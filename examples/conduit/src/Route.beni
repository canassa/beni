--! The pages' addresses: which route an address is, and the address of a
--! route. Conduit's spec uses `#/` addresses; this app uses paths, which
--! `Tea.application` routes without a fragment parser.

import Browser.Navigation as Navigation
import Cmd exposing (Cmd)
import Deploy
import Url exposing (Url)
import Url.Parser exposing (Parser, map, oneOf, s, slash, string, top)


pub type Route
    = Home
    | Root
    | Login
    | Logout
    | Register
    | Settings
    | Article String
    | Profile String
    | Favorited String
    | NewArticle
    | EditArticle String


parser : Parser (Route → a) a
parser =
    oneOf
        [ top ▷ map Home
        , s "login" ▷ map Login
        , s "logout" ▷ map Logout
        , s "settings" ▷ map Settings
        , s "register" ▷ map Register
        , slash (s "article") string ▷ map Article
        , slash (slash (s "profile") string) (s "favorites") ▷ map Favorited
        , slash (s "profile") string ▷ map Profile
        , s "editor" ▷ map NewArticle
        , slash (s "editor") string ▷ map EditArticle
        ]


--| The route at an address under `Deploy.basePath`. The base must end at
--| a `/` or at the end of the path, so `/beni/conduitlogin` is no route
--| under `/beni/conduit`.
pub fromUrl : Url → Maybe Route
fromUrl url =
    rest = String.dropLeft url.path (String.length Deploy.basePath)
    if String.startsWith url.path Deploy.basePath && (rest == "" || String.startsWith rest "/") then
        Url.Parser.parse parser { url | path = rest }
    else
        Nothing


--| The address of a route, under `Deploy.basePath`.
pub href : Route → String
href route = Deploy.basePath ++ path route


path : Route → String
path route =
    case route of
        Home →
            "/"

        Root →
            "/"

        Login →
            "/login"

        Logout →
            "/logout"

        Register →
            "/register"

        Settings →
            "/settings"

        Article slug →
            "/article/${slug}"

        Profile username →
            "/profile/${username}"

        Favorited username →
            "/profile/${username}/favorites"

        NewArticle →
            "/editor"

        EditArticle slug →
            "/editor/${slug}"


--| Why the address did not change: the browser refused it (`Browser.Navigation.Error`).
pub type alias Refusal =
    Navigation.Error


--| Go to the route, replacing the current history entry, when the command
--| runs. `refused` is sent only when the browser refuses the change — a
--| burst throttled — which leaves the page where it is.
pub replaceUrl : Navigation.Key, Route, (Refusal → msg) → Cmd msg
replaceUrl key route refused = Navigation.replaceUrl key (href route) refused
