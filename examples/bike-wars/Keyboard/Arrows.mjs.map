import Keyboard exposing (Key, Character, ArrowDown, ArrowLeft, ArrowRight, ArrowUp, KeyParser, RawKey)


--| A key parser for just the Arrow keys and W, A, S, D.
--|
--| [ArrowLeft] -> `Just ArrowLeft`
--|
--| [A] -> `Character "a"`
--|
--| [B] -> `Nothing`
pub arrowKey : KeyParser
arrowKey rawKey =
    case Keyboard.rawValue rawKey of
        -- Navigation
        "ArrowDown" →
            Just ArrowDown

        "ArrowLeft" →
            Just ArrowLeft

        "ArrowRight" →
            Just ArrowRight

        "ArrowUp" →
            Just ArrowUp

        "Down" →
            Just ArrowDown

        "Left" →
            Just ArrowLeft

        "Right" →
            Just ArrowRight

        "Up" →
            Just ArrowUp

        other →
            lower = String.toLower other
            if lower == "w" || lower == "a" || lower == "s" || lower == "d" then
                Just (Character other)
            else
                Nothing
