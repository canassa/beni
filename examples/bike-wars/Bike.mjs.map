import BikePhysics exposing (collision, computeDirection, computePosition)
import Constants exposing (bikeSize, speedC)
import Explosion
import Html exposing (Html)
import Keyboard exposing (Key)
import Math.Vector2 as Vec2 exposing (Vec2, getX, getY, vec2)
import Trail
import Types exposing (Bike, Controls, Direction, East, Explosion, North, Obstacle, South, Trail, Weapon, West)
import Weapon


pub initBike : Controls, String, Vec2, Direction, Weapon → Bike
initBike controls color pos direction weapon =
    { position = pos
    , trail = [ [ pos, pos ] ]
    , collided = False
    , direction = direction
    , color = color
    , controls = controls
    , weapon = weapon
    }


pub frontWall : Bike → List Vec2
frontWall bike =
    vertical =
        [ vec2 (getX bike.position) (getY bike.position - bikeSize)
        , vec2 (getX bike.position) (getY bike.position + bikeSize)
        ]
    horizontal =
        [ vec2 (getX bike.position - bikeSize) (getY bike.position)
        , vec2 (getX bike.position + bikeSize) (getY bike.position)
        ]
    case bike.direction of
        North →
            horizontal

        East →
            vertical

        South →
            horizontal

        West →
            vertical


pub update : Float, List Explosion, { current : Bike, other : Bike } → Bike × Maybe Explosion
update diff explosions { current, other } =
    walls =
        [ frontWall other, …omitLastSections current.trail ] ++ other.trail ++ Constants.gameBounds
    nextPosition = computePosition current.direction current.position diff
    collisionPoint =
        collision { position = current.position, nextPosition = nextPosition } walls
            [ toObstacle other, …List.map explosions Explosion.toObstacle ]
    ( collided, position, explosionPoint ) =
        case ( current.collided, collisionPoint ) of
            ( False, Just point ) →
                -- fresh collision
                ( True, point, Just point )

            ( True, _ ) →
                -- old collision
                ( True, current.position, Nothing )

            ( False, Nothing ) →
                -- all good
                ( False, nextPosition, Nothing )
    trail =
        if collided then
            Trail.breakIfNecessary explosions current.trail
        else
            Trail.breakIfNecessary explosions (swapPosition current.position current.trail)
    ( { current
        | position = position
        , collided = collided
        , trail = trail
      }
    , Maybe.map explosionPoint Explosion.forBike
    )


pub shoot : Key, { current : Bike, other : Bike } → Bike × Maybe Explosion
shoot key { current, other } =
    if key == current.controls.up then
        ( weapon, explosion ) = Weapon.shoot current (current.trail ++ other.trail)
        ( { current | weapon = weapon }, explosion )
    else
        ( current, Nothing )


pub turn : Key, Bike → Bike
turn key bike =
    if bike.controls.left == key || bike.controls.right == key then
        { bike
            | direction = computeDirection bike.controls bike.direction key
            , trail = cons bike.position (swapPosition bike.position bike.trail)
        }
    else
        bike


pub toObstacle : Bike → Obstacle
toObstacle bike =
    { x, y } = Vec2.toRecord bike.position
    r = bikeSize / 2
    { w = x - r
    , e = x + r
    , n = y - r
    , s = y + r
    }


pub view : Bike → List (Html msg)
view bike =
    posX = getX bike.position
    posY = getY bike.position
    rotation =
        case bike.direction of
            North →
                "0"

            East →
                "90"

            South →
                "180"

            West →
                "270"
    transformValue =
        String.join
            [ "translate("
            , String.fromFloat (posX - bikeSize)
            , " "
            , String.fromFloat (posY - bikeSize)
            , ") rotate("
            , rotation
            , " "
            , String.fromFloat bikeSize
            , " "
            , String.fromFloat bikeSize
            , ")"
            ]
            ""
    trail =
        bike.trail
            ▷ List.map λsection →
                polylinePoints =
                    String.join
                        (List.map section λvec →
                            String.fromFloat (getX vec) ++ "," ++ String.fromFloat (getY vec)
                        )
                        " "
                <polyline
                    fill="none"
                    stroke={bike.color}
                    stroke-width={String.fromFloat (bikeSize / 2)}
                    stroke-linecap="square"
                    points={polylinePoints}
                />
    bikeView =
        if bike.collided then
            []
        else
            [ <g transform={transformValue}>{bikeForm bikeSize bike.color}</g> ]
    trail ++ bikeView


pub bikeForm : Float, String → Html msg
bikeForm bikeSize_ color =
    <svg
        width={String.fromFloat (2 * bikeSize_)}
        height={String.fromFloat (2 * bikeSize_)}
        viewBox="0 0 210 297"
    >
        <g>
            <path
                d="m 185.20834,126.15476 -66.86084,92.02605 -108.183103,-35.15082 0,-113.750451 L 118.3475,34.128718 Z"
                style={"fill:" ++ color}
                transform="matrix(0,-1.690983,1.1396473,0,-39.07253,313.47282)"
            />
        </g>
    </svg>


pub cons : Vec2, Trail → Trail
cons point trail =
    case trail of
        [] →
            [ [ point ] ]

        [ first, …rest ] →
            [ [ point, …first ], …rest ]


pub swapPosition : Vec2, Trail → Trail
swapPosition point trail =
    case trail of
        [ [ head, …tail ], …rest ] →
            [ [ point, …tail ], …rest ]

        _ →
            trail


pub omitLastSections : Trail → Trail
omitLastSections trail =
    case trail of
        [ first, …rest ] →
            [ List.drop first 2, …rest ]

        other →
            other
