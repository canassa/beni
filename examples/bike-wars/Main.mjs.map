import Game exposing (Model, Msg, init, subscriptions, update, view)
import Tea


main : Tea.Program
main =
    Tea.document
        { init = λ⊤ → init
        , update = update
        , view =
            λmodel →
                { title = "Bike Wars"
                , body = view model
                }
        , subscriptions = subscriptions
        }
