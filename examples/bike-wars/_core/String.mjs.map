--! A built-in representation for efficient string manipulation. String
--! literals are enclosed in double quotes, and `"a ${n}"` interpolates a
--! primitive value into one.
--!
--! Argument order here is **subject first and function last**: the string
--! comes first, so `str ▷ split ","` inserts it at the front and reads as
--! "split this string on commas", and a function argument comes last, so a
--! lambda you write inline is the final argument.
--!
--! `compare` below is `String`'s own `compare` method, so `<`, `>`, `≤`
--! and `≥` on two strings call it and `"a" < "b"` means what it reads as.
--! It stays callable by name as well, which is what you want when you are
--! ordering by something other than the string itself.
--!
--! Nothing here is `foreign` but the type. What reaches into the platform's
--! own string type is written over `Js` (`boundary.md` §4.2,
--! `plans/core-in-beni.md`):
--!
--!   - `length` `slice` `append` — indexing and concatenation.
--!   - `compare` — lexicographic order.
--!   - `toUpper` `toLower` — Unicode case mapping.
--!   - `trim` `trimLeft` `trimRight` `words` `lines` — the Unicode
--!     whitespace and line-terminator classes.
--!   - `split` `indexes` — substring search; `join` — the array's own `join`.
--!   - `toInt` `fromInt` `toFloat` `fromFloat` — number parsing and printing.
--!   - `fromChar` `toList` `fromList` — the character/string boundary.
--!
--! Everything else is written over those.
--!
--! A `String` is a native JavaScript string and a `Char` a one-scalar one
--! (`backend.md` §4). Where the UTF-16 mismatch would show — `length`,
--! `slice`, `toList`, `indexes`, `compare`, and `split` on an empty
--! separator — these work in CODE POINTS, because the API is defined over
--! characters and a surrogate half is not one. `Array.from` of a string is
--! its code points. A `List` crosses as a plain array (`boundary.md` §4,
--! *How a sibling sees a `List`*): a list made here is the fresh array its
--! function made, and a list argument is read by the protocol,
--! `Array.isArray` or `$plain()`.

import Js
import List


--| A chunk of text, written between double quotes.
--|
--|     "hello"
--|     "a ${n}"
--|
--| Two strings are equal when they are the same sequence of characters.
--| `compare` below is what orders them.
pub equatable foreign type String


--| Get the length of a string.
--|
--|     length "innumerable" == 11
--|     length "" == 0
pub length : String → Int
length s = Js.pure λ⊤ → Js.to (Js.get (Js.call (Js.global "Array") "from" [ Js.from s ]) "length")


--| Take a substring given a start and end index. Negative indexes are taken
--| starting from the *end* of the string.
--|
--|     slice "snakes on a plane!" 7 9 == "on"
--|     slice "snakes on a plane!" 0 (-7) == "snakes on a"
pub slice : String, Int, Int → String
slice s start end = Js.pure λ⊤ →
    points = Js.call (Js.global "Array") "from" [ Js.from s ]
    n : Int
    n = Js.to (Js.get points "length")
    from = clamp start n
    to = clamp end n
    if to ≤ from then
        ""
    else
        Js.to
            (Js.call (Js.call points "slice" [ Js.from from, Js.from to ]) "join"
                [ Js.from "" ]
            )


-- An index into `n` code points: a negative one counts from the end, and
-- either is kept within 0…n.
clamp : Int, Int → Int
clamp i n =
    if i < 0 then
        Js.to (Js.call (Js.global "Math") "max" [ Js.from 0, Js.from (n + i) ])
    else
        Js.to (Js.call (Js.global "Math") "min" [ Js.from i, Js.from n ])


--| Append two strings. `++` does the same thing.
--|
--|     append "butter" "fly" == "butterfly"
pub append : String, String → String
append a b =
    -- JavaScript's `+` on two strings, the casts compiled to nothing.
    Js.to (Js.from (Js.to (Js.from a) + Js.to (Js.from b)))


--| Compare two strings lexicographically, by Unicode scalar value.
--|
--|     compare "a" "b" == LT
--|     compare "b" "b" == EQ
--|
--| `"a" < "b"` calls it: it is `String`'s own `compare` method.
pub compare : String, String → Order
compare a b = Js.pure λ⊤ →
    -- Code units are compared until the first that differ. Code unit
    -- order is not code point order — an astral character is a pair
    -- of units in 0xD800…0xDFFF and sorts above U+FFFF, which `<` on
    -- two JavaScript strings gets wrong — so the answer is the code
    -- points' there: at that unit, or at the one before it when that
    -- one opens a surrogate pair in either string (the code point
    -- there is astral). No array is made: `<` on two strings is a
    -- walk, not a copy.
    x = Js.from a
    y = Js.from b
    la : Int
    la = Js.to (Js.get x "length")
    lb : Int
    lb = Js.to (Js.get y "length")

    n =
        if la < lb then
            la
        else
            lb

    i = firstDifference x y 0 n
    if i == n then
        if la < lb then
            LT
        else if la > lb then
            GT
        else
            EQ
    else
        at =
            if i > 0 && (pointAt x (i - 1) > 0xFFFF || pointAt y (i - 1) > 0xFFFF) then
                i - 1
            else
                i
        if pointAt x at < pointAt y at then
            LT
        else
            GT


-- The first index below `n` where the two strings' code units differ, or
-- `n`.
firstDifference : Js.Value, Js.Value, Int, Int → Int
firstDifference x y i n =
    if
        i < n
            && Js.same (Js.call x "charCodeAt" [ Js.from i ]) (Js.call y "charCodeAt" [ Js.from i ])
    then
        firstDifference x y (i + 1) n
    else
        i


pointAt : Js.Value, Int → Int
pointAt s i = Js.to (Js.call s "codePointAt" [ Js.from i ])


--| Convert a string to all upper case. Useful for case-insensitive
--| comparisons and VIRTUAL YELLING.
--|
--|     toUpper "skinner" == "SKINNER"
pub toUpper : String → String
toUpper s = Js.pure λ⊤ → Js.to (Js.call (Js.from s) "toUpperCase" [])


--| Convert a string to all lower case.
--|
--|     toLower "X" == "x"
pub toLower : String → String
toLower s = Js.pure λ⊤ → Js.to (Js.call (Js.from s) "toLowerCase" [])


--| Get rid of whitespace on both sides of a string.
--|
--|     trim "  hats \n" == "hats"
pub trim : String → String
trim s = Js.pure λ⊤ → Js.to (Js.call (Js.from s) "trim" [])


--| Get rid of whitespace on the left of a string.
--|
--|     trimLeft "  hats \n" == "hats \n"
pub trimLeft : String → String
trimLeft s = Js.pure λ⊤ → Js.to (Js.call (Js.from s) "trimStart" [])


--| Get rid of whitespace on the right of a string.
--|
--|     trimRight "  hats \n" == "  hats"
pub trimRight : String → String
trimRight s = Js.pure λ⊤ → Js.to (Js.call (Js.from s) "trimEnd" [])


--| Break a string into words, splitting on chunks of whitespace.
--|
--|     words "How are \n you? \t Good?" == [ "How", "are", "you?", "Good?" ]
pub words : String → fresh exclusive List String
words s = Js.pure λ⊤ →
    Js.to
        (Js.call (Js.call (Js.from s) "split" [ Js.regExp "\\s+" "" ]) "filter"
            [ Js.from isWord ]
        )


isWord : Js.Value → Bool
isWord w = Js.to (Js.get w "length") ≠ 0


--| Break a string into lines, splitting on newlines.
--|
--|     lines "How are you?\nGood?" == [ "How are you?", "Good?" ]
pub lines : String → fresh exclusive List String
lines s = Js.pure λ⊤ → Js.to (Js.call (Js.from s) "split" [ Js.regExp "\r\n|\r|\n" "" ])


--| Split a string using a given separator. The string being split comes
--| first, so `csv ▷ split ","` reads as "split this on commas".
--|
--|     split "cat,dog,cow" "," == [ "cat", "dog", "cow" ]
--|     split "abc" "" == [ "a", "b", "c" ]
--|
--| An empty separator splits into characters, which are code points: an
--| astral character comes back whole and never as two halves. An empty
--| string has no characters, so it splits into nothing at all — but split on
--| a separator it does not contain it is still one chunk, itself.
--|
--|     split "" "" == []
--|     split "" "," == [ "" ]
pub split : String, String → fresh exclusive List String
split s separator = Js.pure λ⊤ →
    if separator == "" then
        Js.to (Js.call (Js.global "Array") "from" [ Js.from s ])
    else
        Js.to (Js.call (Js.from s) "split" [ Js.from separator ])


--| Get all of the indexes for a substring in a string. The string being
--| searched comes first, the needle second.
--|
--|     indexes "Mississippi" "i" == [ 1, 4, 7, 10 ]
--|     indexes "haystack" "needle" == []
--|
--| The indexes count CHARACTERS, the same way `length` and `slice` do, so
--| an index from here can be handed straight back to `slice`. A combining
--| mark is a character of its own.
--|
--| Matches do not overlap — the search resumes after the one it found —
--| and an empty needle matches nothing. That last rule is Elm's, and it is
--| about POSITIONS only: `contains str ""` is still `True`, because the
--| empty string is a substring of every string.
--|
--|     indexes "aaaa" "aa" == [ 0, 2 ]
--|     indexes "abc" "" == []
--|     indexes "" "" == []
pub indexes : String, String → fresh exclusive List Int
indexes haystack needle = Js.pure λ⊤ →
    -- `indexOf` answers in UTF-16 code units, so each match is translated
    -- by one forward walk that carries its position between matches —
    -- `scanned` a code unit offset and `point` the code points before it,
    -- both only ever moving forward — so the whole call stays linear in the
    -- haystack. A match that begins on the second half of a surrogate pair
    -- (`scanned` past it) is at no character, and is not an answer.
    if needle == "" then
        []
    else
        h = Js.from haystack
        found = Js.array []
        search h needle found (indexOf h needle 0) 0 0
        Js.to found


search : Js.Value, String, Js.Value, Int, Int, Int → ⊤
search h needle found at scanned point =
    if at < 0 then
        ⊤
    else
        ( s, p ) = advance h at scanned point

        _ =
            if s == at then
                Js.call found "push" [ Js.from p ]
            else
                Js.null
        search h needle found (indexOf h needle (at + Js.to (Js.get (Js.from needle) "length"))) s p


-- `scanned` moved up to `at`, a code point at a time, and the code points
-- it passed counted onto `point`.
advance : Js.Value, Int, Int, Int → Int × Int
advance h at scanned point =
    if scanned < at then
        advance
            h
            at
            (scanned
                + (if Js.to (Js.call h "codePointAt" [ Js.from scanned ]) > 65535 then
                      2
                   else
                      1
                  )
            )
            (point + 1)
    else
        ( scanned, point )


indexOf : Js.Value, String, Int → Int
indexOf h needle from = Js.to (Js.call h "indexOf" [ Js.from needle, Js.from from ])


--| Try to convert a string into an int, failing on improperly formatted
--| strings.
--|
--|     toInt "123" == Just 123
--|     toInt "1.3" == Nothing
pub toInt : String → Maybe Int
toInt s = Js.pure λ⊤ →
    -- Every specification-defined failure is a constructor (`boundary.md`
    -- §4.1): text that is not a number is `Nothing`, never a NaN pretending
    -- to be an `Int`, and neither is one past 2^53.
    if Js.to (Js.call (Js.regExp "^[+-]?\\d+$" "") "test" [ Js.from s ]) then
        n = Js.apply (Js.global "Number") [ Js.from s ]
        if Js.to (Js.call (Js.global "Number") "isSafeInteger" [ n ]) then
            Just (Js.to n)
        else
            Nothing
    else
        Nothing


--| Convert an `Int` to a `String`.
--|
--|     fromInt 123 == "123"
pub fromInt : Int → String
fromInt n = Js.pure λ⊤ → Js.to (Js.apply (Js.global "String") [ Js.from n ])


--| Try to convert a string into a float, failing on improperly formatted
--| strings.
--|
--|     toFloat "123" == Just 123.0
--|     toFloat "abc" == Nothing
pub toFloat : String → Maybe Float
toFloat s = Js.pure λ⊤ →
    if
        Js.to
            (Js.call (Js.regExp "^[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?$" "") "test"
                [ Js.from s ]
            )
    then
        n = Js.apply (Js.global "Number") [ Js.from s ]
        if Js.to (Js.call (Js.global "Number") "isNaN" [ n ]) then
            Nothing
        else
            Just (Js.to n)
    else
        Nothing


--| Convert a `Float` to a `String`.
--|
--|     fromFloat 1.5 == "1.5"
pub fromFloat : Float → String
fromFloat n = Js.pure λ⊤ →
    -- `String(1.0)` is "1" in JavaScript and `1` is not a float literal in
    -- beni's own syntax, so a whole float prints with its point.
    if Js.to (Js.call (Js.global "Number") "isInteger" [ Js.from n ]) then
        "${n}.0"
    else
        Js.to (Js.apply (Js.global "String") [ Js.from n ])


--| Create a string from a given character.
--|
--|     fromChar 'a' == "a"
pub fromChar : Char → String
fromChar c = Js.to (Js.from c)


--| Convert a string to a list of characters.
--|
--|     toList "abc" == [ 'a', 'b', 'c' ]
pub toList : String → fresh exclusive List Char
toList s = Js.pure λ⊤ → Js.to (Js.call (Js.global "Array") "from" [ Js.from s ])


--| Convert a list of characters into a string.
--|
--|     fromList [ 'a', 'b', 'c' ] == "abc"
pub fromList : borrowed List Char → String
fromList list = Js.pure λ⊤ →
    xs = Js.from list

    plain =
        if Js.to (Js.call (Js.global "Array") "isArray" [ xs ]) then
            xs
        else
            Js.call xs "$plain" []
    Js.to (Js.call plain "join" [ Js.from "" ])


--| Determine if a string is empty.
--|
--|     isEmpty "" == True
--|     isEmpty "the world" == False
pub isEmpty : String → Bool
isEmpty str = str == ""


--| Reverse a string.
--|
--|     reverse "stressed" == "desserts"
pub reverse : String → String
reverse str = fromList (List.reverse (toList str))


--| Repeat a string `n` times.
--|
--|     repeat "ha" 3 == "hahaha"
pub repeat : String, Int → String
repeat chunk n = concat (List.repeat chunk n)


--| Replace all occurrences of some substring. The string being rewritten
--| comes first, then the substring to look for, then what to put in its
--| place, so `path ▷ replace "/" "."` reads in the order you say it.
--|
--|     replace "a,b,c" "," "/" == "a/b/c"
--|
--| This is `join (split str before) after`, so it inherits `split`'s
--| empty-separator rule: an empty `before` separates every CHARACTER, and a
--| character is a code point, so an astral character comes back whole rather
--| than as two surrogate halves (which is what Elm's `replace` would give,
--| since its `split` is JavaScript's). An empty string has nothing to
--| separate, so it stays empty.
--|
--|     replace "abc" "" "-" == "a-b-c"
--|     replace "" "" "-" == ""
pub replace : String, String, String → String
replace str before after = join (split str before) after


--| Concatenate many strings into one.
--|
--|     concat [ "never", "the", "less" ] == "nevertheless"
pub concat : List String → String
concat strings = join strings ""


--| Put many strings together with a given separator. The list is the subject
--| here, so `names ▷ join ", "` puts the separator between its elements.
--|
--|     join [ "cat", "dog" ] ", " == "cat, dog"
pub join : borrowed List String, String → String
join chunks sep = Js.pure λ⊤ → Js.to (Js.call (elements (Js.from chunks)) "join" [ Js.from sep ])


-- A list's elements as a plain array, which the caller must not write: the
-- list itself, or its `$plain()` (`backend.md` §4, *Lists are arrays*).
elements : Js.Value → Js.Value
elements xs =
    if Js.to (Js.call (Js.global "Array") "isArray" [ xs ]) then
        xs
    else
        Js.call xs "$plain" []


--| Take `n` characters from the left side of a string.
--|
--|     left "Mulder" 2 == "Mu"
pub left : String, Int → String
left str n =
    if n < 1 then
        ""
    else
        slice str 0 n


--| Take `n` characters from the right side of a string.
--|
--|     right "Scully" 2 == "ly"
pub right : String, Int → String
right str n =
    if n < 1 then
        ""
    else
        slice str (negate n) (length str)


--| Drop `n` characters from the left side of a string.
--|
--|     dropLeft "The Lone Gunmen" 2 == "e Lone Gunmen"
pub dropLeft : String, Int → String
dropLeft str n =
    if n < 1 then
        str
    else
        slice str n (length str)


--| Drop `n` characters from the right side of a string.
--|
--|     dropRight "Cigarette Smoking Man" 2 == "Cigarette Smoking M"
pub dropRight : String, Int → String
dropRight str n =
    if n < 1 then
        str
    else
        slice str 0 (negate n)


--| See if a string contains a substring. The string being searched comes
--| first, so `word ▷ contains "the"` asks about `word`.
--|
--|     contains "theory" "the" == True
--|     contains "theory" "hat" == False
--|
--| The empty string is a substring of every string, at position 0, so an
--| empty needle is always found — this is Elm's answer too, since
--| `_String_contains` is `str.indexOf(sub) > -1`. Note that this does NOT
--| follow from `indexes`, which answers "at which positions" and says
--| nowhere for an empty needle; `contains` answers "is it in there".
--|
--|     contains "abc" "" == True
--|     contains "" "" == True
pub contains : String, String → Bool
contains str sub =
    if isEmpty sub then
        True
    else
        case indexes str sub of
            [] →
                False

            _ →
                True


--| See if a string starts with a given prefix. Every string starts with the
--| empty one, which is what Elm's kernel says as well. The string's own
--| `startsWith`, as Elm's: the same answer as comparing the first
--| `length prefix` characters for any string that holds no half of a
--| surrogate pair on its own.
--|
--|     startsWith "theory" "the" == True
--|     startsWith "theory" "ory" == False
--|     startsWith "abc" "" == True
--|     startsWith "" "" == True
pub startsWith : String, String → Bool
startsWith str prefix = Js.pure λ⊤ → Js.to (Js.call (Js.from str) "startsWith" [ Js.from prefix ])


--| See if a string ends with a given suffix. Every string ends with the
--| empty one, the mirror of `startsWith`.
--|
--|     endsWith "theory" "ory" == True
--|     endsWith "theory" "the" == False
--|     endsWith "abc" "" == True
--|     endsWith "" "" == True
pub endsWith : String, String → Bool
endsWith str suffix = Js.pure λ⊤ → Js.to (Js.call (Js.from str) "endsWith" [ Js.from suffix ])


--| Get all of the indexes for a substring. An alias of `indexes`, kept
--| because Elm has both spellings, so it counts characters and skips
--| overlaps exactly as `indexes` does.
--|
--|     indices "Mississippi" "i" == [ 1, 4, 7, 10 ]
pub indices : String, String → List Int
indices str sub = indexes str sub


--| Add a character to the beginning of a string. The string is the subject,
--| so `"he truth is out there" ▷ cons 'T'` puts the `'T'` on the front.
--|
--|     cons "he truth is out there" 'T' == "The truth is out there"
pub cons : String, Char → String
cons str char = append (fromChar char) str


--| Split a non-empty string into its first character and the rest.
--|
--|     uncons "abc" == Just ( 'a', "bc" )
--|     uncons "" == Nothing
pub uncons : String → Maybe (Char × String)
uncons str =
    case toList str of
        [ char, …rest ] →
            Just ( char, fromList rest )

        [] →
            Nothing


--| Pad a string on both sides until it has a given length.
--|
--|     pad "1" 5 ' ' == "  1  "
pub pad : String, Int, Char → String
pad str n char =
    half = Basics.toFloat (n - length str) / 2
    repeat (fromChar char) (ceiling half) ++ str ++ repeat (fromChar char) (floor half)


--| Pad a string on the left until it has a given length.
--|
--|     padLeft "1" 5 '.' == "....1"
pub padLeft : String, Int, Char → String
padLeft str n char = repeat (fromChar char) (n - length str) ++ str


--| Pad a string on the right until it has a given length.
--|
--|     padRight "1" 5 '.' == "1...."
pub padRight : String, Int, Char → String
padRight str n char = str ++ repeat (fromChar char) (n - length str)


--| Transform every character in a string.
--|
--|     map "a/b/c" (λchar → if char == '/' then '.' else char) == "a.b.c"
pub map : String, (Char → Char) → String
map str func = fromList (List.map (toList str) func)


--| Keep only the characters that pass the test.
--|
--|     filter "R2-D2" Char.isDigit == "22"
pub filter : String, (Char → Bool) → String
filter str isGood = fromList (List.filter (toList str) isGood)


--| Reduce a string from the left, starting from an initial value.
--|
--|     foldl "time" "" (λchar acc → cons acc char) == "emit"
pub foldl : String, b, (Char, b → b) → b
foldl str acc func = List.foldl (toList str) acc func


--| Reduce a string from the right, starting from an initial value.
--|
--|     foldr "time" "" (λchar acc → cons acc char) == "time"
pub foldr : String, b, (Char, b → b) → b
foldr str acc func = List.foldr (toList str) acc func


--| Determine whether any characters pass the test.
--|
--|     any "R2-D2" Char.isDigit == True
pub any : String, (Char → Bool) → Bool
any str isGood = List.any (toList str) isGood


--| Determine whether all characters pass the test.
--|
--|     all "2D2" Char.isDigit == False
pub all : String, (Char → Bool) → Bool
all str isGood = List.all (toList str) isGood
