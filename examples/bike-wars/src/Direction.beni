import Types exposing (Direction, North, East, South, West)


pub turnRight : Direction → Direction
turnRight dir =
    case dir of
        North →
            East

        East →
            South

        South →
            West

        West →
            North


pub turnLeft : Direction → Direction
turnLeft dir = turnRight (turnRight (turnRight dir))
