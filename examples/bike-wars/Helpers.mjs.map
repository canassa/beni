import Math.Vector2 as Vec2 exposing (Vec2, getX, getY, vec2)
import Types exposing (Horizontal, Line, Obstacle, Trail, Vertical)


--| Sort points on the 2D plane.
pub sortPoints : Vec2 × Vec2 → Vec2 × Vec2
sortPoints ( a, b ) =
    if (getX a == getX b && getY a < getY b) || (getY a == getY b && getX a < getX b) then
        ( a, b )
    else
        ( b, a )


pub linesToTrail : List Line → Trail
linesToTrail lines = List.foldr lines [] λline acc →
    ( start, end ) =
        case line of
            Horizontal points →
                points

            Vertical points →
                points
    case acc of
        [] →
            [ [ start, end ] ]

        [ accHead, …accTail ] →
            if List.head accHead == Just end then
                [ [ start, …accHead ], …accTail ]
            else
                [ [ start, end ], …acc ]


pub trailToLines : Trail → List Line
trailToLines trail =
    recurse : List (Maybe Line), List Vec2 → List (Maybe Line)
    recurse acc list =
        case list of
            [] →
                acc

            [ _ ] →
                acc

            [ a, b, …tail ] →
                recurse [ toLine a b, …acc ] [ b, …tail ]
    trail
        ▷ List.map λl → List.reverse (recurse [] l)
        ▷ List.concat
        ▷ List.filterMap identity


pub toLine : Vec2, Vec2 → Maybe Line
toLine vecA vecB =
    a = Vec2.toRecord vecA
    b = Vec2.toRecord vecB
    if a == b then
        Nothing
    else if a.x == b.x then
        Just (Vertical ( vecA, vecB ))
    else if a.y == b.y then
        Just (Horizontal ( vecA, vecB ))
    else
        _ = Debug.log "Line invalid" ( a, b )
        Nothing


pub tryCollision : (Vec2 × Vec2 → Maybe Vec2), List (Vec2 × Vec2) → Maybe Vec2
tryCollision method linePoints =
    linePoints
        ▷ List.filterMap method
        ▷ List.reverse
        ▷ List.head


pub tryObstacleCollision : Vec2 × Vec2, Obstacle → Maybe Vec2
tryObstacleCollision ( a, b ) ({ n, s, w } as obstacle) =
    diff point = isBetween ( w, obstacle.e ) (getX point) && isBetween ( n, s ) (getY point)
    if diff a then
        Just a
    else if diff b then
        Just b
    else
        Nothing


pub horizontalOrthogonal : Vec2 × Vec2, Vec2 × Vec2 → Maybe Vec2
horizontalOrthogonal move trail =
    ( a, b ) = sortPoints move
    ( trailA, trailB ) = sortPoints trail
    if isBetweenWith getX ( a, b ) trailA && isBetweenWith getY ( trailA, trailB ) a then
        Just (vec2 (getX trailA) (getY a))
    else
        Nothing


pub verticalOrthogonal : Vec2 × Vec2, Vec2 × Vec2 → Maybe Vec2
verticalOrthogonal move trail =
    ( a, b ) = sortPoints move
    ( trailA, trailB ) = sortPoints trail
    if isBetweenWith getY ( a, b ) trailA && isBetweenWith getX ( trailA, trailB ) a then
        Just (vec2 (getX a) (getY trailA))
    else
        Nothing


pub isBetween : Float × Float, Float → Bool
isBetween ( small, large ) point = small ≤ point && large ≥ point


pub isBetweenWith : (Vec2 → Float), Vec2 × Vec2, Vec2 → Bool
isBetweenWith getN ( small, large ) point = getN small ≤ getN point && getN large ≥ getN point


pub onlyVertical : Line → Maybe (Vec2 × Vec2)
onlyVertical line =
    case line of
        Vertical points →
            Just points

        Horizontal _ →
            Nothing


pub onlyHorizontal : Line → Maybe (Vec2 × Vec2)
onlyHorizontal line =
    case line of
        Horizontal points →
            Just points

        Vertical _ →
            Nothing
