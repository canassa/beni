--! The chat's protocol, one module that both programs import: the page
--! builds it for `browser-tea` and the server for `node`. It names only
--! the WebSocket operations that every platform shares (`boundary.md`
--! §9.11 (a) and the amendment's item 1) — `write` and `Close` — so it
--! checks on both.
--!
--! A message is one line of text: `say <text>` from a page; `said <name>
--! <text>`, `joined <name>` and `left <name>` from the server. The first
--! word is the kind; a name has no space.

import WebSocket exposing (Socket)


--| What the server tells every page.
pub type Event
    = Said String String
    | Joined String
    | Left String


--| The line of an event.
pub encode : Event → String
encode event =
    case event of
        Said name text →
            "said ${name} ${text}"

        Joined name →
            "joined ${name}"

        Left name →
            "left ${name}"


--| The event of a line, or `Nothing` for a line that is not one.
pub decode : String → Maybe Event
decode line =
    case String.split line " " of
        [ "said", name, …words ] →
            Just (Said name (String.join words " "))

        [ "joined", name ] →
            Just (Joined name)

        [ "left", name ] →
            Just (Left name)

        _ →
            Nothing


--| Write an event to a socket: what the server does for every page.
pub tell : Socket, Event → Result WebSocket.WriteError ⊤
tell socket event = WebSocket.write socket (encode event)


--| What a page says: the line `say <text>`.
pub say : String → String
say text = "say ${text}"


--| The text of a page's line, or `Nothing` for one that is not `say`.
pub said : String → Maybe String
said line = if String.startsWith line "say " then Just (String.dropLeft line 4) else Nothing


--| Why a connection ended, in words, for a page's status line.
pub describe : WebSocket.Close → String
describe close = "closed (${String.fromInt close.code})"
