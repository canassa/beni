--! A chat page in beni, on the `browser-tea` platform (`boundary.md`
--! §9.11 (b)): one WebSocket to the server that served the page, held by
--! a subscription. The page shows what the room says, and says what is
--! typed. When the connection ends it waits, then connects again; after
--! each failure in a row it waits a second longer, 30 seconds at most.

import Chat
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Tea
import Time
import WebSocket exposing (Socket)


-- `Connecting` and `Down` count the failures in a row before this
-- attempt; an open socket ends the row.
type Link
    = Connecting Int
    | Up Socket
    | Down Int


type alias Model =
    link : Link
    lines : List String
    draft : String


type Msg
    = Socket WebSocket.Event
    | Typed String
    | Say
    | Retry
    | Unsent WebSocket.WriteError


init : ⊤ → Model × Cmd Msg
init ⊤ = ( { link = Connecting 0, lines = [], draft = "" }, Cmd.none )


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Socket (WebSocket.Opened socket) →
            ( { model | link = Up socket }, Cmd.none )

        Socket (WebSocket.Received text) →
            case Chat.decode text of
                Just event →
                    ( { model | lines = model.lines ++ [ line event ] }, Cmd.none )

                Nothing →
                    ( model, Cmd.none )

        Socket (WebSocket.Closed close) →
            down model (Chat.describe close)

        Socket (WebSocket.Failed _) →
            down model "cannot connect"

        Typed text →
            ( { model | draft = text }, Cmd.none )

        Say →
            case model.link of
                Up socket →
                    ( { model | draft = "", lines = model.lines ++ [ "you: ${model.draft}" ] }
                    , WebSocket.send socket (Chat.say model.draft) Unsent
                    )

                _ →
                    ( model, Cmd.none )

        Retry →
            case model.link of
                Down failures →
                    ( { model | link = Connecting failures }, Cmd.none )

                _ →
                    ( model, Cmd.none )

        Unsent _ →
            ( model, Cmd.none )


-- The connection ended: wait a second longer after each failure in a
-- row, then connect again.
down : Model, String → Model × Cmd Msg
down model why =
    failures =
        case model.link of
            Connecting n →
                n + 1

            Up _ →
                1

            Down n →
                n
    ( { model | link = Down failures, lines = model.lines ++ [ why ] }
    , Cmd.perform λemit →
        Time.sleep (Time.millis (1000 * min failures 30))
        emit Retry
    )


line : Chat.Event → String
line event =
    case event of
        Chat.Said name text →
            "${name}: ${text}"

        Chat.Joined name →
            "${name} joined"

        Chat.Left name →
            "${name} left"


subscriptions : Model → Sub Msg
subscriptions model =
    case model.link of
        Down _ →
            Sub.none

        _ →
            WebSocket.listen "/chat" [] Socket


status : Link → String
status link =
    case link of
        Connecting _ →
            "connecting"

        Up _ →
            "connected"

        Down _ →
            "offline"


view : Model → Html Msg
view model =
    <main>
        <p id="status">{status model.link}</p>
        <ol id="lines"><For each={model.lines} keyed={False}>{λtext → <li>{text}</li>}</For></ol>
        <input id="draft" value={model.draft} onInput={Typed} />
        <button id="say" onClick={Say}>say</button>
    </main>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = subscriptions }
