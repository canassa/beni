--! The slot and mount half of `platforms/browser/runtime.js`, written in
--! beni over core's `Js` (research 47, a spike). Each declaration is the
--! JavaScript function of the same name, statement for statement where beni
--! allows it. It is this platform's runtime module (`boundary.md` §9.2, *A
--! runtime module*): its `pub` values stand in for the markup runtime's
--! exports of their names, `runtime.js` holds the rest and imports what it
--! calls from here, and both are compiled with the program.
--!
--! Where beni has no counterpart the port says so: a `for` loop is a tail
--! call. A `let` the JavaScript assigns is a `Js.Ref`, which the compiler
--! writes as that `let` (`backend.md` §4, *A `Js.Ref` that does not escape
--! is a `let`*); which is why `mount`'s closures hold what `send` and
--! `queue` were: a cell passed to a helper would escape.
import Js


type alias V =
    Js.Value


-- ---- Instances and their nodes ------------------------------------------


pub first : V -> V
first i =
    if Js.isNull (Js.get i "s") then
        head (Js.get i "q")

    else
        Js.get i "s"


pub last : V -> V
last i =
    if Js.isNull (Js.get i "e") then
        tail (Js.get i "q")

    else
        Js.get i "e"


-- A slot's first and last node: what it holds, or its marker when it holds
-- nothing.
head : V -> V
head s =
    if Js.isNull (Js.get s "u") || Js.to (Js.get (Js.get s "u") "length") == 0 then
        if Js.isNull (Js.get s "i") then
            Js.get s "m"

        else
            first (Js.get s "i")

    else
        first (Js.at (Js.get s "u") 0)


tail : V -> V
tail s =
    -- (Not `not`, which is a call of `Basics.not`.)
    if Js.isNull (Js.get s "m") then
        if Js.isNull (Js.get s "u") || Js.to (Js.get (Js.get s "u") "length") == 0 then
            last (Js.get s "i")

        else
            last (Js.at (Js.get s "u") (Js.to (Js.get (Js.get s "u") "length") - 1))

    else
        Js.get s "m"


-- Move an instance's nodes before `before` in `parent`, in order.
pub put : V, V, V -> ()
put parent i before =
    putRun parent (first i) (last i) before


putRun : V, V, V, V -> ()
putRun parent n end before =
    let
        next =
            Js.get n "nextSibling"

        _ =
            Js.call parent "insertBefore" [ n, before ]
    in
    if Js.same n end then
        ()

    else
        putRun parent next end before


-- Take an instance's nodes out of the page.
pub drop : V -> ()
drop i =
    dropRun (first i) (last i)


dropRun : V, V -> ()
dropRun n end =
    let
        next =
            Js.get n "nextSibling"

        _ =
            Js.call n "remove" []
    in
    if Js.same n end then
        ()

    else
        dropRun next end


-- Put `i` where `old` is, and take `old` out.
pub swap : V, V -> ()
swap old i =
    let
        f =
            first old

        _ =
            put (Js.get f "parentNode") i f
    in
    drop old


-- ---- Templates -----------------------------------------------------------


-- `(html, flags)`: a cloner that parses `html` on its first call and clones
-- the result after that. Flag 1: import rather than clone; 2: the markup is
-- wrapped in its namespace's root element, which is taken off; 4: several
-- nodes, returned in a fragment. One function, as the hand-written
-- runtime's is: the parse is in the cloner, on its first call, and the
-- cell it fills is rewritten step by step.
pub template : String, Int -> (() -> V)
template html flags =
    let
        node =
            Js.ref Js.null
    in
    \() ->
        let
            _ =
                if Js.isNull (Js.read node) then
                    let
                        document =
                            Js.global "document"

                        t =
                            Js.call document "createElement" [ Js.from "template" ]

                        _ =
                            Js.set t "innerHTML" (Js.from html)

                        _ =
                            Js.write node (Js.get t "content")

                        _ =
                            if Js.bitAnd flags 2 /= 0 then
                                Js.write node (Js.get (Js.read node) "firstChild")

                            else
                                ()
                    in
                    if Js.bitAnd flags 4 /= 0 then
                        if Js.bitAnd flags 2 /= 0 then
                            let
                                f =
                                    Js.call document "createDocumentFragment" []

                                _ =
                                    gather (Js.read node) f
                            in
                            Js.write node f

                        else
                            ()

                    else
                        Js.write node (Js.get (Js.read node) "firstChild")

                else
                    ()
        in
        if Js.bitAnd flags 1 /= 0 then
            Js.call (Js.global "document") "importNode" [ Js.read node, Js.from True ]

        else
            Js.call (Js.read node) "cloneNode" [ Js.from True ]


-- Move every child of `from` into `into`, in order.
gather : V, V -> ()
gather from into =
    if Js.isNull (Js.get from "firstChild") then
        ()

    else
        let
            _ =
                Js.call into "appendChild" [ Js.get from "firstChild" ]
        in
        gather from into


-- ---- Slots ---------------------------------------------------------------


-- `(parent, marker, cx)`: a slot, and the mount context what it holds is
-- mounted with.
pub slot : V, V, V -> V
slot parent marker cx =
    Js.from { p = parent, m = marker, cx = cx, i = Js.null, u = Js.null, b = Js.null, x = Js.null, y = Js.null, z = Js.null, d = False }


pub parentOf : V -> V
parentOf s =
    if Js.isNull (Js.get s "p") then
        Js.get (Js.get s "m") "parentNode"

    else
        Js.get s "p"


-- A block mounted on its own: an instance that remembers its kind and the
-- block it shows.
pub unit : V, V -> V
unit b cx =
    let
        i =
            Js.call (Js.get b "t") "m" [ Js.get b "v", cx ]

        _ =
            Js.set i "t" (Js.get b "t")

        _ =
            Js.set i "b" b
    in
    i


-- `b` shown where `i` is: `i` patched when `b` is of its kind, else a new
-- instance in its place. The instance now shown.
pub patch : V, V, V -> V
patch i b cx =
    if Js.same b (Js.get i "b") then
        i

    else if Js.same (Js.get b "t") (Js.get i "t") then
        let
            _ =
                Js.call (Js.get b "t") "p" [ i, Js.get b "v" ]

            _ =
                Js.set i "b" b
        in
        i

    else
        let
            n =
                unit b cx

            _ =
                swap i n
        in
        n


-- Put a new instance in the slot, in place of what it held.
pub place : V, V -> ()
place s i =
    let
        _ =
            if Js.isNull (Js.get s "i") then
                put (parentOf s) i (Js.get s "m")

            else
                swap (Js.get s "i") i
    in
    Js.set s "i" i


-- `(slot, block)`: an `Html` hole.
pub childHtml : V, V -> ()
childHtml s b =
    if Js.isNull (Js.get s "i") then
        place s (unit b (Js.get s "cx"))

    else
        Js.set s "i" (patch (Js.get s "i") b (Js.get s "cx"))


-- ---- The program and its render loop -------------------------------------


-- The module's `let`s: the programs with a render queued, whether a flush
-- is, and the after-render phase a hosted program sets.
queued : Js.Ref V
queued =
    Js.ref (Js.array [])


scheduled : Js.Ref Bool
scheduled =
    Js.ref False


phase : Js.Ref V
phase =
    Js.ref Js.null


-- Render every program a message is waiting on, then run the after-render
-- phase.
pub flush : () -> ()
flush () =
    let
        _ =
            Js.write scheduled False

        renders =
            Js.read queued

        _ =
            Js.write queued (Js.array [])

        _ =
            each renders 0
    in
    if Js.isNullish (Js.read phase) then
        ()

    else
        Js.to (Js.apply (Js.read phase) [])


each : V, Int -> ()
each fs k =
    if k == Js.to (Js.get fs "length") then
        ()

    else
        let
            _ =
                Js.apply (Js.at fs k) []
        in
        each fs (k + 1)


-- `(program)`: start every program the array holds, in order.
pub run : V -> ()
run program =
    runFrom program 0


runFrom : V, Int -> ()
runFrom program k =
    if k == Js.to (Js.get program "length") then
        ()

    else
        let
            m =
                Js.at program k

            _ =
                startOne m
        in
        runFrom program (k + 1)


startOne : V -> ()
startOne m =
    let
        document =
            Js.global "document"

        root =
            if Js.isNull (Js.get m "n") then
                Js.get document "body"

            else
                Js.call document "getElementById" [ Js.get m "n" ]

        -- A mount node that is missing, or that holds a program already, is
        -- a fault of the page, thrown before that program renders anything.
        _ =
            if Js.isNull root || not (Js.isUndefined (Js.get root "$$root")) then
                let
                    id : String
                    id =
                        Js.to (Js.get m "n")
                in
                Js.throw
                    (Js.construct
                        (Js.global "Error")
                        [ Js.from
                            (if Js.isNull root then
                                "no element has the id \"${id}\" to mount a program at"

                             else if Js.isNull (Js.get m "n") then
                                "the page's body already holds a program"

                             else
                                "the element \"${id}\" already holds a program"
                            )
                        ]
                    )

            else
                ()
    in
    if Js.isUndefined (Js.get m "h") then
        mount (Js.get m "a") root

    else
        mount (Js.apply (Js.get m "h") [ root, Js.from flush, Js.from (\f -> setPhase f) ]) root


setPhase : V -> V
setPhase f =
    let
        _ =
            Js.write phase f
    in
    Js.from (Js.read scheduled)


-- Render `view init` after the children of `root`, and mark `root` with the
-- program's `send`.
mount : V, V -> ()
mount program root =
    let
        s =
            slot root Js.null Js.null

        model =
            Js.ref (Js.get program "init")

        waiting =
            Js.ref False

        render =
            \() ->
                let
                    _ =
                        Js.write waiting False
                in
                childHtml s (Js.call program "view" [ Js.read model ])

        _ =
            Js.set
                root
                "$$root"
                (Js.from
                    (\msg ->
                        let
                            _ =
                                if Js.read waiting then
                                    ()

                                else
                                    let
                                        _ =
                                            Js.write waiting True

                                        _ =
                                            Js.call (Js.read queued) "push" [ Js.from render ]
                                    in
                                    if Js.read scheduled then
                                        ()

                                    else
                                        let
                                            _ =
                                                Js.write scheduled True
                                        in
                                        Js.to (Js.apply (Js.global "queueMicrotask") [ Js.from (\() -> microtask ()) ])
                        in
                        Js.write model (Js.call program "update" [ msg, Js.read model ])
                    )
                )
    in
    childHtml s (Js.call program "view" [ Js.read model ])


microtask : () -> ()
microtask () =
    if Js.read scheduled then
        flush ()

    else
        ()
