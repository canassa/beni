--! Text for the values a WebGPU fixture prints: every constructor of the
--! failures it can meet, by name, and never a host message, which differs
--! between the fake and a browser.

import Gpu
import Gpu.Error as Error
import Gpu.Flags as Flags
import Gpu.Limits as Limits
import Gpu.Types as Types


--| An availability.
pub availability : Gpu.Availability → String
availability a =
    case a of
        Gpu.Available →
            "Available"

        Gpu.Unavailable problem →
            "Unavailable " ++ initError problem


--| An initialisation failure.
pub initError : Error.InitError → String
initError problem =
    case problem of
        Error.InsecureContext →
            "InsecureContext"

        Error.ApiUnavailable →
            "ApiUnavailable"

        Error.AdapterUnavailable →
            "AdapterUnavailable"

        Error.AdapterConsumed →
            "AdapterConsumed"

        Error.UnsupportedFeatures names →
            "UnsupportedFeatures ["
                ++ String.join (List.map names Types.featureNameToString) ", "
                ++ "]"

        Error.UnsupportedLimits mismatches →
            "UnsupportedLimits [" ++ String.join (List.map mismatches limitMismatch) ", " ++ "]"

        Error.FeatureRequestRejected detail →
            "FeatureRequestRejected ["
                ++ String.join (List.map detail.requested Types.featureNameToString) ", "
                ++ "]"

        Error.DeviceRequestRejected _ →
            "DeviceRequestRejected"

        Error.InitializationInput _ →
            "InitializationInput"

        Error.InitializationLost l →
            "InitializationLost " ++ loss l


limitMismatch : Error.LimitMismatch → String
limitMismatch m =
    problem =
        case m.problem of
            Error.AboveMaximum →
                "AboveMaximum"

            Error.BelowAlignment →
                "BelowAlignment"

            Error.NotPowerOfTwo →
                "NotPowerOfTwo"
    Limits.limitNameToString m.limit ++ " " ++ problem


--| A device loss, without its message.
pub loss : Error.DeviceLoss → String
loss l =
    case l.reason of
        Error.UnknownLoss →
            "UnknownLoss"

        Error.Destroyed →
            "Destroyed"


--| A device's latched loss, or `none`.
pub latched : Maybe Error.DeviceLoss → String
latched l =
    case l of
        Nothing →
            "none"

        Just l1 →
            loss l1


--| A result's constructor, with `f` for an `Ok` value.
pub result : Result Error.InitError a, (a → String) → String
result r f =
    case r of
        Ok a →
            "Ok " ++ f a

        Err problem →
            "Err " ++ initError problem


--| A GPU operation's failure: its constructor, and for a loss its reason
--| and how many failures were observed with it.
pub error : Error.Error → String
error problem =
    case problem of
        Error.InvalidInput input →
            "InvalidInput " ++ inputError input

        Error.UnsupportedCapability _ →
            "UnsupportedCapability"

        Error.Validation _ →
            "Validation"

        Error.OutOfMemory _ →
            "OutOfMemory"

        Error.Internal _ →
            "Internal"

        Error.PipelineValidation _ →
            "PipelineValidation"

        Error.PipelineInternal _ →
            "PipelineInternal"

        Error.DeviceLost report →
            "DeviceLost "
                ++ loss report.loss
                ++ " observed "
                ++ String.fromInt (List.length report.operation.observed)

        Error.MapFailed m →
            "MapFailed " ++ mapError m

        Error.SourceFailed _ →
            "SourceFailed"

        Error.CanvasFailed c →
            "CanvasFailed " ++ canvasError c

        Error.FormatFeatureRejected _ →
            "FormatFeatureRejected"

        Error.HostOperationRejected o →
            "HostOperationRejected " ++ operationFailure o

        Error.AllocationFailed a →
            "AllocationFailed " ++ String.fromInt a.bytes

        Error.RelatedFailures set →
            "RelatedFailures ["
                ++ String.join (List.map [ set.first, …set.rest ] observation) ", "
                ++ "]"


--| An input error: its constructor, its path and the numbers it names.
pub inputError : Error.InputError → String
inputError input =
    case input of
        Error.NumericDomain d →
            "NumericDomain " ++ d.path

        Error.WrongDevice d →
            "WrongDevice " ++ d.path

        Error.ResourceDestroyed d →
            "ResourceDestroyed " ++ d.path

        Error.ResourceExpired d →
            "ResourceExpired " ++ d.path

        Error.ResourceRejected d →
            "ResourceRejected " ++ d.path

        Error.ResourcePending d →
            "ResourcePending " ++ d.path

        Error.MappedSizeUnaligned d →
            "MappedSizeUnaligned " ++ d.path ++ " " ++ String.fromInt d.size

        Error.ResizableBacking d →
            "ResizableBacking " ++ d.path

        Error.DetachedSource d →
            "DetachedSource " ++ d.path

        Error.Misaligned d →
            "Misaligned "
                ++ d.path
                ++ " "
                ++ String.fromInt d.value
                ++ " by "
                ++ String.fromInt d.alignment

        Error.OutOfRange d →
            "OutOfRange "
                ++ d.path
                ++ " "
                ++ String.fromInt d.offset
                ++ "+"
                ++ String.fromInt d.size
                ++ " of "
                ++ String.fromInt d.available

        Error.InvalidValue d →
            "InvalidValue " ++ d.path ++ " " ++ String.fromFloat d.value

        Error.InvalidMapMode d →
            "InvalidMapMode " ++ d.path ++ " " ++ String.fromInt d.bits

        Error.MissingBufferUsage d →
            "MissingBufferUsage " ++ d.path ++ " " ++ String.fromInt (Flags.bufferUsageBits d.usage)

        Error.MappingState d →
            "MappingState " ++ d.path ++ " " ++ Types.bufferMapStateToString d.state

        Error.RangeOverlap d →
            "RangeOverlap "
                ++ d.path
                ++ " "
                ++ String.fromInt d.offset
                ++ "+"
                ++ String.fromInt d.size

        Error.ReadOnlyMapping d →
            "ReadOnlyMapping " ++ d.path

        Error.EncoderLocked d →
            "EncoderLocked " ++ d.path

        Error.EncoderFinished d →
            "EncoderFinished " ++ d.path

        Error.PassEnded d →
            "PassEnded " ++ d.path

        Error.DebugStackEmpty d →
            "DebugStackEmpty " ++ d.path

        Error.CommandBufferSubmitted d →
            "CommandBufferSubmitted " ++ d.path

        Error.DuplicateCommandBuffer d →
            "DuplicateCommandBuffer " ++ d.path

        Error.ViewKindRequired d →
            "ViewKindRequired " ++ d.path

        Error.QueryActive d →
            "QueryActive " ++ d.path

        Error.QueryInactive d →
            "QueryInactive " ++ d.path

        Error.QuerySetMissing d →
            "QuerySetMissing " ++ d.path

        Error.QueryReused d →
            "QueryReused " ++ d.path ++ " " ++ String.fromInt d.index

        Error.SessionState Error.DeviceLeased →
            "SessionState DeviceLeased"

        Error.SessionState Error.SessionEnded →
            "SessionState SessionEnded"

        Error.SessionStopped →
            "SessionStopped"


--| A map failure, without the host's message.
pub mapError : Error.MapError → String
mapError m =
    case m of
        Error.MapRejected _ →
            "MapRejected"

        Error.MapAborted →
            "MapAborted"

        Error.MappedAllocationFailed a →
            "MappedAllocationFailed " ++ String.fromInt a.bytes

        Error.MappedRangeRejected _ →
            "MappedRangeRejected"


--| A documented host rejection, without its message.
pub operationFailure : Error.OperationFailure → String
operationFailure o =
    case o of
        Error.BufferWriteSourceRejected _ →
            "BufferWriteSourceRejected"

        Error.ImmediateWriteRejected _ →
            "ImmediateWriteRejected"


--| An input result's constructor, with `f` for an `Ok` value.
pub inputResult : Result Error.InputError a, (a → String) → String
inputResult r f =
    case r of
        Ok a →
            "Ok " ++ f a

        Err problem →
            "Err " ++ inputError problem


observation : Error.Observation → String
observation o =
    case o of
        Error.ObservedValidation _ →
            "Validation"

        Error.ObservedOutOfMemory _ →
            "OutOfMemory"

        Error.ObservedInternal _ →
            "Internal"

        Error.ObservedPipelineValidation _ →
            "PipelineValidation"

        Error.ObservedPipelineInternal _ →
            "PipelineInternal"

        Error.ObservedMapFailed m →
            "MapFailed " ++ mapError m

        Error.ObservedHostRejection _ →
            "HostRejection"


--| A checked result's constructor, with `f` for an `Ok` value.
pub checked : Result Error.Error a, (a → String) → String
checked r f =
    case r of
        Ok a →
            "Ok " ++ f a

        Err problem →
            "Err " ++ error problem


--| A canvas failure, without the host's message.
pub canvasError : Error.CanvasError → String
canvasError c =
    case c of
        Error.CanvasNotFound id →
            "CanvasNotFound " ++ id

        Error.WrongElementKind id →
            "WrongElementKind " ++ id

        Error.CanvasContextUnavailable →
            "CanvasContextUnavailable"

        Error.CanvasUnconfigured →
            "CanvasUnconfigured"

        Error.CanvasConfigurationRejected _ →
            "CanvasConfigurationRejected"
