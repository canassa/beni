--! The `gpu-test` platform's host for the WebGPU fixtures
--! (`docs/design/webgpu.md` §10): the failures a page cannot cause on its
--! own, injected into the host before a fixture's GPU work. Under happy-dom
--! and in a Chrome without WebGPU the host is a deterministic fake of
--! `navigator.gpu`; under `zig build test-webgpu` it is Chrome's own, and
--! each fault wraps the native method it is about.

import Binary
import Browser.Host.HTMLImageElement exposing (HTMLImageElement)
import Browser.Host.HTMLVideoElement exposing (HTMLVideoElement)
import Browser.Host.Uint32Array exposing (Uint32Array)
import Browser.Host.Uint8Array exposing (Uint8Array)
import Gpu.Handle exposing (ExternalTexture, Batch, Buffer, Device)
import Task


--| Prepare the host for scenarios, named and separated by commas: the host
--| starts as no fault touched it; `"none"` leaves it so, and each other
--| name, listed in `GpuHost.js`, makes one native call fail as the ledger
--| describes or as it never documents.
pub foreign impure inject : String → ⊤


--| Settle the loss of the latest device made since `inject
--| "lost-controlled"`: `"reject"` rejects its `lost` promise, and any other
--| text resolves it with that reason.
pub foreign impure lose : String → ⊤


--| Release every pop held since `inject "pops-held"`, the latest first.
pub foreign impure releasePops : ⊤ → ⊤


--| How many times the page called the native method `name` of a device.
pub foreign impure calls : String → Int


--| Settle the latest request held since `inject "requests-held"`:
--| `"host"` as the host answered it, `"reject-operation"` with an
--| `OperationError`, `"reject-unlisted"` with a `DOMException` the ledger
--| does not list.
pub foreign impure releaseRequest : String → ⊤


--| Call `f` once every request the host was asked has been answered and
--| the reactions it set off have run.
pub foreign impure later : sync (⊤ → ⊤) → ⊤


--| Wait in the calling fiber until `later` calls back.
pub drain : ⊤ → ⊤
drain ⊤ = Task.callback λresume →
    later λ⊤ → Task.resume resume ⊤
    λ⊤ → ⊤


--| Release only the latest pop of `filter` (`"validation"`,
--| `"out-of-memory"`, `"internal"`) held since `inject "pops-held"`.
pub foreign impure releasePop : String → ⊤


--| Settle every map held since `inject "maps-held"`, in the order they
--| were asked, each as its host map settled.
pub foreign impure releaseMaps : ⊤ → ⊤


--| A resizable `ArrayBuffer` of `bytes`, which `Binary` never makes.
pub foreign impure resizable : Int → Binary.Buffer


--| Whether the page has shared memory (`SharedArrayBuffer`).
pub foreign impure sharedMemory : ⊤ → Bool


--| A growable `SharedArrayBuffer` of `bytes`; only where `sharedMemory`.
pub foreign impure growable : Int → Binary.SharedBuffer


--| A `Uint8Array` over a resizable `ArrayBuffer` of `bytes`.
pub foreign impure resizableBytes : Int → Uint8Array


--| A `Uint8Array` over a growable `SharedArrayBuffer` of `bytes`; only
--| where `sharedMemory`.
pub foreign impure growableBytes : Int → Uint8Array


--| A `Uint32Array` of `count` words over a resizable `ArrayBuffer`.
pub foreign impure resizableWords : Int → Uint32Array


--| Keep `line` for `notes`: a fixture's record of what a synchronous
--| callback saw, whatever the callback's run returns.
pub foreign impure note : String → ⊤


--| Every line kept since the last call, in order.
pub foreign impure notes : ⊤ → List String


--| Keep a buffer for `kept`, past the callback that made it.
pub foreign impure keep : Buffer → ⊤


--| The buffer `keep` kept last.
pub foreign impure kept : ⊤ → Buffer


--| The render commands the page issued since the last call, oldest first,
--| as the fake host saw them: a handle shown by its label. Empty on a
--| native host.
pub foreign impure commands : ⊤ → List String


--| Queue a microtask that marks it ran: with `microtaskHasRun`, what shows
--| that no microtask ran between two points of one synchronous callback.
pub foreign impure armMicrotask : ⊤ → ⊤


--| Whether the microtask `armMicrotask` queued last has run.
pub foreign impure microtaskHasRun : ⊤ → Bool


--| Keep a batch for `keptBatch`, past the callback it was given to.
pub foreign impure keepBatch : Batch → ⊤


--| The batch `keepBatch` kept last.
pub foreign impure keptBatch : ⊤ → Batch


--| Make a call the engine never makes: a sampler the device refuses, made
--| outside every error scope, so the device reports its error as
--| uncaptured.
pub foreign impure escape : Device → ⊤


--| Dispatch an `uncapturederror` event on the device whose error is a
--| plain object named like a GPU error.
pub foreign impure escapeSpoofed : Device → ⊤


--| Log how many error scopes of the device are open three tasks later.
pub foreign impure logScopesLater : Device → ⊤


--| Throw a native `TypeError` with `message`.
pub foreign impure fail : String → ⊤


--| How many error scopes of the device are open now.
pub foreign impure openScopes : Device → Int


--| Write `line` to the console: what a page that stops still shows.
pub foreign impure log : String → ⊤


--| Raise the flag `name`, until the next `inject`.
pub foreign impure raise : String → ⊤


--| Whether the flag `name` is raised.
pub foreign impure raised : String → Bool


--| Make an image element of the opaque RGBA `pixels`, `width` wide, in the
--| state `kind` names, and call `done` with it once it is in that state:
--| `"same"` loaded from the page's origin, `"cross"` loaded from another
--| origin without CORS (not origin-clean), `"broken"` whose load failed,
--| `"loading"` still loading, `"empty"` with no source. On the fake host
--| the element only reports that state.
pub foreign impure image : String, Binary.Buffer, Int, sync (HTMLImageElement → ⊤) → ⊤


--| Make a video element showing the opaque RGBA `pixels`, `width` wide, and
--| call `done` with it: `"ready"` once it shows a frame of them, `"empty"`
--| with no source at all. On the fake host the element only reports that
--| state.
pub foreign impure video : String, Binary.Buffer, Int, sync (HTMLVideoElement → ⊤) → ⊤


--| Log `label` and what `probe` answers three tasks later: after a throw,
--| once the runtime's teardown ran.
pub foreign impure logLater : String, sync (⊤ → String) → ⊤


--| End the hold that every image or video load since the last call put on
--| the driver's settle of a step (`image`, `video`). `GpuPage` calls it once
--| a scenario returned its lines.
pub foreign impure releaseMedia : ⊤ → ⊤


--| Whether two external textures are the same native object.
pub foreign impure sameObject : ExternalTexture, ExternalTexture → Bool
