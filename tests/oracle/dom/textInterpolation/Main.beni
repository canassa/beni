-- dom-expressions' `textInterpolation` client fixture, in beni. Left out:
-- the roots whose root is a component (`escape2`, `trailingSpaceComp`,
-- `leadingSpaceComponent`, `trailingSpaceComponent`,
-- `escapeCompAttribute`) and the fragments of one hole
-- (`trailingSpaceFrag`, `leadingSpaceFragment`, `trailingSpaceFragment`),
-- which have no template in dom-expressions' output.
import Html exposing (Html)


type alias Values =
    { name : String, greeting : String, expr : Html ⊤, s : String, value : String, number : Int }


pub trailing : Html msg
trailing =
    <span>Hello </span>


pub leading : Html msg
leading =
    <span> John</span>


pub extraSpaces : Html msg
extraSpaces =
    <span>Hello   John</span>


pub trailingExpr : Values → Html ⊤
trailingExpr v =
    <span>Hello {v.name}</span>


pub leadingExpr : Values → Html ⊤
leadingExpr v =
    <span>{v.greeting} John</span>


pub multiExpr : Values → Html ⊤
multiExpr v =
    <span>{v.greeting} {v.name}</span>


pub multiExprSpaced : Values → Html ⊤
multiExprSpaced v =
    <span> {v.greeting} {v.name} </span>


pub multiExprTogether : Values → Html ⊤
multiExprTogether v =
    <span> {v.greeting}{v.name} </span>


pub multiLine : Html msg
multiLine =
    <span>

      Hello

    </span>


pub multiLineTrailingSpace : Html msg
multiLineTrailingSpace =
    <span>
      Hello
      John
    </span>


pub multiLineNoTrailingSpace : Html msg
multiLineNoTrailingSpace =
    <span>
      Hello
      John
    </span>


pub escape : Html msg
escape =
    <span>
      &nbsp;&lt;Hi&gt;&nbsp;
    </span>


pub escape3 : Html msg
escape3 =
    <>
      &nbsp;&lt;Hi&gt;&nbsp;
    </>


pub injection : Html msg
injection =
    <span>Hi{"<script>alert();</script>"}</span>


pub evaluated : Values → Html ⊤
evaluated v =
    <span>Hello {v.value ++ "!"}</span>


pub evaluatedNonString : Values → Html ⊤
evaluatedNonString v =
    <span>4 + 5 = {v.number}</span>


pub newLineLiteral : Values → Html ⊤
newLineLiteral v =
    <div>{v.s}{"\n"}d</div>


pub trailingSpace : Values → Html ⊤
trailingSpace v =
    <div>
      {v.expr}
    </div>


pub leadingSpaceElement : Values → Html ⊤
leadingSpaceElement v =
    <span> {v.expr}</span>


pub trailingSpaceElement : Values → Html ⊤
trailingSpaceElement v =
    <span>{v.expr} </span>


pub escapeAttribute : Html msg
escapeAttribute =
    <div normal="Search&hellip;" title={"Search&hellip;"} />


pub lastElementExpression : Values → Html ⊤
lastElementExpression v =
    <div><div></div>{v.expr}</div>


pub messwithTemplates : Html msg
messwithTemplates =
    <p>{"\${blah}"}</p>
