-- dom-expressions' `attributeExpressions` client fixture, in beni: class
-- and style objects are class and style lists written in place, a bare
-- attribute the vocabulary does not type is the quoted escape with an empty
-- value, and an attribute written `false` is not written. Left out: the
-- roots with a spread, `ref`, a `prop:` or `@static` annotation, a
-- computed or spread key in a class or style object, `onclick` as a
-- string, an attribute written twice, `_hk`, and `this`.
import Html exposing (Html)


type alias State =
    { id : String, color : String, name : String, content : String, visible : Bool }


pub template3 : State → Html msg
template3 state =
    <div
        "foo"=""
        id={state.id}
        style={[ ( "background-color", state.color ) ]}
        name={state.name}
        textContent={state.content}
    />


pub template5 : Html msg
template5 =
    <div class="a" className="b"></div>


pub template6 : List (String × String) → Html msg
template6 someStyle =
    <div style={someStyle} textContent="Hi" />


pub template13 : Html msg
template13 =
    <input type="checkbox" checked={True} />


pub template14 : State → Html msg
template14 state =
    <input type="checkbox" checked={state.visible} />


pub template15 : Html msg
template15 =
    <div class="`a">`$`</div>


pub template16 : Html msg
template16 =
    <button class={[ ( "static", True ), ( "hi", True ) ]} type="button">
        Write
    </button>


pub template17 : Html ⊤
template17 =
    <button class={[ ( "a", True ), ( "b", True ), ( "c", True ) ]} onClick={⊤}>
        Hi
    </button>


pub template20 : { s : String, min : String, max : String, s2 : Bool, value : Bool } → Html ⊤
template20 r =
    <div>
        <input value={r.s} min={r.min} max={r.max} onInput={λ_ → ⊤} readonly />
        <input checked={r.s2} min={r.min} max={r.max} onInput={λ_ → ⊤} readonly={r.value} />
    </div>


pub template22 : Html msg
template22 =
    <div data="\"hi\"" data2={"\""} />


pub template30 : Html msg
template30 =
    <div
        class="class1 class2\n    class3 class4\n    class5 class6"
        style="color: red;\n    background-color: blue !important;\n    border: 1px solid black;\n    font-size: 12px;"
        random="random1 random2\n    random3 random4"
    />


