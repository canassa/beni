# Three subscriptions, one request.
frames
# The first delta is the 16 ms since the subscriptions started at 0.
frame 3
# A frame's messages render before its task ends.
frame 1 10 tasks
# Off: the request is cancelled, and a frame runs nothing.
click #toggle
frames
frame 2
advance 100
# On again at 190: the next frame's delta is the 16 ms since then.
click #toggle
frames
frame 1
