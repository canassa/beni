-- The subscription tap builder preserves its borrowed dictionary value.
-- Copying the outer tap list keeps other entries and old dictionaries
-- unchanged when the input has aliases (ownership-checker.md, the dated
-- subscription tap builder amendment).
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


want : Int, Int, Dict Int (Int × List Int) → Dict Int (Int × List Int)
want k t d =
    ( first, taps ) = Maybe.withDefault (Dict.get d k) ( 0, [] )
    Dict.insert d k ( first, List.append (List.copy taps) [ t ] )


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                taps = [ 1 ]
                old = Dict.insert (Dict.insert Dict.empty 1 ( 0, taps )) 2 ( 0, taps )
                changed = want 1 2 old
                ( size changed 1, size changed 2, size old 1 )
        , update = λ_ model → model
        , view = λ( a, b, c ) → <p>{a}:{b}:{c}</p>
        }


size : Dict Int (Int × List Int), Int → Int
size model k =
    ( _, taps ) = Maybe.withDefault (Dict.get model k) ( 0, [] )
    List.length taps
