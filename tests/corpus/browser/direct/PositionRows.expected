-- load
<body>
  <main>
    <button id="insert">"insert"</button>
    <button id="remove">"remove second"</button>
    <button id="prepend">"prepend"</button>
    <button id="swap">"swap"</button>
    <button id="dropeven">"drop even"</button>
    <button id="reverse">"reverse"</button>
    <ol>
      <li title="0">
        <input .value="">
        "a"
        " at "
        "0"
      </li>
      <li title="1">
        <input .value="">
        "b"
        " at "
        "1"
      </li>
      <li title="2">
        <input .value="">
        "c"
        " at "
        "2"
      </li>
    </ol>
  </main>
</body>
