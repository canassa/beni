-- load
<body>
  <main>
    <button id="edit">"edit"</button>
    <button id="swap">"swap"</button>
    <button id="prefix">"prefix"</button>
    <button id="quiet">"quiet"</button>
    <ul id="keyed">
      <li>
        <input .value="">
        <span title=">">
          <b>"a"</b>
        </span>
      </li>
      <li>
        <input .value="">
        <span title=">">
          <b>"b"</b>
        </span>
      </li>
    </ul>
    <ul id="positional">
      <li>
        <span title=">">
          <b>"a"</b>
        </span>
      </li>
      <li>
        <span title=">">
          <b>"b"</b>
        </span>
      </li>
    </ul>
  </main>
</body>
-- click #quiet
(the DOM did not change)
