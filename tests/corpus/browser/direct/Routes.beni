-- The other half of the milestone's acceptance page (see `ApiLogin`): an
-- application that routes (boundary.md §9.8.13) with no API. Started at
-- `/login`, a click on an in-page link is `onUrlRequest`, `pushUrl` makes
-- the change and `onUrlChange` renders the route; the title is the
-- route's. With no token, `/items` asks for nothing. `back` returns to
-- each earlier route and the page and the location follow.
import Browser
import Browser.Navigation as Navigation
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea
import Url exposing (Url)
import Url.Parser exposing (Parser, map, oneOf, s)


type Route
    = Login
    | Items
    | NotFound


route : Parser (Route → a) a
route = oneOf [ s "login" ▷ map Login, s "items" ▷ map Items ]


toRoute : Url → Route
toRoute url = Maybe.withDefault (Url.Parser.parse route url) NotFound


type Msg
    = ClickedLink Browser.UrlRequest
    | UrlChanged Url
    | Refused Navigation.Error


type alias Model =
    key : Navigation.Key
    route : Route
    log : List String


init : Url, Navigation.Key → Model × Cmd Msg
init url key = ( { key = key, route = toRoute url, log = [] }, Cmd.none )


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        ClickedLink (Browser.Internal url) →
            ( model, Navigation.pushUrl model.key (Url.toString url) Refused )

        ClickedLink (Browser.External href) →
            ( { model | log = model.log ++ [ "external ${href}" ] }, Cmd.none )

        UrlChanged url →
            ( { model | route = toRoute url }, Cmd.none )

        Refused _ →
            ( { model | log = model.log ++ [ "refused" ] }, Cmd.none )


title : Route → String
title r =
    case r of
        Login →
            "Sign in"

        Items →
            "Items"

        NotFound →
            "Not found"


page : Model → Html Msg
page model =
    case model.route of
        Login →
            <p>sign in</p>

        Items →
            <p>items</p>

        NotFound →
            <p>nothing here</p>


view : Model → Tea.Document Msg
view model =
    { title = title model.route
    , body =
        <main>
            <nav>
                <a id="login" href="/login">login</a>
                <a id="items" href="/items">items</a>
            </nav>
            <h1>{title model.route}</h1>
            {page model}
            <ol><For each={model.log} keyed={False}>{λline → <li>{line}</li>}</For></ol>
        </main>
    }


main : Tea.Program
main =
    Tea.application
        { init = init
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        , onUrlRequest = ClickedLink
        , onUrlChange = UrlChanged
        }
