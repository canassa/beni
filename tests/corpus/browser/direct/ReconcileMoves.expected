-- load
<body>
  <main>
    <button id="firstlast">"first last"</button>
    <button id="ends">"ends"</button>
    <button id="reverse">"reverse"</button>
    <button id="keep">"keep middle"</button>
    <ul>
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
      <li>
        <input .value="">
        "e"
      </li>
    </ul>
  </main>
</body>
