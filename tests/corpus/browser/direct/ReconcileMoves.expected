-- focus li:nth-child(3)>input
<body>
  <main>
    <button id="firstlast">"first last"</button>
    <button id="ends">"ends"</button>
    <button id="reverse">"reverse"</button>
    <button id="keep">"keep middle"</button>
    <ul>
      <li>
        <input .value="1">
        "a"
      </li>
      <li>
        <input .value="2">
        "b"
      </li>
      <li>
        <input .value="3" :focus>
        "c"
      </li>
      <li>
        <input .value="4">
        "d"
      </li>
      <li>
        <input .value="5">
        "e"
      </li>
    </ul>
  </main>
</body>
-- click #firstlast
<body>
  <main>
    <button id="firstlast">"first last"</button>
    <button id="ends">"ends"</button>
    <button id="reverse">"reverse"</button>
    <button id="keep">"keep middle"</button>
