-- Events across a value slot (browser-direct.md's S4 amendment, item 1;
-- §4.2): markup on the value path — `Other`'s, another module's, and the
-- `Box` component's — listens on its own nodes, so the DOM's bubbling
-- orders its handlers against this platform's own as Elm orders handlers,
-- innermost first, and a declaration that stops propagation stops both
-- kinds:
--
--   - a value-path button inside an element whose handler this platform
--     writes: the button, the element, then `main`;
--   - a value-path stopper inside that element: what is below it, then it,
--     and nothing above;
--   - a value-path button inside a stopper this platform writes: the
--     button, the stopper, and nothing above;
--   - value-path markup with a handler of its own around more of it (a
--     component and its children): the child, the box, then `main`.
--
-- No element this platform writes can stand inside markup on the value
-- path, which is `dom`'s to its leaves; the last case is the order inside
-- one value slot.
import Box
import Html exposing (Html)
import Other
import Stop exposing (Event)
import Tea


type alias Model =
    log : List String


hit : String, Model → Model
hit what model = { model | log = List.push model.log what }


view : Model → Html String
view model =
    <main onClick={"main"}>
        <div id="outer" onClick={"outer"}>
            {Other.button "inner" "inner"}
            {Other.stopper "vstop" "value stopper"}
        </div>
        <div id="dstop" onClickStop={"direct stopper"}>{Other.button "below" "below"}</div>
        <Box msg={"box"}><button id="child" onClick={"child"}>child</button></Box>
        <p id="log">{String.join model.log ", "}</p>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { log = [] }, update = hit, view = view }
