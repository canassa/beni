# A value-path button inside a direct element: the button, the element, main.
click #inner
# A value-path stopper: its button, then it; nothing above.
click #vstop-in
click #vstop
# A value-path button inside a direct stopper: the button, the stopper.
click #below
# Inside one value slot: the child, the box, then main.
click #child
click #box
