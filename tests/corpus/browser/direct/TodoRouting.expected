<body>
  <section class="todoapp">
    <header class="header">
      <h1>"todos"</h1>
      <input id="new-todo" class="new-todo" placeholder="What needs to be done?" autofocus="" .value="" :focus>
    </header>
    <section class="main">
      <input id="toggle-all" class="toggle-all" type="checkbox" .value="on" .checked=false>
      <label for="toggle-all">"Mark all as complete"</label>
      <ul class="todo-list">
        <li class="completed">
          <div class="view">
            <input class="toggle" type="checkbox" .value="on" .checked=true>
            <label>"first"</label>
            <button class="destroy"></button>
          </div>
        </li>
        <li>
          <div class="view">
            <input class="toggle" type="checkbox" .value="on" .checked=false>
            <label>"second"</label>
            <button class="destroy"></button>
          </div>
        </li>
      </ul>
    </section>
    <footer class="footer">
      <span class="todo-count">
        <strong>"1"</strong>
        " item left"
      </span>
      <ul class="filters">
        <li>
          <a href="#/" class="selected">"All"</a>
        </li>
        <li>
          <a href="#/active">"Active"</a>
        </li>
        <li>
          <a href="#/completed">"Completed"</a>
        </li>
      </ul>
      <button id="clear-completed" class="clear-completed">"Clear completed"</button>
    </footer>
  </section>
</body>
