-- The computed root selector is shared by all handlers, but reads the
-- current model at each call. Parameterised template masks stay per key.
import Html exposing (Html)
import Tea


type Msg
    = Toggle
    | Inc
    | Quiet


type alias Model =
    open : Bool
    n : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | open = not model.open }
        Inc →
            { model | n = model.n + 1 }
        Quiet →
            model


view : Model → Html Msg
view model =
    case model.open of
        True →
            <main>
                <button onClick={Toggle}>toggle</button><button onClick={Inc}>inc</button><p>{model.n}</p>
            </main>
        False →
            <main>
                <button onClick={Toggle}>toggle</button><button onClick={Quiet}>quiet</button><p>closed</p>
            </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { open = True, n = 0 }, update = update, view = view }
