-- load
<body>
  <main>
    <button id="relabel">"relabel"</button>
    <button id="mark">"mark"</button>
    <button id="toggle">"toggle"</button>
    <button id="append">"append"</button>
    <button id="remove">"remove"</button>
    <button id="swap">"swap"</button>
    <button id="clear">"clear"</button>
    <ul id="alone">
      <li class="">
        <input .value="">
        "one"
        " "
        "0"
        <!---->
      </li>
      <li class="">
        <input .value="">
        "two"
        " "
        "0"
        <!---->
      </li>
      <li class="">
        <input .value="">
        "three"
        " "
        "0"
        <!---->
      </li>
    </ul>
    <ol id="framed">
      <li>"first"</li>
      <li>"one"</li>
      <li>"two"</li>
      <li>"three"</li>
      <li>"last"</li>
    </ol>
  </main>
</body>
