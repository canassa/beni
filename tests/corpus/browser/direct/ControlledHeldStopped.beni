-- A control held to be put back in a task is left alone once the page has
-- stopped (browser-direct.md §8.1, §8.2; S4's amendment, item 2): a click
-- on a controlled checkbox changes it before the click is dispatched, so
-- the capture listener marks it and holds it for the task after the event;
-- the click's own handler throws, which stops the page before its dispatch
-- reconciles anything. The task then finds the page stopped and runs
-- nothing — the box stays as the click left it, under the crash screen.
-- The release build has no crash screen (`.release-expected`).
import Html exposing (Html)
import Tea


type Msg
    = Toggle Bool


type alias Model =
    on : Bool


view : Model → Html Msg
view m =
    <main>
        <input id="box" type="checkbox" checked={m.on} onClick={λ_ → Debug.todo "handler threw"} />
    </main>


main : Tea.Program
main =
    Tea.sandbox { init = λ⊤ → { on = False }, update = λ(Toggle b) m → { m | on = b }, view = view }
