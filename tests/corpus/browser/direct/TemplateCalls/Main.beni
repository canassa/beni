-- One parameterised template is used through nested helpers and from two
-- sites with different projections. No-op writes must enter no groups.
import Helpers
import Html exposing (Html)
import Tea


type alias Model =
    left : Int
    right : Int


type Msg
    = Left
    | Right
    | Quiet


update : Msg, Model → Model
update msg model =
    case msg of
        Left →
            { model | left = model.left + 1 }
        Right →
            { model | right = model.right + 1 }
        Quiet →
            model


view : Model → Html Msg
view model =
    <main>
        <button id="left" onClick={Left}>left</button>
        <button id="right" onClick={Right}>right</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
        {Helpers.outer "a" model.left}
        {Helpers.outer "b" model.right}
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { left = 0, right = 10 }, update = update, view = view }
