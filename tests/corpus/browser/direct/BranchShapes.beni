-- Branch shapes the arm binding must hold (§5.5; S4's review): an `else
-- if` chain, flattened into one branch of three arms; a `case` whose arms
-- match nested patterns, literals and tuples, each binding variables the
-- arm's markup reads; and a branch nested in an arm whose button's handler
-- reads both arms' variables when it fires.
import Html exposing (Html)
import Tea


type alias User =
    name : String
    admin : Bool


type Msg
    = Step
    | Pick String Int


type alias Model =
    n : Int
    user : Maybe User
    picked : String


update : Msg, Model → Model
update msg model =
    case msg of
        Step →
            { model
                | n = model.n + 1
                , user =
                    if model.n == 0 then
                        Just { name = "ann", admin = False }
                    else
                        Just { name = "bob", admin = True }
            }

        Pick name n →
            { model | picked = "${name} ${String.fromInt n}" }


view : Model → Html Msg
view model =
    <main>
        <button id="step" onClick={Step}>step</button>
        <p id="picked">{model.picked}</p>
        {if model.n == 0 then
            <p>zero</p>
         else if model.n == 1 then
            <p>one {model.n}</p>
         else
            <p>many {model.n}</p>
        }
        {case ( model.n, model.user ) of
            ( 0, _ ) →
                <p>nobody yet</p>

            ( 1, Just { name } ) →
                <p>first {name}</p>

            ( k, Just u ) →
                <div>
                    {if u.admin then
                        <button id="pick" onClick={Pick u.name k}>pick {u.name}</button>
                     else
                        <span>{u.name}</span>
                    }
                </div>

            ( _, Nothing ) →
                <p>gone</p>
        }
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { n = 0, user = Nothing, picked = "" }
        , update = update
        , view = view
        }
