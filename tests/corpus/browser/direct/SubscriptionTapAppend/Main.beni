-- Destructive focus transfers the selected list to the callback.
-- The isolated helper passes; its opaque-tap fold remains pending.
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


want : Int, Int, Dict Int (Int × List Int) → Dict Int (Int × List Int)
want k t d = Dict.update d k λcurrent →
    ( first, taps ) = Maybe.withDefault current ( 0, [] )
    Just ( first, List.append taps [ t ] )


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → want 1 2 (Dict.insert Dict.empty 1 ( 0, [ 1 ] ))
        , update = λ_ model → model
        , view = view
        }


view : Dict Int (Int × List Int) → Html {}
view model =
    ( _, taps ) = Maybe.withDefault (Dict.get model 1) ( 0, [] )
    <p>{List.length taps}</p>
