-- `Browser.Navigation`'s commands (boundary.md §9.8.17): elm/browser's
-- `pushUrl`, `replaceUrl`, `back`, `forward` and `load`, each taking the
-- values `update` computed and a message for a refusal. A change that is
-- made sends nothing of its own — `onUrlChange` hears it, as from the
-- direct forms — and one that is refused sends its refusal, typed
-- (CLAUDE.md rule 9): a push to another origin, a replace that does not
-- resolve, a `javascript:` load. `back` with `0` does nothing and sends
-- nothing. A load that is made leaves the page, and so does `reload`: the
-- driver stops each and logs it (tests/corpus/README.md), and the address
-- stays (a load that stays in the document: `browser/tea/NavigateFragment`).
import Browser.Navigation as Navigation exposing (Key)
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea
import Url exposing (Url)


type Msg
    = Push String
    | Replace String
    | Back Int
    | Forward Int
    | Load String
    | Reload
    | Refused String Navigation.Error
    | Changed Url


type alias Model =
    key : Key
    lines : List String


shown : Navigation.Error → String
shown error =
    case error of
        Navigation.BadUrl url →
            "BadUrl ${url}"

        Navigation.CrossOrigin url →
            "CrossOrigin ${url}"

        Navigation.Throttled →
            "Throttled"


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Push url →
            ( model, Navigation.pushUrl model.key url (Refused "push" _) )

        Replace url →
            ( model, Navigation.replaceUrl model.key url (Refused "replace" _) )

        Back n →
            ( model, Navigation.back model.key n (Refused "back" _) )

        Forward n →
            ( model, Navigation.forward model.key n (Refused "forward" _) )

        Load url →
            ( model, Navigation.load url (Refused "load" _) )

        Reload →
            ( model, Navigation.reload )

        Refused label error →
            ( { model | lines = model.lines ++ [ "${label} refused: ${shown error}" ] }, Cmd.none )

        Changed url →
            ( { model | lines = model.lines ++ [ "changed to ${url.path}" ] }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <button id="push" onClick={Push "/a"}>push</button>
        <button id="away" onClick={Push "https://example.com/x"}>away</button>
        <button id="replace" onClick={Replace "/r"}>replace</button>
        <button id="bad" onClick={Replace "http://["}>bad</button>
        <button id="none" onClick={Back 0}>none</button>
        <button id="script" onClick={Load "javascript:alert(1)"}>script</button>
        <button id="load" onClick={Load "/elsewhere?q=1"}>load</button>
        <button id="reload" onClick={Reload}>reload</button>
        <ol><For each={model.lines} keyed={False}>{λline → <li>{line}</li>}</For></ol>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { key = Navigation.key ⊤, lines = [] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Navigation.onUrlChange Changed
        }
