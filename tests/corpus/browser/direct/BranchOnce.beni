-- A branch's value is evaluated once for each choice of its arm (§5.5; S4's
-- review): its scrutinee, the `let`s around it and the arm's own `let`s
-- give the arm taken and what binds it together, and every group, list,
-- nested branch and listener of the arm reads that, never the value
-- evaluated again. A scrutinee made on every evaluation (`Random.value`)
-- chose one arm and then bound another's variables in a group — a
-- `TypeError` on `null` — and an arm `let` that draws showed two values in
-- one arm. Each message draws once, as `browser-tea`'s render does, and
-- both holes of the arm show the one draw.
import Html exposing (Html)
import Random
import Tea


type Msg
    = Roll


type alias Model =
    rolls : Int


view : Model → Html Msg
view model =
    <main>
        <button id="roll" onClick={Roll}>roll {model.rolls}</button>
        {if Random.value (Random.int 0 1) == 0 then
            n = Random.value (Random.int 1 6)
            <b><span>{n}</span><span>{n}</span></b>
         else
            <i>{model.rolls}</i>
        }
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { rolls = 0 }, update = λRoll m → { m | rolls = m.rolls + 1 }, view = view }
