-- Animation-frame subscriptions (boundary.md §9.8.18). Three are live
-- while `on`: two declarations of `onAnimationFrameDelta`, one key, and an
-- `onAnimationFrame` — and every frame runs ONE callback, the page's one
-- request, whatever the number of subscriptions. The first delta counts
-- from when the subscriptions started, each later one from the frame
-- before. A frame's messages render inside the frame's task, before the
-- frame is drawn: the view's log comes before `(the frame's task ended)`.
-- Turned off, the page asks for no frame at all; turned on again, the
-- clock starts afresh, so the gap is not a delta.
import Browser.Events
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Tea
import Time


type Msg
    = Delta Float
    | Also Float
    | At Time.Posix
    | Toggle


type alias Model =
    on : Bool
    frames : Int
    also : Int
    elapsed : Float
    at : Int


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Delta d →
            ( { model | frames = model.frames + 1, elapsed = model.elapsed + d }, Cmd.none )

        Also _ →
            ( { model | also = model.also + 1 }, Cmd.none )

        At t →
            ( { model | at = Time.toMillis t }, Cmd.none )

        Toggle →
            ( { model | on = not model.on }, Cmd.none )


subscriptions : Model → Sub Msg
subscriptions model =
    if model.on then
        Sub.batch
            [ Browser.Events.onAnimationFrameDelta Delta
            , Browser.Events.onAnimationFrame At
            , Browser.Events.onAnimationFrameDelta Also
            ]
    else
        Sub.none


elapsed : Model → String
elapsed model = String.fromFloat model.elapsed


view : Model → Html Msg
view model =
    <main>
        <button id="toggle" onClick={Toggle}>toggle</button>
        <p>{Debug.log "view" (String.fromInt model.frames)} frames, {elapsed model} ms</p>
        <p>also {String.fromInt model.also}, at {String.fromInt model.at}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { on = True, frames = 0, also = 0, elapsed = 0, at = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
