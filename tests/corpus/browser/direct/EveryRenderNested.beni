-- `browser/dom/EveryRenderNested` on `browser-direct` (§5.3; S4's
-- amendment, item 3): a value that may have an effect is evaluated on
-- every message wherever it stands — here in an `if` hole's arm —
-- whatever the fields it reads: its group is every handler's, and the arm
-- shown is visited for it. `Random.value` draws anew on each message, so
-- the lines change on a message that touches none of the fields they read.
-- Two draws in one dispatch — the arm's and the helper's after it — are
-- made in the order each platform makes them, at the mount as on each
-- message: this one's groups and branches in the order it plans them
-- (§4.1 step 3), `dom`'s order of first writes on `browser-tea`, so the two
-- pages show the same draws swapped
-- (`.tea-expected`, a documented difference of the two platforms; both
-- orders are functions of the model). The original's `let` that calls the
-- helper is left out: a `let` of `view` that may have an effect is
-- refused on this platform (`build/bad/direct/ViewLetEffect`).
import Html exposing (Html)
import Random
import Tea


type Msg
    = Other


type alias Model =
    n : Int
    o : Int


update : Msg, Model → Model
update msg m =
    case msg of
        Other →
            { m | o = m.o + 1 }


roll : Int → Int
roll k = k + Random.value (Random.int 1 1000000)


view : Model → Html Msg
view m =
    <main>
        <button id="other" onClick={Other}>other</button>
        <p id="o">{m.o}</p>
        {if m.n > 100 then <b>x</b> else <i id="nested">{Random.value (Random.int 1 1000000)}</i>}
        <p id="helper">{roll m.n}</p>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { n = 0, o = 0 }, update = update, view = view }
