-- focus #k3
<body>
  <main>
    <button id="swap">"swap"</button>
    <button id="ends">"ends"</button>
    <button id="relabel">"relabel"</button>
    <button id="duplicate">"duplicate"</button>
    <ul id="keyed">
      <li>
        <input id="k1" .value="">
        "one"
      </li>
      <li>
        <input id="k2" .value="typed">
        "2"
      </li>
      <li>
        <input id="k3" .value="" :focus>
        "three"
      </li>
    </ul>
    <ul id="position">
      <li>
        <input .value="">
        "one"
      </li>
      <li>
        <input .value="typed">
        "2"
      </li>
      <li>
        <input .value="">
        "three"
      </li>
    </ul>
    <ul id="tags">
      <li>"a"</li>
      <li>"b"</li>
      <li>"a"</li>
    </ul>
  </main>
</body>
