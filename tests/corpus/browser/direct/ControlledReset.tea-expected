-- load
<body>
  <main>
    <button id="tick">"0"</button>
    <form id="form">
      <input id="text" .value="ab">
      <input id="box" type="checkbox" .value="on" .checked=true>
      <select id="sel" .value="b">
        <option value="a">"a"</option>
        <option value="b">"b"</option>
      </select>
      <input id="plain" .value="">
      <button id="reset" type="reset">"reset"</button>
    </form>
  </main>
</body>
