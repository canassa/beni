-- click #reset
<body>
  <main>
    <button id="tick">"0"</button>
    <form id="form">
      <input id="text" .value="">
      <input id="box" type="checkbox" .value="on" .checked=false>
      <select id="sel" .value="a">
        <option value="a">"a"</option>
        <option value="b">"b"</option>
      </select>
      <input id="plain" .value="">
      <button id="reset" type="reset">"reset"</button>
    </form>
  </main>
</body>
