-- load
<body>
  <main>
    <button id="remove">"remove"</button>
    <button id="insert">"insert"</button>
    <button id="prepend">"prepend"</button>
    <button id="swap">"swap"</button>
    <button id="rekey">"rekey"</button>
    <ul id="removed">
      <li>
        <input .value="">
        "one"
      </li>
      <li>
        <input .value="">
        "two a"
      </li>
      <li>
        <input .value="">
        "two b"
      </li>
      <li>
        <input .value="">
        "two c"
      </li>
    </ul>
    <ul id="inserted">
      <li>
        <input .value="">
        "one"
      </li>
      <li>
        <input .value="">
        "two a"
      </li>
      <li>
        <input .value="">
        "two b"
      </li>
    </ul>
    <ul id="prepended">
      <li>
        <input .value="">
        "two a"
      </li>
      <li>
        <input .value="">
        "two b"
      </li>
    </ul>
    <ul id="swapped">
      <li>
        <input .value="">
        "two a"
      </li>
      <li>
        <input .value="">
        "one"
      </li>
      <li>
        <input .value="">
        "two b"
      </li>
    </ul>
    <ul id="rekeyed">
      <li>
        <input .value="">
        "two a"
      </li>
      <li>
        <input .value="">
        "two b"
      </li>
    </ul>
  </main>
</body>
