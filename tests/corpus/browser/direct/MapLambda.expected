-- load
<body>
  <main>
    <p id="log">""</p>
    <span>
      <button id="lambda-ping">"ping"</button>
      <button id="lambda-pong">"pong"</button>
    </span>
    <span>
      <button id="tagged-ping">"ping"</button>
      <button id="tagged-pong">"pong"</button>
    </span>
    <span>
      <button id="nested-ping">"ping"</button>
      <button id="nested-pong">"pong"</button>
    </span>
  </main>
</body>
