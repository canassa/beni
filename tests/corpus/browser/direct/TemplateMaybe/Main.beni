-- A held Maybe Html slot changes between a runtime text and a template.
import Helpers
import Html exposing (Html)
import Tea


type alias Model =
    show : Bool
    text : Bool
    n : Int


type Msg
    = Show
    | Text
    | Inc
    | Quiet


update : Msg, Model → Model
update msg model =
    case msg of
        Show →
            { model | show = not model.show }
        Text →
            { model | text = not model.text }
        Inc →
            { model | n = model.n + 1 }
        Quiet →
            model


view : Model → Html Msg
view model =
    <main>
        <button id="show" onClick={Show}>show</button>
        <button id="text" onClick={Text}>text</button>
        <button id="inc" onClick={Inc}>inc</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
        <section>{Helpers.optional model.show model.text model.n}</section>
    </main>


main : Tea.Program
main =
    Tea.sandbox { init = λ⊤ → { show = True, text = False, n = 0 }, update = update, view = view }
