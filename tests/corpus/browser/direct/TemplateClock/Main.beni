-- Host-dependent helper arguments retain their every-render semantics.
import Helpers
import Html exposing (Html)
import Tea
import Time


type Msg
    = Tick
    | Quiet


view : Int → Html Msg
view model =
    <main>
        <button id="tick" onClick={Tick}>tick</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
        {Helpers.inner (Time.toMillis (Time.now ⊤))}
        <i>{model}</i>
    </main>


update : Msg, Int → Int
update msg model =
    case msg of
        Tick →
            model + 1
        Quiet →
            model


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = update, view = view }
