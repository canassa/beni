-- A value-path handler's event fired by a handler's own write is delivered
-- (browser-direct.md, *Amended 2026-10-10 (the owner)*; S4's value path): an
-- input in a `Maybe Html` hole — `dom`'s kind, listening on its own node —
-- is focused, and a click's handler takes the hole away. Chrome blurs the
-- input as it goes, while the click's dispatch runs, so the blur's body is
-- queued; what it delivers to — the program's mount node above the input,
-- its handler — is read as the blur fires, when the input still has a
-- parent, not when the body runs, when it has none. The blur's message is
-- sent after the click's (`.chrome-expected`, both platforms). happy-dom
-- fires no blur on a removal (`.expected`).
import Html exposing (Html)
import Tea


type Msg
    = Hide
    | Blurred String


type alias Model =
    shown : Bool
    log : String


update : Msg, Model → Model
update msg model =
    case msg of
        Hide →
            { model | shown = False, log = model.log ++ " hide" }

        Blurred s →
            { model | log = model.log ++ " blur " ++ s }


field : Html Msg
field = <input id="in" onBlur={Blurred "in"} />


view : Model → Html Msg
view model =
    <main>
        <p id="log">{model.log}</p>
        <button id="hide" onClick={Hide}>hide</button>
        {if model.shown then Just field else Nothing}
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { shown = True, log = "" }, update = update, view = view }
