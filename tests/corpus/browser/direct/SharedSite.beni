-- A helper the size gate keeps shared (browser-direct.md §5.2, as amended
-- for S3): `card` is one element with several dynamic holes and a button,
-- called four times from `view` with arguments that read the model, so its
-- four copies would be larger than one shared template, its `make` and
-- groups, and four instances. Each call's instance holds its arguments as
-- a function of the model; a message calls a shared group only on the
-- calls whose arguments its writes reach (`Rename` writes the title two
-- calls read: only those two cards' groups run), and each card's button
-- sends its own message, read through to the call's argument.
import Browser
import Html exposing (Html)
import Tea


type Msg
    = Bump Int
    | Rename String


type alias Model =
    a : Int
    b : Int
    c : Int
    d : Int
    title : String


update : Msg, Model → Model
update msg model =
    case msg of
        Bump which →
            if which == 1 then
                { model | a = model.a + 1 }
            else if which == 2 then
                { model | b = model.b + 1 }
            else if which == 3 then
                { model | c = model.c + 1 }
            else
                { model | d = model.d + 1 }

        Rename title →
            { model | title = title }


card : String, String, Int, Msg → Html Msg
card id title n msg =
    <section id={id} class="card" title={title}>
        <h2>{title}</h2>
        <p class="count">count <b>{n}</b> of <i>{title}</i></p>
        <p class="twice">{n * 2}</p>
        <button id="${id}-bump" onClick={msg}>bump</button>
    </section>


view : Model → Html Msg
view model =
    <main>
        <button id="rename" onClick={Rename "renamed"}>rename</button>
        {card "one" model.title model.a (Bump 1)}
        {card "two" "second" model.b (Bump 2)}
        {card "three" "third" model.c (Bump 3)}
        {card "four" model.title model.d (Bump 4)}
    </main>


main : Browser.Program
main =
    Tea.sandbox
        { init = { a = 0, b = 10, c = 20, d = 30, title = "first" }, update = update, view = view }
