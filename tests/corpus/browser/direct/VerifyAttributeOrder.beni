-- The verify mode reads a value slot's page against a fresh mount of its
-- markup (browser-direct.md §8.3; S4's value path), and a page patched
-- into the right state need not be written in the order a fresh mount
-- writes it: a class switched on is appended to the list, a style
-- property set again goes after the others, and a `Bool`
-- attribute that turns on is added after the element's other attributes. Each is the
-- same page, so the check compares attributes, classes and style
-- declarations as sets, never by their order. A `<details>` the user
-- closes keeps the program's `open` nowhere but in the model: the check
-- leaves `open` on `details` and `dialog` to the user (§8.1).
import Html exposing (Html)
import Tea


type Msg
    = Next


type alias Model =
    step : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Next →
            { model | step = model.step + 1 }


classesAt : Int → List (String × Bool)
classesAt step = if step == 0 then [ ( "a", True ) ] else [ ( "b", True ), ( "a", True ) ]


stylesAt : Int → List (String × String)
stylesAt step =
    if step == 0 then
        [ ( "color", "red" ) ]
    else
        [ ( "margin", "1px" ), ( "color", "blue" ) ]


-- Markup in a `Maybe Html` hole: the value path, `dom`'s kind.
badge : Model → Html Msg
badge model =
    <section>
        <p
            id="p"
            hidden={model.step > 0}
            class={classesAt model.step}
            style={stylesAt model.step}
        >
            {model.step}
        </p>
        <details id="d" open>
            <summary id="s">more</summary>
            text
        </details>
    </section>


view : Model → Html Msg
view model =
    <main>
        <button id="next" onClick={Next}>next</button>
        {Just (badge model)}
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { step = 0 }, update = update, view = view }
