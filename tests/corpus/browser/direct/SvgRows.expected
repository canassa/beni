-- load
<body>
  <main>
    <svg:svg viewBox="0 0 15 10">
      <svg:g id="bars">
        <svg:rect width="4" id="bar1" x="5" height="2"></svg:rect>
        <svg:rect width="4" id="bar2" x="10" height="3"></svg:rect>
      </svg:g>
      <svg:text x="0" y="9" font-size="2">
        "2"
        " bars"
      </svg:text>
    </svg:svg>
    <button id="add">"add"</button>
    <button id="reverse">"reverse"</button>
  </main>
</body>
