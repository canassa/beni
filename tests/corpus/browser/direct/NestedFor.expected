-- load
<body>
  <main>
    <button id="add">"add"</button>
    <button id="rename">"rename"</button>
    <button id="retitle">"retitle"</button>
    <button id="swap">"swap"</button>
    <p id="log">""</p>
    <ul>
      <li>
        <b id="cell1">"first"</b>
        <ol>
          <li>
            <button>"a"</button>
            " of "
            "first"
          </li>
          <li>
            <button>"b"</button>
            " of "
            "first"
          </li>
        </ol>
      </li>
      <li>
        <b id="cell2">"second"</b>
        <ol>
          <li>
            <button>"c"</button>
            " of "
            "second"
          </li>
        </ol>
      </li>
    </ul>
  </main>
</body>
