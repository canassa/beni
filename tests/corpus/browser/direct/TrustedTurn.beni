-- `browser/dom/TrustedTurn`, re-stated for direct writes (browser-direct.md
-- §4.3, Q2): there is no render loop, so each message writes the page as
-- its handler runs, whoever dispatched the event. A user's click (`press`)
-- runs the button's handler and then, as the click bubbles, the section's:
-- two messages, two writes, both before a listener after them. A click
-- page script dispatches is the same, and three in one task are six
-- messages and six writes — `Debug.log` in the hole counts them.
-- `browser-tea` renders once per turn (`TrustedTurn.tea-expected`).
import Html exposing (Html)
import Tea


type Msg
    = Inner
    | Outer


update : Msg, Int → Int
update msg n =
    case msg of
        Inner →
            n + 1

        Outer →
            n + 10


view : Int → Html Msg
view n =
    <section onClick={Outer}>
        <button id="go" onClick={Inner}>go</button>
        <p>{Debug.log "view" n}</p>
    </section>


main : Tea.Program
main = Tea.sandbox { init = 0, update = update, view = view }
