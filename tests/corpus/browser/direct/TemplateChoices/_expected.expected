-- load
<body>
  <main>
    <button id="switch">"open"</button>
    <button id="inc">"0"</button>
    <button id="quiet">"quiet"</button>
    <button id="shared">"8"</button>
  </main>
</body>
-- click #quiet
(the DOM did not change)
-- focus #inc
<body>
  <main>
    <button id="switch">"open"</button>
    <button id="inc" :focus>"0"</button>
    <button id="quiet">"quiet"</button>
    <button id="shared">"8"</button>
  </main>
</body>
-- click #inc
<body>
  <main>
    <button id="switch">"open"</button>
    <button id="inc" :focus>"1"</button>
    <button id="quiet">"quiet"</button>
    <button id="shared">"8"</button>
  </main>
</body>
