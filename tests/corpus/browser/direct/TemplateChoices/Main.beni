-- A view which is itself a helper call; a helper selects markup through a
-- case, and calls a second helper with branch-dependent arguments.
import Helpers
import Html exposing (Html)
import Tea


type alias Model =
    open : Bool
    left : Int
    right : Int
    shared : Int


type Msg
    = Switch
    | Inc
    | Quiet
    | Shared


update : Msg, Model → Model
update msg model =
    case msg of
        Switch →
            { model | open = not model.open }
        Inc →
            { model | left = model.left + 1 }
        Quiet →
            model
        Shared →
            { model | shared = model.shared + 1 }


view : Model → Html Msg
view model = Helpers.page Switch Inc Quiet Shared model.open model.left model.right model.shared


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { open = True, left = 0, right = 100, shared = 7 }
        , update = update
        , view = view
        }
