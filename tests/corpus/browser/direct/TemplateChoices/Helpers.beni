import Html exposing (Html)


body : msg, msg, msg, msg, String, Int, Int → Html msg
body switch inc quiet sharedMsg label n shared =
    <main>
        <button id="switch" onClick={switch}>{label}</button>
        <button id="inc" onClick={inc}>{n}</button>
        <button id="quiet" onClick={quiet}>quiet</button>
        <button id="shared" onClick={sharedMsg}>{shared + 1}</button>
    </main>


pub page : msg, msg, msg, msg, Bool, Int, Int, Int → Html msg
page switch inc quiet sharedMsg open left right shared =
    case open of
        True →
            body switch inc quiet sharedMsg "open" left shared
        False →
            body switch inc quiet sharedMsg "closed" right shared
