-- A derived value that is markup holds a handler (§5.4; S4's amendment,
-- item 4): `button` is a `let` of `view` only markup reads, so it is a slot
-- computed again by the keys whose writes conflict with what it reads — and
-- what its markup's handler reads is read too. A key that writes only
-- `count` must compute it again, or the button sends the count it was made
-- with (the S4 review: the pass left a handler's reads out of a markup
-- value's).
import Html exposing (Html)
import Tea


type Msg
    = Bump
    | Clicked Int


type alias Model =
    count : Int
    title : String
    sent : List Int


update : Msg, Model → Model
update msg model =
    case msg of
        Bump →
            { model | count = model.count + 1 }

        Clicked n →
            { model | sent = [ …model.sent, n ] }


view : Model → Html Msg
view model =
    button = <button id="send" onClick={Clicked model.count}>{model.title}</button>

    <main>
        <button id="bump" onClick={Bump}>bump</button>
        {button}
        <p id="sent">{String.join (List.map model.sent String.fromInt) ","}</p>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { count = 0, title = "send", sent = [] }
        , update = update
        , view = view
        }
