-- An arm torn down and mounted again shows the model, though every value
-- it reads is the one it showed before (docs/design/browser-direct.md
-- §5.5; S4's amendment, item 3: an arm's state is an instance, made new at
-- each mount, so its holes are written whatever their last values were).
-- An `if`: A → B → A with the same text. A `case` on a `Maybe`: Just →
-- Nothing → Just with the same payload. A page union, as Conduit's: Home →
-- Article → Home, each arm binding its payload, Home's arm a helper's
-- call written in place, whose button bumps the home page's count. The
-- page and `home` are kept as two records, each a copy of the other, so that
-- the model holds no record at two paths (ownership-checker.md §31.8).
import Html exposing (Html)
import Tea


type alias Home =
    title : String
    count : Int


type Page
    = HomePage Home
    | ArticlePage String


type alias Model =
    flag : Bool
    label : String
    picked : Maybe String
    page : Page
    home : Home


type Msg
    = Toggle
    | Pick
    | Unpick
    | GoHome
    | GoArticle
    | Bump


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | flag = not model.flag }

        Pick →
            { model | picked = Just "kept" }

        Unpick →
            { model | picked = Nothing }

        GoHome →
            { model | page = HomePage (Record.copy model.home) }

        GoArticle →
            { model | page = ArticlePage "the article" }

        Bump →
            case model.page of
                HomePage h →
                    next = { h | count = h.count + 1 }
                    { model | page = HomePage next, home = Record.copy next }

                ArticlePage _ →
                    model


viewHome : Home → Html Msg
viewHome h =
    <section id="home-page">
        <h1>{h.title}</h1>
        <p id="count">{String.fromInt h.count}</p>
        <button id="bump" onClick={Bump}>bump</button>
    </section>


view : Model → Html Msg
view model =
    <main>
        <button id="toggle" onClick={Toggle}>toggle</button>
        <button id="pick" onClick={Pick}>pick</button>
        <button id="unpick" onClick={Unpick}>unpick</button>
        <button id="home" onClick={GoHome}>home</button>
        <button id="article" onClick={GoArticle}>article</button>
        <div id="ab">{if model.flag then <b>{model.label}</b> else <i>{model.label}</i>}</div>
        <div id="maybe">
            {case model.picked of
                Just p →
                    <em>{p}</em>

                Nothing →
                    <span>none</span>
            }
        </div>
        {case model.page of
            HomePage h →
                viewHome h

            ArticlePage text →
                <article>{text}</article>
        }
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                { flag = True
                , label = "same"
                , picked = Just "kept"
                , page = HomePage { title = "Home", count = 0 }
                , home = { title = "Home", count = 0 }
                }
        , update = update
        , view = view
        }
