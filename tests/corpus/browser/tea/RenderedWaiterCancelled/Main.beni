-- A real Dom.rendered waiter, parked inside a scheduler host turn, is
-- cancelled when the next command defects. Its continuation must not run.
-- Both platforms use one golden. Guarded wraps direct's scheduler drain
-- through Task.onTurn's documented platform hook; tea already does this.
import Cmd exposing (Cmd)
import Dom
import Guarded
import Html exposing (Html)
import Log
import Sub
import Task exposing (Cancelled, Done, Exit)
import Tea


type Msg
    = Go
    | Ping


outcome : Exit a → String
outcome exit =
    case exit of
        Done _ →
            "Done"
        Cancelled →
            "Cancelled"


waiter : Cmd.Send Msg → ⊤
waiter send = Task.bracket (λ⊤ → ⊤) (λ_ exit → Log.info "waiter released: ${outcome exit}") λ_ →
    send Ping
    Dom.rendered ⊤
    Log.info "waiter resumed"


update : Msg, Int → Int × Cmd Msg
update msg n =
    case msg of
        Go →
            ( n, Cmd.batch [ Cmd.perform waiter, Cmd.perform (thrower n _) ] )
        Ping →
            ( n + 1, Cmd.none )


-- Both jobs start as fibers, in order. The unused waiting branch keeps
-- this body suspendable; on this page it defects before the turn ends.
thrower : Int, Cmd.Send Msg → ⊤
thrower n _ = if n < 0 then Dom.rendered ⊤ else Debug.todo "waiter defect"


init : ⊤ → Int × Cmd Msg
init ⊤ =
    Guarded.install ⊤
    ( 0, Cmd.none )


view : Int → Html Msg
view _ = <button id="go" onClick={Go}>go</button>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = λ_ → Sub.none }
