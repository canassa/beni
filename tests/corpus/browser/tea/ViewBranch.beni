-- A `view` whose body, past its `let`s, is an `if` or a `case` is a branch
-- at the page's root (§5.5; S4's amendment, item 3, as amended by its
-- review): no markup holds it, so it is the page's one site's one branch,
-- its marker the mount's end, each arm a site of its own. A `let` of the
-- `view` both arms read is bound where each arm's values are. A switch
-- tears the shown arm down and makes the other; the same arm is visited.
import Html exposing (Html)
import Tea


type Msg
    = Toggle
    | Inc


type alias Model =
    on : Bool
    n : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | on = not model.on }

        Inc →
            { model | n = model.n + 1 }


view : Model → Html Msg
view model =
    label = if model.on then "on" else "off"

    if model.on then
        <main>
            <b id="label">{label} {model.n}</b>
            <button id="toggle" onClick={Toggle}>toggle</button>
            <button id="inc" onClick={Inc}>inc</button>
        </main>
    else
        <section>
            <i id="label">{label}</i>
            <button id="toggle" onClick={Toggle}>toggle</button>
        </section>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { on = True, n = 0 }, update = update, view = view }
