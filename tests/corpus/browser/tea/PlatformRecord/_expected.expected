-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="single">
      <output>"0"</output>
      <p>"x"</p>
      <button data-role="inc">"+1"</button>
      <button data-role="reset">"Reset"</button>
    </div>
  </div>
</body>
-- click [data-role=inc]
<body>
  <div id="root">
    <div data-role="single">
      <output>"1"</output>
      <p>"x"</p>
      <button data-role="inc">"+1"</button>
      <button data-role="reset">"Reset"</button>
    </div>
  </div>
</body>
-- click [data-role=inc]
<body>
  <div id="root">
    <div data-role="single">
      <output>"2"</output>
      <p>"x"</p>
      <button data-role="inc">"+1"</button>
      <button data-role="reset">"Reset"</button>
    </div>
  </div>
</body>
-- click [data-role=reset]
<body>
  <div id="root">
    <div data-role="single">
      <output>"0"</output>
      <p>"x"</p>
      <button data-role="inc">"+1"</button>
      <button data-role="reset">"Reset"</button>
