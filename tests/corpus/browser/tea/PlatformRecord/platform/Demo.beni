import Html exposing (Html)
import Tea


type alias Model =
    count : Int
    label : String


type Msg
    = Inc
    | Reset


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }

        Reset →
            { model | count = 0 }


view : Model → Html Msg
view model =
    <div data-role="single">
        <output>{model.count}</output>
        <p>{model.label}</p>
        <button data-role="inc" onClick={Inc}>+1</button>
        <button data-role="reset" onClick={Reset}>Reset</button>
    </div>


pub demo : Tea.Program
demo = Tea.sandbox { init = λ⊤ → { count = 0, label = "x" }, update = update, view = view }
