-- load
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="reverse">"reverse"</button>
    <ul>
      <li>
        <span>"one"</span>
        <button id="toggle-1">"edit"</button>
      </li>
      <li>
        <span>"two"</span>
        <button id="toggle-2">"edit"</button>
      </li>
    </ul>
  </main>
</body>
