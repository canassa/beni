        <input .value="1" :focus>
        "a"
      </li>
      <li>
        <input .value="2">
        "b"
      </li>
      <li>
        <input .value="3">
        "c"
      </li>
      <li>
        <input .value="4">
        "d"
      </li>
      <li>
        <input .value="5">
        "e"
      </li>
    </ul>
  </main>
</body>
