-- load
<body>
  <main>
    <button id="swap">"swap"</button>
    <button id="repeat">"repeat"</button>
    <ul>
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
      <li>
        <input .value="">
        "e"
      </li>
    </ul>
  </main>
</body>
