    a6 = a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 + a5 - 15 * a5
    a7 = a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 + a6 - 15 * a6
    a8 = a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 + a7 - 15 * a7
