-- `browser/dom/LetChain` on `browser-direct` (§5.4; S4's amendment, item
-- 4), its chain a hundred `let`s long: each `let` read only by markup, and
-- several times by the next, is a derived value — a slot, computed again
-- in the order of the chain by a message that writes what it reads — and
-- building it stays within a test's instruction budget, each `let`'s read
-- set, slot and code made once. The original's chain is 250 long; a page
-- here is built for two platforms, so twice, and a hundred reach the same
-- code.
import Html exposing (Html)
import Tea


type Msg
    = Inc


update : Msg, Int → Int
update msg n = n + 1


view : Int → Html Msg
view n =
    a0 = n
    a1 = a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 - 15 * a0
    a2 = a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 + a1 - 15 * a1
    a3 = a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 + a2 - 15 * a2
    a4 = a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 + a3 - 15 * a3
