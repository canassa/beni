-- The selector's visit beside the rows a message removes or makes
-- (browser-direct.md §6.4, as amended for S3): the visit runs after the
-- list's scripts, from the key map, so a probe whose row the same message
-- removed finds nothing and is passed, and a row the message made is made
-- with the new selection. Removing the selected row clears the selection;
-- one message selects a row and removes another; one inserts a row and
-- selects it; one removes the selected row and selects the next. The
-- inputs are not controlled, so typed text shows that no row is remade.
import Browser
import Html exposing (Html)
import Tea


type Msg
    = Select Int
    | Remove Int
    | SelectAndRemove Int Int
    | InsertSelected
    | RemoveAndSelect Int Int


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    selected : Maybe Int
    next : Int


without : List Row, Int → List Row
without rows id = List.filter rows λr → r.id ≠ id


update : Msg, Model → Model
update msg model =
    case msg of
        Select id →
            { model | selected = Just id }

        Remove id →
            { model
                | rows = without model.rows id
                , selected = if model.selected == Just id then Nothing else model.selected
            }

        SelectAndRemove picked gone →
            { model | rows = without model.rows gone, selected = Just picked }

        InsertSelected →
            { model
                | rows =
                    List.insertAt model.rows 1
                        { id = model.next, label = "new ${String.fromInt model.next}" }
                , selected = Just model.next
                , next = model.next + 1
            }

        RemoveAndSelect gone picked →
            { model | rows = without model.rows gone, selected = Just picked }


view : Model → Html Msg
view model =
    <main>
        <button id="pickandgo" onClick={SelectAndRemove 1 4}>select 1, remove 4</button>
        <button id="insert" onClick={InsertSelected}>insert selected</button>
        <button id="goandpick" onClick={RemoveAndSelect 10 3}>remove 10, select 3</button>
        <ul>
            <For each={model.rows} keyed={.id}>
                {λrow →
                    <li class={if model.selected == Just row.id then "on" else ""}>
                        <input />
                        <a id="pick${String.fromInt row.id}" onClick={Select row.id}>{row.label}</a>
                        <a id="drop${String.fromInt row.id}" onClick={Remove row.id}>x</a>
                    </li>
                }
            </For>
        </ul>
    </main>


main : Browser.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                { rows =
                    [ { id = 1, label = "one" }
                    , { id = 2, label = "two" }
                    , { id = 3, label = "three" }
                    , { id = 4, label = "four" }
                    , { id = 5, label = "five" }
                    ]
                , selected = Nothing
                , next = 10
                }
        , update = update
        , view = view
        }
