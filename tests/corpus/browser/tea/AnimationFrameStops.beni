-- A frame subscription that its own message ends (boundary.md §9.8.18):
-- the third frame's message turns it off, and the render inside that
-- frame's task removes the listener and cancels the frame the clock had
-- already asked for. So no later frame runs a callback, and the page asks
-- for none: an animation that finishes leaves no loop behind.
import Browser.Events
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Tea
import Time


type Msg
    = Frame Time.Posix


update : Msg, Int → Int × Cmd Msg
update msg count =
    case msg of
        Frame _ →
            ( count + 1, Cmd.none )


subscriptions : Int → Sub Msg
subscriptions count =
    if count < 3 then
        Browser.Events.onAnimationFrame Frame
    else
        Sub.none


view : Int → Html Msg
view count = <p>{String.fromInt count} frames</p>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none )
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
