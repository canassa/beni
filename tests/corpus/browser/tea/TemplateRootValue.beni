-- A genuinely dynamic root, with a slot-entry mask rather than a precise
-- helper substitution. Quiet cannot enter it; Inc revisits its value groups.
import Html exposing (Html)
import Tea


type Msg
    = Inc
    | Quiet


type alias Model =
    count : Int
    stored : Html Msg


body : Int → Html Msg
body n =
    <main>
        <button id="inc" onClick={Inc}>{n}</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
    </main>


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            next = model.count + 1
            { count = next, stored = body next }
        Quiet →
            model


view : Model → Html Msg
view model = model.stored


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { count = 0, stored = body 0 }, update = update, view = view }
