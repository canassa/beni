-- Parameter substitutions survive markup supplied as component children.
import Helpers
import Html exposing (Html)
import Panel
import Tea


type alias Model =
    left : Int
    right : Int


type Msg
    = Left
    | Right
    | Quiet


update : Msg, Model → Model
update msg model =
    case msg of
        Left →
            { model | left = model.left + 1 }
        Right →
            { model | right = model.right + 1 }
        Quiet →
            model


view : Model → Html Msg
view model =
    <main>
        <button id="left" onClick={Left}>left</button>
        <button id="right" onClick={Right}>right</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
        <Panel title={String.fromInt model.right}>{Helpers.inner model.left}</Panel>
        <Panel title={String.fromInt model.right}><div>{Helpers.inner model.left}</div></Panel>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { left = 0, right = 10 }, update = update, view = view }
