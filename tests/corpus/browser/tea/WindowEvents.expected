-- event window resize
<body>
  <main>
    <button id="toggle">"toggle"</button>
    <p>
      "resizes "
      "1"
      <!---->
      ", visible "
      "0"
      <!---->
    </p>
  </main>
</body>
-- event document visibilitychange
<body>
  <main>
    <button id="toggle">"toggle"</button>
    <p>
      "resizes "
      "1"
      <!---->
      ", visible "
      "1"
      <!---->
    </p>
  </main>
</body>
