-- Cancellation is the fiber's (boundary.md §9.8.12 (d)): a keyed
-- `Restart` cancels the request still waiting under its key, which aborts
-- it — the fetch log shows `(fetch 1 aborted: AbortError)` — and its
-- answer, given afterwards, reaches nothing; `Cmd.cancel` aborts the
-- second the same way. Only the third, answered, is shown.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Http
import Sub
import Tea


type Key
    = Search


type Msg
    = Typed String
    | Stop
    | Found String (Result Http.Error String)


update : Msg, List String → List String × Cmd Msg
update msg lines =
    case msg of
        Typed q →
            ( lines
            , Cmd.keyed Search Cmd.Restart λsend →
                send (Found q (Http.get { url = "/search?q=${q}", expect = Http.expectString }))
            )

        Stop →
            ( lines, Cmd.cancel Search )

        Found q (Ok text) →
            ( lines ++ [ "${q}: ${text}" ], Cmd.none )

        Found q (Err _) →
            ( lines ++ [ "${q}: failed" ], Cmd.none )


view : List String → Html Msg
view lines =
    <main>
        <button id="a" onClick={Typed "a"}>a</button>
        <button id="ab" onClick={Typed "ab"}>ab</button>
        <button id="abc" onClick={Typed "abc"}>abc</button>
        <button id="stop" onClick={Stop}>stop</button>
        <ol><For each={lines} keyed={False}>{λline → <li>{line}</li>}</For></ol>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( [], Cmd.none ), update = update, view = view, subscriptions = λ_ → Sub.none }
