-- load
(socket 1: /chat)
<body>
  <main>
    <p id="state">"connecting"</p>
    <button id="say">"say"</button>
    <ol></ol>
  </main>
</body>
-- click #say
<body>
  <main>
    <p id="state">"connecting"</p>
    <button id="say">"say"</button>
    <ol>
      <li>"not connected"</li>
    </ol>
  </main>
</body>
-- socket 1 open
<body>
  <main>
    <p id="state">"up"</p>
    <button id="say">"say"</button>
    <ol>
      <li>"not connected"</li>
      <li>"opened"</li>
    </ol>
  </main>
</body>
-- socket 1 message "hello"
<body>
  <main>
    <p id="state">"up"</p>
    <button id="say">"say"</button>
    <ol>
      <li>"not connected"</li>
      <li>"opened"</li>
      <li>"received hello"</li>
    </ol>
  </main>
</body>
-- socket 1 message "world"
<body>
  <main>
    <p id="state">"up"</p>
    <button id="say">"say"</button>
    <ol>
      <li>"not connected"</li>
      <li>"opened"</li>
      <li>"received hello"</li>
      <li>"received world"</li>
    </ol>
  </main>
</body>
-- click #say
(socket 1 sent: "ping")
(the DOM did not change)
-- socket 1 close 4000 "bye"
<body>
  <main>
    <p id="state">"waiting"</p>
    <button id="say">"say"</button>
    <ol>
      <li>"not connected"</li>
      <li>"opened"</li>
      <li>"received hello"</li>
      <li>"received world"</li>
      <li>"closed 4000 \"bye\""</li>
    </ol>
  </main>
</body>
