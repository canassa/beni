-- Copy's fresh result permits the append on browser-direct. The old trail
-- stays live, and nullary calls in holes must update on every relevant edit.
import Browser
import Html exposing (Html)
import Tea


type Msg
    = Add


type alias Model =
    trail : List Int
    previous : List Int


update : Msg, Model → Model
update _ current =
    other = { trail = [ 9 ] }
    { current | trail = current.trail.copy ++ other.trail, previous = current.trail }


view : Model → Html Msg
view model =
    <main>
        <button id="add" onClick={Add}>add</button>
        <b>{model.trail.length}</b>
        <i>{model.previous.length}</i>
    </main>


main : Browser.Program
main = Tea.sandbox { init = λ⊤ → { trail = [ 1 ], previous = [] }, update = update, view = view }
