-- A release already running when a defect strikes runs once, not twice
-- (boundary.md §9.8.14 (d), *Each finaliser runs exactly once*). A keyed
-- `Restart` body sleeps inside a `bracket` whose release sleeps 300 ms.
-- A second `Go` restarts it: the old body is cancelled and its release
-- starts, the new body waiting for it. The page then stops on a defect in
-- `update`. The release goes on to its end, once; the waiting new body is
-- cancelled before it starts, so its release never runs.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Log
import Sub
import Task
import Tea
import Time


type Msg
    = Go
    | Boom


update : Msg, Int → Int × Cmd Msg
update msg n =
    case msg of
        Go →
            ( n + 1
            , Cmd.keyed "work" Cmd.Restart λ_ →
                Task.bracket
                    (λ⊤ → Log.info "body ${String.fromInt (n + 1)} starts")
                    (λ_ _ →
                        Log.info "body ${String.fromInt (n + 1)} release starts"
                        Time.sleep (Time.millis 300)
                        Log.info "body ${String.fromInt (n + 1)} release ends"
                    )
                    λ_ → Time.sleep (Time.seconds 60)
            )

        Boom →
            Debug.todo "update threw"


view : Int → Html Msg
view _ =
    <main>
        <button id="go" onClick={Go}>go</button>
        <button id="boom" onClick={Boom}>boom</button>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( 0, Cmd.none ), update = update, view = view, subscriptions = λ_ → Sub.none }
