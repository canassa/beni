-- What `Http` sends (boundary.md §9.8.12 (b)), read from the driver's
-- fetch log: each method as written (`fetch` upper-cases only the
-- standard ones, so `patch` goes lower-case), headers appended in order and
-- a name given twice sent once with both values, `stringBody`'s MIME type
-- as the `Content-Type` unless the program names one, which wins, no body
-- and no `Content-Type` for `emptyBody`, and the credentials: `include`
-- for `riskyRequest` and the command `riskySend` (boundary.md §9.8.19),
-- `same-origin`, which the log leaves out, for the command `send`, with a
-- tracker name as without one. Each answer is shown as it comes.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Http
import Sub
import Tea


type Msg
    = Send String
    | Got String (Result Http.Error String)


shown : Result Http.Error String → String
shown result =
    case result of
        Ok text →
            "ok ${text}"

        Err _ →
            "failed"


plain : String, String, List Http.Header, Http.Body → Result Http.Error String
plain method url headers body =
    Http.request
        { method = method
        , headers = headers
        , url = url
        , body = body
        , expect = Http.expectString
        , timeout = Nothing
        , tracker = Nothing
        }


work : String → (⊤ → Result Http.Error String)
work name =
    case name of
        "get" →
            λ⊤ → Http.get { url = "/items?page=2", expect = Http.expectString }

        "headers" →
            λ⊤ →
                plain
                    "GET"
                    "/headers"
                    [ Http.header "X-B" "1", Http.header "X-A" "2", Http.header "x-b" "3" ]
                    Http.emptyBody

        "post" →
            λ⊤ →
                Http.post
                    { url = "/notes"
                    , body = Http.stringBody "text/plain" "hello"
                    , expect = Http.expectString
                    }

        "typed" →
            λ⊤ →
                plain
                    "PUT"
                    "/notes/1"
                    [ Http.header "Content-Type" "application/x-note" ]
                    (Http.stringBody "text/plain" "hi")

        "patch" →
            λ⊤ → plain "patch" "/notes/1" [] (Http.stringBody "text/plain" "p")

        "delete" →
            λ⊤ → plain "DELETE" "/notes/1" [] Http.emptyBody

        _ →
            λ⊤ →
                Http.riskyRequest
                    { method = "GET"
                    , headers = []
                    , url = "/me"
                    , body = Http.emptyBody
                    , expect = Http.expectString
                    , timeout = Nothing
                    , tracker = Nothing
                    }


update : Msg, List String → List String × Cmd Msg
update msg lines =
    case msg of
        Send "send" →
            ( lines
            , Http.send
                { method = "PUT"
                , headers = []
                , url = "/send"
                , body = Http.stringBody "text/plain" "s"
                , expect = Http.expectString
                , timeout = Nothing
                , tracker = Nothing
                }
                (Got "send" _)
            )

        Send "riskySend" →
            ( lines
            , Http.riskySend
                { method = "PUT"
                , headers = []
                , url = "/risky-send"
                , body = Http.stringBody "text/plain" "r"
                , expect = Http.expectString
                , timeout = Nothing
                , tracker = Nothing
                }
                (Got "riskySend" _)
            )

        Send "trackedSend" →
            ( lines
            , Http.send
                { method = "PUT"
                , headers = []
                , url = "/tracked-send"
                , body = Http.stringBody "text/plain" "t"
                , expect = Http.expectString
                , timeout = Nothing
                , tracker = Just "shape"
                }
                (Got "trackedSend" _)
            )

        Send "trackedRiskySend" →
            ( lines
            , Http.riskySend
                { method = "PUT"
                , headers = []
                , url = "/tracked-risky-send"
                , body = Http.stringBody "text/plain" "tr"
                , expect = Http.expectString
                , timeout = Nothing
                , tracker = Just "shape"
                }
                (Got "trackedRiskySend" _)
            )

        Send name →
            ( lines, Cmd.task (work name) (Got name _) )

        Got name result →
            ( lines ++ [ "${name}: ${shown result}" ], Cmd.none )


-- One button for each way of sending, in the order the steps click them.
names : List String
names =
    [ "get"
    , "headers"
    , "post"
    , "typed"
    , "patch"
    , "delete"
    , "risky"
    , "send"
    , "riskySend"
    , "trackedSend"
    , "trackedRiskySend"
    ]


view : List String → Html Msg
view lines =
    <main>
        <For each={names} keyed={False}>
            {λname → <button id={name} onClick={Send name}>{name}</button>}
        </For>
        <ol><For each={lines} keyed={False}>{λline → <li>{line}</li>}</For></ol>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( [], Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
