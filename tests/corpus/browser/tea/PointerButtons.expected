    <p id="split">"split"</p>
    <ol>
      <li>"down button 0, buttons 1: main"</li>
      <li>"move button 2, buttons 3: main secondary"</li>
      <li>"move button -1, buttons 3: main secondary"</li>
      <li>"move button 2, buttons 1: main"</li>
      <li>"up button 0, buttons 0:"</li>
      <li>"down button 1, buttons 4:"</li>
      <li>"down button 5, buttons 32:"</li>
      <li>"down button 2, buttons 2: secondary"</li>
      <li>"menu on pad: at 55.0, 25.0, client 95.0, 55.0; button 2, buttons 2: secondary; \"mouse\" #1, not primary"</li>
    </ol>
  </main>
</body>
