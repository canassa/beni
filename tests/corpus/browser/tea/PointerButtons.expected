-- load
<body>
  <main>
    <div id="pad" style="position: absolute; left: 40px; top: 30px; width: 200px; height: 100px; touch-action: none">
      <span id="dot" style="position: absolute; left: 50px; top: 20px; width: 10px; height: 10px"></span>
    </div>
    <p id="native">"native"</p>
    <p id="split">"split"</p>
    <ol></ol>
  </main>
</body>
-- pointer #pad pointerdown 10 20 button:0 buttons:1
<body>
  <main>
    <div id="pad" style="position: absolute; left: 40px; top: 30px; width: 200px; height: 100px; touch-action: none">
      <span id="dot" style="position: absolute; left: 50px; top: 20px; width: 10px; height: 10px"></span>
    </div>
    <p id="native">"native"</p>
    <p id="split">"split"</p>
    <ol>
      <li>"down button 0, buttons 1: main"</li>
    </ol>
  </main>
</body>
