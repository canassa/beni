-- The table app's swap on `browser-direct` (browser-direct.md, *Amended
-- 2026-10-11 (the lean slice, as specified)*): an `indexedMap` with index
-- guards writes rows 1 and 3, and the two writes take each other's keys.
-- They are checked once, after both, so the swap is one exchange of the two
-- rows — their nodes trade places, the typed text going with each, and row
-- 0's focused input, which no edit touches, keeps the focus. A swap back
-- puts them home. Then row 0 takes row 3's key, so a key repeats: the next
-- swap is matched by key and rank instead (CK-221), as `browser-tea` matches
-- it, and the rows show what that match keeps.
import Browser
import Html exposing (Html)
import Tea


type Msg
    = Swap
    | Repeat


type alias Row =
    id : Int
    label : String


at : List Row, Int → Maybe Row
at rows index = List.get rows index


swap : List Row → List Row
swap rows =
    case ( at rows 1, at rows 3 ) of
        ( Just a, Just b ) →
            List.indexedMap rows λi row → if i == 1 then b else if i == 3 then a else row

        _ →
            rows


update : Msg, List Row → List Row
update msg rows =
    case msg of
        Swap →
            swap rows

        Repeat →
            List.indexedMap rows λi row → if i == 0 then { row | id = 4 } else row


view : List Row → Html Msg
view rows =
    <main>
        <button id="swap" onClick={Swap}>swap</button>
        <button id="repeat" onClick={Repeat}>repeat</button>
        <ul>
            <For each={rows} keyed={.id}>
                {λrow → <li><input />{row.label}</li>}
            </For>
        </ul>
    </main>


main : Browser.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                [ { id = 1, label = "a" }
                , { id = 2, label = "b" }
                , { id = 3, label = "c" }
                , { id = 4, label = "d" }
                , { id = 5, label = "e" }
                ]
        , update = update
        , view = view
        }
