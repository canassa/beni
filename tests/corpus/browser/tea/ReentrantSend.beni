-- The dispatch order (boundary.md §9.8.4). A body hands `update` its own
-- `send` in a message, and the model keeps it.
--
--   - "twice": `update` sends through the kept `send` while it runs. The
--     message is queued and applied when this `update` returns — "echo 1"
--     after "twice ends", never inside it — and both are rendered by one
--     flush.
--   - "after": after-render work sends. No dispatch is running, so
--     `update` runs at once, and its render is the next flush's: "render"
--     is logged twice for the one click.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type Msg
    = Captured (Cmd.Send Msg)
    | Twice
    | After
    | Echo Int


type alias Model =
    send : Maybe (Cmd.Send Msg)
    echoes : Int


update : Msg, Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Captured send ->
            ( { model | send = Just send }, Cmd.none )

        Twice ->
            _ = Debug.log "twice begins" ()
            _ = Maybe.withDefault (Maybe.map model.send λsend -> send (Echo 1)) ()
            _ = Debug.log "twice ends" ()
            ( model, Cmd.none )

        After ->
            ( model, Cmd.afterRender afterWork )

        Echo n ->
            ( { model | echoes = Debug.log "echo" (model.echoes + n) }, Cmd.none )


afterWork : Cmd.Send Msg -> ()
afterWork send =
    _ = Debug.log "after-render sends" ()
    _ = send (Echo 2)
    Debug.log "after-render ends" ()


view : Model -> Html Msg
view model =
    _ = Debug.log "render" model.echoes
    <main>
        <button id="twice" onClick={Twice}>twice</button>
        <button id="after" onClick={After}>after</button>
        <p>{model.echoes}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( { send = Nothing, echoes = 0 }, Cmd.perform λsend -> send (Captured send) )
        , update = update
        , view = view
        , subscriptions = λ_ -> Sub.none
        }
