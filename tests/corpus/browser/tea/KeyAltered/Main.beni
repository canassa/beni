-- A real key altered by a project's own platform layer
-- (`ownership-v3-kernel.md` §6 rule 10, *A platform's trusted row*): the key
-- `k` comes from `Hosted.key`, and the layer then writes a function that
-- keeps what it is handed where a key once carried its comparer.
-- `Hosted.compare k (Hosted.key ys)` reads a type's comparer from its own
-- table, never from a key, so that function never runs: `ys` does not
-- escape, and the push after is accepted and edits in place. No rule about
-- where a `Key` is built could stop this program, since the key it alters
-- is a real one; a `compare` that ran the comparer a key carries would keep
-- `ys` and let the push trap.
import Cmd exposing (Cmd)
import Evil
import Hosted
import Html exposing (Html)
import Ref
import Sub
import Tea


type Msg
    = Go


type alias Model =
    n : Int


update : Msg, Model → Model × Cmd Msg
update Go model =
    cell = Ref.make [ 0 ]
    ys = [ 5 ]
    k = Evil.alter (Hosted.key [ 6 ]) λ_ b → keep cell b
    o = Hosted.compare k (Hosted.key ys)
    zs = List.push ys 7
    kept = Ref.get cell
    gt = if o == GT then 1 else 0
    ( { model | n = model.n * 1000 + gt * 100 + List.length kept * 10 + List.length zs }, Cmd.none )


keep : Ref.Ref (List Int), List Int → Order
keep cell b =
    Ref.set cell b
    EQ


view : Model → Html Msg
view model = <button id="go" onClick={Go}>{model.n}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { n = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
