-- load
<body>
  <button id="grow">"grow"</button>
  <button id="front">"front"</button>
  <button id="empty">"empty"</button>
  <ul id="leading">
    <li>"a"</li>
    <li>"b"</li>
    <li>"leading's last"</li>
  </ul>
  <ul id="trailing">
    <li>"trailing's first"</li>
    <li>"a"</li>
    <li>"b"</li>
  </ul>
  <ul id="only">
    <li>"a"</li>
    <li>"b"</li>
  </ul>
  <ul id="middle">
    <li>"before"</li>
    <li>"a"</li>
    <li>"b"</li>
    <li>"after"</li>
  </ul>
  <p>"a"</p>
  <p>"b"</p>
  <p>"the end"</p>
</body>
