-- A document helper call without a source branch is compiled in place.
-- Body and title use the same helper evaluation on each message.
import Cmd exposing (Cmd)
import Debug
import Sub
import Tea


type Msg
    = Inc


page : Int → Tea.Document Msg
page n =
    _ = Debug.log "document" n
    { title = "count ${String.fromInt n}"
    , body = <button id="inc" onClick={Inc}>{n}</button>
    }


view : Int → Tea.Document Msg
view n = page n


main : Tea.Program
main =
    Tea.document
        { init = λ⊤ → ( 0, Cmd.none )
        , update = λInc n → ( n + 1, Cmd.none )
        , view = view
        , subscriptions = λ_ → Sub.none
        }
