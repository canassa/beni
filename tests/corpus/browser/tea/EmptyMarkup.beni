-- `browser/dom/EmptyMarkup`, rebuilt for `browser-direct` (its S4
-- amendment, item 1): markup with no nodes, on the value path. A helper
-- whose body chooses between an element and nothing switches and back,
-- keeping its place among its siblings; a keyed `For` whose row is an `if`
-- — a whole `For` on the value path — has rows of nothing for odd ids,
-- moved, removed and replaced with the others; and markup of no nodes
-- held in a constant sits between two text runs.
import Html exposing (Html)
import Tea


type Msg
    = Toggle
    | Reverse
    | Drop


type alias Model =
    on : Bool
    rows : List Int


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | on = not model.on }

        Reverse →
            { model | rows = List.reverse model.rows }

        Drop →
            { model | rows = List.filter model.rows λn → n ≠ 2 && n ≠ 3 }


nothing : Html msg
nothing = <></>


maybeBold : Bool → Html msg
maybeBold on =
    if on then
        <b>on</b>
    else
        <></>


view : Model → Html Msg
view model =
    <main>
        <button id="toggle" onClick={Toggle}>toggle</button>
        <button id="reverse" onClick={Reverse}>reverse</button>
        <button id="drop" onClick={Drop}>drop</button>
        <p>before {maybeBold model.on} after</p>
        <p>a {nothing} b</p>
        <ul>
            <For each={model.rows} keyed={λn → n}>
                {λn →
                    if Int.mod n 2 == 1 then
                        <></>
                    else
                        <li>{n}</li>
                }
            </For>
        </ul>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { on = False, rows = [ 1, 2, 3, 4 ] }, update = update, view = view }
