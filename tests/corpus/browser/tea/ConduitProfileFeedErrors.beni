-- Conduit's ProfileFeed errors: rendering is a read, while Response is an owned send.
-- The rejected twin retains this same nested list in an event payload.
import Cmd
import Html exposing (Html)
import Sub
import Tea


type alias Page =
    errors : List String


type Feed
    = Loaded Page


type alias ProfilePage =
    feed : Feed


type Model
    = Profile Int ProfilePage


type Msg
    = Grow
    | Response (List String)
    | Share (List String)


update : Msg, Model → Model × Cmd.Cmd Msg
update msg model =
    case ( msg, model ) of
        ( Grow, Profile id profile ) →
            ( Profile id
                { profile | feed = Loaded { errors = List.push (feedErrors profile.feed) "more" } }
            , Cmd.none
            )

        ( Response errors, Profile id profile ) →
            ( Profile id { profile | feed = Loaded { errors = errors } }, Cmd.none )

        ( Share errors, Profile id profile ) →
            ( Profile id { profile | feed = Loaded { errors = errors } }, Cmd.none )


viewErrors : msg, List String → Html msg
viewErrors dismiss errors =
    <section>
        <For each={errors} keyed={False}>{λerror → <p>{error}</p>}</For>
        <button id="grow" onClick={dismiss}>grow</button>
    </section>


feedErrors : Feed → List String
feedErrors (Loaded page) = page.errors


view : Model → Html Msg
view model =
    case model of
        Profile id profile →
            viewErrors Grow (feedErrors profile.feed)


main : Tea.Program
main =
    Tea.element
        { init =
            λ⊤ →
                ( Profile 0 { feed = Loaded { errors = [] } }
                , Cmd.task (λ⊤ → [ "first" ]) Response
                )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
