-- The helper is imported, and Main has no markup tree of its own.
import Body
import Cmd exposing (Cmd)
import Sub
import Tea


type Msg
    = Inc


view : Int → Tea.Document Msg
view n = Body.page Inc n


main : Tea.Program
main =
    Tea.document
        { init = λ⊤ → ( 0, Cmd.none )
        , update = λInc n → ( n + 1, Cmd.none )
        , view = view
        , subscriptions = λ_ → Sub.none
        }
