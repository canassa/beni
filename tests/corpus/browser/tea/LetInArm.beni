-- A `let` inside a page arm (docs/design/browser-direct.md §5.4, §4.1 step
-- 3 (a)): computed where the arm's values are, from the model of that
-- moment, never from a page that is no longer shown. Page A's `doubled`
-- reads the count, and the message that switches to A writes it: A → B →
-- A shows the new count doubled. Page B's `shown` feeds both a nested `if`
-- on whether it is empty and a `For` over it: one message adds an item,
-- and the `if` flips and the new row appears in the same dispatch.
import Html exposing (Html)
import Tea


type Page
    = PageA
    | PageB


type alias Model =
    page : Page
    items : List String
    count : Int


type Msg
    = GoA
    | GoB
    | Add


update : Msg, Model → Model
update msg model =
    case msg of
        GoA →
            { model | page = PageA, count = model.count + 1 }

        GoB →
            { model | page = PageB, count = model.count + 1 }

        Add →
            { model
                | items = List.push model.items "item ${String.fromInt (List.length model.items)}"
            }


view : Model → Html Msg
view model =
    <main>
        <button id="a" onClick={GoA}>a</button>
        <button id="b" onClick={GoB}>b</button>
        <button id="add" onClick={Add}>add</button>
        {case model.page of
            PageA →
                doubled = model.count * 2
                <p id="doubled">{String.fromInt doubled}</p>

            PageB →
                shown = List.reverse model.items
                <section>
                    {if List.isEmpty shown then
                        <p id="empty">empty</p>
                     else
                        <p id="some">{List.length shown}</p>
                    }
                    <ul><For each={shown} keyed={False}>{λs → <li>{s}</li>}</For></ul>
                </section>
        }
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { page = PageA, items = [], count = 0 }, update = update, view = view }
