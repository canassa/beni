-- load
<body>
  <main>
    <button id="toggle">"toggle"</button>
    <button id="pick">"pick"</button>
    <button id="unpick">"unpick"</button>
    <button id="home">"home"</button>
    <button id="article">"article"</button>
    <div id="ab">
      <b>"same"</b>
    </div>
    <div id="maybe">
      <em>"kept"</em>
    </div>
    <section id="home-page">
      <h1>"Home"</h1>
      <p id="count">"0"</p>
      <button id="bump">"bump"</button>
    </section>
  </main>
</body>
