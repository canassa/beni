-- A defect closes the program's scope (boundary.md §9.8.14), and each
-- scoped change of the log context is put back as its fiber unwinds
-- (transparent-effects-proposal.md §17.5). A command body sleeps inside a
-- `bracket`, then `Log.annotate`, then another `bracket`; a second body
-- throws. The inner release, inside the annotation, logs with it — the
-- console's second argument — and the outer release logs without it.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Log
import Sub
import Task
import Tea
import Time


type Msg
    = Go


guarded : String, (⊤ → a) → a
guarded name body = Task.bracket (λ⊤ → ⊤) (λ_ _ → Log.info "${name} released") λ_ → body ⊤


update : Msg, String → String × Cmd Msg
update msg shown =
    case msg of
        Go →
            ( "going"
            , Cmd.batch
                [ Cmd.perform λ_ →
                    guarded "outer" λ⊤ →
                        Log.annotate "request" "r1" λ⊤ →
                            guarded "inner" λ⊤ → Time.sleep (Time.millis 100)
                , Cmd.perform λ_ →
                    Time.sleep (Time.millis 10)
                    Debug.todo "body threw"
                ]
            )


view : String → Html Msg
view shown =
    <main>
        <p id="shown">{shown}</p>
        <button id="go" onClick={Go}>go</button>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( "idle", Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
