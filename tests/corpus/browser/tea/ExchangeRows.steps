# Mark every row's node, and focus row 0's input.
input li:nth-child(1)>input "1"
input li:nth-child(2)>input "2"
input li:nth-child(3)>input "3"
input li:nth-child(4)>input "4"
input li:nth-child(5)>input "5"
focus li:nth-child(1)>input
# Rows 1 and 3 trade places with their nodes; row 0 keeps the focus.
click #swap
# And back.
click #swap
# Row 0 takes key 4, which row 3 holds: a key repeats.
click #repeat
# Swapped again, matched by key and rank.
click #swap
