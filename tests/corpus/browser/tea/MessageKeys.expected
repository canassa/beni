    <input id="in" .value="">
    <p id="text">""</p>
    <p id="clicks" class="few">"0"</p>
    <button id="click">"click"</button>
    <button id="a">"a"</button>
    <button id="b">"b"</button>
    <p id="sub">"0"</p>
  </main>
</body>
