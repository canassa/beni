-- load
<body>
  <main>
    <p id="elapsed">"read 0: -1 ms"</p>
    <button id="read">"read"</button>
  </main>
</body>
-- click #read
<body>
  <main>
    <p id="elapsed">"read 1: 0 ms"</p>
    <button id="read">"read"</button>
  </main>
</body>
