-- store local "todos" "milk"
-- load
<body>
  <main>
    <button id="save">"save"</button>
    <button id="forget">"forget"</button>
    <button id="session">"session"</button>
    <ol>
      <li>"todos = milk"</li>
      <li>"draft unset"</li>
    </ol>
  </main>
</body>
-- click #save
<body>
  <main>
    <button id="save">"save"</button>
    <button id="forget">"forget"</button>
    <button id="session">"session"</button>
    <ol>
      <li>"todos = milk"</li>
      <li>"draft unset"</li>
      <li>"written"</li>
      <li>"draft = eggs"</li>
    </ol>
  </main>
</body>
-- storage local
(localStorage: {"draft":"eggs","todos":"milk"})
(the DOM did not change)
