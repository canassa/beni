-- click #session
<body>
  <main>
    <button id="save">"save"</button>
    <button id="forget">"forget"</button>
    <button id="session">"session"</button>
    <ol>
      <li>"todos = milk"</li>
      <li>"draft unset"</li>
      <li>"written"</li>
      <li>"draft = eggs"</li>
      <li>"todos unset"</li>
      <li>"keys draft"</li>
      <li>"written"</li>
      <li>"tab = 1"</li>
