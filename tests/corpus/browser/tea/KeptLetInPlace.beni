-- The `dom` lowering under `browser-tea` keeps a `let` that only its root
-- reads while the paths it reads are `===` (backend.md §15.4, *The `let`
-- rule*): `xs` reads only `model.j`, a number, so the render after `Add`
-- pushes onto the kept array again. The lowering says it keeps `xs`, so
-- `--ownership=v3` refuses the push (ownership-v3-kernel.md §6.14).
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type Msg
    = Add
    | Bump


type alias Model =
    k : Int
    j : Int


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Add →
            ( { model | k = model.k + 1 }, Cmd.none )

        Bump →
            ( { model | j = model.j + 1 }, Cmd.none )


show : List Int → String
show xs = String.join (List.map xs String.fromInt) ","


view : Model → Html Msg
view model =
    xs = List.repeat 2 model.j
    ys = List.push xs model.k
    <main>
        <button id="add" onClick={Add}>add</button>
        <button id="bump" onClick={Bump}>bump</button>
        <p>{show ys}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { k = 0, j = 1 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
