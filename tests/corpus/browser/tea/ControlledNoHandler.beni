-- A controlled element with no handler is put back at once (browser-
-- direct.md §8.1; its S4 amendment, item 2): the first `control` also adds
-- a bubble-phase listener on the document for `input`, `change`, `click`
-- and `reset`, a send that does nothing, so the reconcile runs after every
-- edit, handled or not. `browser-tea` leaves the edit on the page until its
-- next render (`ControlledNoHandler.tea-expected`: a difference the design
-- specifies), and puts a checkbox's click back in a task.
import Html exposing (Html)
import Tea


type Msg
    = Tick


type alias Model =
    text : String
    n : Int


update : Msg, Model → Model
update _ m = { m | n = m.n + 1 }


view : Model → Html Msg
view m =
    <main>
        <button id="tick" onClick={Tick}>{m.n}</button>
        <input id="free" value={m.text} />
        <input id="box" type="checkbox" checked={True} />
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { text = "ab", n = 0 }, update = update, view = view }
