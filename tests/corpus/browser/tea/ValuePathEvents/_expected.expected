-- load
<body>
  <main>
    <div id="outer">
      <button id="inner">"inner"</button>
      <!---->
      <span id="vstop">
        <button id="vstop-in">"in"</button>
      </span>
      <!---->
    </div>
    <div id="dstop">
      <button id="below">"below"</button>
    </div>
    <section id="box">
      <button id="child">"child"</button>
    </section>
    <p id="log">""</p>
  </main>
</body>
