-- `browser/dom/EveryRenderTop` on `browser-direct` (§5.3): a view that
-- reads nothing of its model still evaluates a value that may have an
-- effect on every message (language.md §11.11, made precise 2026-10-04):
-- its group is every handler's, so `Random.value` draws anew after each
-- message.
import Html exposing (Html)
import Random
import Tea


type Msg
    = Roll


update : Msg, Int → Int
update msg n = n + 1


view : Int → Html Msg
view _ =
    <main>
        <button id="roll" onClick={Roll}>roll</button>
        <p>{Random.value (Random.int 1 1000000)}</p>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = update, view = view }
