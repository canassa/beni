-- load
<body>
  <main>
    <button id="add">"add"</button>
    <button id="clear">"clear"</button>
    <button id="bump">
      "bump "
      "0"
    </button>
    <ul id="branch">
      <li class="odd">
        <button id="odd1">"1"</button>
      </li>
      <li class="even">
        "2"
        " at "
        "0"
        <!---->
      </li>
      <li class="odd">
        <button id="odd3">"3"</button>
      </li>
    </ul>
    <ol id="fallback">
      <li>
        <button id="del1">"1"</button>
      </li>
      <li>
        <button id="del2">"2"</button>
      </li>
      <li>
        <button id="del3">"3"</button>
      </li>
    </ol>
  </main>
</body>
