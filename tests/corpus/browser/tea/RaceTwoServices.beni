-- Two mirrors raced in a page (transparent-effects-proposal.md §17.7):
-- `Task.raceOk` sends the same request to both. The first mirror fails,
-- which does not end the race; the second answers, wins, and the page
-- shows it. A second race: the first mirror answers first, and the other
-- request, still waiting, is aborted before the answer is shown.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Http
import Sub
import Task
import Tea


type Msg
    = Go
    | Got (Result (List Http.Error) String)


mirrors : ⊤ → Result (List Http.Error) String
mirrors ⊤ =
    Task.raceOk
        [ λ⊤ → Http.get { url = "/a/data", expect = Http.expectString }
        , λ⊤ → Http.get { url = "/b/data", expect = Http.expectString }
        ]


update : Msg, String → String × Cmd Msg
update msg model =
    case msg of
        Go →
            ( model, Cmd.task mirrors Got )

        Got (Ok text) →
            ( text, Cmd.none )

        Got (Err errors) →
            ( "every mirror failed: ${String.fromInt (List.length errors)}", Cmd.none )


view : String → Html Msg
view model =
    <main>
        <button id="go" onClick={Go}>go</button>
        <p>{model}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( "idle", Cmd.none ), update = update, view = view, subscriptions = λ_ → Sub.none }
