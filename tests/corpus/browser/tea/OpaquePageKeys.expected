-- load
<body>
  <main>
    <button id="rebuild">"rebuild"</button>
    <button id="leave">"leave"</button>
    <section>
      <p id="serial">"0"</p>
      <p id="count">"0"</p>
      <input id="text" .value="start">
      <button id="add">"add"</button>
    </section>
  </main>
</body>
-- click #add
