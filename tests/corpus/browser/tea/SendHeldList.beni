-- A command's body sends a message that holds a list the program does not own
-- (a top-level list), and `update` pushes onto a list of the model in place.
-- The message is never `update`'s own (kernel §6 rule 13), so a send asks
-- nothing of the sender: the module's writes stand.
import Cmd
import Html exposing (Html)
import Sub
import Tea


type alias Model =
    items : List Int
    seen : List String


type Msg
    = Add
    | Fetch
    | Got (List String)


names : List String
names = [ "ada", "bo" ]


type Key
    = Load


update : Msg, Model → Model × Cmd.Cmd Msg
update msg model =
    case msg of
        Add →
            ( { model | items = List.push model.items (List.length model.items + 1) }, Cmd.none )

        Fetch →
            ( model, Cmd.keyed Load Cmd.Restart λsend → send (Got names) )

        Got got →
            ( { model | seen = got }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <button id="add" onClick={Add}>add</button>
        <button id="fetch" onClick={Fetch}>fetch</button>
        <p id="items">{String.join (List.map model.items String.fromInt) ","}</p>
        <p id="seen">{String.join model.seen ","}</p>
        <p id="names">{String.join names ","}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { items = [ 1 ], seen = [] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
