-- Every way `Http` answers is a value (boundary.md §4.1, §9.8.12): a body
-- read as text, an answer read for nothing, and `BadUrl` for a URL that
-- does not parse. The requests are to `data:` URLs, which the host's own
-- `fetch` answers, so the page needs no server; each result is sent back as
-- a message and shown, sorted, since the order the answers arrive in is
-- the host's.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Http
import Sub
import Tea


type Msg
    = Fetch
    | Got String (Result Http.Error String)


show : Result Http.Error String → String
show result =
    case result of
        Ok text →
            "ok ${text}"

        Err (Http.BadUrl url) →
            "bad url ${url}"

        Err _ →
            "another error"


update : Msg, List String → List String × Cmd Msg
update msg lines =
    case msg of
        Fetch →
            ( lines
            , Cmd.batch
                [ Cmd.task
                    (λ() → Http.get { url = "data:text/plain,hello", expect = Http.expectString })
                    (Got "text" _)
                , Cmd.task
                    (λ() → Http.get { url = "data:text/plain,hello", expect = Http.expectWhatever })
                    λr → Got "whatever" (Result.map r λ() → "()")
                , Cmd.task
                    (λ() → Http.get { url = "http://[::1", expect = Http.expectString })
                    (Got "bad url" _)
                ]
            )

        Got label result →
            ( lines ++ [ "${label}: ${show result}" ], Cmd.none )


view : List String → Html Msg
view lines =
    <main>
        <button id="fetch" onClick={Fetch}>fetch</button>
        <ul><For each={List.sort lines} keyed={False}>{λs → <li>{s}</li>}</For></ul>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( [], Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
