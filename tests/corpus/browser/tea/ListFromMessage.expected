-- load
<body>
  <main>
    <button id="reverse">"reverse"</button>
    <button id="twice">"twice"</button>
    <button id="new">"new"</button>
    <button id="keep">"keep"</button>
    <button id="back">"back"</button>
    <ul>
      <li>
        <input .value="">
        "1"
        ": "
        "a"
        <!---->
      </li>
      <li>
        <input .value="">
        "2"
        ": "
        "b"
        <!---->
      </li>
      <li>
        <input .value="">
        "3"
        ": "
        "c"
        <!---->
      </li>
    </ul>
  </main>
</body>
