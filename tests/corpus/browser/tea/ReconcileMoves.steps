# Mark every row's node, and focus row c's input.
input li:nth-child(1)>input "1"
input li:nth-child(2)>input "2"
input li:nth-child(3)>input "3"
input li:nth-child(4)>input "4"
input li:nth-child(5)>input "5"
focus li:nth-child(3)>input
# a goes last, alone: c keeps the focus.
click #firstlast
# The ends trade places; c, between them, keeps the focus.
click #ends
# Reversed: every row keeps its node.
click #reverse
# Only c is kept, with its node and text; g and h are new.
click #keep
