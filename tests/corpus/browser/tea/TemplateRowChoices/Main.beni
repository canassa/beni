-- A keyed row chooses helpers which share a kind, and those helpers call
-- another helper. Only the returned block owns the physical row scope.
import Helpers
import Html exposing (Html)
import Tea


type alias Row =
    id : Int
    hot : Bool
    label : String


type Msg
    = Flip
    | Edit
    | Swap
    | Quiet


update : Msg, { rows : List Row } → { rows : List Row }
update msg model =
    case msg of
        Flip →
            { model | rows = List.update model.rows 0 λr → { r | hot = not r.hot } }
        Edit →
            { model | rows = List.update model.rows 0 λr → { r | label = r.label ++ "!" } }
        Swap →
            { model | rows = List.swap model.rows 0 1 }
        Quiet →
            model


view : { rows : List Row } → Html Msg
view model =
    <main>
        <button id="flip" onClick={Flip}>flip</button>
        <button id="edit" onClick={Edit}>edit</button>
        <button id="swap" onClick={Swap}>swap</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
        <For each={model.rows} keyed={λr → r.id}>
            {λr →
                case r.hot of
                    True →
                        Helpers.card "hot" r.label
                    False →
                        Helpers.card "cold" r.label
            }
        </For>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                { rows =
                    [ { id = 1, hot = True, label = "a" }, { id = 2, hot = False, label = "b" } ]
                }
        , update = update
        , view = view
        }
