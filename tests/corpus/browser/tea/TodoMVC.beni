-- TodoMVC (todomvc.com's markup and behaviour), the acceptance test of the
-- first browser essentials (boundary.md §9.8.10; plans/status-2026-10.md
-- §6, Milestone 1): Enter in the new-todo field adds a todo and stops the
-- key's default (`Html.key`, `Html.preventDefault`); the list is saved to
-- `localStorage` after every change and read back at start (`Storage`);
-- and the filter is the address's fragment — `#/active`, `#/completed`,
-- anything else all — read at start from `Browser.Navigation.currentUrl`
-- and followed with `onUrlChange` as the filter links are clicked. The
-- page starts with two todos stored and at `#/active`, so the completed
-- one is hidden until the filter goes back to all.
import Browser.Navigation
import Cmd exposing (Cmd)
import Html exposing (Html)
import Storage exposing (Local)
import Tea
import Url exposing (Url)


type Filter
    = All
    | Active
    | Completed


type alias Todo =
    id : Int
    title : String
    done : Bool


type alias Model =
    todos : List Todo
    draft : String
    filter : Filter
    nextId : Int


type Msg
    = Typed String
    | KeyDown Html.Event
    | Toggle Int
    | ClearCompleted
    | UrlChanged Url


-- ---- Persistence --------------------------------------------------------
-- One line per todo: "1" or "0" for done, then the title. A title comes
-- from a one-line input, so it holds no line break.


key : String
key =
    "todos-beni"


encode : List Todo -> String
encode todos =
    String.join (List.map todos (\t -> (if t.done then "1" else "0") ++ t.title)) "\n"


decode : String -> List Todo
decode text =
    List.indexedMap
        (List.filter (String.lines text) (\line -> not (String.isEmpty line)))
        (\i line -> { id = i, title = String.dropLeft line 1, done = String.startsWith line "1" })


save : List Todo -> Cmd Msg
save todos =
    Cmd.do (\() -> saved (Storage.set Local key (encode todos)))


-- A todo list too big for the quota, or storage the browser withholds,
-- is kept in the page only.
saved : Result Storage.Error () -> ()
saved _ =
    ()


-- ---- The filter, from the address ----------------------------------------


filterOf : Maybe Url -> Filter
filterOf url =
    case Maybe.andThen url (\u -> u.fragment) of
        Just "/active" ->
            Active

        Just "/completed" ->
            Completed

        _ ->
            All


-- ---- The program -----------------------------------------------------------


init : ( Model, Cmd Msg )
init =
    let
        todos =
            case Storage.get Local key of
                Just text ->
                    decode text

                Nothing ->
                    []
    in
    ( { todos = todos, draft = "", filter = filterOf (Browser.Navigation.currentUrl ()), nextId = List.length todos }, Cmd.none )


update : Msg, Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Typed text ->
            ( { model | draft = text }, Cmd.none )

        KeyDown event ->
            if Html.key event == "Enter" then
                let
                    _ =
                        Html.preventDefault event

                    title =
                        String.trim model.draft
                in
                if String.isEmpty title then
                    ( model, Cmd.none )
                else
                    changed { model | draft = "", nextId = model.nextId + 1 } (model.todos ++ [ { id = model.nextId, title = title, done = False } ])
            else
                ( model, Cmd.none )

        Toggle id ->
            changed model (List.map model.todos (\t -> if t.id == id then { t | done = not t.done } else t))

        ClearCompleted ->
            changed model (List.filter model.todos (\t -> not t.done))

        UrlChanged url ->
            ( { model | filter = filterOf (Just url) }, Cmd.none )


changed : Model, List Todo -> ( Model, Cmd Msg )
changed model todos =
    ( { model | todos = todos }, save todos )


visible : Filter, Todo -> Bool
visible filter todo =
    case filter of
        All ->
            True

        Active ->
            not todo.done

        Completed ->
            todo.done


view : Model -> Html Msg
view model =
    let
        left =
            List.length (List.filter model.todos (\t -> not t.done))
    in

    <section class="todoapp">
        <header class="header">
            <input id="new-todo" class="new-todo" value={model.draft} onInput={Typed} onKeyDown={KeyDown} />
        </header>
        <section class="main" hidden={List.isEmpty model.todos}>
            <ul class="todo-list">
                <For each={List.filter model.todos (visible model.filter _)} keyed={False}>
                    {\todo ->
                        <li class={[ ( "completed", todo.done ) ]}>
                            <div class="view">
                                <input class="toggle" type="checkbox" checked={todo.done} onCheck={\_ -> Toggle todo.id} />
                                <label>{todo.title}</label>
                            </div>
                        </li>
                    }
                </For>
            </ul>
        </section>
        <footer class="footer" hidden={List.isEmpty model.todos}>
            <span class="todo-count"><strong>{String.fromInt left}</strong>{if left == 1 then " item left" else " items left"}</span>
            <ul class="filters">
                <li><a href="#/" class={[ ( "selected", model.filter == All ) ]}>All</a></li>
                <li><a href="#/active" class={[ ( "selected", model.filter == Active ) ]}>Active</a></li>
                <li><a href="#/completed" class={[ ( "selected", model.filter == Completed ) ]}>Completed</a></li>
            </ul>
            <button id="clear-completed" class="clear-completed" hidden={left == List.length model.todos} onClick={ClearCompleted}>Clear completed</button>
        </footer>
    </section>


main : Tea.Program
main =
    Tea.element
        { init = init
        , update = update
        , view = view
        , subscriptions = \_ -> Browser.Navigation.onUrlChange UrlChanged
        }
