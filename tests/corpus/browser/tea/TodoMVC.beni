-- TodoMVC, the whole todomvc.com specification (its app-spec.md) and its
-- markup, and the acceptance test of the first browser essentials
-- (boundary.md §9.8.10). The new-todo field is focused at load
-- (`autofocus`); Enter adds its trimmed text, unless that is empty, and
-- stops the key's default (`Html.key`, `Html.preventDefault`). A row's box
-- toggles it; the toggle-all box marks every todo as itself, and is checked
-- exactly when there are todos and all are complete. A double-click on a
-- title opens an edit field, focused after the render (`Cmd.afterRender`,
-- `Dom.focus`); Enter or leaving the field saves the trimmed title, an
-- empty one deletes the todo, and Escape discards the edit. The counter
-- pluralises, and "Clear completed" is hidden when nothing is complete.
-- The list is saved to `localStorage` under `todos-beni` after every
-- change and read back at start (`Storage`); the filter is the address's
-- fragment — `#/active`, `#/completed`, anything else all — read at start
-- from `Browser.Navigation.currentUrl` and followed with `onUrlChange`.
-- The rows are keyed by the todo's id. bench/todomvc builds this file for
-- its size comparison, and derives its variants from it.
import Browser.Navigation
import Cmd exposing (Cmd)
import Dom
import Html exposing (Html)
import Storage exposing (Local)
import Tea
import Url exposing (Url)


type Filter
    = All
    | Active
    | Completed


type alias Todo =
    id : Int
    title : String
    completed : Bool


type alias Editing =
    id : Int
    draft : String


type alias Model =
    todos : List Todo
    draft : String
    filter : Filter
    nextId : Int
    editing : Maybe Editing


type Msg
    = Typed String
    | KeyDown Html.Event
    | Toggle Int
    | ToggleAll Bool
    | Destroy Int
    | ClearCompleted
    | UrlChanged Url
    | StartEdit Int String
    | EditTyped String
    | EditKey Html.Event
    | EditDone


-- ---- Persistence --------------------------------------------------------
-- One line per todo: "1" or "0" for completed, then the title. A title comes
-- from a one-line input, so it holds no line break.

key : String
key = "todos-beni"


encode : List Todo → String
encode todos = String.join (List.map todos λt → (if t.completed then "1" else "0") ++ t.title) "\n"


decode : String → List Todo
decode text =
    List.indexedMap (List.filter (String.lines text) λline → not (String.isEmpty line)) λi line →
        { id = i, title = String.dropLeft line 1, completed = String.startsWith line "1" }


save : List Todo → Cmd Msg
save todos = Cmd.do λ() → saved (Storage.set Local key (encode todos))


-- A todo list too big for the quota, or storage the browser withholds,
-- is kept in the page only.
saved : Result Storage.Error () → ()
saved _ = ()


-- ---- The filter, from the address ----------------------------------------

filterOf : Maybe Url → Filter
filterOf url =
    case Maybe.andThen url λu → u.fragment of
        Just "/active" →
            Active

        Just "/completed" →
            Completed

        _ →
            All


-- ---- The program -----------------------------------------------------------

init : Model × Cmd Msg
init =
    todos =
        case Storage.get Local key of
            Just text →
                decode text

            Nothing →
                []
    ( { todos = todos
      , draft = ""
      , filter = filterOf (Browser.Navigation.currentUrl ())
      , nextId = List.length todos
      , editing = Nothing
      }
    , Cmd.afterRender (focus "new-todo" _)
    )


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Typed text →
            ( { model | draft = text }, Cmd.none )

        KeyDown event →
            if Html.key event == "Enter" then
                _ = Html.preventDefault event

                title = String.trim model.draft
                if String.isEmpty title then
                    ( model, Cmd.none )
                else
                    changed
                        { model | draft = "", nextId = model.nextId + 1 }
                        (model.todos ++ [ { id = model.nextId, title = title, completed = False } ])
            else
                ( model, Cmd.none )

        Toggle id →
            changed
                model
                (List.map model.todos λt →
                    if t.id == id then { t | completed = not t.completed } else t
                )

        ToggleAll completed →
            changed model (List.map model.todos λt → { t | completed = completed })

        Destroy id →
            changed model (List.filter model.todos λt → t.id ≠ id)

        ClearCompleted →
            changed model (List.filter model.todos λt → not t.completed)

        UrlChanged url →
            ( { model | filter = filterOf (Just url) }, Cmd.none )

        StartEdit id title →
            ( { model | editing = Just { id = id, draft = title } }
            , Cmd.afterRender (focus "edit" _)
            )

        EditTyped text →
            ( { model | editing = Maybe.map model.editing λed → { ed | draft = text } }, Cmd.none )

        EditKey event →
            case Html.key event of
                "Enter" →
                    commit model

                "Escape" →
                    ( { model | editing = Nothing }, Cmd.none )

                _ →
                    ( model, Cmd.none )

        EditDone →
            commit model


-- Focus the element with this id once the render the update queued has
-- run: the new-todo field at load, which its `autofocus` asks for but not
-- every DOM honours for markup a script inserts (happy-dom does not), and
-- the edit field, which the update that opens it renders. Only one edit
-- field is open at a time, so it has a fixed id.
focus : String, Cmd.Send Msg → ()
focus id _ =
    case Dom.focus id of
        _ →
            ()


-- Enter and leaving the field both save; the second of the two, when Enter
-- has already closed the field, finds nothing open and does nothing.
commit : Model → Model × Cmd Msg
commit model =
    case model.editing of
        Nothing →
            ( model, Cmd.none )

        Just ed →
            title = String.trim ed.draft
            closed = { model | editing = Nothing }
            if String.isEmpty title then
                changed closed (List.filter model.todos λt → t.id ≠ ed.id)
            else
                changed
                    closed
                    (List.map model.todos λt → if t.id == ed.id then { t | title = title } else t)


changed : Model, List Todo → Model × Cmd Msg
changed model todos = ( { model | todos = todos }, save todos )


visible : Filter, Todo → Bool
visible filter todo =
    case filter of
        All →
            True

        Active →
            not todo.completed

        Completed →
            todo.completed


-- The draft of the todo being edited, when it is this one.
editingDraft : Maybe Editing, Int → Maybe String
editingDraft editing id =
    case editing of
        Just ed →
            if ed.id == id then Just ed.draft else Nothing

        Nothing →
            Nothing


isEditing : Maybe Editing, Int → Bool
isEditing editing id =
    case editingDraft editing id of
        Just _ →
            True

        Nothing →
            False


editor : Maybe String → Html Msg
editor editing =
    case editing of
        Just draft →
            <input
                id="edit"
                class="edit"
                value={draft}
                onInput={EditTyped}
                onKeyDown={EditKey}
                onBlur={λ_ → EditDone}
            />

        Nothing →
            <></>


view : Model → Html Msg
view model =
    left = List.length (List.filter model.todos λt → not t.completed)
    <section class="todoapp">
        <header class="header">
            <h1>todos</h1>
            <input
                id="new-todo"
                class="new-todo"
                placeholder="What needs to be done?"
                autofocus
                value={model.draft}
                onInput={Typed}
                onKeyDown={KeyDown}
            />
        </header>
        <section class="main" hidden={List.isEmpty model.todos}>
            <input
                id="toggle-all"
                class="toggle-all"
                type="checkbox"
                checked={left == 0 && not (List.isEmpty model.todos)}
                onCheck={ToggleAll}
            />
            <label for="toggle-all">Mark all as complete</label>
            <ul class="todo-list">
                <For each={List.filter model.todos (visible model.filter _)} keyed={.id}>
                    {λtodo →
                        <li
                            class={[ ( "completed", todo.completed )
                                   , ( "editing", isEditing model.editing todo.id )
                                   ]
                                  }
                        >
                            <div class="view">
                                <input
                                    class="toggle"
                                    type="checkbox"
                                    checked={todo.completed}
                                    onCheck={λ_ → Toggle todo.id}
                                />
                                <label onDblClick={StartEdit todo.id todo.title}>
                                    {todo.title}
                                </label>
                                <button class="destroy" onClick={Destroy todo.id} />
                            </div>
                            {editor (editingDraft model.editing todo.id)}
                        </li>
                    }
                </For>
            </ul>
        </section>
        <footer class="footer" hidden={List.isEmpty model.todos}>
            <span class="todo-count">
                <strong>{String.fromInt left}</strong>{if left == 1 then
                                                          " item left"
                                                       else
                                                          " items left"
                                                      }
            </span>
            <ul class="filters">
                <li><a href="#/" class={[ ( "selected", model.filter == All ) ]}>All</a></li>
                <li>
                    <a href="#/active" class={[ ( "selected", model.filter == Active ) ]}>Active</a>
                </li>
                <li>
                    <a href="#/completed" class={[ ( "selected", model.filter == Completed ) ]}>
                        Completed
                    </a>
                </li>
            </ul>
            <button
                id="clear-completed"
                class="clear-completed"
                hidden={left == List.length model.todos}
                onClick={ClearCompleted}
            >
                Clear completed
            </button>
        </footer>
    </section>


main : Tea.Program
main =
    Tea.element
        { init = init
        , update = update
        , view = view
        , subscriptions = λ_ → Browser.Navigation.onUrlChange UrlChanged
        }
