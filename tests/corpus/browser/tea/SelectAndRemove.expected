-- load
<body>
  <main>
    <button id="pickandgo">"select 1, remove 4"</button>
    <button id="insert">"insert selected"</button>
    <button id="goandpick">"remove 10, select 3"</button>
    <ul>
      <li class="">
        <input .value="">
        <a id="pick1">"one"</a>
        <a id="drop1">"x"</a>
      </li>
      <li class="">
        <input .value="">
        <a id="pick2">"two"</a>
        <a id="drop2">"x"</a>
      </li>
      <li class="">
        <input .value="">
        <a id="pick3">"three"</a>
        <a id="drop3">"x"</a>
      </li>
      <li class="">
        <input .value="">
        <a id="pick4">"four"</a>
        <a id="drop4">"x"</a>
      </li>
      <li class="">
        <input .value="">
        <a id="pick5">"five"</a>
        <a id="drop5">"x"</a>
      </li>
    </ul>
  </main>
</body>
