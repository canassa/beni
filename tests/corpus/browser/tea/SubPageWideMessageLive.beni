-- The live twin of `SubPageWideMessage`: the message function that `Cmd.map`
-- is handed captures the page's errors, so its answer holds them, and that
-- answer escapes. The write of the errors in place is refused.
import Cmd
import Html exposing (Html)
import Sub
import Tea


type alias Page =
    errors : List String


type PageMsg
    = Fail
    | M1 (List String)
    | M2 (List String)
    | M3 (List String)
    | M4 (List String)
    | M5 (List String)
    | M6 (List String)
    | M7 (List String)
    | M8 (List String)
    | M9 (List String)
    | M10 (List String)
    | M11 (List String)
    | M12 (List String)
    | M13 (List String)
    | M14 (List String)
    | M15 (List String)
    | M16 (List String)
    | M17 (List String)
    | M18 (List String)
    | M19 (List String)
    | M20 (List String)
    | M21 (List String)
    | M22 (List String)
    | M23 (List String)
    | M24 (List String)
    | M25 (List String)
    | M26 (List String)
    | M27 (List String)
    | M28 (List String)
    | M29 (List String)
    | M30 (List String)


pageUpdate : PageMsg, Page → Page × Cmd.Cmd PageMsg
pageUpdate msg page =
    case msg of
        Fail →
            ( { page | errors = page.errors ++ [ "failed" ] }, Cmd.none )

        _ →
            ( page, Cmd.none )


type Model
    = Article Page


type Msg
    = GotPage PageMsg
    | Tagged PageMsg (List String)


updateWith : (sub → Model), (subMsg → Msg), sub × Cmd.Cmd subMsg → Model × Cmd.Cmd Msg
updateWith toModel toMsg ( sub, subCmd ) = ( toModel sub, Cmd.map subCmd ⊤ toMsg )


update : Msg, Model → Model × Cmd.Cmd Msg
update msg model =
    case ( msg, model ) of
        ( GotPage sub, Article page ) →
            updateWith Article (λm → Tagged m page.errors) (pageUpdate sub page)

        ( Tagged sub _, Article page ) →
            updateWith Article GotPage (pageUpdate sub page)


view : Model → Html Msg
view model =
    case model of
        Article page →
            <main>
                <button id="fail" onClick={GotPage Fail}>fail</button>
                <p id="errors">{String.join page.errors ","}</p>
            </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( Article { errors = [ "first" ] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
