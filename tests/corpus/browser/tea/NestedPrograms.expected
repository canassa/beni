-- load
<body>
  <main>
    <p id="outer-log">""</p>
    <ul>
      <li id="row1">
        <div id="slot1">
          <section>
            <p id="inner-log">""</p>
            <ol>
              <li>
                <button id="pick-a">"a"</button>
              </li>
              <li>
                <button id="pick-b">"b"</button>
              </li>
            </ol>
          </section>
        </div>
      </li>
      <li id="row2">
        <div id="slot2"></div>
      </li>
    </ul>
  </main>
</body>
