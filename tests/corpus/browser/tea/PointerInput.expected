-- load
<body>
  <main>
    <div id="arena" style="position: absolute; left: 40px; top: 30px; width: 200px; height: 100px; touch-action: none">
      <span id="dot" style="position: absolute; left: 50px; top: 20px; width: 10px; height: 10px"></span>
    </div>
    <button id="zoom">"zoom"</button>
    <div id="corner" style="position: fixed; left: 0; top: 0; width: 20px; height: 20px"></div>
    <p id="held">""</p>
    <ol></ol>
  </main>
</body>
