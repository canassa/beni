-- load
<body>
  <main>
    <button id="tick">"0"</button>
    <input id="free" .value="ab">
    <input id="box" type="checkbox" .value="on" .checked=true>
  </main>
</body>
-- type #free "zz"
<body>
  <main>
    <button id="tick">"0"</button>
    <input id="free" .value="abzz">
    <input id="box" type="checkbox" .value="on" .checked=true>
  </main>
</body>
-- click #box
<body>
  <main>
    <button id="tick">"0"</button>
    <input id="free" .value="abzz">
    <input id="box" type="checkbox" .value="on" .checked=false>
  </main>
</body>
-- advance 0
<body>
  <main>
    <button id="tick">"0"</button>
    <input id="free" .value="abzz">
    <input id="box" type="checkbox" .value="on" .checked=true>
  </main>
</body>
-- click #tick
<body>
  <main>
    <button id="tick">"1"</button>
    <input id="free" .value="ab">
    <input id="box" type="checkbox" .value="on" .checked=true>
  </main>
</body>
