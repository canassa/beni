-- A shared computed root evaluates its derived scrutinee and label from
-- the current model, including same-arm changes and returning to an arm.
import Html exposing (Html)
import Tea


type Msg
    = Toggle
    | Inc
    | Quiet


type alias Model =
    open : Bool
    n : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | open = not model.open }
        Inc →
            { model | n = model.n + 1 }
        Quiet →
            model


view : Model → Html Msg
view model =
    shown = model.open
    label = model.n * 10
    case shown of
        True →
            <main>
                <button onClick={Toggle}>toggle</button><button onClick={Inc}>inc</button><p>{label}</p>
            </main>
        False →
            <main>
                <button onClick={Toggle}>toggle</button><button onClick={Quiet}>quiet</button><p>closed</p>
            </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { open = True, n = 0 }, update = update, view = view }
