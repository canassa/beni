-- The platform test of `Hosted.compare`'s trusted row
-- (`ownership-v3-kernel.md` §6 rule 10, *A platform's trusted row*): it
-- borrows both keys because every comparer it runs is a key type's own
-- `compare`, which is judged where `Hosted.key` is handed it. This key
-- type's `compare` writes its key, so `Cmd.keyed`, which hands it on, is
-- refused under `--ownership=v3`. The update of the model is accepted.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type Slot
    = Slot (List Int)


compare : Slot, Slot → Order
compare (Slot a) _ = if List.length (List.push a 0) > 0 then EQ else LT


type Msg
    = Go


type alias Model =
    n : Int


update : Msg, Model → Model × Cmd Msg
update Go model = ( { model | n = model.n + 1 }, Cmd.keyed (Slot []) Cmd.Restart λ_ → ⊤ )


view : Model → Html Msg
view model = <button id="go" onClick={Go}>{model.n}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { n = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
