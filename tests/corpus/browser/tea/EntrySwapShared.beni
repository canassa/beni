-- The live twin of `EntrySwapArms`: the `Share` arm answers the model's `w`
-- record at both `w` and `w2`, so a run can hold it at two places, and the
-- contract of `update` says so (`ownership-v3-kernel.md` §6 rule 13). `w` is
-- not `update`'s own, and `Bump`'s write of its `c` is refused: in place it
-- would change `w2` as well.

import Html exposing (Html)
import Tea


type alias Wm =
    c : Int
    t : String


type alias Model =
    w : Wm
    w2 : Wm


type Msg
    = Share
    | Bump


update : Msg, Model → Model
update msg model =
    case msg of
        Share →
            { model | w2 = model.w }

        Bump →
            w = model.w
            { model | w = { w | c = w.c + 10 } }


view : Model → Html Msg
view model =
    <main>
        <button id="share" onClick={Share}>share</button>
        <button id="bump" onClick={Bump}>bump</button>
        <p id="w">{model.w.c}:{model.w.t}</p>
        <p id="w2">{model.w2.c}:{model.w2.t}</p>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { w = { c = 1, t = "a" }, w2 = { c = 2, t = "b" } }
        , update = update
        , view = view
        }
