-- Conduit's Profile errors: rendering is a read, while Response is an owned send.
-- The rejected twin retains this same nested list in an event payload.
import Cmd
import Html exposing (Html)
import Sub
import Tea


type alias Page =
    errors : List String


type Model
    = Profile Int Page


type Msg
    = Grow
    | Response (List String)
    | Share (List String)


update : Msg, Model → Model × Cmd.Cmd Msg
update msg model =
    case ( msg, model ) of
        ( Grow, Profile id page ) →
            ( Profile id { page | errors = List.push page.errors "more" }, Cmd.none )

        ( Response errors, Profile id page ) →
            ( Profile id { page | errors = errors }, Cmd.none )

        ( Share errors, Profile id page ) →
            ( Profile id { page | errors = errors }, Cmd.none )


viewErrors : msg, List String → Html msg
viewErrors dismiss errors =
    <section>
        <For each={errors} keyed={False}>{λerror → <p>{error}</p>}</For>
        <button id="grow" onClick={dismiss}>grow</button>
    </section>


view : Model → Html Msg
view model =
    case model of
        Profile id page →
            viewErrors Grow (page.errors)


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( Profile 0 { errors = [] }, Cmd.task (λ⊤ → [ "first" ]) Response )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
