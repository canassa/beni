-- A command transfers a fresh payload to update; the receiver may edit it.
import Cmd
import Html exposing (Html)
import Sub
import Tea


type Msg
    = Start
    | Items (List Int)


update : Msg, Int → Int × Cmd.Cmd Msg
update msg n =
    case msg of
        Start →
            ( n, Cmd.perform λsend → send (Items [ 1, 2 ]) )

        Items xs →
            ( List.length (List.push xs 3), Cmd.none )


view : Int → Html Msg
view n = <main><button id="start" onClick={Start}>start</button><p>{n}</p></main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
