-- Each failure Web Storage documents is a value, and nothing else is
-- (CLAUDE.md rule 9; boundary.md §9.8.10 (b)): a `QuotaExceededError` from
-- `setItem` is `Err QuotaExceeded`; a `SecurityError` reading the area
-- makes it unavailable — `get` finds nothing, `keys` is empty, `remove`
-- does nothing and `set` is `Err Unavailable`; and a `TypeError` from
-- `setItem`, which no standard documents, is a defect that stops the page
-- (the development build's crash screen; `_expected.release-expected` has
-- none). `Storage.save`, the command form (boundary.md §9.8.16), sends its
-- tag each failure `set` returns, by the same names.
import Cmd exposing (Cmd)
import Fault
import Html exposing (Html)
import Storage exposing (Area, Local, Session)
import Sub
import Tea


type Msg
    = Quota
    | Blocked
    | Broken
    | Inc
    | SaveQuota
    | SaveBlocked
    | NotSaved Storage.Error


written : Result Storage.Error ⊤ → String
written result =
    case result of
        Ok ⊤ →
            "written"

        Err Storage.QuotaExceeded →
            "over the quota"

        Err Storage.Unavailable →
            "no storage"


update : Msg, List String → List String × Cmd Msg
update msg lines =
    case msg of
        Quota →
            Fault.fillQuota ⊤
            ( lines ++ [ written (Storage.set Local "k" "v") ], Cmd.none )

        Blocked →
            Fault.blockSession ⊤

            Storage.remove Session "k"

            found =
                case Storage.get Session "k" of
                    Just _ →
                        "found"

                    Nothing →
                        "nothing"
            ( lines
                ++ [ found
                   , "keys ${String.fromInt (List.length (Storage.keys Session))}"
                   , written (Storage.set Session "k" "v")
                   ]
            , Cmd.none
            )

        Broken →
            Fault.breakStorage ⊤
            ( lines ++ [ written (Storage.set Local "k" "v") ], Cmd.none )

        Inc →
            ( lines ++ [ "inc" ], Cmd.none )

        SaveQuota →
            Fault.fillQuota ⊤
            ( lines, Storage.save Local "k" "v" NotSaved )

        SaveBlocked →
            ( lines, Storage.save Session "k" "v" NotSaved )

        NotSaved error →
            ( lines ++ [ "saved: ${written (Err error)}" ], Cmd.none )


view : List String → Html Msg
view lines =
    <main>
        <button id="quota" onClick={Quota}>quota</button>
        <button id="blocked" onClick={Blocked}>blocked</button>
        <button id="broken" onClick={Broken}>broken</button>
        <button id="inc" onClick={Inc}>inc</button>
        <button id="save-quota" onClick={SaveQuota}>save quota</button>
        <button id="save-blocked" onClick={SaveBlocked}>save blocked</button>
        <ol><For each={lines} keyed={False}>{λline → <li>{line}</li>}</For></ol>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( [], Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
