-- The fold's fresh accumulator remains owned for a subsequent focused edit.
import Dict
import Sub
import Tea


want k kind t d = Dict.update d k λcurrent →
    ( first, taps ) = Maybe.withDefault current ( kind, [] )
    Just ( first, List.append taps [ t ] )


initial k kind = Dict.insert (Dict.empty ⊤) k ( kind, [] )


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                sub = Sub.listen 1 (λ_ → ⊤) λ_ → {}
                declared = List.map (Sub.taps (Sub.batch [ sub, sub ])) λ( _, how, tap ) →
                    ( 0, how, tap )
                rows = Dict.fromList (List.indexedMap declared λi item → ( i, item ))
                case declared of
                    [ ( k, kind, t ), …_ ] →
                        built = Dict.foldr rows (initial k kind) λ_ ( key, how, tap ) d →
                            want key how tap d
                        grown = want k kind t built
                        List.sum (List.map (Dict.values grown) λ( _, taps ) → List.length taps)
                    [] →
                        0
        , update = λ_ model → model
        , view = λmodel → <p>{model}</p>
        }
