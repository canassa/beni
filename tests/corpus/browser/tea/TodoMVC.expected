-- hash "#/"
<body>
  <section class="todoapp">
    <header class="header">
      <input id="new-todo" class="new-todo" .value="">
    </header>
    <section class="main">
      <ul class="todo-list">
        <li class="completed">
          <div class="view">
            <input class="toggle" type="checkbox" .value="on" .checked=true>
            <label>"buy milk"</label>
          </div>
        </li>
        <li class="completed">
          <div class="view">
            <input class="toggle" type="checkbox" .value="on" .checked=true>
            <label>"walk the dog"</label>
          </div>
        </li>
        <li>
          <div class="view">
            <input class="toggle" type="checkbox" .value="on" .checked=false>
            <label>"write tests"</label>
          </div>
        </li>
      </ul>
    </section>
    <footer class="footer">
      <span class="todo-count">
        <strong>"1"</strong>
        " item left"
      </span>
      <ul class="filters">
        <li>
          <a href="#/" class="selected">"All"</a>
        </li>
        <li>
          <a href="#/active" class="">"Active"</a>
        </li>
        <li>
          <a href="#/completed">"Completed"</a>
        </li>
      </ul>
      <button id="clear-completed" class="clear-completed">"Clear completed"</button>
    </footer>
  </section>
</body>
-- click #clear-completed
<body>
  <section class="todoapp">
    <header class="header">
      <input id="new-todo" class="new-todo" .value="">
    </header>
    <section class="main">
      <ul class="todo-list">
        <li class="">
          <div class="view">
            <input class="toggle" type="checkbox" .value="on" .checked=false>
            <label>"write tests"</label>
          </div>
        </li>
      </ul>
    </section>
    <footer class="footer">
      <span class="todo-count">
        <strong>"1"</strong>
        " item left"
      </span>
      <ul class="filters">
        <li>
          <a href="#/" class="selected">"All"</a>
        </li>
        <li>
          <a href="#/active" class="">"Active"</a>
        </li>
        <li>
          <a href="#/completed">"Completed"</a>
        </li>
      </ul>
      <button id="clear-completed" class="clear-completed" hidden="">"Clear completed"</button>
    </footer>
  </section>
</body>
