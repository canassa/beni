-- An event reaching a node of an arm the same dispatch tore down is
-- delivered, with the arm's variables as it last showed them
-- (docs/design/browser-direct.md §4.2, Q1, as `DetachedRowEvent` delivers
-- a row's; S4's amendment, item 3, as built): a click on the arm's button
-- closes the page, tearing the arm down, and then bubbles to the arm's
-- section, whose message reads the page's name — which the model no longer
-- holds, so it is read from what the arm kept. Elm and `browser-tea`
-- deliver it with the name the view showed.
import Html exposing (Html)
import Tea


type Page
    = Open String
    | Closed


type Msg
    = Close
    | Reopen
    | Clicked String


type alias Model =
    page : Page
    log : String


update : Msg, Model → Model
update msg model =
    case msg of
        Close →
            { model | page = Closed, log = "${model.log} closed" }

        Reopen →
            { model | page = Open "grace" }

        Clicked name →
            { model | log = "${model.log} clicked ${name}" }


view : Model → Html Msg
view model =
    <main>
        <p id="log">{model.log}</p>
        <button id="reopen" onClick={Reopen}>reopen</button>
        {case model.page of
            Open name →
                <section onClick={Clicked name}>
                    <button id="close" onClick={Close}>close</button>
                </section>

            Closed →
                <p>closed</p>
        }
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { page = Open "ada", log = "" }, update = update, view = view }
