-- `browser/dom/ControlledEdits`, rebuilt for `browser-direct` (its S4
-- amendment, item 2): a controlled element shows the model after every
-- dispatch, by the edited set — what the user changed is marked and put
-- back when the dispatch ends. Each case is one a set that marked only the
-- element a handler was found on would get wrong: a checkbox whose click
-- sends its parent's message before its `input` is dispatched (a user's
-- click, `press`); a radio group, where checking one unchecks another with
-- no event on it; and a select. Typed and rejected, typed and accepted.
-- The original's input with no handler, which `browser-tea` leaves until
-- its next render and this platform puts back at once, is
-- `ControlledNoHandler`'s.
import Html exposing (Html)
import Tea


type Msg
    = Typed String
    | Pick String
    | Tick


type alias Model =
    text : String
    on : Bool
    choice : String
    n : Int


update : Msg, Model → Model
update msg m =
    case msg of
        Typed s →
            if String.length s > 3 then m else { m | text = s }

        -- "c" is refused, from the radios and the select alike.
        Pick c →
            if c == "c" then m else { m | choice = c }

        Tick →
            { m | n = m.n + 1 }


view : Model → Html Msg
view m =
    <main>
        <button id="tick" onClick={Tick}>{m.n}</button>
        <input id="text" value={m.text} onInput={Typed} />
        <div onClick={Tick}><input id="box" type="checkbox" checked={m.on} /></div>
        <input id="ra" type="radio" name="g" checked={m.choice == "a"} onClick={Pick "a"} />
        <input id="rb" type="radio" name="g" checked={m.choice == "b"} onClick={Pick "b"} />
        <input id="rc" type="radio" name="g" checked={m.choice == "c"} onClick={Pick "c"} />
        <select id="sel" value={m.choice} onInput={Pick}>
            <option value="a">a</option>
            <option value="b">b</option>
            <option value="c">c</option>
        </select>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { text = "ab", on = False, choice = "a", n = 0 }
        , update = update
        , view = view
        }
