-- Imported helpers inside keyed and positional rows retain per-row state.
-- A list edit reaches one row; a global prefix reaches only prefix holes.
import Helpers
import Html exposing (Html)
import Tea


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    prefix : String


type Msg
    = Edit
    | Swap
    | Prefix
    | Quiet


update : Msg, Model → Model
update msg model =
    case msg of
        Edit →
            { model | rows = List.update model.rows 0 λrow → { row | label = row.label ++ "!" } }
        Swap →
            { model | rows = List.swap model.rows 0 1 }
        Prefix →
            { model | prefix = model.prefix ++ "+" }
        Quiet →
            model


view : Model → Html Msg
view model =
    <main>
        <button id="edit" onClick={Edit}>edit</button>
        <button id="swap" onClick={Swap}>swap</button>
        <button id="prefix" onClick={Prefix}>prefix</button>
        <button id="quiet" onClick={Quiet}>quiet</button>
        <ul id="keyed">
            <For each={model.rows} keyed={.id}>
                {λrow → <li><input />{Helpers.card model.prefix row.label}</li>}
            </For>
        </ul>
        <ul id="positional">
            <For each={model.rows} keyed={False}>
                {λrow → <li>{Helpers.card model.prefix row.label}</li>}
            </For>
        </ul>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { rows = [ { id = 1, label = "a" }, { id = 2, label = "b" } ], prefix = ">" }
        , update = update
        , view = view
        }
