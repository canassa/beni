-- `browser/tea/DefectInRender` on `browser-direct` (§8.2; S4's amendment,
-- item 6): a throw in `view` stops the page (boundary.md §9.8.10 (c)). On
-- `browser-tea` the throw is the flush's, on the microtask after the click;
-- here a message's handler writes the page, so it is the click's, in the
-- group of the hole that throws, inside the guard. The host reports it,
-- and no later message is applied or written, so "fix" changes nothing.
-- The throw stands in a hole: the original's is a statement of `view`,
-- which this platform runs where the page is made only (§8.4, S3's rule),
-- so it would never throw on a message. The development build's crash
-- screen carries the error the host reported; the release build adds
-- nothing (`DefectInRender.release-expected`). `browser/tea/
-- DefectInTurnRender` is not rebuilt: it pins a render at the end of a
-- trusted turn, and this platform renders in no turn.
import Html exposing (Html)
import Tea


type Msg
    = Bad
    | Fix
    | Inc


type alias Model =
    count : Int
    bad : Bool


update : Msg, Model → Model
update msg model =
    case msg of
        Bad →
            { model | bad = True }

        Fix →
            { model | bad = False }

        Inc →
            { model | count = model.count + 1 }


view : Model → Html Msg
view model =
    <main>
        <p id="count">
            {if model.bad then Debug.todo "view threw" else String.fromInt model.count}
        </p>
        <button id="bad" onClick={Bad}>bad</button>
        <button id="fix" onClick={Fix}>fix</button>
        <button id="inc" onClick={Inc}>inc</button>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { count = 0, bad = False }, update = update, view = view }
