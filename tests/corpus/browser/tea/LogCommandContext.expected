-- load
<body>
  <main>
    <button id="perform">"perform"</button>
    <button id="keyed">"keyed"</button>
    <button id="task">"task"</button>
    <button id="after">"after"</button>
    <button id="mapped">"mapped"</button>
    <button id="plain">"plain"</button>
    <button id="sink">"sink"</button>
    <button id="show">"show"</button>
    <p>"0"</p>
  </main>
</body>
-- click #perform
console.debug: a body that does not wait {"request":"p1"}
<body>
  <main>
    <button id="perform">"perform"</button>
    <button id="keyed">"keyed"</button>
    <button id="task">"task"</button>
    <button id="after">"after"</button>
    <button id="mapped">"mapped"</button>
    <button id="plain">"plain"</button>
    <button id="sink">"sink"</button>
    <button id="show">"show"</button>
    <p>"1"</p>
  </main>
</body>
-- advance 5
console.debug: a body after a wait {"request":"p1"}
(the DOM did not change)
-- click #keyed
console.info: a keyed body that does not wait save=0ms {"request":"k1"}
<body>
