  <main class="machine">
    <svg:svg viewBox="-12 0 412 560" role="img" aria-label="A ball machine: balls wait for room to enter, fill a bucket that a trapdoor drops down a pipe, and are checked at the bottom; failed ones are blown back up a tube to try again.">
