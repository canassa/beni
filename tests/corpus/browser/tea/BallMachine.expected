          <svg:rect fill="url(#steel)" stroke="rgba(255, 255, 255, 0.06)" stroke-width="0.6" filter="url(#shadow)" x="119.0" y="218.4" width="62.0" height="5.2" rx="1.8"></svg:rect>
          <svg:line stroke="rgba(255, 255, 255, 0.16)" stroke-width="0.7" x1="120.8" y1="218.9" x2="179.2" y2="218.9"></svg:line>
        </svg:g>
        <svg:circle r="1.4" fill="url(#bolt)" cx="122.2" cy="221.0"></svg:circle>
