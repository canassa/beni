        <svg:rect x="197.5" y="450" width="7" height="1"></svg:rect>
      </svg:g>
      <svg:g>
        <svg:g>
          <svg:rect fill="url(#steel)" stroke="rgba(255, 255, 255, 0.06)" stroke-width="0.6" filter="url(#shadow)" x="119.0" y="436.4" width="62.0" height="5.2" rx="1.8"></svg:rect>
          <svg:line stroke="rgba(255, 255, 255, 0.16)" stroke-width="0.7" x1="120.8" y1="436.9" x2="179.2" y2="436.9"></svg:line>
        </svg:g>
        <svg:circle r="1.4" fill="url(#bolt)" cx="122.2" cy="439.0"></svg:circle>
        <svg:circle r="1.4" fill="url(#bolt)" cx="177.8" cy="439.0"></svg:circle>
      </svg:g>
      <svg:rect x="128" y="498" width="44" height="12" rx="2" fill="#0B0810" stroke="rgba(255, 154, 60, 0.25)" stroke-width="0.6"></svg:rect>
      <svg:text class="display" x="150" y="504.5" text-anchor="middle" dominant-baseline="middle" fill="#FF9A3C">
        "–"
        "/s"
      </svg:text>
      <svg:circle cx="180" cy="504" r="1.6" fill="rgba(143, 135, 161, 0.3)"></svg:circle>
      <svg:circle cx="186" cy="504" r="1.6" fill="rgba(143, 135, 161, 0.3)"></svg:circle>
      <svg:g class="pools">
        <svg:circle cx="150" cy="94" r="34" fill="url(#poolViolet)" opacity="0.16"></svg:circle>
