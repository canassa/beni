          <svg:line x1="176.0" y1="440.0" x2="192.0" y2="440.0"></svg:line>
          <svg:line x1="108.0" y1="440.0" x2="141.5" y2="474.0"></svg:line>
          <svg:line x1="192.0" y1="440.0" x2="158.5" y2="474.0"></svg:line>
          <svg:line x1="25.0" y1="474.0" x2="141.5" y2="474.0"></svg:line>
