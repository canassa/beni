      "26"
      <!---->
      " done · "
      "3"
      <!---->
      " failed"
    </p>
    <div class="knobs">
      <label class="knob">
        "At once "
        <output>"8"</output>
        <input id="at-once" type="range" min="1" max="8" .value="8">
      </label>
      <label class="knob">
        "Per batch "
        <output>"3"</output>
        <input id="per-batch" type="range" min="1" max="5" .value="3">
      </label>
    </div>
  </main>
</body>
-- input #at-once "2"
<body>
  <main class="machine">
    <svg:svg viewBox="-12 0 412 560" role="img" aria-label="A ball machine: balls wait for room to enter, fill a bucket that a trapdoor drops down a pipe, and are checked at the bottom; failed ones are blown back up a tube to try again.">
      <svg:defs>
        <svg:linearGradient id="steel" x1="0" y1="0" x2="0" y2="1">
          <svg:stop offset="0" stop-color="#4D4260"></svg:stop>
          <svg:stop offset="0.5" stop-color="#2C2438"></svg:stop>
          <svg:stop offset="1" stop-color="#17121F"></svg:stop>
        </svg:linearGradient>
        <svg:linearGradient id="bucketSteel" x1="0" y1="0" x2="1" y2="0">
          <svg:stop offset="0" stop-color="#17121F"></svg:stop>
          <svg:stop offset="0.32" stop-color="#4D4260"></svg:stop>
          <svg:stop offset="1" stop-color="#17121F"></svg:stop>
        </svg:linearGradient>
        <svg:linearGradient id="glass" x1="0" y1="0" x2="1" y2="0">
          <svg:stop offset="0" stop-color="#FFFFFF" stop-opacity="0.11"></svg:stop>
          <svg:stop offset="0.1" stop-color="#FFFFFF" stop-opacity="0.025"></svg:stop>
          <svg:stop offset="0.5" stop-color="#0A0610" stop-opacity="0.12"></svg:stop>
          <svg:stop offset="0.9" stop-color="#FFFFFF" stop-opacity="0.025"></svg:stop>
          <svg:stop offset="1" stop-color="#FFFFFF" stop-opacity="0.08"></svg:stop>
        </svg:linearGradient>
        <svg:linearGradient id="sheen" x1="0" y1="0" x2="1" y2="0">
          <svg:stop offset="0" stop-color="#FFFFFF" stop-opacity="0"></svg:stop>
          <svg:stop offset="0.5" stop-color="#FFFFFF" stop-opacity="0.12"></svg:stop>
          <svg:stop offset="1" stop-color="#FFFFFF" stop-opacity="0"></svg:stop>
        </svg:linearGradient>
        <svg:linearGradient id="hopperGlass" x1="0" y1="0" x2="1" y2="0">
          <svg:stop offset="0" stop-color="#FFFFFF" stop-opacity="0.07"></svg:stop>
          <svg:stop offset="0.3" stop-color="#FFFFFF" stop-opacity="0.02"></svg:stop>
          <svg:stop offset="1" stop-color="#FFFFFF" stop-opacity="0.04"></svg:stop>
        </svg:linearGradient>
        <svg:linearGradient id="hopperShade" x1="0" y1="0" x2="0" y2="1">
          <svg:stop offset="0" stop-color="#17121F" stop-opacity="0"></svg:stop>
          <svg:stop offset="1" stop-color="#17121F" stop-opacity="0.45"></svg:stop>
        </svg:linearGradient>
        <svg:linearGradient id="chip" x1="0" y1="0" x2="0" y2="1">
          <svg:stop offset="0" stop-color="#D8C9FF"></svg:stop>
          <svg:stop offset="1" stop-color="#8E6BEA"></svg:stop>
        </svg:linearGradient>
        <svg:radialGradient id="bolt" cx="0.5" cy="0.5" r="0.5" fx="0.4" fy="0.35">
          <svg:stop offset="0" stop-color="#9A8EB0"></svg:stop>
          <svg:stop offset="1" stop-color="#17121F"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="ballOrange" cx="0.5" cy="0.5" r="0.5" fx="0.33" fy="0.28" fr="0.04">
          <svg:stop offset="0" stop-color="#FFE3BF"></svg:stop>
          <svg:stop offset="0.5" stop-color="#FF9A3C"></svg:stop>
          <svg:stop offset="1" stop-color="#C9631A"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="ballRed" cx="0.5" cy="0.5" r="0.5" fx="0.33" fy="0.28" fr="0.04">
          <svg:stop offset="0" stop-color="#FFC4BE"></svg:stop>
          <svg:stop offset="0.5" stop-color="#FF5C5C"></svg:stop>
          <svg:stop offset="1" stop-color="#B32E36"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="ballDone" cx="0.5" cy="0.5" r="0.5" fx="0.33" fy="0.28" fr="0.04">
          <svg:stop offset="0" stop-color="#FFFFFF"></svg:stop>
          <svg:stop offset="0.5" stop-color="#F1EDF7"></svg:stop>
          <svg:stop offset="1" stop-color="#9F97AF"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="poolViolet">
          <svg:stop offset="0" stop-color="#B79CFF"></svg:stop>
          <svg:stop offset="1" stop-color="#B79CFF" stop-opacity="0"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="poolRed">
          <svg:stop offset="0" stop-color="#FF5C5C"></svg:stop>
          <svg:stop offset="1" stop-color="#FF5C5C" stop-opacity="0"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="poolOrange">
          <svg:stop offset="0" stop-color="#FF9A3C"></svg:stop>
          <svg:stop offset="1" stop-color="#FF9A3C" stop-opacity="0"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="backGlow" gradientUnits="userSpaceOnUse" cx="150" cy="269" r="255">
          <svg:stop offset="0" stop-color="#8B5CF6" stop-opacity="0.1"></svg:stop>
          <svg:stop offset="1" stop-color="#8B5CF6" stop-opacity="0"></svg:stop>
        </svg:radialGradient>
        <svg:radialGradient id="fadeOut" gradientUnits="userSpaceOnUse" cx="150" cy="269" r="280">
          <svg:stop offset="0" stop-color="#FFFFFF"></svg:stop>
          <svg:stop offset="1" stop-color="#FFFFFF" stop-opacity="0"></svg:stop>
        </svg:radialGradient>
        <svg:mask id="fade">
          <svg:rect x="-200" y="0" width="800" height="560" fill="url(#fadeOut)"></svg:rect>
        </svg:mask>
        <svg:pattern id="dots" width="14" height="14" patternUnits="userSpaceOnUse">
          <svg:rect x="7" y="7" width="0.8" height="0.8" fill="#B79CFF" fill-opacity="0.1"></svg:rect>
        </svg:pattern>
        <svg:clipPath id="pipeClip">
          <svg:rect x="124" y="220" width="52" height="220"></svg:rect>
        </svg:clipPath>
        <svg:filter id="shadow" x="-20%" y="-30%" width="140%" height="180%">
          <svg:feGaussianBlur in="SourceAlpha" stdDeviation="4"></svg:feGaussianBlur>
          <svg:feOffset dy="3" result="blur"></svg:feOffset>
          <svg:feFlood flood-color="#000000" flood-opacity="0.55"></svg:feFlood>
          <svg:feComposite in2="blur" operator="in"></svg:feComposite>
          <svg:feMerge>
            <svg:feMergeNode></svg:feMergeNode>
            <svg:feMergeNode in="SourceGraphic"></svg:feMergeNode>
          </svg:feMerge>
        </svg:filter>
        <svg:filter id="rodShadow" x="-10%" y="-10%" width="120%" height="120%">
          <svg:feGaussianBlur in="SourceAlpha" stdDeviation="2"></svg:feGaussianBlur>
          <svg:feOffset dy="1.5" result="blur"></svg:feOffset>
          <svg:feFlood flood-color="#000000" flood-opacity="0.55"></svg:feFlood>
          <svg:feComposite in2="blur" operator="in"></svg:feComposite>
          <svg:feMerge>
            <svg:feMergeNode></svg:feMergeNode>
            <svg:feMergeNode in="SourceGraphic"></svg:feMergeNode>
          </svg:feMerge>
        </svg:filter>
        <svg:filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
          <svg:feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></svg:feGaussianBlur>
          <svg:feMerge>
            <svg:feMergeNode in="blur"></svg:feMergeNode>
            <svg:feMergeNode in="SourceGraphic"></svg:feMergeNode>
          </svg:feMerge>
        </svg:filter>
        <svg:filter id="ballShadow" x="-10%" y="-10%" width="120%" height="120%">
          <svg:feGaussianBlur in="SourceAlpha" stdDeviation="1.5"></svg:feGaussianBlur>
