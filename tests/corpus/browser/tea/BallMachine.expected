          <svg:line x1="104.0" y1="176.0" x2="126.0" y2="216.0"></svg:line>
          <svg:line x1="196.0" y1="176.0" x2="174.0" y2="216.0"></svg:line>
          <svg:line x1="126.0" y1="216.0" x2="124.0" y2="220.0"></svg:line>
