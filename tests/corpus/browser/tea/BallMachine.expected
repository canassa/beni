      </svg:g>
      <svg:g stroke-linecap="round">
        <svg:g stroke-width="3.4" filter="url(#rodShadow)" stroke="#2C2438">
          <svg:line x1="55.0" y1="14.0" x2="139.0" y2="92.0"></svg:line>
