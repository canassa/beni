-- `Html.Markdown` in a page (docs/design/markdown.md §6, §8): the six
-- article-body payloads of the RealWorld e2e suite
-- (specs/e2e/xss-security.spec.ts:66) are text, so the page holds no
-- `script`, no `on…` attribute and no element of the text's own, and a
-- script URL is an empty `href`. A quote in a code block's language stays
-- inside `class`. The text's Markdown is still Markdown.
import Html exposing (Html)
import Html.Markdown
import Tea


body : String
body =
    String.join
        [ "## Before *payloads*"
        , "Before payload: <script>alert(1)</script> After payload"
        , "Before payload: <img src=x onerror=\"alert(1)\"> After payload"
        , "Before payload: <svg onload=\"alert(1)\"> After payload"
        , "Before payload: <iframe srcdoc=\"<script>alert(1)</script>\"> After payload"
        , "Before payload: <a href=\"javascript:alert(1)\">click me</a> After payload"
        , "<div onmouseover=\"alert(1)\">hover me</div>"
        , "[a link](javascript:alert(1)) and [a safe one](https://example.com)"
        , "```a\"onclick=alert(1)\ncode\n```"
        ]
        "\n\n"


view : ⊤ → Html ⊤
view model = <div class="article-content">{Html.Markdown.fromString body}</div>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → ⊤, update = λmsg model → model, view = view }
