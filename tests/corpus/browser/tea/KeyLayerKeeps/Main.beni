-- A key type whose `compare` keeps its list, made a key inside a project's
-- own platform layer (`ownership-v3-kernel.md` §6 rule 10, *A platform's
-- trusted row*; research report 154's first review). `Hosted.compare`
-- borrows both keys because every comparer it runs was judged where
-- `Hosted.key` was handed it. That judgment is in the layer, a package
-- whose writes the build does not enforce, so a refusal of evidence stops
-- the build of every package: `Stash.key` is refused under
-- `--ownership=v3`. Accepted, the push after kept `ys` stale.
import Cmd exposing (Cmd)
import Hosted
import Html exposing (Html)
import Stash
import Sub
import Tea


type Msg
    = Go


type alias Model =
    n : Int


update : Msg, Model → Model × Cmd Msg
update Go model =
    ys = [ 5 ]
    o = Hosted.compare (Stash.key ys) (Stash.key [ 6, 7 ])
    zs = List.push ys 7
    kept = Stash.stashed ⊤
    gt = if o == GT then 1 else 0
    ( { model | n = model.n * 1000 + gt * 100 + List.length kept * 10 + List.length zs }, Cmd.none )


view : Model → Html Msg
view model = <button id="go" onClick={Go}>{model.n}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { n = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
