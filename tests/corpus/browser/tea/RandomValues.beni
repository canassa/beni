-- `Random` (boundary.md §9.8.10 (b)), Elm's generators: `step` on a seed
-- from `initialSeed` is pure, so the same seed gives the same values in
-- every build, and `generate` runs a generator as a command on the page's
-- seed, which starts from `crypto.getRandomValues` (a fixed sequence under
-- the page driver). `value` runs one on the same seed directly, here in
-- `update` (§9.8.11): `#draw` continues the sequence `#roll` stepped, and
-- `#roll` after it continues `#draw`'s. `int` stays within its bounds
-- whichever way round they are given; `uniform`, `weighted`, `pair`,
-- `list`, `map`, `andThen`, `constant` and `independentSeed` each make one
-- value here.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Random exposing (Generator)
import Sub
import Tea


type Msg
    = Roll
    | Rolled (List Int)
    | Draw


die : Generator Int
die = Random.int 1 6


samples : List String
samples =
    seed = Random.initialSeed 42

    ints = (Random.step (Random.list die 10) seed).0

    backwards = (Random.step (Random.list (Random.int 10 5) 6) seed).0

    coin = (Random.step (Random.uniform "heads" [ "tails" ]) seed).0

    weather = (Random.step (Random.weighted ( 0, "never" ) [ ( 1, "always" ) ]) seed).0

    both = (Random.step (Random.pair die (Random.constant "x")) seed).0

    chosen =
        (Random.step
            (Random.andThen die λn → Random.map (Random.int 0 n) λm → m ≤ n)
            seed
        ).0

    fraction = (Random.step (Random.float 0 1) seed).0

    fromChild =
        case Random.step Random.independentSeed seed of
            ( child, _ ) →
                (Random.step die child).0
    [ "ints " ++ nums ints
    , "backwards " ++ nums backwards
    , "coin ${coin}"
    , "weather ${weather}"
    , "pair ${String.fromInt both.0} ${both.1}"
    , "andThen "
        ++ (if chosen then
               "within"
            else
               "outside"
           )
    , "float "
        ++ (if fraction ≥ 0 && fraction < 1 then
               "in [0, 1)"
            else
               "out of range"
           )
    , "child ${String.fromInt fromChild}"
    ]


update : Msg, List Int → List Int × Cmd Msg
update msg rolls =
    case msg of
        Roll →
            ( rolls, Random.generate (Random.list die 3) Rolled )

        Rolled more →
            ( rolls ++ more, Cmd.none )

        Draw →
            ( rolls ++ Random.value (Random.list die 3), Cmd.none )


view : List Int → Html Msg
view rolls =
    <main>
        <ul><For each={samples} keyed={False}>{λline → <li>{line}</li>}</For></ul>
        <button id="roll" onClick={Roll}>roll</button>
        <button id="draw" onClick={Draw}>draw</button>
        <p id="rolls">{nums rolls}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( [], Cmd.none ), update = update, view = view, subscriptions = λ_ → Sub.none }


nums : List Int → String
nums ns = String.join (List.map ns String.fromInt) " "
