-- The compact reconcile's moves (browser-direct.md, *Amended 2026-10-11
-- (the lean slice, as specified)*): rows a key keeps are moved, never made
-- again, and only the rows that must move are. Moving the first row to the
-- end moves that row alone, so the focused input of another keeps the
-- focus; the first and the last trading places are two moves; a reversal
-- moves what it must; a replacement that keeps one row in the middle keeps
-- its node and its typed text, and the new rows are made around it. Every
-- edit here is `replaced` to the write set (`List.reverse`, a list built
-- from parts), so each reaches the reconcile. The inputs are not
-- controlled: typed text shows which node is where.
import Browser
import Html exposing (Html)
import Tea


type Msg
    = FirstLast
    | Ends
    | Reverse
    | KeepMiddle


type alias Row =
    id : Int
    label : String


update : Msg, List Row → List Row
update msg rows =
    case msg of
        FirstLast →
            case rows of
                [ first, …rest ] →
                    [ …rest, first ]

                [] →
                    rows

        Ends →
            case rows of
                [ first, …middle, last ] →
                    [ last, …middle, first ]

                _ →
                    rows

        Reverse →
            List.reverse rows

        KeepMiddle →
            [ { id = 7, label = "g" }
            , …List.filter rows λrow → row.id == 3
            , { id = 8, label = "h" }
            ]


view : List Row → Html Msg
view rows =
    <main>
        <button id="firstlast" onClick={FirstLast}>first last</button>
        <button id="ends" onClick={Ends}>ends</button>
        <button id="reverse" onClick={Reverse}>reverse</button>
        <button id="keep" onClick={KeepMiddle}>keep middle</button>
        <ul>
            <For each={rows} keyed={.id}>
                {λrow → <li><input />{row.label}</li>}
            </For>
        </ul>
    </main>


main : Browser.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                [ { id = 1, label = "a" }
                , { id = 2, label = "b" }
                , { id = 3, label = "c" }
                , { id = 4, label = "d" }
                , { id = 5, label = "e" }
                ]
        , update = update
        , view = view
        }
