-- The GPU image sources on the main thread: acquisition from elements,
-- ImageData over a native pixel view, bitmaps, decode, VideoFrame lifetimes,
-- canvases, bitmaprenderer presentation and each typed failure. happy-dom has
-- no native sources (Probe.nativeSources), so the gate's transcript stops at
-- once; Chrome's golden (`_expected.chrome-expected`) holds the answers.
import Binary
import Browser.Canvas as Canvas
import Browser.Image as Image
import Browser.Source as Source
import Browser.Video as Video
import Cmd exposing (Cmd)
import Html exposing (Html)
import Probe
import String
import Sub
import Tea


type Msg
    = Run
    | Lines String


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( "ready", Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }


update : Msg, String → String × Cmd Msg
update message model =
    case message of
        Run →
            ( model, Cmd.perform λsend → send (Lines (String.join (run ⊤) "\n")) )
        Lines lines →
            ( lines, Cmd.none )


view : String → Html Msg
view model =
    <main>
        <button id="run" onClick={Run}>run</button><canvas id="canvas" width={4} height={4} /><img id="image" /><video id="video" />
        <pre>{model}</pre>
    </main>


show : String, a → String
show label value = label ++ ": " ++ Debug.toString value


-- The acquisition and dimension checks run in every DOM, happy-dom included;
-- the native sources only where the DOM has them.
run : ⊤ → List String
run ⊤ =
    [ …elements ⊤
    , …sizes ⊤
    , …(if Probe.nativeSources ⊤ then exercise ⊤ else [ "this DOM has no native image sources" ])
    ]


exercise : ⊤ → List String
exercise ⊤ =
    case Image.data 2 2 Image.settings of
        Err error →
            [ show "data" (Err error) ]
        Ok data →
            [ …pixels data, …bitmaps data, …frames data, …canvases data ]


pixels : Image.Data → List String
pixels data =
    aliased =
        case Image.pixels data of
            Err error →
                Err error
            Ok storage →
                _ = Binary.writeU8 storage 0 255
                Result.andThen (Image.pixels data) λsecond → Ok (Binary.readU8 second 0)
    clamped = pixelStorage Binary.U8Clamped
    plain = pixelStorage Binary.U8
    fromView =
        Image.dataFromView clamped 2 Nothing Image.settings
            ▷ Result.map λmade → Source.info (Source.FromPixels made)
    [ show "pixel alias" aliased
    , show "data info" (Source.info (Source.FromPixels data))
    , show "data zero" (Image.data 0 2 Image.settings)
    , show "data from view" fromView
    , show
        "wrong view"
        (Image.dataFromView plain 2 Nothing Image.settings)
    , show
        "inconsistent"
        (Image.dataFromView clamped 3 Nothing Image.settings)
    , show
        "wrong height"
        (Image.dataFromView clamped 2 (Just 3) Image.settings)
    , show
        "video info"
        (Video.byId "video" ▷ Result.map λvideo → Source.info (Source.FromVideo video))
    , show "shared" (Binary.shared 8 ▷ Result.map λ_ → "shared")
    ]


elements : ⊤ → List String
elements ⊤ =
    [ show "canvas" (Canvas.byId "canvas" ▷ Result.map Canvas.size)
    , show "canvas missing" (Canvas.byId "nothing")
    , show "canvas wrong" (Canvas.byId "image")
    , show "image" (Image.byId "image" ▷ Result.map λimage → Source.info (Source.FromImage image))
    , show "image wrong" (Image.byId "video")
    , show "video" (Video.byId "video" ▷ Result.map λ_ → "video")
    , show "video wrong" (Video.byId "canvas")
    ]


bitmaps : Image.Data → List String
bitmaps data =
    options =
        { Image.bitmapOptions
            | resizeWidth = Just 3
            , resizeHeight = Just 3
            , orientation = Image.FlipY
        }
    density = Probe.densityImage ⊤
    decoded = Image.decodeElement density
    bitmap = Image.bitmap (Source.FromPixels data) Nothing options
    infoBefore = Result.map bitmap λmade → Source.info (Source.FromBitmap made)
    closed = Result.map bitmap λmade →
        Image.close made
        Source.info (Source.FromBitmap made)
    broken =
        case Image.byId "image" of
            Ok image →
                Image.bitmap (Source.FromImage image) Nothing Image.bitmapOptions
                    ▷ Result.map λ_ → "bitmap"
            Err error →
                Err error
    [ show "bitmap" infoBefore
    , show "bitmap closed" closed
    , show "density decode" decoded
    , show "density" (Source.info (Source.FromImage density))
    , show
        "density bitmap"
        (Image.bitmap
            (Source.FromImage density)
            (Just { x = 0, y = 0, width = -2, height = 2 })
            Image.bitmapOptions
            ▷ Result.map λmade → Source.info (Source.FromBitmap made)
        )
    , show
        "zero crop"
        (Image.bitmap
            (Source.FromPixels data)
            (Just { x = 0, y = 0, width = 0, height = 1 })
            Image.bitmapOptions
            ▷ Result.map λ_ → "bitmap"
        )
    , show
        "zero resize"
        (Image.bitmap (Source.FromPixels data) Nothing
            { Image.bitmapOptions | resizeWidth = Just 0 }
            ▷ Result.map λ_ → "bitmap"
        )
    , show "broken image" broken
    , show
        "broken decode"
        (Image.load "data:image/png;base64,AAAA" Image.SameOrigin ▷ Result.map λ_ → "decoded")
    , show
        "png bytes"
        (Image.bitmapFromBytes
            (Binary.WholeBuffer (Probe.pngBytes ⊤))
            "image/png"
            Nothing
            Image.bitmapOptions
            ▷ Result.map λmade → Source.info (Source.FromBitmap made)
        )
    , show
        "bad bytes"
        (Image.bitmapFromBytes
            (Binary.WholeBuffer (must (Binary.fromList [ 1, 2, 3 ])))
            "image/png"
            Nothing
            Image.bitmapOptions
            ▷ Result.map λ_ → "bitmap"
        )
    ]


frames : Image.Data → List String
frames data =
    canvas = Canvas.byId "canvas"
    frame =
        case canvas of
            Ok element →
                Result.mapError
                    (Video.frame (Source.FromCanvas element)
                        { Video.frameOptions | timestamp = Just 5, duration = Just 2 }
                    )
                    λerror → Debug.toString error
            Err error →
                Err (Debug.toString error)
    density = Probe.densityImage ⊤
    _ = Image.decodeElement density
    densityFrame =
        Video.frame (Source.FromImage density)
            { Video.frameOptions
                | timestamp = Just 0
                , visibleRect = Just { x = 0, y = 0, width = 4, height = 4 }
                , displaySize = Just { width = 4, height = 4 }
            }
    densityInfo = Result.map densityFrame λmade →
        info = Video.info made
        Video.close made
        ( info.codedWidth, info.displayWidth )
    hiddenCrop =
        Video.frame (Source.FromImage density)
            { Video.frameOptions
                | timestamp = Just 0
                , visibleRect = Just { x = 0, y = 0, width = 5, height = 4 }
                , displaySize = Just { width = 5, height = 4 }
            }
            ▷ Result.map λmade →
                Video.close made
                "frame"
    lifetimes = Result.andThen frame λmade →
        info = Video.info made
        clone = Result.mapError (Video.clone made) λerror → Debug.toString error
        Video.close made
        Video.close made
        after = Video.clone made
        live = Result.map clone λcopy → not (Video.closed copy)
        _ = Result.map clone Video.close
        Ok
            [ Debug.toString ( info.codedWidth, info.timestamp, info.duration )
            , Debug.toString ( Video.closed made, live )
            , Debug.toString after
            ]
    bitmapFrame =
        case Image.bitmap (Source.FromPixels data) Nothing Image.bitmapOptions of
            Ok bitmap →
                [ show
                    "missing timestamp"
                    (Video.frame (Source.FromBitmap bitmap) Video.frameOptions
                        ▷ Result.map λ_ → "frame"
                    )
                , show
                    "tiny crop"
                    (Video.frame (Source.FromBitmap bitmap)
                        { Video.frameOptions
                            | timestamp = Just 0
                            , visibleRect = Just { x = 0, y = 0, width = 0.1, height = 1 }
                        }
                        ▷ Result.map λ_ → "frame"
                    )
                , show
                    "pixels source"
                    (Video.frame (Source.FromPixels data)
                        { Video.frameOptions | timestamp = Just 0 }
                        ▷ Result.map λ_ → "frame"
                    )
                ]
            Err error →
                [ show "bitmap" (Err error) ]
    [ show "frame lifetimes" lifetimes
    , show "density frame" densityInfo
    , show "hidden crop" hiddenCrop
    , …bitmapFrame
    ]


canvases : Image.Data → List String
canvases data =
    presented =
        case
            ( Canvas.offscreen 2 2
            , Image.bitmap (Source.FromPixels data) Nothing Image.bitmapOptions
            )
        of
            ( Ok surface, Ok bitmap ) →
                noContext = Canvas.snapshot surface ▷ Result.map λ_ → "snapshot"
                info = Source.info (Source.FromOffscreen surface)
                case Canvas.offscreenBitmapRenderer surface of
                    Ok renderer →
                        first = Canvas.present renderer bitmap
                        consumed = (Source.info (Source.FromBitmap bitmap)).state
                        second = Canvas.present renderer bitmap
                        snapshot =
                            Canvas.snapshot surface
                                ▷ Result.map λmade → Source.info (Source.FromBitmap made)
                        [ show "offscreen" info
                        , show "no context" noContext
                        , show "present" ( first, consumed, second )
                        , show "snapshot" snapshot
                        ]
                    Err error →
                        [ show "renderer" (Err error) ]
            ( surface, bitmap ) →
                [ show
                    "offscreen"
                    ( Result.map surface λ_ → "offscreen", Result.map bitmap λ_ → "bitmap" )
                ]
    presented


pixelStorage : Binary.ViewKind → Binary.View
pixelStorage kind = must (Binary.view (Binary.Local (must (Binary.allocate 32))) kind Binary.whole)


-- Setup that must succeed; a failure here is a broken fixture, not a result.
must : Result e a → a
must result =
    case result of
        Ok value →
            value
        Err error →
            Debug.todo (Debug.toString error)


-- HTML reflects a canvas dimension as `unsigned long`, so above 2^31 − 1 it
-- would reset to the default; OffscreenCanvas takes [EnforceRange] unsigned
-- long long, which throws above 2^53 − 1. Both are refused first.
sizes : ⊤ → List String
sizes ⊤ =
    created = Canvas.create 3 5
    createdSize = Result.map created Canvas.size
    resized = Result.andThen created λcanvas →
        Result.map (Canvas.resize canvas 7 1) λ_ → Canvas.size canvas
    [ show "created" createdSize
    , show "resized" resized
    , show "negative" (Canvas.create (-1) 2)
    , show "too wide" (Canvas.create 2147483648 3)
    , show "widest" (Result.map (Canvas.create 2147483647 0) Canvas.size)
    , show "resize too wide" (Result.andThen created λcanvas → Canvas.resize canvas 3000000000 1)
    , show "offscreen too wide" (Canvas.offscreen 9007199254740992 1 ▷ Result.map λ_ → "offscreen")
    ]
