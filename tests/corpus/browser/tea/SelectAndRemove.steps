# Mark rows 1, 3 and 5.
input li:nth-child(1)>input "one's"
input li:nth-child(3)>input "three's"
input li:nth-child(5)>input "five's"
# Select row 2, then remove it: the selection goes with it.
click #pick2
click #drop2
# Select row 3; then select 1 and remove 4 in one message.
click #pick3
click #pickandgo
# A row inserted and selected by one message: it is made selected, and
# row 1 loses the class.
click #insert
# The selected row removed and row 3 selected in one message.
click #goandpick
