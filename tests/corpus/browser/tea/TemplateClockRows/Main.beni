-- A volatile argument remains volatile through a live row restate.
import Helpers
import Html exposing (Html)
import Tea


type Msg
    = Quiet


view : List Int → Html Msg
view model =
    <main>
        <button id="quiet" onClick={Quiet}>quiet</button>
        {Helpers.rows model}
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → [ 1, 2 ], update = λ_ model → model, view = view }
