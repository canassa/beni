-- load
<body>
  <main>
    <button id="add">"add"</button>
    <button id="all">"all"</button>
    <button id="active">"active"</button>
    <button id="completed">"completed"</button>
    <ul>
      <li class="">
        <input .value="">
        <span>"one"</span>
        <button id="toggle1">"toggle"</button>
        <button id="remove1">"x"</button>
      </li>
      <li class="done">
        <input .value="">
        <span>"two"</span>
        <button id="toggle2">"toggle"</button>
        <button id="remove2">"x"</button>
      </li>
      <li class="">
        <input .value="">
        <span>"three"</span>
        <button id="toggle3">"toggle"</button>
        <button id="remove3">"x"</button>
      </li>
    </ul>
  </main>
</body>
