-- back
<body>
  <main>
    <button id="push">"push"</button>
    <button id="away">"away"</button>
    <button id="replace">"replace"</button>
    <button id="bad">"bad"</button>
    <button id="none">"none"</button>
    <button id="script">"script"</button>
    <ol>
      <li>"changed to /a"</li>
      <li>"push refused: CrossOrigin https://example.com/x"</li>
      <li>"changed to /r"</li>
      <li>"replace refused: BadUrl http://["</li>
      <li>"load refused: BadUrl javascript:alert(1)"</li>
      <li>"changed to /_page.html"</li>
    </ol>
  </main>
</body>
