-- load
<body>
  <main>
    <button id="a">"a"</button>
    <button id="b">"b"</button>
    <ol></ol>
  </main>
</body>
-- click #a
(socket 1: /a)
<body>
  <main>
    <button id="a">"a"</button>
    <button id="b">"b"</button>
    <ol>
      <li>"start /a"</li>
    </ol>
  </main>
</body>
-- socket 1 open
(the DOM did not change)
-- socket 1 message "x"
(socket 1 sent: "echo x")
<body>
  <main>
    <button id="a">"a"</button>
    <button id="b">"b"</button>
    <ol>
      <li>"start /a"</li>
      <li>"read x"</li>
    </ol>
  </main>
</body>
-- socket 1 message "stop"
(socket 1 close: 1000 "")
<body>
  <main>
    <button id="a">"a"</button>
    <button id="b">"b"</button>
    <ol>
      <li>"start /a"</li>
      <li>"read x"</li>
      <li>"done: stopped by the server"</li>
    </ol>
  </main>
</body>
-- socket 1 close 1000 ""
(the DOM did not change)
