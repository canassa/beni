-- load
<body>
  <main>
    <p id="log">""</p>
    <button id="hide">"hide"</button>
    <input id="in" .value="">
  </main>
</body>
-- focus #in
<body>
  <main>
    <p id="log">""</p>
    <button id="hide">"hide"</button>
    <input id="in" .value="" :focus>
  </main>
</body>
-- click #hide
<body>
  <main>
    <p id="log">" hide"</p>
    <button id="hide">"hide"</button>
  </main>
</body>
