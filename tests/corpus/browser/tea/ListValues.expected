    <button id="insert">"insert"</button>
    <button id="remove">"remove"</button>
    <button id="swap">"swap"</button>
    <button id="prepend">"prepend"</button>
    <button id="append">"append"</button>
    <button id="edit">"edit"</button>
    <ul>
      <li>"1"</li>
      <li>"2"</li>
      <li>"3"</li>
    </ul>
  </main>
</body>
