-- load
<body>
  <main>
    <button id="next">"next"</button>
    <section>
      <p id="p" class="a" style="color: red;">"0"</p>
      <details id="d" open="">
        <summary id="s">"more"</summary>
        "text"
      </details>
    </section>
  </main>
</body>
-- click #next
<body>
  <main>
    <button id="next">"next"</button>
    <section>
      <p id="p" class="a b" style="color: blue; margin: 1px;" hidden="">"1"</p>
      <details id="d" open="">
        <summary id="s">"more"</summary>
        "text"
      </details>
    </section>
  </main>
</body>
-- click #s
<body>
  <main>
    <button id="next">"next"</button>
    <section>
      <p id="p" class="a b" style="color: blue; margin: 1px;" hidden="">"1"</p>
      <details id="d">
        <summary id="s">"more"</summary>
        "text"
      </details>
    </section>
  </main>
</body>
-- click #next
