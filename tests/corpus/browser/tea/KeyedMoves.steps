# Mark every row's node.
input li:nth-child(1)>input "1"
input li:nth-child(2)>input "2b"
input li:nth-child(3)>input "2c"
input li:nth-child(4)>input "3"
# The ends change places; the two key-2 rows keep theirs.
click #swap
# The first key-2 item goes: its node goes, and `c` takes the first key-2 row.
click #dropb
# A second key-2 item again: a new row.
click #adde
click #swap
# No key 2 left, then one added back: a new row, not a kept one.
click #droptwos
click #addf
