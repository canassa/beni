-- A subscription's body runs once per live key, and every value it sends
-- goes through the latest tagger of every current declaration of that key
-- (boundary.md §9.8.5). Two declarations share the key `Pulse`: one tags
-- with the model's current label, a new closure on every model; the other
-- is the child's, mapped. The body logs when it is acquired and released:
-- "acquire" is logged once, although the tagger changed after every
-- message, and each pulse reaches `update` twice, with the label of the
-- moment it fired.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Task
import Tea
import Time


type Key
    = Pulse


type Msg
    = Pulsed String Int
    | Child Int
    | Rename


type alias Model =
    label : String
    seen : List String


pulses : (Int -> msg) -> Sub msg
pulses tag = Sub.listen Pulse (beat 1 _) tag


beat : Int, Cmd.Send Int -> ()
beat n send =
    Task.bracket
        (\() -> Debug.log () "acquire")
        (\_ _ -> Debug.log () "release")
        (\_ -> loop n send)


loop : Int, Cmd.Send Int -> ()
loop n send =
    let
        _ = Time.sleep (Time.millis 100)
        _ = send n
    in
    loop (n + 1) send


update : Msg, Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        Pulsed label n ->
            ( { model | seen = model.seen ++ [ "${label} ${String.fromInt n}" ] }, Cmd.none )

        Child n ->
            ( { model | seen = model.seen ++ [ "child ${String.fromInt n}" ] }, Cmd.none )

        Rename ->
            ( { model | label = model.label ++ "'" }, Cmd.none )


subscriptions : Model -> Sub Msg
subscriptions model = Sub.batch [ pulses (Pulsed model.label _), Sub.map (pulses identity) Child ]


view : Model -> Html Msg
view model =
    <main>
        <button id="rename" onClick={Rename}>rename</button>
        <ol><For each={model.seen} keyed={False}>{\s -> <li>{s}</li>}</For></ol>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( { label = "a", seen = [] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
