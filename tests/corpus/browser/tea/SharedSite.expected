-- load
<body>
  <main>
    <button id="rename">"rename"</button>
    <section class="card" id="one" title="first">
      <h2>"first"</h2>
      <p class="count">
        "count "
        <b>"0"</b>
        " of "
        <i>"first"</i>
      </p>
      <p class="twice">"0"</p>
      <button id="one-bump">"bump"</button>
    </section>
    <!---->
    <section class="card" id="two" title="second">
      <h2>"second"</h2>
      <p class="count">
        "count "
        <b>"10"</b>
        " of "
        <i>"second"</i>
      </p>
      <p class="twice">"20"</p>
      <button id="two-bump">"bump"</button>
    </section>
    <!---->
    <section class="card" id="three" title="third">
      <h2>"third"</h2>
      <p class="count">
        "count "
        <b>"20"</b>
        " of "
        <i>"third"</i>
      </p>
      <p class="twice">"40"</p>
      <button id="three-bump">"bump"</button>
    </section>
    <!---->
    <section class="card" id="four" title="first">
      <h2>"first"</h2>
      <p class="count">
        "count "
        <b>"30"</b>
        " of "
        <i>"first"</i>
      </p>
      <p class="twice">"60"</p>
      <button id="four-bump">"bump"</button>
    </section>
    <!---->
  </main>
</body>
