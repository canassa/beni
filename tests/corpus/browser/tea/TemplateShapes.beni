-- Every shape of template in one page, so that the cloner of a template
-- with a flag (`Rt.templateOf`, backend.md §15.3, amended 2026-10-15) is
-- called with each flag and keeps every branch: a custom element, imported
-- rather than cloned (1); an SVG element at a value's top, parsed inside an
-- `<svg>` taken off (2); a fragment, cloned whole (4); and a fragment of
-- SVG elements (2 and 4). The templates with no flag go through
-- `Rt.template`. The values are shown, hidden and shown again, so each
-- cloner parses once and clones twice, and the page shows the same nodes
-- both times. Built for both platforms (`browser-direct` reaches these values
-- through `dom`'s kinds, `Direct.template` and `Direct.templateOf`).
import Html exposing (Html)
import Tea


card : String → Html Bool
card name = <my-card data-name={name}>{name}</my-card>


dot : Html Bool
dot = <circle cx="5" cy="5" r="2" />


pair : Html Bool
pair =
    <>
        <line x2="10" y2="10" />
        <text font-size="3">pair</text>
    </>


both : String → Html Bool
both name = <>Hi {name}<hr /></>


view : Bool → Html Bool
view on =
    <main>
        <button id="flip" onClick={not on}>flip</button>
        {if on then card "ada" else <p>no card</p>}
        <svg viewBox="0 0 20 20">{if on then dot else pair}</svg>
        <svg viewBox="0 0 20 20">{if on then pair else dot}</svg>
        {if on then both "ada" else <p>no fragment</p>}
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → False
        , update = λon _ → on
        , view = view
        }
