-- A program mounted inside another's list row (§4.2, §9.3; S4's amendment,
-- item 6): the outer list's delegated walk never runs the inner program's
-- handlers — a program's mount node counts as another list's row root,
-- whose collected bodies the walk discards — so a click on the inner
-- program's row button reaches the inner program alone, through its own
-- list's listener, and then bubbles natively to the outer row's handler,
-- which the outer walk runs: `inner`, then `outer row`. A click on the
-- outer row itself reaches the outer program alone.
import Browser
import Html exposing (Html)
import Tea


type OuterMsg
    = Row Int


type InnerMsg
    = Pick String


outer : Tea.Program
outer =
    Tea.sandbox
        { init = λ⊤ → ""
        , update = λ(Row i) log → log ++ " outer row ${String.fromInt i}"
        , view =
            λlog →
                <main>
                    <p id="outer-log">{log}</p>
                    <ul>
                        <For each={[ 1, 2 ]} keyed>
                            {λi →
                                <li id="row${String.fromInt i}" onClick={Row i}>
                                    <div id="slot${String.fromInt i}" />
                                </li>
                            }
                        </For>
                    </ul>
                </main>
        }


inner : Tea.Program
inner =
    Tea.sandbox
        { init = λ⊤ → ""
        , update = λ(Pick s) log → log ++ " inner ${s}"
        , view =
            λlog →
                <section>
                    <p id="inner-log">{log}</p>
                    <ol>
                        <For each={[ "a", "b" ]} keyed>
                            {λs → <li><button id="pick-${s}" onClick={Pick s}>{s}</button></li>}
                        </For>
                    </ol>
                </section>
        }


main : Tea.Program
main = Browser.programs [ outer, Browser.mountAt inner "slot1" ]
