-- A second live twin of `EntrySwapArms` (research report 159's second
-- review): `view` keeps the model's `w` in a message, and `Swap` answers it
-- at `w2`. `w2` is `update`'s own only where `w` is, and a location that a
-- consumer keeps is taken out of `own` before the taking away, so the
-- locations that need it go too (`ownership-v3-kernel.md` §6 rule 13):
-- `Bump2`'s write of `w2` is refused. In place, the kept `w3` would change.
import Html exposing (Html)
import Tea


type alias Wm =
    c : Int
    t : String


type alias Model =
    w : Wm
    w2 : Wm
    w3 : Wm


type Msg
    = Swap
    | Keep Wm
    | Bump2


update : Msg, Model → Model
update msg model =
    case msg of
        Swap →
            { model | w = model.w2, w2 = model.w }

        Keep x →
            { model | w3 = x }

        Bump2 →
            w2 = model.w2
            { model | w2 = { w2 | c = w2.c + 1000 } }


show : Wm → String
show x = "${String.fromInt x.c}${x.t}"


view : Model → Html Msg
view model =
    <main>
        <button id="keep" onClick={Keep model.w}>keep</button>
        <button id="swap" onClick={Swap}>swap</button>
        <button id="bump2" onClick={Bump2}>bump2</button>
        <p id="s">{show model.w} {show model.w2} {show model.w3}</p>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { w = { c = 1, t = "a" }, w2 = { c = 2, t = "b" }, w3 = { c = 3, t = "c" } }
        , update = update
        , view = view
        }
