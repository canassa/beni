-- A release that waits during a defect's teardown is bounded by the
-- deadline, 1 000 ms (boundary.md §9.8.14 (f), choice 3). Two bodies run
-- in fibers. The first's release sleeps 200 ms and then logs: it finishes.
-- The second is inside two `bracket`s; its inner release sleeps 5 000 ms,
-- so the deadline cuts it short — its last line never logs — and the
-- outer release, registered before it in the same fiber, runs. Then every
-- fiber has ended: the cleanup cut short is logged as a warning, and the
-- development crash screen shows the same line.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Log
import Sub
import Task
import Tea
import Time


type Msg
    = Start
    | Boom


slowly : String, Int -> ()
slowly name ms =
    _ = Log.info "${name} release starts"
    _ = Time.sleep (Time.millis ms)
    Log.info "${name} release ends"


update : Msg, Int -> ( Int, Cmd Msg )
update msg n =
    case msg of
        Start ->
            ( n
            , Cmd.batch
                [ Cmd.perform λ_ ->
                    Task.bracket (λ() -> ()) (λ_ _ -> slowly "first" 200) λ_ ->
                        Time.sleep (Time.seconds 60)
                , Cmd.perform λ_ ->
                    Task.bracket (λ() -> ()) (λ_ _ -> Log.info "second outer released") λ_ ->
                        Task.bracket (λ() -> ()) (λ_ _ -> slowly "second inner" 5000) λ_ ->
                            Time.sleep (Time.seconds 60)
                ]
            )

        Boom ->
            Debug.todo "update threw"


view : Int -> Html Msg
view _ =
    <main>
        <button id="start" onClick={Start}>start</button>
        <button id="boom" onClick={Boom}>boom</button>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = ( 0, Cmd.none ), update = update, view = view, subscriptions = λ_ -> Sub.none }
