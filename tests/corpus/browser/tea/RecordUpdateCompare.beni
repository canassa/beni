-- A record update whose written field is compared with the old record's
-- after it (`ownership-checker.md` §31.4 item 5, §31.14): `next.count ==
-- model.count` reads `model.count` after `next` wrote it, which the lowering
-- reads first; the comparison is a call with no summary, but the field it is
-- handed is the caller's own read. Building this page made the checker
-- panic (the review of #391). Clicking `same` keeps the count, which
-- value semantics see as equal; `bump` changes it.
import Html exposing (Html)
import Tea


type alias Model =
    items : List Int
    count : Int


type Msg
    = Set Int


update : Msg, Model → Model
update msg model =
    case msg of
        Set n →
            next = { model | count = n }
            if next.count == model.count then next else { model | items = [ n ], count = n }


view : Model → Html Msg
view model =
    <main>
        <button id="same" onClick={Set model.count}>same</button>
        <button id="bump" onClick={Set (model.count + 1)}>bump</button>
        <p>{String.fromInt model.count} {String.fromInt (List.length model.items)}</p>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { items = [], count = 0 }, update = update, view = view }
