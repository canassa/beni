-- load
<body>
  <main>
    <button id="multipass">"multipass"</button>
    <button id="indirect">"indirect"</button>
    <button id="depth">"depth"</button>
    <button id="stencil">"stencil"</button>
    <button id="msaa">"msaa"</button>
    <button id="mrt">"mrt"</button>
    <button id="bundle">"bundle"</button>
    <button id="batch">"batch"</button>
    <button id="occlusion">"occlusion"</button>
    <ol></ol>
  </main>
</body>
-- click #multipass
<body>
