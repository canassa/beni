    <button id="whole">"whole"</button>
    <button id="flipped">"flipped"</button>
    <button id="quadrant">"quadrant"</button>
    <ol></ol>
  </main>
</body>
-- click #whole
<body>
  <main>
    <button id="whole">"whole"</button>
    <button id="flipped">"flipped"</button>
    <button id="quadrant">"quadrant"</button>
    <ol>
      <li>"copy: Ok done"</li>
      <li>"pixels: 0 of 64 pixels match; first miss at 0,0: 0 0 0 0"</li>
    </ol>
  </main>
</body>
