-- click #locks
<body>
  <main>
    <button id="locks">"locks"</button>
    <button id="resources">"resources"</button>
    <button id="slices">"slices"</button>
    <button id="immediates">"immediates"</button>
    <button id="latching">"latching"</button>
    <ol>
      <li>"clear while a pass is open: Err EncoderLocked encoder"</li>
      <li>"then, after the pass is ended too: Err SessionStopped, Err SessionStopped"</li>
      <li>"run: Err InvalidInput EncoderLocked encoder"</li>
      <li>"a pass command after end: Err PassEnded pass"</li>
      <li>"run: Err InvalidInput PassEnded pass"</li>
      <li>"a command after finish: Err EncoderFinished encoder"</li>
      <li>"run: Err InvalidInput EncoderFinished encoder"</li>
      <li>"pop with nothing pushed: Err DebugStackEmpty encoder"</li>
      <li>"run: Err InvalidInput DebugStackEmpty encoder"</li>
      <li>"push, mark and pop: Ok Ok"</li>
      <li>"run: Ok commands"</li>
    </ol>
  </main>
</body>
