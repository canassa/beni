-- Canvas surfaces and their configuration, with no frame that acquires a
-- texture (docs/design/webgpu.md §8; ledger §6), so that they also run in
-- `test-webgpu`'s Chrome, whose WebGPU instance a canvas texture breaks
-- (#2267). The frames that acquire one are `SurfaceFrames`'.
--
-- inside: `getCurrentTexture` of a surface unconfigured inside the frame is
-- `CanvasUnconfigured`. configuration: no configuration before
-- `configure` and a frame then is `CanvasUnconfigured`; the format and
-- usages are read back after, the canvas is an element, and the same
-- canvas gives the same surface. refused: a format a canvas cannot have is
-- `CanvasConfigurationRejected`, a view format of another family
-- `Validation`, a missing element `CanvasNotFound` and one that is not a
-- canvas `WrongElementKind`. injected: the host's `TypeError` for a
-- configuration is `CanvasConfigurationRejected`. noContext: no context is
-- `CanvasContextUnavailable`. leased: a frame of a leased device is
-- `DeviceLeased` at once, and its callback never ran. checkpoint: a frame
-- that acquires no texture runs in `test-webgpu` too, and a microtask queued
-- at the start of its callback has not run when it has submitted — no
-- microtask, so no other fiber, runs inside a frame. conflict: a canvas with a
-- bitmap renderer has no WebGPU context (`CanvasContextUnavailable`), and
-- one with a WebGPU context no bitmap renderer (`ContextUnavailable`).
-- lost: a frame on a destroyed device is `DeviceLost`. refusalsKeep: a
-- configuration refused before the native call, for a feature or a lease,
-- leaves the surface configured as before. concurrent: `unconfigure` while
-- a `configure` is checked leaves the surface unconfigured.
import Browser.Canvas as Canvas
import Gpu.Device
import Gpu.Error as Error exposing (InputError)
import Gpu.Flags as Flags
import Gpu.Frame as Frame
import Gpu.Handle exposing (Device, Frame, Surface)
import Gpu.Surface as Surface
import Gpu.Types as Types
import GpuHost
import GpuKit exposing (must)
import GpuPage
import GpuProbe
import GpuShow
import Task
import Tea


configuration : Device → Types.CanvasConfiguration
configuration d =
    { (Types.canvasConfiguration d Types.Rgba8unorm)
        | usage = Types.Value (Flags.texture [ Flags.RenderAttachment, Flags.TextureCopySrc ])
    }


-- A 4×4 canvas element and its surface, configured on `d`.
configured : Device → Canvas.Canvas × Surface
configured d =
    canvas = must (Canvas.create 4 4)
    surface = must (Surface.fromCanvas canvas)
    must (Surface.configure surface (configuration d))
    ( canvas, surface )


receipts : Result Error.Error { value : a, submissions : List Gpu.Handle.Submission } → String
receipts result = GpuShow.checked result λr →
    String.fromInt (List.length r.submissions) ++ " receipts"


acquireAfter : Surface, Frame → Result Error.Error ⊤
acquireAfter surface frame =
    Surface.unconfigure surface
    _ = Frame.getCurrentTexture frame?
    Ok ⊤


inside : ⊤ → List String
inside ⊤ = GpuKit.with "none" λd →
    ( _, surface ) = configured d
    [ "acquired unconfigured: " ++ receipts (Frame.submit surface "inside" (acquireAfter surface _))
    ]


showConfiguration : Result Error.Error (Maybe Types.CanvasConfiguration) → String
showConfiguration result = GpuShow.checked result showFound


showFound : Maybe Types.CanvasConfiguration → String
showFound c =
    case c of
        Nothing →
            "none"

        Just found →
            usage =
                case found.usage of
                    Types.Value u →
                        String.fromInt (Flags.textureUsagesBits u)

                    Types.Default →
                        "default"
            Types.textureFormatToString found.format ++ ", usage " ++ usage


canvasKind : Surface → String
canvasKind surface =
    case Surface.canvas surface of
        Surface.Element _ →
            "element"

        Surface.Offscreen _ →
            "offscreen"


configurationRead : ⊤ → List String
configurationRead ⊤ = GpuKit.with "none" λd →
    canvas = must (Canvas.create 4 4)
    surface = must (Surface.fromCanvas canvas)
    before = Surface.getConfiguration surface
    frame = Frame.submit surface "before" λ_ → Ok ⊤
    must (Surface.configure surface (configuration d))
    again = must (Surface.fromCanvas canvas)
    [ "before: " ++ showConfiguration before
    , "frame before: " ++ receipts frame
    , "after: " ++ showConfiguration (Surface.getConfiguration surface)
    , "canvas: " ++ canvasKind surface
    , "same surface again: " ++ GpuKit.yesNo (GpuProbe.sameSurface surface again)
    ]


refused : ⊤ → List String
refused ⊤ = GpuKit.with "none" λd →
    canvas = must (Canvas.create 4 4)
    surface = must (Surface.fromCanvas canvas)
    integer = Surface.configure surface (Types.canvasConfiguration d Types.Rgba8uint)

    family =
        Surface.configure surface
            { (configuration d) | viewFormats = Types.Value [ Types.Bgra8unorm ] }
    [ "integer format: " ++ GpuShow.checked integer λ_ → "done"
    , "view format family: " ++ GpuShow.checked family λ_ → "done"
    , "missing: " ++ GpuShow.checked (Surface.fromElement "nope") λ_ → "surface"
    , "not a canvas: " ++ GpuShow.checked (Surface.fromElement "refused") λ_ → "surface"
    ]


injectedConfigure : ⊤ → List String
injectedConfigure ⊤ = GpuKit.with "configure-type-error" λd →
    canvas = must (Canvas.create 4 4)
    surface = must (Surface.fromCanvas canvas)
    [ "configure: " ++ GpuShow.checked (Surface.configure surface (configuration d)) λ_ → "done" ]


noContext : ⊤ → List String
noContext ⊤ = GpuKit.with "context-null" λ_ →
    canvas = must (Canvas.create 4 4)
    [ "context: " ++ GpuShow.checked (Surface.fromCanvas canvas) λ_ → "surface" ]


noted : Frame → Result Error.Error ⊤
noted _ =
    GpuHost.note "the callback ran"
    Ok ⊤


leased : ⊤ → List String
leased ⊤ = GpuKit.with "none" λd →
    ( _, surface ) = configured d
    _ = GpuProbe.lease d
    result = Frame.submit surface "leased" noted
    GpuProbe.releaseLease d
    [ "leased: " ++ receipts result, …GpuHost.notes ⊤ ]


-- A frame that submits an empty command buffer and acquires no texture:
-- the probe's microtask, queued at the start, has not run at the end.
probe : Frame → Result Error.Error Bool
probe frame =
    GpuHost.armMicrotask ⊤
    encoded = Frame.encode frame Types.commandEncoderDescriptor (λ_ → Ok ⊤)?
    _ = Frame.submitCommands frame [ encoded.commands ]?
    Ok (GpuHost.microtaskHasRun ⊤)


checkpoint : ⊤ → List String
checkpoint ⊤ = GpuKit.with "none" λd →
    ( _, surface ) = configured d
    result = Frame.submit surface "probe" probe
    [ "a microtask ran inside the frame: " ++ GpuShow.checked result λr → GpuKit.yesNo r.value
    , "receipts: " ++ receipts result
    ]


rendererName : Result Canvas.Error Canvas.BitmapRenderer → String
rendererName r =
    case r of
        Ok _ →
            "a bitmap renderer"

        Err Canvas.ContextUnavailable →
            "ContextUnavailable"

        Err _ →
            "another canvas error"


conflict : ⊤ → List String
conflict ⊤ = GpuKit.with "none" λ_ →
    first = must (Canvas.create 4 4)
    renderer = Canvas.bitmapRenderer first
    second = must (Canvas.create 4 4)
    surface = Surface.fromCanvas second
    [ "bitmap renderer first: " ++ rendererName renderer
    , "then WebGPU: " ++ GpuShow.checked (Surface.fromCanvas first) λ_ → "surface"
    , "WebGPU first: " ++ GpuShow.checked surface λ_ → "surface"
    , "then a bitmap renderer: " ++ rendererName (Canvas.bitmapRenderer second)
    ]


lost : ⊤ → List String
lost ⊤ = GpuKit.with "none" λd →
    ( _, surface ) = configured d
    Gpu.Device.destroy d
    [ "a frame on a destroyed device: " ++ receipts (Frame.submit surface "lost" λ_ → Ok ⊤) ]


-- A refusal before the native call keeps the surface as it was.
refusalsKeep : ⊤ → List String
refusalsKeep ⊤ = GpuKit.with "none" λd →
    ( _, surface ) = configured d
    gated = { (configuration d) | viewFormats = Types.Value [ Types.Depth32floatStencil8 ] }
    unsupported = Surface.configure surface gated
    _ = GpuProbe.lease d
    leasedConfigure = Surface.configure surface (configuration d)
    GpuProbe.releaseLease d
    [ "a format the device lacks: " ++ GpuShow.checked unsupported λ_ → "done"
    , "a leased device: " ++ GpuShow.checked leasedConfigure λ_ → "done"
    , "a frame after both: " ++ receipts (Frame.submit surface "after" λ_ → Ok ⊤)
    , "the configuration after both: " ++ showConfiguration (Surface.getConfiguration surface)
    ]


-- `unconfigure` while a `configure` is checked: the surface stays
-- unconfigured.
concurrent : ⊤ → List String
concurrent ⊤ = GpuKit.with "none" λd →
    canvas = must (Canvas.create 4 4)
    surface = must (Surface.fromCanvas canvas)
    ( outcome, _ ) = Task.par (λ⊤ → Surface.configure surface (configuration d)) λ⊤ →
        Surface.unconfigure surface
    [ "configure: " ++ GpuShow.checked outcome λ_ → "done"
    , "a frame after: " ++ receipts (Frame.submit surface "after" λ_ → Ok ⊤)
    ]


main : Tea.Program
main =
    GpuPage.program
        [ ( "inside", inside )
        , ( "configuration", configurationRead )
        , ( "refused", refused )
        , ( "injected", injectedConfigure )
        , ( "noContext", noContext )
        , ( "leased", leased )
        , ( "checkpoint", checkpoint )
        , ( "conflict", conflict )
        , ( "lost", lost )
        , ( "refusalsKeep", refusalsKeep )
        , ( "concurrent", concurrent )
        ]
