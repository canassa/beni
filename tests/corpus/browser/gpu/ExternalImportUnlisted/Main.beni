-- A defect, never a typed error (CLAUDE.md rule 9; ledger §6): the
-- native `importExternalTexture` throws an `OperationError`, which the
-- ledger documents for the copy but not for an import (only a
-- `SecurityError` and an `InvalidStateError`). The page stops.
import Gpu.Types as Types
import GpuKit
import GpuMedia
import GpuPage
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "import-unlisted" λd →
    [ "import: " ++ GpuMedia.importOnce d (Types.ExternalVideoFrame (GpuMedia.frame ⊤)) ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
