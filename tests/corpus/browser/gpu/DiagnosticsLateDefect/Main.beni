-- A defect, never a typed error (CLAUDE.md rule 9; docs/design/webgpu.md
-- §6.4, *Outcomes that outlive their caller*): a diagnostic session is
-- cancelled after its callback returned, while its pops are still held,
-- so nobody waits for them. One of the session's own scopes then rejects,
-- which the ledger never documents (§7): the device's sentinel, a fiber of
-- the program that requested the device, throws it, and the page stops
-- after showing that the lease ended at the cancel.
import Gpu.Diagnostics as Diagnostics
import GpuHost
import GpuKit
import GpuPage
import GpuProbe
import Task
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "pops-held,pop-rejected" λd →
    fiber = Task.spawn λ⊤ → Diagnostics.run d λ_ → "returned"
    Task.yieldNow ⊤
    Task.cancel fiber
    leased = GpuProbe.leased d
    GpuHost.releasePops ⊤
    Task.yieldNow ⊤
    [ "cancelled after the callback: leased " ++ GpuKit.yesNo leased ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
