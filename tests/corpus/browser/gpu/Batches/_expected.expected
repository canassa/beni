    </ol>
  </main>
</body>
-- click #reports
<body>
  <main>
    <button id="accepted">"accepted"</button>
    <button id="forms">"forms"</button>
    <button id="rejected">"rejected"</button>
    <button id="reports">"reports"</button>
    <button id="rules">"rules"</button>
    <button id="waiting">"waiting"</button>
    <button id="cross-device">"cross-device"</button>
    <ol>
      <li>"batch: Ok"</li>
      <li>"done: Ok done"</li>
      <li>"read: Ok 7, 9"</li>
      <li>"every batch form: Ok"</li>
      <li>"a batch with a refused buffer: Err BatchFailed refused: Validation; issued [createBuffer, createBuffer], refused []"</li>
      <li>"its buffer, kept: Err InvalidInput ResourceRejected buffer"</li>
      <li>"a refusal beside a validation error: Err BatchFailed both: RelatedFailures [Refusal MappedSizeUnaligned size 6, Validation]; issued [createBuffer], refused [createBuffer]"</li>
      <li>"segments: the failure is in second"</li>
      <li>"no segment: the failure is in batch whole"</li>
      <li>"timestamp queries: Err UnsupportedCapability"</li>
      <li>"run: Err BatchFailed capability: UnsupportedCapability; issued [], refused [createQuerySet]"</li>
    </ol>
  </main>
</body>
