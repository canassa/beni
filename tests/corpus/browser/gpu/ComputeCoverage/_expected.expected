-- click #submits
<body>
  <main>
    <button id="commands">"commands"</button>
    <button id="submits">"submits"</button>
    <button id="writes">"writes"</button>
    <button id="immediates">"immediates"</button>
    <button id="internal">"internal"</button>
    <button id="formats">"formats"</button>
    <ol>
      <li>"buffer to texture: Ok commands"</li>
      <li>"indirect dispatch: Ok commands"</li>
      <li>"timestamp writes to a destroyed query set: Err InvalidInput ResourceDestroyed timestampWrites.querySet"</li>
      <li>"a buffer mapped since: Err InvalidInput MappingState commands mapped"</li>
      <li>"a buffer destroyed since, bound by a group: Err InvalidInput ResourceDestroyed commands"</li>
      <li>"a buffer destroyed since: Err InvalidInput ResourceDestroyed commands"</li>
      <li>"native submits: 0"</li>
    </ol>
  </main>
</body>
