-- A defect, never a typed error (CLAUDE.md rule 9; ledger §3):
-- `getCompilationInfo` rejects, which the ledger does not document. The
-- page stops.
import Gpu.Device
import Gpu.Shader as Shader
import Gpu.Types as Types
import GpuKit exposing (must)
import GpuPage
import GpuShow
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "compilation-rejected" λd →
    shader =
        must
            (Gpu.Device.createShaderModule
                d
                (Types.shaderModuleDescriptor "@compute @workgroup_size(1) fn main() {}")
            )
    [ "messages: " ++ GpuShow.checked (Shader.getCompilationInfo shader) λ_ → "info" ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
