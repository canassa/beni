      <li>"read and write at once: Err InvalidInput InvalidMapMode mode 3"</li>
      <li>"no mode: Err InvalidInput InvalidMapMode mode 0"</li>
      <li>"write without MAP_WRITE: Err InvalidInput MissingBufferUsage buffer 2"</li>
      <li>"offset 4: Err InvalidInput Misaligned offset 4 by 8"</li>
      <li>"size 6: Err InvalidInput Misaligned size 6 by 4"</li>
      <li>"offset 16, size 24: Err InvalidInput OutOfRange size 16+24 of 32"</li>
      <li>"offset -8: Err InvalidInput NumericDomain offset"</li>
      <li>"destroyed: Err InvalidInput ResourceDestroyed buffer"</li>
      <li>"native calls for the refusals: 0"</li>
      <li>"map: Ok mapping"</li>
      <li>"map again while mapped: Err InvalidInput MappingState buffer mapped"</li>
    </ol>
  </main>
</body>
