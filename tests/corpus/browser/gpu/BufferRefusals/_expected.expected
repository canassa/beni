</body>
-- click #creation
<body>
  <main>
    <button id="creation">"creation"</button>
    <button id="maps">"maps"</button>
    <button id="ranges">"ranges"</button>
    <button id="values">"values"</button>
    <button id="writes">"writes"</button>
    <button id="backing">"backing"</button>
    <button id="others">"others"</button>
    <ol>
      <li>"mapped at creation, size 6: Err InvalidInput MappedSizeUnaligned size 6, native calls 0"</li>
      <li>"unmapped, size 6: Ok buffer"</li>
      <li>"map read with storage usage: Err Validation"</li>
    </ol>
  </main>
</body>
