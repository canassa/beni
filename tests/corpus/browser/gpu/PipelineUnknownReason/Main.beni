-- A defect, never a typed error (CLAUDE.md rule 9; ledger §3): the native
-- asynchronous pipeline rejects with a `GPUPipelineError` whose reason is
-- outside the pin. The page stops.
import Gpu.Device
import Gpu.Types as Types
import GpuKit exposing (must)
import GpuPage
import GpuShow
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "pipeline-unknown-reason" λd →
    shader =
        must
            (Gpu.Device.createShaderModule
                d
                (Types.shaderModuleDescriptor "@compute @workgroup_size(1) fn main() {}")
            )
    pipeline =
        Gpu.Device.createComputePipelineAsync
            d
            (Types.computePipelineDescriptor Types.Auto (Types.programmableStage shader))
    [ "pipeline: " ++ GpuShow.checked pipeline λ_ → "pipeline" ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
