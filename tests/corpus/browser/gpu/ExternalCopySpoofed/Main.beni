-- A defect, never a typed error (CLAUDE.md rule 9; ledger §1, §6): the
-- native `copyExternalImageToTexture` throws a plain object named
-- `SecurityError`, which is not a native `DOMException`. The page stops.
import Gpu.Types as Types
import GpuKit
import GpuMedia
import GpuPage
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "copy-spoofed" λd →
    [ "copy: " ++ GpuMedia.copyOnce d (Types.Bitmap (GpuMedia.bitmap ⊤)) ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
