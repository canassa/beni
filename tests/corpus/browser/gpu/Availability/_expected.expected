-- load
<body>
  <main>
    <button id="none">"none"</button>
    <button id="adapter-null">"adapter-null"</button>
    <button id="no-api">"no-api"</button>
    <button id="insecure">"insecure"</button>
    <ol></ol>
  </main>
</body>
-- click #none
<body>
  <main>
    <button id="none">"none"</button>
    <button id="adapter-null">"adapter-null"</button>
    <button id="no-api">"no-api"</button>
    <button id="insecure">"insecure"</button>
    <ol>
      <li>"none: available Available"</li>
      <li>"none: requestAdapter Ok adapter"</li>
      <li>"none: preferredCanvasFormat Ok format"</li>
      <li>"none: wgslLanguageFeatures Ok features"</li>
    </ol>
  </main>
</body>
