-- click #stale
<body>
  <main>
    <button id="pending">"pending"</button>
    <button id="cancelled">"cancelled"</button>
    <button id="stale">"stale"</button>
    <button id="bracket">"bracket"</button>
    <button id="leased">"leased"</button>
