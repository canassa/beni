-- A defect, never `FormatFeatureRejected` (CLAUDE.md rule 9; ledger §3, §7):
-- `createView` throws a `DOMException`, while the call names a feature-gated format: the ledger documents only a `TypeError` there. The page stops.
import GpuFormats
import GpuPage
import Tea


run : ⊤ → List String
run ⊤ = GpuFormats.withFeature "view-throws-dom" λd → [ GpuFormats.view d ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
