-- click #scopes
<body>
  <main>
    <button id="scopes">"scopes"</button>
    <button id="losses">"losses"</button>
    <button id="bundles">"bundles"</button>
    <ol>
      <li>"validation scope popped: ValidationError"</li>
      <li>"session: Ok withheld, observed [ValidationError]"</li>
      <li>"out-of-memory scope popped: OutOfMemoryError"</li>
      <li>"session: Err OutOfMemory"</li>
      <li>"internal scope popped: InternalError"</li>
      <li>"session: Err Internal"</li>
    </ol>
  </main>
</body>
