-- click #callback
<body>
  <main>
    <button id="callback">"callback"</button>
    <button id="unrelated">"unrelated"</button>
    <button id="destroyed">"destroyed"</button>
    <ol>
      <li>"features: timestamp-query no"</li>
      <li>"limits: maxBindGroups some"</li>
      <li>"adapter info: yes"</li>
      <li>"queue label: []"</li>
      <li>"loss: none"</li>
      <li>"buffer: size 8, map state mapped, label renamed, current mapping some"</li>
      <li>"configuration: Ok some"</li>
      <li>"mapped memory: range Ok written, read Ok 7"</li>
      <li>"teardown: unmapped buffer unmapped"</li>
      <li>"receipt: Ok done"</li>
      <li>"queue completion: Ok done"</li>
      <li>"compilation info: Ok read"</li>
      <li>"pending map: Ok mapping"</li>
      <li>"ordinary call: Err InvalidInput SessionState DeviceLeased"</li>
      <li>"session: Ok ⊤, observed []"</li>
      <li>"after: write into the destroyed buffer Err InvalidInput ResourceDestroyed buffer"</li>
      <li>"after: surface configured Ok none"</li>
      <li>"after: ordinary call Ok sampler"</li>
    </ol>
  </main>
</body>
