-- A defect, never a typed error (CLAUDE.md rule 9; ledger §5): the
-- native `writeBuffer` throws a TypeError, where the ledger documents only
-- an OperationError. Every scope the engine pushed is popped first. The
-- page stops.
import Binary
import Gpu.Buffer
import Gpu.Device
import Gpu.Flags exposing (MapRead, CopyDst, CopySrc)
import Gpu.Queue
import Gpu.Submission
import GpuKit exposing (must, buffer, zeros)
import GpuPage
import GpuShow
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "write-unlisted" λd →
    b = must (Gpu.Device.createBuffer d (buffer 16 [ CopyDst ]))
    w =
        Gpu.Queue.writeBuffer
            (Gpu.Device.queue d)
            b
            (Gpu.Queue.bufferWrite 0 (Binary.WholeBuffer (zeros 8)))
    [ "write: " ++ GpuShow.checked w λ_ → "written" ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
