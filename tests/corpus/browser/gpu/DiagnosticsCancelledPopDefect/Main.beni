-- A defect is never swallowed by a cancel (CLAUDE.md rule 9;
-- docs/design/webgpu.md §6.4, *Outcomes that outlive their caller*): a
-- fiber of a session's callback pops the user's internal scope and is
-- cancelled while the pop is held; the pop then rejects, which the ledger
-- never documents (§7), and the session keeps it for its run. The run is
-- then cancelled, so it never throws it: the session hands it to the
-- device's program, and the page stops.
import Gpu.Diagnostics as Diagnostics
import Gpu.Types as Types
import GpuHost
import GpuKit
import GpuPage
import GpuShow
import Task
import Tea


run : ⊤ → List String
run ⊤ = GpuKit.with "pops-held,pop-rejected" λd →
    session = Task.spawn λ⊤ →
        Diagnostics.run d λs →
            _ = Diagnostics.pushErrorScope s Types.FilterInternal
            popper = Task.spawn λ⊤ → GpuShow.popped (Diagnostics.popErrorScope s)
            Task.yieldNow ⊤
            Task.cancel popper
            GpuHost.log "popper cancelled"
            Task.never ⊤
    Task.yieldNow ⊤
    Task.yieldNow ⊤
    GpuHost.releasePop "internal"
    GpuHost.drain ⊤
    Task.cancel session
    GpuHost.drain ⊤
    [ "the page kept running" ]


main : Tea.Program
main = GpuPage.program [ ( "run", run ) ]
