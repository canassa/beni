-- The base's Http family on a prerendered `browser-inline` page
-- (browser-capability-base.md §6, *Prerender plus Http*).
--
--   - load: `init`'s command asks for `/api/greeting`; the build sends no
--     request, and the page sends it once it has taken over. The answer is
--     shown.
--   - "missing": a 404 is `Err (BadStatus 404)`, a value.
--   - "offline": a network failure is `Err NetworkError`, a value.
--   - "save": `Http.send`, the command form, posts a body and shows the
--     answer.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Http
import Sub
import Tea


type Msg
    = Missing
    | Offline
    | Save
    | Got String


-- Each answer is shown by the command that waited for it, so the message
-- carries one string (inline builds a message from leaf fields).
show : String, Result Http.Error String → String
show label result =
    answer =
        case result of
            Ok text →
                "ok ${text}"

            Err (Http.BadStatus status) →
                "bad status ${String.fromInt status}"

            Err Http.NetworkError →
                "network error"

            Err _ →
                "another error"
    "${label}: ${answer}"


fetch : String, String → Cmd Msg
fetch label url =
    Cmd.task (λ⊤ → show label (Http.get { url = url, expect = Http.expectString })) Got


update : Msg, String → String × Cmd Msg
update msg log =
    case msg of
        Missing →
            ( log, fetch "missing" "/api/missing" )

        Offline →
            ( log, fetch "offline" "/api/offline" )

        Save →
            ( log
            , Http.send
                { method = "POST"
                , headers = []
                , url = "/api/notes"
                , body = Http.stringBody "text/plain" "note"
                , expect = Http.expectString
                , timeout = Nothing
                , tracker = Nothing
                }
                λr → Got (show "save" r)
            )

        Got line →
            ( if log == "" then line else log ++ " / " ++ line, Cmd.none )


view : String → Html Msg
view log =
    <main>
        <button id="missing" onClick={Missing}>missing</button>
        <button id="offline" onClick={Offline}>offline</button>
        <button id="save" onClick={Save}>save</button>
        <output id="log">{log}</output>
    </main>


main : Tea.Program
main =
    Browser.prerender
        (Tea.element
            { init =
                λ⊤ →
                    ( ""
                    , Cmd.perform λsend →
                        send
                            (Got
                                (show
                                    "greeting"
                                    (Http.get { url = "/api/greeting", expect = Http.expectString })
                                )
                            )
                    )
            , update = update
            , view = view
            , subscriptions = λ_ → Sub.none
            }
        )
        [ "/" ]
