-- click [data-role=help]
<body>
  "\n    "
  <div id="root">
    <div data-role="app">
      <button data-role="help">"Help"</button>
      <p data-role="note">"Two panels."</p>
      <section>
        <button data-role="open">"First"</button>
        ""
      </section>
      <section>
        <button data-role="open">"Second"</button>
        ""
      </section>
    </div>
  </div>
  "\n  "
</body>
