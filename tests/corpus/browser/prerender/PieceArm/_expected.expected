-- load
<body>
  "\n    "
  <div id="root">
    <div data-role="app">
      <button data-role="help">"Help"</button>
      ""
      <section>
        <button data-role="open">"First"</button>
        ""
      </section>
      <section>
        <button data-role="open">"Second"</button>
        <div>
          <span>"Second is open"</span>
          <button data-role="close">"Close"</button>
        </div>
      </section>
    </div>
  </div>
  "\n  "
</body>
-- click section:nth-of-type(1)>[data-role=open]
