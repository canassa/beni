-- `EarlyInput` with every handler a lambda, not a constructor
-- (docs/design/browser-inline.md §8.3, amended 2026-11-05; prerender.md
-- §6.5): each event's message goes through the program's dispatcher, and
-- the takeover still hands each recorded input to its listener after the
-- first pass, in order. The page, the transcript and the log are
-- `EarlyInput`'s, byte for byte.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    count : Int
    name : String
    agree : Bool
    plan : String
    log : String


type Msg
    = Inc
    | SetName String
    | SetAgree Bool
    | SetPlan String


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1, log = model.log ++ " inc" }

        SetName typed →
            { model | name = typed, log = model.log ++ " name:" ++ typed }

        SetAgree on →
            { model | agree = on, log = model.log ++ " check" }

        SetPlan chosen →
            { model | plan = chosen, log = model.log ++ " plan:" ++ chosen }


view : Model → Html Msg
view model =
    <section data-role="app">
        <button data-role="inc" onClick={λ_ → Inc}><b>+</b></button>
        <input data-role="name" value={model.name} onInput={λtyped → SetName typed} />
        <input
            type="checkbox"
            data-role="agree"
            checked={model.agree}
            onCheck={λon → SetAgree on}
        />
        <select data-role="plan" value={model.plan} onChange={λchosen → SetPlan chosen}>
            <option value="free">Free</option>
            <option value="team">Team</option>
        </select>
        <output data-role="count">{String.fromInt model.count}</output>
        <output data-role="log">{model.log}</output>
    </section>


main : Tea.Program
main =
    Browser.prerender
        (Browser.mountAt
            (Tea.sandbox
                { init = λ⊤ → { count = 0, name = "Ada", agree = False, plan = "free", log = "" }
                , update = update
                , view = view
                }
            )
            "root"
        )
        [ "/" ]
