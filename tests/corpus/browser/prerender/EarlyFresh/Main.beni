-- Input made before the program runs on a page a host changed
-- (docs/design/prerender.md §6.4, §6.5, amended 2026-10-29): the mount
-- does not take the page over and mounts fresh, so the click and the text
-- the capture script recorded were made on elements the program never
-- took over, and are dropped. The program starts as on a page with no
-- view, and a later click is its first.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    count : Int
    name : String


type Msg
    = Inc
    | SetName String


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }

        SetName typed →
            { model | name = typed }


view : Model → Html Msg
view model =
    <section data-role="app">
        <button data-role="inc" onClick={Inc}>+</button>
        <input data-role="name" value={model.name} onInput={SetName} />
        <output data-role="count">{String.fromInt model.count} {model.name}</output>
    </section>


main : Tea.Program
main =
    Browser.prerender
        (Browser.mountAt
            (Tea.sandbox { init = λ⊤ → { count = 0, name = "Ada" }, update = update, view = view })
            "root"
        )
        [ "/" ]
