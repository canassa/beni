-- A project that names a data program in `"build"."data"` and a `main`
-- that says `Browser.prerender`, not `Browser.prerenderData`
-- (docs/design/prerender.md §8.5 item 1): the data program is neither
-- built nor run, nor its paths read — `nowhere` does not exist — and the
-- build warns, `prerender_data_ignored`, and writes the pages as ever.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    count : Int
    label : String


type Msg
    = Inc
    | Dec


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1, label = "Clicked" }

        Dec →
            { model | count = model.count - 1 }


view : Model → Html Msg
view model =
    <div data-role="app">
        <p>{model.label}: {model.count} times</p>
        <output>{model.count}</output>
        <button data-role="dec" disabled={model.count ≤ 0} onClick={Dec}>-</button>
        <button data-role="inc" onClick={Inc}>+</button>
    </div>


main : Tea.Program
main =
    Browser.prerender
        (Browser.mountAt
            (Tea.sandbox
                { init = λ⊤ → { count = 0, label = "Never" }, update = update, view = view }
            )
            "root"
        )
        [ "/" ]
