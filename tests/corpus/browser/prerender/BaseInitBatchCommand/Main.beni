-- Approved contract fixture: the clock is read only after hydration.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea
import Time


type Msg
    = Loaded Int


update : Msg, Int → Int × Cmd Msg
update msg _ =
    case msg of
        Loaded stamp →
            ( stamp, Cmd.none )


view : Int → Html Msg
view stamp = <main><output id="stamp">{stamp}</output></main>


main : Tea.Program
main =
    Browser.prerender
        (Tea.element
            { init =
                λ⊤ →
                    ( 0
                    , Cmd.batch
                        [ Cmd.none
                        , Cmd.perform λsend →
                            Debug.log "first client command" ⊤
                            send (Loaded 1)
                        , Cmd.batch [ Cmd.perform λsend → send (Loaded 2) ]
                        ]
                    )
            , update = update
            , view = view
            , subscriptions = λ_ → Sub.none
            }
        )
        [ "/" ]
