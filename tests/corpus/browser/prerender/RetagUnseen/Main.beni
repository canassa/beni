-- An element no code refers to replaced, before the program loads, by one
-- of another tag (docs/design/prerender.md §6.4): the `<h1>` is an `<h2>`
-- on the page. Every build checks every tag (§6.4, amended 2026-10-29,
-- #1186: the table is by index, so an element no code refers to can move
-- those code does, as `Shifted` shows), so release mounts fresh too; a
-- development build warns first.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    count : Int


type Msg
    = Inc


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }


view : Model → Html Msg
view model =
    <div data-role="app">
        <h1>Counter</h1>
        <output>{model.count}</output>
        <button data-role="inc" onClick={Inc}>+</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt (Tea.sandbox { init = λ⊤ → { count = 0 }, update = update, view = view }) "root"
