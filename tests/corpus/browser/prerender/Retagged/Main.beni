-- An element some code refers to replaced, before the program loads, by
-- one of another tag (docs/design/prerender.md §6.4): the button the
-- listener is wired to is a `<span>` on the page, and the element count
-- is unchanged. Every build checks the tag of each element its code refers
-- to, so a release build mounts fresh too, and no listener is attached to
-- an element it was not compiled for; a development build warns first.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    count : Int


type Msg
    = Inc


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }


view : Model → Html Msg
view model =
    <div data-role="app">
        <h1>Counter</h1>
        <output>{model.count}</output>
        <button data-role="inc" onClick={Inc}>+</button>
    </div>


main : Tea.Program
main =
    Browser.prerender
        (Browser.mountAt
            (Tea.sandbox { init = λ⊤ → { count = 0 }, update = update, view = view })
            "root"
        )
        [ "/" ]
