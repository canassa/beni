-- load
<body>
  <div id="root">
    <div data-role="app">
      <button data-role="toggle">"Help"</button>
      ""
      <section data-role="counter">
        <output>"3"</output>
        <button data-role="inc">"+1"</button>
        <button data-role="dec">"-1"</button>
        ""
      </section>
    </div>
  </div>
</body>
-- click [data-role=inc]
<body>
  <div id="root">
    <div data-role="app">
      <button data-role="toggle">"Help"</button>
      ""
      <section data-role="counter">
        <output>"4"</output>
        <button data-role="inc">"+1"</button>
        <button data-role="dec">"-1"</button>
        ""
      </section>
    </div>
  </div>
</body>
-- click [data-role=inc]
<body>
  <div id="root">
    <div data-role="app">
      <button data-role="toggle">"Help"</button>
      ""
      <section data-role="counter">
        <output>"5"</output>
        <button data-role="inc" disabled="">"+1"</button>
        <button data-role="dec">"-1"</button>
        <strong>"many"</strong>
      </section>
    </div>
  </div>
</body>
-- click [data-role=toggle]
<body>
  <div id="root">
    <div data-role="app">
      <button data-role="toggle">"Help"</button>
      <p data-role="help">"Count to five."</p>
      <section data-role="counter">
        <output>"5"</output>
        <button data-role="inc" disabled="">"+1"</button>
        <button data-role="dec">"-1"</button>
        <strong>"many"</strong>
      </section>
    </div>
  </div>
</body>
-- click [data-role=dec]
<body>
  <div id="root">
    <div data-role="app">
      <button data-role="toggle">"Help"</button>
      <p data-role="help">"Count to five."</p>
      <section data-role="counter">
        <output>"4"</output>
        <button data-role="inc">"+1"</button>
        <button data-role="dec">"-1"</button>
        ""
      </section>
    </div>
  </div>
</body>
