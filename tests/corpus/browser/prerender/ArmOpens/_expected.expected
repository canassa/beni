-- load
<body>
  "\n    "
  <div id="root">
    <main data-role="app">
      <button data-role="toggle">"Toggle"</button>
      ""
      <div data-role="shown">
        <span data-role="closed">"closed at 0"</span>
        ""
        <button data-role="bump">"Bump"</button>
      </div>
    </main>
  </div>
  "\n  "
</body>
-- click [data-role=bump]
<body>
  "\n    "
  <div id="root">
    <main data-role="app">
      <button data-role="toggle">"Toggle"</button>
      ""
      <div data-role="shown">
        <span data-role="closed">"closed at 1"</span>
        <b>"1"</b>
        <button data-role="bump">"Bump"</button>
      </div>
    </main>
  </div>
  "\n  "
</body>
-- click [data-role=toggle]
<body>
  "\n    "
  <div id="root">
    <main data-role="app">
      <button data-role="toggle">"Toggle"</button>
      <section data-role="panel">
        <p>"1"</p>
        <button data-role="inner">"+1"</button>
        ""
      </section>
      <div data-role="shown">
        ""
        <b>"1"</b>
        <button data-role="bump">"Bump"</button>
      </div>
    </main>
  </div>
  "\n  "
</body>
-- click [data-role=inner]
<body>
  "\n    "
  <div id="root">
    <main data-role="app">
      <button data-role="toggle">"Toggle"</button>
      <section data-role="panel">
        <p>"2"</p>
        <button data-role="inner">"+1"</button>
        <em>"big"</em>
      </section>
      <div data-role="shown">
        ""
        <b>"2"</b>
        <button data-role="bump">"Bump"</button>
      </div>
    </main>
  </div>
  "\n  "
</body>
