-- load
<body>
  <main>
    <button id="launch">"launch"</button>
    <output>"idle"</output>
    <p id="stage">"waiting"</p>
  </main>
</body>
-- click-wait #launch #stage "load failed"
<body>
  <main>
    <button id="launch">"launch"</button>
    <output>"idle"</output>
    <p id="stage">"load failed"</p>
  </main>
</body>
-- advance 20
<body>
  <main>
    <button id="launch">"launch"</button>
    <output>"load failed"</output>
    <p id="stage">"load failed"</p>
  </main>
</body>
-- click-wait #stage output "load failed"
