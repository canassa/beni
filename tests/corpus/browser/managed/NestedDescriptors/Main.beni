-- Hoisting must resolve the child descriptor from the final worker artifact.
import Browser
import Browser.Worker as Worker
import Deep.Child as Child
import Hosted
import Html exposing (Html)
import Task


worker : Worker.Program String String (Worker.Protocol String String ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ config → Ok config
        , start = λ_ _ → ⊤
        , handle = λ_ state request → Ok (Child.run (state ++ request))
        }


type Msg
    = Launch
    | Finished String


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start
                            (λ⊤ →
                                Task.scope λscope →
                                    result = Worker.open scope worker "config" Worker.options
                                    case result of
                                        Ok handle →
                                            reply = Worker.call handle "request"
                                            _ = Worker.close handle
                                            Hosted.emit
                                                outlet
                                                (Finished
                                                    (case reply of
                                                        Ok text →
                                                            text
                                                        Err _ →
                                                            "failed"
                                                    )
                                                )
                                        Err _ →
                                            Hosted.emit outlet (Finished "failed")
                            )
                            λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel → <main><button onClick={Launch}>launch</button><output>{model}</output></main>
        }
