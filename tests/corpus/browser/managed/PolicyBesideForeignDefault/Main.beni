-- An owned policy in the options beside a default policy beni does not
-- own (workers.md §6, amended 2026-11-07; #2208). The page's default
-- policy refuses every URL (it returns null). `open` given the owned
-- policy mints the entry's URL with it and hands the constructor that
-- branded URL, so the default is never called (`callbacks=0`) and the
-- worker answers. Before, the foreign-default check ran first and `open`
-- returned `ScriptPolicy (PolicyRefused …)` even with the owned policy;
-- with no policy the refusal stays (`PolicyForeignNull`).
import Browser
import Browser.Worker as Worker
import Hosted
import Html exposing (Html)
import Probe
import Task


worker : Worker.Program String String (Worker.Protocol String String ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ config → Ok config
        , start = λ_ _ → ⊤
        , handle = λ_ state request → Ok (state ++ request)
        }


exercise : ⊤ → String
exercise ⊤ = Task.scope λowner →
    Probe.arm "null"
    case ( Worker.policyName "beni-workers", Worker.policyName "bad name" ) of
        ( Ok name, Err Worker.InvalidPolicyName ) →
            case Worker.policy name of
                Err _ →
                    "policy failed"
                Ok chosen →
                    duplicate = True
                    defaults = Worker.options
                    case Worker.open owner worker "config" { defaults | policy = Just chosen } of
                        Err _ →
                            "open failed"
                        Ok handle →
                            answer = Worker.call handle "ping"
                            answerGood =
                                case answer of
                                    Ok text →
                                        text == "configping"
                                    Err _ →
                                        False
                            cleanup = Worker.close handle
                            if
                                duplicate
                                    && answerGood
                                    && cleanup == Worker.Confirmed
                                    && Probe.observation ⊤
                                        == "constructs=1;callbacks=0;trusted=true"
                            then
                                "owned policy beside a foreign default passed"
                            else
                                "policy assertions failed;" ++ Probe.observation ⊤
        _ →
            "validation failed"


type Msg
    = Launch
    | Finished String


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start (λ⊤ → Hosted.emit outlet (Finished (exercise ⊤))) λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel → <main><button onClick={Launch}>launch</button><output>{model}</output></main>
        }
