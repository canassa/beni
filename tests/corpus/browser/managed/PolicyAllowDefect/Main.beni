-- A user allow callback runs outside every native guard, even for TypeError.
import Browser
import Browser.Worker as Worker
import Probe


type Msg
    = Launch


exercise : ⊤ → String
exercise ⊤ =
    case ( Worker.policyName "beni-allow", Worker.scriptUrl "/worker.js" ) of
        ( Ok name, Ok url ) →
            case Worker.policy name of
                Ok chosen →
                    _ = Worker.trust chosen url Probe.throwing
                    "swallowed defect"
                _ →
                    "policy failed"
        _ →
            "validation failed"


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update = λ_ _ _ → exercise ⊤
        , settle = λ_ model → model
        , view =
            λmodel → <main><button onClick={Launch}>launch</button><output>{model}</output></main>
        }
