-- Held message and messageerror events retain their native metadata and ports.
import Browser
import Browser.Worker as Worker
import Hosted
import Probe
import Task


seed : String
seed = Probe.inject "worker"


worker : Worker.Program ⊤ String (Worker.Protocol ⊤ String ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ _ → Ok seed
        , start = λ_ _ → ⊤
        , handle = λ_ _ _ → Ok (Probe.observed ⊤)
        }


type Msg
    = Launch
    | Finished String


exercise : ⊤ → String
exercise _ = Task.scope λowned →
    case Worker.open owned worker ⊤ Worker.options of
        Err _ →
            "open failed"
        Ok handle →
            reply = Worker.call handle ⊤
            _ = Worker.close handle
            case reply of
                Ok text →
                    text
                Err _ →
                    "call failed"


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start (λ⊤ → Hosted.emit outlet (Finished (exercise ⊤))) λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel → <main><button onClick={Launch}>launch</button><output>{model}</output></main>
        }
