import Browser
import Browser.Worker as Worker
import Browser.WorkerStream as Events
import Duration
import Hosted
import Probe
import Task


worker : Worker.Program ⊤ ⊤ (Worker.Protocol ⊤ ⊤ ⊥ String String ⊥)
worker =
    Worker.program
        { init = λ_ _ → Ok ⊤
        , start = λ_ _ → ⊤
        , handle =
            λcontext _ _ →
                _ = Worker.emit context "busy"
                Probe.spin ⊤
                Ok ⊤
        , stream = Worker.noStream
        }


type Msg
    = Launch
    | Finished String


exercise : Hosted.Outlet Msg → String
exercise outlet = Task.scope λowned →
    case Worker.open owned worker ⊤ { Worker.options | cleanupWithin = Duration.millis 10 } of
        Err _ →
            "open failed"
        Ok handle →
            case Worker.prepare ⊤ of
                Err _ →
                    "prepare failed"
                Ok prepared →
                    case Worker.send handle prepared of
                        Err _ →
                            "send failed"
                        Ok ticket →
                            pushed = Worker.events handle
                            _ = Events.next pushed
                            Hosted.emit outlet (Finished "closing")
                            cleanup = Worker.close handle
                            result = Worker.await ticket
                            event = Events.next pushed
                            _ = Worker.abort handle
                            case ( cleanup, result, event ) of
                                ( Worker.Unconfirmed Worker.LeaseExpired, Err (Worker.Transport Worker.PeerUnresponsive), Err (Events.Failed Worker.PeerUnresponsive) ) →
                                    "unresponsive"
                                _ →
                                    "wrong loss"


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start (λ⊤ → Hosted.emit outlet (Finished (exercise outlet))) λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel →
                <main>
                    <button id="launch" onClick={Launch}>launch</button><output>{model}</output><p id="stage">waiting</p>
                </main>
        }
