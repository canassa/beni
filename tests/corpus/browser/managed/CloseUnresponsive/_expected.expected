-- load
<body>
  <main>
    <button id="launch">"launch"</button>
    <output>"idle"</output>
    <p id="stage">"waiting"</p>
  </main>
</body>
-- click-wait #launch output "closing"
<body>
  <main>
    <button id="launch">"launch"</button>
    <output>"closing"</output>
    <p id="stage">"waiting"</p>
  </main>
</body>
-- advance 20
<body>
  <main>
    <button id="launch">"launch"</button>
    <output>"unresponsive"</output>
    <p id="stage">"waiting"</p>
  </main>
</body>
-- click-wait #stage output "unresponsive"
