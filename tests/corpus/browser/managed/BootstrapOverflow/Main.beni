import Browser
import Browser.Worker as Worker
import Hosted
import Html exposing (Html)
import Probe
import Task


seed : String
seed = Probe.fail "overflow probe"


worker : Worker.Program String String (Worker.Protocol String String ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ _ → Ok seed
        , start = λ_ _ → ⊤
        , handle = λ_ state request → Ok (state ++ request)
        , stream = Worker.noStream
        }


type Msg
    = Launch
    | Finished String


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start
                            (λ⊤ →
                                Probe.install ⊤
                                Task.scope λscope →
                                    result = Worker.open scope worker "config" Worker.options
                                    case result of
                                        Ok handle →
                                            _ = Worker.close handle
                                            Hosted.emit outlet (Finished "ready")
                                        Err _ →
                                            Hosted.emit outlet (Finished "failed")
                            )
                            λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel →
                <main>
                    <button onClick={Launch}>launch</button><output>{model}</output><p id="stage">waiting</p>
                </main>
        }
