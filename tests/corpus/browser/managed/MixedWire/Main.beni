-- A shared page runtime normalizes Lists, while a recursive stable worker does not.
import Browser
import Browser.Worker as Worker
import Browser.WorkerStream as Events
import Hosted
import Html exposing (Html)
import List
import Task


type Tree
    = Leaf { label : String, score : Int }
    | Branch Tree Tree


type Request
    = Echo { tree : Tree, stamp : String }


type Reply
    = Got { tree : Tree, stamp : String, total : Int }


type alias Stable =
    Worker.Protocol Request Reply ⊥ String Tree ⊥


type alias Packet =
    items : List Int
    note : String


type alias Lists =
    Worker.Protocol Packet Packet ⊥ String Packet ⊥


sum : Tree → Int
sum tree =
    case tree of
        Leaf value →
            value.score
        Branch left right →
            sum left + sum right


stable : Worker.Program Tree Tree Stable
stable =
    Worker.program
        { init =
            λcontext config →
                _ = Worker.emit context config
                Ok config
        , start = λ_ _ → ⊤
        , handle =
            λcontext state (Echo request) →
                _ = Worker.emit context request.tree
                Ok
                    (Got
                        { tree = Branch state request.tree
                        , stamp = request.stamp
                        , total = sum state + sum request.tree
                        }
                    )
        }


lists : Worker.Program ⊤ ⊤ Lists
lists =
    Worker.program
        { init = λ_ _ → Ok ⊤
        , start = λ_ _ → ⊤
        , handle =
            λcontext _ request →
                reply = { request | items = List.drop request.items 1 }
                _ = Worker.emit context reply
                Ok reply
        }


type Msg
    = Launch
    | Finished String


next : Events.Stream Worker.TransportError event → Maybe event
next stream =
    case Events.next stream of
        Ok (Events.Item chunk) →
            Just (Events.take chunk)
        _ →
            Nothing


exercise : ⊤ → String
exercise _ = Task.scope λowner →
    config = Branch (Leaf { label = "left", score = 2 }) (Leaf { label = "right", score = 3 })
    request = Leaf { label = "request", score = 7 }
    case Worker.open owner stable config Worker.options of
        Err _ →
            "stable open failed"
        Ok stableHandle →
            case Worker.open owner lists ⊤ Worker.options of
                Err _ →
                    _ = Worker.close stableHandle
                    "list open failed"
                Ok listHandle →
                    initial = next (Worker.events stableHandle)
                    stableReply = Worker.call stableHandle (Echo { tree = request, stamp = "echo" })
                    stableEvent = next (Worker.events stableHandle)
                    listReply =
                        Worker.call listHandle { items = List.drop [ 0, 7, 8, 9 ] 1, note = "view" }
                    listEvent = next (Worker.events listHandle)
                    stableGood =
                        case stableReply of
                            Ok (Got value) →
                                value.tree == Branch config request
                                    && value.stamp == "echo"
                                    && value.total == 12
                            _ →
                                False
                    listGood =
                        case listReply of
                            Ok value →
                                value.items == [ 8, 9 ] && value.note == "view"
                            _ →
                                False
                    stableClosed = Worker.close stableHandle
                    listClosed = Worker.close listHandle
                    if
                        initial == Just config
                            && stableGood
                            && stableEvent == Just request
                            && listGood
                            && listEvent == Just { items = [ 8, 9 ], note = "view" }
                            && stableClosed == Worker.Confirmed
                            && listClosed == Worker.Confirmed
                    then
                        "mixed wire passed"
                    else
                        "mixed wire failed"


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start (λ⊤ → Hosted.emit outlet (Finished (exercise ⊤))) λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel → <main><button onClick={Launch}>launch</button><output>{model}</output></main>
        }
