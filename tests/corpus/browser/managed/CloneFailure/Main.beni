-- The native postMessage wrapper must classify only its DataCloneError.
import Browser
import Browser.Worker as Worker
import Hosted
import Probe
import Task


worker : Worker.Program ⊤ ⊤ (Worker.Protocol String ⊤ ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ _ → Ok ⊤, start = λ_ _ → ⊤, handle = λ_ _ _ → Ok ⊤ }


type Msg
    = Launch
    | Finished String


exercise : ⊤ → String
exercise _ = Task.scope λowned →
    case Worker.open owned worker ⊤ Worker.options of
        Err _ →
            "open failed"
        Ok handle →
            Probe.install ⊤
            outcome = Worker.call handle "typed payload"
            _ = Worker.close handle
            case outcome of
                Err (Worker.Transport (Worker.SendFailed (Worker.WorkerCloneRejected Worker.NativeCloneRejected))) →
                    "clone rejected"
                _ →
                    "clone failed"


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start (λ⊤ → Hosted.emit outlet (Finished (exercise ⊤))) λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel → <main><button onClick={Launch}>launch</button><output>{model}</output></main>
        }
