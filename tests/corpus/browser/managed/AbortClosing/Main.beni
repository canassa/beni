import Browser
import Browser.Worker as Worker
import Hosted
import Probe
import Task


worker : Worker.Program ⊤ ⊤ (Worker.Protocol ⊤ ⊤ ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ _ → Ok ⊤, start = λ_ _ → ⊤, handle = λ_ _ _ → Ok ⊤, stream = Worker.noStream }


type Msg
    = Launch
    | Finished String


exercise : Hosted.Outlet Msg → String
exercise outlet = Task.scope λowned →
    case Worker.open owned worker ⊤ Worker.options of
        Err _ →
            "open failed"
        Ok handle →
            Probe.hold handle
            closing = Task.spawn λ⊤ → Worker.close handle
            Task.callback λresume →
                Probe.onClose handle λ⊤ → Task.resume resume ⊤
                λ⊤ → ⊤
            aborted = Worker.abort handle
            observed = Task.join closing
            other = Task.openRoot ⊤
            second = Worker.open other worker ⊤ Worker.options
            ownerClosed =
                case second of
                    Err _ →
                        False
                    Ok secondHandle →
                        Probe.hold secondHandle
                        finishing = Task.spawn λ⊤ → Task.closeRoot other
                        Task.callback λresume →
                            Probe.onClose secondHandle λ⊤ → Task.resume resume ⊤
                            λ⊤ → ⊤
                        _ = Worker.abort secondHandle
                        Task.join finishing
                        True
            if aborted == Worker.Abandoned && observed == Worker.Abandoned && ownerClosed then
                "abandoned"
            else
                "wrong cleanup"


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → "idle"
        , update =
            λowner msg model →
                case msg of
                    Launch →
                        outlet = Hosted.outlet owner
                        Task.start (λ⊤ → Hosted.emit outlet (Finished (exercise outlet))) λ_ → ⊤
                        model
                    Finished text →
                        text
        , settle = λ_ model → model
        , view =
            λmodel →
                <main>
                    <button id="launch" onClick={Launch}>launch</button><output>{model}</output><p id="stage">waiting</p>
                </main>
        }
