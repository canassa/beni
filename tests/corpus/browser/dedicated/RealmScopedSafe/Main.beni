-- A kept sibling that binds `document`, `location` and `self` in its own
-- scopes, reads only those bindings, and hands `setTimeout` a function builds
-- and runs in a worker: the realm check reads sibling scopes (#2211,
-- `workers.md` §4).
import Page
import RealmJs
import Worker


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle = λ_ _ _ → RealmJs.siblingScopedSafe ⊤
        }


start : ⊤ → ⊤
start _ =
    Page.text "waiting"
    Page.button launch


launch : ⊤ → ⊤
launch _ =
    case Worker.open worker of
        Ok handle →
            Worker.receive handle Page.text
            Worker.send handle "go"
        Err _ →
            Page.text "open failed"


main : Page.Program
main = Page.program start
