-- Stored and returned callbacks must keep their execution realm.
import Cells as Ref
import Page
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


workerCb _ = ⊤


pageCell : Ref.Slot (⊤ → ⊤)
pageCell = Ref.make λ⊤ → ⊤


cell : Ref.Slot (⊤ → ⊤)
cell = Ref.make λ⊤ → ⊤


store : Ref.Slot a, a → ⊤
store r x = Ref.set r x


setIt _ = store cell workerCb


callIt _ = (Ref.get cell) ⊤


go _ =
    setIt ⊤
    callIt ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    store pageCell pageCb
    (Ref.get pageCell) ⊤
    Page.text "ready"
    Page.button λ_ →
        case Worker.open worker of
            Ok handle →
                Worker.receive handle Page.text
                Worker.send handle "ping"
            Err _ →
                Page.text "open failed"
