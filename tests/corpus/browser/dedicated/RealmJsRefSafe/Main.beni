-- Stored and returned callbacks must keep their execution realm.
import Page
import RealmProbe as Js
import Worker


pageCb : ⊤ → ⊤
pageCb _ = ⊤


cell : Js.Ref (⊤ → ⊤)
cell = Js.jsRef λ⊤ → ⊤


go _ =
    Js.jsWrite cell pageCb
    (Js.jsRead cell) ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    Page.text "ready"
    Page.button λ_ →
        case Worker.open worker of
            Ok handle →
                Worker.receive handle Page.text
                Worker.send handle "ping"
            Err _ →
                Page.text "open failed"
