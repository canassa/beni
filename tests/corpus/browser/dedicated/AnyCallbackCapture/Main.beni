-- Packing and unpacking preserve a callback without invoking it.
import Envelope
import Page
import Worker


pageCallback : ⊤ → ⊤
pageCallback ⊤ = Page.text "window callback"


stored = Envelope.store { callback = pageCallback }


go : ⊤ → ⊤
go ⊤ =
    found : Maybe { callback : ⊤ → ⊤ }
    found = Envelope.restore stored
    case found of
        Just _ →
            ⊤
        Nothing →
            ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    Page.text "ready"
    Page.button λ_ →
        case Worker.open worker of
            Ok handle →
                Worker.receive handle Page.text
                Worker.send handle "ping"
            Err _ →
                Page.text "open failed"
