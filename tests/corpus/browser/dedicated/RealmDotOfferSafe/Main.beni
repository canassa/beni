-- Stored and returned callbacks must keep their execution realm.
import Page
import Queue
import Worker


pageCb : ⊤ → ⊤
pageCb _ = ⊤


q : Queue.Queue (⊤ → ⊤)
q = Queue.bounded 1


setIt _ = if q.offer pageCb then ⊤


callIt _ =
    case Queue.poll q of
        Just callback →
            callback ⊤
        Nothing →
            ⊤


go _ =
    setIt ⊤
    callIt ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    Page.text "ready"
    Page.button λ_ →
        case Worker.open worker of
            Ok handle →
                Worker.receive handle Page.text
                Worker.send handle "ping"
            Err _ →
                Page.text "open failed"
