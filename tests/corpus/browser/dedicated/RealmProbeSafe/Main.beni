-- Existence probes of globals a worker lacks run, in development and release
-- alike: a release worker writes `globalThis.document`, never a bare `document`
-- (#2207), and a local read only where its probe proves the name present is a
-- probe too (#2206, `workers.md` §4).
import Page
import RealmJs
import Worker


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                String.join
                    [ RealmJs.probeDocument ⊤
                    , RealmJs.probeStorage ⊤
                    , RealmJs.probeIdle ⊤
                    , RealmJs.siblingSafe ⊤
                    ]
                    ","
        }


start : ⊤ → ⊤
start _ =
    Page.text "waiting"
    Page.button launch


launch : ⊤ → ⊤
launch _ =
    case Worker.open worker of
        Ok handle →
            Worker.receive handle Page.text
            Worker.send handle "go"
        Err _ →
            Page.text "open failed"


main : Page.Program
main = Page.program start
