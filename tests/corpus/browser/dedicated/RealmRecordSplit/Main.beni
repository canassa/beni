-- Record fields retain independent callback realms, unlike nominal holders.
import Page
import Worker


pageOnly _ =
    Page.text "page"
    "page"


actions = { safe = λ_ → "safe", page = pageOnly }


worker : Worker.Program
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle = λ_ _ _ → actions.safe ⊤
        , stream = λ_ _ _ _ → ⊤
        }


start _ =
    Page.text "ready"
    Page.button λ_ →
        case Worker.open worker of
            Ok handle →
                Worker.receive handle Page.text
                Worker.send handle "ping"
            Err _ →
                Page.text "open failed"


main : Page.Program
main = Page.program start
