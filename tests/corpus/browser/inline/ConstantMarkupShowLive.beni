-- A constant of markup that builds a list is shown in a Show body: inline
-- evaluates it at each render, so a write of the list it builds is refused
-- (ownership-v3-kernel.md §7, *A constant read once*).
import Html exposing (Html)
import Tea


seed : List Int
seed = List.range 1 2


banner : Html Int
banner =
    xs = seed ++ [ 3 ]
    <span>{String.fromInt (List.sum xs)}</span>


view : Int → Html Int
view n =
    <button onClick={n + 1}>
        {String.fromInt n}
        {if n == 1 then <i>one</i> else banner}
    </button>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = λn _ → n, view = view }
