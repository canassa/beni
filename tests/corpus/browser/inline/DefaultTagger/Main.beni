-- A tagger whose constructor `update` handles in its `_` arm reaches the
-- key of that default step (docs/design/browser-inline.md §3): `Pushed` is
-- not named in the `case`, and the default's handler counts it.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Pushes
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea


type alias Model =
    pushes : Int


type Msg
    = Pushed Value
    | Other
    | Reset


type Key
    = Push


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Reset →
            ( { model | pushes = 0 }, Cmd.none )

        _ →
            ( { model | pushes = model.pushes + 1 }, Cmd.none )


view : Model → Html Msg
view model = <p>{model.pushes}</p>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { pushes = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.on Push Pushes.pushes Pushed
        }
