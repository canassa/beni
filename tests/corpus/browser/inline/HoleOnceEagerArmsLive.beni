-- Both arms of a branch whose values are pure and total are evaluated, one
-- after the other, on one dictionary (browser-inline.md §8.2): the inserts in
-- place are refused under --ownership=v3 (ownership-v3-kernel.md §6 rule 12,
-- *A hole evaluated once*).
import Browser
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


type Msg
    = Toggle


update : Msg, Bool → Bool
update _ shown = not shown


choices : Dict String Int, Bool → Html Msg
choices d shown =
    <>
        {if shown then
            <section data-arm="left">
                {Dict.size (Dict.insert d (String.fromInt (Dict.size d)) 1)}
            </section>
         else
            <section data-arm="right">
                {Dict.size (Dict.insert d (String.fromInt (Dict.size d)) 2)}
            </section>
        }
    </>


view : Bool → Html Msg
view shown =
    <main>
        {choices (Dict.fromList [ ( "a", if shown then 1 else 0 ) ]) shown}
        <button onClick={Toggle}>Toggle</button>
    </main>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → False, update = update, view = view })
        "root"
