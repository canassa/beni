-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"-1"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <output>"-1"</output>
      </section>
    </div>
  </div>
</body>
-- detail window rr-push {"type": "serverSet", "widget": "w1", "state": {"form": {"cups": 7}}}
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"7"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <output>"7"</output>
      </section>
    </div>
  </div>
</body>
-- click [data-role=four]
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"4"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <output>"4"</output>
      </section>
    </div>
  </div>
</body>
-- detail window rr-push {"type": "snapshot", "state": {"widgets": {"w1": {"form": {"cups": 8}}, "w2": {"venue": "West"}}}}
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"8"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="West">
        <p>"West"</p>
        <output>"8"</output>
      </section>
    </div>
  </div>
</body>
