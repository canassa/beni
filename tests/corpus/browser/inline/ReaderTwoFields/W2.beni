--! The second widget: a venue the user types, and what it shows of the
--! first widget's cups, which it reads and never writes.

import Html exposing (Html)
import W1


pub type alias Model =
    venue : String


pub init : ⊤ → Model
init ⊤ = { venue = "" }


pub type Msg
    = Write String


pub update : Msg, Model → Model
update msg model =
    case msg of
        Write typed →
            { model | venue = typed }


--| The venue every widget shows: what the program's button sets.
pub hall : Model → Model
hall model = { model | venue = "Hall" }


pub view : Model, W1.Model → Html Msg
view model first =
    <section data-role="w2">
        <input data-role="venue" value={model.venue} onInput={Write} />
        <p>{shown first.cups model.venue}</p>
    </section>


-- What the one entry shows, logged each time it runs: once per pass.
shown : Int, String → String
shown cups venue = Debug.log "shown" "${String.fromInt cups}:${venue}"
