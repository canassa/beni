-- element "root"
-- load
console.log: shown: "-1:"
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"-1"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p>"-1:"</p>
      </section>
      <button data-role="both">"Both"</button>
    </div>
  </div>
</body>
