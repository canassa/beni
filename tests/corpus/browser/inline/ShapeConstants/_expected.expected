-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="edit1">"Edit"</button>
        <p>"-1"</p>
        <p></p>
        <p>"1"</p>
        <p>"1.5"</p>
        <p>"on"</p>
        <p>"start"</p>
      </section>
      <section data-role="w2">
        <button data-role="grow">"Grow"</button>
        <p></p>
        <p>"1"</p>
      </section>
      <section data-role="w3">
        <button data-role="toggle">"Toggle"</button>
        <p>"0"</p>
        <p>"big"</p>
      </section>
    </div>
  </div>
</body>
