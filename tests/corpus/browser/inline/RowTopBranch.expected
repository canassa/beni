-- load
<body>
  <main>
    <button id="reverse">"reverse"</button>
    <button id="drop">"drop"</button>
    <button id="add">"add"</button>
    <button id="bump">"bump"</button>
    <ul id="keyed">
      <li>
        <button id="on1">"1/0"</button>
      </li>
      <li class="on">
        <button id="off2">"2"</button>
      </li>
      <!---->
      <li>
        <button id="on4">"4/0"</button>
      </li>
    </ul>
    <ol id="position">
      <li>"zero 1"</li>
      <!---->
      <li class="two">"3"</li>
      <li>"zero 4"</li>
      <li>"end"</li>
    </ol>
  </main>
</body>
