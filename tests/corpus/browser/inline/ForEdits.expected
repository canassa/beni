-- load
<body>
  <main>
    <button id="front">"front"</button>
    <button id="middle">"middle"</button>
    <button id="swap">"swap"</button>
    <button id="reverse">"reverse"</button>
    <button id="clear">"clear"</button>
    <button id="refill">"refill"</button>
    <p id="log">"-"</p>
    <ul>
      <li>
        <input .value="">
        <span>"a"</span>
        <button>"x"</button>
      </li>
      <li>
        <input .value="">
        <span>"b"</span>
        <button>"x"</button>
      </li>
      <li>
        <input .value="">
        <span>"c"</span>
        <button>"x"</button>
      </li>
    </ul>
  </main>
</body>
-- input li:nth-child(1)>input "a"
<body>
