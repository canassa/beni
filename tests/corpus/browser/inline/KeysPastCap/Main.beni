view : Model → Html Msg
view model =
    <div>
        {Html.map (W.view model.w) WMsg}
        <p>{model.k}</p>
        <button data-role="last" onClick={S257}>last</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { w = W.init ⊤, k = 0 }, update = update, view = view })
        "root"
