-- A message of 257 constructors, one of them another module's messages:
-- the key tree's first split has 257 children, past the write-set pass's
-- cap of 256 leaves, which `browser-inline` lifts (write-sets.md, *The
-- caps*; docs/design/browser-inline.md §8.7). Capped, the program had one
-- key of no steps, which the piece's event could not reach through
-- `Html.map`. Every key is split now, and the button counts.
import Browser
import Html exposing (Html)
import Tea
import W


type alias Model =
    w : W.Model
    k : Int


