-- load
console.log: empty: "none 2/0"
<body>
  <main>
    <button id="flip">"flip"</button>
    <button id="bump">"bump"</button>
    <ul id="groups">
      <li>
        <button id="clear1">"clear"</button>
        <button id="fill1">"fill"</button>
        <ol>
          <li>"a"</li>
        </ol>
        <p>
          <b>"a"</b>
          <i>"end"</i>
        </p>
      </li>
      <li>
        <button id="clear2">"clear"</button>
        <button id="fill2">"fill"</button>
        <ol>
          <li class="none">"none 2/0"</li>
        </ol>
        <p>
          "nothing"
          <i>"end"</i>
        </p>
      </li>
    </ul>
    <div id="arm">
      <p>"closed"</p>
    </div>
    <div id="show">
      <ul>
        <li>"a"</li>
      </ul>
    </div>
  </main>
</body>
