-- A `Cmd.batch` of a `List.map` whose callback makes a command
-- (browser-inline.md §4, amended 2026-11-23): the write-set pass reads it as
-- the callback's command for each element, here over a list the model
-- holds, so the bodies run, one per element, in order. `Go` also writes
-- `sent`, and each `Got` writes `got`: the holes that read them change,
-- and the one that reads `items` stays.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type alias Model =
    items : List String
    sent : Int
    got : String


type Msg
    = Go
    | Got String


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Go →
            ( { model | sent = model.sent + List.length model.items }
            , Cmd.batch (List.map model.items λs → Cmd.perform λsend → send (Got s))
            )

        Got s →
            ( { model | got = model.got ++ s }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <p id="items">{String.join model.items ","}</p>
        <p id="sent">{String.fromInt model.sent}</p>
        <p id="got">{model.got}</p>
        <button id="go" onClick={Go}>go</button>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { items = [ "a", "b", "c" ], sent = 0, got = "" }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
