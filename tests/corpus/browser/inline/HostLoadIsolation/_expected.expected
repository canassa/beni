-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="growcups">"Grow"</button>
        <p>"-1"</p>
        <output data-role="items"></output>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <input data-role="seats" .value="1">
        <span>"1"</span>
        <output>"-1"</output>
      </section>
    </div>
  </div>
</body>
