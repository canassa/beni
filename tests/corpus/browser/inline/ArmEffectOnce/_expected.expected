<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <output>"L2"</output>
        <button data-role="raise">"Raise"</button>
        <button data-role="lower">"Lower"</button>
      </section>
      <button data-role="other">"0"</button>
    </div>
  </div>
</body>
