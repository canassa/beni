-- selection
-- load
<body>
  <main>
    <input id="up" .value="abcdef" .selection=6-6>
    <input id="same" .value="abcdef" .selection=6-6>
    <input id="cap" .value="abcd" .selection=4-4>
    <input id="mirror" .value="abcdef" .selection=6-6>
  </main>
</body>
-- focus #up
<body>
  <main>
    <input id="up" .value="abcdef" .selection=6-6 :focus>
    <input id="same" .value="abcdef" .selection=6-6>
    <input id="cap" .value="abcd" .selection=4-4>
    <input id="mirror" .value="abcdef" .selection=6-6>
  </main>
</body>
-- select #up 3
<body>
  <main>
    <input id="up" .value="abcdef" .selection=3-3 :focus>
    <input id="same" .value="abcdef" .selection=6-6>
    <input id="cap" .value="abcd" .selection=4-4>
    <input id="mirror" .value="abcdef" .selection=6-6>
  </main>
</body>
-- insert #up "x"
<body>
