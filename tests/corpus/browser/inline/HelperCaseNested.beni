-- View helpers whose bodies are branches, one inside an arm of the other
-- (docs/design/browser-inline.md §8.4, amended 2026-11-23, #2498): the
-- outer helper's arm is an eager `when` in its call's context, and the
-- inner helper's call is entered inside that arm, with its own `when`s.
-- Each switches both ways while the other holds.
-- Its transcript is `browser-tea`'s for the same source but for one
-- difference: each arm written eagerly that is hidden keeps an empty text
-- node in its place, where `browser-tea` keeps one comment for the arm that
-- shows nothing, and none for the others.
import Html exposing (Html)
import Tea


type Msg
    = Open
    | Next


type alias Model =
    open : Bool
    n : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Open →
            { model | open = not model.open }

        Next →
            { model | n = Int.mod (model.n + 1) 3 }


inner : Int → Html Msg
inner n =
    case n of
        0 →
            <i id="zero">zero</i>

        1 →
            <></>

        _ →
            <b id="many">{"n is ${String.fromInt n}"}</b>


outer : Bool, Int → Html Msg
outer open n =
    if open then
        <section id="box">
            {inner n}
            <span>{n}</span>
        </section>
    else
        <></>


view : Model → Html Msg
view model =
    <main>
        <button id="open" onClick={Open}>open</button>
        <button id="next" onClick={Next}>next</button>
        {outer model.open model.n}
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { open = True, n = 0 }, update = update, view = view }
