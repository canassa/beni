-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w">
        <input data-role="cups" .value="">
        <p>"0 from "</p>
        <input data-role="venue" .value="">
        <input data-role="venue2" .value="">
        <p></p>
        <button data-role="flip">"off"</button>
      </section>
    </div>
  </div>
</body>
