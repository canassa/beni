-- element "root"
-- load
<body>
  <div id="root">
    <section data-role="form">
      <button data-role="switchMuted">"Switch muted"</button>
      ""
      <select data-role="pickPhase" .value="Standard">
        <option value="Basic">"Basic"</option>
        <option value="Standard">"Standard"</option>
        <option value="Premium">"Premium"</option>
      </select>
      <button data-role="rotatePhase">"Standard"</button>
      <input type="number" data-role="setPages" .value="4">
      <input data-role="code" .value="ab">
      <input data-role="locked" .value="fixed">
      <ul>
        <li>"Pages: 4"</li>
        <li>"Static"</li>
      </ul>
    </section>
  </div>
</body>
-- click [data-role=switchMuted]
<body>
  <div id="root">
    <section data-role="form">
      <button data-role="switchMuted">"Switch muted"</button>
      <div>
        <p>"Muted: done"</p>
        <strong>"Pages = 4"</strong>
      </div>
      <select data-role="pickPhase" .value="Standard">
        <option value="Basic">"Basic"</option>
        <option value="Standard">"Standard"</option>
        <option value="Premium">"Premium"</option>
      </select>
      <button data-role="rotatePhase">"Standard"</button>
      <input type="number" data-role="setPages" .value="4">
      <input data-role="code" .value="ab">
      <input data-role="locked" .value="fixed">
      <ul>
        <li>"Pages: 4"</li>
        <li>"Static"</li>
      </ul>
    </section>
  </div>
</body>
