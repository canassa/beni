-- Shared scoped commands preserve captured effects and log context.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Log
import Sub
import Tea


type Msg
    = Go
    | Done


update : Msg, Int → Int × Cmd Msg
update msg model =
    t = Log.annotate "k" "v" λ⊤ → ( Cmd.perform λ_ → Log.info "body", model + 1 )
    case t of
        ( c, m ) →
            ( m, c )


view : Int → Html Msg
view model = <button onClick={Go}>{model}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
