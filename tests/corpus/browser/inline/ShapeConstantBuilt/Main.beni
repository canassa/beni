-- A route's constant that only the route's function builds
-- (`docs/design/browser-inline.md` §8.4, amended 2026-10-24, #946): `W1.replace`
-- resets `mode` to `Mode.Idle`, a constructor of a third module that nothing
-- else builds, and the program has no `schema`, so no constructor is exempt
-- from `backend.md` §9's *A `case` arm on a constructor nothing builds*. The
-- row holds the constant, and the build counts it as built: `W1.view`'s arm
-- on `Idle` is kept, and a push shows it. The expected transcript was made
-- with the compiler before the change.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Json
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea
import W1


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"


type alias Model =
    w1 : W1.Model


init : ⊤ → Model × Cmd Msg
init ⊤ = ( { w1 = W1.init ⊤ }, Cmd.none )


type Msg
    = W1Msg W1.Msg
    | Pushed Value


update : Msg, Model → Model × Cmd Msg
update msg model = ( step msg model, Cmd.none )


step : Msg, Model → Model
step msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        Pushed value →
            pushed value model


subscriptions : Model → Sub Msg
subscriptions _ = Push.onPush Pushed


pushed : Value, Model → Model
pushed value model =
    case Json.decodeValue value of
        Ok event →
            replaced event.widget event.state model

        Err _ →
            model


replaced : String, Value, Model → Model
replaced widget state model =
    case widget of
        "w1" →
            { model | w1 = W1.replace state model.w1 }

        _ →
            model


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
    </div>


-- ---- Shape runs: thirty runs in all take the program to the shapes side --

pub pad1 : Value → Int
pad1 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


pub pad2 : Value → Int
pad2 v = (Result.withDefault (Json.decodeValue v) { n = 2 }).n


