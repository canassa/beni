-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="work">"Work"</button>
        <p>"-1"</p>
        <p>"busy"</p>
      </section>
    </div>
  </div>
</body>
-- detail window rr-push {"widget": "w1", "state": {"cups": 3}}
<body>
