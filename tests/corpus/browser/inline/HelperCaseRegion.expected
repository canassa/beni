-- load
<body>
  <main>
    <button id="start">"start"</button>
    <p id="saved">"ada"</p>
    <button id="done">"done"</button>
  </main>
</body>
-- click #start
<body>
  <main>
    <button id="start">"start"</button>
    <p id="saved">"ada"</p>
    <input id="edit" .value="ada">
    <button id="done">"done"</button>
  </main>
</body>
-- input #edit "grace"
<body>
  <main>
    <button id="start">"start"</button>
    <p id="saved">"ada"</p>
    <input id="edit" .value="grace">
    <button id="done">"done"</button>
  </main>
</body>
-- focus #edit
<body>
  <main>
    <button id="start">"start"</button>
    <p id="saved">"ada"</p>
    <input id="edit" .value="grace" :focus>
    <button id="done">"done"</button>
  </main>
</body>
-- blur #edit
<body>
  <main>
    <button id="start">"start"</button>
    <p id="saved">"grace"</p>
    <button id="done">"done"</button>
  </main>
</body>
