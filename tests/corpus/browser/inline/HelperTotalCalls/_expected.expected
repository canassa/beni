-- element "root"
-- load
<body>
  <div id="root">
    <main>
      ""
      <output>"0"</output>
      <button data-role="append">"Append"</button>
      <button data-role="toggle">"Toggle"</button>
    </main>
  </div>
</body>
-- click [data-role=append]
(the DOM did not change)
-- click [data-role=toggle]
<body>
  <div id="root">
    <main>
      <section>
        <button data-role="choose">"4 4 3"</button>
      </section>
      <output>"0"</output>
      <button data-role="append">"Append"</button>
      <button data-role="toggle">"Toggle"</button>
    </main>
  </div>
</body>
-- click [data-role=choose]
