-- A cross-module reader across the app and platform boundary: `W1`, the
-- writer, is in the project's own platform layer, and `W2`, an app module,
-- reads `W1.Model`; `W1`'s handlers keep it current (D-c,
-- docs/design/browser-inline.md §8.4, amended 2026-10-19). `Reader`'s page,
-- with `W1` moved into the layer.
import Browser
import Html exposing (Html)
import Tea
import W1
import W2


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            { model | w2 = W2.update sub model.w2 }


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
        {Html.map (W2.view model.w2 model.w1) W2Msg}
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { w1 = W1.init ⊤, w2 = W2.init ⊤ }
            , update = update
            , view = view
            }
        )
        "root"
