-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <output>"2"</output>
        <button data-role="raise">"Raise"</button>
        <button data-role="lower">"Lower"</button>
      </section>
      <section data-role="w2">
        <p>"Note: quiet"</p>
        <p>"Level: 2"</p>
        <p>"low"</p>
        <button data-role="toggle">"Toggle"</button>
      </section>
    </div>
  </div>
</body>
