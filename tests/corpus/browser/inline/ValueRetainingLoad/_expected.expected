-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"-1"</p>
        <output data-role="retained">"none"</output>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <input data-role="seats" .value="1">
        <span>"1"</span>
        <output>"-1"</output>
      </section>
    </div>
  </div>
</body>
-- detail window rr-push {"type":"serverSet","widget":"w1","state":{"cups":3,"kept":{"items":[1,2]}}}
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"3"</p>
        <output data-role="retained">"{\"items\":[1,2]}"</output>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <input data-role="seats" .value="1">
        <span>"1"</span>
        <output>"3"</output>
      </section>
    </div>
  </div>
</body>
-- click [data-role=four]
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"4"</p>
        <output data-role="retained">"{\"items\":[1,2]}"</output>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <input data-role="seats" .value="1">
        <span>"1"</span>
        <output>"4"</output>
      </section>
    </div>
  </div>
</body>
