-- element "root"
-- load
<body>
  <div id="root">
    <main>
      <p data-role="p" class="base">"0"</p>
      <span data-role="s">"s"</span>
      <button data-role="toggle">"t"</button>
      <button data-role="inc">"i"</button>
    </main>
  </div>
</body>
-- click [data-role=toggle]
<body>
  <div id="root">
    <main>
      <p data-role="p" class="base on">"0"</p>
      <span data-role="s" class="on">"s"</span>
      <button data-role="toggle">"t"</button>
      <button data-role="inc">"i"</button>
    </main>
  </div>
</body>
-- click [data-role=inc]
<body>
  <div id="root">
    <main>
      <p data-role="p" class="base on">"1"</p>
      <span data-role="s" class="on">"s"</span>
      <button data-role="toggle">"t"</button>
      <button data-role="inc">"i"</button>
    </main>
  </div>
</body>
