-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <p data-role="a">"a 0"</p>
      <p data-role="b">"b 10"</p>
      <p data-role="clicks">"0"</p>
      <button data-role="bump">"bump"</button>
      <button data-role="both">"both"</button>
    </div>
  </div>
</body>
-- click [data-role=bump]
<body>
  <div id="root">
    <div data-role="app">
      <p data-role="a">"a 1"</p>
      <p data-role="b">"b 10"</p>
      <p data-role="clicks">"1"</p>
      <button data-role="bump">"bump"</button>
      <button data-role="both">"both"</button>
    </div>
  </div>
</body>
-- click [data-role=both]
<body>
  <div id="root">
    <div data-role="app">
      <p data-role="a">"A1 1"</p>
      <p data-role="b">"b 11"</p>
      <p data-role="clicks">"1"</p>
      <button data-role="bump">"bump"</button>
      <button data-role="both">"both"</button>
    </div>
  </div>
</body>
