-- Shared scoped commands preserve captured effects and log context.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Task
import Tea


type Msg
    = Done


init : ⊤ → Int × Cmd Msg
init ⊤ =
    ( 0
    , Cmd.perform λsend →
        Task.yieldNow ⊤
        send Done
    )


update : Msg, Int → Int × Cmd Msg
update msg model =
    case msg of
        Done →
            ( model + 1, Cmd.none )


view : Int → Html Msg
view n = <p>{n}</p>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = λ_ → Sub.none }
