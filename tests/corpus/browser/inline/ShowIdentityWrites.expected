-- load
<body>
  <main>
    <button id="age">"age"</button>
    <button id="note">"note"</button>
    <button id="same">"same"</button>
    <button id="rewrap">"rewrap"</button>
    <button id="clear">"clear"</button>
    <button id="back">"back"</button>
    <label>
      "Ada"
      ""
      <input id="shown" .value="">
    </label>
  </main>
</body>
