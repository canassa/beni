-- A root with no hole (`docs/design/browser-inline.md` §8.4, amended
-- 2026-10-22): `W1`'s markup reads nothing of the model, so no hole gives its
-- call path, which the view walk's call of its function gives instead. Its
-- click is still its own handler, writing the slice it holds, and `W2`'s
-- reader of `w1.cups` registered in `W1`'s row shows it.
import Browser
import Html exposing (Html)
import Tea
import W1
import W2


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { w1 = W1.init ⊤, w2 = W2.init ⊤ }
            , update = update
            , view = view
            }
        )
        "root"


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            { model | w2 = W2.update sub model.w2 }


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
        {Html.map (W2.view model.w2 model.w1) W2Msg}
    </div>
