-- A function the command is mapped with keeps the message: the list in it is
-- not update's own, so the write is refused (ownership-v3-kernel.md §6 rule
-- 13, *A message a command builds*).
import Cmd
import Html exposing (Html)
import Ref
import Sub
import Tea


type Msg
    = Start
    | Items (List Int)


stash : Ref.Ref (List Msg)
stash = Ref.make []


keep : a, Ref.Ref (List a) → a
keep x r =
    Ref.set r [ x ]
    x


update : Msg, Int → Int × Cmd.Cmd Msg
update msg n =
    case msg of
        Start →
            ( n, Cmd.map (Cmd.perform λsend → send (Items [ 1, 2 ])) ⊤ (keep _ stash) )

        Items xs →
            ( List.length (List.push xs 3), Cmd.none )


view : Int → Html Msg
view n = <main><button id="start" onClick={Start}>start</button><p>{n}</p></main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
