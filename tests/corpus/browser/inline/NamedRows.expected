    <button id="bump">"bump"</button>
    <button id="one">"one"</button>
    <button id="two">"two"</button>
    <button id="none">"none"</button>
    <p id="picked">"5"</p>
    <ul id="keyed">
      <li>
        <button id="pick4">"4"</button>
        <input id="in4" .value="">
      </li>
      <li>
        <button id="pick3">"3"</button>
        <input id="in3" .value="">
      </li>
      <li>
        <button id="pick1">"1"</button>
        <input id="in1" .value="one">
      </li>
      <li>
        <button id="pick5">"5"</button>
        <input id="in5" .value="">
      </li>
      <li>
        <button id="pick6">"6"</button>
        <input id="in6" .value="">
      </li>
    </ul>
    <ol id="placed">
      <li>"0: 4"</li>
      <li>"1: 3"</li>
      <li>"2: 1"</li>
      <li>"3: 5"</li>
      <li>"4: 6"</li>
    </ol>
    <ul id="chosen">
      <li class="even">"4"</li>
      <!---->
      <li class="odd">
        <button id="odd1">"1"</button>
      </li>
      <li class="odd">
        <button id="odd5">"5"</button>
      </li>
      <li class="even">"6"</li>
    </ul>
    <div id="show">
      <em>
        <input id="kept" .value="">
        "1"
      </em>
    </div>
    <div id="shownamed">
      <p id="named">"named 1"</p>
    </div>
  </main>
</body>
