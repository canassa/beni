-- load
<body>
  <main>
    <button id="reverse">"reverse"</button>
    <button id="drop">"drop"</button>
    <button id="add">"add"</button>
    <button id="bump">"bump"</button>
    <button id="one">"one"</button>
    <button id="two">"two"</button>
    <button id="none">"none"</button>
    <p id="picked">"0"</p>
    <ul id="keyed">
      <li>
        <button id="pick1">"1"</button>
        <input id="in1" .value="">
      </li>
      <li>
        <button id="pick2">"2"</button>
        <input id="in2" .value="">
      </li>
      <li>
        <button id="pick3">"3"</button>
        <input id="in3" .value="">
      </li>
      <li>
        <button id="pick4">"4"</button>
        <input id="in4" .value="">
      </li>
    </ul>
    <ol id="placed">
      <li>"0: 1"</li>
      <li>"1: 2"</li>
      <li>"2: 3"</li>
      <li>"3: 4"</li>
    </ol>
    <ul id="chosen">
      <li class="odd">
        <button id="odd1">"1"</button>
      </li>
      <li class="even">"2"</li>
      <!---->
      <li class="even">"4"</li>
    </ul>
    <div id="show">
      <i>"nothing"</i>
    </div>
    <div id="shownamed"></div>
  </main>
</body>
