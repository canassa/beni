-- A URL attribute whose value changes goes through the runtime's `safeUrl`
-- on `browser-inline` (browser-inline.md §10.5, amended 2026-11-05):
-- `browser/dom/SafeUrl`'s page, the same URLs and the same result. A
-- `javascript:` or `data:text/html` URL is written as nothing, in any case
-- and with whitespace or a control character wherever a browser ignores
-- one, both at the mount and when a key's handler writes the attribute
-- again; any other URL is written as it is, `data:` of another type and a
-- path that merely begins `javascript` included; and so is every URL
-- attribute (`action` here). A field no message changes is baked, the
-- check made when the program is built: `baked`'s script URL is an empty
-- `href` in the markup. One whose answer turns on a character outside
-- ASCII is a binding instead, and the runtime refuses `nbspBaked`'s.
import Html exposing (Html)
import Tea


type Msg
    = Flip


type alias Model =
    unsafe : Bool
    baked : String
    nbspBaked : String


update : Msg, Model → Model
update _ model = { model | unsafe = not model.unsafe }


-- Each link's URL in the two states: refused ones first, kept ones second.
url : Bool, String, String → String
url unsafe bad good =
    if unsafe then
        bad
    else
        good


view : Model → Html Msg
view model =
    <main>
        <button id="flip" onClick={Flip}>flip</button>
        <a id="plain" href={url model.unsafe "javascript:alert(1)" "/a"}>plain</a>
        <a id="cased" href={url model.unsafe "JaVaScRiPt:alert(1)" "/b"}>cased</a>
        <a id="spaced" href={url model.unsafe " \u{0001}\tjava\nscript :x" "/c"}>spaced</a>
        <a id="html" href={url model.unsafe "data:text/html,<b>x</b>" "/d"}>html</a>
        <a id="html64" href={url model.unsafe "DATA: text / html ;base64,eA==" "/e"}>html64</a>
        <a id="nbsp" href={url model.unsafe "\u{00A0}java\u{00A0}script:x" "/n"}>nbsp</a>
        <a id="image" href={url model.unsafe "data:image/png,x" "/f"}>image</a>
        <a id="path" href={url model.unsafe "javascript.html" "/g"}>path</a>
        <form id="form" action={url model.unsafe "\tjavascript:x" "/h"} />
        <a id="baked" href={model.baked}>baked</a>
        <a id="nbspBaked" href={model.nbspBaked}>nbspBaked</a>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                { unsafe = True, baked = "javascript:alert(1)", nbspBaked = "\u{00A0}javascript:x" }
        , update = update
        , view = view
        }
