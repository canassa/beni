-- load
<body>
  <main>
    <div id="top">
      <button class="reset">"reset"</button>
    </div>
    <button id="inc">"inc"</button>
    <section id="inner">
      <p>"1"</p>
      <button class="reset">"reset"</button>
    </section>
    <div id="bottom">
      <button class="reset">"reset"</button>
    </div>
  </main>
</body>
