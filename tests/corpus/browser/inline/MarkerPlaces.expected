-- load
<body>
  <main>
    <button id="more">"more"</button>
    <button id="less">"less"</button>
    <button id="flip">"flip"</button>
    <button id="name">"name"</button>
    <p id="fors">
      <!---->
      "then"
      <!---->
      <!---->
      "end"
    </p>
    <div id="shows">
      <s>"none"</s>
      <!---->
      <!---->
      "after "
      "ann"
    </div>
    <p id="regions">
      <i>"empty"</i>
      <!---->
      "mid"
      <em>"first"</em>
      <!---->
      "ann"
      <i>"off"</i>
      <!---->
      "tail"
    </p>
  </main>
</body>
