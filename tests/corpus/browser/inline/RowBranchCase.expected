-- load
<body>
  <main>
    <button id="reverse">"reverse"</button>
    <button id="mark">"mark"</button>
    <ul>
      <li>
        <button id="on-1">"add"</button>
        <p>
          <i>"none"</i>
        </p>
      </li>
      <li>
        <span>
          <input id="in-2" .value="">
          <button id="off-2">"two"</button>
        </span>
        <p>
          <em>"two"</em>
        </p>
      </li>
    </ul>
  </main>
</body>
-- input #in-2 "typed"
<body>
  <main>
    <button id="reverse">"reverse"</button>
    <button id="mark">"mark"</button>
    <ul>
      <li>
        <button id="on-1">"add"</button>
        <p>
          <i>"none"</i>
        </p>
      </li>
      <li>
        <span>
          <input id="in-2" .value="typed">
          <button id="off-2">"two"</button>
        </span>
        <p>
          <em>"two"</em>
        </p>
      </li>
    </ul>
  </main>
</body>
-- click #mark
