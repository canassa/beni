-- load
console.log: show element: 0
console.log: show text: "0"
console.log: for element: 0
console.log: for text: "0"
<body>
  <main>
    <button id="bump">"bump"</button>
    <button id="toggle">"toggle"</button>
    <section id="show">
      <p>"0"</p>
    </section>
    <section id="show-text">"0"</section>
    <ul id="for">
      <li>"0"</li>
    </ul>
    <ul id="for-text">"0"</ul>
  </main>
</body>
