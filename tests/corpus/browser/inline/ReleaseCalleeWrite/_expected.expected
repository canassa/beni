-- load
<body>
  <main>
    <button id="later">"later"</button>
    <button id="deep">"deep"</button>
    <button id="cross">"cross"</button>
    <button id="record">"record"</button>
    <button id="tuple">"tuple"</button>
    <button id="batch">"batch"</button>
    <button id="slept">"slept"</button>
    <button id="apply">"apply"</button>
    <button id="handed">"handed"</button>
    <p id="count">"0"</p>
    <p id="log"></p>
  </main>
</body>
-- click #later
