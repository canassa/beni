--! The second module of CellEntryHosts: a function that forks a fiber in
--! which a writer of a cell runs.

import Duration
import List
import Ref
import Task


hosting : ⊤ → ⊤
hosting ⊤ =
    r = Ref.make [ 1, 2 ]
    _ = Task.spawn λ⊤ →
        Task.sleep (Duration.millis 1)
        Ref.update r λl → List.push (List.copy l) 5
    Task.sleep (Duration.millis 5)
    _ = List.length (Ref.get r)
    ⊤


pub forkerM : ⊤ → ⊤
forkerM ⊤ =
    _ = Task.spawn hosting
    ⊤
