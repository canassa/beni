-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="raise">"Raise"</button>
        <p>"-1"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <output>"-1"</output>
      </section>
    </div>
  </div>
</body>
-- click [data-role=raise]
<body>
  <div id="root">
