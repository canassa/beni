-- load
<body>
  <main>
    <button id="go">"Go"</button>
    <div id="arena">"arena"</div>
    <div id="inner">"inner 0"</div>
    <section>
      <div id="pad">"pad"</div>
      <output>"0"</output>
    </section>
    <p id="at">"0.0 0"</p>
  </main>
</body>
-- click #go
<body>
  <main>
    <button id="go">"Go"</button>
    <div id="arena">"arena"</div>
    <div id="inner">"inner 30"</div>
    <section>
      <div id="pad">"pad"</div>
      <output>"30"</output>
    </section>
    <p id="at">"30.0 3"</p>
  </main>
</body>
