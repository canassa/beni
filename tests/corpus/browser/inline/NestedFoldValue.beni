-- `writes/NestedFoldValue`'s program as a page (the review of #1002). An
-- analysis that shared one element root between the two folds dropped the
-- inner insertion, so a click left the page at 0. It shows 1.
import Browser
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


type Item
    = A
    | B


type alias Model =
    items : List Item
    d : Dict Int Int


type Msg
    = Go


f : List Item, Dict Int Int → Dict Int Int
f items d =
    fl = List.foldl
    fl items d λx acc →
        case x of
            A →
                fl items acc λy acc2 →
                    case y of
                        A →
                            acc2

                        B →
                            Dict.insert acc2 1 1

            B →
                acc


update : Msg, Model → Model
update msg model =
    case msg of
        Go →
            { model | d = f model.items model.d }


view : Model → Html Msg
view model = <p data-role="d" onClick={Go}>{Maybe.withDefault (Dict.get model.d 1) 0}</p>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { items = [ A, B ], d = Dict.empty }, update = update, view = view }
        )
        "root"
