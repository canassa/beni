-- `Counter.update`'s arms read the message whole, `name msg`, so `Counter`
-- has no arm piece: the handler calls `Counter.update` with the message the
-- key's fields make (D-e, docs/design/browser-inline.md §8.4), and the page
-- shows the name it recorded.
import Browser
import Counter
import Html exposing (Html)
import Tea


type alias Model =
    c : Counter.Model


type Msg
    = CounterMsg Counter.Msg


step : Msg, Model → Model
step msg model =
    case msg of
        CounterMsg sub →
            { model | c = Counter.update sub model.c }


update : Msg, Model → Model
update msg model = step msg model


view : Model → Html Msg
view model =
    <div data-role="app">
        <output>{model.c.count}</output>
        <p>{model.c.last}</p>
        <button data-role="inc" onClick={CounterMsg Counter.Inc}>+</button>
        <button data-role="dec" onClick={CounterMsg Counter.Dec}>-</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { c = Counter.init ⊤ }, update = update, view = view })
        "root"
