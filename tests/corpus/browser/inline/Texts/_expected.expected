-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="texts">
        <p>"Count: 1"</p>
        <p>"first"</p>
        <button data-role="add">"Add"</button>
        <button data-role="removeLast">"Remove last"</button>
        <button data-role="clear">"Clear"</button>
      </section>
    </div>
  </div>
</body>
-- click [data-role=add]
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="texts">
        <p>"Count: 2"</p>
        <p>"first, text 2"</p>
        <button data-role="add">"Add"</button>
        <button data-role="removeLast">"Remove last"</button>
        <button data-role="clear">"Clear"</button>
      </section>
    </div>
  </div>
</body>
