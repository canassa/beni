        <input id="in3" .value="">
        "m*"
        " row "
        "3"
        <button>"pick"</button>
        <ol>
          <li>"t2"</li>
          <li>"b"</li>
          <li>"c"</li>
          <li>"end"</li>
        </ol>
      </li>
      <li id="row2" title="2">
        <input id="in2" .value="2" :focus>
        "m*"
        " row "
        "2"
        <button>"pick"</button>
        <ol>
          <li>"t0"</li>
          <li>"end"</li>
        </ol>
      </li>
      <li id="row1" title="1">
        <input id="in1" .value="1">
        "m*"
        " row "
        "1"
        <button>"pick"</button>
        <ol>
          <li>"t1"</li>
          <li>"a"</li>
          <li>"end"</li>
        </ol>
      </li>
      <li>"last"</li>
