--! The second widget: a venue the user types, and what it shows of the
--! first widget's cups, which it reads and never writes. Its `replace`
--! updates the model it is handed, so it is no route.

import Html exposing (Html)
import Json
import Schema exposing (Value)
import W1


pub type alias Model =
    venue : String


pub init : ⊤ → Model
init ⊤ = { venue = "" }


pub type Msg
    = Write String


pub update : Msg, Model → Model
update msg model =
    case msg of
        Write typed →
            { model | venue = typed }


--| The venue the host sent, or the model as it was when it sent none.
pub replace : Value, Model → Model
replace state model =
    case Json.decodeValue state of
        Ok new →
            { model | venue = new.venue }

        Err _ →
            model


pub view : Model, W1.Model → Html Msg
view model first =
    <section data-role="w2">
        <input data-role="venue" value={model.venue} onInput={Write} />
        <p>{model.venue}</p>
        <output>{first.cups}</output>
    </section>
