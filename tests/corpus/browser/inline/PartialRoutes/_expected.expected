-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"-1"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <output>"-1"</output>
      </section>
    </div>
  </div>
</body>
-- detail window rr-push {"type": "serverSet", "widget": "w1", "state": {"cups": 9}}
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"9"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="">
        <p></p>
        <output>"9"</output>
      </section>
    </div>
  </div>
</body>
