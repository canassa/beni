-- detail window rr-push {"type": "snapshot", "state": {"widgets": {"w1": {"cups": 2}, "w2": {"venue": "West"}}}}
<body>
  <div id="root">
    <div data-role="app">
      <section data-role="w1">
        <button data-role="four">"Make it 4"</button>
        <p>"2"</p>
      </section>
      <section data-role="w2">
        <input data-role="venue" .value="West">
        <p>"West"</p>
        <output>"2"</output>
      </section>
    </div>
  </div>
</body>
