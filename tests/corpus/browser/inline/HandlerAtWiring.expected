-- element "root"
-- load
<body>
  <div id="root">
    <main>
      <output>"0"</output>
      <button>"one"</button>
      <button>"two"</button>
    </main>
  </div>
</body>
-- click button:nth-of-type(1)
<body>
  <div id="root">
    <main>
      <output>"1"</output>
      <button>"one"</button>
      <button>"two"</button>
    </main>
  </div>
</body>
