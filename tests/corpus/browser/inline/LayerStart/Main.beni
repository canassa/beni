-- The research generators' push subscription, through their own platform
-- layer (`Push.onPush`, unchanged). The analysis reads the set — one
-- declaration, key `Pushed`, its tagger `Pushed` — and its start, a lambda
-- of the layer's module, is lifted there as an exported piece the mount
-- calls (docs/design/browser-inline.md §7). A push runs the handler;
-- `stop` removes the listener.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea


type Msg
    = Pushed Value
    | Tick


init : ⊤ → {} × Cmd Msg
init ⊤ = ( {}, Cmd.none )


update : Msg, {} → {} × Cmd Msg
update msg model =
    case msg of
        Pushed _ →
            ( model, Cmd.none )

        Tick →
            ( model, Cmd.none )


subscriptions : {} → Sub Msg
subscriptions _ = Push.onPush Pushed


view : {} → Html Msg
view _ = <div />


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"
