-- A keyed command compiles on `browser-inline` (browser-inline.md §4,
-- amended 2026-11-23): the write-set pass reads `Cmd.keyed` as the body it
-- runs, and the runtime keeps the bodies running under each key. It was
-- refused, class 4, until the runtime had that table.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type Msg
    = Go
    | Got Int


update : Msg, Int → Int × Cmd Msg
update msg n =
    case msg of
        Go →
            ( n, Cmd.keyed "go" Cmd.Restart λsend → send (Got 1) )

        Got k →
            ( n + k, Cmd.none )


view : Int → Html Msg
view n = <main><button id="go" onClick={Go}>go</button><output>{n}</output></main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none ), update = update, view = view, subscriptions = λ_ → Sub.none }
