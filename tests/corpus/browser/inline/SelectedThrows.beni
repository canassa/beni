-- A potentially throwing helper argument stays unevaluated while its arm
-- is hidden (#459). The preceding argument logs once, in source order.
-- Revealing it throws before visibility or sibling text
-- writes change the previous page.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    cups : Int
    shown : Bool


type Msg
    = Cup
    | Toggle


update : Msg, Model → Model
update msg model =
    case msg of
        Cup →
            { model | cups = model.cups + 1 }

        Toggle →
            { model | shown = not model.shown }


boom : Int → Int
boom n = if n > 0 then Debug.todo "selected helper boom" else n


pair : Int, Int, Model → Html Msg
pair first label model = <p data-role="helper">{first} {label} {model.cups}</p>


view : Model → Html Msg
view model =
    <div>
        {if model.shown then
            <section>
                <p data-role="hole">{model.cups}</p>
                {pair (Debug.log "before" model.cups) (boom model.cups) model}
            </section>
         else
            <></>
        }
        <button data-role="cup" onClick={Cup}>Cup</button>
        <button data-role="toggle" onClick={Toggle}>Toggle</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { cups = 0, shown = False }, update = update, view = view })
        "root"
