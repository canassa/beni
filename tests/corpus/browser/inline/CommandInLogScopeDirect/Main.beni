-- Shared scoped commands preserve captured effects and log context.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Log
import Sub
import Tea


type Msg
    = Go


update : Msg, Int → Int × Cmd Msg
update _ model = Log.annotate "request" "r1" λ⊤ → ( model + 1, Cmd.perform λ_ → Log.info "a body" )


view : Int → Html Msg
view model = <button onClick={Go}>{model}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
