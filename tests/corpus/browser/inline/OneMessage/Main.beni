-- A message type of one constructor is one key with no steps: `update` has
-- nothing to tell apart (write-sets.md §4.4). A tagger giving that
-- constructor reaches that key's handler (docs/design/browser-inline.md §3).
import Cmd exposing (Cmd)
import Html exposing (Html)
import Pushes
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea


type alias Model =
    pushes : Int


type Msg
    = Pushed Value


type Key
    = Push


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Pushed _ →
            ( { model | pushes = model.pushes + 1 }, Cmd.none )


view : Model → Html Msg
view model = <p>{model.pushes}</p>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { pushes = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.on Push Pushes.pushes Pushed
        }
