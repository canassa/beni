-- load
console.log: none: 0
console.log: first: "a"
console.log: row: "b"
console.log: statement: "b"
console.log: inner: "a"
console.log: ticks in a row: 0
<body>
  <main>
    <button id="ada">"ada"</button>
    <button id="clear">"clear"</button>
    <button id="rename">"rename"</button>
    <button id="tick">"0"</button>
    <section>
      <i id="picked">"none"</i>
    </section>
    <div>
      <em id="badge">"-"</em>
    </div>
    <ul>
      <li>"first"</li>
      <li>"b"</li>
    </ul>
    <ol>
      <li>
        <b>"a"</b>
      </li>
      <li>
        <i>"b"</i>
      </li>
    </ol>
  </main>
</body>
