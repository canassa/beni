-- load
<body>
  <main>
    <nav>
      <a id="handled" href="/h">"handled"</a>
      <a id="plain" href="/p">"plain"</a>
      <button id="next">"next"</button>
      <button id="first">"first"</button>
      <button id="twice">"twice"</button>
      <input id="shout" .value="">
      <button id="toggle">"toggle"</button>
      ""
      <form id="form">
        <button id="submit">"submit"</button>
      </form>
      <output id="page">"1"</output>
      <output id="text"></output>
      <output id="handled">"0"</output>
    </nav>
    <p id="request"></p>
  </main>
</body>
