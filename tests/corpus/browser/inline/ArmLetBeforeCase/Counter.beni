pub type alias Model =
    count : Int


pub init : ⊤ → Model
init ⊤ = { count = 3 }


pub type Msg
    = Inc
    | Dec


pub update : Msg, Model → Model
update msg model =
    step = 1
    case msg of
        Inc →
            { model | count = model.count + step }

        Dec →
            { model | count = model.count - step }
