-- The live twin of CellEntryHosts: each fiber that the functions start reads
-- a cell its parent made, so `init`, `update` and `view` host, and the runtime
-- can run each where a masked ancestor keeps the reader running after a throw:
-- refused at the entry, one refusal there (ownership-v3-kernel.md §13 item 12,
-- *A defect*, (d), *The ways in, from the code*, item 12; #2695). The `where`
-- method is refused at its binding, as before (*The ways in*, row 5).
import Cmd exposing (Cmd)
import Duration
import Hoster
import Html exposing (Html)
import List
import Ref
import String
import Sub exposing (Sub)
import Task
import Tea


type Msg
    = Done
    | Direct
    | Helper
    | Other
    | Method
    | Evidence


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


hosting : ⊤ → ⊤
hosting ⊤ =
    r = Ref.make [ 1, 2 ]
    _ = Task.spawn λ⊤ →
        Task.sleep (Duration.millis 5)
        _ = ints (Ref.get r)
        ⊤
    ⊤


forker : ⊤ → ⊤
forker ⊤ =
    _ = Task.spawn hosting
    ⊤


forkVia : ⊤ → ⊤
forkVia ⊤ = forker ⊤


pub type HF
    = HF


pub fgo : HF → ⊤
fgo h =
    case h of
        HF →
            forker ⊤


runGo : a → ⊤
    where a.fgo : a → ⊤
runGo x = x.fgo


shown : Int → Int
shown n =
    if n == 3 then forker ⊤
    n


work : (Msg → ⊤) → ⊤
work send =
    Task.start
        (λ⊤ →
            Task.uninterruptible λ⊤ →
                send Direct
                send Helper
                send Other
                send Method
                send Evidence
                Task.sleep (Duration.millis 50)
        )
        λ_ → ⊤


init : ⊤ → Int × Cmd Msg
init ⊤ =
    forker ⊤
    ( 0, Cmd.perform work )


update : Msg, Int → Int × Cmd Msg
update msg model =
    case msg of
        Done →
            ( model, Cmd.none )

        Direct →
            forker ⊤
            ( model + 1, Cmd.none )

        Helper →
            forkVia ⊤
            ( model + 1, Cmd.none )

        Other →
            Hoster.forkerM ⊤
            ( model + 1, Cmd.none )

        Method →
            hf = HF
            hf.fgo
            ( model + 1, Cmd.none )

        Evidence →
            runGo HF
            ( model + 1, Cmd.none )


view : Int → Html Msg
view n = <p>{shown n}</p>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = λ_ → Sub.none }
