-- click #inner
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <label>
      "user 1!"
      <input id="by-key" .value="typed">
      "2"
      <button id="inner">"inner"</button>
    </label>
    <p id="after">"after"</p>
    <div>
      <b>"user 1!"</b>
    </div>
    <section>
      <i>
        "2"
        <input id="by-value" .value="">
      </i>
    </section>
  </main>
</body>
-- input #by-value "two"
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <label>
      "user 1!"
      <input id="by-key" .value="typed">
      "2"
      <button id="inner">"inner"</button>
    </label>
    <p id="after">"after"</p>
    <div>
      <b>"user 1!"</b>
    </div>
    <section>
      <i>
        "2"
        <input id="by-value" .value="two">
      </i>
    </section>
  </main>
</body>
