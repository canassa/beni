-- load
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <p id="nobody">"nobody at 0"</p>
    <p id="after">"after"</p>
    <div>"none at 0"</div>
    <section></section>
  </main>
</body>
-- click #bump
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <p id="nobody">"nobody at 1"</p>
    <p id="after">"after"</p>
    <div>"none at 1"</div>
    <section></section>
  </main>
</body>
-- click #next
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <label>
      "user 1"
      <input id="by-key" .value="">
      "1"
      <button id="inner">"inner"</button>
    </label>
    <p id="after">"after"</p>
    <div>
      <b>"user 1"</b>
    </div>
    <section></section>
  </main>
</body>
-- input #by-key "typed"
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <label>
      "user 1"
      <input id="by-key" .value="typed">
      "1"
      <button id="inner">"inner"</button>
    </label>
    <p id="after">"after"</p>
    <div>
      <b>"user 1"</b>
    </div>
    <section></section>
  </main>
</body>
-- click #rename
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="clear">"clear"</button>
    <button id="bump">"bump"</button>
    <label>
      "user 1!"
      <input id="by-key" .value="typed">
