-- load
<body>
  <main>
    <button id="bump">"bump"</button>
    <button id="rename">"rename"</button>
    <button id="toggle">"toggle"</button>
    <button id="add">"add"</button>
    <p id="before">
      "ann"
      <strong>"!"</strong>
    </p>
    <p id="after">
      <strong>"1"</strong>
      " item"
    </p>
    <p id="between">
      "Hello, "
      "ann"
      " and "
      <em>"more"</em>
      " count "
      "1"
    </p>
    <p id="number">
      <b>"n"</b>
      "1"
    </p>
    <div id="arm">
      "open "
      "ann"
      <hr>
    </div>
    <ul id="list">
      "seen "
      "1"
      <li>"end"</li>
    </ul>
    <section id="region">
      "label "
      "ann"
      <i>"none"</i>
      <hr>
    </section>
  </main>
</body>
