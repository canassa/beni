-- element "root"
-- load
<body>
  <div id="root">
    <main>
      <output>"0"</output>
      <p>"start"</p>
      <aside>"outside"</aside>
      <button data-role="inc">"+1"</button>
      <button data-role="field">"Field"</button>
      <button data-role="restore">"Restore"</button>
    </main>
  </div>
</body>
-- click [data-role=inc]
