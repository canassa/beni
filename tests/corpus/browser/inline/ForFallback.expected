-- load
<body>
  <main>
    <button id="add">"add"</button>
    <button id="clear">"clear"</button>
    <ul id="element">
      <li>
        <button id="bump">"none 0"</button>
      </li>
    </ul>
    <p id="text">
      "empty 0"
      <!---->
      "end"
    </p>
    <ol id="label">
      <li>"n=0"</li>
    </ol>
    <div id="show">
      <i>"n=0"</i>
    </div>
    <ol id="empty"></ol>
  </main>
</body>
