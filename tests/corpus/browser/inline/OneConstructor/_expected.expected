-- input [data-role=pick] "ada"
<body>
  <div id="root">
    <div>
      <section>
        <button data-role="bump">"Bump"</button>
        <output data-role="bumped">"2"</output>
      </section>
      <section>
        <input type="text" data-role="pick" .value="ada">
        <output data-role="picked">"1"</output>
      </section>
      <section>
        <input type="text" data-role="say" .value="">
        <output data-role="said"></output>
      </section>
    </div>
  </div>
</body>
