-- element "root"
-- load
<body>
  <div id="root">
    <div>
      <section>
        <button data-role="bump">"Bump"</button>
        <output data-role="bumped">"0"</output>
      </section>
      <section>
        <input type="text" data-role="pick" .value="">
        <output data-role="picked">"0"</output>
      </section>
      <section>
        <input type="text" data-role="say" .value="">
        <output data-role="said"></output>
      </section>
    </div>
  </div>
</body>
-- click [data-role=bump]
<body>
  <div id="root">
    <div>
      <section>
        <button data-role="bump">"Bump"</button>
        <output data-role="bumped">"1"</output>
      </section>
      <section>
        <input type="text" data-role="pick" .value="">
        <output data-role="picked">"0"</output>
      </section>
      <section>
        <input type="text" data-role="say" .value="">
        <output data-role="said"></output>
      </section>
    </div>
  </div>
</body>
-- click [data-role=bump]
<body>
  <div id="root">
    <div>
      <section>
        <button data-role="bump">"Bump"</button>
        <output data-role="bumped">"2"</output>
      </section>
      <section>
        <input type="text" data-role="pick" .value="">
        <output data-role="picked">"0"</output>
      </section>
      <section>
        <input type="text" data-role="say" .value="">
        <output data-role="said"></output>
      </section>
