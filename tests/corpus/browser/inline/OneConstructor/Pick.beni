--! A count of the words typed, which `reset` clears: a literal under the
--! one constructor.

import Html exposing (Html)


pub type alias Model =
    count : Int


pub init : ⊤ → Model
init ⊤ = { count = 0 }


pub type Msg
    = Pick String


pub update : Msg, Model → Model
update msg model =
    case msg of
        Pick "reset" →
            { model | count = 0 }

        Pick _ →
            { model | count = model.count + 1 }


pub view : Model → Html Msg
view model =
    <section>
        <input type="text" data-role="pick" onInput={Pick} />
        <output data-role="picked">{model.count}</output>
    </section>
