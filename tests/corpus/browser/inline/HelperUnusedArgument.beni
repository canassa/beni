import Html exposing (Html)
import Tea


type Msg
    = Add


helper : Int → Html Msg
helper _ = <button onClick={Add}>static</button>


view : Int → Html Msg
view model = <main>{helper (Debug.log "argument" model)}<output>{model}</output></main>


update : Msg, Int → Int
update _ model = model + 1


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = update, view = view }
