    <section>
      <button id="inc">"inc"</button>
      <button id="pick">"pick"</button>
      <button id="add">"add"</button>
      <button id="faster">"faster"</button>
      <output id="count">"0"</output>
      <output id="step">"1"</output>
    </section>
  </main>
</body>
