--! A counter whose buttons are a helper's markup.

import Html exposing (Event, Html)


pub type alias Model =
    count : Int
    step : Int


pub type Msg
    = Inc
    | Add Int
    | Faster


pub update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }

        Add n →
            { model | count = model.count + n }

        Faster →
            { model | step = model.step * 2 }


pick : Event → Msg
pick _ = Inc


adder : Int → Html Msg
adder step = <button id="add" onClick={λ_ → Add step}>add</button>


pub view : Model → Html Msg
view model =
    <section>
        <button id="inc" onClick={Inc}>inc</button>
        <button id="pick" onClick={pick}>pick</button>
        {adder model.step}
        <button id="faster" onClick={Faster}>faster</button>
        <output id="count">{String.fromInt model.count}</output>
        <output id="step">{String.fromInt model.step}</output>
    </section>
