-- element "root"
-- load
<body>
  <div id="root">
    <div>
      <select .value="a">
        <optgroup>
          <option>"a"</option>
          <option>"b"</option>
        </optgroup>
        <hr>
        <option>"c"</option>
        <hr>
        <optgroup>
          <option>"d"</option>
        </optgroup>
        <option>"0"</option>
      </select>
      <button data-role="inc">"0"</button>
    </div>
  </div>
</body>
-- click [data-role=inc]
