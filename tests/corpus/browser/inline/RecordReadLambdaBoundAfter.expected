-- load
<body>
  <main>
    <button id="lam">"lam"</button>
    <button id="twice">"twice"</button>
    <button id="local">"local"</button>
    <button id="slept">"slept"</button>
    <p id="count">"0"</p>
    <p id="log"></p>
  </main>
</body>
-- click #lam
<body>
  <main>
    <button id="lam">"lam"</button>
    <button id="twice">"twice"</button>
    <button id="local">"local"</button>
    <button id="slept">"slept"</button>
    <p id="count">"2"</p>
    <p id="log">" | lam 1"</p>
  </main>
</body>
-- click #twice
<body>
  <main>
    <button id="lam">"lam"</button>
    <button id="twice">"twice"</button>
    <button id="local">"local"</button>
    <button id="slept">"slept"</button>
    <p id="count">"22"</p>
    <p id="log">" | lam 1 | before 12 | after 12 | m 12"</p>
  </main>
</body>
