<body>
  <main>
    <button id="pick9">"9"</button>
    <button id="unpick">"none"</button>
    <button id="pickedit">"3, and edit 1"</button>
    <button id="drop3">"drop 3"</button>
    <button id="cursor2">"cursor 2"</button>
    <ul>
      <li class="">
        <a id="pick1">"one"</a>
      </li>
      <li class="">
        <a id="pick2">"two"</a>
      </li>
      <li class="">
        <a id="pick3">"three"</a>
      </li>
      <li class="">
        <a id="pick2">"twin"</a>
      </li>
    </ul>
    <ol>
      <li class="at">"1"</li>
      <li class="">"2"</li>
      <li class="">"3"</li>
    </ol>
  </main>
</body>
