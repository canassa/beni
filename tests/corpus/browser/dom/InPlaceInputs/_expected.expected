-- load
<body>
  <main>
    <button id="change">"change"</button>
    <p id="list">"1"</p>
    <!---->
    <p id="record">"1"</p>
    <!---->
    <p id="wrapped">"10"</p>
    <!---->
    <p id="boxed">"10"</p>
    <!---->
    <p id="component">"2"</p>
    <ul id="captured-list">
      <li>"2"</li>
    </ul>
    <ul id="captured-record">
      <li>"2"</li>
    </ul>
    <p id="shown">"1"</p>
    <!---->
  </main>
</body>
