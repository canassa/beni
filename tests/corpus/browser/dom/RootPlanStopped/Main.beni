-- The release transcript omits the development crash screen.
-- A native clock drives the existing Bool root message; no task kernel is needed.
import Browser
import Controller
import Html exposing (Html)
import Rt


view : Int → Html Bool
view count =
    _ = Debug.log "paint" count
    <input id="root" />


main : Browser.Program
main =
    Browser.program
        { init =
            λ⊤ →
                Controller.schedule ⊤
                0
        , update =
            λ_ count →
                _ = Debug.log "update" count
                if count == 1 then Rt.protocolStop ⊤
                count + 1
        , view = view
        }
