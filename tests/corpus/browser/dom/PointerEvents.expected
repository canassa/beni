-- load
<body>
  <main>
    <div id="surface" style="position: absolute; left: 20px; top: 60px; width: 300px; height: 200px; touch-action: none">
      <ul>
        <li id="r1">"1"</li>
        <li id="r2">"2"</li>
      </ul>
    </div>
    <button id="track">"track"</button>
    <button id="add">"add"</button>
    <ol></ol>
  </main>
</body>
