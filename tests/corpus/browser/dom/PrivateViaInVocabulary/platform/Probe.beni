--! A payload extractor that is not `pub`, and the one markup that names it
--! is in this module (boundary.md §9.3, amended 2026-10-21). So the build
--! writes the extractor in the module that declares it, and imports
--! nothing for it.

import Html exposing (Html)


--| The event object the extractor is handed.
pub foreign type Event


--| The text, as a text hole shows it.
pub markup text : String → Html msg


--| The same markup, its messages passed through the function.
pub markup map : Html a, (a → b) → Html b


pub element "*"


pub attribute "*" : String


pub event "onProbe" name "probe" via probe : String


foreign impure probe : Event → String


--| A button whose handler takes the extractor's `String`.
pub button : Html String
button = <button id="box" onProbe={λvalue → value}>send</button>
