-- load
<body>
  <main>
    <button id="tick">"0"</button>
    <input id="text" .value="ab">
    <input id="free" .value="ab">
    <div>
      <input id="box" type="checkbox" .value="on" .checked=false>
    </div>
    <input id="ra" type="radio" name="g" .value="on" .checked=true>
    <input id="rb" type="radio" name="g" .value="on" .checked=false>
    <input id="rc" type="radio" name="g" .value="on" .checked=false>
    <select id="sel" .value="a">
      <option value="a">"a"</option>
      <option value="b">"b"</option>
      <option value="c">"c"</option>
    </select>
  </main>
</body>
