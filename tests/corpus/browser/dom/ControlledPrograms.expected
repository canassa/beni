-- load
<body>
  <main>
    <button id="outer-tick">"0"</button>
    <input id="outer-text" .value="outer">
    <div id="inner">
      <section>
        <button id="inner-tick">"0"</button>
        <input id="inner-text" .value="inner">
      </section>
    </div>
  </main>
</body>
