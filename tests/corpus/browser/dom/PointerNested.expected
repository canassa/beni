  <main>
    <div id="outer">
      <div id="inner">"inner"</div>
    </div>
    <div id="pad">
      <div id="knob">"knob"</div>
    </div>
    <button id="off" disabled="">"off"</button>
    <ol></ol>
  </main>
</body>
-- press #inner
(a later listener ran)
<body>
  <main>
    <div id="outer">
      <div id="inner">"inner"</div>
    </div>
    <div id="pad">
      <div id="knob">"knob"</div>
    </div>
    <button id="off" disabled="">"off"</button>
    <ol>
      <li>"inner pointerdown: n=1"</li>
      <li>"outer pointerdown: the handler saw n=0, the model has n=1"</li>
      <li>"outer mousedown: the handler saw n=1, the model has n=1"</li>
      <li>"inner pointerup: n=2"</li>
      <li>"outer pointerup: the handler saw n=1, the model has n=2"</li>
    </ol>
  </main>
</body>
