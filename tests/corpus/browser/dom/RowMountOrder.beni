-- Pin source evaluation order at mount and patch (language.md §6;
-- backend.md §15.5). Record rows are visited on every render under O3,
-- so their item-only values run again as well as their model inputs.
-- `#after` reads the model before the item; `#before` reverses that order;
-- `#toggled` includes a class toggle. Adding, marking and relabelling must
-- preserve that order and leave every unrelated DOM value unchanged.

import Browser
import Html exposing (Html)


type Msg
    = Add
    | Mark
    | Rename


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    mark : String


marked : Model, Row → String
marked model r = Debug.log "mark" "${model.mark}${String.fromInt r.id}"


named : String, Row → String
named list r = Debug.log "${list} label" r.label


update : Msg, Model → Model
update msg model =
    case msg of
        Add →
            { model | rows = model.rows ++ [ { id = 3, label = "c" } ] }

        Mark →
            { model | mark = "*" }

        Rename →
            { model
                | rows = List.map model.rows λr → if r.id == 1 then { r | label = "A" } else r
            }


view : Model → Html Msg
view model =
    <main>
        <button id="add" onClick={Add}>add</button>
        <button id="mark" onClick={Mark}>mark</button>
        <button id="rename" onClick={Rename}>rename</button>
        <ul id="after">
            <For each={model.rows} keyed={.id}>
                {λr → <li class={marked model r}>{named "after" r}</li>}
            </For>
        </ul>
        <ul id="before">
            <For each={model.rows} keyed={.id}>
                {λr → <li title={named "before" r} class={marked model r} />}
            </For>
        </ul>
        <ul id="toggled">
            <For each={model.rows} keyed={.id}>
                {λr →
                    <li class={[ ( "on", model.mark == "*" ) ]} title={marked model r}>
                        {named "toggled" r}
                    </li>
                }
            </For>
        </ul>
    </main>


main : Browser.Program
main =
    Browser.program
        { init = λ⊤ → { rows = [ { id = 1, label = "a" }, { id = 2, label = "b" } ], mark = "" }
        , update = update
        , view = view
        }
