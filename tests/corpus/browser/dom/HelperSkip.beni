-- A call of a top-level function in an `Html` hole is not made again while
-- every argument is the one the hole was given last render (language.md
-- §11.6, §11.11; backend.md §15.3–§15.4). `Debug.log` in each helper's
-- body shows which calls happen. `card "counted" model.count` is called
-- when the count changes, and inside it `tag "counted"`, whose argument
-- did not, is not; `card "fixed" 7` is never called again. A helper given
-- a record built during the render, and a local function, are called
-- when what they read changes — `model.other` — and only then: the root
-- computes each value by the fields it reads (language.md §11.11, made
-- precise 2026-10-04), so the record is not built again when only the
-- count changed, and the local function, which captures nothing, is the
-- same function.
import Browser
import Html exposing (Html)


type Msg
    = Count
    | Other


type alias Model =
    count : Int
    other : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Count →
            { model | count = model.count + 1 }

        Other →
            { model | other = model.other + 1 }


tag : String → Html Msg
tag name = <i>{Debug.log "tag" name}</i>


card : String, Int → Html Msg
card title n =
    <section>
        {tag title}
        <b>{Debug.log title n}</b>
    </section>


boxed : { n : Int } → Html Msg
boxed r = <p>{Debug.log "boxed" r.n}</p>


view : Model → Html Msg
view model =
    local : Int → Html Msg
    local n = <em>{Debug.log "local" n}</em>
    <main>
        <button id="count" onClick={Count}>count</button>
        <button id="other" onClick={Other}>other</button>
        {card "counted" model.count}
        {card "fixed" 7}
        {boxed { n = model.other }}
        {local model.other}
    </main>


main : Browser.Program
main = Browser.program { init = { count = 0, other = 0 }, update = update, view = view }
