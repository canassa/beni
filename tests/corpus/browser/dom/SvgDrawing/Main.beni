-- SVG in a page built by the `dom` lowering (boundary.md §9.9). Every
-- element inside the `<svg>` is in the SVG namespace — the page's parser
-- decides it from the template — and an `<a>` and a `<title>` there are
-- SVG's, while the `<p>` inside the `<foreignObject>` is HTML again (in
-- Chrome, `_expected.chrome-expected`: happy-dom's parser makes it SVG). An
-- attribute is an attribute, never a property: `viewBox` keeps its case,
-- `class` is the attribute an SVG element's `className` is not, and
-- `xlink:href` is in the XLink namespace. A hole in an SVG attribute is
-- written again when its value changes; a keyed `For` of `<rect>`s, each
-- row's template wrapped in an `<svg>` for its parser and taken out of it,
-- adds and moves rows; a click and a delegated `mouseover` on an SVG
-- element send their messages. A component written as a tag and the same
-- component called in a hole draw the same circle, and a value of several
-- SVG elements at its top level is parsed inside one `<svg>`.
import Browser
import Html exposing (Html)
import Shapes


type Msg
    = Move
    | Picked Int
    | Hovered Int
    | Grow


type alias Model =
    x : Int
    picked : Int
    hovered : Int
    bars : List Int


update : Msg, Model → Model
update msg model =
    case msg of
        Move →
            { model | x = model.x + 10 }

        Picked n →
            { model | picked = n }

        Hovered n →
            { model | hovered = n }

        Grow →
            { model | bars = [ model.picked + 5, …List.reverse model.bars ] }


pair : Html msg
pair =
    <>
        <line x1="0" y1="45" x2="10" y2="50" stroke="black" />
        <text x="12" y="49" font-size="3">pair</text>
    </>


bar : Int → Html Msg
bar n =
    <rect
        id="bar${String.fromInt n}"
        x={String.fromInt (n * 5)}
        y="20"
        width="4"
        height={String.fromInt n}
        onClick={Picked n}
        onMouseOver={Hovered n}
    />


view : Model → Html Msg
view model =
    <main>
        <svg id="pic" viewBox="0 0 100 50" width="100%" class={[ ( "moved", model.x > 0 ) ]}>
            <title>A drawing</title>
            <defs>
                <linearGradient id="fade" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="white" />
                    <stop offset="1" stop-color="black" />
                </linearGradient>
                <path id="tri" d="M0 0 L4 0 L2 3 Z" />
            </defs>
            <g transform="translate(1 1)" style="opacity:0.9">
                <rect
                    id="mover"
                    x={String.fromInt model.x}
                    y="2"
                    width="10"
                    height="5"
                    fill="url(#fade)"
                    stroke="red"
                    stroke-width="0.5"
                    onClick={Move}
                />
                <polyline points="0,0 5,5 10,0" fill="none" stroke-linecap="round" />
                <use href="#tri" x="20" xlink:href="#tri" />
                <a href="https://example.com/">
                    <text x="30" y="10" font-family="sans-serif">link</text>
                </a>
            </g>
            <g id="bars"><For each={model.bars} keyed={λn → n}>{bar}</For></g>
            <Shapes.dot cx="40" fill="blue" />
            {Shapes.dot { cx = "40", fill = "blue" }}
            {pair}
            <foreignObject x="60" y="0" width="40" height="20">
                <p id="html">picked {model.picked}</p>
            </foreignObject>
        </svg>
        <p id="hovered">hovered {model.hovered}</p>
        <button id="grow" onClick={Grow}>grow</button>
    </main>


main : Browser.Program
main =
    Browser.program
        { init = λ⊤ → { x = 0, picked = 0, hovered = 0, bars = [ 1, 2 ] }
        , update = update
        , view = view
        }
