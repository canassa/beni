-- load
<body>
  <main>
    <svg:svg id="pic" viewBox="0 0 100 50" width="100%">
      <svg:title>"A drawing"</svg:title>
      <svg:defs>
        <svg:linearGradient id="fade" gradientUnits="userSpaceOnUse">
          <svg:stop offset="0" stop-color="white"></svg:stop>
          <svg:stop offset="1" stop-color="black"></svg:stop>
        </svg:linearGradient>
        <svg:path id="tri" d="M0 0 L4 0 L2 3 Z"></svg:path>
      </svg:defs>
      <svg:g transform="translate(1 1)" style="opacity:0.9">
        <svg:rect id="mover" y="2" width="10" height="5" fill="url(#fade)" stroke="red" stroke-width="0.5" x="0"></svg:rect>
        <svg:polyline points="0,0 5,5 10,0" fill="none" stroke-linecap="round"></svg:polyline>
        <svg:use href="#tri" x="20" xlink:href="#tri"></svg:use>
        <svg:a href="https://example.com/">
          <svg:text x="30" y="10" font-family="sans-serif">"link"</svg:text>
        </svg:a>
      </svg:g>
      <svg:g id="bars">
        <svg:rect y="20" width="4" id="bar1" x="5" height="1"></svg:rect>
        <svg:rect y="20" width="4" id="bar2" x="10" height="2"></svg:rect>
      </svg:g>
      <svg:circle cy="40" r="2" cx="40" fill="blue"></svg:circle>
      <!---->
      <svg:circle cy="40" r="2" cx="40" fill="blue"></svg:circle>
      <!---->
      <svg:line x1="0" y1="45" x2="10" y2="50" stroke="black"></svg:line>
      <svg:text x="12" y="49" font-size="3">"pair"</svg:text>
      <svg:foreignObject x="60" y="0" width="40" height="20">
        <svg:p id="html">
          "picked "
          "0"
        </svg:p>
      </svg:foreignObject>
    </svg:svg>
    <p id="hovered">
      "hovered "
      "0"
    </p>
    <button id="grow">"grow"</button>
  </main>
</body>
-- click #mover
<body>
  <main>
    <svg:svg id="pic" viewBox="0 0 100 50" width="100%" class="moved">
      <svg:title>"A drawing"</svg:title>
      <svg:defs>
        <svg:linearGradient id="fade" gradientUnits="userSpaceOnUse">
          <svg:stop offset="0" stop-color="white"></svg:stop>
          <svg:stop offset="1" stop-color="black"></svg:stop>
        </svg:linearGradient>
        <svg:path id="tri" d="M0 0 L4 0 L2 3 Z"></svg:path>
      </svg:defs>
      <svg:g transform="translate(1 1)" style="opacity:0.9">
        <svg:rect id="mover" y="2" width="10" height="5" fill="url(#fade)" stroke="red" stroke-width="0.5" x="10"></svg:rect>
        <svg:polyline points="0,0 5,5 10,0" fill="none" stroke-linecap="round"></svg:polyline>
        <svg:use href="#tri" x="20" xlink:href="#tri"></svg:use>
        <svg:a href="https://example.com/">
          <svg:text x="30" y="10" font-family="sans-serif">"link"</svg:text>
        </svg:a>
      </svg:g>
      <svg:g id="bars">
        <svg:rect y="20" width="4" id="bar1" x="5" height="1"></svg:rect>
        <svg:rect y="20" width="4" id="bar2" x="10" height="2"></svg:rect>
      </svg:g>
      <svg:circle cy="40" r="2" cx="40" fill="blue"></svg:circle>
      <!---->
      <svg:circle cy="40" r="2" cx="40" fill="blue"></svg:circle>
      <!---->
      <svg:line x1="0" y1="45" x2="10" y2="50" stroke="black"></svg:line>
      <svg:text x="12" y="49" font-size="3">"pair"</svg:text>
      <svg:foreignObject x="60" y="0" width="40" height="20">
        <svg:p id="html">
          "picked "
          "0"
        </svg:p>
      </svg:foreignObject>
    </svg:svg>
    <p id="hovered">
      "hovered "
      "0"
    </p>
    <button id="grow">"grow"</button>
  </main>
</body>
