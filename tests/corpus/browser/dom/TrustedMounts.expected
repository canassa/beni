-- load
console.log: outer renders: "bumps 0, taps 0, frames 0"
console.log: inner renders: 0
<body>
  <main>
    <button id="bump">"bump"</button>
    <p>"bumps 0, taps 0, frames 0"</p>
    <div id="frame">
      <section id="inner">
        <div>
          <button id="inc">"inc"</button>
          <p>"0"</p>
        </div>
      </section>
    </div>
  </main>
</body>
