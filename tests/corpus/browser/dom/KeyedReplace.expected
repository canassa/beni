-- load
<body>
  <main>
    <button id="ends">"ends"</button>
    <button id="promote">"promote"</button>
    <button id="all">"all"</button>
    <button id="keep">"keep"</button>
    <ul id="only">
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
    </ul>
    <ol id="framed">
      <li>"first"</li>
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>"last"</li>
    </ol>
  </main>
</body>
