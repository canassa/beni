-- focus #only>li:nth-child(2)>input
<body>
  <main>
    <button id="ends">"ends"</button>
    <button id="promote">"promote"</button>
    <button id="all">"all"</button>
    <button id="keep">"keep"</button>
    <ul id="only">
      <li>
        <input .value="1">
        "a"
      </li>
      <li>
        <input .value="2" :focus>
        "b"
      </li>
      <li>
        <input .value="3">
        "c"
      </li>
    </ul>
    <ol id="framed">
      <li>"first"</li>
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="2">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>"last"</li>
    </ol>
  </main>
</body>
-- click #ends
<body>
  <main>
    <button id="ends">"ends"</button>
    <button id="promote">"promote"</button>
    <button id="all">"all"</button>
    <button id="keep">"keep"</button>
    <ul id="only">
      <li>
        <input .value="3">
        "c"
      </li>
      <li>
        <input .value="2" :focus>
        "b"
      </li>
      <li>
        <input .value="1">
        "a"
      </li>
    </ul>
    <ol id="framed">
      <li>"first"</li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>
        <input .value="2">
        "b"
      </li>
      <li>
        <input .value="">
        "a"
      </li>
      <li>"last"</li>
    </ol>
  </main>
</body>
