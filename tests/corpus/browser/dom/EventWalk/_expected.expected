-- load
console.log: view: 0
<body>
  <main>
    <div id="outer">
      <section id="mid">
        <p id="inner">
          <button id="deep">"deep"</button>
        </p>
      </section>
      <p id="free">
        <span id="bare">"bare"</span>
      </p>
      <fieldset id="off" disabled="">
        <span id="within">"within"</span>
      </fieldset>
      <button id="prevent">"prevent"</button>
      <button id="mapped">"mapped"</button>
    </div>
    <p id="renders">"0"</p>
    <ol></ol>
  </main>
</body>
