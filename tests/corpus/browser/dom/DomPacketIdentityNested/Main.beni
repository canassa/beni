-- The enclosing patch must carry identities needed by a nested packet.
-- Noop still calls render with a fresh packet and the same identity; the
-- log must not repeat. The browser corpus runs development and release.
import Browser
import Html exposing (Html)
import Probe


type Msg
    = Flip
    | Noop


type alias Model =
    float : Bool
    ticks : Int


render : (a → a) → Html Msg
render value =
    <main>
        <button id="flip" onClick={Flip}>flip</button>
        <button id="noop" onClick={Noop}>noop</button>
        <p>{<span>{Debug.log "identity patch" (Probe.describe value)}</span>}</p>
    </main>


view : Model → Html Msg
view model = if model.float then render floatIdentity else render intIdentity


intIdentity : Int → Int
intIdentity = Probe.identity


floatIdentity : Float → Float
floatIdentity = Probe.identity


update : Msg, Model → Model
update msg model =
    case msg of
        Flip →
            { model | float = not model.float }
        Noop →
            { model | ticks = model.ticks + 1 }


main : Browser.Program
main = Browser.program { init = λ⊤ → { float = False, ticks = 0 }, update = update, view = view }
