-- A chain of `let`s read only by markup, each read several times by the
-- next (backend.md §15.4, *The `let` rule*): which of them the root takes
-- is decided in one pass, linear in the declaration, so building this
-- page stays within a test's instruction budget, where deciding it by
-- repeated scans of every `let` against every other did not.
import Browser
import Html exposing (Html)


type Msg
    = Inc


update : Msg, Int → Int
update msg n = n + 1


view : Int → Html Msg
view n =
    a0 = n
    a1 = a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 + a0 - 15 * a0
