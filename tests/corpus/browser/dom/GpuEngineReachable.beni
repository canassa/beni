-- What a direct `browser` program can import of WebGPU today
-- (docs/design/webgpu.md §2.1; #2256): every module of its platform,
-- `Gpu.Engine` and `Gpu.Native` included, since a platform has no way to
-- keep one of its own modules from the program it is the top of. Their
-- signatures name `Js.Value`, which such a program cannot make, so it
-- reaches only what needs none: here the engine's count of open channels.
-- On `browser-tea`, which re-exports the public modules only, the import
-- is `unknown_module` (`build/bad/GpuEngineHiddenByTea`).
import Browser
import Gpu.Engine
import Html exposing (Html)


view : ⊤ → Html msg
view _ = <p>open channels {String.fromInt (Gpu.Engine.openChannelCount ⊤)}</p>


main : Browser.Program
main = Browser.program { init = λ⊤ → ⊤, update = λ_ m → m, view = view }
