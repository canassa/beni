-- load
<body>
  <main>
    <button id="rename">"rename"</button>
    <button id="next">"next"</button>
    <button id="flip">"flip"</button>
    <label>
      "Ada"
      <input id="by-key" .value="">
    </label>
    <!---->
    <label>
      "Ada"
      <input id="by-identity" .value="">
    </label>
    <div>
      <input id="left" .value="">
    </div>
  </main>
</body>
