-- A controlled input inside markup that is itself a value — in an `if`
-- hole, in a `let` of markup, or nested with a constant `value` — is put
-- back after a render as one at the top of the view is (backend.md §15.3,
-- *Controlled inputs*, amended 2026-10-08: the edit marks it, and the
-- render ends by putting marked controls back; before, every such input
-- was reconciled on every render, and the markup holding it patched). An
-- edit `update` rejects returns the model it was given, so nothing the
-- view reads has changed; the render still puts each input's value back.
import Browser
import Html exposing (Html)


type Msg
    = Typed String


type alias Model =
    text : String
    open : Bool


update : Msg, Model → Model
update msg m =
    case msg of
        Typed s →
            if String.length s > 3 then m else { m | text = s }


view : Model → Html Msg
view m =
    viaLet = <input id="let" value={m.text} onInput={Typed} />

    <main>
        <input id="top" value={m.text} onInput={Typed} />
        {if m.open then <input id="nested" value={m.text} onInput={Typed} /> else <span />}
        {viaLet}
        {if m.open then <input id="locked" value="locked" onInput={Typed} /> else <span />}
    </main>


main : Browser.Program
main = Browser.program { init = { text = "ab", open = True }, update = update, view = view }
