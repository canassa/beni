    <button id="insert">"insert"</button>
    <button id="replace">"replace"</button>
    <button id="edit">"edit"</button>
    <button id="copylast">"copy last"</button>
    <button id="copyfirst">"copy first"</button>
    <button id="dedupe">"dedupe"</button>
    <button id="flip">"flip"</button>
    <button id="twins">"twins"</button>
    <ul id="at">
      <li>
        <input .value="">
        "h"
        " at "
        "0"
        <!---->
      </li>
      <li>
        <input .value="5">
        "e"
        " at "
        "1"
        <!---->
      </li>
      <li>
        <input .value="4">
        "d"
        " at "
        "2"
        <!---->
      </li>
      <li>
        <input .value="2">
        "b"
        " at "
        "3"
        <!---->
      </li>
      <li>
        <input .value="1">
        "a!"
        " at "
        "4"
        <!---->
      </li>
    </ul>
    <ul id="drawn">
      <li>
        <input .value="">
        "h"
      </li>
      <li>
        <input .value="">
        "e"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
      <li>
        <input .value="2">
        "b"
      </li>
      <li class="done">"a!"</li>
    </ul>
    <ol id="framed">
      <li>"first"</li>
      <li>
        <input .value="">
        "h"
      </li>
      <li>
        <input .value="5">
        "e"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
      <li>
        <input .value="2">
        "b"
      </li>
      <li>
        <input .value="">
        "a!"
      </li>
      <li>"last"</li>
    </ol>
  </main>
</body>
