-- load
<body>
  <main>
    <button id="remove">"remove"</button>
    <button id="inner">"inner"</button>
    <button id="ends">"ends"</button>
    <button id="insert">"insert"</button>
    <button id="replace">"replace"</button>
    <button id="edit">"edit"</button>
    <button id="copylast">"copy last"</button>
    <button id="copyfirst">"copy first"</button>
    <button id="dedupe">"dedupe"</button>
    <button id="flip">"flip"</button>
    <button id="twins">"twins"</button>
    <ul id="at">
      <li>
        <input .value="">
        "a"
        " at "
        "0"
        <!---->
      </li>
      <li>
        <input .value="">
        "b"
        " at "
        "1"
        <!---->
      </li>
      <li>
        <input .value="">
        "c"
        " at "
        "2"
        <!---->
      </li>
      <li>
        <input .value="">
        "d"
        " at "
        "3"
        <!---->
      </li>
      <li>
        <input .value="">
        "e"
        " at "
        "4"
        <!---->
      </li>
      <li>
        <input .value="">
        "f"
        " at "
        "5"
        <!---->
      </li>
    </ul>
    <ul id="drawn">
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
      <li>
        <input .value="">
        "e"
      </li>
      <li>
        <input .value="">
        "f"
      </li>
    </ul>
    <ol id="framed">
      <li>"first"</li>
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
      <li>
        <input .value="">
        "e"
      </li>
      <li>
        <input .value="">
        "f"
      </li>
      <li>"last"</li>
    </ol>
  </main>
</body>
