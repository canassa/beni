-- load
<body>
  <main>
    <button id="flip">"flip"</button>
    <button id="noop">"noop"</button>
    <section id="item-type">
      <p>
        "Int"
        <input id="item-input" .value="">
      </p>
    </section>
    <!---->
    <section id="environment-type">
      <p>"1:Int"</p>
      <p>"2:Int"</p>
      <p>"3:Int"</p>
    </section>
    <!---->
    <section id="show-type">
      <p>
        "Int"
        <input id="show-input" .value="">
      </p>
    </section>
    <!---->
  </main>
</body>
