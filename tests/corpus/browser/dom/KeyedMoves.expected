-- load
<body>
  <main>
    <button id="swap">"swap"</button>
    <button id="dropb">"drop b"</button>
    <button id="adde">"add e"</button>
    <button id="droptwos">"drop twos"</button>
    <button id="addf">"add f"</button>
    <ul>
      <li>
        <input .value="">
        "a"
      </li>
      <li>
        <input .value="">
        "b"
      </li>
      <li>
        <input .value="">
        "c"
      </li>
      <li>
        <input .value="">
        "d"
      </li>
    </ul>
  </main>
</body>
