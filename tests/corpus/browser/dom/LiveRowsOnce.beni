-- A row that a render skips is not evaluated again, even when it is live
-- (backend.md §15.4, as amended after the third review). Each row holds
-- a controlled input and a helper's markup; a rejected edit is put back
-- by the reconcile that ends the render (§15.3, *Controlled inputs*,
-- amended 2026-10-08), and the row is never evaluated for it:
-- `Debug.log` in the row and in the helper prints only when that row's
-- item changed. A row the pass
-- patched is not restated after it, so an accepted edit prints its row
-- once, and a mount prints each row once. Both lists: keyed and by
-- position.
import Browser
import Html exposing (Html)


type Msg
    = Edit Int String
    | Tick


type alias Item =
    id : Int
    label : String


type alias Model =
    rows : List Item
    n : Int


update : Msg, Model → Model
update msg m =
    case msg of
        Edit id s →
            if String.length s > 3 then
                m
            else
                { m | rows = List.map m.rows λr → if r.id == id then { r | label = s } else r }

        Tick →
            { m | n = m.n + 1 }


cell : String → Html Msg
cell s = <b>{Debug.log "cell" s}</b>


view : Model → Html Msg
view m =
    <main>
        <button id="tick" onClick={Tick}>{m.n}</button>
        <For each={m.rows} keyed={.id}>
            {λr →
                <p>
                    {Debug.log "keyed" r.label}
                    <input id="k${String.fromInt r.id}" value={r.label} onInput={Edit r.id _} />
                    {cell r.label}
                </p>
            }
        </For>
        <For each={m.rows} keyed={False}>
            {λr →
                <p>
                    {Debug.log "position" r.label}
                    <input id="p${String.fromInt r.id}" value={r.label} onInput={Edit r.id _} />
                </p>
            }
        </For>
    </main>


main : Browser.Program
main =
    Browser.program
        { init = { rows = [ { id = 0, label = "a" }, { id = 1, label = "b" } ], n = 0 }
        , update = update
        , view = view
        }
