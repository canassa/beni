-- Each record row is evaluated once per render under backend.md §15.5
-- (O3), even when its reference is unchanged. A row already patched by the
-- pass is not evaluated a second time by restatement. Controlled inputs
-- reconcile rejected edits at render end; the helper's unchanged String
-- argument retains its scalar skip. Both keyed and positional lists pin
-- the same behaviour and unchanged DOM snapshots.

import Browser
import Html exposing (Html)


type Msg
    = Edit Int String
    | Tick


type alias Item =
    id : Int
    label : String


type alias Model =
    rows : List Item
    n : Int


update : Msg, Model → Model
update msg m =
    case msg of
        Edit id s →
            if String.length s > 3 then
                m
            else
                { m | rows = List.map m.rows λr → if r.id == id then { r | label = s } else r }

        Tick →
            { m | n = m.n + 1 }


cell : String → Html Msg
cell s = <b>{Debug.log "cell" s}</b>


view : Model → Html Msg
view m =
    <main>
        <button id="tick" onClick={Tick}>{m.n}</button>
        <For each={m.rows} keyed={.id}>
            {λr →
                <p>
                    {Debug.log "keyed" r.label}
                    <input id="k${String.fromInt r.id}" value={r.label} onInput={Edit r.id _} />
                    {cell r.label}
                </p>
            }
        </For>
        <For each={m.rows} keyed={False}>
            {λr →
                <p>
                    {Debug.log "position" r.label}
                    <input id="p${String.fromInt r.id}" value={r.label} onInput={Edit r.id _} />
                </p>
            }
        </For>
    </main>


main : Browser.Program
main =
    Browser.program
        { init = λ⊤ → { rows = [ { id = 0, label = "a" }, { id = 1, label = "b" } ], n = 0 }
        , update = update
        , view = view
        }
