-- The driver's `click` step (tests/corpus/README.md, `browser/`): each
-- modifier it names is held and its `button:<n>` is the event's `button`,
-- 0 by default; a click whose default a handler prevented logs `(click's
-- default prevented)`, and one whose default no handler prevented logs
-- nothing. The handler shows the four modifiers and the button of each
-- click it is handed.
import Browser
import Html exposing (Event, Html)
import Mouse


type Msg
    = Clicked String


describe : String, Event → Msg
describe name event =
    held =
        List.filterMap
            [ ( Html.ctrlKey event, "ctrl" )
            , ( Html.shiftKey event, "shift" )
            , ( Html.altKey event, "alt" )
            , ( Html.metaKey event, "meta" )
            ]
            λ( on, label ) →
                if on then
                    Just label
                else
                    Nothing

    shown = String.join held " "
    Clicked "${name}: [${shown}] button ${String.fromInt (Mouse.button event)}"


prevented : Event → Msg
prevented event =
    _ = Html.preventDefault event
    describe "prevented" event


view : List String → Html Msg
view lines =
    <main>
        <button id="plain" onClick={describe "plain" _}>plain</button>
        <button id="prevent" onClick={prevented}>prevent</button>
        <ol><For each={lines} keyed={False}>{λline → <li>{line}</li>}</For></ol>
    </main>


main : Browser.Program
main =
    Browser.program
        { init = []
        , update = λ(Clicked line) lines → lines ++ [ line ]
        , view = view
        }
