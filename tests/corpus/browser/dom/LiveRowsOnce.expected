-- load
console.log: keyed: "a"
console.log: cell: "a"
console.log: keyed: "b"
console.log: cell: "b"
console.log: position: "a"
console.log: position: "b"
<body>
  <main>
    <button id="tick">"0"</button>
    <p>
      "a"
      <input id="k0" .value="a">
      <b>"a"</b>
      <!---->
    </p>
    <p>
      "b"
      <input id="k1" .value="b">
      <b>"b"</b>
      <!---->
    </p>
    <!---->
    <p>
      "a"
      <input id="p0" .value="a">
    </p>
    <p>
      "b"
      <input id="p1" .value="b">
    </p>
    <!---->
  </main>
</body>
-- click #tick
