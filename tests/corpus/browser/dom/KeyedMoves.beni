-- A keyed `For` whose rows move while two items share a key (language.md
-- §11.9, backend.md §15.5): the key map is kept across renders that move
-- rows, and items that share a key are matched to rows by their rank among
-- them. The inputs are not controlled, so typed text shows which node is
-- where. A swap moves each row with its item, the two key-2 rows keeping
-- their order; removing the first key-2 item leaves its node gone and the
-- second item on the first key-2 row, by rank; a third key-2 item gets a
-- new row; with every key-2 item removed and one added back, the row is
-- new, not one the map kept.
import Browser
import Html exposing (Html)


type Msg
    = Swap
    | DropB
    | AddE
    | DropTwos
    | AddF


type alias Row =
    id : Int
    label : String


swap : List Row -> List Row
swap rows =
    case rows of
        [ first, ...rest ] ->
            case List.reverse rest of
                [ last, ...middle ] ->
                    [ last, ...List.reverse middle ++ [ first ] ]

                [] ->
                    rows

        [] ->
            rows


update : Msg, List Row -> List Row
update msg rows =
    case msg of
        Swap ->
            swap rows

        DropB ->
            List.filter rows (λrow -> row.label /= "b")

        AddE ->
            rows ++ [ { id = 2, label = "e" } ]

        DropTwos ->
            List.filter rows (λrow -> row.id /= 2)

        AddF ->
            [ { id = 2, label = "f" }, ...rows ]


view : List Row -> Html Msg
view rows =
    <main>
        <button id="swap" onClick={Swap}>swap</button>
        <button id="dropb" onClick={DropB}>drop b</button>
        <button id="adde" onClick={AddE}>add e</button>
        <button id="droptwos" onClick={DropTwos}>drop twos</button>
        <button id="addf" onClick={AddF}>add f</button>
        <ul>
            <For each={rows} keyed={.id}>
                {λrow -> <li><input />{row.label}</li>}
            </For>
        </ul>
    </main>


main : Browser.Program
main =
    Browser.program
        { init =
            [ { id = 1, label = "a" }
            , { id = 2, label = "b" }
            , { id = 2, label = "c" }
            , { id = 3, label = "d" }
            ]
        , update = update
        , view = view
        }
