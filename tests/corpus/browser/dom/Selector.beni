-- A selector (language.md §11.9, §11.11; backend.md §15.5): a row input
-- read only to compare with the row's own key. When the selection is all
-- that changed, only the rows whose key the old or the new selection is
-- run; `Debug.log` in each row's class shows which. The keyed list reads
-- `model.selected` through a helper, against `Just row.id`, with two rows
-- on key 2; the list keyed by reference compares `n /= model.cursor`.
-- Selecting the same id again runs no row, an id no row has runs only the
-- row that loses the class, and a selection with an edit in one render
-- runs the edited row and the two selections' rows.
import Browser
import Html exposing (Html)


type Msg
    = Pick Int
    | Unpick
    | PickAndEdit Int
    | Drop Int
    | Cursor Int


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    selected : Maybe Int
    cursor : Int
    ids : List Int


update : Msg, Model → Model
update msg model =
    case msg of
        Pick id →
            { model | selected = Just id }

        Unpick →
            { model | selected = Nothing }

        PickAndEdit id →
            { model
                | selected = Just id
                , rows =
                    List.map model.rows λrow →
                        if row.id == 1 then { row | label = "${row.label}!" } else row
            }

        Drop id →
            { model | rows = List.filter model.rows λrow → row.id ≠ id }

        Cursor n →
            { model | cursor = n }


rowClass : Model, Row → String
rowClass model row =
    Debug.log "row ${String.fromInt row.id}" (if model.selected == Just row.id then "on" else "")


view : Model → Html Msg
view model =
    <main>
        <button id="pick9" onClick={Pick 9}>9</button>
        <button id="unpick" onClick={Unpick}>none</button>
        <button id="pickedit" onClick={PickAndEdit 3}>3, and edit 1</button>
        <button id="drop3" onClick={Drop 3}>drop 3</button>
        <button id="cursor2" onClick={Cursor 2}>cursor 2</button>
        <ul>
            <For each={model.rows} keyed={.id}>
                {λrow →
                    <li class={rowClass model row}>
                        <a id="pick${String.fromInt row.id}" onClick={Pick row.id}>{row.label}</a>
                    </li>
                }
            </For>
        </ul>
        <ol>
            <For each={model.ids}>
                {λn →
                    <li
                        class={Debug.log
                                  "id ${String.fromInt n}"
                                  (if n ≠ model.cursor then "" else "at")
                              }
                    >
                        {n}
                    </li>
                }
            </For>
        </ol>
    </main>


main : Browser.Program
main =
    Browser.program
        { init =
            { rows =
                [ { id = 1, label = "one" }
                , { id = 2, label = "two" }
                , { id = 3, label = "three" }
                , { id = 2, label = "twin" }
                ]
            , selected = Nothing
            , cursor = 1
            , ids = [ 1, 2, 3 ]
            }
        , update = update
        , view = view
        }
