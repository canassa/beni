-- focus #draft
<body>
  <main>
    <ul>
      <li>
        <button id="b1">"1"</button>
      </li>
      <li>
        <button id="b2">"2"</button>
      </li>
      <li>
        <button id="b3">"3"</button>
      </li>
    </ul>
    <p>
      "picked "
      "2"
    </p>
    <input id="draft" .value="" :focus>
    <button id="leaf">"leaf"</button>
    <ol>
      <li>"focused"</li>
    </ol>
  </main>
</body>
