-- load
<body>
  <main>
    <button id="add">"add"</button>
    <ul id="keyed">
      <li>"1"</li>
      <li>"2"</li>
    </ul>
    <ul id="position">
      <li>"1"</li>
      <li>"2"</li>
    </ul>
    <p class="a">"2"</p>
    <output>"3"</output>
  </main>
</body>
