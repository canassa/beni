# A Reply kept in the state holds nothing: NoReply at once; a reply through
# it later is one warning line.
{"path": "/lobby/keep"}
{"path": "/lobby/late"}
# The last holder ends while the consumer is parked: NoReply comes then.
{"path": "/lobby/drop-fiber"}
# An unrelated fiber delays NoReply until it ends; it comes.
{"path": "/lobby/bg"}
{"path": "/lobby/drop"}
