-- workers: each request runs on a scheduler of its own (boundary.md §9.12
-- (d); transparent-effects-proposal.md §17.5). Two requests park on their
-- own timers at once and each answers in its own context when woken; a
-- fiber started with `Task.spawnDetached` runs after its answer under
-- `waitUntil`, and a later request reads what it wrote. Two requests of
-- one Miniflare share an isolate, which a program never relies on: the
-- shared cell is the test's device.
import Duration
import Ref exposing (Ref)
import String
import Task
import Worker exposing (Context, Request, Response)


main : Worker.Program
main = Worker.program { fetch = route, objects = [] }


seen : Ref String
seen = Ref.make "nothing yet"


route : Context, Request → Response
route ctx request =
    case String.split (Worker.path request) "/" of
        [ "", "slow", ms ] →
            case String.toInt ms of
                Just n →
                    Task.sleep (Duration.millis n)
                    Worker.text 200 "slept ${ms}"

                Nothing →
                    Worker.text 400 "not a number"

        [ "", "outlive" ] →
            -- Queued behind this handler's answer: it runs after the answer
            -- is given, in the same turn, so no step depends on a timer.
            _ = Task.spawnDetached λ⊤ → Ref.set seen "the detached fiber ran after the answer"
            Worker.text 200 "answered first"

        [ "", "seen" ] →
            Worker.text 200 (Ref.get seen)

        _ →
            Worker.text 404 "no such page"
