# Two requests in flight at once, each parked on its own timer: the shorter
# answers first, and each answers in its own context.
{"path": "/slow/40", "detach": "long"}
{"path": "/slow/10"}
{"answer": "long"}
# A fiber that runs after the answer, in the same turn: the next request
# reads what it wrote.
{"path": "/outlive"}
{"path": "/seen"}
# A fiber that parks after the answer is held under waitUntil until it
# ends; the hook counts the holds.
{"path": "/__beni/holds"}
{"path": "/outlive-gate"}
{"path": "/__beni/holds"}
{"path": "/release"}
{"path": "/__beni/holds"}
{"path": "/seen"}
