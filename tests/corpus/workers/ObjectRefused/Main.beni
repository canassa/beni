-- workers: the asks that are refused (boundary.md §9.12 (e.3), (e.10);
-- #594's `stub.fetch` half). The Scorer asking the Lobby back while the
-- Lobby waits on it is the refused cycle, 508 with `x-beni-cycle`, and
-- neither object hangs; a ref of the wrong protocol is `Unreadable`; and
-- a `Reply` printed for another object is `Unprintable`: the post is
-- dropped with one warning line, and the asker gets `NoReply`.
import Duration
import Schema exposing (Schema)
import String
import Task
import Worker exposing (Context, Request, Response)
import Worker.Object as Object exposing (Reply)


main : Worker.Program
main = Worker.program { fetch = route, objects = [ lobby, scorer ] }


-- The Scorer's protocol: an operation, its text, and the reply channel.
type alias ScorerMsg =
    op : String
    text : String
    reply : Reply String


toMsg ( ( ( ⊤, op ), text ), reply ) = { op = op, text = text, reply = reply }


fromMsg m = ( ( ( ⊤, m.op ), m.text ), m.reply )


scorerSchema : Schema { op : String, text : String, reply : String } ScorerMsg
scorerSchema =
    Schema.record
        (Schema.fields
            ▷ Schema.field "op" Schema.string
            ▷ Schema.field "text" Schema.string
            ▷ Schema.field "reply" (Object.replySchema Schema.string)
        )
        (Schema.mapping toMsg fromMsg)
        (Schema.mapping toMsg fromMsg)


-- The Lobby's protocol: a greeting with its reply channel.
type alias LobbyMsg =
    reply : Reply String


toHello ( ⊤, reply ) = { reply = reply }


fromHello m = ( ⊤, m.reply )


lobbySchema : Schema { reply : String } LobbyMsg
lobbySchema =
    Schema.record
        (Schema.fields ▷ Schema.field "reply" (Object.replySchema Schema.string))
        (Schema.mapping toHello fromHello)
        (Schema.mapping toHello fromHello)


-- ---- The Scorer ---------------------------------------------------------------

scorer : Worker.Definition
scorer = Object.define "Scorer" scorerSchema (λ_ → ⊤) { Object.none | received = scored }


scored : Object.Context ScorerMsg, ⊤, ScorerMsg → ⊤
scored ctx _ msg =
    case msg.op of
        "back" →
            -- The Lobby waits on this call: asking it back is the cycle.
            case Worker.objects (Object.env ctx) "LOBBIES" lobbySchema of
                Just lobbies →
                    Object.reply msg.reply
                        (showAsk
                            (Object.ask (Worker.byName lobbies "l") Schema.string λr → { reply = r }
                            )
                        )

                Nothing →
                    Object.reply msg.reply "no LOBBIES binding"

        _ →
            -- "keep": only ever posted with another object's `Reply`, which
            -- does not print: never received.
            ⊤


-- ---- The Lobby ----------------------------------------------------------------

lobby : Worker.Definition
lobby =
    Object.define "Lobby" lobbySchema (λ_ → ⊤)
        { Object.none | request = lobbyRequest, received = greeted }


greeted : Object.Context LobbyMsg, ⊤, LobbyMsg → ⊤
greeted ctx _ msg =
    -- A `Reply` printed for another object does not print: the post is
    -- dropped with one warning line, and the asker gets `NoReply`.
    case Worker.objects (Object.env ctx) "SCORERS" scorerSchema of
        Just scorers →
            Object.post (Worker.byName scorers "s") { op = "keep", text = "", reply = msg.reply }

        Nothing →
            ⊤


lobbyRequest : Object.Context LobbyMsg, ⊤, Request → ⊤ × Response
lobbyRequest ctx _ request =
    case
        ( Worker.objects (Object.env ctx) "SCORERS" scorerSchema
        , List.reverse (String.split (Worker.path request) "/")
        )
    of
        ( Just scorers, [ op, …rest ] ) →
            s = Worker.byName scorers "s"
            ( ⊤
            , Worker.text 200
                (case op of
                    "wrong" →
                        -- The Scorer's namespace with the Lobby's protocol:
                        -- the message does not parse there.
                        case Worker.objects (Object.env ctx) "SCORERS" lobbySchema of
                            Just wrong →
                                showAsk
                                    (Object.ask (Worker.byName wrong "s") Schema.string λr →
                                        { reply = r }
                                    )

                            Nothing →
                                "no SCORERS binding"

                    _ →
                        showAsk
                            (Object.ask s Schema.string λr →
                                { op = op, text = "seven!!", reply = r }
                            )
                )
            )

        _ →
            ( ⊤, Worker.text 404 "no such page" )


showAsk : Result Object.AskError String → String
showAsk result =
    case result of
        Ok text →
            "Ok ${text}"

        Err Object.Overloaded →
            "Err Overloaded"

        Err Object.Reset →
            "Err Reset"

        Err Object.Transient →
            "Err Transient"

        Err Object.Cycle →
            "Err Cycle"

        Err Object.NoReply →
            "Err NoReply"

        Err (Object.Unprintable _) →
            "Err Unprintable"

        Err (Object.Unreadable issues) →
            "Err Unreadable (${String.fromInt (List.length issues)} issue)"


-- ---- The Worker ---------------------------------------------------------------

route : Context, Request → Response
route ctx request =
    case
        ( Worker.objects (Worker.env ctx) "LOBBIES" lobbySchema
        , String.split (Worker.path request) "/"
        )
    of
        ( Just lobbies, [ "", "lobby", …rest ] ) →
            case Worker.forward (Worker.byName lobbies "l") request of
                Ok response →
                    response

                Err _ →
                    Worker.text 503 "the lobby is not available"

        ( Just lobbies, [ "", "hello" ] ) →
            -- An ask from the Worker itself.
            Worker.text
                200
                (showAsk (Object.ask (Worker.byName lobbies "l") Schema.string λr → { reply = r }))

        ( Nothing, _ ) →
            Worker.text 500 "no LOBBIES binding"

        _ →
            Worker.text 404 "no such page"
