-- ownership (project): `ChoiceArmsApart` with the callees in another module
-- (#1439, ownership-v2.md §2.11 item 3 *a choice's arms*): a call of an
-- imported writer reads a choice's arms apart exactly as a call of one of
-- this module, and keeps each arm's own refusals.
import Walk exposing (Pair, Rose)


pub levels : Bool → Rose
levels c =
    k = [ Rose [] ]
    Walk.incAll
        (if c then
            Rose [ Rose k ]
         else
            Rose [ Rose [ Rose k ] ]
        )


pub nested : Bool, Bool → Rose
nested c d =
    k = [ Rose [] ]
    Walk.incAll
        (if c then
            Rose [ Rose k ]
         else if d then
            Rose [ Rose [ Rose k ] ]
         else
            Rose [ Rose [ Rose [ Rose k ] ] ]
        )


pub field : Bool → Pair
field c =
    k = [ Rose [] ]
    Walk.incLeft
        { left =
            if c then
                Rose k
            else
                Rose [ Rose k ]
        , right = []
        }


pub sharedArm : Bool → Rose
sharedArm c =
    k = [ Rose [] ]
    Walk.incAll
        (if c then
            Rose [ Rose k, Rose [ Rose k ] ]
         else
            Rose [ Rose [ Rose k ] ]
        )


pub nestedShared : Bool, Bool → Rose
nestedShared c d =
    k = [ Rose [] ]
    Walk.incAll
        (if c then
            Rose [ Rose k ]
         else if d then
            Rose [ Rose [ Rose k ], Rose k ]
         else
            Rose [ Rose [ Rose [ Rose k ] ] ]
        )


pub fieldShared : Bool → Pair
fieldShared c =
    k = [ Rose [] ]
    Walk.incLeft
        { left =
            if c then
                Rose k
            else
                Rose []
        , right = k
        }


pub unionTwin : ⊤ → Rose
unionTwin ⊤ =
    k = [ Rose [] ]
    case [ Rose [ Rose k ], Rose [ Rose [ Rose k ] ] ] of
        [ r, …_ ] →
            Walk.incAll r

        [] →
            Rose []


-- Two leaves in one list of one arm, as in `ChoiceArmsApart`: accepted.
pub twoLeaves : Bool → Rose
twoLeaves d =
    Walk.incAll
        (if d then
            Rose []
         else
            Rose [ Rose [ Rose [], Rose [] ] ]
        )


pub leafBesideK : Bool → Rose
leafBesideK d =
    k = [ Rose [] ]
    Walk.incAll
        (if d then
            Rose []
         else
            Rose [ Rose [ Rose k, Rose [] ] ]
        )


pub leafBesideKTwice : Bool → Rose
leafBesideKTwice d =
    k = [ Rose [] ]
    Walk.incAll
        (if d then
            Rose []
         else
            Rose [ Rose [ Rose k, Rose [] ], Rose [] ]
        )


pub sameArms : Bool → Rose
sameArms c =
    k = [ Rose [] ]
    s0 = Rose [ Rose [], Rose k ]
    Walk.incAll
        (if c then
            Rose [ s0 ]
         else
            Rose [ s0 ]
        )
