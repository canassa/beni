-- ownership (project): see Main.beni. The callees of `PatternPositions`:
-- each answers a part of one position of its list and writes another's, or
-- takes the second position from a rest.
pub type Box
    = Box (List Int)


type Pair
    = Pair Box Box


pub type W
    = W Box Int


kidsBox : Box → List Int
kidsBox b =
    case b of
        Box xs →
            List.push xs 1


rightLeft : Pair → List Int × Box
rightLeft p =
    case p of
        Pair l r →
            ( kidsBox r, l )


sizeBox : Box → Int
sizeBox b =
    case b of
        Box xs →
            List.length xs


pub ctor : List W → Int × Int
ctor ws =
    case ws of
        [ W a _, W c _ ] →
            case rightLeft (Pair a c) of
                ( ys, l ) →
                    ( List.length ys, sizeBox l )

        _ →
            ( 0, 0 )


pub tuple : List (Box × Int) → Int × Int
tuple ws =
    case ws of
        [ ( a, _ ), ( c, _ ) ] →
            case rightLeft (Pair a c) of
                ( ys, l ) →
                    ( List.length ys, sizeBox l )

        _ →
            ( 0, 0 )


pub record : List { k : Box } → Int × Int
record ws =
    case ws of
        [ x, y ] →
            case rightLeft (Pair x.k y.k) of
                ( ys, l ) →
                    ( List.length ys, sizeBox l )

        _ →
            ( 0, 0 )


pub same : List W → Int × Int
same ws =
    case ws of
        [ W a _, _ ] →
            case rightLeft (Pair a a) of
                ( ys, l ) →
                    ( List.length ys, sizeBox l )

        _ →
            ( 0, 0 )


pub type alias Two =
    l : List Int
    m : List Int


type PairTwo
    = PairTwo Two Two


rightLeftTwo : PairTwo → List Int × Two
rightLeftTwo p =
    case p of
        PairTwo l r →
            ( List.push r.l 1, l )


pub crossed : List { k : Two } → Int
crossed ws =
    case ws of
        [ x, y ] →
            case rightLeftTwo (PairTwo x.k y.k) of
                ( ys, l ) →
                    List.length ys + List.length l.m

        _ →
            0


pub nested : List Box → Int × Int
nested bs =
    case bs of
        [ a, …rest ] →
            case rest of
                [ c ] →
                    case rightLeft (Pair a c) of
                        ( ys, l ) →
                            ( List.length ys, sizeBox l )

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub nestedSame : List Box → Int × Int
nestedSame bs =
    case bs of
        [ _, …rest ] →
            case rest of
                [ c ] →
                    case rightLeft (Pair c c) of
                        ( ys, l ) →
                            ( List.length ys, sizeBox l )

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub twoLevels : List Box → Int × Int
twoLevels bs =
    case bs of
        [ a, …r1 ] →
            case r1 of
                [ _, …r2 ] →
                    case r2 of
                        [ c ] →
                            case rightLeft (Pair a c) of
                                ( ys, l ) →
                                    ( List.length ys, sizeBox l )

                        _ →
                            ( 0, 0 )

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub twoLevelsInner : List Box → Int × Int
twoLevelsInner bs =
    case bs of
        [ _, …r1 ] →
            case r1 of
                [ a, …r2 ] →
                    case r2 of
                        [ c ] →
                            case rightLeft (Pair a c) of
                                ( ys, l ) →
                                    ( List.length ys, sizeBox l )

                        _ →
                            ( 0, 0 )

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub each : List W → Int
each ws =
    case ws of
        [ W a _, W c _ ] →
            List.length (kidsBox a) + List.length (kidsBox c)

        _ →
            0
