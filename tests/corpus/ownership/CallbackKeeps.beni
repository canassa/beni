-- CK-251: a callee kept a callback's result, then wrote the list it handed that callback.
-- ownership (§16.4's keep edge, issue #281): a callback's result may keep
-- what the callee handed it. `kParam` hands its callback `xs`, keeps the
-- result `t`, then pushes onto `xs`; with a callback that returns its
-- argument (`keepParam`, `keepCtor`, `keepOne`), `t` holds the list the
-- push changes, so the call is rejected `supply`, approximately — the
-- summary says that `kParam` uses `xs` after the call, not that the write
-- comes after. A callback that drops its argument is accepted
-- (`dropParam`). `kFresh` hands on a list it made itself and writes it
-- after: no caller sees that write, so `kFresh` itself is rejected. `wrap`
-- hands `kParam` its own function parameter, which must then return a
-- list it owns: `wrapKeep` is rejected `need`. Before, all were accepted,
-- and in place the kept result saw the push.
type Tree
    = Node (List Tree)
    | Leaf


type One
    = One (List One)


kParam : (List Int → List Int × Int), List Int → (List Int × Int) × List Int
kParam f xs =
    t = f xs
    ( t, List.push xs 9 )


kTree : (List Tree → Tree), List Tree, Tree → Tree × List Tree
kTree f xs y =
    t = f xs
    ( t, List.push xs y )


kOne : (List One → One), List One, One → One × List One
kOne f xs y =
    t = f xs
    ( t, List.push xs y )


kFresh : (List Int → List Int × Int) → (List Int × Int) × List Int
kFresh f =
    xs = [ 1 ]
    t = f xs
    ( t, List.push xs 9 )


wrap : (List Int → List Int × Int) → (List Int × Int) × List Int
wrap f = kParam f []


pub keepParam : ⊤ → (List Int × Int) × List Int
keepParam ⊤ = kParam (λys → ( ys, 1 )) []


pub dropParam : ⊤ → (List Int × Int) × List Int
dropParam ⊤ = kParam (λ_ → ( [], 1 )) []


pub keepCtor : ⊤ → Tree × List Tree
keepCtor ⊤ = kTree Node [] Leaf


pub keepOne : ⊤ → One × List One
keepOne ⊤ = kOne One [] (One [])


pub keepFresh : ⊤ → (List Int × Int) × List Int
keepFresh ⊤ = kFresh λys → ( ys, 1 )


pub wrapKeep : ⊤ → (List Int × Int) × List Int
wrapKeep ⊤ = wrap λys → ( ys, 1 )


pub wrapDrop : ⊤ → (List Int × Int) × List Int
wrapDrop ⊤ = wrap λ_ → ( [], 1 )


-- The list is changed by a second callback (`keepThenHand`): rejected
-- `supply` where the first callback keeps it, accepted where it drops it.
-- The callee returns the list it made beside the kept result
-- (`makeKeepReturn`): the supply keeps the list's fresh number, so the
-- caller that pushes onto the returned list while it holds the kept result
-- is rejected, and one that drops the kept result is not.
keepThenHand :
      (List Int → List Int × Int)
    , (List Int → List Int)
    , List Int
    → (List Int × Int) × List Int
keepThenHand f g xs =
    t = f xs
    ( t, g xs )


makeKeepReturn : (List Int → List Int × Int) → (List Int × Int) × List Int
makeKeepReturn f =
    xs = [ 1 ]
    t = f xs
    ( t, xs )


pub handKeep : ⊤ → (List Int × Int) × List Int
handKeep ⊤ = keepThenHand (λys → ( ys, 1 )) (λys → List.push ys 9) []


pub handDrop : ⊤ → (List Int × Int) × List Int
handDrop ⊤ = keepThenHand (λ_ → ( [], 1 )) (λys → List.push ys 9) []


pub returnKeep : ⊤ → (List Int × Int) × List Int
returnKeep ⊤ =
    ( kept, xs ) = makeKeepReturn λys → ( ys, 1 )
    ( kept, List.push xs 9 )


pub returnDrop : ⊤ → List Int
returnDrop ⊤ =
    ( _, xs ) = makeKeepReturn λys → ( ys, 1 )
    List.push xs 9


-- A callee that writes `xs` before handing it on and only reads it after
-- is refused too (`writeFirst`): the summary says that `xs` is used after
-- the call, not that the write is that use. A known over-rejection.
kBefore : (List Int → List Int × Int), List Int → (List Int × Int) × List Int
kBefore f xs =
    ys = List.push xs 9
    t = f ys
    ( t, ys )


pub writeFirst : ⊤ → (List Int × Int) × List Int
writeFirst ⊤ = kBefore (λys → ( ys, 1 )) []


-- Two made lists at one result path, the kept one made second
-- (`pickSecond`), or both as elements of the returned list (`inList`): the
-- supply's fresh number is renumbered as the result's is, so the caller
-- that writes the returned list while it holds the kept result is
-- rejected whichever list it gets.
pickSecond : Bool, (List Int → List Int × Int) → (List Int × Int) × List Int
pickSecond c f =
    a = [ 0 ]
    b = [ 1 ]
    t = f b
    ( t, if c then a else b )


inList : (List Int → List Int × Int) → (List Int × Int) × List (List Int)
inList f =
    a = [ 0 ]
    b = [ 1 ]
    t = f b
    ( t, [ a, b ] )


pub secondKeep : Bool → (List Int × Int) × List Int
secondKeep c =
    ( kept, xs ) = pickSecond c λys → ( ys, 1 )
    ( kept, List.push xs 9 )


pub listKeep : ⊤ → (List Int × Int) × List (List Int)
listKeep ⊤ =
    ( kept, xss ) = inList λys → ( ys, 1 )
    case xss of
        [ _, b ] →
            ( kept, [ List.push b 9 ] )
        _ →
            ( kept, xss )
