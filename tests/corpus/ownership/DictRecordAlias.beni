-- CK-270: one list in the record payloads at two dictionary keys (#474).
-- The callback builds a new record around the old record's list, edited
-- in place: rejected `exclusive` for `shared`. The folded tree accepted it, as it
-- does DictTupleAlias. `fresh` stores two distinct fresh lists and stays
-- accepted. Ordered storage (#294) refuses it.
import Dict exposing (Dict)


type alias P =
    items : List Int
    n : Int


grow : P → P
grow p = { items = List.push p.items 9, n = p.n }


pub shared : ⊤ → Dict Int P
shared ⊤ =
    xs = [ 1 ]
    d = Dict.insert (Dict.insert (Dict.empty ⊤) 1 { items = xs, n = 0 }) 2 { items = xs, n = 0 }
    Dict.update d 1 λm → Maybe.map m grow


pub fresh : ⊤ → Dict Int P
fresh ⊤ =
    d =
        Dict.insert (Dict.insert (Dict.empty ⊤) 1 { items = [ 1 ], n = 0 }) 2
            { items = [ 2 ], n = 0 }
    Dict.update d 1 λm → Maybe.map m grow
