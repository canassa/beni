-- ownership: the callers of `LevelLimit`'s `inline` and `two` (#1016's
-- comment of 2026-10-26). v1 refuses each body at its level limit, and v2
-- accepts them with no cap; what keeps them safe is the caller's check.
-- `inline xs xs` hands one list to both arguments: refused `disjoint`,
-- while two lists accept (`inlineDistinct`). `inline xs [ 1 ]` with `xs`
-- read again is refused `later-use`; not read again, it accepts
-- (`inlineOnce`). `two` over a tree holding one list at both levels it
-- touches is refused; distinct lists accept (`twoDistinct`).
type Tree
    = Leaf
    | Node Tree (List Int) Tree


inline : List Int, List Int → List Int × Int
inline a b =
    t = Node (Node (Node Leaf a Leaf) b Leaf) a Leaf
    case t of
        Node l xs _ →
            case l of
                Node _ ys _ →
                    ( List.push xs 1, List.length ys )

                Leaf →
                    ( [], 0 )

        Leaf →
            ( [], 0 )


two : Tree → List Int × List Int
two t =
    case t of
        Node (Node _ a (Node _ b _)) _ _ →
            ( List.push a 1, b )

        _ →
            ( [], [] )


pub inlineSame : List Int → List Int × Int
inlineSame xs = inline xs xs


pub inlineDistinct : List Int, List Int → List Int × Int
inlineDistinct xs ys = inline xs ys


pub inlineReadAgain : List Int → Int
inlineReadAgain xs =
    ( l, n ) = inline xs [ 1 ]
    List.length l + n + List.length xs


pub inlineOnce : List Int → Int
inlineOnce xs =
    ( l, n ) = inline xs [ 1 ]
    List.length l + n


pub twoShared : ⊤ → Int
twoShared ⊤ =
    xs = [ 1 ]
    ( l, _ ) = two (Node (Node Leaf xs (Node Leaf xs Leaf)) [] Leaf)
    List.length l


pub twoDistinct : ⊤ → Int
twoDistinct ⊤ =
    ( l, _ ) = two (Node (Node Leaf [ 1 ] (Node Leaf [ 2 ] Leaf)) [] Leaf)
    List.length l
