-- ownership (project): see Main.beni. The unannotated callees, whose
-- results sit at a type variable's place (#1350), and `inner`, which
-- projects one in this module.
pub pick r = r


pub ans r = r.b


pub ansU r = r.b


pub choose b l r =
    if b then
        l
    else
        r


pub inner g = List.length (pick g.x).c
