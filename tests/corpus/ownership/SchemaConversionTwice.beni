-- CK-247: a conversion whose forward returns one list at two places reads as two fresh lists.
-- ownership (§30.10, amended for issue #268): a run hands a conversion's
-- `forward` what it built, so the argument is no holder, and a list
-- `forward` makes is new — but `forward` may return either at two places,
-- and then two positions of the answer are one array. Such a schema's
-- decoding slot holds `⊤twice`, so a write onto its answer is rejected
-- `unknown`, approximately: the argument in a tuple (`tuple`), a record
-- (`record`), a list beside the list itself (`nested`), the library path
-- through `Schema.converted` (`library`), and a list `forward` makes
-- (`made`) or copies (`copied`) and returns twice. Before, each was
-- accepted `call`, and `List.push a 9` changed `b` too. The slot cannot
-- tell which list of the answer is the doubled one or whether the other
-- position is read again, so `single`, which drops the other position,
-- and `sibling`, which writes another field, are rejected as well. A
-- `forward` that returns its argument once beside a list it builds
-- (`once`) is accepted, and so is one that returns what a recursive
-- builder makes (`ranged`, `rangedPair`): `range` numbers its elements as
-- the list, but they are `Int`s, which hold no list.
import Schema exposing (Conversion)


type alias Both =
    all : List Int
    first : List Int


dup : Conversion (List Int) (List Int × List Int)
dup = Schema.conversion (λxs → Ok ( xs, xs )) λ( a, _ ) → Ok a


both : Conversion (List Int) Both
both = Schema.conversion (λxs → Ok { all = xs, first = xs }) λr → Ok r.all


nest : Conversion (List Int) (List Int × List (List Int))
nest = Schema.conversion (λxs → Ok ( xs, [ xs ] )) λ( a, _ ) → Ok a


dupHelper : List Int → List Int × List Int
dupHelper xs = ( xs, xs )


madeDup : Conversion (List Int) (List Int × List Int)
madeDup = Schema.conversion (λ_ → Ok (dupHelper [ 1 ])) λ( a, _ ) → Ok a


copyDup : Conversion (List Int) (List Int × List Int)
copyDup = Schema.conversion (λxs → Ok (dupHelper (List.copy xs))) λ( a, _ ) → Ok a


range : Int → List Int
range n = if n ≤ 0 then [] else List.push (range (n - 1)) n


oneRange : Conversion (List Int) (List Int)
oneRange = Schema.conversion (λ_ → Ok (range 3)) λ_ → Ok []


twoRanges : Conversion (List Int) (List Int × List Int)
twoRanges = Schema.conversion (λ_ → Ok ( range 3, range 2 )) λ( a, _ ) → Ok a


split : Conversion (List Int) (List Int × List Int)
split = Schema.conversion (λxs → Ok ( xs, List.reverse xs )) λ( a, _ ) → Ok a


schema Pair =
    items : List Int via dup


schema Rec =
    items : List Int via both


schema Nest =
    items : List Int via nest


schema Split =
    items : List Int via split


schema Ranged =
    items : List Int via oneRange


schema RangedPair =
    items : List Int via twoRanges


schema Made =
    items : List Int via madeDup


schema Copied =
    items : List Int via copyDup


schema PairBeside =
    items : List Int via dup
    other : List Int


pub tuple : String → List Int × List Int
tuple input =
    case Pair.parse input of
        Ok p →
            ( a, b ) = p.items
            ( List.push a 9, b )
        Err _ →
            ( [], [] )


pub record : String → List Int × List Int
record input =
    case Rec.parse input of
        Ok p →
            ( List.push p.items.all 9, p.items.first )
        Err _ →
            ( [], [] )


pub nested : String → List Int × List (List Int)
nested input =
    case Nest.parse input of
        Ok p →
            ( a, bs ) = p.items
            ( List.push a 9, bs )
        Err _ →
            ( [], [] )


pub library : String → List Int × List Int
library input =
    case Schema.parse (Schema.converted (Schema.list Schema.int) dup) input of
        Ok ( a, b ) →
            ( List.push a 9, b )
        Err _ →
            ( [], [] )


pub single : String → List Int
single input =
    case Pair.parse input of
        Ok p →
            ( a, _ ) = p.items
            List.push a 9
        Err _ →
            []


pub once : String → List Int × List Int
once input =
    case Split.parse input of
        Ok p →
            ( a, b ) = p.items
            ( List.push a 9, b )
        Err _ →
            ( [], [] )


pub made : String → List Int × List Int
made input =
    case Made.parse input of
        Ok p →
            ( a, b ) = p.items
            ( List.push a 9, b )
        Err _ →
            ( [], [] )


pub copied : String → List Int × List Int
copied input =
    case Copied.parse input of
        Ok p →
            ( a, b ) = p.items
            ( List.push a 9, b )
        Err _ →
            ( [], [] )


pub sibling : String → List Int
sibling input =
    case PairBeside.parse input of
        Ok p →
            List.push p.other 9
        Err _ →
            []


pub ranged : String → List Int
ranged input =
    case Ranged.parse input of
        Ok p →
            List.push p.items 9
        Err _ →
            []


pub rangedPair : String → List Int × List Int
rangedPair input =
    case RangedPair.parse input of
        Ok p →
            ( a, b ) = p.items
            ( List.push a 9, b )
        Err _ →
            ( [], [] )
