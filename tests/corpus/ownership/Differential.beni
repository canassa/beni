-- ownership: the programs of thesis Table 6.2 that the Lean reference model
-- (`proofs/ownership/Ownership/Fixtures.lean`) also runs, beside its
-- verdicts (`ownership-checker.md` §16.13; research 76 §6). Where the two
-- disagree, the line says why.
--
-- T1 fold alias: rejected (Lean: rejected) — the accumulator and the list
-- are one array. T2: accepted (Lean: accepted) — the length is read before
-- the write. T3: rejected (Lean: rejected) — a top-level list. T10:
-- rejected (Lean: rejected) — one list at two fields of one element. T14:
-- accepted (Lean: accepted) — each call of `init` makes its lists. T33:
-- since a prepend copies (`ownership-checker.md` §25.2), the kept version
-- and the copied one are both accepted; the Lean model has no prepend and
-- runs T33 projected onto a push (`retained`), which `t33Pushed` is: the
-- kept version rejected, the copied one accepted (Lean: the same).
-- T52: both accepted. The model runs T52 projected onto `filter`'s
-- identity promise ("T52 spine identity projection", rejected) and onto a
-- copy (accepted); the owner dropped the promise on 2026-10-13
-- (`ownership-checker.md` §27), so `filter` is a fresh list and `t52` is
-- now the copy's projection, which the model accepts too.
--
-- T40, T42 and T57 edit an element in place through `List.update` or
-- `List.map`, whose summaries are inferred over the focus and traversal
-- primitives (§18.5): the element is handed out owned, and the edit relies
-- on the list being exclusive, which each function states as `xreq` and its
-- callers discharge. As in the Lean model, the distinct forms are accepted
-- (`t40Distinct`, `t42Distinct`, `t57Distinct`) and the repeated ones
-- rejected, `exclusive` (`t42Repeated`, `t57Repeated`, `t57RepeatedRows`;
-- T10 is the record-shape one). No program here disagrees with the model.
type alias Row =
    id : Int
    tags : List Int


empty : List Int
empty = []


addOne : List Int → List Int
addOne l = [ …l, 1 ]


init : ⊤ → { todos : List Int }
init ⊤ = { todos = [] }


pub t1 : List Int → List Int
t1 xs = List.foldl xs xs λx acc → List.insertAt acc 0 x


pub t2 : List Int → Int
t2 xs =
    n = List.length xs
    List.length [ …xs, 1 ] + n


pub t3 : ⊤ → List Int × List Int
t3 ⊤ = ( addOne empty, addOne empty )


pub t10 : List Int → List { a : List Int, b : List Int }
t10 xs =
    rows = [ { a = xs, b = xs } ]
    List.update rows 0 λr → { r | a = [ …r.a, 2 ] }


pub t14 : ⊤ → Int
t14 ⊤ =
    a = init ⊤
    b = init ⊤
    List.length [ …a.todos, 1 ] + List.length b.todos


pub t33 : List Int → Int
t33 s =
    kept = s
    top = [ 0, …s ]
    copied = List.copy s
    top2 = [ 0, …copied ]
    List.length top + List.length top2 + List.length kept


pub t33Pushed : List Int → Int
t33Pushed s =
    kept = s
    top = [ …s, 0 ]
    copied = List.copy kept
    top2 = [ …copied, 0 ]
    List.length top + List.length top2 + List.length kept


pub t40 : List Row, Int, Int → List Row
t40 rows i t = List.update rows i λr → { r | tags = [ …r.tags, t ] }


pub t40Distinct : ⊤ → Int
t40Distinct ⊤ = List.length (t40 [ { id = 1, tags = [ 1 ] }, { id = 2, tags = [ 2 ] } ] 0 3)


pub t42 : List Row, Int, Int → List Row
t42 cards id t = List.map cards λc →
    if c.id == id then
        { c | tags = [ …c.tags, t ] }
    else
        c


pub t42Distinct : ⊤ → Int
t42Distinct ⊤ = List.length (t42 [ { id = 1, tags = [ 1 ] }, { id = 0, tags = [ 2 ] } ] 1 3)


pub t42Repeated : ⊤ → Int
t42Repeated ⊤ =
    tags = [ 1 ]
    List.length (t42 [ { id = 1, tags = tags }, { id = 0, tags = tags } ] 1 3)


pub t52 : List Int, Int → Int
t52 all x =
    visible = List.filter all λy → y > 0
    grown = [ …all, x ]
    List.length grown + List.length visible


pub t52Copied : List Int, Int → Int
t52Copied all x =
    visible = List.copy (List.filter all λy → y > 0)
    grown = [ …all, x ]
    List.length grown + List.length visible


pub t57 : List (List (List Int)), Int → List (List (List Int))
t57 rows i = List.update rows i λrow →
    case row of
        [] →
            []

        [ r, …rest ] →
            [ [ …r, 0 ], …rest ]


pub t57Distinct : ⊤ → Int
t57Distinct ⊤ = List.length (t57 [ [ [ 1 ], [ 2 ] ] ] 0)


pub t57Repeated : ⊤ → Int
t57Repeated ⊤ =
    r = [ 1 ]
    List.length (t57 [ [ r, r ] ] 0)


pub t57RepeatedRows : ⊤ → Int
t57RepeatedRows ⊤ =
    row = [ [ 1 ], [ 2 ] ]
    List.length (t57 [ row, row ] 0)
