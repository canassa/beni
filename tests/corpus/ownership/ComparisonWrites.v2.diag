[{"code":"comparison_changes_value","severity":"error","span":{"file":"tests/corpus/ownership/ComparisonWrites.beni","start":{"line":14,"col":31},"end":{"line":14,"col":40}},"title":"COMPARISON CHANGES A VALUE","message":"List.push a is refused: comparison: a type's `eq` and `compare` may only read\nthe values they are handed\n\nThis is a rule of the language: `==` and `<` call a type's `eq` and `compare`,\nwhich only read. Change a copy (`List.copy`)."},{"code":"comparison_changes_value","severity":"error","span":{"file":"tests/corpus/ownership/ComparisonWrites.beni","start":{"line":23,"col":21},"end":{"line":23,"col":25}},"title":"COMPARISON CHANGES A VALUE","message":"ComparisonWrites.grow a is refused: comparison: a type's `eq` and `compare` may\nonly read the values they are handed\n\nThis is a rule of the language: `==` and `<` call a type's `eq` and `compare`,\nwhich only read. Change a copy (`List.copy`)."}]
