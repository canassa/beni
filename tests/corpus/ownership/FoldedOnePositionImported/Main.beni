-- ownership (project): `FoldedOnePosition` with the writer in another
-- module (#1253's review). The imported `writeLL` publishes its write at
-- `π1#Node.0⟲#Node.1` with no `excl`, so each actual that puts one list at
-- two positions of that path is refused at the call, and `apart` is
-- accepted, as in the single-module fixture.
import Walk exposing (Leaf, Node, Tree)


pub same : Tree
same =
    s = Node Leaf [ 1 ] Leaf
    Walk.writeLL (Node (Node s [ 2 ] s) [] Leaf)


pub param : List Int → Tree
param q =
    s = Node Leaf q Leaf
    Walk.writeLL (Node (Node s [ 2 ] s) [] Leaf)


pub twoNodes : List Int → Tree
twoNodes q = Walk.writeLL (Node (Node (Node Leaf q Leaf) [ 2 ] (Node Leaf q Leaf)) [] Leaf)


pub projected : Tree
projected =
    l = Node Leaf [ 3 ] Leaf
    case l of
        Node _ ys _ →
            Walk.writeLL (Node (Node (Node Leaf ys Leaf) [ 2 ] l) [] Leaf)

        Leaf →
            Leaf


pub apart : Tree
apart = Walk.writeLL (Node (Node (Node Leaf [ 1 ] Leaf) [ 2 ] (Node Leaf [ 3 ] Leaf)) [] Leaf)
