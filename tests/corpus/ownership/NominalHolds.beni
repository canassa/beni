-- CK-238: a custom type is taken to hold anything, so a list of functions meets a write.
-- ownership (§30.9): whether a value of a custom type may hold an object
-- of another type is read off its constructors' fields, as written, not
-- assumed of every type that holds anything. A call of a function value
-- with no class may return any cell its callee captured, of a type its
-- result could hold. In `held`, `result` is such a call's `Validation`,
-- live while the list of validators it captured is pushed onto: a
-- `Validation` holds a `List (String × String)`, never a list of
-- functions, so `result` is not a holder of that list and the push is
-- accepted (before rule 4 it was rejected `call`, approximately).
-- `heldLists` is its twin, whose result's type can be the written list's,
-- and is rejected `call`. `bench/corpus`'s applicative chain, `check`:
-- `andMap` appends its errors in place, and since §30.10 (issue #216) the
-- errors each step hands it are what a function the checker cannot
-- identify returned (`(firstOf [ … ]) "a" a`), `⊤call`, so each write is
-- rejected `unknown`, approximately — the checker's limit, issue #223.
-- `twice` hands `andMap` one error list as both operands, and is
-- rejected: real sharing the text shows.
pub type Validation a
    = Valid a
    | Invalid (List (String × String))


pub andMap : Validation (a → b), Validation a → Validation b
andMap function value =
    case ( function, value ) of
        ( Valid f, Valid a ) →
            Valid (f a)

        ( Invalid errors, Valid _ ) →
            Invalid errors

        ( Valid _, Invalid errors ) →
            Invalid errors

        ( Invalid left, Invalid right ) →
            Invalid (left ++ right)


required : String, String → Validation String
required field value =
    if String.isEmpty value then
        Invalid [ ( field, "is required" ) ]
    else
        Valid value


firstOf : List (String, String → Validation String) → (String, String → Validation String)
firstOf validators =
    λfield value →
        case validators of
            [] →
                Valid value

            [ validator, …rest ] →
                case validator field value of
                    Valid v →
                        (firstOf rest) field v

                    invalid →
                        invalid


pub check : String, String → Validation (String × String)
check a b =
    Valid (λx → λy → λz → ( x, y ))
        ▷ andMap ((firstOf [ required ]) "a" a)
        ▷ andMap ((firstOf [ required ]) "b" b)
        ▷ andMap ((firstOf [ required ]) "c" b)


pub twice : ⊤ → Validation String
twice ⊤ =
    errors = [ ( "a", "is required" ) ]
    andMap (Invalid errors) (Invalid errors)


pub held : String → List (String, String → Validation String) × Validation String
held a =
    validators = [ required ]
    result = (firstOf validators) "a" a
    ( List.push validators required, result )


pub heldLists : List (List Int → List Int), List Int → List Int × List Int
heldLists fs xs =
    case fs of
        [ f, …_ ] →
            result = f xs
            ( List.push xs 1, result )

        [] →
            ( xs, xs )
