-- ownership: a later callee's writes, by field (`ownership-v2.md` §2.8,
-- *a later callee's writes, by field*; R-4.8.2, R-4.8.5). `pokeB` pushes
-- onto the list at the field `b` of its record. After an update of `a`,
-- a call `pokeB m` reaches its list through the untouched field `b`: no
-- use of the old record (`untouched`). After an update of `b`, the same
-- call reads the written field to reach the list: a whole use, and the
-- update is refused (`written`). `setC` updates another field of the old
-- record: an update of the old record is a whole use (`another`).
type alias Inner =
    n : Int


type alias M =
    a : Int
    b : List Int
    c : Inner


pokeB : M → List Int
pokeB m = List.push m.b 1


setC : M → M
setC m = { m | c = { n = 2 } }


pub untouched : M → Int × List Int
untouched m =
    n = { m | a = 1 }
    ( n.a, pokeB m )


pub written : M → Int × List Int
written m =
    n = { m | b = [] }
    ( n.a, pokeB m )


pub another : M → Int × M
another m =
    n = { m | a = 1 }
    ( n.a, setC m )
