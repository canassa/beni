-- ownership: a write to each child of a recursive constructor's child
-- (ownership-v2.md §2.2 *Parts*, #1422). `a` of `QN a b c d` is a level
-- below the matched node; `h a` writes `a`'s four children at
-- `π1#QN.k#QL.0`, and `a` projected by each `#QN.k` is the one part
-- `part a·⟲`: two paths folding through one leaf, owed as `excl` of the
-- canonical cell as a parameter's is, not one object at two paths. `f`
-- is accepted and owes `excl π1#QN.k⟲#QL.0`. Refused: `fTwice` writes `a`
-- twice, `fSame` hands `a` at two children of one argument, and a caller
-- whose grandchildren share one list.
type Q
    = QN Q Q Q Q
    | QL (List Int)


g : Q → Q
g q =
    case q of
        QN _ _ _ _ →
            QL []

        QL xs →
            QL (List.push xs 1)


h : Q → Q
h q =
    case q of
        QN a b c d →
            QN (g a) (g b) (g c) (g d)

        QL xs →
            QL xs


pub f : Q → Q
f q =
    case q of
        QN a b c d →
            QN (h a) (h b) (h c) (h d)

        QL xs →
            QL (List.push xs 1)


pub fTwice : Q → Q
fTwice q =
    case q of
        QN a _ c d →
            QN (h a) (h a) (h c) (h d)

        QL xs →
            QL xs


pub fSame : Q → Q
fSame q =
    case q of
        QN a _ _ _ →
            h (QN a a (QL []) (QL []))

        QL xs →
            QL xs


pub fShared : ⊤ → Q
fShared ⊤ =
    l = QL [ 1 ]
    f (QN (QN l l l l) (QL []) (QL []) (QL []))


pub fDistinct : ⊤ → Q
fDistinct ⊤ = f (QN (QN (QL [ 1 ]) (QL [ 2 ]) (QL [ 3 ]) (QL [ 4 ])) (QL []) (QL []) (QL []))
