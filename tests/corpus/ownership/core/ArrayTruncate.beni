-- Truncation is a storage write and cannot edit an array with a later alias.
import Browser.Host.Array as Array


pub shrink : Array.Array Int → ⊤
shrink array = Array.rendererTruncate array 0


pub retained : Array.Array Int → Int
retained array =
    Array.rendererTruncate array 0
    Array.size array


pub read : Array.Array Int, Int → Int
read array index = Array.rendererAt array index


pub present : Array.Array a, Int → Bool
present array index = Array.rendererHas array index
