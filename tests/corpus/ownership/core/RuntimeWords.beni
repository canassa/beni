-- Core scheduling now uses typed native operations. These registrations
-- retain callbacks and must keep captured lists shared after the call.
import Browser.Host.Date
import Browser.Host.Immediate
import Browser.Host.Math
import Browser.Host.Timers
import Js.Runtime
import List


micro xs =
    Browser.Host.Timers.queueMicrotask λ⊤ →
        _ = List.push xs 1
        ⊤
    List.push xs 2


macro xs =
    _ = Browser.Host.Immediate.trySchedule λ⊤ →
        _ = List.push xs 1
        ⊤
    List.push xs 2


timer xs =
    _ =
        Browser.Host.Timers.start
            (λ⊤ →
                _ = List.push xs 1
                ⊤
            )
            1
    List.push xs 2


-- Scalar native adapters have no mutable payload or unsafe stronger word.
scalar ⊤ =
    _ = Browser.Host.Date.now ⊤
    _ = Browser.Host.Math.random ⊤
    Js.Runtime.defect "done"
