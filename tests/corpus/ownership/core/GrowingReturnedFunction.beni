-- The raw type-growing function bridge is pinned as HostFreeGrowingReturnedFunction.
-- GrowingCast keeps the permitted data-growth control; this typed callback
-- preserves fresh outer results, captured aliases and unknown alternatives.
import Js


pub build : Int, List Int → (List (List Int) → Js.Value)
build n x =
    if n == 0 then
        λy → Js.from [ [ x ], y ]
    else
        build (n - 1) x


pub outer : List Int → List (List (List Int)) × List Int
outer xs =
    f : List (List Int) → Js.Value
    f = build 1 xs
    decoded : List (List (List Int))
    decoded = Js.to (f [ [] ])
    ( List.push decoded [], xs )


pub shared : List Int → List Int × List Int
shared xs =
    f : List (List Int) → Js.Value
    f = build 1 xs
    decoded : List (List (List Int))
    decoded = Js.to (f [ [] ])
    case decoded of
        [ [ ys ], _ ] →
            ( List.push ys 1, xs )
        _ →
            ( [], xs )


-- A known root on one branch cannot hide an unknown callable alternative.
pub mixed : Bool, (List (List Int) → Js.Value), List Int → List (List (List Int)) × List Int
mixed known host xs =
    encoded =
        if known then
            build 1 xs
        else
            host
    f : List (List Int) → Js.Value
    f = encoded
    decoded : List (List (List Int))
    decoded = Js.to (f [ [] ])
    ( List.push decoded [], xs )
