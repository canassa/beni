-- ownership (core): a word on a parameter whose declared type is a bare type
-- variable applies at every depth (`ownership-v2.md` §2.13.6, #1105). `ys`
-- holds `xs` at `ys[*]`, and `look` and `Js.from` may read all of `ys`, so
-- the edit of `xs` before them is refused, as v1 refuses it.
import Js


pub foreign pure look : borrowed a → Int


heldIntoVar : List Int → List Int
heldIntoVar xs =
    ys = [ xs ]
    zs = [ …xs, 1 ]
    [ look ys, …zs ]


heldIntoFrom : List Int → Js.Value
heldIntoFrom xs =
    ys = [ xs ]
    zs = [ …xs, 1 ]
    Js.array [ Js.from ys, Js.from zs ]


-- A `List a` parameter is not a bare variable: `borrowed` reads its `ε`.
pub foreign pure size : borrowed List a → Int


sizeAfter : List (List Int) → Int
sizeAfter rows =
    case rows of
        [ r, …_ ] →
            List.length [ …r, 0 ] + size rows

        _ →
            0


-- An alias that expands to a bare variable is one: `borrowed Id a` reads
-- all of `ys` too.
type alias Id a =
    a


pub foreign pure lookId : borrowed Id a → Int


heldIntoAlias : List Int → List Int
heldIntoAlias xs =
    ys = [ xs ]
    zs = [ …xs, 1 ]
    [ lookId ys, …zs ]


-- A beni wrapper over `look`: its call is not built until S3b (its
-- `.v2.unchecked` line), where it must be refused as v1 refuses it.
wrap : a → Int
wrap x = look x


viaWrap : List Int → List Int
viaWrap xs =
    ys = [ xs ]
    zs = [ …xs, 1 ]
    [ wrap ys, …zs ]


fromWrap : a → Js.Value
fromWrap x = Js.from x


viaFromWrap : List Int → Js.Value
viaFromWrap xs =
    ys = [ xs ]
    zs = [ …xs, 1 ]
    Js.array [ fromWrap ys, Js.from zs ]
