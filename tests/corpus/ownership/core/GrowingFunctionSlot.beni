import Js
import Js.Any as Any


pub loop : Int, a, Any.Any → Js.Value
loop n value host =
    reader =
        case read host of
            Just found →
                found
            Nothing →
                { f = λ_ → Js.null }
    if n == 0 then
        reader.f value
    else
        loop (n - 1) [ value ] host


-- A closed substitution cannot grow the type vocabulary.
pub constant : Int, a → Js.Value
constant n value =
    if n == 0 then
        Js.from [ value ]
    else
        constant (n - 1) [ 0 ]


read : Any.Any → Maybe { f : a → Js.Value }
read packet = Any.unpack packet
