pub nested : List Int → List N
nested xs =
    s = { s0 = xs, s1 = xs, s2 = xs, s3 = xs, s4 = xs, s5 = xs, s6 = xs, s7 = xs }
    r = { r0 = s, r1 = s, r2 = s, r3 = s, r4 = s, r5 = s, r6 = s, r7 = s, r8 = s, r9 = s }
    [ r, r ]
