-- ownership: the browser entry protocol and key aliases (§24.8).
-- Html.Event and Html.Pointer now retain typed native event handles;
-- this fixture assumes no explicit crossing word on either declaration.
-- Keyboard and pointer updates still exercise message payload analysis
-- and the entry model protocol through the public event projections.
-- A keyed command built and dropped leaves its key list unescaped,
-- while a command returned to its caller keeps the key alias alive.
-- The two key cases below continue to pin both directions.
-- Entry words select direct rows, including browser-tea (§20.2).
-- Only public keyboard and pointer projections read event data.
-- The direct update path writes the current model items.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type alias Model =
    items : List Int
    draft : String


type Msg
    = Key Html.Event
    | Aim Html.Pointer
    | Typed String


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Key event →
            if Html.key event == "Enter" then
                Html.preventDefault event
                ( { model | items = List.push model.items (String.length model.draft) }, Cmd.none )
            else
                ( model, Cmd.none )

        Aim p →
            ( { model | items = List.push model.items (round (Html.localX p)) }, Cmd.none )

        Typed text →
            ( { model | draft = text }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <input onKeyDown={Key} onInput={Typed} onPointerDown={Aim} />
        <ul>
            <For each={model.items}>
                {λn → <li>{String.fromInt n}</li>}
            </For>
        </ul>
    </main>


pub keys : Int → Int
keys n =
    rows = [ n ]
    _ = Cmd.keyed rows Cmd.Restart λ_ → ⊤
    more = [ …rows, 1 ]
    List.length more


-- The other direction: the key is the key's (`aliased`), so a command still
-- returned holds its key list, and writing the list first is rejected.
pub keysHeld : Int → Cmd Msg × Int
keysHeld n =
    rows = [ n ]
    cmd = Cmd.keyed rows Cmd.Restart λ_ → ⊤
    more = [ …rows, 1 ]
    ( cmd, List.length more )


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { items = [], draft = "" }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
