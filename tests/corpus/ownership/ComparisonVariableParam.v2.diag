[{"code":"comparison_changes_value","severity":"error","span":{"file":"tests/corpus/ownership/ComparisonVariableParam.beni","start":{"line":11,"col":27},"end":{"line":11,"col":36}},"title":"COMPARISON CHANGES A VALUE","message":"List.push a is refused: comparison: a type's `eq` and `compare` may only read\nthe values they are handed\n\nThis is a rule of the language: `==` and `<` call a type's `eq` and `compare`,\nwhich only read. Change a copy (`List.copy`)."}]
