-- ownership: `List.copy` makes an edit acceptable (Change 2, thesis
-- §7 *The explicit copy*; T33's and T41's fix). `kept` extends a list it
-- also returns: rejected, `later-use`. `copiedFirst` extends a copy instead,
-- a fresh array nothing else holds: accepted, `call` — a call whose summary
-- says `fresh1`, `List.copy`'s asserted row (`ownership-checker.md` §16.8).
-- The copy is
-- shallow: its elements are the original's, so editing an element of the
-- copy while the original lives is still rejected — `alias`, exact: the
-- element split off the copy (§18.4 item 4) is one position, and `rows`
-- holds it and is read after.
pub kept : List Int → List Int × List Int
kept history = ( [ …history, 0 ], history )


pub copiedFirst : List Int → List Int × List Int
copiedFirst history = ( [ …List.copy history, 0 ], history )


pub shallow : List (List Int) → Int
shallow rows =
    copy = List.copy rows
    case copy of
        [ first, …_ ] →
            List.length [ …first, 9 ] + List.length rows

        [] →
            0
