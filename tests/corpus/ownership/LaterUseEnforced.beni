-- ownership (§28.2, §28.10, §30.7): whether `check` enforces the report
-- is the platform's. The report is the same under all three tokens —
-- `List.push xs n` is rejected `later-use`, since `xs` is read on the next
-- line — but `check` passes on `browser-tea`, where no list is edited in
-- place, and fails with `list_still_used` on `browser-inline`, whose
-- manifest says `"lists": "in-place"`, and under the token
-- `browser-tea+everywhere`, which is `browser-tea` with the hidden
-- `--ownership-everywhere`.
grownBy : List Int, Int → Int
grownBy xs n =
    ys = List.push xs n
    List.length ys + List.length xs
