-- #684: a record built from 64 fields of one parameter carries one
-- construction condition (§16.7, as amended 2026-10-22) with an atom for
-- every pair of its fields, and every call of `step` instantiates it over
-- what the call hands `step`. Each atom names two projections of that one
-- argument; instantiated afresh at every atom, the projections made the
-- walk cubic in the width of the record, and this fixture went past the
-- instruction budget. Each projection is now made once per condition.
type alias Sub =
    n : Int


type alias Item =
    a : Sub
    b : Sub


type alias Model =
    f1 : Item
    f2 : Item
    f3 : Item
    f4 : Item
    f5 : Item
    f6 : Item
    f7 : Item
    f8 : Item
    f9 : Item
    f10 : Item
    f11 : Item
    f12 : Item
    f13 : Item
    f14 : Item
    f15 : Item
    f16 : Item
    f17 : Item
    f18 : Item
    f19 : Item
    f20 : Item
    f21 : Item
    f22 : Item
    f23 : Item
    f24 : Item
    f25 : Item
    f26 : Item
    f27 : Item
    f28 : Item
    f29 : Item
    f30 : Item
    f31 : Item
    f32 : Item
    f33 : Item
    f34 : Item
    f35 : Item
    f36 : Item
    f37 : Item
    f38 : Item
    f39 : Item
    f40 : Item
    f41 : Item
    f42 : Item
    f43 : Item
    f44 : Item
    f45 : Item
    f46 : Item
    f47 : Item
    f48 : Item
    f49 : Item
    f50 : Item
    f51 : Item
    f52 : Item
    f53 : Item
    f54 : Item
    f55 : Item
    f56 : Item
    f57 : Item
    f58 : Item
    f59 : Item
    f60 : Item
    f61 : Item
    f62 : Item
    f63 : Item
    f64 : Item


keep : Item → Item
keep item = if item.a.n > 0 then item else { item | b = item.a }


step : Model → Model
step m =
    { f1 = keep m.f1
    , f2 = keep m.f2
    , f3 = keep m.f3
    , f4 = keep m.f4
    , f5 = keep m.f5
    , f6 = keep m.f6
    , f7 = keep m.f7
    , f8 = keep m.f8
    , f9 = keep m.f9
    , f10 = keep m.f10
    , f11 = keep m.f11
    , f12 = keep m.f12
    , f13 = keep m.f13
    , f14 = keep m.f14
    , f15 = keep m.f15
    , f16 = keep m.f16
    , f17 = keep m.f17
    , f18 = keep m.f18
    , f19 = keep m.f19
    , f20 = keep m.f20
    , f21 = keep m.f21
    , f22 = keep m.f22
    , f23 = keep m.f23
    , f24 = keep m.f24
    , f25 = keep m.f25
    , f26 = keep m.f26
    , f27 = keep m.f27
    , f28 = keep m.f28
    , f29 = keep m.f29
    , f30 = keep m.f30
    , f31 = keep m.f31
    , f32 = keep m.f32
    , f33 = keep m.f33
    , f34 = keep m.f34
    , f35 = keep m.f35
    , f36 = keep m.f36
    , f37 = keep m.f37
    , f38 = keep m.f38
    , f39 = keep m.f39
    , f40 = keep m.f40
    , f41 = keep m.f41
    , f42 = keep m.f42
    , f43 = keep m.f43
    , f44 = keep m.f44
    , f45 = keep m.f45
    , f46 = keep m.f46
    , f47 = keep m.f47
    , f48 = keep m.f48
    , f49 = keep m.f49
    , f50 = keep m.f50
    , f51 = keep m.f51
    , f52 = keep m.f52
    , f53 = keep m.f53
    , f54 = keep m.f54
    , f55 = keep m.f55
    , f56 = keep m.f56
    , f57 = keep m.f57
    , f58 = keep m.f58
    , f59 = keep m.f59
    , f60 = keep m.f60
    , f61 = keep m.f61
    , f62 = keep m.f62
    , f63 = keep m.f63
    , f64 = keep m.f64
    }


fresh : Int → Model
fresh k =
    { f1 = { a = { n = k + 1 }, b = { n = 1 } }
    , f2 = { a = { n = k + 2 }, b = { n = 2 } }
    , f3 = { a = { n = k + 3 }, b = { n = 3 } }
    , f4 = { a = { n = k + 4 }, b = { n = 4 } }
    , f5 = { a = { n = k + 5 }, b = { n = 5 } }
    , f6 = { a = { n = k + 6 }, b = { n = 6 } }
    , f7 = { a = { n = k + 7 }, b = { n = 7 } }
    , f8 = { a = { n = k + 8 }, b = { n = 8 } }
    , f9 = { a = { n = k + 9 }, b = { n = 9 } }
