    }


pub run : Int → Model
run k =
    m0 = fresh k
    m1 = step m0
    m2 = step m1
    m3 = step m2
    m4 = step m3
    m5 = step m4
    m6 = step m5
    m7 = step m6
    m8 = step m7
    m9 = step m8
    m10 = step m9
    m11 = step m10
    m12 = step m11
    m12
