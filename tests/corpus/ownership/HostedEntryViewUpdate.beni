import Browser
import Html
import List


update : Browser.Host Int, Int, List Int → List Int
update host n state = List.push state n


main : Browser.Program
main =
    Browser.hosted
        { init = λ_ → []
        , update = update
        , settle = λhost state → state
        , view = λstate → <button onClick={λ_ → List.length state}>step</button>
        }
