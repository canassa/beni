pub returned40 : ⊤ → List Int
returned40 ⊤ =
    case rows40 ⊤ of
        [ x, …_ ] →
            List.push x 9

        [] →
            []


returnedShared ⊤ =
    case sharedRows1000 [ 0 ] of
        [ x, …_ ] →
            List.push x 9

        [] →
            []


pub supplied40 : ⊤ → List Int
supplied40 ⊤ = headPush (rows40 ⊤)


pub supplied100 : ⊤ → List Int
supplied100 ⊤ = headPush (rows100 ⊤)


pub suppliedShared : ⊤ → List Int
suppliedShared ⊤ = headPush (sharedRows1000 [ 0 ])
