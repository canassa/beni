-- ownership: a sweep of writes below a view of the list above, over three
-- recursive shapes (ownership-v2.md §2.8): `Rose (List Rose)`, `M (List
-- Int) (List M)` and the mutual `A (List B)`, `B (List A)`; a rest view,
-- an init view or the list whole; the first or the last element; `push`
-- or `set`. `g` lies under `r` in every one: all refused, as v1 does.

type Rose
    = Rose (List Rose)


type M
    = M (List Int) (List M)


type A
    = A (List B)


type B
    = B (List A)


pub p1 : List Rose → List Rose × List Rose
p1 x =
    case x of
        [ Rose k1, …_ ] →
            case k1 of
                [ _, …r ] →
                    case r of
                        [ Rose g, …_ ] →
                            ( List.push g (Rose []), r )

                        _ →
                            ( [], r )

                _ →
                    ( [], [] )

        _ →
            ( [], [] )


pub p2 : List M → List Int × List M
p2 x =
    case x of
        [ M _ k1, …_ ] →
            case k1 of
                [ _, …r ] →
                    case r of
                        [ M g _, …_ ] →
                            ( List.push g (0), r )

                        _ →
                            ( [], r )

                _ →
                    ( [], [] )

        _ →
            ( [], [] )


pub p3 : List A → List A × List B
p3 x =
    case x of
        [ A k1, …_ ] →
            case k1 of
                [ _, …r ] →
                    case r of
                        [ B g, …_ ] →
                            ( List.push g (A []), r )

                        _ →
                            ( [], r )

                _ →
                    ( [], [] )

        _ →
            ( [], [] )


pub p4 : List Rose → List Rose × List Rose
p4 x =
    case x of
        [ Rose k1, …_ ] →
            case k1 of
                [ _, …r ] →
                    case r of
                        [ Rose g, …_ ] →
                            ( List.set g 0 (Rose []), r )

                        _ →
                            ( [], r )

                _ →
                    ( [], [] )

        _ →
            ( [], [] )


