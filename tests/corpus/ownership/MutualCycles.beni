    | REnd27


pub f : K0 → List Int
f t =
    case t of
        K0 xs _ _ _ _ _ _ _ _ _ _ _ →
            List.push xs 1

        KEnd0 →
            []


pub g : R0 → List Int
g t =
    case t of
        R0 _ _ _ next →
            case next of
                Just (R3 ys _ _ _) →
                    List.push ys 1

                _ →
                    []

        REnd0 →
            []
