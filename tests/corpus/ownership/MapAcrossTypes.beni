-- ownership: `map`'s result is a new list whatever its types
-- (`ownership-checker.md` §27). Research 82's R4 maps `Explosion` records
-- to `Obstacle` records (`Bike.update`, line 60); appending onto the map
-- while the explosions are read afterwards is accepted (`obstacles`), and
-- so are the two maps whose callback may return its element: from a
-- record type to itself (`moved`), and from a one-field wrapper to its
-- field (`unwrapped`). Until the owner dropped `map`'s identity promise on
-- 2026-10-13 those two were rejected, approximately, and the first was
-- accepted only by §25.3's rule for closed records, withdrawn with it.
type alias Explosion =
    center : Int
    size : Int


type alias Obstacle =
    n : Int
    s : Int


type Wrapped
    = Wrapped Explosion


toObstacle : Explosion → Obstacle
toObstacle ex = { n = ex.center - ex.size, s = ex.center + ex.size }


pub obstacles : List Explosion, Obstacle → Int
obstacles explosions wall =
    all = List.map explosions toObstacle ++ [ wall ]
    List.length all + List.length explosions


pub moved : List Explosion, Explosion → Int
moved explosions extra =
    all = List.map explosions (λex → ex) ++ [ extra ]
    List.length all + List.length explosions


pub unwrapped : List Wrapped, Explosion → Int
unwrapped wrapped extra =
    all =
        List.map
            wrapped
            (λw →
                case w of
                    Wrapped ex →
                        ex
            )
            ++ [ extra ]
    List.length all + List.length wrapped
