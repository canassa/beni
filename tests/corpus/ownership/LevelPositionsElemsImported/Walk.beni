-- ownership (project): see Main.beni. The recursive group over
-- `B (List B) (List B)`.
pub type B
    = B (List B) (List B)


pub incAll : B → B
incAll b =
    case b of
        B xs ys →
            B (incList (List.push xs (B [] []))) (incList ys)


pub incList : List B → List B
incList bs =
    case bs of
        [ b, …rest ] →
            [ incAll b, …incList rest ]

        [] →
            []
