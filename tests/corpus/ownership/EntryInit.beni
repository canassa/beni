-- ownership: `init` is a function, and top-level lists are shared (Change 4,
-- T53, T14, T21; `ownership-checker.md` §20.3, §22.2). Every platform calls
-- `init ⊤` once per mount (boundary.md §9.8.16), so what it returns is the
-- entry model's start. `fromTop` returns the top-level `initialModel`, whose
-- list every mount and every `Reset` would share: `Add`'s push is rejected
-- `top-level`, and so it is in `fromTopFunction`, whose `init` is a named
-- function of `⊤` that returns the same top-level value (T53 through
-- `init ⊤ = initialModel`). `fromFunction` names `initialModelOf`, which
-- builds the list anew at each mount and each `Reset` (T14), and
-- `fromLambda` writes the literal in the record: accepted on every platform
-- by the entry row. `seeded` builds its model in `init` from a
-- top-level list (T21): rejected `top-level` on both.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    todos : List String


type Msg
    = Add String
    | Reset


initialModel : Model
initialModel = { todos = [] }


initialModelOf : ⊤ → Model
initialModelOf ⊤ = { todos = [] }


initTop : ⊤ → Model
initTop ⊤ = initialModel


seed : List String
seed = [ "milk" ]


resetTo : Model, Msg, Model → Model
resetTo first msg model =
    case msg of
        Add t →
            { model | todos = List.push model.todos t }

        Reset →
            first


updateTop : Msg, Model → Model
updateTop msg model = resetTo initialModel msg model


updateFresh : Msg, Model → Model
updateFresh msg model =
    case msg of
        Add t →
            { model | todos = List.push model.todos t }

        Reset →
            initialModelOf ⊤


updateAdd : Msg, Model → Model
updateAdd msg model =
    case msg of
        Add t →
            { model | todos = List.push model.todos t }

        Reset →
            model


view : Model → Html Msg
view model =
    <main>
        <button onClick={Add "x"}>add</button>
        <button onClick={Reset}>reset</button>
        <p>{String.fromInt (List.length model.todos)}</p>
    </main>


fromTop : Tea.Program
fromTop = Tea.sandbox { init = λ⊤ → initialModel, update = updateTop, view = view }


fromTopFunction : Tea.Program
fromTopFunction = Tea.sandbox { init = initTop, update = updateAdd, view = view }


fromFunction : Tea.Program
fromFunction = Tea.sandbox { init = initialModelOf, update = updateFresh, view = view }


fromLambda : Tea.Program
fromLambda = Tea.sandbox { init = λ⊤ → { todos = [] }, update = updateAdd, view = view }


seeded : Tea.Program
seeded = Tea.sandbox { init = λ⊤ → { todos = seed }, update = updateFresh, view = view }


main : Tea.Program
main = Browser.programs [ fromTop, fromTopFunction, fromFunction, fromLambda, seeded ]
