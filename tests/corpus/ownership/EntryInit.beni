-- ownership: `init` is a function, and top-level lists are shared (Change 4,
-- T53, T14, T21; `ownership-checker.md` §20.3). browser-direct evaluates the
-- record's `init` expression in the mount, once per mount, so the expression
-- is the body of Change 4's `init ⊤`. `fromTop` names the top-level
-- `initialModel`, whose list every mount and every `Reset` would share:
-- `Add`'s push is rejected `top-level`. `fromFunction` calls `initialModelOf ⊤`,
-- which builds the list anew at each mount and each `Reset` (T14): accepted.
-- `seeded` builds its model in `init` from a top-level list (T21): rejected.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    todos : List String


type Msg
    = Add String
    | Reset


initialModel : Model
initialModel = { todos = [] }


initialModelOf : ⊤ → Model
initialModelOf ⊤ = { todos = [] }


seed : List String
seed = [ "milk" ]


resetTo : Model, Msg, Model → Model
resetTo first msg model =
    case msg of
        Add t →
            { model | todos = List.push model.todos t }

        Reset →
            first


updateTop : Msg, Model → Model
updateTop msg model = resetTo initialModel msg model


updateFresh : Msg, Model → Model
updateFresh msg model =
    case msg of
        Add t →
            { model | todos = List.push model.todos t }

        Reset →
            initialModelOf ⊤


view : Model → Html Msg
view model =
    <main>
        <button onClick={Add "x"}>add</button>
        <button onClick={Reset}>reset</button>
        <p>{String.fromInt (List.length model.todos)}</p>
    </main>


fromTop : Tea.Program
fromTop = Tea.sandbox { init = initialModel, update = updateTop, view = view }


fromFunction : Tea.Program
fromFunction = Tea.sandbox { init = initialModelOf ⊤, update = updateFresh, view = view }


seeded : Tea.Program
seeded = Tea.sandbox { init = { todos = seed }, update = updateFresh, view = view }


main : Tea.Program
main = Browser.programs [ fromTop, fromFunction, seeded ]
