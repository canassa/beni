-- ownership (project): see Main.beni. The callees of
-- `PatternPositionsStored`: each matches a list that holds a head beside
-- its rest.
pub type Box
    = Box (List Int)


type Pair
    = Pair Box Box


pub type W
    = W Box Int


kidsBox : Box → List Int
kidsBox b =
    case b of
        Box xs →
            List.push xs 1


rightLeft : Pair → List Int × Box
rightLeft p =
    case p of
        Pair l r →
            ( kidsBox r, l )


sizeBox : Box → Int
sizeBox b =
    case b of
        Box xs →
            List.length xs


go : Box, Box → Int × Int
go a c =
    case rightLeft (Pair a c) of
        ( ys, l ) →
            ( List.length ys, sizeBox l )


pub joinLit : Bool, List Box → Int × Int
joinLit t xs =
    case xs of
        [ a, …rest ] →
            l = if t then rest else [ a ]
            case l of
                [ c, …_ ] →
                    go a c

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub pushRest : List Box → Int × Int
pushRest xs =
    case xs of
        [ a, …rest ] →
            case List.push rest a of
                [ …_, c ] →
                    go a c

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub setRest : List Box → Int × Int
setRest xs =
    case xs of
        [ a, …rest ] →
            case List.set rest 0 a of
                [ c, …_ ] →
                    go a c

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub appendRest : List Box → Int × Int
appendRest xs =
    case xs of
        [ a, …rest ] →
            case rest ++ [ a ] of
                [ c, …_ ] →
                    go a c

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub pushRestRest : List Box → Int × Int
pushRestRest xs =
    case xs of
        [ _, …r1 ] →
            case r1 of
                [ a, …r2 ] →
                    case List.push r2 a of
                        [ …_, c ] →
                            go a c

                        _ →
                            ( 0, 0 )

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub literal : List Box → Int × Int
literal xs =
    case xs of
        [ a, …rest ] →
            case [ a, …rest ] of
                [ c, …_ ] →
                    go a c

                _ →
                    ( 0, 0 )

        _ →
            ( 0, 0 )


pub headRest : List W → List Int × List W
headRest ws =
    case ws of
        [ W a _, …rest ] →
            ( kidsBox a, rest )

        _ →
            ( [], [] )
