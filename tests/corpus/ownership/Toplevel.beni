-- ownership: a top-level list is shared (Change 4, thesis §3.10, *Top-level
-- values are shared*; T3, T21, T53). Extending `seed` — directly, or through
-- a record `initialModel` returns — is rejected, `top-level`, whoever reads
-- it afterwards. Building the list in a function (`init`) makes it fresh at
-- every call, and the reading form `[ x ] ++ seed` builds a new list from a
-- literal base and only reads `seed`: both accepted. What is shared is the
-- cells a definition makes and nothing else: `Dict.empty` makes none, so a
-- write `bump` makes inside a dictionary started from it is nobody's
-- top-level list (T51; `ownership-checker.md` §16.3).
import Dict


type alias Model =
    todos : List String


seed : List String
seed = [ "milk" ]


initialModel : Model
initialModel = { todos = seed }


pub addSeed : String → List String
addSeed t = [ …seed, t ]


pub addModel : String → Model
addModel t = { initialModel | todos = [ …initialModel.todos, t ] }


pub init : ⊤ → Model
init ⊤ = { todos = [ "milk" ] }


pub addFresh : String → Model
addFresh t =
    model = init ⊤
    { model | todos = [ …model.todos, t ] }


pub reading : String → List String
reading t = [ t ] ++ seed


bump : Dict.Dict Int (List Int), Int → Dict.Dict Int (List Int)
bump d k =
    case Dict.get d k of
        Just xs →
            Dict.insert d k [ …xs, 1 ]

        Nothing →
            Dict.insert d k [ 1 ]


pub fromEmpty : Int → Dict.Dict Int (List Int)
fromEmpty k = bump (Dict.empty ⊤) k
