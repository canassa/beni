-- ownership (project): see Main.beni. The callees.
pub bumpHead : List (List Int) → List (List Int)
bumpHead rows =
    case rows of
        [] →
            []

        [ r, …rest ] →
            [ [ …r, 0 ], …rest ]


pub firstLength : List (List Int) → Int
firstLength ys =
    case ys of
        [ y, …_ ] →
            List.length y

        [] →
            0
