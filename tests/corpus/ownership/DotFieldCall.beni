-- ownership (§30.11): `r.load a` on a record field is the field's value
-- called, as `(r.load) a` is, so the call reads `r.load` and not all of
-- `r`. Before, the dot form read the whole receiver: `dottedLater` was
-- rejected `later-use` ("`r.items` is read again"), told as sharing the
-- checker can see, while `parensLater` was accepted. A closure in the
-- field that captured the written list is read by either spelling, and
-- both are rejected `captured`.
type alias Loader =
    load : ⊤ → List Int
    items : List Int


pub dottedLater : Loader → List Int × List Int
dottedLater r =
    xs = List.push r.items 1
    ( xs, r.load ⊤ )


pub parensLater : Loader → List Int × List Int
parensLater r =
    xs = List.push r.items 1
    ( xs, (r.load) ⊤ )


pub dottedCaptured : List Int → List Int × List Int
dottedCaptured items =
    r = { load = λ⊤ → items, items = [] }
    xs = List.push items 1
    ( xs, r.load ⊤ )


pub parensCaptured : List Int → List Int × List Int
parensCaptured items =
    r = { load = λ⊤ → items, items = [] }
    xs = List.push items 1
    ( xs, (r.load) ⊤ )


-- An extensible record that lists the field is the same: `r.load ⊤` is a
-- slot of the parameter, as `(r.load) ⊤` is, so a caller that hands a
-- loader of a fresh list is accepted and one of the top-level `shared` is
-- rejected `need`, exactly, in both spellings.
shared : List Int
shared = [ 1 ]


extDotted : { r | load : ⊤ → List Int } → List Int
extDotted r = List.push (r.load ⊤) 4


extParens : { r | load : ⊤ → List Int } → List Int
extParens r = List.push ((r.load) ⊤) 4


pub extDottedFresh : ⊤ → List Int
extDottedFresh ⊤ = extDotted { load = λ⊤ → [ 1 ], other = 1 }


pub extParensFresh : ⊤ → List Int
extParensFresh ⊤ = extParens { load = λ⊤ → [ 1 ], other = 1 }


pub extDottedShared : ⊤ → List Int
extDottedShared ⊤ = extDotted { load = λ⊤ → shared, other = 1 }


pub extParensShared : ⊤ → List Int
extParensShared ⊤ = extParens { load = λ⊤ → shared, other = 1 }
