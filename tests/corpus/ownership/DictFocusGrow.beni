-- #663: two fresh lists at distinct keys of ordered Dict storage stay
-- exclusive, so the callback write through `Dict.update` is accepted.
import Dict exposing (Dict)


grow : ⊤ → Dict Int (List Int)
grow ⊤ =
    d = Dict.insert (Dict.insert (Dict.empty ⊤) 1 [ 1 ]) 2 [ 2 ]
    Dict.update d 1 λm → Maybe.map m λv → List.push v 9
