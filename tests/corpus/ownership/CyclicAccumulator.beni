-- ownership: a fold whose accumulator has an unnamed cyclic type (#955;
-- ownership-checker.md §16.7, the amendment of 2026-10-25). A callback that
-- puts the accumulator into the list it returns makes it `List (List …)`, a
-- type no binder can hold and no type name stands for, and each round of the
-- callback's fixpoint put it one `[*]` deeper. Now the first nesting stays
-- exact and a later one goes to `⋆`, so the fixpoint settles: `count` has no
-- limit line. Lists built so are still judged: `freshPush` writes the fold's
-- fresh answer, accepted; `sharedHead` hands `pushHead` one list at two
-- positions (`twice`), refused; `singleHead` hands it one list per position
-- (`once`). `borrowedStart` folds from a start its caller still reads.
count : Int
count = List.length (List.foldr [] [] List.intersperse)


once : b, a → List a
once _ acc = [ acc ]


twice : b, a → List a
twice _ acc = [ acc, acc ]


pushHead : List (List b), b → Int
pushHead xs x =
    case xs of
        [ inner, …rest ] →
            List.length [ List.push inner x, …rest ]

        [] →
            0


freshPush : Int
freshPush = List.length (List.push (List.foldl [ 1, 2 ] [] twice) [])


sharedHead : Int
sharedHead = pushHead (List.foldl [ 1, 2 ] [] twice) []


singleHead : Int
singleHead = pushHead (List.foldl [ 1, 2 ] [] once) []


-- A fold that does not own its start, because its caller reads the start
-- again, settles too: its callback's fixpoint is the general one (the
-- review of #972).
share : a, (b, a → a), List b → List a
share init f xs = [ List.foldl xs init f, init ]


borrowedStart : Int
borrowedStart = List.length (share [] once [ 1, 2 ])
