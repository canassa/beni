-- One strict read transfers fresh allocations; the destination stays shared.
-- The unsafe twins have a second read, deferred reads, a public seed, aliases
-- within the transferred value, or a genuinely shared source allocation.
import Html exposing (Html)
import Schema
import Task


seed : List Int
seed = List.range 1 2


pub consumed : List Int
consumed = seed ++ [ 3 ]


pub destinationStillShared : Int → List Int
destinationStillShared n = List.push consumed n


twice : List Int
twice = [ 1 ]


pub firstRead : List Int
firstRead = twice ++ [ 2 ]


pub secondRead : List Int
secondRead = twice


deferredSeed : List Int
deferredSeed = [ 1 ]


pub deferred : ⊤ → List Int
deferred = λ⊤ → deferredSeed ++ [ 2 ]


pub publicSeed : List Int
publicSeed = [ 1 ]


pub publicRead : List Int
publicRead = publicSeed ++ [ 2 ]


aliased : (List Int) × (List Int)
aliased =
    xs = [ 1 ]
    ( xs, xs )


pub aliasRead : (List Int) × (List Int)
aliasRead =
    ( left, right ) = aliased
    ( List.push left 2, right )


shared : List Int
shared = [ 1 ]


wrapper : { items : List Int }
wrapper = { items = shared }


pub sharedRead : List Int
sharedRead = List.push wrapper.items 2


pub keepShared : List Int
keepShared = shared


separated : (List Int) × (List Int)
separated = ( [ 1 ], [ 2 ] )


pub separatedRead : (List Int) × (List Int)
separatedRead =
    ( left, right ) = separated
    ( List.push left 3, right )


escapedSeed : List Int
escapedSeed =
    xs = [ 1 ]
    _ = Task.spawn λ⊤ → List.length xs
    xs


pub escapedRead : List Int
escapedRead = List.push escapedSeed 2


functionSeed : List Int
functionSeed = [ 1 ]


pub functionRead : Int → List Int
functionRead n = List.push functionSeed n


branchSeed : List Int
branchSeed = [ 1 ]


pub branchRead : List Int
branchRead = if List.isEmpty [] then List.push branchSeed 2 else []


chainStart : List Int
chainStart = [ 1 ]


chainMiddle : List Int
chainMiddle = List.push chainStart 2


pub chainEnd : List Int
chainEnd = List.push chainMiddle 3


localSeed : List Int
localSeed = [ 1 ]


pub localFunction : List Int
localFunction =
    grow n = List.push localSeed n
    grow 2


evidenceSeed : List a
evidenceSeed = []


pub evidenceDestination : List a
    where a.compare : a, a → Order
evidenceDestination = List.pop evidenceSeed


schemaSeed : List Int
schemaSeed = [ 1 ]


pub schema KeepsSeed =
    Int via (Schema.conversion (λn → Ok (n + List.length schemaSeed)) λn → Ok n)


pub schemaRead : List Int
schemaRead = List.push schemaSeed 2


markupSeed : List Int
markupSeed = [ 1 ]


pub markupRead : List Int
markupRead = List.push markupSeed 2


pub markupObserver : Html Int
markupObserver = <p>{String.fromInt (List.length markupSeed)}</p>


sourceWithEvidence : List a
    where a.compare : a, a → Order
sourceWithEvidence = []


pub evidenceSourceRead : List Int
evidenceSourceRead = List.push sourceWithEvidence 1


-- A write the way `main` writes it: accepted, and the same write in a
-- function, `functionRead`, is `top-level`.
issueSeed : List Int
issueSeed = [ 1, 2, 3 ]


pub issueRead : List String
issueRead = [ String.fromInt (List.length (List.set issueSeed 0 9)) ]
