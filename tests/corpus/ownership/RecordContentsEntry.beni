-- ownership: a program's rows of records, written through a callback that
-- a destructive read hands each row (`ownership-checker.md` §31.4 item 6,
-- §31.8). `update` relies on `model.rows` holding no record twice
-- (`rxreq`); the entry holds it as an invariant of the model, as it does a
-- list's: every arm keeps it. `Add` stores a fresh row, so `Done` is
-- accepted at the entry; in `RecordContentsTwice`, `Copy` stores a row the
-- list already holds, and the same write is refused.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type alias Row =
    id : Int
    done : Bool


type alias Model =
    rows : List Row


type Msg
    = Add Int
    | Done


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Add n →
            ( { model | rows = List.push model.rows { id = n, done = False } }, Cmd.none )

        Done →
            ( { model | rows = List.map model.rows λr → { r | done = True } }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <button onClick={Done}>done</button>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { rows = [] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
