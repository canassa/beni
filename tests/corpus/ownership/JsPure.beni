-- ownership: `Debug`'s ownership words (`ownership-checker.md` §24.8). Until
-- Change 5 `Debug.toString` handed its argument to `Js.pure` inside a lambda,
-- so its summary escaped it (§18.6) and a list shown and then extended was
-- rejected `escaped`. Its words say it only reads (`borrowed`), so `shown`
-- is accepted. `Debug.log` returns what it is handed (`returned`), so the
-- list it gives back is the one `logged` reads afterwards: rejected
-- `alias`, the sharing the text shows.
pub shown : List Int → Int
shown xs =
    s = Debug.toString xs
    ys = [ …xs, 1 ]
    String.length s + List.length ys


pub logged : String → Int
logged label =
    xs = [ String.length label ]
    ys = Debug.log label xs
    zs = [ …ys, 1 ]
    List.length xs + List.length zs
