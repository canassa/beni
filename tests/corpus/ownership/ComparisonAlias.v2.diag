[{"code":"comparison_changes_value","severity":"error","span":{"file":"tests/corpus/ownership/ComparisonAlias.beni","start":{"line":13,"col":39},"end":{"line":13,"col":48}},"title":"COMPARISON CHANGES A VALUE","message":"List.push a is refused: comparison: a type's `eq` and `compare` may only read\nthe values they are handed\n\nThis is a rule of the language: `==` and `<` call a type's `eq` and `compare`,\nwhich only read. Change a copy (`List.copy`)."},{"code":"comparison_changes_value","severity":"error","span":{"file":"tests/corpus/ownership/ComparisonAlias.beni","start":{"line":18,"col":21},"end":{"line":18,"col":30}},"title":"COMPARISON CHANGES A VALUE","message":"List.push a is refused: comparison: a type's `eq` and `compare` may only read\nthe values they are handed\n\nThis is a rule of the language: `==` and `<` call a type's `eq` and `compare`,\nwhich only read. Change a copy (`List.copy`)."}]
