update : Msg, Model → Model
update msg model =
    case msg of
        Step values →
            bump values model


view : Model → Html Msg
view model =
    <main>
        <button id="step" onClick={Step inputPayload}>step</button>
        <p id="a">{model.f0}</p>
        <p id="b">{model.f1}</p>
    </main>


