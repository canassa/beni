                else
                    b14

            b15 =
                if model.pick == 115 then
                    b14
                else
                    a14

            a16 =
                if model.pick == 16 then
                    a15
                else
                    b15

            b16 =
                if model.pick == 116 then
                    b15
                else
                    a15

            a17 =
                if model.pick == 17 then
                    a16
                else
                    b16

            b17 =
                if model.pick == 117 then
                    b16
                else
                    a16

            a18 =
                if model.pick == 18 then
