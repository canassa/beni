                    a9
                else
                    b9

            b10 =
                if model.pick == 110 then
                    b9
                else
                    a9

            a11 =
                if model.pick == 11 then
                    a10
                else
                    b10

            b11 =
                if model.pick == 111 then
                    b10
                else
                    a10

            a12 =
                if model.pick == 12 then
                    a11
                else
                    b11

            b12 =
                if model.pick == 112 then
                    b11
                else
                    a11

            a13 =
