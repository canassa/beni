-- writes: the work cap W (`write-sets.md` §6.1, N6; §8.3 item 15). C1's
-- chain written in `update` itself, over the model, run under the hidden,
-- test-only `--writes-work` (`CapW.writes-work`), which lowers W so the
-- fixture reaches it under the test budget. The key that spends it is
-- marked `(cap W)` and is `value ρ`: a cap is the top, never an error.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    count : Int
    pick : Int


type Msg
    = Go


update : Msg, Model → Model
update msg model =
    case msg of
        Go →
            a0 = model

            b0 = { model | count = 1 }

            a1 =
                if model.pick == 1 then
                    a0
                else
                    b0

            b1 =
                if model.pick == 101 then
                    b0
                else
                    a0

            a2 =
                if model.pick == 2 then
                    a1
                else
                    b1

            b2 =
                if model.pick == 102 then
                    b1
                else
                    a1

            a3 =
                if model.pick == 3 then
                    a2
                else
                    b2

            b3 =
                if model.pick == 103 then
                    b2
                else
                    a2

            a4 =
                if model.pick == 4 then
                    a3
                else
                    b3

            b4 =
                if model.pick == 104 then
                    b3
                else
                    a3

            a5 =
                if model.pick == 5 then
                    a4
                else
                    b4

            b5 =
                if model.pick == 105 then
                    b4
                else
                    a4

            a6 =
                if model.pick == 6 then
                    a5
                else
                    b5

            b6 =
                if model.pick == 106 then
                    b5
                else
                    a5

            a7 =
