program ApproxConstructor.main : Tea.sandbox
  model ApproxConstructor.Model
  init
    literal ρ
  key Start                                       exact      node ρ; value ρ.state ≈
  key Stop                                        exact      node ρ; value ρ.state
  keys 2: bounded 2 (100%), exact 2, indexed 0, structural 0, * 0; capped 0
  hole ApproxConstructor.beni:48:38               dynamic    reads tag ρ.state; ρ.state.Running#0
  holes 1: static 0, literal 0, static-key 0, dynamic 1
  site ApproxConstructor.beni:48:14               unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 2: under * 0 (0%)
  pairs 2 over 2 keys and 1 groups (1.00 per key); every key calls 1 of 1 groups (100%)
  reconciler 0 of 0 lists
  patchAll <none>
