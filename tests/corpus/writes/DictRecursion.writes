program DictRecursion.main : Tea.sandbox
  model DictRecursion.Model
  init
    literal ρ
  key Fill                                        structural node ρ; node ρ.rows ⟨grow⟩; value ρ.rows{n}; value ρ.rows{*}
  key Either                                      structural node ρ; node ρ.rows ⟨grow⟩; value ρ.rows{1}; value ρ.rows{2}
  key Rather                                      structural node ρ; node ρ.rows ⟨grow⟩; value ρ.rows{1}; value ρ.rows{2}
  keys 3: bounded 3 (100%), exact 0, indexed 0, structural 3, * 0; capped 0
  hole DictRecursion.beni:45:17                   dynamic    reads ρ.rows
  holes 1: static 0, literal 0, static-key 0, dynamic 1
  site DictRecursion.beni:45:14                   unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 3: under * 0 (0%)
  pairs 3 over 3 keys and 1 groups (1.00 per key); every key calls 1 of 1 groups (100%)
  reconciler 0 of 0 lists
  patchAll <none>
