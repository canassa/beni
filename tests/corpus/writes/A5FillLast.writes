program A5FillLast.main : Tea.sandbox
  model A5FillLast.Model
  init
    literal ρ
  key (any)                                       structural node ρ; node ρ.todos ⟨kept⟩; value ρ.todos[*]
  keys 1: bounded 1 (100%), exact 0, indexed 0, structural 1, * 0; capped 0
  hole A5FillLast.beni:40:10                      dynamic    reads ρ.todos
  hole A5FillLast.beni:40:57                      dynamic    reads ρ.todos[*].title
  holes 2: static 0, literal 0, static-key 0, dynamic 2
  site A5FillLast.beni:39:5                       unique
  site A5FillLast.beni:40:53                      instanced
  sites 2: unique 1, shared 0, instanced 1, value 0
  markup_value_roots 0 (0% of 2 sites)
  carriers no
  constructors 1: under * 0 (0%)
  pairs 2 over 1 keys and 2 groups (2.00 per key); every key calls 2 of 2 groups (100%)
  list A5FillLast.beni:40:10                      scripts
  reconciler 0 of 0 lists
  patchAll <none>
