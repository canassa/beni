program DictSequence.main : Tea.sandbox
  model DictSequence.Model
  init
    literal ρ
  key Bump                                        indexed    node ρ; node ρ.rows ⟨at 1 ins⟩; value ρ.rows{1}; value ρ.rows{2} ≈
  key More                                        indexed    node ρ; value ρ.ids ⟨append⟩; value ρ.x
  keys 2: bounded 2 (100%), exact 0, indexed 2, structural 0, * 0; capped 0
  hole DictSequence.beni:40:12                    dynamic    reads ρ.rows{2}
  hole DictSequence.beni:41:12                    dynamic    reads ρ.rows; ρ.x
  hole DictSequence.beni:42:12                    dynamic    reads ρ.ids; ρ.ids[*]; ρ.rows
  holes 3: static 0, literal 0, static-key 0, dynamic 3
  site DictSequence.beni:39:5                     unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 2: under * 0 (0%)
  pairs 5 over 2 keys and 3 groups (2.50 per key); every key calls 2 of 3 groups (66%)
  reconciler 0 of 0 lists
  patchAll <none>
