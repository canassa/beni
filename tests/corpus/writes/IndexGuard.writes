program IndexGuard.main : Tea.sandbox
  model IndexGuard.Model
  init
    literal ρ
  key SwapRows                                    indexed    node ρ; node ρ.rows ⟨kept⟩; value ρ.rows[1]; value ρ.rows[998]
  key Every10                                     structural node ρ; node ρ.rows ⟨kept⟩; node ρ.rows[*]; value ρ.rows[*].label
  keys 2: bounded 2 (100%), exact 0, indexed 1, structural 1, * 0; capped 0
  hole IndexGuard.beni:62:10                      dynamic    reads ρ.rows
  hole IndexGuard.beni:62:62                      dynamic    reads ρ.rows[*].label
  holes 2: static 0, literal 0, static-key 0, dynamic 2
  site IndexGuard.beni:61:5                       unique
  site IndexGuard.beni:62:54                      instanced
  sites 2: unique 1, shared 0, instanced 1, value 0
  markup_value_roots 0 (0% of 2 sites)
  carriers no
  constructors 2: under * 0 (0%)
  pairs 4 over 2 keys and 2 groups (2.00 per key); every key calls 2 of 2 groups (100%)
  list IndexGuard.beni:62:10                      scripts
  reconciler 0 of 0 lists
  patchAll <none>
