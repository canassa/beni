--! `writes/TagHeader/` with navigation: `Go` builds another page through a
--! helper that takes the constructor as a value, so the tag at ρ may change
--! (`value ρ`) and the header is `dynamic`. Typing alone would leave it
--! `static` (`Typing.beni`).

import Browser
import Html exposing (Html)
import Shared
import Tea


type Msg
    = Typed String
    | Go


open : (Shared.HomePage → Shared.Model), Shared.Model → Shared.Model
open make model = make { session = Shared.toSession model, count = 0 }


update : Msg, Shared.Model → Shared.Model
update msg model =
    case msg of
        Typed text →
            case model of
                Shared.Editor ed →
                    Shared.Editor { ed | title = text }

                _ →
                    model

        Go →
            open Shared.Home model


main : Browser.Program
main = Tea.sandbox { init = Shared.start, update = update, view = Shared.view }
