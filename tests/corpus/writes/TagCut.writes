program TagCut.main : Tea.sandbox
  model TagCut.Model
  init
    literal ρ
  key (any)                                       exact (cap k) node ρ; node ρ.l1; node ρ.l1.l2; node ρ.l1.l2.l3; node ρ.l1.l2.l3.l4; node ρ.l1.l2.l3.l4.l5; node ρ.l1.l2.l3.l4.l5.l6; node ρ.l1.l2.l3.l4.l5.l6.l7; value ρ.l1.l2.l3.l4.l5.l6.l7.deep
  keys 1: bounded 1 (100%), exact 1, indexed 0, structural 0, * 0; capped 1
  hole TagCut.beni:111:12                         static     reads tag ρ.l1.l2.l3.l4.l5.l6.l7.top
  hole TagCut.beni:112:12                         dynamic    reads ρ.l1.l2.l3.l4.l5.l6.l7.deep
  holes 2: static 1, literal 0, static-key 0, dynamic 1
  site TagCut.beni:110:5                          unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 1: under * 0 (0%)
  pairs 1 over 1 keys and 2 groups (1.00 per key); every key calls 1 of 2 groups (50%)
  reconciler 0 of 0 lists
  patchAll <none>
