program FosterParent.main : Tea.sandbox
  model FosterParent.Model
  init
    literal ρ
  key (any)                                       exact      node ρ; value ρ.clicks
  keys 1: bounded 1 (100%), exact 1, indexed 0, structural 0, * 0; capped 0
