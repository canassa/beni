program UpdateRecursion.main : Tea.sandbox
  model UpdateRecursion.Model
  init
    literal ρ
  key Bump                                        structural node ρ; node ρ.rows ⟨kept⟩; value ρ.rows{?} ≈; value ρ.rows{n} ≈
  key Touch                                       structural node ρ; node ρ.xs ⟨kept⟩; value ρ.xs[?] ≈; value ρ.xs[n] ≈
  key Inc                                         structural node ρ; node ρ.xs ⟨kept⟩; value ρ.xs[*] ≈
  key Deep                                        structural node ρ; node ρ.grid ⟨kept⟩; node ρ.grid[*] ⟨kept⟩; value ρ.grid[*][*] ≈
  keys 4: bounded 4 (100%), exact 0, indexed 0, structural 4, * 0; capped 0
  hole UpdateRecursion.beni:58:17                 dynamic    reads ρ.rows
  hole UpdateRecursion.beni:58:40                 dynamic    reads ρ.xs
  holes 2: static 0, literal 0, static-key 0, dynamic 2
  site UpdateRecursion.beni:58:14                 unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 4: under * 0 (0%)
  pairs 3 over 4 keys and 2 groups (0.75 per key); every key calls 0 of 2 groups (0%)
  reconciler 0 of 0 lists
  patchAll <none>
