program TagTuple.main : Tea.sandbox
  model TagTuple.Model
  init
    literal ρ
  key Rename                                      exact      node ρ; value ρ.name
  key Tick                                        exact      node ρ; node ρ.page; value ρ.page.Ready#0
  keys 2: bounded 2 (100%), exact 2, indexed 0, structural 0, * 0; capped 0
  hole TagTuple.beni:49:13                        dynamic    reads ρ.name; tag ρ.page
  hole TagTuple.beni:61:13                        static     reads tag ρ.page
  holes 2: static 1, literal 0, static-key 0, dynamic 1
  site TagTuple.beni:47:5                         unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 2: under * 0 (0%)
  pairs 1 over 2 keys and 2 groups (0.50 per key); every key calls 0 of 2 groups (0%)
  reconciler 0 of 0 lists
  patchAll <none>
