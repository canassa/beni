-- writes: a recursion that edits the list or the dictionary it threads
-- (#998). Rounds are compared up to the renaming of the element roots they
-- mint, and a composed update keeps one copy of elements that write the
-- same, so §4.3's rounds meet: `bump`, `touch`, `inc` and `deep` (a map
-- inside a map) settle as `kept` with their element writes, not a cap.
import Browser
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


type alias Model =
    rows : Dict Int Int
    xs : List Int
    grid : List (List Int)


type Msg
    = Bump Int
    | Touch Int
    | Inc Int
    | Deep Int


bump : Dict Int Int, Int → Dict Int Int
bump rows n = if n ≤ 0 then rows else bump (Dict.update rows n λm → Maybe.map m λv → v + 1) (n - 1)


touch : List Int, Int → List Int
touch xs n = if n ≤ 0 then xs else touch (List.update xs n λv → v + 1) (n - 1)


inc : List Int, Int → List Int
inc xs n = if n ≤ 0 then xs else inc (List.map xs λv → v + 1) (n - 1)


deep : List (List Int), Int → List (List Int)
deep grid n = if n ≤ 0 then grid else deep (List.map grid λr → List.map r λc → c + 1) (n - 1)


update : Msg, Model → Model
update msg model =
    case msg of
        Bump n →
            { model | rows = bump model.rows n }

        Touch n →
            { model | xs = touch model.xs n }

        Inc n →
            { model | xs = inc model.xs n }

        Deep n →
            { model | grid = deep model.grid n }


view : Model → Html Msg
view model = <p>{Dict.size model.rows} {List.length model.xs}</p>


main : Browser.Program
main =
    Tea.sandbox
        { init = λ⊤ → { rows = Dict.empty, xs = [], grid = [] }, update = update, view = view }
