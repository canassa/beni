program Recursion.main : Tea.sandbox
  model Recursion.Model
  init
    literal ρ
  key Repeat                                      exact      node ρ; value ρ.count
  key Build                                       indexed    node ρ; value ρ.items ⟨replaced⟩
  keys 2: bounded 2 (100%), exact 1, indexed 1, structural 0, * 0; capped 0
  hole Recursion.beni:52:12                       literal    reads ρ.label
  holes 1: static 0, literal 1, static-key 0, dynamic 0
  site Recursion.beni:51:5                        unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 2: under * 0 (0%)
  pairs 0 over 2 keys and 1 groups (0.00 per key); every key calls 0 of 1 groups (0%)
  reconciler 0 of 0 lists
  patchAll <none>
