view : Model → Html Msg
view model = <button onClick={Step0}>{model.left}{model.right}{model.after}</button>


main : Browser.Program
main =
    Tea.sandbox
        { init = λ⊤ → { flag = False, left = 0, right = 0, after = 0 }
        , update = update
        , view = view
        }
