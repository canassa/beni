program CompleteTailBudget.main : Tea.sandbox
  model CompleteTailBudget.Model
  init
    literal ρ
  key (any)                                       exact      node ρ; value ρ.after ≈; value ρ.left ≈; value ρ.right ≈
    tails joined (probe work exhausted)
  tail-analysis eligible 1; visits 0; work 40; candidates 0; resets 0
  keys 1: bounded 1 (100%), exact 1, indexed 0, structural 0, * 0; capped 0
  hole CompleteTailBudget.beni:35:37              dynamic    reads ρ.left
  hole CompleteTailBudget.beni:35:49              dynamic    reads ρ.right
  hole CompleteTailBudget.beni:35:62              dynamic    reads ρ.after
  holes 3: static 0, literal 0, static-key 0, dynamic 3
  site CompleteTailBudget.beni:35:14              unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 1: under * 0 (0%)
  pairs 3 over 1 keys and 3 groups (3.00 per key); every key calls 3 of 3 groups (100%)
  reconciler 0 of 0 lists
  patchAll <none>
