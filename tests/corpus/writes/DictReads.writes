program DictReads.main : Tea.sandbox
  model DictReads.Model
  init
    literal ρ
  key SetTwo                                      indexed    node ρ; node ρ.rows ⟨at 2 ins⟩; value ρ.rows{2}
  key SetAt                                       indexed    node ρ; node ρ.rows ⟨at k ins⟩; value ρ.rows{k}
  key Rename                                      indexed    node ρ; node ρ.rows ⟨kept⟩; value ρ.rows{2}
  keys 3: bounded 3 (100%), exact 0, indexed 3, structural 0, * 0; capped 0
  hole DictReads.beni:37:12                       dynamic    reads ρ.rows{1}
  hole DictReads.beni:38:12                       dynamic    reads ρ.rows
  holes 2: static 0, literal 0, static-key 0, dynamic 2
  site DictReads.beni:36:5                        unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 3: under * 0 (0%)
  pairs 4 over 3 keys and 2 groups (1.33 per key); every key calls 1 of 2 groups (50%)
  reconciler 0 of 0 lists
  patchAll <none>
