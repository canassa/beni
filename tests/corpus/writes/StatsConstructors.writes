program StatsConstructors.main : Tea.sandbox
  model StatsConstructors.Model
  init
    literal ρ
  key Child · Inc                                 exact      node ρ; value ρ.child
  key Child · Dec                                 exact      node ρ; value ρ.child
  key Child · Set                                 exact      node ρ; value ρ.child
  key Loaded · Ok                                 exact      node ρ; value ρ.n
  key Loaded · Err                                exact      ∅
  key Replace                                     *          value ρ
  key _                                           exact      node ρ; value ρ.seen
  keys 7: bounded 6 (85%), exact 6, indexed 0, structural 0, * 1; capped 0
  hole StatsConstructors.beni:70:17               dynamic    reads ρ.child
  holes 1: static 0, literal 0, static-key 0, dynamic 1
  site StatsConstructors.beni:70:14               unique
  sites 1: unique 1, shared 0, instanced 0, value 0
  markup_value_roots 0 (0% of 1 sites)
  carriers no
  constructors 7: under * 1 (14%)
  pairs 3 over 6 keys and 1 groups (0.50 per key); every key calls 0 of 1 groups (0%)
  reconciler 0 of 0 lists
  patchAll Replace
