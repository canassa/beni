-- A selector (language.md §11.9; backend.md §15.5): each row reads an
-- input only to compare it with the row's own key, so its row object
-- carries `g`, the selector's position among the inputs, and `z`, its
-- probe — the input itself against `===`, `s.$ === "Just" ? s.a : s`
-- against `Just`. The first row reads it through a helper; the second
-- through a record pattern, the operands the other way round, under
-- `keyed={\r -> r.id}`; the third with `/=`, keyed by reference; the
-- fourth reads another input first, so its selector is its second; the
-- fifth passes the input itself, and the key, to a helper.
import Html exposing (Html)


type Msg
    = Select Int


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    selected : Maybe Int
    cursor : Int
    ids : List Int
    theme : String


rowClass : Model, Row → String
rowClass model row = if model.selected == Just row.id then "danger" else ""


isOn : Maybe Int, Int → String
isOn selected id = if selected == Just id then "on" else ""


pub table : Model → Html Msg
table model =
    <div>
        <For each={model.rows} keyed={.id}>
            {λrow → <p class={rowClass model row} onClick={Select row.id}>{row.label}</p>}
        </For>
        <For each={model.rows} keyed={λr → r.id}>
            {λ{ id, label } → <p class={if Just id == model.selected then "on" else ""}>{label}</p>}
        </For>
        <For each={model.ids}>
            {λn → <p class={if n ≠ model.cursor then "" else "at"}>{n}</p>}
        </For>
        <For each={model.rows} keyed={.id}>
            {λrow →
                <p class={model.theme}>
                    <b class={if model.cursor == row.id then "at" else ""}>{row.label}</b>
                </p>
            }
        </For>
        <For each={model.rows} keyed={.id}>
            {λrow → <p class={isOn model.selected row.id}>{row.label}</p>}
        </For>
    </div>
