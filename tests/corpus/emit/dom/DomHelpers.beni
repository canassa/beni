-- A call of a top-level function in an `Html` hole (language.md §11.6,
-- backend.md §15.3–§15.4): the arguments are the root's values and are kept
-- in the instance, the call is made at mount and then only when an
-- argument is not `===` the one kept, and the callee is named in the kind
-- itself, so a skipped call allocates nothing. In a row compiled in place
-- the same test guards the call. A local function, a call that passes
-- evidence and a markup primitive stay values of the root, made every
-- render. A constant argument — `"fixed"`, `1`, the row's `0` — is neither
-- kept nor compared, and `label "fixed" 1`, all constants, is called at
-- mount only (backend.md §15.4, *amended 2026-09-30*).
import Html exposing (Html)


label : String, Int → Html msg
label name n = <b>{name} {n}</b>


pub page : String, Int → Html msg
page name n = <div>{label name n}{label "fixed" 1}</div>


pub rows : List String → Html msg
rows names = <ul><For each={names}>{λname → <li>{label name 0}</li>}</For></ul>


same : a, a → Html msg
    where a.eq : a, a → Bool
same x y = <b>{if x == y then "same" else "different"}</b>


pub others : Int → Html msg
others n =
    twice : Int → Html msg
    twice m = <i>{m}{m}</i>
    <div>{same n 1}{twice n}{Html.text "t"}</div>
