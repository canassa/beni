-- A branch and its liveness test (docs/design/browser-direct.md §4.1, §5.5;
-- S4's amendment, item 3, as built): the `case` is a state
-- `Direct.branch(parent, marker, makes)` and a `make` per arm, each arm's
-- template cloned whole. `Rename` writes inside the page's payload, and
-- its handler computes the arm again (the scrutinee's facts read the tag):
-- the same arm is visited under `if ($B.k === 0)`, its group reading the
-- payload from the `case` lowered again with the arm's result replaced by
-- its inputs; another arm is made. `Close` replaces the model whole, a
-- key of class `*`: the arm is computed again, then `patchAll`. Each
-- branch is a comment the arms go after, made once (`Direct.branch`).
import Html exposing (Html)
import Tea


type Page
    = Open String
    | Closed


type Msg
    = Rename
    | Close


update : Msg, Page → Page
update msg page =
    case msg of
        Rename →
            case page of
                Open name →
                    Open (name ++ "!")

                Closed →
                    page

        Close →
            Closed


view : Page → Html Msg
view page =
    <main>
        <button onClick={Rename}>rename</button>
        <button onClick={Close}>close</button>
        {case page of
            Open name →
                <p>{name}</p>

            Closed →
                <p>closed</p>
        }
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → Open "ada", update = update, view = view }
