-- Helpers' calls on `browser-direct` (browser-direct.md §5.2, as amended
-- for S3). `button` called with constants only is written in place, its
-- text and id template text (the table app's buttons). `label` reads the
-- model and is called once: written in place, its hole one group of the
-- page's own. `cell` is one element with holes and a handler, called from
-- three places with arguments that read the model: the size gate keeps it
-- shared — one template, one `make`, one group per hole, and each call an
-- instance whose `c` computes its arguments again and whose listener body
-- sends that call's message.
import Browser
import Html exposing (Html)
import Tea


type Msg
    = Go Int


type alias Model =
    a : Int
    b : Int
    c : Int
    name : String


update : Msg, Model → Model
update msg model =
    case msg of
        Go 1 →
            { model | a = model.a + 1 }

        Go 2 →
            { model | b = model.b + 1 }

        Go _ →
            { model | c = model.c + 1 }


button : String, String → Html Msg
button id text = <button id={id} type="button">{text}</button>


label : String → Html Msg
label name = <h1>Hello, {name}</h1>


cell : String, Int, Msg → Html Msg
cell title n msg =
    <div class="cell" onClick={msg}>
        <span>{title}</span>
        <b>{n}</b>
        <i>{n + 1}</i>
    </div>


view : Model → Html Msg
view model =
    <main>
        {label model.name}
        {button "run" "Create 1,000 rows"}
        {button "add" "Append 1,000 rows"}
        {cell "a" model.a (Go 1)}
        {cell "b" model.b (Go 2)}
        {cell "c" model.c (Go 3)}
    </main>


main : Browser.Program
main =
    Tea.sandbox { init = λ⊤ → { a = 0, b = 0, c = 0, name = "beni" }, update = update, view = view }
