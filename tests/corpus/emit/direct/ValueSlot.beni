-- A value slot (browser-direct.md's S4 amendment, item 1): a `List Html`
-- hole of the view's root and a `Maybe Html` hole of a row are each a
-- slot made at mount — a name of the mount, a field `c<k>` of the row's
-- instance — and a group of the hole's read set, which hands the value to
-- `childList` or `childMaybe`. `Add` writes the list, so its handler calls
-- the first group; `Tick` writes neither, and calls neither. Markup on the
-- value path is `dom`'s kinds, hoisted, each handler node listening on
-- itself (`Direct.listen`); the program has a dispatcher, written on its
-- mount node as `$$root`, and the verify mode checks each slot
-- (`Direct.verifySlot`).
import Html exposing (Html)
import Tea


type Msg
    = Add
    | Tick
    | Pick Int


type alias Row =
    id : Int
    note : Maybe String


type alias Model =
    names : List String
    rows : List Row
    ticks : Int
    picked : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Add →
            { model | names = List.push model.names "n" }

        Tick →
            { model | ticks = model.ticks + 1 }

        Pick i →
            { model | picked = i }


view : Model → Html Msg
view model =
    <main>
        <button onClick={Tick}>{model.ticks}</button>
        <ul>{List.map model.names λn → <li onClick={Add}>{n}</li>}</ul>
        <ol>
            <For each={model.rows} keyed={.id}>
                {λr → <li>{Maybe.map r.note λs → <b onClick={Pick r.id}>{s}</b>}</li>}
            </For>
        </ol>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ → { names = [ "a" ], rows = [ { id = 1, note = Just "x" } ], ticks = 0, picked = 0 }
        , update = update
        , view = view
        }
