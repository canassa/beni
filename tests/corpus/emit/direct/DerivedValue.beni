-- A derived value's slot (docs/design/browser-direct.md §4.1 step 2, §5.4;
-- S4's amendment, item 4, as built): `view`'s `let` its markup alone reads
-- is a slot of the mount, `= unset`, computed at mount and again by
-- `Add`, whose writes conflict with what it reads, before the groups that
-- read it; `Tick` writes the ticks only, and computes nothing of it. The
-- groups read the slot.
import Html exposing (Html)
import Tea


type Msg
    = Tick
    | Add


type alias Model =
    items : List Int
    ticks : Int


update : Msg, Model → Model
update msg model =
    case msg of
        Tick →
            { model | ticks = model.ticks + 1 }

        Add →
            { model | items = List.push model.items (List.length model.items) }


view : Model → Html Msg
view model =
    total = List.sum model.items

    <main>
        <button onClick={Tick}>tick</button>
        <button onClick={Add}>add</button>
        <p>{model.ticks}</p>
        <p>{total}</p>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { items = [ 1, 2 ], ticks = 0 }, update = update, view = view }
