-- The size gate counts a helper's calls in the view's root site (§5.2, as
-- amended for S3), and a call inside markup that turns out to be on the
-- value path is none of them (S4's review): `chip` is called once in the
-- root and once inside an `Html.map` whose markup holds a value slot, which
-- makes the whole map `dom`'s. Counted twice, `chip` was large enough to be
-- a shared site, with a `make` and an instance; counted once, it is written
-- in place.
import Html exposing (Html)
import Tea


type Msg
    = Set String
    | Inner String


type alias Model =
    a : String
    b : String
    c : String


chip : String → Html Msg
chip s =
    <span class="chip chip-large chip-outlined chip-with-a-long-class-list">
        <b>{s}</b>
        <i>{s}</i>
        <u>{s}</u>
        <em>{s}</em>
    </span>


view : Model → Html Msg
view m =
    <main>
        <button onClick={Set "x"}>set</button>
        {chip m.a}
        {Html.map (<div>{chip m.b}{Html.text m.c}</div>) λmsg → msg}
    </main>


update : Msg, Model → Model
update msg m =
    case msg of
        Set s →
            { m | a = s }

        Inner s →
            { m | b = s }


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { a = "a", b = "b", c = "c" }, update = update, view = view }
