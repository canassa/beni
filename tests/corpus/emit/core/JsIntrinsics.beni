-- Every `Js` intrinsic is the JavaScript it names, written in place
-- (research 47): no call, no wrapper, no import of core's `Js`. A property
-- name that is an identifier is `.name`, any other `[name]`; `set` is a
-- statement and its value `null`; a list literal of arguments is spread into
-- the call; `global` is `globalThis`; `at` is `[k]` and `setAt` the
-- statement `[k] = v`; `throw` a statement;
-- `from` and `to` are nothing at all.
-- Built with `--core`, which is what lets a root-package module import `Js`.
import Js


pub read : Js.Value → Js.Value
read o = Js.get o "firstChild"


pub readIndexed : Js.Value, String → Js.Value
readIndexed o k = Js.get (Js.get o "x-y") k


pub write : Js.Value, Js.Value → ()
write o v = Js.set o "$$root" v


pub insert : Js.Value, Js.Value, Js.Value → Js.Value
insert parent node before = Js.call parent "insertBefore" [ node, before ]


pub make : String → Js.Value
make tag =
    Js.call (Js.get (Js.global "document") "createElement") "call"
        [ Js.global "document", Js.from tag ]


pub tests : Js.Value, Js.Value → List Bool
tests a b = [ Js.same a b, Js.isNull a, Js.isUndefined a, Js.isNullish a ]


pub flag : Int → Bool
flag flags = Js.bitAnd flags 2 ≠ 0


pub pair : Js.Value → Js.Value
pair x = Js.array [ x, Js.null, Js.undefined ]


pub callback : Js.Value → Js.Value
callback f = Js.apply f [ Js.from λn → n + 1 ]


pub back : Js.Value → Int
back v = Js.to v


pub second : Js.Value → Js.Value
second xs = Js.at xs 1


pub fail : String → Int
fail message = Js.throw (Js.apply (Js.global "Error") [ Js.from message ])


pub store : Js.Value, Int, Js.Value → ()
store xs k v = Js.setAt xs k v
