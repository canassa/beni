-- emit: the SHAPE of `docs/design/backend.md` §8's loop, which running
-- cannot observe — a program is right whether it loops or overflows at a
-- depth the fixture never reaches.
--
-- `countUp` makes no function in its body, so since 2026-10-02 its loop
-- reassigns its parameters in place (§8, *In place, when nothing
-- captures*): a `for (;;)` with no label, the parameters as the loop's
-- variables, no prologue and no `continue` at the end of the body, and one
-- LOOP-INVARIANT parameter — `step`, which every self-call passes itself —
-- assigned nothing. `TailCallInPlace` pins the shape with the copies (the
-- `$in$<i>` slots and the prologue `const`s) beside this one.
--
-- `plain` is the control: no tail self-call, so its emitted shape is
-- unchanged, byte for byte.
import Node exposing (Program)


pub countUp : Int, Int, Int → Int
countUp n acc step =
    if n ≤ 0 then
        acc
    else
        countUp (n - 1) (acc + step) step


pub plain : Int → Int
plain n =
    if n ≤ 0 then
        0
    else
        1 + plain (n - 1)


main : Program
main = Node.printLines []
