-- emit: the SHAPE of a list pattern with items after its spread on the
-- array-backed `List` (`backend.md` §7, *List patterns with elements after
-- the spread*, its *After the flip*), which running cannot tell from any
-- other correct compilation.
--
-- The golden pins, in `lastOr`: the scrutinee bound once; the column split
-- by length as a chain of two-way length tests, `xs.length === 0`, then
-- `xs.length === 1`, one comparison each and no walk; and the trailing item
-- read at `xs.length - 1` through `List$unsafeGet`. `init` is not read, so
-- it is not bound (§7: a spread's list is an allocation). `middle` binds
-- its spread as `List$slice(xs, 1, xs.length - 1)` — a copy, the choice
-- `plans/list-arrays.md` left to this slice, since a view is a suffix — and
-- its last item from the end. `endsInZero` tests a trailing literal at the
-- same index. `headOr` is the control: `[ x, ...rest ]`, a column with
-- nothing after its spread, reads element 0, and binds no view for the
-- `rest` it never reads.
import Node exposing (Program)


pub lastOr : List Int -> Int
lastOr xs =
    case xs of
        [] ->
            0

        [ ...init, last ] ->
            last


pub middle : List Int -> List Int
middle xs =
    case xs of
        [ first, ...between, last ] ->
            between

        _ ->
            []


pub endsInZero : List Int -> Bool
endsInZero xs =
    case xs of
        [ ..._, 0 ] ->
            True

        _ ->
            False


pub headOr : List Int -> Int
headOr xs =
    case xs of
        [ x, ...rest ] ->
            x

        [] ->
            0


main : Program
main = Node.printLines []
