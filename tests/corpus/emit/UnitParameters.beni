-- emit: `docs/design/backend.md` §6, *A parameter of type `()`*. A trailing
-- run of `()` parameters is not in the JavaScript parameter list: `thunk` is
-- `() => …`, `later` is `(n) => …`, and a lambda `\() -> …` is `() => …`.
-- A `()` BEFORE a written parameter keeps its position, so `first` takes two.
--
-- A call of a declaration of this module leaves out the `()` literals it
-- would pass there — `thunk()`, `later(n)` — and every other call still
-- passes `null`, which the callee ignores: `first(null, n)`, and the lambda
-- called through a value.
import Node exposing (Program)


pub thunk : () -> Int
thunk () =
    42


pub later : Int, () -> Int
later n () =
    n + 1


pub first : (), Int -> Int
first () n =
    n


pub lambda : () -> (() -> Int)
lambda () =
    \() -> 7


pub calls : Int -> Int
calls n =
    let
        f =
            lambda ()
    in
    thunk () + later n () + first () n + f ()


main : Program
main =
    Node.printLines []
