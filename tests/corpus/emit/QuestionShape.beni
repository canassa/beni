-- emit: the three statements a `?` is (`backend.md` §4, §7, §8).
--
--     const $t$<n> = <subject>;
--     if ($t$<n>.$ === "Nothing") return $t$<n>;
--     …$t$<n>.a…
--
-- Behaviour is `run/Question*.beni`; what a golden adds is the shape, and
-- there are four claims in it that running a program cannot see:
--
--   `maybe`   the subject is evaluated ONCE into a `$t$<n>`, the failure
--             test is the `Nothing` TAG, and what is returned is that same
--             temporary — nothing is rebuilt, nothing new is named, so §9
--             has no edge to follow down the failure path
--   `result`  the same for `Err`, where it also carries a payload out of a
--             `Result String Int` and into a `Result String String`
--   `atom`    a subject that is already a name is not bound at all:
--             re-reading a parameter is not an evaluation
--   `twice`   two `?` in one expression are two tests in source order, the
--             second subject is not reached until the first passes, and the
--             payload of the first is pinned because the second hoists
import Node exposing (Program)
import String


pub maybe : String -> Maybe Int
maybe text =
    Just (String.toInt text? + 1)


pub result : Result String Int -> Result String String
result r =
    Ok (String.fromInt (r?))


pub atom : Maybe Int, Int -> Maybe Int
atom m offset =
    Just (m? + offset)


pub twice : Maybe Int, Maybe Int -> Maybe Int
twice a b =
    Just (a? + b?)


main : Program
main =
    Node.printLines []
