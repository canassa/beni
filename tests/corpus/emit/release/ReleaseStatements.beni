-- emit/release: research 47 §6's items 2, 3, 4 and 7 as release bytes
-- (`backend.md` §4, §6 and §8, amended 2026-10-02).
--
--   * `sum` is a loop that reassigns its parameters in place: `for(;;)`,
--     no label, no prologue, no `continue`, and `+`/`-` as operators;
--   * `twice`'s `let _ =`s are statements, the discarded `if` is an `if`,
--     and `say`, a private function whose result nothing reads, ends with
--     its last statement and no `return`;
--   * `quiet`'s pure discard is dropped whole, as its `const` was;
--   * `tick`'s `()` parameter is not written, and `tick ()` passes nothing.
--
-- `Debug.log` is the impure call, which `--allow-debug` lets a release
-- golden hold (this directory's README).
import Node exposing (Program)


pub sum : Int, Int -> Int
sum n acc =
    if n <= 0 then
        acc

    else
        sum (n - 1) (acc + n)


tick : () -> Int
tick () =
    7


say : Int -> ()
say n =
    let
        _ =
            Debug.log n "say"
    in
    ()


pub twice : Bool -> Int
twice c =
    let
        _ =
            say 1

        _ =
            if c then
                say (tick ())

            else
                ()
    in
    2


pub quiet : Int -> Int
quiet n =
    let
        _ =
            n * 2
    in
    n


main : Program
main =
    Node.printLines []
