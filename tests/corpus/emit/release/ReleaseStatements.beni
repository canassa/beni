-- emit/release: research 47 §6's items 2, 3, 4 and 7 as release bytes
-- (`backend.md` §4, §6 and §8, amended 2026-10-02).
--
--   * `sum` is a loop that reassigns its parameters in place: a `while`
--     whose header is the exit test and whose exit value follows it (§8,
--     *The exit test is the loop's header*), no label, no prologue, no
--     `continue`, and `+`/`-` as operators;
--   * `twice`'s `let _ =`s are statements, the discarded `if` is an `if`,
--     and `say`, a private function whose result nothing reads, ends with
--     its last statement and no `return`;
--   * `quiet`'s pure discard is dropped whole, as its `const` was;
--   * `tick`, called from one place, is written there as its `7` (§9, *A
--     function called once is written where it is called*); its `()`
--     parameter unwritten is `emit/UnitParameters`'s.
--
-- `Debug.log` is the impure call, which `--allow-debug` lets a release
-- golden hold (this directory's README).
import Node exposing (Program)


pub sum : Int, Int → Int
sum n acc =
    if n ≤ 0 then
        acc
    else
        sum (n - 1) (acc + n)


tick : ⊤ → Int
tick ⊤ = 7


say : Int → ⊤
say n =
    _ = Debug.log "say" n
    ⊤


pub twice : Bool → Int
twice c =
    say 1

    if c then
        say (tick ⊤)
    2


pub quiet : Int → Int
quiet n =
    _ = n * 2
    n


main : Program
main = Node.printLines []
