-- emit/release: a loop called once whose value is bound or discarded is
-- written where its call is (`backend.md` §9, *A function called once is
-- written where it is called*, amended 2026-10-02):
--
--   * `scan` binds `upTo`'s value: its exit writes no name of its own, since
--     every exit gives the loop's variable `k`, which `scan` then reads —
--     `while(…)c++;return c*2`;
--   * `fill` discards `fillFrom`'s: a `for` whose variable is declared in its
--     head, since nothing after the loop reads it;
--   * `ends` binds a tuple of `both`'s two variables: no tuple is built;
--   * `pick` binds `firstBig`'s, whose exits are not its variables: a
--     `let` the exits write, then `break`;
--   * `total` writes `rowSum`, a loop, inside `rows`, another.
import Js


pub scan : Js.Value, Int → Int
scan xs m =
    p = upTo xs m 0
    p * 2


upTo : Js.Value, Int, Int → Int
upTo xs m k =
    if k < m && not (Js.isNull (Js.at xs k)) then
        upTo xs m (k + 1)
    else
        k


pub fill : Js.Value, Int → Int
fill xs n =
    fillFrom xs n 0
    n


fillFrom : Js.Value, Int, Int → ⊤
fillFrom xs n k =
    if k == n then
        ⊤
    else
        _ = Js.call xs "push" [ Js.from k ]
        fillFrom xs n (k + 1)


pub ends : Js.Value, Int → Int
ends xs n =
    ( a, b ) = both xs 0 n
    a + b


both : Js.Value, Int, Int → Int × Int
both xs a b =
    if a < b && Js.same (Js.at xs a) (Js.at xs (b - 1)) then
        both xs (a + 1) (b - 1)
    else
        ( a, b )


pub pick : Js.Value → Int
pick xs =
    big = firstBig xs 0
    big + 1


firstBig : Js.Value, Int → Int
firstBig xs k =
    if k == Js.to (Js.get xs "length") then
        -1
    else if Js.to (Js.at xs k) > 9 then
        Js.to (Js.at xs k)
    else
        firstBig xs (k + 1)


pub total : Js.Value → Int
total rows = rowsFrom rows 0 0


rowsFrom : Js.Value, Int, Int → Int
rowsFrom rows r sum =
    if r == Js.to (Js.get rows "length") then
        sum
    else
        s = rowSum (Js.at rows r) 0 0
        rowsFrom rows (r + 1) (sum + s)


rowSum : Js.Value, Int, Int → Int
rowSum row k sum =
    if k == Js.to (Js.get row "length") then
        sum
    else
        rowSum row (k + 1) (sum + Js.to (Js.at row k))
