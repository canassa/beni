-- emit: a loop whose first statement leaves it is a `while` under
-- `--release` (`backend.md` §9, *Compact statements*, item 6): `gather`'s
-- loop is `while(a.firstChild!==null)b.appendChild(a.firstChild)`, its exit
-- at the end of a function that returns nothing written as nothing. Only
-- such a loop, and only with one statement left: `each` (two statements)
-- and `find` (whose exit returns a value after the loop) stay `for(;;)`,
-- since measured on the release corpus the wider rule cost 415 brotli bytes
-- against the `for(;;){if(` every other loop shares. `k = k + 1` is
-- `k+=1`. `settle`'s exit is not its first statement.
import Js


pub gather : Js.Value, Js.Value -> ()
gather from into =
    if Js.isNull (Js.get from "firstChild") then
        ()
    else
        _ = Js.call into "appendChild" [ Js.get from "firstChild" ]
        gather from into


pub each : Js.Value, Int -> ()
each fs k =
    if k == Js.to (Js.get fs "length") then
        ()
    else
        _ = Js.apply (Js.at fs k) []
        each fs (k + 1)


pub find : Js.Value, Int -> Int
find xs k =
    if Js.isNull (Js.at xs k) then
        k
    else
        find xs (k + 2)


pub settle : Js.Value, Js.Value -> ()
settle n end =
    next = Js.get n "nextSibling"

    _ = Js.call n "remove" []
    if Js.same n end then
        ()
    else
        settle next end
