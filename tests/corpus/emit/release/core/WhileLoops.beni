-- emit: a loop whose first statement leaves it is a `while` under
-- `--release` (`backend.md` §9, *Compact statements*, item 6): `gather`'s
-- loop is `while(a.firstChild!==null)b.appendChild(a.firstChild)` and
-- `each`'s `while(b!==a.length){…}`, their exits at the end of a function
-- that returns nothing written as nothing; `find`'s exit returns a value,
-- written after the loop. `k = k + 1` is `k+=1`. `settle`'s exit is not its
-- first statement, so it stays `for(;;)`.
import Js


pub gather : Js.Value, Js.Value -> ()
gather from into =
    if Js.isNull (Js.get from "firstChild") then
        ()

    else
        let
            _ =
                Js.call into "appendChild" [ Js.get from "firstChild" ]
        in
        gather from into


pub each : Js.Value, Int -> ()
each fs k =
    if k == Js.to (Js.get fs "length") then
        ()

    else
        let
            _ =
                Js.apply (Js.at fs k) []
        in
        each fs (k + 1)


pub find : Js.Value, Int -> Int
find xs k =
    if Js.isNull (Js.at xs k) then
        k

    else
        find xs (k + 2)


pub settle : Js.Value, Js.Value -> ()
settle n end =
    let
        next =
            Js.get n "nextSibling"

        _ =
            Js.call n "remove" []
    in
    if Js.same n end then
        ()

    else
        settle next end
