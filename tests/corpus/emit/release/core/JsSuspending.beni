-- emit: `Js.suspending λ() → body` is its body (`backend.md` §4,
-- *`Js.suspending` is its body*), and a call of it may suspend. In tail
-- position (`park`) the body's value is returned as it is, with no
-- comparison. In a value position (`inValue`) and a discarded one
-- (`discarded`) it is a suspension point: the rest of the function is its
-- continuation, handed to `Task.andThen`. Passed as a value (`passed`) it
-- is the sibling's function, called with the lambda. Each body reads a
-- value the compiler cannot see, so no build folds the suspension away.
import Js


pub park : Js.Value → Int
park v = Js.suspending λ⊤ → Js.to v


pub inValue : Js.Value → Int
inValue v =
    n = Js.suspending λ⊤ → Js.to v
    n + 1


pub discarded : Js.Value → Int
discarded v =
    _ = Js.suspending λ⊤ → Js.to v
    4


pub passed : ⊤ → (sync (⊤ → Int) → Int)
passed ⊤ = Js.suspending
