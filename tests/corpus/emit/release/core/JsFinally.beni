-- emit: `Js.finally` is `try { … } finally { … }` (`boundary.md` §4.2;
-- `backend.md` §4, *`Js.finally` is `try … finally`*). Called with lambdas,
-- each lambda's body is its block and no function is made: `guard` is the
-- effects host's latch, the body discarded; `render` returns its value from
-- inside the guard, in tail position; `measured` binds it to a `let` the
-- body assigns. With functions passed in, the blocks call them.
import Js


busy : Js.Ref Bool
busy = Js.ref False


pub guard : Js.Value -> ()
guard queue =
    _ = Js.write busy True

    _ = Js.finally (λ() -> Js.each queue λf -> Js.to (Js.apply f [])) λ() -> Js.write busy False
    Js.set queue "length" (Js.from 0)


pub render : Js.Value -> Js.Value
render view =
    if Js.read busy then
        Js.null
    else
        _ = Js.write busy True
        Js.finally (λ() -> Js.apply view []) λ() -> Js.write busy False


pub measured : Js.Value -> String
measured node =
    width : Int
    width = Js.finally (λ() -> Js.to (Js.get node "offsetWidth")) λ() -> Js.write busy False
    "${String.fromInt width}px"


pub passed : (() -> Int), (() -> ()) -> Int
passed f g = Js.finally f g
