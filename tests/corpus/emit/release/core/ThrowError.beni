-- emit: an error is one inline `throw new Error(…)` (`backend.md` §9,
-- *Compact statements*, item 7). `Js.construct` is `new C(…)`, and `Error`
-- is its bare name; the message, an `else if` chain whose value is the
-- argument, is one nested conditional under `--release` rather than a
-- temporary each arm assigns; and a function returning on both sides of
-- one `if` is a concise conditional (`label`).
import Js


pub refuse : Js.Value, Js.Value -> ()
refuse m root =
    id : String
    id = Js.to (Js.get m "n")
    if Js.isNull root || not (Js.isUndefined (Js.get root "$$root")) then
        Js.throw
            (Js.construct (Js.global "Error")
                [ Js.from
                    (if Js.isNull root then
                        "no element has the id \"${id}\""
                     else if Js.isNull (Js.get m "n") then
                        "the body is taken"
                     else
                        "the element \"${id}\" is taken"
                    )
                ]
            )
    else
        ()


pub label : Int -> String
label n =
    if n < 0 then
        "minus"
    else if n == 0 then
        "zero"
    else
        "plus"
