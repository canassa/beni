-- The `dom` lowering under `--release` (backend.md §15.7). Kinds,
-- templates and runtime imports take short names as every top-level name
-- does, walks as the locals they are; property names — `data`, `$$click`,
-- a block's `t` and `v`, an instance's fields — are never renamed. A walk
-- used once is folded into its use when nothing is evaluated between them,
-- which holds by construction: every walk comes before the first write.
-- A record update stays a spread, so an untouched field keeps its
-- identity, which the kind's `p` compares by (§15.8).
import Html exposing (Html)


type Msg
    = Pick Int


pub row : { id : Int, label : String } -> Html Msg
row r = <tr><td><a onClick={Pick r.id}>{r.label}</a></td></tr>


pub rename : { id : Int, label : String } -> { id : Int, label : String }
rename r = { r | label = "x" }
