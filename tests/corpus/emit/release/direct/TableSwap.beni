-- The table app's shapes under `--release`, the lean slice
-- (browser-direct.md, *Amended 2026-10-11 (the lean slice, as specified)*):
-- the swap, an `indexedMap` with index guards, is one `exchange` of two
-- rows checked after both writes; the buttons, a helper called with
-- constants, are each one call of the shared `on` with the key's handler;
-- the rows carry their list's number, not its descriptor, so the
-- descriptor is the program's own and the runtime it reaches is written
-- for it — no test of `o` or `i`, the end marker's `null` folded. The
-- dispatch guard keeps its queue, as on every page.
import Html exposing (Html)
import Tea


type Msg
    = Swap
    | Clear
    | Select Int
    | Remove Int


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    selected : Maybe Int


swap : List Row → List Row
swap rows =
    case ( List.get rows 1, List.get rows 3 ) of
        ( Just a, Just b ) →
            List.indexedMap rows λi row → if i == 1 then b else if i == 3 then a else row

        _ →
            rows


update : Msg, Model → Model
update msg model =
    case msg of
        Swap →
            { model | rows = swap model.rows }

        Clear →
            { model | rows = [] }

        Select id →
            { model | selected = Just id }

        Remove id →
            { model | rows = List.filter model.rows λrow → row.id ≠ id }


button : String, Msg → Html Msg
button label msg = <button onClick={msg}>{label}</button>


view : Model → Html Msg
view model =
    <main>
        {button "swap" Swap}
        {button "clear" Clear}
        <table>
            <tbody>
                <For each={model.rows} keyed={.id}>
                    {λrow →
                        <tr class={if model.selected == Just row.id then "danger" else ""}>
                            <td><a onClick={Select row.id}>{row.label}</a></td>
                            <td><a onClick={Remove row.id}>x</a></td>
                        </tr>
                    }
                </For>
            </tbody>
        </table>
    </main>


main : Tea.Program
main =
    Tea.sandbox
        { init =
            { rows =
                [ { id = 1, label = "a" }
                , { id = 2, label = "b" }
                , { id = 3, label = "c" }
                , { id = 4, label = "d" }
                ]
            , selected = Nothing
            }
        , update = update
        , view = view
        }
