-- A release build's hydrating mount (docs/design/prerender.md §6.4, amended
-- 2026-10-29, #1186): the tags handed to `take` are every element's, the
-- `<h1>` that no code refers to included, as in a development build — the
-- table is by index, and an element no code refers to moves those code
-- does; `take`, its merge and its checks are in the one file, with no
-- warning: the development build's prose is not shipped.
import Html exposing (Html)
import Tea


type alias Model =
    open : Bool


type Msg
    = Toggle


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | open = not model.open }


view : Model → Html Msg
view model =
    <div onClick={Toggle}>
        <h1>Title</h1>
        {if model.open then <p>Open</p> else <></>}
    </div>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { open = False }, update = update, view = view }
