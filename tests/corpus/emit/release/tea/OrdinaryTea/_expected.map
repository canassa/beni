--! Fibers: functions that may wait, running side by side
--! (`transparent-effects-proposal.md` §16).
--!
--! A beni function that may wait for something — a timer, a network reply,
--! another fiber — is written like any other function. The compiler infers
--! that it may suspend and emits it so that it can stop in the middle and be
--! resumed later; nothing in the source says so. This module is what such
--! functions run on: a fiber is one line of execution, and many fibers take
--! turns on one JavaScript thread.
--!
--! **Structured.** A fiber started with `spawn` belongs to the fiber that
--! started it and is cancelled when that one ends; one started in a `scope`
--! belongs to the scope and is cancelled, and waited for, when the scope's
--! function returns. Nothing a fiber starts outlives what started it unless
--! it is joined first.
--!
--! **Cancellation is prompt and cleanup is guaranteed.** A fiber that is
--! waiting when it is cancelled stops waiting at once; the release of every
--! `bracket` it is inside runs, last first, before `cancel` returns.
--! Cancellation is delivered only where a fiber may suspend, so a function
--! that never waits is never interrupted in the middle.
--!
--! **A defect ends the program.** There are no exceptions: a failure you
--! expect is a `Result`, and a fiber ends either `Done` with its value or
--! `Cancelled`.

-- Typed controls store closed unit jobs. Each job retains its callback and
-- matching result destination; native resources stay in Js.Runtime's sibling.

import Duration exposing (Duration)
import Js
import Js.Runtime as Runtime
import List
import Record
import Schedule exposing (Schedule)


--| How a fiber ended.
pub type Exit a
    = Done a
    | Cancelled


--| A fiber that is running, or has ended. `join` waits for its value.
pub opaque type Fiber a
    = Fiber Control (Js.Ref (Maybe (Exit a)))


--| How a platform's primitive resumes the fiber that waits on it, once: a
--| JavaScript function the platform calls with the value.
pub opaque type Resume a
    = Resume (a → ⊤)


-- Closed protocol steps retain their original work and typed destinations
-- in their environments. True means the step completed without parking.
type alias UnitJob =
    (⊤ → ⊤) → Bool


type Frame
    = Execute (⊤ → ⊤)
    | Boundary


type Control
    = Control
        { stack : Chain Frame
        , finalizers : Chain UnitJob
        , observers : Chain (⊤ → ⊤)
        , children : Chain Control
        , interrupted : Js.Ref Bool
        , unwinding : Js.Ref Bool
        , registered : Js.Ref Bool
        , ended : Js.Ref Bool
        , masks : Js.Ref Int
        , parked : Js.Ref (Maybe Wait)
        , slots : Js.Ref Slots
        , member : Js.Ref (Maybe Scheduler)
        , unlinks : Chain (⊤ → ⊤)
        , cancelled : ⊤ → ⊤
        , cleaning : Js.Ref (Maybe (Link Control))
        }


type Wait
    = Wait { stopWait : Js.Ref (⊤ → ⊤), done : Js.Ref Bool }


type Pending
    = Pending Bool (Maybe Wait)


--| The fibers a `scope` started. It is cancelled, and waited for, when the
--| scope's function returns.
pub opaque type Scope
    = Scope
        { children : Chain Control
        , closed : Js.Ref Bool
        , deferred : Chain (Exit ⊤ → UnitJob)
        , finalizer : Js.Ref (Maybe (Control × Link UnitJob))
        , root : Bool
        , listed : Js.Ref (Maybe (Scheduler × Link Root))
        }


type Root
    = RootScope Scope
    | RootFiber Control


--| Work queued to run once, in no fiber, where a fiber started now would
--| first run: `soon` makes one, and it is `queued` until it has run.
pub opaque type Soon
    = Soon
        { work : Js.Ref (Maybe (⊤ → ⊤))
        , children : Chain Control
        , sched : Scheduler
        }


--| What `restore` is handed: a way back, inside an `uninterruptibleMask`,
--| to the interruptibility there was where the mask was entered.
pub opaque type Restore
    = Restore { depth : Int, fiber : Control, live : Js.Ref Bool }


pub opaque type VirtualClock
    = VirtualClock { now : Js.Ref Int, sleepers : Chain Sleeper }


type Sleeper
    = Sleeper Int (Resume ⊤)


type alias Slots =
    clock : Maybe VirtualClock
    sched : Maybe Scheduler
    log : Maybe (⊤ → ⊤)
    seed : Maybe Int


--| A scheduler of its own: a queue of ready fibers drained apart from the
--| program's, by a drain its maker queues. A fiber whose scheduler slot
--| names one (`withScheduler`) is resumed through it and never through the
--| program's queue, and a defect under it stops that scheduler alone — its
--| fibers are cancelled and their cleanup run, and nothing else is touched.
--| What a platform gives each request or each object a runtime of its own
--| with; a program may make one too.
pub opaque type Scheduler
    = Scheduler
        { queue : JobQueue
        , scheduled : Js.Ref Bool
        , queuing : Js.Ref Bool
        , runner : (⊤ → ⊤) → ⊤
        , more : (⊤ → ⊤) → ⊤
        , hook : Js.Ref (Maybe (⊤ → ⊤))
        , turn : Js.Ref (Maybe ((⊤ → ⊤) → ⊤))
        , roots : Chain Root
        , members : Chain Control
        , loans : Chain Loan
        , live : Js.Ref Int
        , idle : Js.Ref (Maybe (⊤ → ⊤))
        , watch : Js.Ref (Maybe (Int → ⊤))
        , phase : Js.Ref Int
        , culprit : Js.Ref (Maybe Control)
        , done : Js.Ref (Maybe (Int → ⊤))
        , deadline : Js.Ref Int
        , timer : Js.Ref (Maybe (⊤ → ⊤))
        , expired : Js.Ref Bool
        , abandoned : Js.Ref Int
        , sweeping : Chain Control
        , torn : Js.Ref Bool
        , listed : Js.Ref (Maybe (Link Scheduler))
        , program : Bool
        }


emptySlots : Slots
emptySlots = { clock = Nothing, sched = Nothing, log = Nothing, seed = Nothing }


current : Js.Ref (Maybe Control)
current = Js.ref Nothing


outside : Js.Ref (Maybe Control)
outside = Js.ref Nothing


pending : Js.Ref (Maybe Pending)
pending = Js.ref Nothing


soonRunning : Js.Ref (Maybe Soon)
soonRunning = Js.ref Nothing


cleaning : Chain Control
cleaning = newChain ⊤


schedulers : Chain Scheduler
schedulers = newChain ⊤


fibered : Js.Ref Bool
fibered = Js.ref False


sentinel : Js.Value
sentinel = Runtime.parked ⊤


--| Used by the code the compiler emits, and by nothing else: always `False`
--| for any value a program can hold.
pub isWaiting : a → Bool
isWaiting value = Js.same value sentinel


-- Source calls are ordinary application. Only compiler-generated callers
-- can hand the sentinel to this compatibility operation.
--| Used by the code the compiler emits for a function that may suspend, and
--| by nothing else: `andThen value next` is `next value`. Calling it by hand
--| is allowed and does exactly that. Its effects include those of `next`.
pub andThen : a, sync (a → b) → b
andThen value next = next value


chain : a, (a → b), sync (b → ⊤) → b
chain value next done = if isWaiting value then Runtime.parked ⊤ else Js.invoke next value done


continueWith : (a → b), a, sync (b → ⊤) → ⊤
continueWith next value done =
    pushFrame
        (here ⊤)
        (Execute λ⊤ →
            result = Js.invoke next value done
            if isWaiting result then ⊤ else done result
        )


unitJob : (⊤ → ⊤) → UnitJob
unitJob work = λdone → not (isWaiting (Js.invoke work ⊤ done))


runUnitJob : UnitJob → ⊤
runUnitJob job = Js.suspending λ⊤ →
    if Js.invoke job (Js.completion ⊤) λ_ → ⊤ then ⊤ else Runtime.parked ⊤


pushFrame : Control, Frame → ⊤
pushFrame (Control c) frame = pushStep c.stack frame


newControl : Slots, sync (⊤ → ⊤) → Control
newControl slots cancelled =
    Js.write fibered True
    Control
        { stack = newChain ⊤
        , finalizers = newChain ⊤
        , observers = newChain ⊤
        , children = newChain ⊤
        , interrupted = Js.ref False
        , unwinding = Js.ref False
        , registered = Js.ref False
        , ended = Js.ref False
        , masks = Js.ref 0
        , parked = Js.ref Nothing
        , slots = Js.ref slots
        , member = Js.ref Nothing
        , unlinks = newChain ⊤
        , cancelled = cancelled
        , cleaning = Js.ref Nothing
        }


here : ⊤ → Control
here ⊤ =
    case Js.read current of
        Just fiber →
            fiber
        Nothing →
            case Js.read outside of
                Just fiber →
                    fiber
                Nothing →
                    made = newControl emptySlots λ⊤ → ⊤
                    Js.write outside (Just made)
                    made


slotsOf : Maybe Control → Slots
slotsOf fiber =
    case fiber of
        Nothing →
            emptySlots
        Just (Control c) →
            Js.read c.slots


currentSlots : ⊤ → Slots
currentSlots ⊤ =
    case Js.read current of
        Nothing →
            slotsOf (Js.read outside)
        fiber →
            slotsOf fiber


endedControl : Control → Bool
endedControl (Control c) = Js.read c.ended


interrupted : Control → Bool
interrupted (Control c) = Js.read c.interrupted && Js.read c.masks == 0 && not (Js.read c.unwinding)


--| Wait for a platform's callback: the one way a fiber suspends. The
--| function is called at once with the `Resume` the platform hands its host
--| callback, and returns what cancels the wait. When the host calls back
--| before the function returns, nothing waits at all.
--|
--|     sleep ms =
--|         Task.callback λresume → startTimer ms resume
pub callback : sync (Resume a → sync (⊤ → ⊤)) → a
callback register = Js.suspending λ⊤ → callbackWith register (Js.completion ⊤) False


callbackWith : sync (Resume a → sync (⊤ → ⊤)), sync (a → ⊤), Bool → a
callbackWith register done later =
    fiber = here ⊤
    if interrupted fiber then
        Js.write pending (Just (Pending True Nothing))
        Runtime.parked ⊤
    else
        ready = Js.ref Nothing
        synchronous = Js.ref (not later)
        waiting = Wait { stopWait = Js.ref λ⊤ → ⊤, done = Js.ref False }
        (Wait w) = waiting
        wake =
            λvalue →
                if Js.read w.done then
                    ⊤
                else
                    Js.write w.done True
                    if Js.read synchronous then
                        Js.write ready (Just value)
                    else
                        pushFrame fiber (Execute λ⊤ → done value)
                        enqueue fiber (Just waiting)
        stopWait = register (Resume wake)
        Js.write synchronous False
        case Js.read ready of
            Just value →
                value
            Nothing →
                Js.write w.stopWait stopWait
                Js.write pending (Just (Pending False (Just waiting)))
                Runtime.parked ⊤


--| Answer the wait `resume` belongs to with `value`: the fiber that waits
--| is queued to go on with it, and runs at a later turn, never inside this
--| call. Once only: a second `resume` of the same wait does nothing, and so
--| does one after the waiting fiber was cancelled. Called while the
--| function `callback` was given is still running, it answers the wait at
--| once and nothing waits at all.
--|
--| What lets a program finish a wait it started itself, and so write its
--| own coordination — a gate, a mailbox — over `callback` and a `Ref`.
--|
--|     gate = Ref.make Nothing
--|     opened = Task.spawn λ⊤ → Task.callback λr →
--|         _ = Ref.set gate (Just r)
--|         λ⊤ → Ref.set gate Nothing
--|     -- later, from another fiber:
--|     case Ref.get gate of
--|         Just r → Task.resume r "open"
--|         Nothing → ⊤
pub resume : Resume a, a → ⊤
resume (Resume wake) value =
    Js.invoke wake value λ_ → ⊤
    ⊤


--| Let every other fiber that is ready run first.
pub yieldNow : ⊤ → ⊤
yieldNow ⊤ = Js.suspending λ⊤ →
    callbackWith
        (λwake →
            resume wake ⊤
            λ⊤ → ⊤
        )
        (Js.completion ⊤)
        True


--| Wait forever. Only cancelling the fiber ends the wait. Effect's `never`.
pub never : ⊤ → a
never ⊤ = callback λ_ → λ⊤ → ⊤


selfCancel : ⊤ → a
selfCancel ⊤ = Js.suspending λ⊤ →
    Js.write pending (Just (Pending True Nothing))
    Runtime.parked ⊤


runFiber : Control → ⊤
runFiber ((Control c) as fiber) =
    outer = Js.read current
    Js.write current (Just fiber)
    Js.write c.parked Nothing
    runLoop fiber
    Js.write current outer


runLoop : Control → ⊤
runLoop ((Control c) as fiber) =
    if interrupted fiber then unwind fiber
    if Js.read c.ended then
        ⊤
    else
        case popChain c.stack of
            Nothing →
                ⊤
            Just Boundary →
                leaveCleanup fiber
                runLoop fiber
            Just (Execute work) →
                Js.invoke work ⊤ λ_ → ⊤
                if Js.read c.ended then
                    ⊤
                else
                    case Js.read pending of
                        Nothing →
                            runLoop fiber
                        Just (Pending stop waiting) →
                            Js.write pending Nothing
                            if stop then
                                unwind fiber
                                runLoop fiber
                            else if inCleanup fiber && deadlinePassed fiber then
                                abandon fiber waiting
                                runLoop fiber
                            else
                                Js.write c.parked waiting


unwind : Control → ⊤
unwind ((Control c) as fiber) =
    Js.write c.unwinding True
    Js.write c.parked Nothing
    clearChain c.stack
    pushFrame
        fiber
        (Execute
            (driverJob λ⊤ →
                cancelChildren fiber
                c.cancelled ⊤
                complete fiber
            )
        )
    cleanups fiber
    pushFrame fiber (Execute (driverJob λ⊤ → cancelChildren fiber))


driverJob : (⊤ → ⊤) → (⊤ → ⊤)
driverJob work =
    λ⊤ →
        Js.invoke work ⊤ λ⊤ → ⊤
        ⊤


cleanups : Control → ⊤
cleanups ((Control c) as fiber) =
    case shiftChain c.finalizers of
        Nothing →
            ⊤
        Just fin →
            pushFrame fiber Boundary
            pushFrame
                fiber
                (Execute λ⊤ →
                    enterCleanup fiber
                    _ = Js.invoke fin (λ⊤ → ⊤) λ_ → ⊤
                    ⊤
                )
            cleanups fiber


enterCleanup : Control → ⊤
enterCleanup ((Control c) as fiber) =
    case Js.read c.cleaning of
        Nothing →
            Js.write c.cleaning (Just (appendLink cleaning fiber))
        Just _ →
            ⊤


leaveCleanup : Control → ⊤
leaveCleanup (Control c) =
    case Js.read c.cleaning of
        Nothing →
            ⊤
        Just token →
            _ = removeLink cleaning token
            Js.write c.cleaning Nothing


inCleanup : Control → Bool
inCleanup (Control c) =
    case Js.read c.cleaning of
        Nothing →
            False
        Just _ →
            True


cutBack : Control → ⊤
cutBack ((Control c) as fiber) =
    popBoundary c.stack
    leaveCleanup fiber
    cleanups fiber


popBoundary : Chain Frame → ⊤
popBoundary stack =
    case popChain stack of
        Nothing →
            ⊤
        Just Boundary →
            ⊤
        Just (Execute _) →
            popBoundary stack


halt : Control → ⊤
halt ((Control c) as fiber) =
    if Js.read c.ended || Js.read c.unwinding then
        ⊤
    else
        Js.write c.interrupted True
        case Js.read c.parked of
            Nothing →
                ⊤
            Just (Wait waiting) →
                if Js.read c.masks == 0 then
                    Js.write c.parked Nothing
                    Js.write waiting.done True
                    enqueue fiber Nothing
                    (Js.read waiting.stopWait) ⊤


complete : Control → ⊤
complete ((Control c) as fiber) =
    Js.write c.ended True
    clearChain c.stack
    leaveCleanup fiber
    runJobs c.unlinks
    runJobs c.observers
    if Js.read c.registered then
        case Js.read c.member of
            Nothing →
                ⊤
            Just sched →
                countDown sched
        countDown program


runJobs : Chain (⊤ → ⊤) → ⊤
runJobs jobs =
    case shiftChain jobs of
        Nothing →
            ⊤
        Just job →
            Js.invoke job ⊤ λ_ → ⊤
            runJobs jobs


cancelChildren : Control → ⊤
cancelChildren (Control c) = cancelControls (chainList c.children)


cancelControls : List Control → ⊤
cancelControls fibers =
    each fibers halt
    waitControls fibers


waitControls : List Control → ⊤
waitControls fibers =
    if List.all fibers endedControl then
        ⊤
    else
        callback λwake →
            listeners = newChain ⊤
            remaining = Js.ref 0
            each fibers λfiber →
                if endedControl fiber then
                    ⊤
                else
                    (Control c) = fiber
                    Js.write remaining (Js.read remaining + 1)
                    token = appendLink c.observers λ⊤ →
                        left = Js.read remaining - 1
                        Js.write remaining left
                        if left == 0 then resume wake ⊤
                    pushStep listeners λ⊤ →
                        _ = removeLink c.observers token
                        ⊤
            λ⊤ → runJobs listeners


makeFiber : Slots, (⊤ → a) → Fiber a
makeFiber slots work =
    result = Js.ref Nothing
    fiber = newControl slots λ⊤ → Js.write result (Just Cancelled)
    (Control c) = fiber
    pushFrame
        fiber
        (Execute
            (driverJob λ⊤ →
                value = work ⊤
                Js.write c.unwinding True
                cancelChildren fiber
                Js.write result (Just (Done value))
                complete fiber
            )
        )
    Fiber fiber result


--| How a fiber ended, `Just` once it has and `Nothing` while it runs,
--| without waiting. A fiber that is cancelled but still running its cleanup
--| is running.
pub poll : Fiber a → Maybe (Exit a)
poll (Fiber _ result) = Js.read result


--| Whether a fiber is still running: `False` once it has ended, either
--| way. A fiber that has been cancelled but is still running its cleanup
--| is still running.
pub running : Fiber a → Bool
running (Fiber fiber _) = not (endedControl fiber)


--| Wait for a fiber to end, and say how.
pub wait : Fiber a → Exit a
wait (Fiber (Control c) result) =
    case Js.read result of
        Just value →
            value
        Nothing →
            callback λwake →
                token = appendLink c.observers λ⊤ →
                    case Js.read result of
                        Nothing →
                            ⊤
                        Just value →
                            resume wake value
                λ⊤ →
                    _ = removeLink c.observers token
                    ⊤


--| Wait for a fiber's value. If it was cancelled, the fiber that joins it is
--| cancelled too.
pub join : Fiber a → a
join fiber =
    case wait fiber of
        Done value →
            value
        Cancelled →
            selfCancel ⊤


--| Cancel a fiber and wait until its cleanup has run. Cancelling a fiber
--| that has ended does nothing.
pub cancel : Fiber a → ⊤
cancel (Fiber fiber _) =
    halt fiber
    waitControls [ fiber ]


--| Wait for every fiber in the list, then answer their values, in list
--| order. If any of them was cancelled, the fiber that waits is cancelled
--| too, as `join` of that one would — but only once every fiber has ended.
--| A fiber named twice is waited for once and its value given twice.
pub joinAll : List (Fiber a) → List a
joinAll fibers =
    waitControls (List.map fibers λ(Fiber fiber _) → fiber)
    List.map fibers join


--| Cancel every fiber in the list, in list order, and wait until all of
--| them have ended and run their cleanup. A fiber that has ended is left
--| as it is; a fiber that belongs to a scope still belongs to it.
pub cancelAll : List (Fiber a) → ⊤
cancelAll fibers = cancelControls (List.map fibers λ(Fiber fiber _) → fiber)


--| Run `work` again and again. It ends only when the fiber is cancelled,
--| and then the cleanup of the run in progress runs, as for any other
--| cancelled work. After each run it lets every other ready fiber run
--| first, as `yieldNow` does, so a `work` that never waits cannot starve
--| them and can still be cancelled. A loop of any length uses no stack.
--| Effect's `forever`.
--|
--|     _ = Task.spawn λ⊤ → Task.forever λ⊤ →
--|         Latch.wait ready
--|         tick ⊤
--|
--| A loop that should stop is not a `forever`. A loop over a `Queue`
--| that can end is a recursive function that stops on `Nothing`:
--|
--|     work jobs = case Queue.take jobs of
--|         Just job → handle job; work jobs
--|         Nothing → ⊤
pub forever : (⊤ → a) → b
forever work =
    _ = work ⊤
    yieldNow ⊤
    forever work


type Jobs
    = JobEnd
    | JobNext (⊤ → Bool) (Js.Ref Jobs)


type alias JobQueue =
    first : Js.Ref (Js.Ref Jobs)
    last : Js.Ref (Js.Ref Jobs)


newJobs : ⊤ → JobQueue
newJobs ⊤ =
    end = Js.ref JobEnd
    { first = Js.ref end, last = Js.ref end }


pushJob : JobQueue, sync (⊤ → Bool) → ⊤
pushJob q job =
    end = Js.ref JobEnd
    Js.write (Js.read q.last) (JobNext job end)
    Js.write q.last end


jobsEmpty : JobQueue → Bool
jobsEmpty q =
    case Js.read (Js.read q.first) of
        JobEnd →
            True
        JobNext _ _ →
            False


hosting : Js.Ref Bool
hosting = Js.ref False


program : Scheduler
program = newScheduler queueMicrotask macrotask True


newScheduler : sync ((⊤ → ⊤) → ⊤), sync ((⊤ → ⊤) → ⊤), Bool → Scheduler
newScheduler runner more root =
    Scheduler
        { queue = newJobs ⊤
        , scheduled = Js.ref False
        , queuing = Js.ref False
        , runner = runner
        , more = more
        , hook = Js.ref Nothing
        , turn = Js.ref Nothing
        , roots = newChain ⊤
        , members = newChain ⊤
        , loans = newChain ⊤
        , live = Js.ref 0
        , idle = Js.ref Nothing
        , watch = Js.ref Nothing
        , phase = Js.ref 0
        , culprit = Js.ref Nothing
        , done = Js.ref Nothing
        , deadline = Js.ref 0
        , timer = Js.ref Nothing
        , expired = Js.ref False
        , abandoned = Js.ref 0
        , sweeping = newChain ⊤
        , torn = Js.ref False
        , listed = Js.ref Nothing
        , program = root
        }


queueMicrotask : sync (⊤ → ⊤) → ⊤
queueMicrotask task = Runtime.microtask task


macrotask : sync (⊤ → ⊤) → ⊤
macrotask task = Runtime.macrotask task


schedulerHere : ⊤ → Scheduler
schedulerHere ⊤ =
    case (currentSlots ⊤).sched of
        Nothing →
            program
        Just sched →
            sched


schedulerOf : Control → Scheduler
schedulerOf (Control c) =
    case (Js.read c.slots).sched of
        Nothing →
            program
        Just sched →
            sched


stopped : Scheduler → Bool
stopped (Scheduler s) = Js.read s.phase ≠ 0


endedScheduler : Scheduler → Bool
endedScheduler (Scheduler s) = Js.read s.phase == 3


enqueue : Control, Maybe Wait → ⊤
enqueue ((Control c) as fiber) waiting =
    sched = schedulerOf fiber
    target = if endedScheduler sched then program else sched
    if endedScheduler sched then Js.write c.interrupted True
    scheduleOn target λ⊤ →
        valid =
            case waiting of
                Nothing →
                    True
                Just expected →
                    case Js.read c.parked of
                        Nothing →
                            False
                        Just actual →
                            Js.same actual expected
        if valid then
            runFiber fiber
            True
        else
            False


scheduleOn : Scheduler, sync (⊤ → Bool) → ⊤
scheduleOn ((Scheduler s) as sched) task =
    pushJob s.queue task
    if not (Js.read s.scheduled) then
        Js.write s.scheduled True
        if s.program && Js.read hosting then ⊤ else requeue sched λ⊤ → drain sched


-- The host scheduler retains this closed drain. Its captures escape; the
-- scheduler handle can be retained with it; mutable state is behind Js.Ref.
requeue : escaped Scheduler, escaped sync (⊤ → ⊤) → ⊤
requeue (Scheduler s) task =
    Js.write s.queuing True
    s.runner task
    Js.write s.queuing False


--| How the platform runs each drain of the scheduler: `f` is handed the
--| drain and calls it once, at once. The browser's makes the drain a
--| turn, so the messages its fibers send render when it returns
--| (`backend.md` §15.11), not on a microtask after it. The last one given
--| is the one used.
pub onTurn : sync ((⊤ → ⊤) → ⊤) → ⊤
onTurn around =
    (Scheduler s) = program
    Js.write s.turn (Just around)


--| Run `f`, a callback the platform registered with its host — a timer's,
--| a promise reaction's — which the host calls with nothing beneath it:
--| the fibers it resumes run when it returns, in the same callback, where
--| they would have run on the microtask after it. Never for a callback
--| the host may call while other code runs, such as an event's listener.
pub fromHost : sync (⊤ → ⊤) → ⊤
fromHost work =
    (Scheduler s) = program
    if Js.read s.scheduled then
        work ⊤
    else
        Js.write hosting True
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                work ⊤
                Js.write ok True
            )
            λ⊤ →
                Js.write hosting False
                if not (Js.read ok) && Js.read s.scheduled then queueMicrotask λ⊤ → drain program
        if Js.read s.scheduled then drain program


--| What runs when a fiber throws: a defect, after which no program code runs
--| again (`boundary.md` §9.8.10 (c)). A platform hands it what stops its
--| program — the browser stops the page — and the throw goes on to the
--| host; then every fiber is cancelled and its cleanup run, as `shutdown`
--| does (§9.8.14). The last one given is the one called.
pub onDefect : sync (⊤ → ⊤) → ⊤
onDefect hook =
    (Scheduler s) = program
    Js.write s.hook (Just hook)


releases : Chain (⊤ → ⊤)
releases = newChain ⊤


--| Call `f` once, when the runtime stops (`shutdown`): in a microtask
--| queued at the stop, so after the throw that stopped it has gone on to
--| the host and before any fiber's cleanup, the functions given first
--| called first. What a platform releases a host resource no fiber
--| holds with — a listener a subscription added with no fiber
--| (`boundary.md` §9.8.5); a program never needs it.
pub onShutdown : sync (⊤ → ⊤) → ⊤
onShutdown release = pushStep releases release


drain : Scheduler → ⊤
drain ((Scheduler s) as sched) =
    if Js.read s.queuing then
        Runtime.defect
            "a scheduler's run called its drain during the call; it must queue it to run later (Task.schedulerWith)"
    else
        case Js.read s.turn of
            Nothing →
                drainNow sched
            Just around →
                around λ⊤ → drainNow sched


drainNow : Scheduler → ⊤
drainNow ((Scheduler s) as sched) =
    if Js.bitAnd (Js.read s.phase) 1 ≠ 0 then
        ⊤
    else
        ok = Js.ref False
        emptied =
            Js.finally
                (λ⊤ →
                    value = drainFrom sched 0
                    Js.write ok True
                    value
                )
                λ⊤ → if Js.read ok then ⊤ else failed sched
        if emptied then Js.write s.scheduled False


drainFrom : Scheduler, Int → Bool
drainFrom ((Scheduler s) as sched) count =
    case Js.read (Js.read s.queue.first) of
        JobEnd →
            True
        JobNext task next →
            if count == 64 || Js.read s.phase == 1 then
                if s.program || count == 64 then
                    s.more λ⊤ → drain sched
                else
                    requeue sched λ⊤ → drain sched
                False
            else
                Js.write s.queue.first next
                result = Js.invoke task ⊤ λ_ → ⊤
                drainFrom sched (if result then count + 1 else count)


failed : Scheduler → ⊤
failed ((Scheduler s) as sched) =
    fiber = Js.read current
    Js.write current Nothing
    Js.write pending Nothing
    Js.write soonRunning Nothing
    case Js.read outside of
        Nothing →
            ⊤
        Just (Control c) →
            Js.write c.masks 0
    if Js.read s.phase < 2 then
        Js.write s.culprit fiber
        stopping sched
        case Js.read s.hook of
            Nothing →
                ⊤
            Just hook →
                hook ⊤
    else
        case fiber of
            Nothing →
                ⊤
            Just control →
                if not (endedControl control) then
                    recover control
                    enqueue control Nothing
        if s.program then macrotask λ⊤ → drain sched else requeue sched λ⊤ → drain sched


--| A scheduler for a platform: `run` is called once per batch of ready
--| work, with the drain, and must run it later — in a microtask, a promise
--| reaction, a host callback — never during the call; `more` is called
--| with the rest of a drain that has used its 64 resumptions, and must run
--| it in a later turn of the host's event loop — a timer — so that a fiber
--| that keeps yielding starves nothing (the Worker slice, P705-5); `hook`
--| is `scheduler`'s.
pub schedulerWith : sync ((⊤ → ⊤) → ⊤), sync ((⊤ → ⊤) → ⊤), sync (⊤ → ⊤) → Scheduler
schedulerWith runner more hook =
    sched = newScheduler runner more False
    (Scheduler s) = sched
    Js.write s.hook (Just hook)
    Js.write s.listed (Just (appendLink schedulers sched))
    sched


--| A scheduler whose drains run in a microtask of their own, and go on in
--| a macrotask after 64 resumptions, as the program's do, so a timer and
--| I/O get their turn. `hook` runs on a defect under it, in the stop,
--| before the throw goes on to the host, as `onDefect`'s does for the
--| program: the one piece of program code that runs there, and it may not
--| wait. `λ⊤ → ⊤` when nothing needs to know.
pub scheduler : sync (⊤ → ⊤) → Scheduler
scheduler hook = schedulerWith queueMicrotask macrotask hook


--| Whether a fiber of the scheduler still runs: one that belongs to it, or
--| one lent to it by `withScheduler`, running or parked. `False` once every
--| one has ended, and before any has started. What the `cloudflare`
--| platform asks after a request's answer, to know whether work outlives
--| it (`boundary.md` §9.12 (d)).
pub schedulerBusy : Scheduler → Bool
schedulerBusy (Scheduler s) = Js.read s.live > 0


--| How many fibers of the scheduler still run: belonging or lent, running
--| or parked. What the `cloudflare` platform asks of an object's
--| scheduler, whose one consumer fiber always runs: more than one means a
--| fiber a handler started is still alive (`boundary.md` §9.12 (e.10)).
pub schedulerFibers : Scheduler → Int
schedulerFibers (Scheduler s) = Js.read s.live


--| How many schedulers the kernel lists: every one made that has not
--| stopped for good. For a platform's test hook, where a fixture checks
--| that a request's scheduler leaves the list (`boundary.md` §9.12 (k)).
--| Public, because a platform's hook is beni that imports `Task`, and a
--| count that changes nothing is safe for any program to read; a build
--| that does not call it keeps nothing of it.
pub schedulersListed : ⊤ → Int
schedulersListed ⊤ = chainSize schedulers


--| Call `f` once, the next time no fiber of the scheduler runs — at once,
--| during this call, when none does now. One `f` waits: the last one given
--| replaces the one before. It runs at the end of the last fiber, where
--| that fiber's `complete` or its leave from `withScheduler` counts it off,
--| with that fiber still the current one: a `resume` from `f` is queued as
--| any other, and a `spawn` makes a child of the fiber that ended. During
--| a stop it runs when the last fiber ends, before `done`. What the
--| `cloudflare` platform holds a request open with under `waitUntil`
--| while work outlives the answer, and lets go of the request with as soon
--| as that work ends (`boundary.md` §9.12 (d)).
pub onSchedulerIdle : Scheduler, sync (⊤ → ⊤) → ⊤
onSchedulerIdle (Scheduler s) hook =
    if Js.read s.live == 0 then hook ⊤ else Js.write s.idle (Just hook)


--| Call `f` with the count each time a fiber of the scheduler ends or
--| leaves it, from the end of that fiber, with it still the current one,
--| as `onSchedulerIdle`'s function runs. One `f` watches: the last one
--| given replaces the one before. What the `cloudflare` platform answers
--| an `ask` with `NoReply` through, when the last fiber that could reply
--| has ended (`boundary.md` §9.12 (e.10)).
pub onSchedulerCount : Scheduler, sync (Int → ⊤) → ⊤
onSchedulerCount (Scheduler s) hook = Js.write s.watch (Just hook)


countDown : Scheduler → ⊤
countDown ((Scheduler s) as sched) =
    n = Js.read s.live - 1
    Js.write s.live n
    case Js.read s.watch of
        Nothing →
            ⊤
        Just watch →
            watch n
    if n == 0 then
        case Js.read s.idle of
            Nothing →
                ⊤
            Just idle →
                Js.write s.idle Nothing
                idle ⊤
        if Js.read s.phase == 2 then allEnded sched


attachFiber : Maybe Control, Maybe Scope, Fiber a → ⊤
attachFiber parent group (Fiber ((Control c) as fiber) _) =
    sched = schedulerOf fiber
    (Scheduler s) = sched
    (Scheduler p) = program
    Js.write p.live (Js.read p.live + 1)
    globalToken = appendLink p.members fiber
    pushStep c.unlinks λ⊤ →
        _ = removeLink p.members globalToken
        ⊤
    if not s.program && not (endedScheduler sched) then
        Js.write c.member (Just sched)
        Js.write s.live (Js.read s.live + 1)
        token = appendLink s.members fiber
        pushStep c.unlinks λ⊤ →
            _ = removeLink s.members token
            ⊤
    if stopped program || stopped sched then Js.write c.interrupted True
    case group of
        Just ((Scope sc) as attachedGroup) →
            listRoot attachedGroup sched
            if Js.read sc.closed then Js.write c.interrupted True
            token = appendLink sc.children fiber
            pushStep c.unlinks λ⊤ →
                _ = removeLink sc.children token
                ⊤
        Nothing →
            case parent of
                Just (Control owner) →
                    if Js.read owner.ended then
                        registerRoot fiber sched
                    else
                        token = appendLink owner.children fiber
                        pushStep c.unlinks λ⊤ →
                            _ = removeLink owner.children token
                            ⊤
                Nothing →
                    registerRoot fiber sched


registerRoot : Control, Scheduler → ⊤
registerRoot (Control c) (Scheduler s) =
    token = appendLink s.roots (RootFiber (Control c))
    pushStep c.unlinks λ⊤ →
        _ = removeLink s.roots token
        ⊤


fork : Maybe Control, Maybe Scope, Slots, (⊤ → a) → Fiber a
fork parent group slots work =
    fiber = makeFiber slots work
    registerFiber parent group fiber
    (Fiber control _) = fiber
    enqueue control Nothing
    fiber


--| Start `work` in a new fiber, a child of the current one, and return at
--| once. The child is cancelled when the current fiber ends.
pub spawn : (⊤ → a) → Fiber a
spawn work =
    fiber = fork (Js.read current) Nothing (currentSlots ⊤) work
    case Js.read current of
        Just _ →
            ⊤
        Nothing →
            case Js.read soonRunning of
                Nothing →
                    ⊤
                Just (Soon queuedWork) →
                    (Fiber control _) = fiber
                    pushStep queuedWork.children control
    fiber


--| Start `work` in a new fiber that belongs to no other: it outlives the
--| fiber that started it, and is not cancelled when that one ends. What
--| ends it is its own end, `cancel`, or the program's: a page's stop, or on
--| Node the end of `Io.run`'s fiber, cancels it and runs its cleanup with
--| every other fiber's. It sees what the fiber that started it sees — its
--| clock, its log context. Effect's `forkDetach`.
pub spawnDetached : (⊤ → a) → Fiber a
spawnDetached work = fork Nothing Nothing (currentSlots ⊤) work


--| Start `work` in a new fiber that belongs to `scope`.
pub spawnIn : Scope, (⊤ → a) → Fiber a
spawnIn group work = fork (Js.read current) (Just group) (currentSlots ⊤) work


--| Run `work` in a root fiber, and call `done` with how it ended. What a
--| platform's entry point uses; a program asks its platform instead.
pub start : (⊤ → a), sync (Exit a → ⊤) → ⊤
start work report =
    (Fiber (Control c) result) = fork Nothing Nothing emptySlots work
    pushStep c.observers λ⊤ →
        case Js.read result of
            Nothing →
                ⊤
            Just exit →
                report exit


--| Whether stopping will have cleanup to run: `True` once a fiber has been
--| made, when `shutdown` cancels fibers and calls its `done`. What a
--| platform asks to know whether more reports may follow its program's
--| stop (`boundary.md` §9.8.14 (g)).
pub cleansUp : ⊤ → Bool
cleansUp ⊤ = Js.read fibered


--| Queue `work` to run at the scheduler's next turn, in the queue of the
--| fibers that are ready, behind those queued before it — exactly where a
--| fiber `spawn`ed now would first run — but with no fiber of its own:
--| `work` must not suspend, and it runs outside any fiber, as `main` does.
--| What a page program runs a command with when its body cannot suspend
--| (`boundary.md` §9.8.11). What `work` starts with `spawn` belongs to it,
--| as a fiber's children do, and is cancelled when it returns. Once this synchronous job starts, it runs to its end. Its children
--| that have not started are cancelled before their first line when it ends.
pub soon : sync (⊤ → ⊤) → Soon
soon work =
    sched = schedulerHere ⊤
    queuedWork = Soon { work = Js.ref (Just work), children = newChain ⊤, sched = sched }
    scheduleOn sched λ⊤ → runSoon queuedWork
    queuedWork


runSoon : Soon → Bool
runSoon ((Soon s) as queuedWork) =
    work = Js.read s.work
    Js.write s.work Nothing
    if stopped program || stopped s.sched then
        False
    else
        case work of
            Nothing →
                False
            Just task →
                outer = Js.read soonRunning
                Js.write soonRunning (Just queuedWork)
                task ⊤
                Js.write soonRunning outer
                each (chainList s.children) halt
                True


--| Whether queued work has not run yet.
pub queued : Soon → Bool
queued (Soon s) =
    case Js.read s.work of
        Nothing →
            False
        Just _ →
            True


--| Run `body` with a scope, and when it returns, cancel every fiber it
--| started in the scope that is still running and wait for them.
--|
--|     both a b = Task.scope λs →
--|         x = Task.spawnIn s a
--|         y = Task.spawnIn s b
--|         ( Task.join x, Task.join y )
pub scope : (Scope → a) → a
scope body =
    group = openScope ⊤
    closeScope group (body group)


newScope : Bool → Scope
newScope root =
    Scope
        { children = newChain ⊤
        , closed = Js.ref False
        , deferred = newChain ⊤
        , finalizer = Js.ref Nothing
        , root = root
        , listed = Js.ref Nothing
        }


--| A scope that no function brackets, for a platform whose program
--| outlives every call: a page program's commands and subscriptions run
--| in one. `closeRoot` ends it; nothing else does.
pub openRoot : ⊤ → Scope
openRoot ⊤ = newScope True


openScope : ⊤ → Scope
openScope ⊤ =
    group = newScope False
    (Scope sc) = group
    owner = here ⊤
    (Control c) = owner
    token = appendLink c.finalizers (unitJob λ⊤ → shutWith group Cancelled)
    Js.write sc.finalizer (Just ( owner, token ))
    group


listRoot : Scope, Scheduler → ⊤
listRoot ((Scope sc) as group) ((Scheduler s) as sched) =
    if sc.root then
        case Js.read sc.listed of
            Nothing →
                Js.write sc.listed (Just ( sched, appendLink s.roots (RootScope group) ))
            Just _ →
                ⊤


unlistScope : Scope → Scheduler
unlistScope (Scope sc) =
    case Js.read sc.listed of
        Nothing →
            program
        Just ( (Scheduler s) as sched, token ) →
            _ = removeLink s.roots token
            Js.write sc.listed Nothing
            sched


shut : Scope → ⊤
shut ((Scope sc) as group) =
    Js.write sc.closed True
    if chainSize sc.children == 0 then
        ⊤
    else
        cancelControls (chainList sc.children)
        shut group


closeScope : Scope, a → a
closeScope ((Scope sc) as group) value =
    shut group
    case Js.read sc.finalizer of
        Nothing →
            ⊤
        Just ( Control c, token ) →
            _ = removeLink c.finalizers token
            Js.write sc.finalizer Nothing
    runDeferred group (Done ⊤)
    value


shutWith : Scope, Exit ⊤ → ⊤
shutWith group exit =
    shut group
    runDeferred group exit


runDeferred : Scope, Exit ⊤ → ⊤
runDeferred ((Scope sc) as group) exit =
    case popChain sc.deferred of
        Nothing →
            ⊤
        Just cleanup →
            uninterruptible λ⊤ →
                runUnitJob (cleanup exit)
                runDeferred group exit


--| Run `finally` when `scope` closes — after every fiber started in it has
--| been cancelled and has ended — where cancellation cannot reach it, the
--| last one added first. It is told `Done ⊤` when the scope's function
--| returned, and `Cancelled` when the fiber running that function was
--| cancelled. Added to a scope that has already closed, it runs at once,
--| told `Cancelled`. Effect's `Scope.addFinalizer`.
--|
--|     Task.scope λs →
--|         conn = connect ⊤
--|         _ = Task.defer s λ_ → disconnect conn
--|         serve s conn
--|
--| A root scope's run when `closeRoot` closes it, told `Done ⊤`, in a
--| fiber of their own that `closeRoot` does not wait for; or when the
--| program stops, told `Cancelled`, with the rest of its cleanup.
pub defer : Scope, (Exit ⊤ → ⊤) → ⊤
defer ((Scope sc) as group) cleanup =
    if Js.read sc.closed then
        uninterruptible λ⊤ → cleanup Cancelled
    else
        Js.write fibered True
        listRoot group (schedulerHere ⊤)
        pushStep sc.deferred λexit → unitJob λ⊤ → cleanup exit


--| Cancel every fiber of a scope `openRoot` made, without waiting for
--| their cleanup, which runs as each is resumed. A fiber started in the
--| scope afterwards is cancelled before it runs. What `defer` added to it
--| runs once those fibers have ended, in a fiber of its own.
pub closeRoot : Scope → ⊤
closeRoot ((Scope sc) as group) =
    owner = unlistScope group
    Js.write sc.closed True
    each (chainList sc.children) halt
    if chainSize sc.deferred > 0 then cleanupScope group (Done ⊤) owner


cleanupScope : Scope, Exit ⊤, Scheduler → ⊤
cleanupScope group exit owner =
    fins = newChain ⊤
    pushStep fins (unitJob λ⊤ → shutWith group exit)
    cleanupFiber fins owner


--| Run `work` where cancellation cannot reach it. A cancellation that
--| arrives meanwhile is delivered at the fiber's next suspension after it.
pub uninterruptible : (⊤ → a) → a
uninterruptible work =
    (Control c) = here ⊤
    Js.write c.masks (Js.read c.masks + 1)
    value = work ⊤
    Js.write c.masks (Js.read c.masks - 1)
    value


--| Run `work` where cancellation cannot reach it, as `uninterruptible`
--| does, handing it a `Restore` with which a part of it can be made
--| interruptible again: `restore token f` runs `f` as cancellable as the
--| code that entered the mask was. So a wait can be cancelled while what
--| follows it cannot — a permit taken and then always given back:
--|
--|     Task.uninterruptibleMask λtoken →
--|         permit = Task.restore token λ⊤ → waitForPermit ⊤
--|         Task.onExit (λ⊤ → Task.restore token use) λ_ → giveBack permit
--|
--| Effect's `uninterruptibleMask`. A cancellation that arrives while
--| masked is delivered at the next point where the fiber may suspend
--| inside a restored part, or after the mask.
pub uninterruptibleMask : (Restore → a) → a
uninterruptibleMask work =
    fiber = here ⊤
    (Control c) = fiber
    token = Restore { depth = Js.read c.masks, fiber = fiber, live = Js.ref True }
    (Restore t) = token
    value = uninterruptible λ⊤ → work token
    Js.write t.live False
    value


--| Run `work` with the interruptibility there was where the mask `token`
--| came from was entered — cancellable inside a mask entered from code
--| that was, not inside one entered from an uninterruptible region — and
--| put the mask back when `work` ends. A token used after its mask has
--| returned, or by a fiber other than the one that entered it, restores
--| nothing: `work` runs as the code around it does.
pub restore : Restore, (⊤ → a) → a
restore (Restore token) work =
    fiber = here ⊤
    (Control c) = fiber
    if Js.read token.live && Js.same fiber token.fiber then
        old = Js.read c.masks
        Js.write c.masks token.depth
        value = work ⊤
        Js.write c.masks old
        value
    else
        work ⊤


--| Acquire a resource, use it, and release it however the use ends:
--| `Done` with the use's value, or `Cancelled` when the fiber was cancelled
--| during the use. Acquire and release cannot be interrupted.
--|
--|     Task.bracket (λ⊤ → open path) (λfile _ → close file) λfile → read file
pub bracket : (⊤ → r), (r, Exit a → ⊤), (r → a) → a
bracket acquire release use =
    resource = uninterruptible acquire
    (Control c) = here ⊤
    token = appendLink c.finalizers (unitJob λ⊤ → release resource Cancelled)
    value = use resource
    _ = removeLink c.finalizers token
    uninterruptible λ⊤ →
        release resource (Done value)
        value


--| Run `work`, then `finally` with how it ended — `Done` with its value,
--| or `Cancelled` when the fiber was cancelled during it — where
--| cancellation cannot reach it, and answer `work`'s value. `bracket` with
--| no resource; Effect's `onExit`.
--|
--|     Task.onExit (λ⊤ → fetch url) λexit →
--|         case exit of
--|             Done _ → Log.info "fetched"
--|             Cancelled → Log.warn "gave up"
pub onExit : (⊤ → a), (Exit a → ⊤) → a
onExit work cleanup = bracket (λ⊤ → ⊤) (λ_ exit → cleanup exit) λ⊤ → work ⊤


--| Stop every fiber: close every root scope, cancel every fiber and run its
--| cleanup, drop queued work, and start nothing new. Cleanup that suspends
--| is given `deadline` milliseconds from the call; `done` is called once
--| every fiber has ended, with how many cleanups were cut short. What a
--| platform calls when its program stops (`boundary.md` §9.8.14); a
--| program never does. It returns at once — the cleanup runs in a later
--| task — and a second call does nothing.
pub shutdown : Int, sync (Int → ⊤) → ⊤
shutdown ms done =
    (Scheduler s) = program
    if Js.read s.phase == 0 then Js.write s.phase 1
    if chainSize releases > 0 then queueMicrotask λ⊤ → runJobs releases
    each (chainList schedulers) λsched →
        stopScheduler sched ms λcut → Js.write s.abandoned (Js.read s.abandoned + cut)
    if Js.read fibered then stopScheduler program ms done


--| Stop one scheduler, as `shutdown` stops the program: close its root
--| scopes, cancel its fibers and run their cleanup, drop its queued work
--| and start nothing new under it. Cleanup that suspends is given
--| `deadline` milliseconds from the call; `done` is called once every
--| fiber of the scheduler has ended, with how many cleanups were cut
--| short. It returns at once, and a second call does nothing. Every other
--| scheduler, the program's included, runs on.
pub stopScheduler : Scheduler, Int, sync (Int → ⊤) → ⊤
stopScheduler ((Scheduler s) as sched) ms done =
    case Js.read s.done of
        Just _ →
            ⊤
        Nothing →
            if Js.read s.phase ≠ 3 then
                Js.write s.done (Just done)
                Js.write s.deadline ms
                if Js.read s.phase == 2 then arm sched
                stopping sched


stopping : Scheduler → ⊤
stopping ((Scheduler s) as sched) =
    if Js.read s.phase == 0 then Js.write s.phase 1
    Js.write s.scheduled True
    if not (Js.read s.torn) then
        Js.write s.torn True
        queueTeardown sched


queueTeardown : Scheduler → ⊤
queueTeardown ((Scheduler s) as sched) =
    if s.program then
        macrotask λ⊤ → teardown sched
    else
        requeue sched λ⊤ → teardown sched


arm : Scheduler → ⊤
arm ((Scheduler s) as sched) =
    Js.write s.timer (Just (Runtime.timer (Js.read s.deadline) λ⊤ → expire sched))


teardown : Scheduler → ⊤
teardown ((Scheduler s) as sched) =
    if Js.read s.phase == 1 then
        Js.write s.phase 2
        case Js.read s.done of
            Nothing →
                ⊤
            Just _ →
                arm sched
        roots = chainList s.roots
        each roots λroot →
            case root of
                RootFiber _ →
                    ⊤
                RootScope (Scope group) →
                    Js.write group.closed True
        each (chainList s.members) λfiber → pushStep s.sweeping fiber
        each (chainList s.loans) λ(Loan loan) → pushStep s.sweeping loan.fiber
        cleanupRoots roots Cancelled sched
    ok = Js.ref False
    Js.finally
        (λ⊤ →
            sweep sched
            Js.write ok True
        )
        λ⊤ → if Js.read ok then ⊤ else queueTeardown sched
    case Js.read s.culprit of
        Nothing →
            ⊤
        Just fiber →
            Js.write s.culprit Nothing
            if not (endedControl fiber) then
                recover fiber
                enqueue fiber Nothing
    if s.program then
        case Js.read outside of
            Nothing →
                ⊤
            Just ((Control holder) as outsideControl) →
                if chainSize holder.finalizers > 0 then
                    fins = newChain ⊤
                    moveOutside outsideControl holder.finalizers fins
                    Js.write holder.masks 0
                    cleanupFiber fins program
    if Js.read s.live == 0 then allEnded sched else drain sched


moveOutside : Control, Chain UnitJob, Chain UnitJob → ⊤
moveOutside (Control owner) from into =
    case shiftChain from of
        Nothing →
            ⊤
        Just fin →
            pushStep into λdone →
                (Control active) = here ⊤
                old = Js.read owner.slots
                Js.write active.slots { Record.copy old | sched = Nothing }
                Js.invoke fin done λ_ → ⊤
            moveOutside (Control owner) from into


cleanupRoots : List Root, Exit ⊤, Scheduler → ⊤
cleanupRoots roots exit owner =
    fins = newChain ⊤
    each roots λroot →
        case root of
            RootFiber _ →
                ⊤
            RootScope ((Scope sc) as group) →
                if chainSize sc.deferred > 0 then
                    _ = prependLink fins (unitJob λ⊤ → shutWith group exit)
                    ⊤
    if chainSize fins > 0 then cleanupFiber fins owner


cleanupFiber : Chain UnitJob, Scheduler → ⊤
cleanupFiber fins sched =
    fiber = newControl { Record.copy emptySlots | sched = Just sched } λ⊤ → ⊤
    (Control c) = fiber
    copyFinalizers fins c.finalizers
    registerFiber Nothing Nothing (Fiber fiber (Js.ref Nothing))
    unwind fiber
    enqueue fiber Nothing


copyFinalizers : Chain UnitJob, Chain UnitJob → ⊤
copyFinalizers from into =
    case shiftChain from of
        Nothing →
            ⊤
        Just fin →
            pushStep into fin
            copyFinalizers from into


sweep : Scheduler → ⊤
sweep ((Scheduler s) as sched) =
    case shiftChain s.sweeping of
        Nothing →
            ⊤
        Just fiber →
            halt fiber
            sweep sched


recover : Control → ⊤
recover ((Control c) as fiber) =
    Js.write c.interrupted True
    Js.write c.parked Nothing
    Js.write c.masks 0
    if inCleanup fiber then
        cutBack fiber
    else if not (Js.read c.unwinding) then
        unwind fiber
    else
        if chainSize c.stack == 0 then
            pushFrame
                fiber
                (Execute λ⊤ →
                    c.cancelled ⊤
                    complete fiber
                )
        pushFrame fiber (Execute (driverJob λ⊤ → cancelChildren fiber))


deadlinePassed : Control → Bool
deadlinePassed fiber =
    (Scheduler p) = program
    (Scheduler s) = schedulerOf fiber
    Js.read p.expired || Js.read s.expired


expire : Scheduler → ⊤
expire ((Scheduler s) as sched) =
    Js.write s.timer Nothing
    Js.write s.expired True
    ok = Js.ref False
    Js.finally
        (λ⊤ →
            each (chainList cleaning) λ((Control c) as fiber) →
                if s.program || Js.same (schedulerOf fiber) sched then
                    case Js.read c.parked of
                        Nothing →
                            ⊤
                        Just waiting →
                            Js.write c.parked Nothing
                            enqueue fiber Nothing
                            abandon fiber (Just waiting)
            Js.write ok True
        )
        λ⊤ → if Js.read ok then ⊤ else macrotask λ⊤ → expire sched


abandon : Control, Maybe Wait → ⊤
abandon fiber waiting =
    (Scheduler s) = schedulerOf fiber
    Js.write s.abandoned (Js.read s.abandoned + 1)
    cutBack fiber
    case waiting of
        Nothing →
            ⊤
        Just (Wait w) →
            Js.write w.done True
            (Js.read w.stopWait) ⊤


allEnded : Scheduler → ⊤
allEnded (Scheduler s) =
    if Js.read s.phase ≠ 3 then
        Js.write s.phase 3
        case Js.read s.listed of
            Nothing →
                ⊤
            Just token →
                _ = removeLink schedulers token
                Js.write s.listed Nothing
        case Js.read s.timer of
            Nothing →
                ⊤
            Just stopTimer →
                stopTimer ⊤
        Js.write s.timer Nothing
        case Js.read s.done of
            Nothing →
                ⊤
            Just done →
                done (Js.read s.abandoned)


type Loan
    = Loan { fiber : Control, depth : Js.Ref Int }


findLink : Chain a, sync (a → Bool) → Maybe (Link a)
findLink (Chain q) predicate = matchingLink (Js.read q.first) predicate


matchingLink : Maybe (Link a), sync (a → Bool) → Maybe (Link a)
matchingLink next predicate =
    case next of
        Nothing →
            Nothing
        Just ((Link link) as token) →
            case Js.read link.value of
                Nothing →
                    Nothing
                Just value →
                    if predicate value then
                        Just token
                    else
                        matchingLink (Js.read link.after) predicate


lend : Control, Scheduler → Maybe (Link Loan)
lend fiber ((Scheduler s) as sched) =
    (Control c) = fiber
    owned =
        case Js.read c.member of
            Nothing →
                s.program
            Just owner →
                Js.same owner sched
    if owned then
        Nothing
    else
        case findLink s.loans λ(Loan loan) → Js.same loan.fiber fiber of
            Just ((Link link) as token) →
                case Js.read link.value of
                    Nothing →
                        Nothing
                    Just (Loan loan) →
                        Js.write loan.depth (Js.read loan.depth + 1)
                        Just token
            Nothing →
                Js.write s.live (Js.read s.live + 1)
                Just (appendLink s.loans (Loan { fiber = fiber, depth = Js.ref 1 }))


unlend : Scheduler, Maybe (Link Loan) → ⊤
unlend ((Scheduler s) as sched) maybe =
    case maybe of
        Nothing →
            ⊤
        Just ((Link link) as token) →
            case Js.read link.value of
                Nothing →
                    ⊤
                Just (Loan loan) →
                    if Js.read loan.depth > 1 then
                        Js.write loan.depth (Js.read loan.depth - 1)
                    else
                        _ = removeLink s.loans token
                        countDown sched


--| Run `work` with the calling fiber's scheduler slot set to `scheduler`,
--| and put the old one back when `work` ends, returned or cancelled, as
--| `Clock.run` does with the clock. While inside, this fiber resumes
--| through that scheduler; the fibers `work` starts copy the slot and
--| belong to the scheduler for good. The body is `withClock`'s, plus the
--| loan: change them together.
pub withScheduler : Scheduler, (⊤ → a) → a
withScheduler sched work =
    if stopped sched then
        selfCancel ⊤
    else
        fiber = here ⊤
        old = currentSlots ⊤
        token =
            case Js.read current of
                Nothing →
                    Nothing
                Just active →
                    lend active sched
        withSlots { Record.copy old | sched = Just sched } work λ⊤ → unlend sched token


withSlots : Slots, (⊤ → a), sync (⊤ → ⊤) → a
withSlots slots work after =
    (Control c) = here ⊤
    old = Js.read c.slots
    putBack =
        λ⊤ →
            Js.write c.slots old
            after ⊤
    token = appendLink c.finalizers (unitJob putBack)
    Js.write c.slots slots
    value = work ⊤
    _ = removeLink c.finalizers token
    putBack ⊤
    value


--| Core Log's typed context installer for the calling fiber, when set.
pub currentLogContext : ⊤ → Maybe (⊤ → ⊤)
currentLogContext ⊤ = (currentSlots ⊤).log


--| Run with a typed context installer, restoring the old slot on return or
--| cancellation. Child fibers inherit it. This is private plumbing for Log.
pub withLogContext : sync (⊤ → ⊤), (⊤ → a) → a
withLogContext context work =
    old = currentSlots ⊤
    withSlots { Record.copy old | log = Just context } work λ⊤ → ⊤


--| `work` as a function that runs with the calling fiber's log context,
--| the one in force here, wherever it is called later; `work` itself when
--| no log context is set. For `browser`'s commands, whose bodies run after
--| `update` has returned (`boundary.md` §9.8.16 (b), amended 2026-10-22).
--| It reads `slotted` itself, so in a build in which nothing sets a slot it
--| is `work`, and a release build keeps no call of it.
pub keepLogContext : (a → b) → (a → b)
keepLogContext work =
    case currentLogContext ⊤ of
        Nothing →
            work
        Just context →
            λvalue → withLogContext context λ⊤ → work value


--| Whether the calling fiber has a log context of its own: one that
--| `withLogContext` set, and not the default. For `browser`'s `send`, which
--| runs a message's `update` with the program's context only when the
--| caller has another (`boundary.md` §9.8.16 (b), amended 2026-10-23). It
--| reads `slotted` first, so in a build in which nothing sets a slot it is
--| `False`, and a release build keeps no call of it.
pub hasLogContext : ⊤ → Bool
hasLogContext ⊤ =
    case currentLogContext ⊤ of
        Nothing →
            False
        Just _ →
            True


--| Run `work`, which cannot wait, with the default log context, the
--| program's. Put the calling fiber's back at once when `work` returns or
--| throws. When `work` throws and leaves finalisers, the teardown runs
--| them first, with `work`'s context, then puts the fiber's back again.
pub withoutLogContext : sync (⊤ → a) → a
withoutLogContext work =
    holder =
        case Js.read current of
            Nothing →
                Js.read outside
            fiber →
                fiber
    case holder of
        Nothing →
            work ⊤
        Just (Control c) →
            old = Js.read c.slots
            token = appendLink c.finalizers (unitJob λ⊤ → Js.write c.slots old)
            Js.write c.slots { Record.copy old | log = Nothing }
            ok = Js.ref False
            Js.finally
                (λ⊤ →
                    value = work ⊤
                    Js.write ok True
                    value
                )
                λ⊤ →
                    if Js.read ok then
                        _ = removeLink c.finalizers token
                        ⊤
                    else
                        thrown = Js.read c.slots
                        pushStep c.finalizers (unitJob λ⊤ → Js.write c.slots thrown)
                    Js.write c.slots old


--| Core Clock's virtual reading, or Nothing for the host clock.
pub currentClock : ⊤ → Maybe Int
currentClock ⊤ =
    case (currentSlots ⊤).clock of
        Nothing →
            Nothing
        Just (VirtualClock clock) →
            Just (Js.read clock.now)


--| Core Clock's typed virtual clock with no sleepers.
pub virtualClock : Int → VirtualClock
virtualClock epoch = VirtualClock { now = Js.ref epoch, sleepers = newChain ⊤ }


--| Run with a typed virtual clock, restoring the old slot on return or
--| cancellation. Child fibers inherit it. This is private plumbing for Clock.
pub withClock : VirtualClock, (⊤ → a) → a
withClock clock work =
    old = currentSlots ⊤
    withSlots { Record.copy old | clock = Just clock } work λ⊤ → ⊤


--| Wait `duration` on the calling fiber's clock; only this fiber waits.
--|
--| On the real clock that is a host timer, cleared when the fiber is
--| cancelled; a wait longer than the timer's limit, 2³¹ − 1 ms, is a
--| chain of timers, so it never ends early. A `zero` wait lets every
--| other ready fiber run first, as `yieldNow` does — Effect's
--| `sleep(0)`. Inside `Clock.run` the clock is a virtual one: the fiber
--| waits until `Clock.adjust` moves that clock past the wake time, and a
--| `zero` wait returns at once.
pub sleep : Duration → ⊤
sleep duration =
    ms = Duration.toMillis duration
    case (currentSlots ⊤).clock of
        Nothing →
            if ms == 0 then yieldNow ⊤ else realSleep ms
        Just clock →
            if ms == 0 then ⊤ else virtualSleep clock ms


timerLimit : Int
timerLimit = 2147483647


realSleep : Int → ⊤
realSleep ms =
    callback λwake → Runtime.timer (Basics.min ms timerLimit) λ⊤ → fromHost λ⊤ → resume wake ⊤
    if ms > timerLimit then realSleep (ms - timerLimit)


virtualSleep : VirtualClock, Int → ⊤
virtualSleep (VirtualClock clock) ms = callback λwake →
    at = Js.read clock.now + ms
    token = insertSleeper clock.sleepers at wake
    λ⊤ →
        _ = removeLink clock.sleepers token
        ⊤


insertSleeper : Chain Sleeper, Int, Resume ⊤ → Link Sleeper
insertSleeper ((Chain q) as sleepers) at wake =
    case findLink sleepers λ(Sleeper due _) → due > at of
        Nothing →
            appendLink sleepers (Sleeper at wake)
        Just ((Link next) as following) →
            token =
                Link
                    { value = Js.ref (Just (Sleeper at wake))
                    , before = Js.ref (Js.read next.before)
                    , after = Js.ref (Just following)
                    }
            case Js.read next.before of
                Nothing →
                    Js.write q.first (Just token)
                Just (Link previous) →
                    Js.write previous.after (Just token)
            Js.write next.before (Just token)
            Js.write q.count (Js.read q.count + 1)
            token


--| Move the virtual clock `clock` forward by `ms` milliseconds, and return once everything that woke has run as far as it
--| can: core's `Clock.adjust`.
--|
--| It first lets every other ready fiber run until none is (*settles*);
--| then, while the earliest sleeper is due by the target, sets the reading
--| to its wake time, wakes every sleeper due then, in the order they began
--| to sleep, and settles again — so a sleeper the woken code registers is
--| woken too if it is due by the target. Last, the reading is the target.
pub adjustClock : VirtualClock, Int → ⊤
adjustClock ((VirtualClock clock) as virtual) ms =
    if ms > 0 then
        settle ⊤
        advance virtual (Js.read clock.now + ms)


advance : VirtualClock, Int → ⊤
advance ((VirtualClock clock) as virtual) target =
    case chainList clock.sleepers of
        [] →
            Js.write clock.now target
        [ Sleeper at _, …_ ] →
            if at > target then
                Js.write clock.now target
            else
                Js.write clock.now at
                wakeDue clock.sleepers at
                settle ⊤
                advance virtual target


wakeDue : Chain Sleeper, Int → ⊤
wakeDue sleepers at =
    (Chain q) = sleepers
    case Js.read q.first of
        Nothing →
            ⊤
        Just (Link link) →
            case Js.read link.value of
                Nothing →
                    ⊤
                Just (Sleeper due wake) →
                    if due == at then
                        _ = shiftChain sleepers
                        resume wake ⊤
                        wakeDue sleepers at


settle : ⊤ → ⊤
settle ⊤ =
    (Scheduler s) = schedulerHere ⊤
    if not (jobsEmpty s.queue) then
        yieldNow ⊤
        settle ⊤


clockMillis : ⊤ → Int
clockMillis ⊤ =
    case currentClock ⊤ of
        Nothing →
            Runtime.now ⊤
        Just now →
            now


each : List a, (a → ⊤) → ⊤
each items work =
    case items of
        [] →
            ⊤
        [ item, …rest ] →
            work item
            each rest work


-- Fast combinator branches run before being registered. A branch that
-- returns synchronously is never counted as a live sched member.
startIn : Scope, (⊤ → a) → Fiber a
startIn group work =
    fiber = makeFiber (currentSlots ⊤) work
    (Fiber ((Control c) as control) _) = fiber
    outer = Js.read current
    Js.write current (Just control)
    ok = Js.ref False
    Js.finally
        (λ⊤ →
            case popChain c.stack of
                Just (Execute job) →
                    Js.invoke job ⊤ λ_ → ⊤
                    ⊤
                _ →
                    ⊤
            if not (Js.read c.ended) then
                registerFiber outer (Just group) fiber
                case Js.read pending of
                    Nothing →
                        enqueue control Nothing
                    Just (Pending stop waiting) →
                        Js.write pending Nothing
                        if stop then
                            unwind control
                            enqueue control Nothing
                        else
                            Js.write c.parked waiting
            Js.write ok True
        )
        λ⊤ →
            Js.write current outer
            if not (Js.read ok) then
                Js.write pending Nothing
                registerFiber outer (Just group) fiber
                recover control
                enqueue control Nothing
    fiber


type Entry
    = Entry { number : Int, fiber : Control, stop : ⊤ → Bool, kill : ⊤ → Bool }


entry : Int, Fiber a, sync (Exit a → Bool), sync (Exit a → Bool) → Entry
entry number (Fiber fiber result) stop kill =
    Entry
        { number = number
        , fiber = fiber
        , stop =
            λ⊤ →
                case Js.read result of
                    Nothing →
                        False
                    Just exit →
                        stop exit
        , kill =
            λ⊤ →
                case Js.read result of
                    Nothing →
                        False
                    Just exit →
                        kill exit
        }


findEnded : List Entry → Maybe Entry
findEnded entries =
    case entries of
        [] →
            Nothing
        [ ((Entry item) as candidate), …rest ] →
            if endedControl item.fiber && item.stop ⊤ then Just candidate else findEnded rest


firstOf : List Entry → Maybe Int
firstOf entries =
    case findEnded entries of
        Just (Entry winner) →
            if winner.kill ⊤ then haltOthers entries winner.fiber
            Just winner.number
        Nothing →
            if List.all entries λ(Entry item) → endedControl item.fiber then
                Nothing
            else
                me = Js.read current
                listeners = newChain ⊤
                value = callback λwake →
                    each entries λ(Entry item) →
                        if endedControl item.fiber then
                            ⊤
                        else
                            (Control c) = item.fiber
                            token = appendLink c.observers λ⊤ →
                                if item.stop ⊤ then
                                    if item.kill ⊤ then haltAs me entries item.fiber
                                    resume wake (Just item.number)
                                else if
                                    List.all entries λ(Entry other) → endedControl other.fiber
                                then
                                    resume wake Nothing
                            pushStep listeners λ⊤ →
                                _ = removeLink c.observers token
                                ⊤
                    λ⊤ → runJobs listeners
                runJobs listeners
                value


haltOthers : List Entry, Control → ⊤
haltOthers entries winner = each entries λ(Entry item) →
    if not (Js.same winner item.fiber) then halt item.fiber


haltAs : Maybe Control, List Entry, Control → ⊤
haltAs fiber entries winner =
    outer = Js.read current
    Js.write current fiber
    Js.finally (λ⊤ → haltOthers entries winner) λ⊤ → Js.write current outer


wasCancelled : Exit a → Bool
wasCancelled exit =
    case exit of
        Done _ →
            False
        Cancelled →
            True


wasDone : Exit a → Bool
wasDone exit = not (wasCancelled exit)


failedOrCancelled : Exit (Result e a) → Bool
failedOrCancelled exit =
    case exit of
        Done (Ok _) →
            False
        _ →
            True


succeeded : Exit (Result e a) → Bool
succeeded exit =
    case exit of
        Done (Ok _) →
            True
        _ →
            False


allOrCancel : List Entry → ⊤
allOrCancel entries =
    case firstOf entries of
        Nothing →
            ⊤
        Just _ →
            selfCancel ⊤


--| Run both concurrently, and answer both values, in argument order. If
--| one of them is cancelled — it joined a cancelled fiber — the other is
--| cancelled and waited for, and so is the caller. Effect's `all` of two.
pub par : (⊤ → a), (⊤ → b) → a × b
par a b = scope λgroup →
    fa = startIn group a
    fb = startIn group b
    allOrCancel [ entry 0 fa wasCancelled wasCancelled, entry 1 fb wasCancelled wasCancelled ]
    ( join fa, join fb )


--| `par` of three.
pub par3 : (⊤ → a), (⊤ → b), (⊤ → c) → a × b × c
par3 a b c = scope λgroup →
    fa = startIn group a
    fb = startIn group b
    fc = startIn group c
    allOrCancel
        [ entry 0 fa wasCancelled wasCancelled
        , entry 1 fb wasCancelled wasCancelled
        , entry 2 fc wasCancelled wasCancelled
        ]
    ( join fa, join fb, join fc )


--| Run both concurrently; the first `Err` to arrive cancels the other as
--| it arrives, waits for its cleanup, and is the answer. When the first
--| answers `Err` without waiting, the second is never started. `Ok` of both values, in
--| argument order, otherwise. Effect's `all`, which fails fast.
pub parOk : (⊤ → Result e a), (⊤ → Result e b) → Result e (a × b)
parOk a b = scope λgroup →
    fa = startIn group a
    case poll fa of
        Just Cancelled →
            selfCancel ⊤
        Just (Done (Err why)) →
            Err why
        _ →
            fb = startIn group b
            winner =
                firstOf
                    [ entry 0 fa failedOrCancelled failedOrCancelled
                    , entry 1 fb failedOrCancelled failedOrCancelled
                    ]
            case winner of
                Just 0 →
                    failedWith fa
                Just _ →
                    failedWith fb
                Nothing →
                    case ( join fa, join fb ) of
                        ( Ok x, Ok y ) →
                            Ok ( x, y )
                        ( Err why, _ ) →
                            Err why
                        ( _, Err why ) →
                            Err why


failedWith : Fiber (Result e a) → Result e b
failedWith fiber =
    case join fiber of
        Err why →
            Err why
        Ok _ →
            selfCancel ⊤


--| Run both concurrently; the first to return is the answer. The other is
--| cancelled as the first returns, so it runs again only where it cannot
--| be interrupted, and is waited for — its cleanup has run — before the
--| answer is returned. When the first returns without waiting, the second
--| is never started. A branch cancelled by itself never wins; if both are,
--| the caller is cancelled. Effect's `raceFirst`.
pub race : (⊤ → a), (⊤ → a) → a
race first second = raceAll first [ second ]


--| `race` of any number of branches, `first` and then `rest`: the first to
--| return wins. Every other branch is cancelled as it returns, so none runs
--| again where it can be interrupted, and is waited for before the answer
--| is returned; a branch after one that returned without waiting is never
--| started. Effect's `raceAllFirst`.
pub raceAll : (⊤ → a), List (⊤ → a) → a
raceAll first rest = scope λgroup →
    fibers = startRacers group [ first, …rest ] [] wasDone
    entries = List.indexedMap fibers λi fiber → entry i fiber wasDone wasDone
    case firstOf entries of
        Nothing →
            selfCancel ⊤
        Just index →
            case List.get fibers index of
                Nothing →
                    selfCancel ⊤
                Just fiber →
                    join fiber


startRacers : Scope, List (⊤ → a), List (Fiber a), sync (Exit a → Bool) → List (Fiber a)
startRacers group work fibers wins =
    case work of
        [] →
            fibers
        [ thunk, …rest ] →
            fiber = startIn group thunk
            more = [ …fibers, fiber ]
            case poll fiber of
                Just exit →
                    if wins exit then more else startRacers group rest more wins
                Nothing →
                    startRacers group rest more wins


--| The first branch to answer `Ok` wins, and the rest are cancelled as it
--| answers, and waited for; an `Err` does not end the race. A branch after
--| one that answered `Ok` without waiting is never started. When no branch answers
--| `Ok`, the answer is `Err` of every branch's error, in argument order —
--| a branch cancelled by itself gives none, and if every branch was, the
--| caller is cancelled. No branches at all is `Err []`. Effect's `race`.
pub raceOk : many aliased List (⊤ → Result e a) → fresh Result (List e) a
raceOk work =
    if List.isEmpty work then
        Err []
    else
        scope λgroup →
            fibers = startRacers group work [] succeeded
            entries = List.indexedMap fibers λi fiber → entry i fiber succeeded succeeded
            case firstOf entries of
                Just index →
                    case List.get fibers index of
                        Nothing →
                            selfCancel ⊤
                        Just fiber →
                            case join fiber of
                                Ok value →
                                    Ok value
                                Err why →
                                    Err [ why ]
                Nothing →
                    errors fibers []


errors : List (Fiber (Result e a)), List e → Result (List e) a
errors fibers reasons =
    case fibers of
        [] →
            if List.isEmpty reasons then selfCancel ⊤ else Err reasons
        [ fiber, …rest ] →
            case wait fiber of
                Cancelled →
                    errors rest reasons
                Done (Err why) →
                    errors rest [ …reasons, why ]
                Done (Ok value) →
                    Ok value


--| Run `work`; if it returns before `duration` has passed on the calling
--| fiber's clock, `Just` its value. Otherwise `work` is cancelled as the
--| time passes, its cleanup waited for, and the answer is `Nothing` — so
--| `timeout` may take longer than `duration`, by as long as that cleanup
--| takes, and `work` that cannot be interrupted when the time passes runs
--| to its next point of suspension first. A `zero` duration answers `Nothing` without
--| starting `work`. Effect's `timeoutOption`.
--|
--|     Task.timeout (Duration.seconds 5) (λ⊤ → Http.get url)
--|         ▷ Maybe.withDefault (Err Http.Timeout)
pub timeout : borrowed Duration, once aliased (⊤ → a) → fresh Maybe a
timeout duration work =
    if Duration.toMillis duration == 0 then
        Nothing
    else
        scope λgroup →
            child = startIn group work
            case poll child of
                Just Cancelled →
                    selfCancel ⊤
                Just (Done value) →
                    Just value
                Nothing →
                    timer = startIn group λ⊤ → sleep duration
                    winner =
                        firstOf
                            [ entry 0 child (λ_ → True) λ_ → True
                            , entry 1 timer (λ_ → True) λ_ → True
                            ]
                    case winner of
                        Just 0 →
                            Just (join child)
                        _ →
                            Nothing


--| Call `f` on every element, at most `bound` calls running at once — each
--| started, in list order, as one before it ends — and answer the results
--| in list order. A `bound` below 1 is 1; `List.length xs` runs them all at
--| once. If a call is cancelled, no more are started, those running are
--| cancelled and waited for, and the caller is cancelled. Effect's
--| `forEach` with `concurrency`.
pub forEach : List a, Int, (a → b) → List b
forEach items bound work = scope λgroup →
    case bounded group items (Basics.max 1 bound) work λ_ → False of
        Ok values →
            values
        Err _ →
            selfCancel ⊤


--| `forEach` for a function that answers a `Result`: on the first `Err`,
--| no more calls are started, those running are cancelled as it arrives
--| and waited for,
--| and that `Err` is the answer. `Ok` of every result, in list order,
--| otherwise.
pub forEachOk : List a, Int, (a → Result e b) → Result e (List b)
forEachOk items bound work = scope λgroup →
    case bounded group items (Basics.max 1 bound) work isErr of
        Ok values →
            collectOk values []
        Err fiber →
            case join fiber of
                Err why →
                    Err why
                Ok _ →
                    selfCancel ⊤


isErr : Result e a → Bool
isErr value =
    case value of
        Err _ →
            True
        Ok _ →
            False


collectOk : List (Result e a), List a → Result e (List a)
collectOk values done =
    case values of
        [] →
            Ok done
        [ value, …rest ] →
            case value of
                Err why →
                    Err why
                Ok item →
                    collectOk rest [ …done, item ]


bounded : Scope, List a, Int, (a → b), sync (b → Bool) → Result (Fiber b) (List b)
bounded group items bound work stops =
    results = List.map items λ_ → Js.ref Nothing
    boundedFrom group items results results bound work stops 0 []


boundedFrom :
      Scope
    , List a
    , List (Js.Ref (Maybe b))
    , List (Js.Ref (Maybe b))
    , Int
    , (a → b)
    , sync (b → Bool)
    , Int
    , List (Int × Fiber b)
    → Result (Fiber b) (List b)
boundedFrom group items slots allSlots bound work stops next inFlight =
    if List.length inFlight < bound then
        case ( items, slots ) of
            ( [ item, …rest ], [ slot, …otherSlots ] ) →
                fiber = startIn group λ⊤ → work item
                case poll fiber of
                    Just Cancelled →
                        Err fiber
                    Just (Done value) →
                        if stops value then
                            Err fiber
                        else
                            Js.write slot (Just value)
                            boundedFrom
                                group
                                rest
                                otherSlots
                                allSlots
                                bound
                                work
                                stops
                                (next + 1)
                                inFlight
                    Nothing →
                        boundedFrom group rest otherSlots allSlots bound work stops (next + 1)
                            [ …inFlight, ( next, fiber ) ]
            _ →
                awaitBounded group items slots allSlots bound work stops next inFlight
    else
        awaitBounded group items slots allSlots bound work stops next inFlight


awaitBounded :
      Scope
    , List a
    , List (Js.Ref (Maybe b))
    , List (Js.Ref (Maybe b))
    , Int
    , (a → b)
    , sync (b → Bool)
    , Int
    , List (Int × Fiber b)
    → Result (Fiber b) (List b)
awaitBounded group items slots allSlots bound work stops next inFlight =
    case inFlight of
        [] →
            Ok (readSlots allSlots [])
        _ →
            wins =
                λexit →
                    case exit of
                        Cancelled →
                            True
                        Done value →
                            stops value
            entries = List.map inFlight λ( i, fiber ) → entry i fiber (λ_ → True) wins
            winner = firstOf entries
            case winner of
                Just index →
                    case flightAt inFlight index of
                        Nothing →
                            selfCancel ⊤
                        Just fiber →
                            case poll fiber of
                                Just Cancelled →
                                    Err fiber
                                Just (Done value) →
                                    if stops value then
                                        Err fiber
                                    else
                                        continueBounded
                                            group
                                            items
                                            slots
                                            allSlots
                                            bound
                                            work
                                            stops
                                            next
                                            inFlight
                                Nothing →
                                    selfCancel ⊤
                Nothing →
                    continueBounded group items slots allSlots bound work stops next inFlight


flightAt : List (Int × Fiber a), Int → Maybe (Fiber a)
flightAt flights index =
    case flights of
        [] →
            Nothing
        [ ( i, fiber ), …rest ] →
            if i == index then Just fiber else flightAt rest index


continueBounded :
      Scope
    , List a
    , List (Js.Ref (Maybe b))
    , List (Js.Ref (Maybe b))
    , Int
    , (a → b)
    , sync (b → Bool)
    , Int
    , List (Int × Fiber b)
    → Result (Fiber b) (List b)
continueBounded group items slots allSlots bound work stops next inFlight =
    case completedFlight inFlight allSlots stops [] of
        Err fiber →
            Err fiber
        Ok remaining →
            boundedFrom group items slots allSlots bound work stops next remaining


completedFlight :
      List (Int × Fiber b)
    , List (Js.Ref (Maybe b))
    , sync (b → Bool)
    , List (Int × Fiber b)
    → Result (Fiber b) (List (Int × Fiber b))
completedFlight flights slots stops remaining =
    case flights of
        [] →
            Ok remaining
        [ (( i, fiber ) as pair), …rest ] →
            case poll fiber of
                Nothing →
                    completedFlight rest slots stops [ …remaining, pair ]
                Just Cancelled →
                    Err fiber
                Just (Done value) →
                    if stops value then
                        Err fiber
                    else
                        case List.get slots i of
                            Nothing →
                                ⊤
                            Just slot →
                                Js.write slot (Just value)
                        completedFlight rest slots stops remaining


readSlots : List (Js.Ref (Maybe a)), List a → List a
readSlots slots values =
    case slots of
        [] →
            values
        [ slot, …rest ] →
            case Js.read slot of
                Nothing →
                    selfCancel ⊤
                Just value →
                    readSlots rest [ …values, value ]


--| Run `work`; an `Ok` is the answer at once. On an `Err`, step `policy`
--| with it: `Stop` makes that `Err` the answer, and `Continue` sleeps its
--| delay on the calling fiber's clock and runs `work` again, stepping the
--| next schedule after that. A cancelled `work` never returns, so it is
--| never retried. Effect's `retry`.
--|
--|     -- at most four runs, 100, 200 and 400 ms apart
--|     Task.retry (Schedule.max (Schedule.exponential (Duration.millis 100) 2.0) (Schedule.recurs 3)) fetch
pub retry : Schedule e, (⊤ → Result e a) → Result e a
retry policy work = retryFrom policy work (clockMillis ⊤) 1


retryFrom : Schedule e, (⊤ → Result e a), Int, Int → Result e a
retryFrom policy work began attempt =
    case work ⊤ of
        Ok value →
            Ok value

        Err problem →
            case Schedule.step policy (metadata problem attempt began) of
                Schedule.Stop →
                    Err problem

                Schedule.Continue delay next →
                    sleep delay
                    retryFrom next work began (attempt + 1)


--| Run `work`, step `policy` with its value, and while it continues
--| sleep its delay and run `work` again; the last value is the answer.
--| `repeat (Schedule.recurs 2)` runs `work` three times. Effect's `repeat`.
pub repeat : Schedule a, (⊤ → a) → a
repeat policy work = repeatFrom policy work (clockMillis ⊤) 1


repeatFrom : Schedule a, (⊤ → a), Int, Int → a
repeatFrom policy work began attempt =
    value = work ⊤

    case Schedule.step policy (metadata value attempt began) of
        Schedule.Stop →
            value

        Schedule.Continue delay next →
            sleep delay
            repeatFrom next work began (attempt + 1)


-- One step's metadata: the time since `began` on the calling fiber's clock,
-- and a random draw — from the host, until a seed slot is set (§17.5; the
-- seed is P9's `Random.withSeed`, which nothing writes yet).
metadata : i, Int, Int → Schedule.Metadata i
metadata input attempt began =
    { input = input
    , attempt = attempt
    , elapsed = Duration.millis (clockMillis ⊤ - began)
    , random = Runtime.random ⊤
    }


registerFiber : Maybe Control, Maybe Scope, Fiber a → ⊤
registerFiber parent group ((Fiber (Control c) _) as fiber) =
    if not (Js.read c.registered) then
        Js.write c.registered True
        attachFiber parent group fiber


-- Typed intrusive storage. Removed links forget their payload and neighbours.
type Chain a
    = Chain
        { first : Js.Ref (Maybe (Link a))
        , last : Js.Ref (Maybe (Link a))
        , count : Js.Ref Int
        }


type Link a
    = Link
        { value : Js.Ref (Maybe a)
        , before : Js.Ref (Maybe (Link a))
        , after : Js.Ref (Maybe (Link a))
        }


newChain : ⊤ → Chain a
newChain ⊤ = Chain { first = Js.ref Nothing, last = Js.ref Nothing, count = Js.ref 0 }


chainSize : Chain a → Int
chainSize (Chain q) = Js.read q.count


appendLink : Chain a, a → Link a
appendLink (Chain q) value =
    link =
        Link
            { value = Js.ref (Just value)
            , before = Js.ref (Js.read q.last)
            , after = Js.ref Nothing
            }
    case Js.read q.last of
        Nothing →
            Js.write q.first (Just link)
        Just (Link previous) →
            Js.write previous.after (Just link)
    Js.write q.last (Just link)
    Js.write q.count (Js.read q.count + 1)
    link


prependLink : Chain a, a → Link a
prependLink (Chain q) value =
    link =
        Link
            { value = Js.ref (Just value)
            , before = Js.ref Nothing
            , after = Js.ref (Js.read q.first)
            }
    case Js.read q.first of
        Nothing →
            Js.write q.last (Just link)
        Just (Link next) →
            Js.write next.before (Just link)
    Js.write q.first (Just link)
    Js.write q.count (Js.read q.count + 1)
    link


removeLink : Chain a, Link a → Maybe a
removeLink (Chain q) (Link link) =
    case Js.read link.value of
        Nothing →
            Nothing
        Just value →
            case Js.read link.before of
                Nothing →
                    Js.write q.first (Js.read link.after)
                Just (Link previous) →
                    Js.write previous.after (Js.read link.after)
            case Js.read link.after of
                Nothing →
                    Js.write q.last (Js.read link.before)
                Just (Link next) →
                    Js.write next.before (Js.read link.before)
            Js.write link.value Nothing
            Js.write link.before Nothing
            Js.write link.after Nothing
            Js.write q.count (Js.read q.count - 1)
            Just value


shiftChain : Chain a → Maybe a
shiftChain ((Chain q) as deque) =
    case Js.read q.first of
        Nothing →
            Nothing
        Just link →
            removeLink deque link


popChain : Chain a → Maybe a
popChain ((Chain q) as deque) =
    case Js.read q.last of
        Nothing →
            Nothing
        Just link →
            removeLink deque link


chainList : Chain a → List a
chainList (Chain q) = linksList (Js.read q.first) []


linksList : Maybe (Link a), List a → List a
linksList next values =
    case next of
        Nothing →
            values
        Just (Link link) →
            case Js.read link.value of
                Nothing →
                    values
                Just value →
                    linksList (Js.read link.after) [ …values, value ]


clearChain : Chain a → ⊤
clearChain deque =
    case shiftChain deque of
        Nothing →
            ⊤
        Just _ →
            clearChain deque


pushStep : Chain a, a → ⊤
pushStep deque value =
    _ = appendLink deque value
    ⊤
