--! The page's address (`docs/design/boundary.md` §9.8.13 (c), §9.8.17):
--! elm/browser's `Browser.Navigation`. Reading the address — `currentUrl`,
--! `eachUrlChange`, `onUrlChange` — needs nothing; changing it goes through
--! the page's `Key`.
--!
--! Elm's names are commands that take values — `pushUrl`, `replaceUrl`,
--! `back`, `forward`, `load`, `reload` — so an `update` hands the runtime
--! the address it computed and no function that reads the model later
--! (§9.8.16 (b)). Each sends its last argument's message only when the
--! change was refused, as `Storage.save` does: a typed failure is never
--! dropped (CLAUDE.md rule 9). Each has a direct form that answers at once
--! (§9.8.11): `push`, `replace`, `goBack`, `goForward`, `loadPage`,
--! `reloadPage`.
--!
--!     ClickedLink (Browser.Internal url) →
--!         ( model, Navigation.pushUrl model.key (Url.toString url) Refused )
--!
--! Every change `push`, `replace`, `goBack` and `goForward` make is
--! announced to every follower of the address on the page, whoever made
--! it, so no program falls out of step with the address.

import Browser
import Cmd exposing (Cmd)
import Js
import Listen
import Sub exposing (Sub)
import Url exposing (Url)


--| What changes the page's address: one per page, handed out by `key`. A
--| model may hold it.
pub opaque type Key
    = Page


--| The page's key.
pub key : ⊤ → Key
key ⊤ = Page


--| Why the address did not change: the URL does not resolve against the
--| page (or would run script), it names another origin, or the browser
--| refused the change as too frequent.
pub type Error
    = BadUrl String
    | CrossOrigin String
    | Throttled


--| The page's address, or `Nothing` when it is not an `http` or `https`
--| one (a page opened from a file).
--|
--|     init =
--|         case Browser.Navigation.currentUrl ⊤ of
--|             Just url → filterOf url.fragment
--|             Nothing → All
pub currentUrl : ⊤ → Maybe Url
currentUrl ⊤ = Url.fromString (Js.to (Js.get (Js.global "location") "href"))


--| Add an entry to the browser's history with the URL, resolved against
--| the page, and tell every follower of the address, when the command
--| runs. The page is not reloaded. `refused error` is sent only when the
--| change did not happen.
--|
--|     ClickedLink (Browser.Internal url) →
--|         ( model, Navigation.pushUrl model.key (Url.toString url) Refused )
pub pushUrl : Key, String, (Error → msg) → Cmd msg
pushUrl k url refused = command (λ⊤ → push k url) refused


--| Replace the current entry of the browser's history with the URL, as
--| `pushUrl` adds one.
pub replaceUrl : Key, String, (Error → msg) → Cmd msg
replaceUrl k url refused = command (λ⊤ → replace k url) refused


--| Go back `n` entries in the history, as `goBack` does, when the command
--| runs.
pub back : Key, Int, (Error → msg) → Cmd msg
back k n refused = command (λ⊤ → goBack k n) refused


--| Go forward `n` entries in the history, as `goForward` does, when the
--| command runs.
pub forward : Key, Int, (Error → msg) → Cmd msg
forward k n refused = command (λ⊤ → goForward k n) refused


--| Leave the page for the URL, as `loadPage` does, when the command runs.
pub load : String, (Error → msg) → Cmd msg
load url refused = command (λ⊤ → loadPage url) refused


--| Load the page again, when the command runs. It takes `⊤`: making a
--| command is impure, and a top-level value made by an impure call cannot
--| keep the type variable `msg` (`docs/design/checker-v2.md` §8.4).
pub reload : ⊤ → Cmd msg
reload ⊤ = Cmd.perform λ_ → reloadPage ⊤


-- A change made when the command runs, and its refusal sent: the change is
-- a function of `⊤` so that it is made then, not when `update` returns.
command : (⊤ → Result Error ⊤), (Error → msg) → Cmd msg
command attempt refused = Cmd.perform λsend →
    case attempt ⊤ of
        Ok ⊤ →
            ⊤

        Err error →
            send (refused error)


--| The direct form of `pushUrl`: add an entry to the browser's history
--| with the URL, resolved against the page, and tell every follower of
--| the address. The page is not reloaded.
pub push : Key, String → Result Error ⊤
push _ url = change "pushState" url


--| The direct form of `replaceUrl`: replace the current entry of the
--| browser's history with the URL, and tell every follower of the address.
pub replace : Key, String → Result Error ⊤
replace _ url = change "replaceState" url


--| The direct form of `back`: go back `n` entries in the history. The
--| address changes when the browser has gone back, and followers hear it
--| then; `n = 0` does nothing.
pub goBack : Key, Int → Result Error ⊤
goBack _ n = go (negate n)


--| The direct form of `forward`: go forward `n` entries in the history,
--| as `goBack` goes back.
pub goForward : Key, Int → Result Error ⊤
goForward _ n = go n


--| The direct form of `load`: leave the page for the URL, resolved
--| against the page. An address that does not resolve, and a
--| `javascript:` one, which would run text as script, is `BadUrl`.
pub loadPage : String → Result Error ⊤
loadPage url =
    target = resolve url
    if Js.isNull target || Js.same (Js.get target "protocol") (Js.from "javascript:") then
        Err (BadUrl url)
    else
        -- `assign` documents a `SyntaxError` for an address it cannot
        -- parse and a `SecurityError` for one it refuses; nothing else is
        -- caught (CLAUDE.md rule 9).
        Js.catchIf
            (λ⊤ →
                _ = Js.call (Js.global "location") "assign" [ Js.get target "href" ]
                Ok ⊤
            )
            (λerror → isDomException error "SyntaxError" || isDomException error "SecurityError")
            λerror →
                if isDomException error "SyntaxError" then
                    Err (BadUrl url)
                else
                    Err Throttled


--| The direct form of `reload`: load the page again.
pub reloadPage : ⊤ → ⊤
reloadPage ⊤ = Js.to (Js.call (Js.global "location") "reload" [])


-- The subscriptions' keys, one type each, so a page that follows only the
-- address compares no key of the other.
type Follow
    = UrlChange


type Requests
    = LinkClick


--| Call `f` with each click on a link the page should handle itself, for
--| as long as the calling fiber runs: the direct form of `onUrlRequest`.
--| One listener on the window decides, while the click is dispatched and
--| after every handler on the page has run, and prevents the host from
--| following the link when it is a request: a plain click (the main
--| button, no Ctrl, Meta, Shift or Alt) whose default nothing prevented,
--| on an `<a href>` with no `download` and a `target` that is empty or
--| `_self`. Any other click is the host's. It covers the whole document,
--| markup outside a program's mount included. It never returns.
pub eachUrlRequest : (Browser.UrlRequest → ⊤) → ⊤
eachUrlRequest f = Listen.each requests f


--| Each click on a link the page should handle itself, as `eachUrlRequest`
--| decides it: `Internal` with its `Url` for a link to the page's own
--| protocol, host and port, `External` with its `href` for any other.
pub onUrlRequest : (Browser.UrlRequest → msg) → Sub msg
onUrlRequest tag = Sub.on LinkClick requests tag


-- The listener both forms run: one on the window's clicks, which decides
-- while the click is dispatched.
requests : sync (Browser.UrlRequest → ⊤) → (⊤ → ⊤)
requests send = Listen.on "window" "click" request λr → sendRequest send r


sendRequest : sync (Browser.UrlRequest → ⊤), Maybe Browser.UrlRequest → ⊤
sendRequest send r =
    case r of
        Just u →
            send u

        Nothing →
            ⊤


-- Elm's guard, made precise (`boundary.md` §9.8.13 (c)), decided while the
-- click is dispatched: a default already prevented has been handled, a
-- modified or non-main click is the user asking the host, and so is a link
-- that downloads or opens elsewhere.
request : Js.Value → Maybe Browser.UrlRequest
request event =
    if
        Js.to (Js.get event "defaultPrevented")
            || not (Js.same (Js.get event "button") (Js.from 0))
            || Js.to (Js.get event "ctrlKey")
            || Js.to (Js.get event "metaKey")
            || Js.to (Js.get event "shiftKey")
            || Js.to (Js.get event "altKey")
    then
        Nothing
    else
        a = anchorOf event
        if
            Js.isNull a
                || not (Js.to (Js.call a "hasAttribute" [ Js.from "href" ]))
                || Js.to (Js.call a "hasAttribute" [ Js.from "download" ])
                || not (sameContext (Js.call (Js.get a "target") "toLowerCase" []))
        then
            Nothing
        else
            _ = Js.call event "preventDefault" []
            href : String
            href = Js.to (Js.get a "href")
            location = Js.global "location"
            case Url.fromString href of
                Just url →
                    if
                        Js.same (Js.get a "protocol") (Js.get location "protocol")
                            && Js.same (Js.get a "host") (Js.get location "host")
                    then
                        Just (Browser.Internal url)
                    else
                        Just (Browser.External href)

                Nothing →
                    Just (Browser.External href)


sameContext : Js.Value → Bool
sameContext target = Js.same target (Js.from "") || Js.same target (Js.from "_self")


-- The nearest `<a>` at or above the click's target, along its composed
-- path, or null.
anchorOf : Js.Value → Js.Value
anchorOf event =
    found = Js.ref Js.null
    anchor = Js.global "HTMLAnchorElement"
    Js.each (Js.call event "composedPath" []) λnode →
        if Js.isNull (Js.read found) && Js.instanceOf node anchor then
            Js.write found node
    Js.read found


--| Call `f` with the page's new address each time it changes, for as long
--| as the calling fiber runs: the direct form of `onUrlChange` (§9.8.11).
--| It hears the back and forward buttons, a link to a fragment followed,
--| and every `pushUrl` and `replaceUrl` on the page. It never returns;
--| cancelling the fiber removes the listener. An address that is not a
--| `Url` is skipped.
pub eachUrlChange : (Url → ⊤) → ⊤
eachUrlChange f = Listen.each follow f


--| The page's new address each time it changes. An address that is not a
--| `Url` sends nothing.
pub onUrlChange : (Url → msg) → Sub msg
onUrlChange tag = Sub.on UrlChange follow tag


-- The listener both forms run: `popstate`, which a browser fires for a
-- fragment followed and for the back and forward buttons, and this
-- module's own announcement of a push or a replace, in the order they
-- fire. The address is read when each fires.
follow : sync (Url → ⊤) → (⊤ → ⊤)
follow send = Listen.on2 "window" "popstate" announcement (λ_ → currentUrl ⊤) λurl →
    sendUrl send url


sendUrl : sync (Url → ⊤), Maybe Url → ⊤
sendUrl send url =
    case url of
        Just u →
            send u

        Nothing →
            ⊤


-- The event every push and replace is announced by: the platform's own,
-- so other code on the page sees `popstate` only for the host's traversals.
announcement : String
announcement = "beni:navigate"


-- Resolve the URL against the page, check its origin, then make the
-- change. `pushState` and `replaceState` document a `SecurityError`: for
-- another origin, which is found first, and for too many calls, which
-- Safari and Firefox throw. Chrome drops a call over its limit with a
-- warning instead, so the address is compared afterwards — the one way to
-- see that drop.
change : String, String → Result Error ⊤
change method url =
    target = resolve url
    location = Js.global "location"
    if Js.isNull target then
        Err (BadUrl url)
    else if not (Js.same (Js.get target "origin") (Js.get location "origin")) then
        Err (CrossOrigin url)
    else
        href = Js.get target "href"
        changed =
            Js.catchIf
                (λ⊤ →
                    _ = Js.call (Js.global "history") method [ Js.null, Js.from "", href ]
                    Js.same (Js.get location "href") href
                )
                (λerror → isDomException error "SecurityError")
                λ_ → False
        if changed then
            _ =
                Js.call (Js.global "window") "dispatchEvent"
                    [ Js.construct (Js.global "Event") [ Js.from announcement ] ]
            Ok ⊤
        else
            Err Throttled


go : Int → Result Error ⊤
go n =
    if n == 0 then
        Ok ⊤
    else
        Js.catchIf
            (λ⊤ →
                _ = Js.call (Js.global "history") "go" [ Js.from n ]
                Ok ⊤
            )
            (λerror → isDomException error "SecurityError")
            λ_ → Err Throttled


-- The URL resolved against the page's address, or null: `URL.parse`
-- answers null for what does not resolve, and an engine without it has
-- `new URL`, whose one documented failure is a `TypeError`.
resolve : String → Js.Value
resolve url =
    constructor = Js.global "URL"
    base = Js.get (Js.global "location") "href"
    if Js.isUndefined (Js.get constructor "parse") then
        Js.catchIf
            (λ⊤ → Js.construct constructor [ Js.from url, base ])
            (λerror → Js.instanceOf error (Js.global "TypeError"))
            λ_ → Js.null
    else
        Js.call constructor "parse" [ Js.from url, base ]


isDomException : Js.Value, String → Bool
isDomException error name =
    Js.instanceOf error (Js.global "DOMException") && Js.same (Js.get error "name") (Js.from name)
