--! Fibers: functions that may wait, running side by side
--! (`transparent-effects-proposal.md` §16).
--!
--! A beni function that may wait for something — a timer, a network reply,
--! another fiber — is written like any other function. The compiler infers
--! that it may suspend and emits it so that it can stop in the middle and be
--! resumed later; nothing in the source says so. This module is what such
--! functions run on: a fiber is one line of execution, and many fibers take
--! turns on one JavaScript thread.
--!
--! **Structured.** A fiber started with `spawn` belongs to the fiber that
--! started it and is cancelled when that one ends; one started in a `scope`
--! belongs to the scope and is cancelled, and waited for, when the scope's
--! function returns. Nothing a fiber starts outlives what started it unless
--! it is joined first.
--!
--! **Cancellation is prompt and cleanup is guaranteed.** A fiber that is
--! waiting when it is cancelled stops waiting at once; the release of every
--! `bracket` it is inside runs, last first, before `cancel` returns.
--! Cancellation is delivered only where a fiber may suspend, so a function
--! that never waits is never interrupted in the middle.
--!
--! **A defect ends the program.** There are no exceptions: a failure you
--! expect is a `Result`, and a fiber ends either `Done` with its value or
--! `Cancelled`.

-- One Control Cell holds intrusive links and the private resume/result slot.
-- Stored callables remain charged to their writer; native resources keep their types.

import Browser.Host.Date as HostDate
import Browser.Host.Immediate as Immediate
import Browser.Host.Math as HostMath
import Browser.Host.MessageChannel as MessageChannel
import Browser.Host.MessagePort as MessagePort
import Browser.Host.Timers as Timers
import Duration exposing (Duration)
import Js
import Js.Array as Array
import Js.Chain as Chain exposing (Chain, Link)
import Js.Fifo as Fifo
import Js.Kernel as Kernel
import Js.Runtime as Runtime
import Js.TaskHooks as Hooks
import List
import Record
import Schedule exposing (Schedule)


--| How a fiber ended.
pub type Exit a
    = Done a
    | Cancelled


--| A fiber that is running, or has ended. `join` waits for its value.
pub opaque type Fiber a
    = Fiber Control


--| How a platform's primitive resumes the fiber that waits on it, once: a
--| JavaScript function the platform calls with the value.
pub opaque type Resume a
    = Resume (a → ⊤)


-- Original typed work retains its captures and returns unit or the sentinel.
type alias UnitJob =
    ⊤ → ⊤


type alias Frame =
    Kernel.Slot


type Control
    = Control (Js.Cell ControlFields)


type alias ControlFields =
    flags : Int
    ordinal : Int
    masks : Int
    top : Js.Opt Frame
    frames : Js.Opt FrameStack
    value : Kernel.Slot
    owner : Js.Opt Control
    group : Js.Opt Scope
    before : Js.Opt Control
    after : Js.Opt Control
    children : Js.Opt Control
    finalizers : Js.Opt Finalizer
    wait : Js.Opt Kernel.Slot
    wbefore : Js.Opt Control
    wafter : Js.Opt Control
    joiners : Js.Opt (WaitList ⊤)
    slots : Slots
    ext : Js.Opt ControlExt


type FrameStack
    = FrameStack (Js.Cell { values : Js.Builder (Js.Opt Frame), count : Int })


type Finalizer
    = Finalizer
        (Js.Cell { key : Int, before : Js.Opt Finalizer, after : Js.Opt Finalizer })


type ControlExt
    = ControlExt
        (Js.Cell
            { member : Maybe Scheduler
            , cleanBefore : Js.Opt Control
            , cleanAfter : Js.Opt Control
            , outsideOwner : Maybe Control
            , scopes : Js.Opt Scope
            , observers : Maybe (Chain (⊤ → ⊤))
            , report : Maybe (⊤ → ⊤)
            }
        )


-- Core-only coordination; wake writes its typed result into the waiting fiber.
pub opaque type WaitList a
    = WaitList (Js.Cell { first : Js.Opt Control, last : Js.Opt Control })


--| The fibers a `scope` started. It is cancelled, and waited for, when the
--| scope's function returns.
pub opaque type Scope
    = Scope
        (Js.Cell
            { children : Js.Opt Control
            , closed : Bool
            , deferred : Maybe (Chain Int)
            , finalizer : Js.Opt Finalizer
            , root : Bool
            , listed : Maybe Scheduler
            , waiters : Js.Opt (WaitList ⊤)
            , owner : Js.Opt Control
            , before : Js.Opt Scope
            , after : Js.Opt Scope
            }
        )


--| Work queued to run once, in no fiber, where a fiber started now would
--| first run: `soon` makes one, and it is `queued` until it has run.
pub opaque type Soon
    = Soon
        (Js.Cell
            { work : Maybe (⊤ → ⊤)
            , sched : Scheduler
            , next : Js.Opt Soon
            , position : Int
            , group : Js.Opt Scope
            }
        )


--| What `restore` is handed: a way back, inside an `uninterruptibleMask`,
--| to the interruptibility there was where the mask was entered.
pub opaque type Restore
    = Restore (Js.Cell { depth : Int, fiber : Control, live : Bool })


pub opaque type VirtualClock
    = VirtualClock (Js.Cell { now : Int, sleepers : Chain Sleeper })


type Sleeper
    = Sleeper Int (Resume ⊤)


type alias Slots =
    clock : Maybe VirtualClock
    sched : Maybe Scheduler
    log : Maybe (⊤ → ⊤)
    seed : Maybe Int


--| A scheduler of its own: a queue of ready fibers drained apart from the
--| program's, by a drain its maker queues. A fiber whose scheduler slot
--| names one (`withScheduler`) is resumed through it and never through the
--| program's queue, and a defect under it stops that scheduler alone — its
--| fibers are cancelled and their cleanup run, and nothing else is touched.
--| What a platform gives each request or each object a runtime of its own
--| with; a program may make one too.
pub opaque type Scheduler
    = Scheduler
        (Js.Cell
            { queue : JobQueue
            , scheduled : Bool
            , queuing : Bool
            , runner : (⊤ → ⊤) → ⊤
            , more : (⊤ → ⊤) → ⊤
            , hook : Maybe (⊤ → ⊤)
            , roots : Js.Opt Control
            , rootScopes : Js.Opt Scope
            , loans : Maybe (Chain Loan)
            , live : Int
            , idle : Maybe (⊤ → ⊤)
            , watch : Maybe (Int → ⊤)
            , phase : Int
            , culprit : Maybe Control
            , done : Maybe (Int → ⊤)
            , deadline : Int
            , timer : Maybe (⊤ → ⊤)
            , expired : Bool
            , abandoned : Int
            , sweeping : Sweep
            , torn : Bool
            , listed : Maybe (Link Scheduler)
            , program : Bool
            , serial : Int
            }
        )


emptySlots : Slots
emptySlots = { clock = Nothing, sched = Nothing, log = Nothing, seed = Nothing }


current : Js.Ref (Maybe Control)
current = Js.ref Nothing


outside : Js.Ref (Maybe Control)
outside = Js.ref Nothing


pending : Js.Ref Int
pending = Js.ref 0


soonRunning : Js.Ref (Maybe Soon)
soonRunning = Js.ref Nothing


cleaning : Js.Ref (Js.Opt Control)
cleaning = Js.ref (Js.none ⊤)


schedulers : Chain Scheduler
schedulers = Chain.make ⊤


fibered : Js.Ref Bool
fibered = Js.ref False


sentinel : Js.Value
sentinel = Runtime.parked ⊤


--| Used by the code the compiler emits, and by nothing else: always `False`
--| for any value a program can hold.
pub isWaiting : a → Bool
isWaiting value = Js.same value sentinel


-- Source calls are ordinary application. Only compiler-generated callers
-- can hand the sentinel to this compatibility operation.
--| Used by the code the compiler emits for a function that may suspend, and
--| by nothing else: `andThen value next` is `next value`. Calling it by hand
--| is allowed and does exactly that. Its effects include those of `next`.
pub andThen : a, sync (a → b) → b
andThen value next = next value


chain : a, (a → b) → b
chain _ next =
    mode = Js.read pending
    if mode > 0 then
        Array.arrayWrite pendingFrames (mode - 1) (Js.some (Kernel.slotPack next))
        Js.write pending (mode + 1)
    else if mode == 0 then
        Runtime.defect "a parked result had no pending operation"
    Runtime.parked ⊤


unitJob : (⊤ → ⊤) → UnitJob
unitJob work = work


-- Raw user work is deliberately separate from records holding normal hooks.
-- #1917 tracks the checker's field-effect precision gap.
type alias WorkStore a =
    values : Js.Builder (Js.Opt a)
    free : Js.Builder Int
    first : Int


newWorkStore : ⊤ → Js.Cell (WorkStore a)
newWorkStore ⊤ =
    Js.cell { values = Array.arrayAllocate 0, free = Array.arrayAllocate 0, first = 0 - 1 }


unitWork : Js.Cell (WorkStore UnitJob)
unitWork = newWorkStore ⊤


exitWork : Js.Cell (WorkStore (Exit ⊤ → ⊤))
exitWork = newWorkStore ⊤


keepWork : Js.Cell (WorkStore a), a → Int
keepWork store work =
    first = Js.cellRead store .first
    values = Js.cellRead store .values
    key =
        if first < 0 then
            Array.arrayLength values
        else
            Js.cellWrite store (Array.arrayGet (Js.cellRead store .free) first) .first
            first
    Array.arrayWrite values key (Js.some work)
    key


takeWork : Js.Cell (WorkStore a), Int → a
takeWork store key =
    values = Js.cellRead store .values
    work = required (Array.arrayGet values key)
    Array.arrayWrite values key (Js.none ⊤)
    Array.arrayWrite (Js.cellRead store .free) key (Js.cellRead store .first)
    Js.cellWrite store key .first
    work


runExitJob : (Exit ⊤ → ⊤), Exit ⊤ → ⊤
runExitJob job exit = Js.suspending λ⊤ → Js.invoke job exit


newControl : Slots → Control
newControl slots =
    Js.write fibered True
    installHooks ⊤
    (Scheduler p) = program
    ordinal = Js.cellRead p .serial
    if ordinal == 9007199254740991 then Runtime.defect "the fiber birth ordinal was exhausted"
    Js.cellWrite p (ordinal + 1) .serial
    Control
        (Js.cell
            { flags = 0
            , ordinal = ordinal
            , masks = 0
            , top = Js.none ⊤
            , frames = Js.none ⊤
            , value = Kernel.slotPack ⊤
            , owner = Js.none ⊤
            , group = Js.none ⊤
            , before = Js.none ⊤
            , after = Js.none ⊤
            , children = Js.none ⊤
            , finalizers = Js.none ⊤
            , wait = Js.none ⊤
            , wbefore = Js.none ⊤
            , wafter = Js.none ⊤
            , joiners = Js.none ⊤
            , slots = slots
            , ext = Js.none ⊤
            }
        )


here : ⊤ → Control
here ⊤ =
    case Js.read current of
        Just fiber →
            fiber
        Nothing →
            case Js.read outside of
                Just fiber →
                    fiber
                Nothing →
                    made = newControl emptySlots
                    Js.write outside (Just made)
                    made


slotsOf : Maybe Control → Slots
slotsOf fiber =
    case fiber of
        Nothing →
            emptySlots
        Just (Control c) →
            (Js.cellRead c .slots)


currentSlots : ⊤ → Slots
currentSlots ⊤ =
    if not (Js.read slotted) then
        emptySlots
    else
        case Js.read current of
            Nothing →
                slotsOf (Js.read outside)
            fiber →
                slotsOf fiber


endedControl : Control → Bool
endedControl (Control c) = (has c endedBit)


interrupted : Control → Bool
interrupted (Control c) =
    (has c interruptBit) && (Js.cellRead c .masks) == 0 && not ((has c unwindBit))


--| Wait for a platform's callback: the one way a fiber suspends. The
--| function is called at once with the `Resume` the platform hands its host
--| callback, and returns what cancels the wait. When the host calls back
--| before the function returns, nothing waits at all.
--|
--|     sleep ms =
--|         Task.callback λresume → startTimer ms resume
pub callback : sync (Resume a → sync (⊤ → ⊤)) → a
callback register = Js.suspending λ⊤ → callbackWith register


callbackWith : sync (Resume a → sync (⊤ → ⊤)) → a
callbackWith register =
    Js.write callbacking True
    fiber = here ⊤
    if interrupted fiber then
        Js.write pending (0 - 1)
        Runtime.parked ⊤
    else
        (Control c) = fiber
        set c hostBit True
        set c parkedBit True
        set c readyBit False
        set c syncBit True
        wake value =
            if has c hostBit && Js.same (Js.cellRead c .value) wake then
                Js.cellWrite c (Kernel.slotPack value) .value
                set c hostBit False
                set c readyBit True
                if not (has c syncBit) then enqueue fiber
        Js.cellWrite c (Kernel.slotPack wake) .value
        stopWait = register (Resume wake)
        set c syncBit False
        if interrupted fiber then
            Js.invoke stopWait ⊤
            Js.write pending (0 - 1)
            Runtime.parked ⊤
        else if has c readyBit then
            set c readyBit False
            set c parkedBit False
            Kernel.slotRead (Js.cellRead c .value)
        else
            Js.cellWrite c (Js.some (Kernel.slotPack stopWait)) .wait
            Js.write pending 1
            Runtime.parked ⊤


--| Answer the wait `resume` belongs to with `value`: the fiber that waits
--| is queued to go on with it, and runs at a later turn, never inside this
--| call. Once only: a second `resume` of the same wait does nothing, and so
--| does one after the waiting fiber was cancelled. Called while the
--| function `callback` was given is still running, it answers the wait at
--| once and nothing waits at all.
--|
--| What lets a program finish a wait it started itself, and so write its
--| own coordination — a gate, a mailbox — over `callback` and a `Ref`.
--|
--|     gate = Ref.make Nothing
--|     opened = Task.spawn λ⊤ → Task.callback λr →
--|         _ = Ref.set gate (Just r)
--|         λ⊤ → Ref.set gate Nothing
--|     -- later, from another fiber:
--|     case Ref.get gate of
--|         Just r → Task.resume r "open"
--|         Nothing → ⊤
pub resume : Resume a, a → ⊤
resume (Resume wake) value =
    Js.invoke wake value
    ⊤


--| Let every other fiber that is ready run first.
pub yieldNow : ⊤ → ⊤
yieldNow ⊤ = Js.suspending λ⊤ → park True


--| Wait forever. Only cancelling the fiber ends the wait. Effect's `never`.
pub never : ⊤ → a
never ⊤ = Js.suspending λ⊤ → park False


park : Bool → a
park again =
    fiber = here ⊤
    if interrupted fiber then
        Js.write pending (0 - 1)
    else
        c = cellOf fiber
        Js.cellWrite c (Kernel.slotPack ⊤) .value
        set c parkedBit True
        if again then enqueue fiber
        Js.write pending 1
    Runtime.parked ⊤


selfCancel : ⊤ → a
selfCancel ⊤ = Js.suspending λ⊤ →
    set (cellOf (here ⊤)) interruptBit True
    Js.write pending (0 - 1)
    Runtime.parked ⊤


runFiber : Control → ⊤
runFiber ((Control c) as fiber) =
    outer = Js.read current
    Js.write current (Just fiber)
    if Js.read callbacking && has c readyBit && not (interrupted fiber) then
        set c readyBit False
        Js.cellWrite c (Js.none ⊤) .wait
    set c parkedBit False
    runLoop fiber
    Js.write current outer


runLoop : Control → ⊤
runLoop ((Control c) as fiber) =
    mode = Js.read pending
    Js.write pending 0
    if mode > 0 then acceptFrames fiber (mode - 1)
    if mode < 0 then
        forceCancel fiber
        runLoop fiber
    else if interrupted fiber then
        unwind fiber
        runLoop fiber
    else if has c endedBit then
        ⊤
    else if mode > 0 then
        if Js.read finalising && inCleanup fiber && deadlinePassed fiber then
            abandon fiber
            runLoop fiber
    else
        frame = popFrame c
        if absent frame then
            if not (has c unwindBit) then finishReturned fiber
            advanceUnwind fiber
            runLoop fiber
        else
            runStep fiber (required frame)
            runLoop fiber


runStep : Control, Frame → ⊤
runStep (Control c) frame =
    result = Js.invoke (Kernel.slotRead frame) (Js.cellRead c .value)
    if isWaiting result then
        if Js.read pending == 0 then Runtime.defect "a parked result had no pending operation"
    else
        Js.cellWrite c result .value


unwind : Control → ⊤
unwind ((Control c) as fiber) =
    set c unwindBit True
    set c cancelBit True
    if Js.read spawning then set c cleanupPhaseBit False
    case clearWait fiber of
        Nothing →
            ⊤
        Just stopWait →
            Js.invoke stopWait ⊤
            ⊤
    clearFrames c
    Js.cellWrite c (Kernel.slotPack ⊤) .value


finishCancelled : Control → ⊤
finishCancelled ((Control c) as fiber) =
    set c cancelBit True
    Js.cellWrite c (Kernel.slotPack ⊤) .value
    complete fiber


enterCleanup : Control → ⊤
enterCleanup ((Control c) as fiber) =
    (ControlExt extra) = extension c
    if absent (Js.cellRead extra .cleanBefore) then
        first = Js.read cleaning
        if absent first then
            Js.cellWrite extra (Js.some fiber) .cleanBefore
            Js.cellWrite extra (Js.some fiber) .cleanAfter
            Js.write cleaning (Js.some fiber)
        else
            (ControlExt head) = extension (cellOf (required first))
            last = Js.cellRead head .cleanBefore
            (ControlExt tail) = extension (cellOf (required last))
            Js.cellWrite extra last .cleanBefore
            Js.cellWrite extra first .cleanAfter
            Js.cellWrite tail (Js.some fiber) .cleanAfter
            Js.cellWrite head (Js.some fiber) .cleanBefore
    case Js.cellRead extra .outsideOwner of
        Nothing →
            ⊤
        Just (Control holder) →
            old = Js.cellRead holder .slots
            Js.cellWrite c { Record.copy old | sched = Nothing } .slots


leaveCleanup : Control → ⊤
leaveCleanup ((Control c) as fiber) =
    if Js.read finalising && not (absent (Js.cellRead c .ext)) then
        (ControlExt extra) = required (Js.cellRead c .ext)
        if not (absent (Js.cellRead extra .cleanBefore)) then
            before = Js.cellRead extra .cleanBefore
            after = Js.cellRead extra .cleanAfter
            if Js.same (required after) fiber then
                Js.write cleaning (Js.none ⊤)
            else
                (ControlExt prev) = extension (cellOf (required before))
                (ControlExt next) = extension (cellOf (required after))
                Js.cellWrite prev after .cleanAfter
                Js.cellWrite next before .cleanBefore
                if Js.same (required (Js.read cleaning)) fiber then Js.write cleaning after
            Js.cellWrite extra (Js.none ⊤) .cleanBefore
            Js.cellWrite extra (Js.none ⊤) .cleanAfter


inCleanup : Control → Bool
inCleanup (Control c) =
    if not (Js.read finalising) then
        False
    else
        Js.optMatch (Js.cellRead c .ext) (λ⊤ → False) λ(ControlExt extra) →
            not (absent (Js.cellRead extra .cleanBefore))


cutBack : Control → ⊤
cutBack ((Control c) as fiber) =
    clearFrames c
    leaveCleanup fiber


halt : Control → ⊤
halt ((Control c) as fiber) =
    if not (has c endedBit || has c unwindBit) then
        set c interruptBit True
        if has c parkedBit && Js.cellRead c .masks == 0 then
            stop = clearWait fiber
            enqueue fiber
            case stop of
                Nothing →
                    ⊤
                Just cancelWait →
                    Js.invoke cancelWait ⊤
                    ⊤


complete : Control → ⊤
complete ((Control c) as fiber) =
    set c endedBit True
    clearFrames c
    if Js.read finalising then leaveCleanup fiber
    unlinkOwner fiber
    if not (absent (Js.cellRead c .ext)) then
        (ControlExt extra) = required (Js.cellRead c .ext)
        report = Js.cellRead extra .report
        Js.cellWrite extra Nothing .report
        case report of
            Nothing →
                ⊤
            Just notify →
                Js.invoke notify ⊤
                ⊤
        if Js.read observed then
            case Js.cellRead extra .observers of
                Nothing →
                    ⊤
                Just observers →
                    runJobs observers
    joiners = Js.cellRead c .joiners
    Js.cellWrite c (Js.none ⊤) .joiners
    if Js.read joined && not (absent joiners) then wakeAll (required joiners) ⊤
    if has c registeredBit then
        if Js.read many then
            case memberOf c of
                Nothing →
                    ⊤
                Just sched →
                    countDown sched
        countDown program
    Js.cellWrite c (Js.none ⊤) .ext
    if Js.read slotted then Js.cellWrite c emptySlots .slots


runJobs : Chain (⊤ → ⊤) → ⊤
runJobs jobs =
    case Chain.shift jobs of
        Nothing →
            ⊤
        Just job →
            Js.invoke job ⊤
            runJobs jobs


cancelControls : List Control → ⊤
cancelControls fibers =
    each fibers halt
    waitControls fibers


waitControls : List Control → ⊤
waitControls fibers =
    case fibers of
        [] →
            ⊤
        [ fiber, …rest ] →
            waitControl fiber
            waitControls rest


makeFiber : Slots, (⊤ → a) → Fiber a
makeFiber slots work =
    fiber = newControl slots
    c = cellOf fiber
    initial = λ⊤ → Js.invoke work ⊤
    Js.cellWrite c (Js.some (Kernel.slotPack initial)) .top
    Fiber fiber


--| How a fiber ended, `Just` once it has and `Nothing` while it runs,
--| without waiting. A fiber that is cancelled but still running its cleanup
--| is running.
pub poll : Fiber a → Maybe (Exit a)
poll (Fiber (Control c)) =
    if has c endedBit then
        Just (if has c cancelBit then Cancelled else Done (Kernel.slotRead (Js.cellRead c .value)))
    else
        Nothing


--| Whether a fiber is still running: `False` once it has ended, either
--| way. A fiber that has been cancelled but is still running its cleanup
--| is still running.
pub running : Fiber a → Bool
running (Fiber fiber) = not (endedControl fiber)


--| Wait for a fiber to end, and say how.
pub wait : Fiber a → Exit a
wait ((Fiber control) as fiber) =
    waitControl control
    case poll fiber of
        Just value →
            value
        Nothing →
            Runtime.defect "a fiber wait completed before its target ended"


--| Wait for a fiber's value. If it was cancelled, the fiber that joins it is
--| cancelled too.
pub join : Fiber a → a
join (Fiber ((Control c) as fiber)) =
    waitControl fiber
    if has c cancelBit then selfCancel ⊤ else Kernel.slotRead (Js.cellRead c .value)


--| Cancel a fiber and wait until its cleanup has run. Cancelling a fiber
--| that has ended does nothing.
pub cancel : Fiber a → ⊤
cancel (Fiber fiber) =
    halt fiber
    waitControl fiber


--| Wait for every fiber in the list, then answer their values, in list
--| order. If any of them was cancelled, the fiber that waits is cancelled
--| too, as `join` of that one would — but only once every fiber has ended.
--| A fiber named twice is waited for once and its value given twice.
pub joinAll : List (Fiber a) → List a
joinAll fibers =
    waitControls (List.map fibers λ(Fiber fiber) → fiber)
    List.map fibers join


--| Cancel every fiber in the list, in list order, and wait until all of
--| them have ended and run their cleanup. A fiber that has ended is left
--| as it is; a fiber that belongs to a scope still belongs to it.
pub cancelAll : List (Fiber a) → ⊤
cancelAll fibers = cancelControls (List.map fibers λ(Fiber fiber) → fiber)


--| Run `work` again and again. It ends only when the fiber is cancelled,
--| and then the cleanup of the run in progress runs, as for any other
--| cancelled work. After each run it lets every other ready fiber run
--| first, as `yieldNow` does, so a `work` that never waits cannot starve
--| them and can still be cancelled. A loop of any length uses no stack.
--| Effect's `forever`.
--|
--|     _ = Task.spawn λ⊤ → Task.forever λ⊤ →
--|         Latch.wait ready
--|         tick ⊤
--|
--| A loop that should stop is not a `forever`. A loop over a `Queue`
--| that can end is a recursive function that stops on `Nothing`:
--|
--|     work jobs = case Queue.take jobs of
--|         Just job → handle job; work jobs
--|         Nothing → ⊤
pub forever : (⊤ → a) → b
forever work =
    _ = work ⊤
    yieldNow ⊤
    forever work


newJobs : ⊤ → JobQueue
newJobs ⊤ =
    Js.cell
        { first = Js.none ⊤
        , last = Js.none ⊤
        , soonFirst = Js.none ⊤
        , soonLast = Js.none ⊤
        , enqueued = 0
        , dequeued = 0
        }


jobsEmpty : JobQueue → Bool
jobsEmpty q =
    if Js.read soonable then
        absent (Js.cellRead q .first) && absent (Js.cellRead q .soonFirst)
    else
        absent (Js.cellRead q .first)


hosting : Js.Ref Bool
hosting = Js.ref False


program : Scheduler
program = newScheduler queueMicrotask macrotask True


newScheduler : sync ((⊤ → ⊤) → ⊤), sync ((⊤ → ⊤) → ⊤), Bool → Scheduler
newScheduler runner more root =
    Scheduler
        (Js.cell
            { queue = newJobs ⊤
            , scheduled = False
            , queuing = False
            , runner = runner
            , more = more
            , hook = Nothing
            , roots = Js.none ⊤
            , rootScopes = Js.none ⊤
            , loans = Nothing
            , live = 0
            , idle = Nothing
            , watch = Nothing
            , phase = 0
            , culprit = Nothing
            , done = Nothing
            , deadline = 0
            , timer = Nothing
            , expired = False
            , abandoned = 0
            , sweeping = Js.cell { values = Array.arrayAllocate 0, count = 0, at = 0 }
            , torn = False
            , listed = Nothing
            , program = root
            , serial = 0
            }
        )


queueMicrotask : sync (⊤ → ⊤) → ⊤
queueMicrotask task = Timers.queueMicrotask task


macrotask : sync (⊤ → ⊤) → ⊤
macrotask task =
    if not (Immediate.trySchedule task) then
        port = macroSender ⊤
        Fifo.push macroQueue task
        MessagePort.postUnit port


macroQueue : Fifo.Fifo (⊤ → ⊤)
macroQueue = Fifo.make ⊤


macroPort : Js.Ref (Maybe MessagePort.MessagePort)
macroPort = Js.ref Nothing


macroSender : ⊤ → MessagePort.MessagePort
macroSender ⊤ =
    case Js.read macroPort of
        Just port →
            port
        Nothing →
            channel = MessageChannel.create ⊤
            MessagePort.onMessage (MessageChannel.port1 channel) runMacro
            port = MessageChannel.port2 channel
            Js.write macroPort (Just port)
            port


runMacro : ⊤ → ⊤
runMacro ⊤ =
    if not (Fifo.empty macroQueue) then
        work = Fifo.shift macroQueue
        Js.invoke work ⊤
        ⊤


nativeTimer : Int, sync (⊤ → ⊤) → (⊤ → ⊤)
nativeTimer milliseconds work =
    handle = Timers.start work milliseconds
    λ⊤ → Timers.clear handle


schedulerHere : ⊤ → Scheduler
schedulerHere ⊤ =
    if not (Js.read many) then
        program
    else
        case (currentSlots ⊤).sched of
            Nothing →
                program
            Just sched →
                sched


schedulerOf : Control → Scheduler
schedulerOf (Control c) =
    if not (Js.read many) then
        program
    else
        case ((Js.cellRead c .slots)).sched of
            Nothing →
                program
            Just sched →
                sched


stopped : Scheduler → Bool
stopped (Scheduler s) = (Js.cellRead s .phase) ≠ 0 || (Js.cellRead s .program && Hooks.stopped ⊤)


endedScheduler : Scheduler → Bool
endedScheduler (Scheduler s) = (Js.cellRead s .phase) == 3


enqueue : Control → ⊤
enqueue ((Control c) as fiber) =
    if not (has c queuedBit) then
        sched = schedulerOf fiber
        target = if endedScheduler sched then program else sched
        if endedScheduler sched then set c interruptBit True
        (Scheduler s) = target
        q = Js.cellRead s .queue
        if Js.cellRead q .enqueued == 9007199254740991 then
            Runtime.defect "the run queue position was exhausted"
        set c queuedBit True
        Js.cellWrite c (Js.none ⊤) .wafter
        last = Js.cellRead q .last
        if absent last then
            Js.cellWrite q (Js.some fiber) .first
        else
            Js.cellWrite (cellOf (required last)) (Js.some fiber) .wafter
        Js.cellWrite q (Js.some fiber) .last
        Js.cellWrite q (Js.cellRead q .enqueued + 1) .enqueued
        requestDrain target


-- The host scheduler retains this closed drain. Its captures escape; the
-- scheduler handle can be retained with it; mutable state is behind Js.Ref.
requeue : escaped Scheduler, escaped sync (⊤ → ⊤) → ⊤
requeue (Scheduler s) task =
    Js.cellWrite s True .queuing
    (Js.cellRead s .runner) task
    Js.cellWrite s False .queuing


--| How the platform runs each drain of the scheduler: `f` is handed the
--| drain and calls it once, at once. The browser's makes the drain a
--| turn, so the messages its fibers send render when it returns
--| (`backend.md` §15.11), not on a microtask after it. The last one given
--| is the one used.
pub onTurn : sync ((⊤ → ⊤) → ⊤) → ⊤
onTurn around = Hooks.onTurn around


--| Run `f`, a callback the platform registered with its host — a timer's,
--| a promise reaction's — which the host calls with nothing beneath it:
--| the fibers it resumes run when it returns, in the same callback, where
--| they would have run on the microtask after it. Never for a callback
--| the host may call while other code runs, such as an event's listener.
pub fromHost : sync (⊤ → ⊤) → ⊤
fromHost work =
    (Scheduler s) = program
    if (Js.cellRead s .scheduled) then
        work ⊤
    else
        Js.write hosting True
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                work ⊤
                Js.write ok True
            )
            λ⊤ →
                Js.write hosting False
                if not (Js.read ok) && (Js.cellRead s .scheduled) then
                    queueMicrotask λ⊤ → drain program
        if (Js.cellRead s .scheduled) then drain program


--| What runs when a fiber throws: a defect, after which no program code runs
--| again (`boundary.md` §9.8.10 (c)). A platform hands it what stops its
--| program — the browser stops the page — and the throw goes on to the
--| host; then every fiber is cancelled and its cleanup run, as `shutdown`
--| does (§9.8.14). The last one given is the one called.
pub onDefect : sync (⊤ → ⊤) → ⊤
onDefect hook = Hooks.onDefect hook


--| Call `f` once, when the runtime stops (`shutdown`): in a microtask
--| queued at the stop, so after the throw that stopped it has gone on to
--| the host and before any fiber's cleanup, the functions given first
--| called first. What a platform releases a host resource no fiber
--| holds with — a listener a subscription added with no fiber
--| (`boundary.md` §9.8.5); a program never needs it.
pub onShutdown : sync (⊤ → ⊤) → ⊤
onShutdown release = Hooks.onShutdown release


drain : Scheduler → ⊤
drain ((Scheduler s) as sched) =
    if (Js.cellRead s .queuing) then
        Runtime.defect
            "a scheduler's run called its drain during the call; it must queue it to run later (Task.schedulerWith)"
    else if Js.cellRead s .program then
        Hooks.around λ⊤ → drainNow sched
    else
        drainNow sched


drainNow : Scheduler → ⊤
drainNow ((Scheduler s) as sched) =
    if Js.bitAnd ((Js.cellRead s .phase)) 1 ≠ 0 then
        ⊤
    else
        ok = Js.ref False
        emptied =
            Js.finally
                (λ⊤ →
                    value = drainFrom sched 0
                    Js.write ok True
                    value
                )
                λ⊤ → if Js.read ok then ⊤ else failed sched
        if emptied then Js.cellWrite s False .scheduled


drainFrom : Scheduler, Int → Bool
drainFrom ((Scheduler s) as sched) count =
    queue = Js.cellRead s .queue
    if jobsEmpty queue then
        True
    else if count == 64 || Js.cellRead s .phase == 1 then
        if Js.cellRead s .program || count == 64 then
            (Js.cellRead s .more) λ⊤ → drain sched
        else
            requeue sched λ⊤ → drain sched
        False
    else
        result = runQueued queue
        drainFrom sched (if result then count + 1 else count)


failed : Scheduler → ⊤
failed ((Scheduler s) as sched) =
    fiber = Js.read current
    Js.write current Nothing
    Js.write pending 0
    Js.write soonRunning Nothing
    case Js.read outside of
        Nothing →
            ⊤
        Just (Control c) →
            Js.cellWrite c 0 .masks
    if (Js.cellRead s .phase) < 2 then
        Js.cellWrite s fiber .culprit
        stopping sched
        if Js.cellRead s .program then
            Hooks.failed ⊤
        else
            case Js.cellRead s .hook of
                Nothing →
                    ⊤
                Just hook →
                    hook ⊤
    else
        case fiber of
            Nothing →
                ⊤
            Just control →
                if not (endedControl control) then
                    recover control
                    enqueue control
        if (Js.cellRead s .program) then
            macrotask λ⊤ → drain sched
        else
            requeue sched λ⊤ → drain sched


--| A scheduler for a platform: `run` is called once per batch of ready
--| work, with the drain, and must run it later — in a microtask, a promise
--| reaction, a host callback — never during the call; `more` is called
--| with the rest of a drain that has used its 64 resumptions, and must run
--| it in a later turn of the host's event loop — a timer — so that a fiber
--| that keeps yielding starves nothing (the Worker slice, P705-5); `hook`
--| is `scheduler`'s.
pub schedulerWith : sync ((⊤ → ⊤) → ⊤), sync ((⊤ → ⊤) → ⊤), sync (⊤ → ⊤) → Scheduler
schedulerWith runner more hook =
    Js.write many True
    installHooks ⊤
    sched = newScheduler runner more False
    (Scheduler s) = sched
    Js.cellWrite s (Just hook) .hook
    Js.cellWrite s (Just (Chain.append schedulers sched)) .listed
    sched


--| A scheduler whose drains run in a microtask of their own, and go on in
--| a macrotask after 64 resumptions, as the program's do, so a timer and
--| I/O get their turn. `hook` runs on a defect under it, in the stop,
--| before the throw goes on to the host, as `onDefect`'s does for the
--| program: the one piece of program code that runs there, and it may not
--| wait. `λ⊤ → ⊤` when nothing needs to know.
pub scheduler : sync (⊤ → ⊤) → Scheduler
scheduler hook = schedulerWith queueMicrotask macrotask hook


--| Whether a fiber of the scheduler still runs: one that belongs to it, or
--| one lent to it by `withScheduler`, running or parked. `False` once every
--| one has ended, and before any has started. What the `cloudflare`
--| platform asks after a request's answer, to know whether work outlives
--| it (`boundary.md` §9.12 (d)).
pub schedulerBusy : Scheduler → Bool
schedulerBusy (Scheduler s) = (Js.cellRead s .live) > 0


--| How many fibers of the scheduler still run: belonging or lent, running
--| or parked. What the `cloudflare` platform asks of an object's
--| scheduler, whose one consumer fiber always runs: more than one means a
--| fiber a handler started is still alive (`boundary.md` §9.12 (e.10)).
pub schedulerFibers : Scheduler → Int
schedulerFibers (Scheduler s) = (Js.cellRead s .live)


--| How many schedulers the kernel lists: every one made that has not
--| stopped for good. For a platform's test hook, where a fixture checks
--| that a request's scheduler leaves the list (`boundary.md` §9.12 (k)).
--| Public, because a platform's hook is beni that imports `Task`, and a
--| count that changes nothing is safe for any program to read; a build
--| that does not call it keeps nothing of it.
pub schedulersListed : ⊤ → Int
schedulersListed ⊤ = Chain.size schedulers


--| Call `f` once, the next time no fiber of the scheduler runs — at once,
--| during this call, when none does now. One `f` waits: the last one given
--| replaces the one before. It runs at the end of the last fiber, where
--| that fiber's `complete` or its leave from `withScheduler` counts it off,
--| with that fiber still the current one: a `resume` from `f` is queued as
--| any other, and a `spawn` makes a child of the fiber that ended. During
--| a stop it runs when the last fiber ends, before `done`. What the
--| `cloudflare` platform holds a request open with under `waitUntil`
--| while work outlives the answer, and lets go of the request with as soon
--| as that work ends (`boundary.md` §9.12 (d)).
pub onSchedulerIdle : Scheduler, sync (⊤ → ⊤) → ⊤
onSchedulerIdle (Scheduler s) hook =
    if (Js.cellRead s .live) == 0 then hook ⊤ else Js.cellWrite s (Just hook) .idle


--| Call `f` with the count each time a fiber of the scheduler ends or
--| leaves it, from the end of that fiber, with it still the current one,
--| as `onSchedulerIdle`'s function runs. One `f` watches: the last one
--| given replaces the one before. What the `cloudflare` platform answers
--| an `ask` with `NoReply` through, when the last fiber that could reply
--| has ended (`boundary.md` §9.12 (e.10)).
pub onSchedulerCount : Scheduler, sync (Int → ⊤) → ⊤
onSchedulerCount (Scheduler s) hook = Js.cellWrite s (Just hook) .watch


countDown : Scheduler → ⊤
countDown ((Scheduler s) as sched) =
    n = (Js.cellRead s .live) - 1
    Js.cellWrite s n .live
    if Js.read many then
        case (Js.cellRead s .watch) of
            Nothing →
                ⊤
            Just watch →
                watch n
    if n == 0 then
        if Js.read many then
            case (Js.cellRead s .idle) of
                Nothing →
                    ⊤
                Just idle →
                    Js.cellWrite s Nothing .idle
                    idle ⊤
        if (Js.cellRead s .phase) == 2 then allEnded sched


attachFiber : Maybe Control, Maybe Scope, Fiber a → ⊤
attachFiber parent group (Fiber ((Control c) as fiber)) =
    sched = schedulerOf fiber
    (Scheduler s) = sched
    (Scheduler p) = program
    Js.cellWrite p (Js.cellRead p .live + 1) .live
    if Js.read many && not (Js.cellRead s .program) && not (endedScheduler sched) then
        (ControlExt extra) = extension c
        Js.cellWrite extra (Just sched) .member
        Js.cellWrite s (Js.cellRead s .live + 1) .live
    if stopped program || stopped sched then set c interruptBit True
    case group of
        Nothing →
            ⊤
        Just attachedScope →
            listRoot attachedScope sched
    linkChild parent group fiber


registerRoot : Control, Scheduler → ⊤
registerRoot fiber _ =
    (Scheduler p) = program
    roots = appendChild (Js.cellRead p .roots) fiber
    Js.cellWrite p roots .roots


fork : Maybe Control, Maybe Scope, Slots, (⊤ → a) → Fiber a
fork parent group slots work =
    fiber = makeFiber slots work
    registerFiber parent group fiber
    (Fiber control) = fiber
    enqueue control
    fiber


--| Start `work` in a new fiber, a child of the current one, and return at
--| once. The child is cancelled when the current fiber ends.
pub spawn : (⊤ → a) → Fiber a
spawn work =
    Js.write spawning True
    case Js.read current of
        Just owner →
            fork (Just owner) Nothing (currentSlots ⊤) work
        Nothing →
            if Js.read soonable then
                spawnFromSoon work
            else
                fork Nothing Nothing (currentSlots ⊤) work


spawnFromSoon : (⊤ → a) → Fiber a
spawnFromSoon work =
    case Js.read soonRunning of
        Nothing →
            fork Nothing Nothing (currentSlots ⊤) work
        Just (Soon s) →
            group =
                Js.optMatch (Js.cellRead s .group)
                    (λ⊤ →
                        made = openRoot ⊤
                        Js.cellWrite s (Js.some made) .group
                        made
                    )
                    identity
            fork Nothing (Just group) (currentSlots ⊤) work


--| Start `work` in a new fiber that belongs to no other: it outlives the
--| fiber that started it, and is not cancelled when that one ends. What
--| ends it is its own end, `cancel`, or the program's: a page's stop, or on
--| Node the end of `Io.run`'s fiber, cancels it and runs its cleanup with
--| every other fiber's. It sees what the fiber that started it sees — its
--| clock, its log context. Effect's `forkDetach`.
pub spawnDetached : (⊤ → a) → Fiber a
spawnDetached work = fork Nothing Nothing (currentSlots ⊤) work


--| Start `work` in a new fiber that belongs to `scope`.
pub spawnIn : Scope, (⊤ → a) → Fiber a
spawnIn group work = fork (Js.read current) (Just group) (currentSlots ⊤) work


--| Run `work` in a root fiber, and call `done` with how it ended. What a
--| platform's entry point uses; a program asks its platform instead.
pub start : (⊤ → a), sync (Exit a → ⊤) → ⊤
start work report =
    (Fiber control) = fork Nothing Nothing emptySlots work
    c = cellOf control
    (ControlExt extra) = extension c
    Js.cellWrite
        extra
        (Just λ⊤ →
            report
                (if has c cancelBit then
                    Cancelled
                 else
                    Done (Kernel.slotRead (Js.cellRead c .value))
                )
        )
        .report


--| Whether stopping will have cleanup to run: `True` once a fiber has been
--| made, when `shutdown` cancels fibers and calls its `done`. What a
--| platform asks to know whether more reports may follow its program's
--| stop (`boundary.md` §9.8.14 (g)).
pub cleansUp : ⊤ → Bool
cleansUp ⊤ = Js.read fibered


--| Queue `work` to run at the scheduler's next turn, in the queue of the
--| fibers that are ready, behind those queued before it — exactly where a
--| fiber `spawn`ed now would first run — but with no fiber of its own:
--| `work` must not suspend, and it runs outside any fiber, as `main` does.
--| What a page program runs a command with when its body cannot suspend
--| (`boundary.md` §9.8.11). What `work` starts with `spawn` belongs to it,
--| as a fiber's children do, and is cancelled when it returns. Once this synchronous job starts, it runs to its end. Its children
--| that have not started are cancelled before their first line when it ends.
pub soon : sync (⊤ → ⊤) → Soon
soon work =
    Js.write soonable True
    installHooks ⊤
    sched = schedulerHere ⊤
    queuedWork =
        Soon
            (Js.cell
                { work = Just work
                , sched = sched
                , next = Js.none ⊤
                , position = 0
                , group = Js.none ⊤
                }
            )
    queueSoon sched queuedWork
    queuedWork


runSoon : Soon → Bool
runSoon ((Soon s) as queuedWork) =
    work = Js.cellRead s .work
    Js.cellWrite s Nothing .work
    if stopped program || stopped (Js.cellRead s .sched) then
        False
    else
        case work of
            Nothing →
                False
            Just task →
                outer = Js.read soonRunning
                Js.write soonRunning (Just queuedWork)
                task ⊤
                Js.write soonRunning outer
                group = Js.cellRead s .group
                if not (absent group) then closeRoot (required group)
                True


--| Whether queued work has not run yet.
pub queued : Soon → Bool
queued (Soon s) =
    case (Js.cellRead s .work) of
        Nothing →
            False
        Just _ →
            True


--| Run `body` with a scope, and when it returns, cancel every fiber it
--| started in the scope that is still running and wait for them.
--|
--|     both a b = Task.scope λs →
--|         x = Task.spawnIn s a
--|         y = Task.spawnIn s b
--|         ( Task.join x, Task.join y )
pub scope : (Scope → a) → a
scope body =
    group = openScope ⊤
    closeScope group (body group)


newScope : Bool → Scope
newScope root =
    Js.write scoped True
    Scope
        (Js.cell
            { children = Js.none ⊤
            , closed = False
            , deferred = Nothing
            , finalizer = Js.none ⊤
            , root = root
            , listed = Nothing
            , waiters = Js.none ⊤
            , owner = Js.none ⊤
            , before = Js.none ⊤
            , after = Js.none ⊤
            }
        )


--| A scope that no function brackets, for a platform whose program
--| outlives every call: a page program's commands and subscriptions run
--| in one. `closeRoot` ends it; nothing else does.
pub openRoot : ⊤ → Scope
openRoot ⊤ =
    Js.write rooted True
    newScope True


openScope : ⊤ → Scope
openScope ⊤ =
    Js.write finalising True
    group = newScope False
    (Scope sc) = group
    owner = here ⊤
    c = cellOf owner
    token = addFinalizer c (unitJob λ⊤ → shutWith group Cancelled)
    Js.cellWrite sc (Js.some token) .finalizer
    linkScope owner group
    group


listRoot : Scope, Scheduler → ⊤
listRoot ((Scope sc) as group) sched =
    if Js.read rooted && Js.cellRead sc .root then
        case Js.cellRead sc .listed of
            Just _ →
                ⊤
            Nothing →
                (Scheduler p) = program
                roots = appendScope (Js.cellRead p .rootScopes) group
                Js.cellWrite p roots .rootScopes
                Js.cellWrite sc (Just sched) .listed


unlistScope : Scope → Scheduler
unlistScope ((Scope sc) as group) =
    case Js.cellRead sc .listed of
        Nothing →
            program
        Just sched →
            (Scheduler p) = program
            roots = removeScope (Js.cellRead p .rootScopes) group
            Js.cellWrite p roots .rootScopes
            Js.cellWrite sc Nothing .listed
            Js.cellWrite sc (Js.none ⊤) .before
            Js.cellWrite sc (Js.none ⊤) .after
            sched


shut : Scope → ⊤
shut (Scope sc) =
    Js.cellWrite sc True .closed
    haltChildren (Js.cellRead sc .children)
    if not (absent (Js.cellRead sc .children)) then parkIn (scopeWaiters sc)


closeScope : Scope, a → a
closeScope ((Scope sc) as group) value =
    shut group
    token = Js.cellRead sc .finalizer
    if not (absent token) then
        _ = removeFinalizer (cellOf (required (Js.cellRead sc .owner))) (required token)
        Js.cellWrite sc (Js.none ⊤) .finalizer
    unlinkScope group
    if Js.read releasing || Js.read rooted then runDeferred group (Done ⊤)
    value


shutWith : Scope, Exit ⊤ → ⊤
shutWith group exit =
    shut group
    if Js.read releasing || Js.read rooted then runDeferred group exit


runDeferred : Scope, Exit ⊤ → ⊤
runDeferred ((Scope sc) as group) exit =
    if Js.read releasing && hasDeferred group then
        case Chain.pop (deferredList group) of
            Nothing →
                ⊤
            Just key →
                cleanup = takeWork exitWork key
                uninterruptible λ⊤ →
                    runExitJob cleanup exit
                    runDeferred group exit
    else if Js.read rooted && Js.cellRead sc .root then
        _ = unlistScope group
        ⊤


--| Run `finally` when `scope` closes — after every fiber started in it has
--| been cancelled and has ended — where cancellation cannot reach it, the
--| last one added first. It is told `Done ⊤` when the scope's function
--| returned, and `Cancelled` when the fiber running that function was
--| cancelled. Added to a scope that has already closed, it runs at once,
--| told `Cancelled`. Effect's `Scope.addFinalizer`.
--|
--|     Task.scope λs →
--|         conn = connect ⊤
--|         _ = Task.defer s λ_ → disconnect conn
--|         serve s conn
--|
--| A root scope's run when `closeRoot` closes it, told `Done ⊤`, in a
--| fiber of their own that `closeRoot` does not wait for; or when the
--| program stops, told `Cancelled`, with the rest of its cleanup.
pub defer : Scope, (Exit ⊤ → ⊤) → ⊤
defer ((Scope sc) as group) cleanup =
    Js.write releasing True
    Js.write finalising True
    if (Js.cellRead sc .closed) then
        uninterruptible λ⊤ → cleanup Cancelled
    else
        Js.write fibered True
        installHooks ⊤
        listRoot group (schedulerHere ⊤)
        pushStep (deferredList group) (keepWork exitWork cleanup)


--| Cancel every fiber of a scope `openRoot` made, without waiting for
--| their cleanup, which runs as each is resumed. A fiber started in the
--| scope afterwards is cancelled before it runs. What `defer` added to it
--| runs once those fibers have ended, in a fiber of its own.
pub closeRoot : Scope → ⊤
closeRoot ((Scope sc) as group) =
    owner =
        case Js.cellRead sc .listed of
            Nothing →
                program
            Just sched →
                sched
    Js.cellWrite sc True .closed
    haltChildren (Js.cellRead sc .children)
    if Js.read releasing && hasDeferred group then
        cleanupScope group (Done ⊤) owner
    else if absent (Js.cellRead sc .children) then
        _ = unlistScope group
        ⊤


cleanupScope : Scope, Exit ⊤, Scheduler → ⊤
cleanupScope group exit owner =
    fins = Chain.make ⊤
    pushStep fins (unitJob λ⊤ → shutWith group exit)
    cleanupFiber fins owner


--| Run `work` where cancellation cannot reach it. A cancellation that
--| arrives meanwhile is delivered at the fiber's next suspension after it.
pub uninterruptible : (⊤ → a) → a
uninterruptible work =
    (Control c) = here ⊤
    Js.cellWrite c ((Js.cellRead c .masks) + 1) .masks
    value = work ⊤
    Js.cellWrite c ((Js.cellRead c .masks) - 1) .masks
    value


--| Run `work` where cancellation cannot reach it, as `uninterruptible`
--| does, handing it a `Restore` with which a part of it can be made
--| interruptible again: `restore token f` runs `f` as cancellable as the
--| code that entered the mask was. So a wait can be cancelled while what
--| follows it cannot — a permit taken and then always given back:
--|
--|     Task.uninterruptibleMask λtoken →
--|         permit = Task.restore token λ⊤ → waitForPermit ⊤
--|         Task.onExit (λ⊤ → Task.restore token use) λ_ → giveBack permit
--|
--| Effect's `uninterruptibleMask`. A cancellation that arrives while
--| masked is delivered at the next point where the fiber may suspend
--| inside a restored part, or after the mask.
pub uninterruptibleMask : (Restore → a) → a
uninterruptibleMask work =
    fiber = here ⊤
    (Control c) = fiber
    token = Restore (Js.cell { depth = (Js.cellRead c .masks), fiber = fiber, live = True })
    (Restore t) = token
    value = uninterruptible λ⊤ → work token
    Js.cellWrite t False .live
    value


--| Run `work` with the interruptibility there was where the mask `token`
--| came from was entered — cancellable inside a mask entered from code
--| that was, not inside one entered from an uninterruptible region — and
--| put the mask back when `work` ends. A token used after its mask has
--| returned, or by a fiber other than the one that entered it, restores
--| nothing: `work` runs as the code around it does.
pub restore : Restore, (⊤ → a) → a
restore (Restore token) work =
    fiber = here ⊤
    (Control c) = fiber
    if (Js.cellRead token .live) && Js.same fiber (Js.cellRead token .fiber) then
        old = (Js.cellRead c .masks)
        Js.cellWrite c (Js.cellRead token .depth) .masks
        value = work ⊤
        Js.cellWrite c old .masks
        value
    else
        work ⊤


--| Acquire a resource, use it, and release it however the use ends:
--| `Done` with the use's value, or `Cancelled` when the fiber was cancelled
--| during the use. Acquire and release cannot be interrupted.
--|
--|     Task.bracket (λ⊤ → open path) (λfile _ → close file) λfile → read file
pub bracket : (⊤ → r), (r, Exit a → ⊤), (r → a) → a
bracket acquire release use =
    Js.write finalising True
    resource = uninterruptible acquire
    (Control c) = here ⊤
    token = addFinalizer c (unitJob λ⊤ → release resource Cancelled)
    value = use resource
    _ = removeFinalizer c token
    uninterruptible λ⊤ →
        release resource (Done value)
        value


--| Run `work`, then `finally` with how it ended — `Done` with its value,
--| or `Cancelled` when the fiber was cancelled during it — where
--| cancellation cannot reach it, and answer `work`'s value. `bracket` with
--| no resource; Effect's `onExit`.
--|
--|     Task.onExit (λ⊤ → fetch url) λexit →
--|         case exit of
--|             Done _ → Log.info "fetched"
--|             Cancelled → Log.warn "gave up"
pub onExit : (⊤ → a), (Exit a → ⊤) → a
onExit work cleanup = bracket (λ⊤ → ⊤) (λ_ exit → cleanup exit) λ⊤ → work ⊤


--| Stop every fiber: close every root scope, cancel every fiber and run its
--| cleanup, drop queued work, and start nothing new. Cleanup that suspends
--| is given `deadline` milliseconds from the call; `done` is called once
--| every fiber has ended, with how many cleanups were cut short. What a
--| platform calls when its program stops (`boundary.md` §9.8.14); a
--| program never does. It returns at once — the cleanup runs in a later
--| task — and a second call does nothing.
pub shutdown : Int, sync (Int → ⊤) → ⊤
shutdown ms done = Hooks.shutdown ms done


shutdownRuntime : Int, sync (Int → ⊤) → ⊤
shutdownRuntime ms done =
    (Scheduler s) = program
    if (Js.cellRead s .phase) == 0 then Js.cellWrite s 1 .phase
    if Js.read many then
        walkChain schedulers λsched →
            stopScheduler sched ms λcut →
                Js.cellWrite s ((Js.cellRead s .abandoned) + cut) .abandoned
    if Js.read fibered then stopScheduler program ms done


--| Stop one scheduler, as `shutdown` stops the program: close its root
--| scopes, cancel its fibers and run their cleanup, drop its queued work
--| and start nothing new under it. Cleanup that suspends is given
--| `deadline` milliseconds from the call; `done` is called once every
--| fiber of the scheduler has ended, with how many cleanups were cut
--| short. It returns at once, and a second call does nothing. Every other
--| scheduler, the program's included, runs on.
pub stopScheduler : Scheduler, Int, sync (Int → ⊤) → ⊤
stopScheduler ((Scheduler s) as sched) ms done =
    case (Js.cellRead s .done) of
        Just _ →
            ⊤
        Nothing →
            if (Js.cellRead s .phase) ≠ 3 then
                Js.cellWrite s (Just done) .done
                Js.cellWrite s ms .deadline
                if (Js.cellRead s .phase) == 2 then arm sched
                stopping sched


stopping : Scheduler → ⊤
stopping ((Scheduler s) as sched) =
    if (Js.cellRead s .phase) == 0 then Js.cellWrite s 1 .phase
    Js.cellWrite s True .scheduled
    if not ((Js.cellRead s .torn)) then
        Js.cellWrite s True .torn
        queueTeardown sched


queueTeardown : Scheduler → ⊤
queueTeardown ((Scheduler s) as sched) =
    if (Js.cellRead s .program) then
        macrotask λ⊤ → teardown sched
    else
        requeue sched λ⊤ → teardown sched


arm : Scheduler → ⊤
arm ((Scheduler s) as sched) =
    Js.cellWrite s (Just (nativeTimer ((Js.cellRead s .deadline)) λ⊤ → expire sched)) .timer


teardown : Scheduler → ⊤
teardown ((Scheduler s) as sched) =
    if Js.cellRead s .phase == 1 then
        Js.cellWrite s 2 .phase
        case Js.cellRead s .done of
            Nothing →
                ⊤
            Just _ →
                arm sched
        (Scheduler p) = program
        state = Js.cellRead s .sweeping
        gatherChildren (Js.cellRead p .roots) state
        if Js.read rooted then
            visitScopes (Js.cellRead p .rootScopes) λ((Scope sc) as group) →
                if ownedScope group sched then Js.cellWrite sc True .closed
            gatherScopes (Js.cellRead p .rootScopes) state
        collectTree sched 0 0
        if Js.read many then
            walkChain (loanList sched) λ(Loan loan) →
                pushSweep (Js.cellRead s .sweeping) (Js.cellRead loan .fiber)
        if Js.read spawning || Js.read scoped then sortSweep (Js.cellRead s .sweeping)
        if Js.read rooted && Js.read releasing then
            cleanupRoots (Js.cellRead p .rootScopes) Cancelled sched
    ok = Js.ref False
    Js.finally
        (λ⊤ →
            sweep sched
            Js.write ok True
        )
        λ⊤ → if Js.read ok then ⊤ else queueTeardown sched
    case Js.cellRead s .culprit of
        Nothing →
            ⊤
        Just fiber →
            Js.cellWrite s Nothing .culprit
            if not (endedControl fiber) then
                recover fiber
                enqueue fiber
    if Js.read finalising then
        if Js.cellRead s .program then
            case Js.read outside of
                Nothing →
                    ⊤
                Just ((Control holder) as control) →
                    if not (absent (Js.cellRead holder .finalizers)) then
                        cleanupOutside control
    if Js.cellRead s .live == 0 then allEnded sched else drain sched


cleanupRoots : Js.Opt Scope, Exit ⊤, Scheduler → ⊤
cleanupRoots roots exit owner =
    fins = Chain.make ⊤
    visitScopes roots λgroup →
        if ownedScope group owner && hasDeferred group then
            Chain.unshift fins (unitJob λ⊤ → shutWith group exit)
    if Chain.size fins > 0 then cleanupFiber fins owner


cleanupFiber : Chain UnitJob, Scheduler → ⊤
cleanupFiber fins sched =
    fiber = newControl { Record.copy emptySlots | sched = Just sched }
    c = cellOf fiber
    copyFinalizers fins c
    registerFiber Nothing Nothing (Fiber fiber)
    unwind fiber
    enqueue fiber


copyFinalizers : Chain UnitJob, Js.Cell ControlFields → ⊤
copyFinalizers from into =
    case Chain.shift from of
        Nothing →
            ⊤
        Just fin →
            _ = addFinalizer into fin
            copyFinalizers from into


sweep : Scheduler → ⊤
sweep ((Scheduler s) as sched) =
    state = Js.cellRead s .sweeping
    at = Js.cellRead state .at
    if at < Js.cellRead state .count then
        fiber = Array.arrayGet (Js.cellRead state .values) at
        Js.cellWrite state (at + 1) .at
        halt fiber
        sweep sched
    else
        Js.cellWrite state (Array.arrayAllocate 0) .values
        Js.cellWrite state 0 .count
        Js.cellWrite state 0 .at


recover : Control → ⊤
recover ((Control c) as fiber) =
    set c interruptBit True
    set c cancelBit True
    stop = clearWait fiber
    Js.cellWrite c 0 .masks
    if Js.read finalising && inCleanup fiber then cutBack fiber else clearFrames c
    case stop of
        Nothing →
            ⊤
        Just cancelWait →
            Js.invoke cancelWait ⊤
            ⊤


deadlinePassed : Control → Bool
deadlinePassed fiber =
    (Scheduler p) = program
    (Scheduler s) = schedulerOf fiber
    (Js.cellRead p .expired) || (Js.cellRead s .expired)


expire : Scheduler → ⊤
expire ((Scheduler s) as sched) =
    Js.cellWrite s Nothing .timer
    Js.cellWrite s True .expired
    if Js.read finalising then
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                expireWaiting sched
                Js.write ok True
            )
            λ⊤ → if Js.read ok then ⊤ else macrotask λ⊤ → expire sched


abandon : Control → ⊤
abandon fiber =
    (Scheduler s) = schedulerOf fiber
    Js.cellWrite s (Js.cellRead s .abandoned + 1) .abandoned
    stop = clearWait fiber
    cutBack fiber
    case stop of
        Nothing →
            ⊤
        Just cancelWait →
            Js.invoke cancelWait ⊤
            ⊤


allEnded : Scheduler → ⊤
allEnded (Scheduler s) =
    if (Js.cellRead s .phase) ≠ 3 then
        Js.cellWrite s 3 .phase
        if Js.read many then
            case (Js.cellRead s .listed) of
                Nothing →
                    ⊤
                Just token →
                    _ = Chain.remove schedulers token
                    Js.cellWrite s Nothing .listed
        case (Js.cellRead s .timer) of
            Nothing →
                ⊤
            Just stopTimer →
                stopTimer ⊤
        Js.cellWrite s Nothing .timer
        case (Js.cellRead s .done) of
            Nothing →
                ⊤
            Just done →
                done ((Js.cellRead s .abandoned))


type Loan
    = Loan (Js.Cell { fiber : Control, depth : Int })


lend : Control, Scheduler → Maybe (Link Loan)
lend fiber ((Scheduler s) as sched) =
    (Control c) = fiber
    owned =
        case (memberOf c) of
            Nothing →
                (Js.cellRead s .program)
            Just owner →
                Js.same owner sched
    if owned then
        Nothing
    else
        case Chain.find (loanList sched) λ(Loan loan) → Js.same (Js.cellRead loan .fiber) fiber of
            Just token →
                case Chain.peek token of
                    Nothing →
                        Nothing
                    Just (Loan loan) →
                        Js.cellWrite loan ((Js.cellRead loan .depth) + 1) .depth
                        Just token
            Nothing →
                Js.cellWrite s ((Js.cellRead s .live) + 1) .live
                Just
                    (Chain.append
                        (loanList sched)
                        (Loan (Js.cell { fiber = fiber, depth = 1 }))
                    )


unlend : Scheduler, Maybe (Link Loan) → ⊤
unlend ((Scheduler s) as sched) maybe =
    case maybe of
        Nothing →
            ⊤
        Just token →
            case Chain.peek token of
                Nothing →
                    ⊤
                Just (Loan loan) →
                    if (Js.cellRead loan .depth) > 1 then
                        Js.cellWrite loan ((Js.cellRead loan .depth) - 1) .depth
                    else
                        _ = Chain.remove (loanList sched) token
                        countDown sched


--| Run `work` with the calling fiber's scheduler slot set to `scheduler`,
--| and put the old one back when `work` ends, returned or cancelled, as
--| `Clock.run` does with the clock. While inside, this fiber resumes
--| through that scheduler; the fibers `work` starts copy the slot and
--| belong to the scheduler for good. The body is `withClock`'s, plus the
--| loan: change them together.
pub withScheduler : Scheduler, (⊤ → a) → a
withScheduler sched work =
    if stopped sched then
        selfCancel ⊤
    else
        fiber = here ⊤
        old = currentSlots ⊤
        token =
            case Js.read current of
                Nothing →
                    Nothing
                Just active →
                    lend active sched
        withSlots { Record.copy old | sched = Just sched } work λ⊤ → unlend sched token


withSlots : Slots, (⊤ → a), sync (⊤ → ⊤) → a
withSlots slots work after =
    Js.write finalising True
    Js.write slotted True
    (Control c) = here ⊤
    old = (Js.cellRead c .slots)
    putBack =
        λ⊤ →
            Js.cellWrite c old .slots
            after ⊤
    token = addFinalizer c (unitJob putBack)
    Js.cellWrite c slots .slots
    value = work ⊤
    _ = removeFinalizer c token
    putBack ⊤
    value


--| Core Log's typed context installer for the calling fiber, when set.
pub currentLogContext : ⊤ → Maybe (⊤ → ⊤)
currentLogContext ⊤ = if Js.read logHooksInstalled then (currentSlots ⊤).log else Nothing


--| Run with a typed context installer, restoring the old slot on return or
--| cancellation. Child fibers inherit it. This is private plumbing for Log.
pub withLogContext : sync (⊤ → ⊤), (⊤ → a) → a
withLogContext context work =
    installLogHooks ⊤
    old = currentSlots ⊤
    withSlots { Record.copy old | log = Just context } work λ⊤ → ⊤


--| `work` as a function that runs with the calling fiber's log context,
--| the one in force here, wherever it is called later; `work` itself when
--| no log context is set. For `browser`'s commands, whose bodies run after
--| `update` has returned (`boundary.md` §9.8.16 (b), amended 2026-10-22).
--| It reads `slotted` itself, so in a build in which nothing sets a slot it
--| is `work`, and a release build keeps no call of it.
pub keepLogContext : (a → b) → (a → b)
keepLogContext work =
    case currentLogContext ⊤ of
        Nothing →
            work
        Just context →
            λvalue → withLogContext context λ⊤ → work value


--| Whether the calling fiber has a log context of its own: one that
--| `withLogContext` set, and not the default. For `browser`'s `send`, which
--| runs a message's `update` with the program's context only when the
--| caller has another (`boundary.md` §9.8.16 (b), amended 2026-10-23). It
--| reads `slotted` first, so in a build in which nothing sets a slot it is
--| `False`, and a release build keeps no call of it.
pub hasLogContext : ⊤ → Bool
hasLogContext ⊤ =
    if not (Js.read logHooksInstalled) then
        False
    else
        case currentLogContext ⊤ of
            Nothing →
                False
            Just _ →
                True


--| Run `work`, which cannot wait, with the default log context, the
--| program's. Put the calling fiber's back at once when `work` returns or
--| throws. When `work` throws and leaves finalisers, the teardown runs
--| them first, with `work`'s context, then puts the fiber's back again.
pub withoutLogContext : sync (⊤ → a) → a
withoutLogContext work =
    Js.write slotted True
    holder =
        case Js.read current of
            Nothing →
                Js.read outside
            fiber →
                fiber
    case holder of
        Nothing →
            work ⊤
        Just (Control c) →
            Js.write finalising True
            old = (Js.cellRead c .slots)
            token = addFinalizer c (unitJob λ⊤ → Js.cellWrite c old .slots)
            Js.cellWrite c { Record.copy old | log = Nothing } .slots
            ok = Js.ref False
            Js.finally
                (λ⊤ →
                    value = work ⊤
                    Js.write ok True
                    value
                )
                λ⊤ →
                    if Js.read ok then
                        _ = removeFinalizer c token
                        ⊤
                    else
                        thrown = (Js.cellRead c .slots)
                        _ = addFinalizer c (unitJob λ⊤ → Js.cellWrite c thrown .slots)
                        ⊤
                    Js.cellWrite c old .slots


--| Core Clock's virtual reading, or Nothing for the host clock.
pub currentClock : ⊤ → Maybe Int
currentClock ⊤ =
    case (currentSlots ⊤).clock of
        Nothing →
            Nothing
        Just (VirtualClock clock) →
            Just ((Js.cellRead clock .now))


--| Core Clock's typed virtual clock with no sleepers.
pub virtualClock : Int → VirtualClock
virtualClock epoch = VirtualClock (Js.cell { now = epoch, sleepers = Chain.make ⊤ })


--| Run with a typed virtual clock, restoring the old slot on return or
--| cancellation. Child fibers inherit it. This is private plumbing for Clock.
pub withClock : VirtualClock, (⊤ → a) → a
withClock clock work =
    old = currentSlots ⊤
    withSlots { Record.copy old | clock = Just clock } work λ⊤ → ⊤


--| Wait `duration` on the calling fiber's clock; only this fiber waits.
--|
--| On the real clock that is a host timer, cleared when the fiber is
--| cancelled; a wait longer than the timer's limit, 2³¹ − 1 ms, is a
--| chain of timers, so it never ends early. A `zero` wait lets every
--| other ready fiber run first, as `yieldNow` does — Effect's
--| `sleep(0)`. Inside `Clock.run` the clock is a virtual one: the fiber
--| waits until `Clock.adjust` moves that clock past the wake time, and a
--| `zero` wait returns at once.
pub sleep : Duration → ⊤
sleep duration =
    ms = Duration.toMillis duration
    case (currentSlots ⊤).clock of
        Nothing →
            if ms == 0 then yieldNow ⊤ else realSleep ms
        Just clock →
            if ms == 0 then ⊤ else virtualSleep clock ms


timerLimit : Int
timerLimit = 2147483647


realSleep : Int → ⊤
realSleep ms =
    callback λwake → nativeTimer (Basics.min ms timerLimit) λ⊤ → fromHost λ⊤ → resume wake ⊤
    if ms > timerLimit then realSleep (ms - timerLimit)


virtualSleep : VirtualClock, Int → ⊤
virtualSleep (VirtualClock clock) ms = callback λwake →
    at = (Js.cellRead clock .now) + ms
    token = insertSleeper (Js.cellRead clock .sleepers) at wake
    λ⊤ →
        _ = Chain.remove (Js.cellRead clock .sleepers) token
        ⊤


insertSleeper : Chain Sleeper, Int, Resume ⊤ → Link Sleeper
insertSleeper sleepers at wake =
    case Chain.find sleepers λ(Sleeper due _) → due > at of
        Nothing →
            Chain.append sleepers (Sleeper at wake)
        Just following →
            Chain.insertBefore sleepers following (Sleeper at wake)


--| Move the virtual clock `clock` forward by `ms` milliseconds, and return once everything that woke has run as far as it
--| can: core's `Clock.adjust`.
--|
--| It first lets every other ready fiber run until none is (*settles*);
--| then, while the earliest sleeper is due by the target, sets the reading
--| to its wake time, wakes every sleeper due then, in the order they began
--| to sleep, and settles again — so a sleeper the woken code registers is
--| woken too if it is due by the target. Last, the reading is the target.
pub adjustClock : VirtualClock, Int → ⊤
adjustClock ((VirtualClock clock) as virtual) ms =
    if ms > 0 then
        settle ⊤
        advance virtual ((Js.cellRead clock .now) + ms)


advance : VirtualClock, Int → ⊤
advance ((VirtualClock clock) as virtual) target =
    case Chain.first (Js.cellRead clock .sleepers) of
        Nothing →
            Js.cellWrite clock target .now
        Just (Sleeper at _) →
            if at > target then
                Js.cellWrite clock target .now
            else
                Js.cellWrite clock at .now
                wakeDue (Js.cellRead clock .sleepers) at
                settle ⊤
                advance virtual target


wakeDue : Chain Sleeper, Int → ⊤
wakeDue sleepers at =
    case Chain.first sleepers of
        Nothing →
            ⊤
        Just (Sleeper due wake) →
            if due == at then
                _ = Chain.shift sleepers
                resume wake ⊤
                wakeDue sleepers at


settle : ⊤ → ⊤
settle ⊤ =
    (Scheduler s) = schedulerHere ⊤
    if not (jobsEmpty (Js.cellRead s .queue)) then
        yieldNow ⊤
        settle ⊤


clockMillis : ⊤ → Int
clockMillis ⊤ =
    case currentClock ⊤ of
        Nothing →
            HostDate.now ⊤
        Just now →
            now


each : List a, (a → ⊤) → ⊤
each items work =
    case items of
        [] →
            ⊤
        [ item, …rest ] →
            work item
            each rest work


-- Fast combinator branches run before being registered. A branch that
-- returns synchronously is never counted as a live sched member.
startIn : Scope, (⊤ → a) → Fiber a
startIn group work =
    fiber = makeFiber (currentSlots ⊤) work
    (Fiber ((Control c) as control)) = fiber
    outer = Js.read current
    Js.write current (Just control)
    ok = Js.ref False
    Js.finally
        (λ⊤ →
            frame = popFrame c
            if not (absent frame) then
                runStep control (required frame)
            if Js.read pending == 0 then
                finishReturned control
                advanceUnwind control
            if not (has c endedBit) then
                registerFiber outer (Just group) fiber
                mode = Js.read pending
                Js.write pending 0
                if mode > 0 then acceptFrames control (mode - 1)
                if mode < 0 || interrupted control then
                    forceCancel control
                    enqueue control
                else if mode == 0 then
                    enqueue control
            Js.write ok True
        )
        λ⊤ →
            Js.write current outer
            if not (Js.read ok) then
                Js.write pending 0
                registerFiber outer (Just group) fiber
                recover control
                enqueue control
    fiber


type Entry
    = Entry { number : Int, fiber : Control, stop : ⊤ → Bool, kill : ⊤ → Bool }


entry : Int, Fiber a, sync (Exit a → Bool), sync (Exit a → Bool) → Entry
entry number ((Fiber control) as fiber) stop kill =
    Entry
        { number = number
        , fiber = control
        , stop =
            λ⊤ →
                case poll fiber of
                    Nothing →
                        False
                    Just exit →
                        stop exit
        , kill =
            λ⊤ →
                case poll fiber of
                    Nothing →
                        False
                    Just exit →
                        kill exit
        }


findEnded : List Entry → Maybe Entry
findEnded entries =
    case entries of
        [] →
            Nothing
        [ ((Entry item) as candidate), …rest ] →
            if endedControl item.fiber && item.stop ⊤ then Just candidate else findEnded rest


firstOf : List Entry → Maybe Int
firstOf entries =
    case findEnded entries of
        Just (Entry winner) →
            if winner.kill ⊤ then haltOthers entries winner.fiber
            Just winner.number
        Nothing →
            if List.all entries λ(Entry item) → endedControl item.fiber then
                Nothing
            else
                me = Js.read current
                listeners = Chain.make ⊤
                value = callback λwake →
                    each entries λ(Entry item) →
                        if endedControl item.fiber then
                            ⊤
                        else
                            (Control c) = item.fiber
                            token = Chain.append (observerList c) λ⊤ →
                                if item.stop ⊤ then
                                    if item.kill ⊤ then haltAs me entries item.fiber
                                    resume wake (Just item.number)
                                else if
                                    List.all entries λ(Entry other) → endedControl other.fiber
                                then
                                    resume wake Nothing
                            pushStep listeners λ⊤ →
                                _ = Chain.remove (observerList c) token
                                ⊤
                    λ⊤ → runJobs listeners
                runJobs listeners
                value


haltOthers : List Entry, Control → ⊤
haltOthers entries winner = each entries λ(Entry item) →
    if not (Js.same winner item.fiber) then halt item.fiber


haltAs : Maybe Control, List Entry, Control → ⊤
haltAs fiber entries winner =
    outer = Js.read current
    Js.write current fiber
    Js.finally (λ⊤ → haltOthers entries winner) λ⊤ → Js.write current outer


wasCancelled : Exit a → Bool
wasCancelled exit =
    case exit of
        Done _ →
            False
        Cancelled →
            True


wasDone : Exit a → Bool
wasDone exit = not (wasCancelled exit)


failedOrCancelled : Exit (Result e a) → Bool
failedOrCancelled exit =
    case exit of
        Done (Ok _) →
            False
        _ →
            True


succeeded : Exit (Result e a) → Bool
succeeded exit =
    case exit of
        Done (Ok _) →
            True
        _ →
            False


allOrCancel : List Entry → ⊤
allOrCancel entries =
    case firstOf entries of
        Nothing →
            ⊤
        Just _ →
            selfCancel ⊤


--| Run both concurrently, and answer both values, in argument order. If
--| one of them is cancelled — it joined a cancelled fiber — the other is
--| cancelled and waited for, and so is the caller. Effect's `all` of two.
pub par : (⊤ → a), (⊤ → b) → a × b
par a b = scope λgroup →
    fa = startIn group a
    fb = startIn group b
    allOrCancel [ entry 0 fa wasCancelled wasCancelled, entry 1 fb wasCancelled wasCancelled ]
    ( join fa, join fb )


--| `par` of three.
pub par3 : (⊤ → a), (⊤ → b), (⊤ → c) → a × b × c
par3 a b c = scope λgroup →
    fa = startIn group a
    fb = startIn group b
    fc = startIn group c
    allOrCancel
        [ entry 0 fa wasCancelled wasCancelled
        , entry 1 fb wasCancelled wasCancelled
        , entry 2 fc wasCancelled wasCancelled
        ]
    ( join fa, join fb, join fc )


--| Run both concurrently; the first `Err` to arrive cancels the other as
--| it arrives, waits for its cleanup, and is the answer. When the first
--| answers `Err` without waiting, the second is never started. `Ok` of both values, in
--| argument order, otherwise. Effect's `all`, which fails fast.
pub parOk : (⊤ → Result e a), (⊤ → Result e b) → Result e (a × b)
parOk a b = scope λgroup →
    fa = startIn group a
    case poll fa of
        Just Cancelled →
            selfCancel ⊤
        Just (Done (Err why)) →
            Err why
        _ →
            fb = startIn group b
            winner =
                firstOf
                    [ entry 0 fa failedOrCancelled failedOrCancelled
                    , entry 1 fb failedOrCancelled failedOrCancelled
                    ]
            case winner of
                Just 0 →
                    failedWith fa
                Just _ →
                    failedWith fb
                Nothing →
                    case ( join fa, join fb ) of
                        ( Ok x, Ok y ) →
                            Ok ( x, y )
                        ( Err why, _ ) →
                            Err why
                        ( _, Err why ) →
                            Err why


failedWith : Fiber (Result e a) → Result e b
failedWith fiber =
    case join fiber of
        Err why →
            Err why
        Ok _ →
            selfCancel ⊤


--| Run both concurrently; the first to return is the answer. The other is
--| cancelled as the first returns, so it runs again only where it cannot
--| be interrupted, and is waited for — its cleanup has run — before the
--| answer is returned. When the first returns without waiting, the second
--| is never started. A branch cancelled by itself never wins; if both are,
--| the caller is cancelled. Effect's `raceFirst`.
pub race : (⊤ → a), (⊤ → a) → a
race first second = raceAll first [ second ]


--| `race` of any number of branches, `first` and then `rest`: the first to
--| return wins. Every other branch is cancelled as it returns, so none runs
--| again where it can be interrupted, and is waited for before the answer
--| is returned; a branch after one that returned without waiting is never
--| started. Effect's `raceAllFirst`.
pub raceAll : (⊤ → a), List (⊤ → a) → a
raceAll first rest = scope λgroup →
    fibers = startRacers group [ first, …rest ] [] wasDone
    entries = List.indexedMap fibers λi fiber → entry i fiber wasDone wasDone
    case firstOf entries of
        Nothing →
            selfCancel ⊤
        Just index →
            case List.get fibers index of
                Nothing →
                    selfCancel ⊤
                Just fiber →
                    join fiber


startRacers : Scope, List (⊤ → a), List (Fiber a), sync (Exit a → Bool) → List (Fiber a)
startRacers group work fibers wins =
    case work of
        [] →
            fibers
        [ thunk, …rest ] →
            fiber = startIn group thunk
            more = [ …fibers, fiber ]
            case poll fiber of
                Just exit →
                    if wins exit then more else startRacers group rest more wins
                Nothing →
                    startRacers group rest more wins


--| The first branch to answer `Ok` wins, and the rest are cancelled as it
--| answers, and waited for; an `Err` does not end the race. A branch after
--| one that answered `Ok` without waiting is never started. When no branch answers
--| `Ok`, the answer is `Err` of every branch's error, in argument order —
--| a branch cancelled by itself gives none, and if every branch was, the
--| caller is cancelled. No branches at all is `Err []`. Effect's `race`.
pub raceOk : many aliased List (⊤ → Result e a) → fresh Result (List e) a
raceOk work =
    if List.isEmpty work then
        Err []
    else
        scope λgroup →
            fibers = startRacers group work [] succeeded
            entries = List.indexedMap fibers λi fiber → entry i fiber succeeded succeeded
            case firstOf entries of
                Just index →
                    case List.get fibers index of
                        Nothing →
                            selfCancel ⊤
                        Just fiber →
                            case join fiber of
                                Ok value →
                                    Ok value
                                Err why →
                                    Err [ why ]
                Nothing →
                    errors fibers []


errors : List (Fiber (Result e a)), List e → Result (List e) a
errors fibers reasons =
    case fibers of
        [] →
            if List.isEmpty reasons then selfCancel ⊤ else Err reasons
        [ fiber, …rest ] →
            case wait fiber of
                Cancelled →
                    errors rest reasons
                Done (Err why) →
                    errors rest [ …reasons, why ]
                Done (Ok value) →
                    Ok value


--| Run `work`; if it returns before `duration` has passed on the calling
--| fiber's clock, `Just` its value. Otherwise `work` is cancelled as the
--| time passes, its cleanup waited for, and the answer is `Nothing` — so
--| `timeout` may take longer than `duration`, by as long as that cleanup
--| takes, and `work` that cannot be interrupted when the time passes runs
--| to its next point of suspension first. A `zero` duration answers `Nothing` without
--| starting `work`. Effect's `timeoutOption`.
--|
--|     Task.timeout (Duration.seconds 5) (λ⊤ → Http.get url)
--|         ▷ Maybe.withDefault (Err Http.Timeout)
pub timeout : borrowed Duration, once aliased (⊤ → a) → fresh Maybe a
timeout duration work =
    if Duration.toMillis duration == 0 then
        Nothing
    else
        scope λgroup →
            child = startIn group work
            case poll child of
                Just Cancelled →
                    selfCancel ⊤
                Just (Done value) →
                    Just value
                Nothing →
                    timer = startIn group λ⊤ → sleep duration
                    winner =
                        firstOf
                            [ entry 0 child (λ_ → True) λ_ → True
                            , entry 1 timer (λ_ → True) λ_ → True
                            ]
                    case winner of
                        Just 0 →
                            Just (join child)
                        _ →
                            Nothing


--| Call `f` on every element, at most `bound` calls running at once — each
--| started, in list order, as one before it ends — and answer the results
--| in list order. A `bound` below 1 is 1; `List.length xs` runs them all at
--| once. If a call is cancelled, no more are started, those running are
--| cancelled and waited for, and the caller is cancelled. Effect's
--| `forEach` with `concurrency`.
pub forEach : List a, Int, (a → b) → List b
forEach items bound work = scope λgroup →
    case bounded group items (Basics.max 1 bound) work λ_ → False of
        Ok values →
            values
        Err _ →
            selfCancel ⊤


--| `forEach` for a function that answers a `Result`: on the first `Err`,
--| no more calls are started, those running are cancelled as it arrives
--| and waited for,
--| and that `Err` is the answer. `Ok` of every result, in list order,
--| otherwise.
pub forEachOk : List a, Int, (a → Result e b) → Result e (List b)
forEachOk items bound work = scope λgroup →
    case bounded group items (Basics.max 1 bound) work isErr of
        Ok values →
            collectOk values []
        Err fiber →
            case join fiber of
                Err why →
                    Err why
                Ok _ →
                    selfCancel ⊤


isErr : Result e a → Bool
isErr value =
    case value of
        Err _ →
            True
        Ok _ →
            False


collectOk : List (Result e a), List a → Result e (List a)
collectOk values done =
    case values of
        [] →
            Ok done
        [ value, …rest ] →
            case value of
                Err why →
                    Err why
                Ok item →
                    collectOk rest [ …done, item ]


bounded : Scope, List a, Int, (a → b), sync (b → Bool) → Result (Fiber b) (List b)
bounded group items bound work stops =
    results = List.map items λ_ → Js.ref Nothing
    boundedFrom group items results results bound work stops 0 []


boundedFrom :
      Scope
    , List a
    , List (Js.Ref (Maybe b))
    , List (Js.Ref (Maybe b))
    , Int
    , (a → b)
    , sync (b → Bool)
    , Int
    , List (Int × Fiber b)
    → Result (Fiber b) (List b)
boundedFrom group items slots allSlots bound work stops next inFlight =
    if List.length inFlight < bound then
        case ( items, slots ) of
            ( [ item, …rest ], [ slot, …otherSlots ] ) →
                fiber = startIn group λ⊤ → work item
                case poll fiber of
                    Just Cancelled →
                        Err fiber
                    Just (Done value) →
                        if stops value then
                            Err fiber
                        else
                            Js.write slot (Just value)
                            boundedFrom
                                group
                                rest
                                otherSlots
                                allSlots
                                bound
                                work
                                stops
                                (next + 1)
                                inFlight
                    Nothing →
                        boundedFrom group rest otherSlots allSlots bound work stops (next + 1)
                            [ …inFlight, ( next, fiber ) ]
            _ →
                awaitBounded group items slots allSlots bound work stops next inFlight
    else
        awaitBounded group items slots allSlots bound work stops next inFlight


awaitBounded :
      Scope
    , List a
    , List (Js.Ref (Maybe b))
    , List (Js.Ref (Maybe b))
    , Int
    , (a → b)
    , sync (b → Bool)
    , Int
    , List (Int × Fiber b)
    → Result (Fiber b) (List b)
awaitBounded group items slots allSlots bound work stops next inFlight =
    case inFlight of
        [] →
            Ok (readSlots allSlots [])
        _ →
            wins =
                λexit →
                    case exit of
                        Cancelled →
                            True
                        Done value →
                            stops value
            entries = List.map inFlight λ( i, fiber ) → entry i fiber (λ_ → True) wins
            winner = firstOf entries
            case winner of
                Just index →
                    case flightAt inFlight index of
                        Nothing →
                            selfCancel ⊤
                        Just fiber →
                            case poll fiber of
                                Just Cancelled →
                                    Err fiber
                                Just (Done value) →
                                    if stops value then
                                        Err fiber
                                    else
                                        continueBounded
                                            group
                                            items
                                            slots
                                            allSlots
                                            bound
                                            work
                                            stops
                                            next
                                            inFlight
                                Nothing →
                                    selfCancel ⊤
                Nothing →
                    continueBounded group items slots allSlots bound work stops next inFlight


flightAt : List (Int × Fiber a), Int → Maybe (Fiber a)
flightAt flights index =
    case flights of
        [] →
            Nothing
        [ ( i, fiber ), …rest ] →
            if i == index then Just fiber else flightAt rest index


continueBounded :
      Scope
    , List a
    , List (Js.Ref (Maybe b))
    , List (Js.Ref (Maybe b))
    , Int
    , (a → b)
    , sync (b → Bool)
    , Int
    , List (Int × Fiber b)
    → Result (Fiber b) (List b)
continueBounded group items slots allSlots bound work stops next inFlight =
    case completedFlight inFlight allSlots stops [] of
        Err fiber →
            Err fiber
        Ok remaining →
            boundedFrom group items slots allSlots bound work stops next remaining


completedFlight :
      List (Int × Fiber b)
    , List (Js.Ref (Maybe b))
    , sync (b → Bool)
    , List (Int × Fiber b)
    → Result (Fiber b) (List (Int × Fiber b))
completedFlight flights slots stops remaining =
    case flights of
        [] →
            Ok remaining
        [ (( i, fiber ) as pair), …rest ] →
            case poll fiber of
                Nothing →
                    completedFlight rest slots stops [ …remaining, pair ]
                Just Cancelled →
                    Err fiber
                Just (Done value) →
                    if stops value then
                        Err fiber
                    else
                        case List.get slots i of
                            Nothing →
                                ⊤
                            Just slot →
                                Js.write slot (Just value)
                        completedFlight rest slots stops remaining


readSlots : List (Js.Ref (Maybe a)), List a → List a
readSlots slots values =
    case slots of
        [] →
            values
        [ slot, …rest ] →
            case Js.read slot of
                Nothing →
                    selfCancel ⊤
                Just value →
                    readSlots rest [ …values, value ]


--| Run `work`; an `Ok` is the answer at once. On an `Err`, step `policy`
--| with it: `Stop` makes that `Err` the answer, and `Continue` sleeps its
--| delay on the calling fiber's clock and runs `work` again, stepping the
--| next schedule after that. A cancelled `work` never returns, so it is
--| never retried. Effect's `retry`.
--|
--|     -- at most four runs, 100, 200 and 400 ms apart
--|     Task.retry (Schedule.max (Schedule.exponential (Duration.millis 100) 2.0) (Schedule.recurs 3)) fetch
pub retry : Schedule e, (⊤ → Result e a) → Result e a
retry policy work = retryFrom policy work (clockMillis ⊤) 1


retryFrom : Schedule e, (⊤ → Result e a), Int, Int → Result e a
retryFrom policy work began attempt =
    case work ⊤ of
        Ok value →
            Ok value

        Err problem →
            case Schedule.step policy (metadata problem attempt began) of
                Schedule.Stop →
                    Err problem

                Schedule.Continue delay next →
                    sleep delay
                    retryFrom next work began (attempt + 1)


--| Run `work`, step `policy` with its value, and while it continues
--| sleep its delay and run `work` again; the last value is the answer.
--| `repeat (Schedule.recurs 2)` runs `work` three times. Effect's `repeat`.
pub repeat : Schedule a, (⊤ → a) → a
repeat policy work = repeatFrom policy work (clockMillis ⊤) 1


repeatFrom : Schedule a, (⊤ → a), Int, Int → a
repeatFrom policy work began attempt =
    value = work ⊤

    case Schedule.step policy (metadata value attempt began) of
        Schedule.Stop →
            value

        Schedule.Continue delay next →
            sleep delay
            repeatFrom next work began (attempt + 1)


-- One step's metadata: the time since `began` on the calling fiber's clock,
-- and a random draw — from the host, until a seed slot is set (§17.5; the
-- seed is P9's `Random.withSeed`, which nothing writes yet).
metadata : i, Int, Int → Schedule.Metadata i
metadata input attempt began =
    { input = input
    , attempt = attempt
    , elapsed = Duration.millis (clockMillis ⊤ - began)
    , random = HostMath.random ⊤
    }


registerFiber : Maybe Control, Maybe Scope, Fiber a → ⊤
registerFiber parent group ((Fiber (Control c)) as fiber) =
    if not ((has c registeredBit)) then
        set c registeredBit True
        attachFiber parent group fiber


pushStep : Chain a, a → ⊤
pushStep deque value = Chain.push deque value


--| Add a synchronous defect hook before the current hook, preserving that
--| hook. A later `onDefect` replaces the composed hook as usual. Platforms
--| use this when another runtime layer also needs to stop on a fiber defect.
pub chainDefect : sync (⊤ → ⊤) → ⊤
chainDefect hook = Hooks.chainDefect hook


hooksInstalled : Js.Ref Bool
hooksInstalled = Js.ref False


installHooks : ⊤ → ⊤
installHooks ⊤ =
    if not (Js.read hooksInstalled) then
        Js.write hooksInstalled True
        if Hooks.stopped ⊤ then
            (Scheduler s) = program
            Js.cellWrite s 1 .phase
        Hooks.install shutdownRuntime cleansUp


logHooksInstalled : Js.Ref Bool
logHooksInstalled = Js.ref False


installLogHooks : ⊤ → ⊤
installLogHooks ⊤ =
    if not (Js.read logHooksInstalled) then
        Js.write logHooksInstalled True
        Hooks.installContext hasLogContext withoutLogContext


many : Js.Ref Bool
many = Js.ref False


slotted : Js.Ref Bool
slotted = Js.ref False


spawning : Js.Ref Bool
spawning = Js.ref False


interruptBit : Int
interruptBit = 1


unwindBit : Int
unwindBit = 2


endedBit : Int
endedBit = 4


cancelBit : Int
cancelBit = 8


queuedBit : Int
queuedBit = 16


parkedBit : Int
parkedBit = 32


registeredBit : Int
registeredBit = 64


hostBit : Int
hostBit = 128


syncBit : Int
syncBit = 256


readyBit : Int
readyBit = 512


childrenBit : Int
childrenBit = 1024


listBit : Int
listBit = 4096


has : Js.Cell ControlFields, Int → Bool
has c bit = Js.bitAnd (Js.cellRead c .flags) bit ≠ 0


set : Js.Cell ControlFields, Int, Bool → ⊤
set c bit enabled =
    flags = Js.cellRead c .flags
    next = if enabled then Js.bitOr flags bit else Js.bitAnd flags (Js.bitXor bit (0 - 1))
    Js.cellWrite c next .flags


absent : Js.Opt a → Bool
absent value = Js.same value (Js.none ⊤)


required : Js.Opt a → a
required value = Js.optMatch value (λ⊤ → Runtime.defect "an absent kernel link was read") identity


cellOf : Control → Js.Cell ControlFields
cellOf (Control c) = c


extension : Js.Cell ControlFields → ControlExt
extension c =
    slot = Js.cellRead c .ext
    if absent slot then
        made =
            ControlExt
                (Js.cell
                    { member = Nothing
                    , cleanBefore = Js.none ⊤
                    , cleanAfter = Js.none ⊤
                    , outsideOwner = Nothing
                    , scopes = Js.none ⊤
                    , observers = Nothing
                    , report = Nothing
                    }
                )
        Js.cellWrite c (Js.some made) .ext
        made
    else
        required slot


memberOf : Js.Cell ControlFields → Maybe Scheduler
memberOf c = Js.optMatch (Js.cellRead c .ext) (λ⊤ → Nothing) λ(ControlExt extra) →
    Js.cellRead extra .member


observerList : Js.Cell ControlFields → Chain (⊤ → ⊤)
observerList c =
    Js.write observed True
    (ControlExt extra) = extension c
    case Js.cellRead extra .observers of
        Just existing →
            existing
        Nothing →
            made = Chain.make ⊤
            Js.cellWrite extra (Just made) .observers
            made


pushFrame : Control, Frame → ⊤
pushFrame (Control c) frame =
    top = Js.cellRead c .top
    if not (absent top) then
        stack =
            Js.optMatch (Js.cellRead c .frames)
                (λ⊤ →
                    made = FrameStack (Js.cell { values = Array.arrayAllocate 0, count = 0 })
                    Js.cellWrite c (Js.some made) .frames
                    made
                )
                identity
        (FrameStack frames) = stack
        count = Js.cellRead frames .count
        Array.arrayWrite (Js.cellRead frames .values) count top
        Js.cellWrite frames (count + 1) .count
    Js.cellWrite c (Js.some frame) .top


popFrame : Js.Cell ControlFields → Js.Opt Frame
popFrame c =
    top = Js.cellRead c .top
    if not (absent top) then
        next = Js.optMatch (Js.cellRead c .frames) (λ⊤ → Js.none ⊤) λ(FrameStack frames) →
            count = Js.cellRead frames .count
            if count == 0 then
                Js.none ⊤
            else
                index = count - 1
                values = Js.cellRead frames .values
                value = Array.arrayGet values index
                Array.arrayWrite values index (Js.none ⊤)
                Js.cellWrite frames index .count
                value
        Js.cellWrite c next .top
    top


-- This scratch buffer is empty whenever user work can run. Its entries
-- are compiler/kernel frames; user finalizer work stays in typed stores.
pendingFrames : Js.Builder (Js.Opt Frame)
pendingFrames = Array.arrayAllocate 0


acceptFrames : Control, Int → ⊤
acceptFrames fiber count =
    if count > 0 then
        index = count - 1
        frame = required (Array.arrayGet pendingFrames index)
        Array.arrayWrite pendingFrames index (Js.none ⊤)
        pushFrame fiber frame
        acceptFrames fiber index


clearFrames : Js.Cell ControlFields → ⊤
clearFrames c =
    Js.cellWrite c (Js.none ⊤) .top
    Js.cellWrite c (Js.none ⊤) .frames


addFinalizer : Js.Cell ControlFields, UnitJob → Finalizer
addFinalizer c work =
    old = Js.cellRead c .finalizers
    made = Finalizer (Js.cell { key = keepWork unitWork work, before = Js.none ⊤, after = old })
    if not (absent old) then
        (Finalizer next) = required old
        Js.cellWrite next (Js.some made) .before
    Js.cellWrite c (Js.some made) .finalizers
    made


removeFinalizer : Js.Cell ControlFields, Finalizer → Js.Opt UnitJob
removeFinalizer c (Finalizer fin) =
    key = Js.cellRead fin .key
    if key < 0 then
        Js.none ⊤
    else
        before = Js.cellRead fin .before
        after = Js.cellRead fin .after
        if absent before then
            Js.cellWrite c after .finalizers
        else
            (Finalizer prev) = required before
            Js.cellWrite prev after .after
        if not (absent after) then
            (Finalizer next) = required after
            Js.cellWrite next before .before
        Js.cellWrite fin (0 - 1) .key
        Js.cellWrite fin (Js.none ⊤) .before
        Js.cellWrite fin (Js.none ⊤) .after
        Js.some (takeWork unitWork key)


walkChain : Chain a, sync (a → ⊤) → ⊤
walkChain entries work =
    _ = Chain.find entries λvalue →
        work value
        False
    ⊤


pub waitList : ⊤ → WaitList a
waitList ⊤ = WaitList (Js.cell { first = Js.none ⊤, last = Js.none ⊤ })


linkWait : WaitList a, Control → ⊤
linkWait ((WaitList q) as list) ((Control c) as fiber) =
    set c listBit True
    last = Js.cellRead q .last
    Js.cellWrite c last .wbefore
    Js.cellWrite c (Js.none ⊤) .wafter
    Js.cellWrite c (Js.some (Kernel.slotPack list)) .wait
    if absent last then
        Js.cellWrite q (Js.some fiber) .first
    else
        Js.cellWrite (cellOf (required last)) (Js.some fiber) .wafter
    Js.cellWrite q (Js.some fiber) .last


unlinkList : WaitList a, Control → ⊤
unlinkList (WaitList q) (Control c) =
    set c listBit False
    before = Js.cellRead c .wbefore
    after = Js.cellRead c .wafter
    if absent before then
        Js.cellWrite q after .first
    else
        Js.cellWrite (cellOf (required before)) after .wafter
    if absent after then
        Js.cellWrite q before .last
    else
        Js.cellWrite (cellOf (required after)) before .wbefore
    Js.cellWrite c (Js.none ⊤) .wbefore
    Js.cellWrite c (Js.none ⊤) .wafter
    Js.cellWrite c (Js.none ⊤) .wait


pub parkIn : WaitList a → a
parkIn list = Js.suspending λ⊤ →
    fiber = here ⊤
    if interrupted fiber then
        Js.write pending (0 - 1)
        Runtime.parked ⊤
    else
        (Control c) = fiber
        set c parkedBit True
        set c hostBit False
        linkWait list fiber
        Js.write pending 1
        Runtime.parked ⊤


pub wakeFirst : WaitList a, a → Bool
wakeFirst ((WaitList q) as list) value =
    first = Js.cellRead q .first
    if absent first then
        False
    else
        fiber = required first
        c = cellOf fiber
        unlinkList list fiber
        set c parkedBit False
        Js.cellWrite c (Kernel.slotPack value) .value
        enqueue fiber
        True


wakeAll : WaitList a, a → ⊤
wakeAll list value = if wakeFirst list value then wakeAll list value


-- Remove links before the host canceller can run user code. The caller
-- enqueues cancellation before invoking the returned canceller.

clearWait : Control → Maybe (⊤ → ⊤)
clearWait ((Control c) as fiber) =
    saved = Js.cellRead c .wait
    host = if Js.read callbacking then has c hostBit || has c readyBit else False
    kids = if Js.read spawning then has c childrenBit else False
    if Js.read callbacking then
        set c hostBit False
        set c readyBit False
    set c parkedBit False
    if Js.read spawning then set c childrenBit False
    if host then Js.cellWrite c (Kernel.slotPack ⊤) .value
    if absent saved then
        Nothing
    else if kids then
        Js.cellWrite c (Js.none ⊤) .wait
        Nothing
    else if has c listBit then
        list : WaitList ⊤
        list = Kernel.slotRead (required saved)
        unlinkList list fiber
        Nothing
    else
        Js.cellWrite c (Js.none ⊤) .wait
        Just (Kernel.slotRead (required saved))


joinerList : Js.Cell ControlFields → WaitList ⊤
joinerList c =
    Js.write joined True
    old = Js.cellRead c .joiners
    if absent old then
        made = waitList ⊤
        Js.cellWrite c (Js.some made) .joiners
        made
    else
        required old


waitControl : Control → ⊤
waitControl (Control c) = if not (has c endedBit) then parkIn (joinerList c)


haltChildren : Js.Opt Control → ⊤
haltChildren children =
    if not (absent children) then
        fiber = required children
        next = Js.cellRead (cellOf fiber) .after
        halt fiber
        haltChildren next


linkChild : Maybe Control, Maybe Scope, Control → ⊤
linkChild parent group ((Control c) as fiber) =
    if Js.read scoped then linkChildGroup parent group fiber else linkParent parent fiber


linkChildGroup : Maybe Control, Maybe Scope, Control → ⊤
linkChildGroup parent group ((Control c) as fiber) =
    case group of
        Just attachedScope →
            (Scope sc) = attachedScope
            Js.cellWrite c (Js.some attachedScope) .group
            first = appendChild (Js.cellRead sc .children) fiber
            Js.cellWrite sc first .children
            if Js.cellRead sc .closed then set c interruptBit True
        Nothing →
            linkParent parent fiber


linkParent : Maybe Control, Control → ⊤
linkParent parent ((Control c) as fiber) =
    if not (Js.read spawning) then
        registerRoot fiber (schedulerOf fiber)
    else
        case parent of
            Nothing →
                registerRoot fiber (schedulerOf fiber)
            Just ((Control owner) as holder) →
                if has owner endedBit then
                    registerRoot fiber (schedulerOf fiber)
                else
                    Js.cellWrite c (Js.some holder) .owner
                    first = appendChild (Js.cellRead owner .children) fiber
                    Js.cellWrite owner first .children


unlinkOwner : Control → ⊤
unlinkOwner ((Control c) as fiber) =
    owner = Js.cellRead c .owner
    if Js.read spawning && not (absent owner) then
        parent = required owner
        p = cellOf parent
        first = removeChild (Js.cellRead p .children) fiber
        Js.cellWrite p first .children
        if absent first && has p childrenBit then
            set p childrenBit False
            set p parkedBit False
            enqueue parent
    else if has c registeredBit && absent (Js.cellRead c .group) then
        (Scheduler p) = program
        roots = removeChild (Js.cellRead p .roots) fiber
        Js.cellWrite p roots .roots
    if Js.read scoped then unlinkGroup fiber
    Js.cellWrite c (Js.none ⊤) .owner
    Js.cellWrite c (Js.none ⊤) .group
    Js.cellWrite c (Js.none ⊤) .before
    Js.cellWrite c (Js.none ⊤) .after


linkScope : Control, Scope → ⊤
linkScope ((Control c) as fiber) ((Scope sc) as group) =
    (ControlExt extra) = extension c
    first = appendScope (Js.cellRead extra .scopes) group
    Js.cellWrite extra first .scopes
    Js.cellWrite sc (Js.some fiber) .owner


unlinkScope : Scope → ⊤
unlinkScope ((Scope sc) as group) =
    owner = Js.cellRead sc .owner
    if not (absent owner) then
        (ControlExt extra) = extension (cellOf (required owner))
        first = removeScope (Js.cellRead extra .scopes) group
        Js.cellWrite extra first .scopes
        Js.cellWrite sc (Js.none ⊤) .owner
        Js.cellWrite sc (Js.none ⊤) .before
        Js.cellWrite sc (Js.none ⊤) .after


scopeWaiters : Js.Cell { r | waiters : Js.Opt (WaitList ⊤) } → WaitList ⊤
scopeWaiters sc =
    old = Js.cellRead sc .waiters
    if absent old then
        made = waitList ⊤
        Js.cellWrite sc (Js.some made) .waiters
        made
    else
        required old


type alias JobQueue =
    Js.Cell
        { first : Js.Opt Control
        , last : Js.Opt Control
        , soonFirst : Js.Opt Soon
        , soonLast : Js.Opt Soon
        , enqueued : Int
        , dequeued : Int
        }


queueSoon : Scheduler, Soon → ⊤
queueSoon ((Scheduler s) as sched) ((Soon work) as queuedWork) =
    q = Js.cellRead s .queue
    Js.cellWrite work (Js.cellRead q .enqueued) .position
    last = Js.cellRead q .soonLast
    if absent last then
        Js.cellWrite q (Js.some queuedWork) .soonFirst
    else
        (Soon previous) = required last
        Js.cellWrite previous (Js.some queuedWork) .next
    Js.cellWrite q (Js.some queuedWork) .soonLast
    requestDrain sched


requestDrain : Scheduler → ⊤
requestDrain ((Scheduler s) as sched) =
    if not (Js.cellRead s .scheduled) then
        Js.cellWrite s True .scheduled
        if Js.cellRead s .program && Js.read hosting then ⊤ else requeue sched λ⊤ → drain sched


runQueued : JobQueue → Bool
runQueued q = if Js.read soonable then runMixed q else runFiberJob q


runMixed : JobQueue → Bool
runMixed q =
    soonHead = Js.cellRead q .soonFirst
    takeSoon =
        if absent soonHead then
            False
        else
            (Soon s) = required soonHead
            Js.cellRead s .position ≤ Js.cellRead q .dequeued
    if takeSoon then
        work = required soonHead
        (Soon s) = work
        next = Js.cellRead s .next
        Js.cellWrite q next .soonFirst
        if absent next then Js.cellWrite q (Js.none ⊤) .soonLast
        Js.cellWrite s (Js.none ⊤) .next
        if jobsEmpty q then
            Js.cellWrite q 0 .enqueued
            Js.cellWrite q 0 .dequeued
        runSoon work
    else
        runFiberJob q


runFiberJob : JobQueue → Bool
runFiberJob q =
    fiber = required (Js.cellRead q .first)
    c = cellOf fiber
    next = Js.cellRead c .wafter
    Js.cellWrite q next .first
    if absent next then Js.cellWrite q (Js.none ⊤) .last
    Js.cellWrite c (Js.none ⊤) .wafter
    if jobsEmpty q then
        Js.cellWrite q 0 .enqueued
        Js.cellWrite q 0 .dequeued
    else
        Js.cellWrite q (Js.cellRead q .dequeued + 1) .dequeued
    set c queuedBit False
    runFiber fiber
    True


visitChildren : Js.Opt Control, sync (Control → ⊤) → ⊤
visitChildren children visit =
    if not (absent children) then
        fiber = required children
        next = Js.cellRead (cellOf fiber) .after
        visit fiber
        visitChildren next visit


ownedScope : Scope, Scheduler → Bool
ownedScope (Scope sc) ((Scheduler s) as sched) =
    if Js.cellRead s .program then
        True
    else
        case Js.cellRead sc .listed of
            Nothing →
                False
            Just owner →
                Js.same owner sched


expireWaiting : Scheduler → ⊤
expireWaiting sched =
    case findCleaning (Js.read cleaning) sched of
        Nothing →
            ⊤
        Just fiber →
            abandon fiber
            enqueue fiber
            expireWaiting sched


finalising : Js.Ref Bool
finalising = Js.ref False


joined : Js.Ref Bool
joined = Js.ref False


observed : Js.Ref Bool
observed = Js.ref False


scoped : Js.Ref Bool
scoped = Js.ref False


soonable : Js.Ref Bool
soonable = Js.ref False


finishReturned : Control → ⊤
finishReturned (Control c) = set c unwindBit True


parkChildren : Control → ⊤
parkChildren (Control c) =
    set c parkedBit True
    set c childrenBit True
    Js.write pending 1


finishUnwind : Control → ⊤
finishUnwind fiber = if settleChildren fiber then finishCancelled fiber


appendChild : Js.Opt Control, Control → Js.Opt Control
appendChild first ((Control c) as fiber) =
    Js.cellWrite c (Js.none ⊤) .after
    if absent first then
        Js.cellWrite c (Js.some fiber) .before
        Js.some fiber
    else
        head = cellOf (required first)
        last = required (Js.cellRead head .before)
        Js.cellWrite c (Js.some last) .before
        Js.cellWrite (cellOf last) (Js.some fiber) .after
        Js.cellWrite head (Js.some fiber) .before
        first


removeChild : Js.Opt Control, Control → Js.Opt Control
removeChild first ((Control c) as fiber) =
    head = required first
    before = Js.cellRead c .before
    after = Js.cellRead c .after
    if Js.same head fiber then
        if not (absent after) then Js.cellWrite (cellOf (required after)) before .before
        after
    else
        Js.cellWrite (cellOf (required before)) after .after
        if absent after then
            Js.cellWrite (cellOf head) before .before
        else
            Js.cellWrite (cellOf (required after)) before .before
        first


unlinkGroup : Control → ⊤
unlinkGroup ((Control c) as fiber) =
    group = Js.cellRead c .group
    if not (absent group) then
        attachedScope = required group
        (Scope sc) = attachedScope
        first = removeChild (Js.cellRead sc .children) fiber
        Js.cellWrite sc first .children
        if absent first then
            waiting = Js.cellRead sc .waiters
            if not (absent waiting) then wakeAll (required waiting) ⊤
            if
                Js.cellRead sc .closed
                    && Js.read rooted
                    && Js.cellRead sc .root
                    && not (hasDeferred attachedScope)
            then
                _ = unlistScope attachedScope
                ⊤


type alias Sweep =
    Js.Cell { values : Js.Builder Control, count : Int, at : Int }


pushSweep : Sweep, Control → ⊤
pushSweep sweepState fiber =
    count = Js.cellRead sweepState .count
    Array.arrayWrite (Js.cellRead sweepState .values) count fiber
    Js.cellWrite sweepState (count + 1) .count


sortSweep : Sweep → ⊤
sortSweep sweepState =
    count = Js.cellRead sweepState .count
    if count > 1 then
        fresh = Array.arrayAllocate count
        filled = copySweep (Js.cellRead sweepState .values) fresh 0 count
        sorted = Array.arraySort filled byBirth
        Js.cellWrite sweepState sorted .values


copySweep : Js.Builder Control, Js.Builder Control, Int, Int → Js.Builder Control
copySweep source into index count =
    if index == count then
        into
    else
        filled = Array.arraySet into index (Array.arrayGet source index)
        copySweep source filled (index + 1) count


byBirth : Control, Control → Int
byBirth (Control left) (Control right) = Js.cellRead left .ordinal - Js.cellRead right .ordinal


callbacking : Js.Ref Bool
callbacking = Js.ref False


appendScope : Js.Opt Scope, Scope → Js.Opt Scope
appendScope first ((Scope sc) as group) =
    Js.cellWrite sc (Js.none ⊤) .after
    if absent first then
        Js.cellWrite sc (Js.some group) .before
        Js.some group
    else
        (Scope head) = required first
        last = required (Js.cellRead head .before)
        (Scope tail) = last
        Js.cellWrite sc (Js.some last) .before
        Js.cellWrite tail (Js.some group) .after
        Js.cellWrite head (Js.some group) .before
        first


removeScope : Js.Opt Scope, Scope → Js.Opt Scope
removeScope first ((Scope sc) as group) =
    head = required first
    before = Js.cellRead sc .before
    after = Js.cellRead sc .after
    if Js.same head group then
        if not (absent after) then
            (Scope next) = required after
            Js.cellWrite next before .before
        after
    else
        (Scope prev) = required before
        Js.cellWrite prev after .after
        if absent after then
            (Scope firstCell) = head
            Js.cellWrite firstCell before .before
        else
            (Scope next) = required after
            Js.cellWrite next before .before
        first


visitScopes : Js.Opt Scope, sync (Scope → ⊤) → ⊤
visitScopes first visit =
    if not (absent first) then
        group = required first
        (Scope sc) = group
        next = Js.cellRead sc .after
        visit group
        visitScopes next visit


cleanupOutside : Control → ⊤
cleanupOutside ((Control owner) as holder) =
    old = Js.cellRead owner .slots
    fiber = newControl { Record.copy old | sched = Nothing }
    c = cellOf fiber
    Js.cellWrite c (Js.cellRead owner .finalizers) .finalizers
    Js.cellWrite owner (Js.none ⊤) .finalizers
    Js.cellWrite owner 0 .masks
    (ControlExt extra) = extension c
    Js.cellWrite extra (Just holder) .outsideOwner
    registerFiber Nothing Nothing (Fiber fiber)
    unwind fiber
    enqueue fiber


findCleaning : Js.Opt Control, Scheduler → Maybe Control
findCleaning first ((Scheduler s) as sched) =
    if absent first then
        Nothing
    else
        fiber = required first
        c = cellOf fiber
        if has c parkedBit && (Js.cellRead s .program || Js.same (schedulerOf fiber) sched) then
            Just fiber
        else
            (ControlExt extra) = required (Js.cellRead c .ext)
            next = Js.cellRead extra .cleanAfter
            if Js.same next (Js.read cleaning) then Nothing else findCleaning next sched


deferredList : Scope → Chain Int
deferredList (Scope sc) =
    case Js.cellRead sc .deferred of
        Just existing →
            existing
        Nothing →
            made = Chain.make ⊤
            Js.cellWrite sc (Just made) .deferred
            made


hasDeferred : Scope → Bool
hasDeferred (Scope sc) =
    if not (Js.read releasing) then
        False
    else
        case Js.cellRead sc .deferred of
            Nothing →
                False
            Just jobs →
                Chain.size jobs > 0


releasing : Js.Ref Bool
releasing = Js.ref False


scopeHeads : Control → Js.Opt Scope
scopeHeads (Control c) =
    if Js.read scoped then
        Js.optMatch (Js.cellRead c .ext) (λ⊤ → Js.none ⊤) λ(ControlExt extra) →
            Js.cellRead extra .scopes
    else
        Js.none ⊤


collectTree : Scheduler, Int, Int → ⊤
collectTree ((Scheduler s) as sched) index kept =
    state = Js.cellRead s .sweeping
    if index == Js.cellRead state .count then
        Js.cellWrite state kept .count
    else
        values = Js.cellRead state .values
        fiber = Array.arrayGet values index
        c = cellOf fiber
        if Js.read spawning then gatherChildren (Js.cellRead c .children) state
        if Js.read scoped then gatherScopes (scopeHeads fiber) state
        matches =
            if not (Js.read many) || Js.cellRead s .program then
                True
            else
                case memberOf c of
                    Nothing →
                        False
                    Just owner →
                        Js.same owner sched
        if matches && not (has c endedBit) then
            Array.arrayWrite values kept fiber
            collectTree sched (index + 1) (kept + 1)
        else
            collectTree sched (index + 1) kept


cleanupPhaseBit : Int
cleanupPhaseBit = 2048


settleChildren : Control → Bool
settleChildren ((Control c) as fiber) =
    if not (Js.read spawning) then
        True
    else
        haltChildren (Js.cellRead c .children)
        if absent (Js.cellRead c .children) then
            True
        else
            parkChildren fiber
            False


advanceUnwind : Control → ⊤
advanceUnwind ((Control c) as fiber) =
    if not (has c cancelBit) then
        if settleChildren fiber then complete fiber
    else if not (Js.read finalising) then
        finishUnwind fiber
    else if not (Js.read spawning) || has c cleanupPhaseBit then
        runFinalizer fiber
    else if settleChildren fiber then
        set c cleanupPhaseBit True
        runFinalizer fiber


runFinalizer : Control → ⊤
runFinalizer ((Control c) as fiber) =
    if inCleanup fiber then leaveCleanup fiber
    first = Js.cellRead c .finalizers
    if absent first then
        finishUnwind fiber
    else
        fin = required (removeFinalizer c (required first))
        enterCleanup fiber
        Js.invoke fin ⊤
        ⊤


forceCancel : Control → ⊤
forceCancel ((Control c) as fiber) =
    if not (has c endedBit) then
        if has c unwindBit then
            set c cancelBit True
            cutBack fiber
        else
            unwind fiber


rooted : Js.Ref Bool
rooted = Js.ref False


gatherChildren : Js.Opt Control, Sweep → ⊤
gatherChildren first state =
    if not (absent first) then
        fiber = required first
        pushSweep state fiber
        gatherChildren (Js.cellRead (cellOf fiber) .after) state


gatherScopes : Js.Opt Scope, Sweep → ⊤
gatherScopes first state =
    if not (absent first) then
        (Scope group) = required first
        gatherChildren (Js.cellRead group .children) state
        gatherScopes (Js.cellRead group .after) state


loanList : Scheduler → Chain Loan
loanList ((Scheduler s) as sched) =
    case Js.cellRead s .loans of
        Just existing →
            existing
        Nothing →
            made = Chain.make ⊤
            Js.cellWrite s (Just made) .loans
            made
