--! This module is for values that may or may not exist. `Maybe` is how beni
--! says "this might be missing" in a type, so it is checked rather than
--! discovered at run time; there is no null.
--!
--! Every function here takes the `Maybe` as its first argument and the
--! function it applies, if any, as its last. That is what lets `▷` feed a
--! `Maybe` in at the front — `maybe ▷ map toString` is `map maybe toString` —
--! and lets `x ← andThen maybe` bind the rest of the block as the
--! callback.
--!
--! Everything here is ordinary beni — no `foreign` declarations.

--| Represent values that may or may not exist. It can be useful if you have a
--| record field that is only filled in sometimes, or if a function takes a
--| value sometimes but does not absolutely need it.
--|
--|     type alias Person =
--|         { name : String, age : Maybe Int }
pub type Maybe a
    = Just a
    | Nothing


--| Provide a default value, turning an optional value into a normal value.
--|
--|     withDefault (Just 42) 100 == 42
--|     withDefault Nothing 100 == 100
--|
--| It is best to pattern match when you can, so a missing value is handled
--| where it happens rather than papered over here.
pub withDefault : Maybe a, a → a
withDefault maybe default =
    case maybe of
        Just value →
            value

        Nothing →
            default


--| Transform a `Maybe` value with a given function.
--|
--|     map (Just 9) sqrt == Just 3
--|     map Nothing sqrt == Nothing
--|
--| The `Maybe` comes first, so this reads well in a pipeline:
--|
--|     (Just 9 ▷ map sqrt) == Just 3
pub map : Maybe a, (a → b) → Maybe b
map maybe func =
    case maybe of
        Just value →
            Just (func value)

        Nothing →
            Nothing


--| Apply a function if both `Maybe` values are `Just` a value.
--|
--|     map2 (Just 3) (Just 4) (+) == Just 7
--|     map2 (Just 3) Nothing (+) == Nothing
pub map2 : Maybe a, Maybe b, (a, b → value) → Maybe value
map2 ma mb func =
    case ma of
        Nothing →
            Nothing

        Just a →
            case mb of
                Nothing →
                    Nothing

                Just b →
                    Just (func a b)


--| Apply a function if all three `Maybe` values are `Just` a value.
--|
--|     map3 (Just 1) (Just 2) (Just 3) (λa b c → a + b + c) == Just 6
--|     map3 (Just 1) Nothing (Just 3) (λa b c → a + b + c) == Nothing
pub map3 : Maybe a, Maybe b, Maybe c, (a, b, c → value) → Maybe value
map3 ma mb mc func =
    case ma of
        Nothing →
            Nothing

        Just a →
            case mb of
                Nothing →
                    Nothing

                Just b →
                    case mc of
                        Nothing →
                            Nothing

                        Just c →
                            Just (func a b c)


--| Apply a function if all four `Maybe` values are `Just` a value.
pub map4 :
      Maybe a
    , Maybe b
    , Maybe c
    , Maybe d
    , (a, b, c, d → value)
    → Maybe value
map4 ma mb mc md func =
    case ma of
        Nothing →
            Nothing

        Just a →
            case mb of
                Nothing →
                    Nothing

                Just b →
                    case mc of
                        Nothing →
                            Nothing

                        Just c →
                            case md of
                                Nothing →
                                    Nothing

                                Just d →
                                    Just (func a b c d)


--| Apply a function if all five `Maybe` values are `Just` a value.
pub map5 :
      Maybe a
    , Maybe b
    , Maybe c
    , Maybe d
    , Maybe e
    , (a, b, c, d, e → value)
    → Maybe value
map5 ma mb mc md me func =
    case ma of
        Nothing →
            Nothing

        Just a →
            case mb of
                Nothing →
                    Nothing

                Just b →
                    case mc of
                        Nothing →
                            Nothing

                        Just c →
                            case md of
                                Nothing →
                                    Nothing

                                Just d →
                                    case me of
                                        Nothing →
                                            Nothing

                                        Just value →
                                            Just (func a b c d value)


--| Chain together many computations that may fail.
--|
--|     andThen (Just 1) (λx → Just (x + 1)) == Just 2
--|     andThen Nothing (λx → Just (x + 1)) == Nothing
--|
--| The callback comes last, so `x ← andThen maybe` binds the rest of the
--| block as the callback. The `?` operator does the same thing with less
--| punctuation: `head xs?` is the value, or an early return of `Nothing` from
--| the enclosing function.
pub andThen : Maybe a, (a → Maybe b) → Maybe b
andThen maybe callback =
    case maybe of
        Just value →
            callback value

        Nothing →
            Nothing
