-- #1861: this unproved root keeps the general renderer byte for byte.
import Browser
import Browser.Host.Array as Array
import Html exposing (Html)


view : Int → Html {}
view _ = <p>escaped</p>


held = Array.fromList [ view ]


main : Browser.Program
main =
    Browser.program
        { init =
            λ⊤ →
                Array.eachView held λ_ → ⊤
                Array.length held
        , update = λ_ model → model
        , view = view
        }
