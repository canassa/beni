-- emit/release: `backend.md` §9 items 3 and 5, as bytes. What a running
-- program cannot tell you is where the whitespace went, so this is the
-- golden that says it:
--
--   * **one line, and a newline only at the end of the file** (item 3 as
--     amended on 2026-10-02: the newline after every top-level declaration,
--     kept for stack traces, was 13 brotli bytes of the empty page's 838).
--     The whole module body is ONE joined declaration, written `let`: a
--     `const` the compiler wrote is assigned nowhere;
--   * **no indentation at all**, and no space that the syntax does not need —
--     `let a=1`, `f(x,y)`, `{a:1}`, `(a,b)=>`, `a?b:c`, `if(c){…}else{…}`,
--     `case 1:`, `for(;;)`;
--   * **every semicolon present**, including the last one of every block. §9
--     rejects eliding it: one byte per block, in exchange for having to know
--     that a statement beginning `(`, `[`, `` ` ``, `+`, `-` or `/` needs a
--     leading one. Nothing here elides, so no newline is ever in a position
--     where ASI could stand in for a semicolon;
--   * **a run of adjacent declarations joined into one** — `joins`' three
--     bindings, the run item 5 was reserved for (`carried`'s §8 loop, which
--     had a prologue to join, reassigns its parameters in place since
--     2026-10-02 and has none). `const` and `let` join alike, both written
--     `let`, and `branching`'s `if`/`else` is the statement that breaks one.
--
-- The declarations below exist for those shapes and for nothing else, so a
-- diff of this golden reads as a whitespace decision rather than as codegen.
import Node exposing (Program)


pub joins : Int -> Int
joins n =
    let
        one =
            n * 2

        two =
            one * 3

        three =
            two * 4
    in
    one + two + three


pub branching : Int -> Int
branching n =
    if n > 0 then
        n * 2
    else
        n - 1


pub carried : Int, Int -> Int
carried n acc =
    if n <= 0 then
        acc
    else
        carried (n - 1) (acc + n)


pub shaped : Int -> { count : Int, label : Int }
shaped n =
    { count = n, label = n * 2 }


main : Program
main =
    Node.printLines []
