-- emit/release: a value made only of beni field reads, names and literals
-- is written at its single use when nothing between may write (`backend.md`
-- §9 item 1, amended 2026-10-18). A field read has no effect, but a write
-- of its record would change it.
--
-- `plenty`'s two bindings are both written at their uses, the second an
-- `if` of a field read and literals; before, each stayed a `let`. `label`'s
-- `n = c.name` is read after two calls of `f`, and a field read crosses no
-- call (the ordering rule: a call not proven pure may write the record),
-- so it stays bound.
import Node


type alias Cups =
    cups : Int
    name : String


pub label : (String → String), Cups → List String
label f c =
    n = c.name
    shout = f "x"
    louder = f shout
    [ louder, n, shout ]


pub plenty : Cups → List String
plenty c =
    a = c.cups
    b = if c.cups > 11 then "Plenty" else "Some"
    [ "Cups = ${String.fromInt a}", b ]


main : Node.Program
main = Node.printLines (plenty { cups = 12, name = "x" })
