-- The research generators' push and timer subscriptions on browser-inline
-- (docs/design/browser-inline.md §3, §7), through their platform layer
-- (`Push.onPush`, `Interval.every`, unchanged but for the platform name):
-- each start is lifted in its own module and called from the mount, the
-- push decoded in its arm by a `read` whose `Err` payload nothing reads —
-- a shape run (`schema.md` §6) — and the one text binding written in the
-- dispatch's write pass. No message, no `core/Task`, no `core/Dict`.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Interval
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"


type alias Model =
    count : Int
    ticks : Int


init : ⊤ → Model × Cmd Msg
init ⊤ = ( { count = 0, ticks = 0 }, Cmd.none )


type Msg
    = Pushed Value
    | Tick


schema Event tagged "type" of
    Set as "set"
        value : Int
    Reset as "reset"


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Pushed value →
            ( pushed value model, Cmd.none )

        Tick →
            ( { model | ticks = model.ticks + 1 }, Cmd.none )


pushed : Value, Model → Model
pushed value model =
    case Schema.read (Event.schema ⊤) value of
        Ok (Event.Set event) →
            { model | count = event.value }

        Ok Event.Reset →
            { model | count = 0 }

        Err _ →
            model


subscriptions : Model → Sub Msg
subscriptions _ = Sub.batch [ Push.onPush Pushed, Interval.every 1000 Tick ]


view : Model → Html Msg
view model =
    <div data-role="dashboard">
        <p>{"${String.fromInt model.count} pushed, ${String.fromInt model.ticks} ticks"}</p>
    </div>
