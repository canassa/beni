-- Each widget reads the other's field (`docs/design/browser-inline.md` §8.4,
-- amended 2026-10-22): `W1` shows `w2.venue` and `W2` shows `w1.cups`, each
-- handed the field below the slice it does not hold, which it reads through
-- that slice's object. Each registers its reader into the other's bucket at
-- mount, and neither event names the other root: a click writes both cups
-- displays, an input both venue displays, in the same dispatch.
import Browser
import Html exposing (Html)
import Tea
import W1
import W2


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { w1 = W1.init ⊤, w2 = W2.init ⊤ }
            , update = update
            , view = view
            }
        )
        "root"


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            { model | w2 = W2.update sub model.w2 }


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1 model.w2.venue) W1Msg}
        {Html.map (W2.view model.w2 model.w1.cups) W2Msg}
    </div>
