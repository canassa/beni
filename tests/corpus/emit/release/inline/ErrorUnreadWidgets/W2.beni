--! A list whose state the host may replace.

import Json
import Schema exposing (Value)


pub type alias Model =
    laps : Int
    items : List String
    open : Bool


pub init : ⊤ → Model
init ⊤ = { laps = 0, items = [], open = False }


pub replace : Value, Model → Model
replace state model =
    case Json.decodeValue state of
        Ok new →
            { laps = new.laps, items = List.copy new.items, open = new.open }

        Err _ →
            model
