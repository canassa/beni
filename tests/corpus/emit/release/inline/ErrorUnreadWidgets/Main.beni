-- The research benchmark's widgets on browser-inline (`schema.md` §6, *A run
-- whose failure is never read is a validator*): each widget's module reads
-- the state the host pushes with `Json.decodeValue`, whose error it discards
-- — `W1` and `W2` in a `case` with `Err _`, `W3` with
-- `Result.withDefault`. Each is a validator run: the widget's derived
-- codec's validator worker called where the run stands, which makes no issue
-- and writes no message.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea
import W1
import W2
import W3


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"


type alias Model =
    w1 : W1.Model
    w2 : W2.Model
    w3 : W3.Model


init : ⊤ → Model × Cmd Msg
init ⊤ = ( { w1 = W1.init ⊤, w2 = W2.init ⊤, w3 = W3.init ⊤ }, Cmd.none )


type Msg
    = Pushed Value


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Pushed value →
            ( { w1 = W1.replace value model.w1
              , w2 = W2.replace value model.w2
              , w3 = W3.replace value model.w3
              }
            , Cmd.none
            )


subscriptions : Model → Sub Msg
subscriptions _ = Push.onPush Pushed


view : Model → Html Msg
view model =
    <div data-role="dashboard">
        <p>{"${String.fromInt model.w1.sheets} ${model.w1.tone}"}</p>
        <p>{"${String.fromInt model.w2.laps} ${String.fromInt (List.length model.w2.items)}"}</p>
        <p>{String.fromFloat model.w3.level}</p>
    </div>
