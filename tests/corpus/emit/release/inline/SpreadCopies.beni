update1 : ChildMsg, Child → Child
update1 msg child =
    case msg of
        M1 →
            { child | b = child.b + 101 }
        M2 →
            { child | c = child.c + 102 }
        M3 →
            { child | a = child.a + 103 }
        M4 →
            { child | b = child.b + 104 }
        M5 →
            { child | c = child.c + 105 }
        M6 →
            { child | a = child.a + 106 }


