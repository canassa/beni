-- #564: SpreadArms with 42 children of six messages each. Every handler the
-- `inline` lowering emits copies the model (`const $before = $model`) and
-- spreads the copy, so each of the 252 record updates spreads a summary of
-- its own, linked to the model's. Points-to gave each update a var per field,
-- fed by an edge from that summary, and every summary that folds the updates
-- an edge per update and field, which put this build past the gates'
-- instruction budget. A field only the spread writes now shares the var of
-- the root of those copies, the model summary's, until something else
-- writes it. The golden was written by the compiler before the change.
import Browser
import Html exposing (Html)
import Tea


type alias Child =
    a : Int
    b : Int
    c : Int


type ChildMsg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


type alias Model =
    w1 : Child
    w2 : Child
    w3 : Child
    w4 : Child
    w5 : Child
    w6 : Child
    w7 : Child
    w8 : Child
    w9 : Child
    w10 : Child
    w11 : Child
    w12 : Child
    w13 : Child
    w14 : Child
    w15 : Child
    w16 : Child
    w17 : Child
    w18 : Child
    w19 : Child
    w20 : Child
    w21 : Child
    w22 : Child
    w23 : Child
    w24 : Child
    w25 : Child
    w26 : Child
