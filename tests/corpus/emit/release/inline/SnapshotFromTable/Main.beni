-- A snapshot's record of widgets written from the route table
-- (`docs/design/browser-inline.md` §8.4, amended 2026-10-24, #915).
-- `ShapeLoader`'s program with its widgets named `zed` and `amy`: the
-- `Widgets` record is a `Value` per widget, its keys and names those of the
-- keyed route table's rows in the declaration's order, so its shape is made
-- from the table. The canonical order (`amy`, `zed`) is not the
-- declaration's, so the shape's `order` puts `zed` first: each key is read
-- once, in the declaration's order. A snapshot missing a widget, one whose
-- widgets are `null` or an array, and an unknown key change nothing; a
-- key no widget has is ignored, as the record's shape ignores it.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Json
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea
import W1
import W2


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"


type alias Model =
    zed : W1.Model
    amy : W2.Model


init : ⊤ → Model × Cmd Msg
init ⊤ = ( { zed = W1.init ⊤, amy = W2.init ⊤ }, Cmd.none )


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg
    | Pushed Value


update : Msg, Model → Model × Cmd Msg
update msg model = ( step msg model, Cmd.none )


step : Msg, Model → Model
step msg model =
    case msg of
        W1Msg sub →
            { model | zed = W1.update sub model.zed }

        W2Msg sub →
            { model | amy = W2.update sub model.amy }

        Pushed value →
            pushed value model


subscriptions : Model → Sub Msg
subscriptions _ = Push.onPush Pushed


schema Event tagged "type" of
    ServerSet as "serverSet"
        widget : String
        state : Value
    Snapshot as "snapshot"
        state : Snapshot


schema Snapshot =
    widgets : Widgets


schema Widgets =
    zed : Value as "zed"
    amy : Value as "amy"


pushed : Value, Model → Model
pushed value model =
    case Schema.read (Event.schema ⊤) value of
        Ok (Event.ServerSet event) →
            replaced event.widget event.state model

        Ok (Event.Snapshot event) →
            widgets = event.state.widgets
            { zed = W1.replace widgets.zed model.zed
            , amy = W2.replace widgets.amy model.amy
            }

        Err _ →
            model


replaced : String, Value, Model → Model
replaced widget state model =
    case widget of
        "zed" →
            { model | zed = W1.replace state model.zed }

        "amy" →
            { model | amy = W2.replace state model.amy }

        _ →
            model


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.zed) W1Msg}
        {Html.map (W2.view model.amy model.zed) W2Msg}
    </div>


-- ---- Shape runs: thirty runs in all take the program to the shapes side --

pub pad1 : Value → Int
pad1 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


pub pad2 : Value → Int
pad2 v = (Result.withDefault (Json.decodeValue v) { n = 2 }).n


