-- A slice the program replaces (`docs/design/browser-inline.md` §8.4,
-- amended 2026-10-22, the owner's decision 1): `w1` is a number, so every
-- write gives the model a new value there, and no object of it can be held.
-- Both roots read it through the model's object, which every key keeps:
-- `W1`'s own and `W2`'s reader see a raise, the pushed value, then the next
-- raise from it.
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea
import W1
import W2


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


init : ⊤ → Model × Cmd Msg
init ⊤ = ( { w1 = W1.init ⊤, w2 = W2.init ⊤ }, Cmd.none )


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg
    | Pushed Value


update : Msg, Model → Model × Cmd Msg
update msg model = ( step msg model, Cmd.none )


step : Msg, Model → Model
step msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            { model | w2 = W2.update sub model.w2 }

        Pushed value →
            pushed value model


subscriptions : Model → Sub Msg
subscriptions _ = Push.onPush Pushed


schema Event tagged "type" of
    Set as "set"
        cups : Int


pushed : Value, Model → Model
pushed value model =
    case Schema.read (Event.schema ⊤) value of
        Ok (Event.Set event) →
            { model | w1 = event.cups }

        Err _ →
            model


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
        {Html.map (W2.view model.w2 model.w1) W2Msg}
    </div>
