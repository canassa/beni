-- emit/release/inline: `update` reads `model.n`, writes `n` by a record
-- update, then keeps the value it read (`backend.md` §9 item 1, amended
-- 2026-10-18, *the ordering rule*). A field read is effect-free but not
-- invariant: it is never moved across a write of its record. The write is
-- in place (#315), so the read is hoisted above the store
-- (`ownership-checker.md` §31.14): `let b=e.a;e.a=e.a+1;e.b=b`. The page
-- is `browser/inline/OldValueAfterWrite`.
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    n : Int
    was : Int


type Msg
    = Inc


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            old = model.n
            next = { model | n = model.n + 1 }
            { next | was = old }


view : Model → Html Msg
view model =
    <div data-role="old">
        <output>{model.n}</output>
        <p>Was: {model.was}</p>
        <button data-role="inc" onClick={Inc}>+1</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { n = 0, was = 0 }, update = update, view = view })
        "root"
