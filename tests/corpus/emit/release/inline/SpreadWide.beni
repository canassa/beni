-- #464: a wide record of children, each updated by its own function in its own
-- arm of `update`: every arm spreads `model`, so the release optimiser's
-- points-to analysis copies every field of every model site into every arm's
-- result. Before the field summaries, each spread was one constraint re-walking
-- every source site and property on every change, which made this build grow
-- past the gates' instruction budget; the summary makes it one edge per
-- property. The golden was written by the compiler before the change.
import Browser
import Html exposing (Html)
import Tea


type alias Child =
    a : Int
    b : Int
    c : Int
    d : Int


type ChildMsg
    = Add
    | Subtract


type alias Model =
    w1 : Child
    w2 : Child
    w3 : Child
    w4 : Child
    w5 : Child
    w6 : Child
    w7 : Child
    w8 : Child
    w9 : Child
    w10 : Child
    w11 : Child
    w12 : Child
    w13 : Child
    w14 : Child
    w15 : Child
    w16 : Child
