--! Child 5: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a5 : Int
    b5 : Int
    c5 : Int


pub init : ⊤ → Model
init ⊤ = { a5 = 5, b5 = 1, c5 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b5 = model.b5 + 501 }

        M2 →
            { model | c5 = model.c5 + 502 }

        M3 →
            { model | a5 = model.a5 + 503 }

        M4 →
            { model | b5 = model.b5 + 504 }

        M5 →
            { model | c5 = model.c5 + 505 }

        M6 →
            { model | a5 = model.a5 + 506 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a5 = n, b5 = 5, c5 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a5}</p>
        <p>{model.b5}</p>
        <p>{model.c5}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
