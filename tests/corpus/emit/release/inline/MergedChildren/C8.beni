--! Child 8: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a8 : Int
    b8 : Int
    c8 : Int


pub init : ⊤ → Model
init ⊤ = { a8 = 8, b8 = 1, c8 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b8 = model.b8 + 801 }

        M2 →
            { model | c8 = model.c8 + 802 }

        M3 →
            { model | a8 = model.a8 + 803 }

        M4 →
            { model | b8 = model.b8 + 804 }

        M5 →
            { model | c8 = model.c8 + 805 }

        M6 →
            { model | a8 = model.a8 + 806 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a8 = n, b8 = 8, c8 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a8}</p>
        <p>{model.b8}</p>
        <p>{model.c8}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
