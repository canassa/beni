--! Child 10: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a10 : Int
    b10 : Int
    c10 : Int


pub init : ⊤ → Model
init ⊤ = { a10 = 10, b10 = 1, c10 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b10 = model.b10 + 1001 }

        M2 →
            { model | c10 = model.c10 + 1002 }

        M3 →
            { model | a10 = model.a10 + 1003 }

        M4 →
            { model | b10 = model.b10 + 1004 }

        M5 →
            { model | c10 = model.c10 + 1005 }

        M6 →
            { model | a10 = model.a10 + 1006 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a10 = n, b10 = 10, c10 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a10}</p>
        <p>{model.b10}</p>
        <p>{model.c10}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
