--! Child 11: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a11 : Int
    b11 : Int
    c11 : Int


pub init : ⊤ → Model
init ⊤ = { a11 = 11, b11 = 1, c11 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b11 = model.b11 + 1101 }

        M2 →
            { model | c11 = model.c11 + 1102 }

        M3 →
            { model | a11 = model.a11 + 1103 }

        M4 →
            { model | b11 = model.b11 + 1104 }

        M5 →
            { model | c11 = model.c11 + 1105 }

        M6 →
            { model | a11 = model.a11 + 1106 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a11 = n, b11 = 11, c11 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a11}</p>
        <p>{model.b11}</p>
        <p>{model.c11}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
