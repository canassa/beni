--! Child 6: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a6 : Int
    b6 : Int
    c6 : Int


pub init : ⊤ → Model
init ⊤ = { a6 = 6, b6 = 1, c6 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b6 = model.b6 + 601 }

        M2 →
            { model | c6 = model.c6 + 602 }

        M3 →
            { model | a6 = model.a6 + 603 }

        M4 →
            { model | b6 = model.b6 + 604 }

        M5 →
            { model | c6 = model.c6 + 605 }

        M6 →
            { model | a6 = model.a6 + 606 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a6 = n, b6 = 6, c6 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a6}</p>
        <p>{model.b6}</p>
        <p>{model.c6}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
