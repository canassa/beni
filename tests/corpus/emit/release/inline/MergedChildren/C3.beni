--! Child 3: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a3 : Int
    b3 : Int
    c3 : Int


pub init : ⊤ → Model
init ⊤ = { a3 = 3, b3 = 1, c3 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b3 = model.b3 + 301 }

        M2 →
            { model | c3 = model.c3 + 302 }

        M3 →
            { model | a3 = model.a3 + 303 }

        M4 →
            { model | b3 = model.b3 + 304 }

        M5 →
            { model | c3 = model.c3 + 305 }

        M6 →
            { model | a3 = model.a3 + 306 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a3 = n, b3 = 3, c3 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a3}</p>
        <p>{model.b3}</p>
        <p>{model.c3}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
