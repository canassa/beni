--! Child 14: three fields of its own, six messages, a decoder and a view.

import Html exposing (Html)


pub type alias Model =
    a14 : Int
    b14 : Int
    c14 : Int


pub init : ⊤ → Model
init ⊤ = { a14 = 14, b14 = 1, c14 = 2 }


pub type Msg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


pub update : Msg, Model → Model
update msg model =
    case msg of
        M1 →
            { model | b14 = model.b14 + 1401 }

        M2 →
            { model | c14 = model.c14 + 1402 }

        M3 →
            { model | a14 = model.a14 + 1403 }

        M4 →
            { model | b14 = model.b14 + 1404 }

        M5 →
            { model | c14 = model.c14 + 1405 }

        M6 →
            { model | a14 = model.a14 + 1406 }


pub decode : String → Maybe Model
decode s =
    case String.toInt s of
        Just n →
            Just { a14 = n, b14 = 14, c14 = n }

        Nothing →
            Nothing


pub view : Model → Html Msg
view model =
    <section>
        <p>{model.a14}</p>
        <p>{model.b14}</p>
        <p>{model.c14}</p>
        <button onClick={M1}>1</button>
        <button onClick={M2}>2</button>
        <button onClick={M3}>3</button>
        <button onClick={M4}>4</button>
        <button onClick={M5}>5</button>
        <button onClick={M6}>6</button>
    </section>
