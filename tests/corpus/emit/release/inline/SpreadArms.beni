-- #496: 29 children of six messages each, every arm its own record update, so
-- the result of `update` may be any of 175 model records (one per arm, and
-- `init`'s), and every handler the `inline` lowering emits copies the whole
-- model into its own vars and its arms' locals. Before the points-to set table
-- each of those vars kept its own copy of every set it grew through, one site
-- at a time, which put this build past the gates' instruction budget; vars
-- that hold the same sites now hold one copy. The golden was written by the
-- compiler before the change.
import Browser
import Html exposing (Html)
import Tea


type alias Child =
    a : Int
    b : Int
    c : Int


type ChildMsg
    = M1
    | M2
    | M3
    | M4
    | M5
    | M6


type alias Model =
    w1 : Child
    w2 : Child
    w3 : Child
    w4 : Child
    w5 : Child
    w6 : Child
    w7 : Child
    w8 : Child
    w9 : Child
    w10 : Child
    w11 : Child
    w12 : Child
    w13 : Child
    w14 : Child
    w15 : Child
    w16 : Child
    w17 : Child
    w18 : Child
    w19 : Child
    w20 : Child
    w21 : Child
    w22 : Child
    w23 : Child
    w24 : Child
    w25 : Child
    w26 : Child
    w27 : Child
    w28 : Child
    w29 : Child


type Msg
    = W1 ChildMsg
    | W2 ChildMsg
    | W3 ChildMsg
    | W4 ChildMsg
    | W5 ChildMsg
    | W6 ChildMsg
    | W7 ChildMsg
    | W8 ChildMsg
    | W9 ChildMsg
    | W10 ChildMsg
    | W11 ChildMsg
    | W12 ChildMsg
    | W13 ChildMsg
    | W14 ChildMsg
    | W15 ChildMsg
    | W16 ChildMsg
    | W17 ChildMsg
    | W18 ChildMsg
    | W19 ChildMsg
    | W20 ChildMsg
    | W21 ChildMsg
    | W22 ChildMsg
    | W23 ChildMsg
    | W24 ChildMsg
    | W25 ChildMsg
    | W26 ChildMsg
    | W27 ChildMsg
    | W28 ChildMsg
    | W29 ChildMsg


init : ⊤ → Model
init ⊤ =
    { w1 = { a = 0, b = 1, c = 2 }
    , w2 = { a = 0, b = 1, c = 2 }
    , w3 = { a = 0, b = 1, c = 2 }
    , w4 = { a = 0, b = 1, c = 2 }
    , w5 = { a = 0, b = 1, c = 2 }
    , w6 = { a = 0, b = 1, c = 2 }
    , w7 = { a = 0, b = 1, c = 2 }
