    , w9 = { a = 0, b = 1, c = 2 }
    , w10 = { a = 0, b = 1, c = 2 }
    , w11 = { a = 0, b = 1, c = 2 }
    , w12 = { a = 0, b = 1, c = 2 }
    , w13 = { a = 0, b = 1, c = 2 }
    , w14 = { a = 0, b = 1, c = 2 }
    , w15 = { a = 0, b = 1, c = 2 }
    , w16 = { a = 0, b = 1, c = 2 }
    , w17 = { a = 0, b = 1, c = 2 }
    , w18 = { a = 0, b = 1, c = 2 }
    , w19 = { a = 0, b = 1, c = 2 }
    , w20 = { a = 0, b = 1, c = 2 }
    , w21 = { a = 0, b = 1, c = 2 }
    , w22 = { a = 0, b = 1, c = 2 }
    , w23 = { a = 0, b = 1, c = 2 }
    , w24 = { a = 0, b = 1, c = 2 }
    , w25 = { a = 0, b = 1, c = 2 }
    , w26 = { a = 0, b = 1, c = 2 }
    , w27 = { a = 0, b = 1, c = 2 }
    , w28 = { a = 0, b = 1, c = 2 }
    , w29 = { a = 0, b = 1, c = 2 }
    }


update1 : ChildMsg, Child → Child
update1 msg child =
    case msg of
        M1 →
            { child | b = child.b + 101 }
        M2 →
            { child | c = child.c + 102 }
        M3 →
            { child | a = child.a + 103 }
        M4 →
            { child | b = child.b + 104 }
        M5 →
            { child | c = child.c + 105 }
        M6 →
            { child | a = child.a + 106 }


