view : Model → Html Msg
view model =
    <main>
        <section>
            <p>{model.w1.a} {model.w1.b} {model.w1.c}</p><button onClick={W1 M1}>1</button><button onClick={W1 M2}>2</button><button onClick={W1 M3}>3</button><button onClick={W1 M4}>4</button><button onClick={W1 M5}>5</button><button onClick={W1 M6}>6</button>
        </section>
        <section>
            <p>{model.w2.a} {model.w2.b} {model.w2.c}</p><button onClick={W2 M1}>1</button><button onClick={W2 M2}>2</button><button onClick={W2 M3}>3</button><button onClick={W2 M4}>4</button><button onClick={W2 M5}>5</button><button onClick={W2 M6}>6</button>
