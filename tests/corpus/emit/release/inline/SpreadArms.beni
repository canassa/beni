update : Msg, Model → Model
update msg model =
    case msg of
        W1 childMsg →
            { model | w1 = update1 childMsg model.w1 }
        W2 childMsg →
            { model | w2 = update2 childMsg model.w2 }
        W3 childMsg →
            { model | w3 = update3 childMsg model.w3 }
        W4 childMsg →
            { model | w4 = update4 childMsg model.w4 }
        W5 childMsg →
