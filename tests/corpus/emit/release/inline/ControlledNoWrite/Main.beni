-- A controlled input the program refuses to write (`docs/design/browser-
-- inline.md` §8.3, *Controlled inputs*; §8.4, amended 2026-10-22): `W2`'s
-- arm takes a venue of at most three letters and keeps the model otherwise,
-- so its handler is the program's. A refused value writes nothing, and the
-- pass runs the input's own bucket, which shows the model's venue again;
-- `W1`'s bucket does not run.
import Browser
import Html exposing (Html)
import Tea
import W1
import W2


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { w1 = W1.init ⊤, w2 = W2.init ⊤ }
            , update = update
            , view = view
            }
        )
        "root"


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            if accepts sub then { model | w2 = W2.update sub model.w2 } else model


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
        {Html.map (W2.view model.w2 model.w1) W2Msg}
    </div>


accepts : W2.Msg → Bool
accepts sub =
    case sub of
        W2.Write typed →
            String.length typed ≤ 3
