sum : Value, Bool → Int
sum v fresh =
    List.sum
        [ alpha v fresh
        , bravo v fresh
        , charlie v fresh
        , delta v fresh
        , echo v fresh
        , foxtrot v fresh
        , golf v fresh
        , hotel v fresh
        , india v fresh
        , juliet v fresh
        , kilo v fresh
        , lima v fresh
        , mike v fresh
        , november v fresh
        , oscar v fresh
        , papa v fresh
        , quebec v fresh
        , romeo v fresh
        , sierra v fresh
        , tango v fresh
        , uniform v fresh
        , victor v fresh
        ]


main : Node.Program
main =
    case Schema.parse Schema.value "{}" of
        Ok v →
            Node.print (String.fromInt (sum v (List.length (String.split "," "a,b") > 1)))

        Err _ →
            Node.print "not JSON"
