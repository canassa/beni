-- emit: whole-program specialisation of user code (`backend.md` §9,
-- *Whole-program specialisation*). Facts 1 and 2: every call of `pad`
-- passes `6`, so `width` is substituted and dropped, from `pad` and from
-- both calls, and the loop tests `>=6`; every call of `scale` passes `1`,
-- so `factor == 1` folds and `scale` is the identity, which is its
-- argument wherever it is called (slice 8); `clamp` is called
-- with `9` only, and `limit` is a constant nothing assigns, so its whole
-- `if` folds to `6`. Slice 2: nothing reads `limit` after that, so it is
-- not written; and `shout` is only ever called with `False`, so the arm
-- that calls `String.toUpper` goes, and with it the sibling's `toUpper`.
import Node exposing (Program)


limit : Int
limit =
    3


pad : Int, String -> String
pad width s =
    if String.length s >= width then
        s

    else
        pad width (s ++ ".")


scale : Int, Int -> Int
scale factor n =
    if factor == 1 then
        n

    else
        n * factor


clamp : Int -> Int
clamp n =
    if n > limit * 2 then
        limit * 2

    else
        n


shout : Bool, String -> String
shout loud s =
    if loud then
        String.toUpper s

    else
        s


main : Program
main =
    Node.printLines [ pad 6 "ab", pad 6 "abcdefgh", String.fromInt (scale 1 5), String.fromInt (scale 1 7), String.fromInt (clamp 9), shout False "quiet" ]
