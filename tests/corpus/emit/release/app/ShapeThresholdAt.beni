-- A program with 4 shape runs, `SchemaValid.shape_threshold`, so every run
-- takes its shape (`schema.md` §6, *How a program chooses between shapes and
-- workers*): `Schema.validShape` with each declaration's `$$shape`, and no
-- validator worker. `ShapeThresholdBelow` is this program with one fewer.
import Node
import Schema exposing (Value)


schema Alpha =
    alpha : Int
    count : Int


alphaValid : Value → Bool
alphaValid v =
    case Schema.read (Alpha.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


schema Bravo =
    bravo : String
    count : Int


bravoValid : Value → Bool
bravoValid v =
    case Schema.read (Bravo.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


schema Charlie =
    charlie : Bool
    count : Int


charlieValid : Value → Bool
charlieValid v =
    case Schema.read (Charlie.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


schema Delta =
    delta : Float
    count : Int


deltaValid : Value → Bool
deltaValid v =
    case Schema.read (Delta.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


checks : Value → List Bool
checks v = [ alphaValid v, bravoValid v, charlieValid v, deltaValid v ]


main : Node.Program
main =
    case Schema.parse Schema.value "{}" of
        Ok v →
            Node.print (String.fromInt (List.length (List.filter (checks v) λb → b)))

        Err _ →
            Node.print "not JSON"
