-- The release optimiser deletes a record field no read reaches, but only
-- while it can name every record literal a variable may hold: past
-- `Spec.Pts.max_sites` literals it assumes every field is read. `pick`'s
-- parameter holds sixty distinct literals here, and only `keep` is read, so
-- `unused` and `spare` must be gone from every one of them.
import Node


type alias Row =
    keep : Int
    unused : String
    spare : Int


pick : Row → Int
pick r = r.keep


main : Node.Program
main =
    Node.printLines
        [ String.fromInt
            (List.sum
                [ pick { keep = 0, unused = "u0", spare = 0 }
                , pick { keep = 1, unused = "u1", spare = 7 }
                , pick { keep = 2, unused = "u2", spare = 14 }
                , pick { keep = 3, unused = "u3", spare = 21 }
                , pick { keep = 4, unused = "u4", spare = 28 }
                , pick { keep = 5, unused = "u5", spare = 35 }
                , pick { keep = 6, unused = "u6", spare = 42 }
                , pick { keep = 7, unused = "u7", spare = 49 }
                , pick { keep = 8, unused = "u8", spare = 56 }
                , pick { keep = 9, unused = "u9", spare = 63 }
                , pick { keep = 10, unused = "u10", spare = 70 }
                , pick { keep = 11, unused = "u11", spare = 77 }
                , pick { keep = 12, unused = "u12", spare = 84 }
                , pick { keep = 13, unused = "u13", spare = 91 }
                , pick { keep = 14, unused = "u14", spare = 98 }
                , pick { keep = 15, unused = "u15", spare = 105 }
                , pick { keep = 16, unused = "u16", spare = 112 }
                , pick { keep = 17, unused = "u17", spare = 119 }
                , pick { keep = 18, unused = "u18", spare = 126 }
                , pick { keep = 19, unused = "u19", spare = 133 }
