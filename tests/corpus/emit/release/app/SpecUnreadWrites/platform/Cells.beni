--! Cells written and never read (`backend.md` §9, *A variable nothing
--! reads*), in the code only a platform may write: the shape of the fiber
--! runtime's `expired`.

import Js


-- Written by `expire`, read by nothing: its writes go, and then it does.
expired : Js.Ref Bool
expired = Js.ref False


-- Written with a value that calls the host: the write goes, the call stays.
stamped : Js.Ref Float
stamped = Js.ref 0


-- Read: every write of it stays.
count : Js.Ref Int
count = Js.ref 0


expire : ⊤ → ⊤
expire ⊤ = Js.write expired True


pub tick : String → Int
tick label =
    expire ⊤
    Js.write stamped (Js.to (Js.call (Js.global "Date") "now" []))
    Js.write count (Js.read count + String.length label)

    -- A cell of its own that nothing reads: a `let`, written and gone.
    scratch = Js.ref 0
    Js.write scratch (String.length label)
    Js.read count
