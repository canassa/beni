-- emit: a top-level binding whose initialiser is a field read keeps the
-- lambda it holds (`backend.md` §9, *Slice 8*, amended 2026-10-15, *A
-- record field's lambda*). `app.step n` is the one call of the lambda,
-- but `picked = ops.fn` reads it through a field, and a place holding a
-- field read is not one that only holds the value it is (`soleCalls`), so
-- the lambda is not written at the call: there its body would be in the
-- output two times, and the call stays. Since 2026-10-18 the field read
-- is inert (§9, *A field read of a beni value is pure*), so `picked`
-- itself is written at its one use, the lambda still once.
import Node exposing (Program)


type alias Count =
    count : Int
    label : String
    twice : Int


type alias Ops =
    fn : Int → Count
    name : String


type alias App =
    step : Int → Count
    tag : Int


ops : Ops
ops =
    { fn = λk → { count = k * 10 + 7, label = "value " ++ String.fromInt k, twice = k + k }
    , name = "ab"
    }


picked : Int → Count
picked = ops.fn


run : App, Int → List String
run app n =
    v = app.step n
    [ String.fromInt v.count, v.label, String.fromInt v.twice, String.fromInt app.tag ]


main : Program
main = Node.printLines (run { step = picked, tag = String.length ops.name } (String.length "abcde"))
