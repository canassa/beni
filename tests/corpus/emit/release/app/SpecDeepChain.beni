f21 : Int → Int
f21 x =
    if x * 3 > 1000 then
        x
    else
        f22 x * 2 + f22 x


f22 : Int → Int
f22 x =
    if x * 3 > 1000 then
        x
    else
        f23 x * 2 + f23 x


f23 : Int → Int
f23 x =
    if x * 3 > 1000 then
        x
    else
        f24 x * 2 + f24 x


f24 : Int → Int
f24 x =
    if x * 3 > 1000 then
        x
    else
        x + 1


main : Program
main = Node.print (String.fromInt (f1 7))
