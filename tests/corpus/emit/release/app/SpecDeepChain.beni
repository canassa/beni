f16 : Int → Int
f16 x =
    if x * 3 > 1000 then
        x
    else
        f17 x * 2 + f17 x


f17 : Int → Int
f17 x =
    if x * 3 > 1000 then
        x
    else
        f18 x * 2 + f18 x


f18 : Int → Int
f18 x =
