f14 : Int → Int
f14 x =
    if x * 3 > 1000 then
        x
    else
        f15 x * 2 + f15 x


f15 : Int → Int
f15 x =
    if x * 3 > 1000 then
        x
    else
        f16 x * 2 + f16 x


f16 : Int → Int
f16 x =
    if x * 3 > 1000 then
        x
    else
        f17 x * 2 + f17 x


f17 : Int → Int
f17 x =
    if x * 3 > 1000 then
        x
    else
        f18 x * 2 + f18 x


f18 : Int → Int
f18 x =
    if x * 3 > 1000 then
        x
    else
        f19 x * 2 + f19 x


f19 : Int → Int
f19 x =
    if x * 3 > 1000 then
