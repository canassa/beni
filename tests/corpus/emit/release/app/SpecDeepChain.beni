-- emit: a chain of 24 functions, each passing its own parameter on to the
-- next (research 52, E1), pinned at what the release specialiser writes
-- today. `main` calls `f1 7`, so every `x` is `7` and every test
-- `x * 3 > 1000` is `false` — but fact 1 runs from caller to callee and the
-- sweeps walk the program in the order it is written, callee first, so each
-- level of the chain costs a sweep, and 24 levels reach the cap of 24
-- sweeps. A round that does not converge rewrites nothing, so nothing is
-- specialised anywhere, not even `7 * 3 > 1000` in `main`. With 23
-- functions every parameter folds and goes. A worklist of facts rather than
-- of ordered sweeps has no such cap (research 52 §4, slices 4–6), and this
-- golden then moves.
import Node exposing (Program)


f1 : Int → Int
f1 x =
    if x * 3 > 1000 then
        x
    else
        f2 x * 2 + f2 x


f2 : Int → Int
f2 x =
    if x * 3 > 1000 then
        x
    else
        f3 x * 2 + f3 x


f3 : Int → Int
f3 x =
    if x * 3 > 1000 then
        x
    else
        f4 x * 2 + f4 x


