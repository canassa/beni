-- A program with 24 shape runs, one below `SchemaValid.shape_threshold`
-- (25), so every run keeps its compiled validator worker (`schema.md` §6, *How a
-- program chooses between shapes and workers*): each declaration's
-- `$$readValid` called where its run stands, and no `validShape`. `ShapeThresholdAt` is this
-- program with a twenty-fifth.
import Node
import Schema exposing (Value)


schema Alpha =
    alpha : Int
    count : Int


alphaValid : Value → Bool
alphaValid v =
    case Schema.read (Alpha.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


