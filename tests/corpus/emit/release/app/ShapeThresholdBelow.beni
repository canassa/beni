-- A program with 3 shape runs, one below `SchemaValid.shape_threshold`
-- (4), so every run keeps its compiled validator worker (`schema.md` §6, *How a
-- program chooses between shapes and workers*): `Schema.validRun` with each
-- declaration's `$$readValid`, and no `validShape`. `ShapeThresholdAt` is this
-- program with a fourth.
import Node
import Schema exposing (Value)


schema Alpha =
    alpha : Int
    count : Int


alphaValid : Value → Bool
alphaValid v =
    case Schema.read (Alpha.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


schema Bravo =
    bravo : String
    count : Int


bravoValid : Value → Bool
bravoValid v =
    case Schema.read (Bravo.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


schema Charlie =
    charlie : Bool
    count : Int


charlieValid : Value → Bool
charlieValid v =
    case Schema.read (Charlie.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


checks : Value → List Bool
checks v = [ alphaValid v, bravoValid v, charlieValid v ]


main : Node.Program
main =
    case Schema.parse Schema.value "{}" of
        Ok v →
            Node.print (String.fromInt (List.length (List.filter (checks v) λb → b)))

        Err _ →
            Node.print "not JSON"
