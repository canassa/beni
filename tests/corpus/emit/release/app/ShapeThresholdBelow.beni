checks : Value → List Bool
checks v =
    [ alphaValid v
    , bravoValid v
    , charlieValid v
    , deltaValid v
    , echoValid v
    , foxtrotValid v
    , golfValid v
    , hotelValid v
    , indiaValid v
    , julietValid v
    , kiloValid v
    , limaValid v
    , mikeValid v
    , novemberValid v
    , oscarValid v
    , papaValid v
    , quebecValid v
    , romeoValid v
    , sierraValid v
    , tangoValid v
    , uniformValid v
    , victorValid v
    , whiskeyValid v
    , xrayValid v
    ]


main : Node.Program
main =
    case Schema.parse Schema.value "{}" of
        Ok v →
            Node.print (String.fromInt (List.length (List.filter (checks v) λb → b)))

        Err _ →
            Node.print "not JSON"
