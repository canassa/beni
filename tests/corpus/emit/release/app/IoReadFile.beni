-- `Io.run` and `Io.readFile` under `--release`: the typed Node.Program
-- reaches the typed entry runtime, and generated NodeProcess/NodeFs recipes
-- write its output and read the file. Rejections are classified through
-- native error bindings; no Program or callback passes through Js.Value.
import Io
import Node exposing (Program)


describe : Io.FileError → String
describe failure =
    case failure of
        Io.NotFound →
            "not found"

        Io.PermissionDenied →
            "permission denied"

        _ →
            "other"


main : Program
main = Io.run λ⊤ →
    case Io.readFile "notes.txt" of
        Ok text →
            Node.print text

        Err failure →
            Node.exitWith (describe failure) 2
