-- The module that declares an alias of its sibling's export: in its own
-- `viaAlias` the lambda stays, since `Opt` walks the alias to the import.
import Js


foreign pure counted : Int → Int


pub countedAlias : Int → Int
countedAlias = counted


pub viaAlias : List Int → List Int
viaAlias xs = hostMap xs λx → countedAlias x


-- The host still supplies index and array extras to the typed callback.
foreign impure hostMap : List a, sync (a → b) → List b
