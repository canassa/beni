-- emit: whole-program specialisation, unused trailing arguments
-- (`backend.md` §9, *Whole-program specialisation*, amended 2026-10-02):
-- `total` calls `op.apply` through the field, which holds `double` or
-- `triple` — functions of the program, neither of which reads its second
-- parameter — so the call passes it nothing: its `0` goes, and the
-- functions keep their parameters. `op.merge` holds `add`, which reads
-- both, or `left`, which reads one: its call keeps both arguments.
import Node exposing (Program)


type alias Op =
    name : String
    apply : Int, Int -> Int
    merge : Int, Int -> Int


double : Int, Int -> Int
double n _ = n * 2


triple : Int, Int -> Int
triple n _ = n * 3


add : Int, Int -> Int
add a b = a + b


left : Int, Int -> Int
left a _ = a


total : Op, List Int -> String
total op xs =
    sum = List.foldl xs 0 λx acc -> op.merge acc (op.apply x 0)
    "${op.name}: ${String.fromInt sum}"


main : Program
main =
    Node.printLines
        [ total { name = "double", apply = double, merge = add } [ 1, 2, 3 ]
        , total { name = "triple", apply = triple, merge = left } [ 4, 5 ]
        ]
