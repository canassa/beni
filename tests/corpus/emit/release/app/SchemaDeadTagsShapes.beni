-- `SchemaDeadTags` with 29 shape runs and more (`SchemaValid.shape_threshold`):
-- a dead tag is no row of its union's shape, and the `case` has no arm for
-- it (`schema.md` §6, amended 2026-10-24).
import Node
import Schema exposing (Value)


schema Event tagged "type" of
    Set as "set"
        value : Int
    Ping as "ping"
    Note as "note"
        text : String
    Bump as "bump"
        by : Int


step : Value, Int → Int
step v n =
    case Schema.read (Event.schema ⊤) v of
        Ok (Event.Set s) →
            s.value

        Ok Event.Ping →
            n

        Ok (Event.Note _) →
            n

        Ok (Event.Bump b) →
            n + b.by

        Err _ →
            n


schema Signal tagged "kind" of
    Loud as "loud"
        level : Int
    Quiet as "quiet"


level : Value, Int → Int
level v n =
    case Schema.read (Signal.schema ⊤) v of
        Ok (Signal.Loud l) →
            l.level

        Ok Signal.Quiet →
            0

        Err _ →
            n


line : String → String
line text =
    case Schema.parse Schema.value text of
        Ok v →
            "${String.fromInt (step v 7)} ${String.fromInt (level v 7)} ${String.fromInt (filler1 v + filler2 v + filler3 v + filler4 v + filler5 v + filler6 v + filler7 v + filler8 v + filler9 v + filler10 v + filler11 v + filler12 v + filler13 v + filler14 v + filler15 v + filler16 v + filler17 v + filler18 v + filler19 v + filler20 v + filler21 v + filler22 v + filler23 v + filler24 v + filler25 v + filler26 v + filler27 v + filler28 v + 0)}"

        Err _ →
            "not JSON"


main : Node.Program
main = Node.print (line "{\"type\": \"ping\"}")


