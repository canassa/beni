-- emit: a fact a branch hides from itself (research 52, E2). `go` is only
-- ever called with `False`, and its `verbose` arm passes `True` to its own
-- `verbose`. That arm is dead, because `verbose` is `False`. The release
-- specialiser follows only the arms a test can take (`backend.md` §9,
-- *Executability*), so the dead call passes nothing and `verbose` stays
-- `False`. `go` therefore folds as `quiet` does, to its `else`, and loses
-- its parameter. Before slice 6 the facts analysed both arms of every `if`,
-- `verbose` was ⊤, and `go` kept the arm.
import Node exposing (Program)


go : Bool, Int → Int
go verbose n =
    if n ≤ 0 then
        0
    else if verbose then
        100 + go True (n - 1)
    else
        1 + go verbose (n - 1)


quiet : Bool, Int → Int
quiet verbose n =
    if n ≤ 0 then
        0
    else if verbose then
        100 + quiet verbose (n - 1)
    else
        1 + quiet verbose (n - 1)


main : Program
main =
    Node.printLines
        [ String.fromInt (go False 10)
        , String.fromInt (quiet False 10)
        ]
