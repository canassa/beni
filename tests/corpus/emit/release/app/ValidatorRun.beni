-- A `read` whose `Err` payload nothing reads is a validator (`schema.md`
-- §6, *A run whose failure is never read is a validator*), and with its
-- schema written `S.schema ⊤` of a nongeneric declaration the run calls the
-- declaration's validator worker directly (`s` here): it makes no issue,
-- writes no message and builds no schema value. The messages the file still
-- holds are `Schema.parse Schema.value`'s, which reads its text into a
-- `Value`: a `parse` is not compiled to a validator yet. `run/SchemaValidator`
-- proves the answers.
import Node
import Schema exposing (Value)


schema Event tagged "type" of
    Set as "set"
        value : Int
    Reset as "reset"


classify : Value → String
classify v =
    case Schema.read (Event.schema ⊤) v of
        Ok (Event.Set event) →
            "set " ++ String.fromInt event.value

        Ok Event.Reset →
            "reset"

        Err _ →
            "invalid"


line : String → String
line text =
    case Schema.parse Schema.value text of
        Ok v →
            classify v

        Err _ →
            "not JSON"


main : Node.Program
main = Node.print (line "{\"type\": \"set\", \"value\": 3}")
