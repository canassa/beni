-- A `read` whose `Err` payload nothing reads is a shape run (`schema.md` §6,
-- *A validator run is a shape that one shared validator reads*): its
-- schema, `S.schema ⊤` of a nongeneric declaration with a shape, is the
-- constant `Event$$shape`, and the run calls the shared `Schema.validShape`
-- with it. It makes no issue, writes no message, builds no schema value and
-- ships no worker of `Event`. The messages the file still holds are
-- `Schema.parse Schema.value`'s, which reads its text into a `Value` and
-- whose schema is no declaration. `run/SchemaValidator` proves the answers;
-- `ValidatorWorker` is this program with a `via`, which has no shape.
import Node
import Schema exposing (Value)


schema Event tagged "type" of
    Set as "set"
        value : Int
    Reset as "reset"


classify : Value → String
classify v =
    case Schema.read (Event.schema ⊤) v of
        Ok (Event.Set event) →
            "set " ++ String.fromInt event.value

        Ok Event.Reset →
            "reset"

        Err _ →
            "invalid"


line : String → String
line text =
    case Schema.parse Schema.value text of
        Ok v →
            classify v

        Err _ →
            "not JSON"


main : Node.Program
main = Node.print (line "{\"type\": \"set\", \"value\": 3}")
