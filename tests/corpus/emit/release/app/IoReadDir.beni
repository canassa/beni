-- `Io.readDir` under `--release` once `Io.js` is gone
-- (plans/runtime-in-beni.md step 14): `startReadDir` asks `process` for
-- `node:fs/promises` and calls `readdir` with `withFileTypes`; the
-- fulfilment maps each entry to an `Entry` and sorts by name, the
-- rejection handler reads the code table by its own keys and throws
-- anything else; `Result`, `Entry` and `EntryKind` are no longer pinned
-- by a `foreign` annotation, so they carry integer tags and short names,
-- while `FileError` keeps its strings.
import Io
import Node exposing (Program)


describe : Io.Entry → String
describe entry =
    case entry.kind of
        Io.Directory →
            "${entry.name}/"

        _ →
            entry.name


main : Program
main = Io.run λ⊤ →
    case Io.readDir "." of
        Ok entries →
            Node.printLines (List.map entries describe)

        Err _ →
            Node.exitWith "cannot list" 2
