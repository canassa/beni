-- emit/app: a program that only describes ships no worker and no builder
-- (`docs/design/schema.md` §6, *DCE*; *What `describe` ships*).
--
-- `Tree.schema ⊤` reaches the description alone: the node §5's builders
-- would make, made by `core/Schema`'s `described…` values without boxing,
-- under `describedRecursive "Tree"` because `Tree` refers to itself, one
-- mapping per record and one injection per variant, both endpoints', written
-- as arrows over §4's representation. No `$$read`, no `$$write`, no `box`.
import Node exposing (Program)
import Schema


schema Tree tagged "kind" of
    Leaf as "leaf"
        value : Int
    Branch as "branch"
        children : List Tree


main : Program
main =
    Node.printLines
        [ case (Schema.describe (Tree.schema ⊤)).root of
            Schema.Reference _ →
                "a reference"

            _ →
                "something else"
        ]
