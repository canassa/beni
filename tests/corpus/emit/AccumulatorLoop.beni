-- emit: the SHAPE of an accumulator loop (`docs/design/backend.md` §8,
-- *Accumulators build a plain array*), which running cannot observe.
--
-- The golden pins, in `prepend`: `const $acc = []` before the loop, the
-- accumulator's parameter keeping its own name and never assigned, one
-- `$acc.push(h)` per step and no `List$cons`, and the exit's
-- `List$close($acc.reverse(), acc)`. `two` pushes two heads in one step,
-- the second first, after binding both where a head may print. `append`
-- pushes `[ …acc, x ]`'s heads in order and exits with
-- `List$append(acc, $acc)`. `tupled` returns the accumulator inside a
-- tuple, as the table app's `buildFrom` does. `reads` is the control: a
-- loop that also reads its accumulator keeps its `List$cons`.
import Node exposing (Program)


pub prepend : Int, List Int → List Int
prepend n acc = if n ≤ 0 then acc else prepend (n - 1) [ n, …acc ]


pub two : Int, List Int → List Int
two n acc = if n ≤ 0 then acc else two (n - 1) [ Debug.log "a" n, Debug.log "b" n, …acc ]


pub append : Int, List Int → List Int
append n acc = if n ≤ 0 then acc else append (n - 1) [ …acc, n ]


pub tupled : Int, List Int → List Int × Int
tupled n acc = if n ≤ 0 then ( acc, n ) else tupled (n - 1) [ n, …acc ]


pub reads : Int, List Int → List Int
reads n acc = if List.length acc ≥ n then acc else reads n [ n, …acc ]


main : Program
main = Node.printLines []
