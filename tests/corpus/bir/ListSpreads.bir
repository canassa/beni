  %2 = pat_var local 1 (first)
  %3 = pat_var local 2 (middle)
  %4 = pat_spread ...%3
  %5 = pat_var local 3 (last)
  %6 = pat_list [%2, %4, %5]
  %7 = local 2 (middle)
  %8 = branch %6 -> %7
  %9 = pat_wild
  %10 = local 0 (xs)
  %11 = branch %9 -> %10
  %12 = case %1 [%8, %11]
  params [%0]
  body %12
  locals
    0 xs param %0
    1 first pattern %2
    2 middle pattern %3
    3 last pattern %5

