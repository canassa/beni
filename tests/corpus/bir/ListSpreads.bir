  %1 = pat_var local 1 (xs)
  %2 = local 0 (x)
  %3 = local 1 (xs)
  %4 = import_value List.cons
  %5 = call %4 [%2, %3]
  params [%0, %1]
  body %5
  locals
    0 x param %0
    1 xs param %1
  refs
    import_value List.cons

