decl 0: value greet (annotated)
  %0 = type_import String.String
  %1 = type_import Basics.Int
  %2 = type_import String.String
  %3 = type_fn [%0, %1] -> %2
  %4 = pat_var local 0 (name)
  %5 = pat_var local 1 (n)
  %6 = chunk "hello "
  %7 = local 0 (name)
  %8 = chunk ", "
  %9 = local 1 (n)
  %10 = chunk " new"
  %11 = interp [%6, %7, %8, %9, %10]
  annotation %3
  params [%4, %5]
  body %11
  locals
    0 name param %4
    1 n param %5
  refs
    import_type String.String
    import_type Basics.Int

decl 1: value adjacent (annotated)
  %0 = type_import Basics.Int
  %1 = type_import Basics.Int
  %2 = type_import String.String
  %3 = type_fn [%0, %1] -> %2
  %4 = pat_var local 0 (a)
  %5 = pat_var local 1 (b)
  %6 = local 0 (a)
  %7 = local 1 (b)
  %8 = interp [%6, %7]
  annotation %3
  params [%4, %5]
  body %8
  locals
    0 a param %4
    1 b param %5
  refs
    import_type Basics.Int
    import_type String.String

decl 2: value only (annotated)
  %0 = type_import Basics.Int
  %1 = type_import String.String
  %2 = type_fn [%0] -> %1
  %3 = pat_var local 0 (a)
  %4 = local 0 (a)
  %5 = interp [%4]
  annotation %2
  params [%3]
  body %5
  locals
    0 a param %3
  refs
    import_type Basics.Int
    import_type String.String

decl 3: value escaped (annotated)
  %0 = type_import Basics.Int
  %1 = type_import String.String
  %2 = type_fn [%0] -> %1
  %3 = pat_var local 0 (a)
  %4 = chunk "\t"
  %5 = local 0 (a)
  %6 = int 1
  %7 = import_value Basics.add
  %8 = call %7 [%5, %6]
  %9 = chunk "\n$"
  %10 = interp [%4, %8, %9]
  annotation %2
  params [%3]
  body %10
  locals
    0 a param %3
  refs
    import_type Basics.Int
    import_type String.String
    import_value Basics.add

decl 4: value plain (annotated)
  %0 = type_import String.String
  %1 = string "no interpolation"
  annotation %0
  params []
  body %1
  refs
    import_type String.String

interface

imports
  prelude Basics
  prelude List
  prelude Maybe
  prelude Result
  prelude String
  prelude Char
  prelude Debug
