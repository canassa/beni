decl 0: value greet (annotated)
  %0 = type_import Basics.String
  %1 = type_import Basics.Int
  %2 = type_import Basics.String
  %3 = type_fn %1 -> %2
  %4 = type_fn %0 -> %3
  %5 = pat_var local 0 (name)
  %6 = pat_var local 1 (n)
  %7 = chunk "hello "
  %8 = local 0 (name)
  %9 = chunk ", "
  %10 = local 1 (n)
  %11 = chunk " new"
  %12 = interp [%7, %8, %9, %10, %11]
  annotation %4
  params [%5, %6]
  body %12
  locals
    0 name param %5
    1 n param %6
  refs
    import_type Basics.String
    import_type Basics.Int

decl 1: value adjacent (annotated)
  %0 = type_import Basics.Int
  %1 = type_import Basics.Int
  %2 = type_import Basics.String
  %3 = type_fn %1 -> %2
  %4 = type_fn %0 -> %3
  %5 = pat_var local 0 (a)
  %6 = pat_var local 1 (b)
  %7 = local 0 (a)
  %8 = local 1 (b)
  %9 = interp [%7, %8]
  annotation %4
  params [%5, %6]
  body %9
  locals
    0 a param %5
    1 b param %6
  refs
    import_type Basics.Int
    import_type Basics.String

decl 2: value only (annotated)
  %0 = type_import Basics.Int
  %1 = type_import Basics.String
  %2 = type_fn %0 -> %1
  %3 = pat_var local 0 (a)
  %4 = local 0 (a)
  %5 = interp [%4]
  annotation %2
  params [%3]
  body %5
  locals
    0 a param %3
  refs
    import_type Basics.Int
    import_type Basics.String

decl 3: value escaped (annotated)
  %0 = type_import Basics.Int
  %1 = type_import Basics.String
  %2 = type_fn %0 -> %1
  %3 = pat_var local 0 (a)
  %4 = chunk "\t"
  %5 = local 0 (a)
  %6 = int 1
  %7 = import_value Basics.add
  %8 = call %7 [%5, %6]
  %9 = chunk "\n$"
  %10 = interp [%4, %8, %9]
  annotation %2
  params [%3]
  body %10
  locals
    0 a param %3
  refs
    import_type Basics.Int
    import_type Basics.String
    import_value Basics.add

decl 4: value plain (annotated)
  %0 = type_import Basics.String
  %1 = string "no interpolation"
  annotation %0
  params []
  body %1
  refs
    import_type Basics.String

interface

imports
  prelude Basics
  prelude List
  prelude Maybe
  prelude Result
  prelude String
  prelude Char
  prelude Debug
