-- BIR: a `where` constraint's type is its own scope for the `equatable`
-- marker (checker.md Appendix A, static-dispatch-spike.md §2.1). The marker
-- is legal at a variable's FIRST occurrence, and `a`'s occurrences in the
-- annotated type are not the clause's — nor is one constraint's occurrence
-- the next constraint's. Core only, like every `equatable` marker.
pub foreign pure sorted : List a → List a
    where a.compare : equatable a, a → Order


pub foreign pure paired : List a, List b → Bool
    where
        a.eq : equatable a, a → Bool
        , b.eq : equatable b, b → Bool
