decl 0: pub foreign type Html
  type params msg
  interface foreign type Html

decl 1: pub foreign type Event
  interface foreign type Event

decl 2: pub element "input"
  facts void
  interface element "input"

decl 3: pub attribute "value"
  %0 = type_import String.String
  facts property stateful on "input" on "select"
  annotation %0
  refs
    import_type String.String
  interface attribute "value"

decl 4: pub attribute "data-*"
  %0 = type_import String.String
  annotation %0
  refs
    import_type String.String
  interface attribute "data-*"

decl 5: pub event "onInput"
  %0 = type_import String.String
  facts delegated via targetValue
  annotation %0
  refs
    import_type String.String
  interface event "onInput"

decl 6: pub markup map
  %0 = type_top 0 (Html)
  %1 = type_var a
  %2 = type_app %0 [%1]
  %3 = type_var a
  %4 = type_var b
  %5 = type_fn [%3] -> %4
  %6 = type_top 0 (Html)
  %7 = type_var b
  %8 = type_app %6 [%7]
  %9 = type_fn [%2, %5] -> %8
  annotation %9
  refs
    type_top 0 (Html)
  interface markup map

decl 7: foreign value pure targetValue
  %0 = type_top 1 (Event)
  %1 = type_import String.String
  %2 = type_fn [%0] -> %1
  annotation %2
  refs
    type_top 1 (Event)
    import_type String.String

interface
  foreign type Html
  foreign type Event
  element "input"
  attribute "value"
  attribute "data-*"
  event "onInput"
  markup map

