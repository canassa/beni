-- BIR: `e?` desugars into a `case` on a fresh local (§6.6, §8.2): the Ok
-- branch continues with the value, the Err branch returns from the
-- enclosing named function. In Result position; the shape is identical for
-- Maybe (see QuestionMaybe). Also `?` on an application and chained twice.
parse : String -> Result String Int
parse s =
    Result.fromMaybe "nan" (String.toInt s)


both : String -> String -> Result String Int
both a b =
    Ok (parse a? + parse b?)


nested : Result String (Result String Int) -> Result String Int
nested r =
    Ok (r??)


inLet : String -> Result String Int
inLet s =
    let
        twice t =
            Ok (parse t? * 2)
    in
    twice s
