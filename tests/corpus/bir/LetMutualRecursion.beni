-- BIR: all bindings of a `let` are in scope in every body and in the `in`
-- expression (§7), so `even` and `odd` resolve to each other as locals
-- regardless of order, and a binding may reference a later constant.
isEven : Int -> Bool
isEven n =
    let
        even k =
            if k == base then
                True
            else
                odd (k - 1)

        odd k =
            if k == base then
                False
            else
                even (k - 1)

        base =
            0
    in
    even n
