-- BIR: an accessor function `.field` lowers to a one-parameter lambda whose
-- body is a field-access node (§8.2); field access `r.a.b` and tuple index
-- `t.0` stay as nodes.
names : List { name : String } -> List String
names people =
    List.map people .name


nestedAccess : { a : { b : Int } } -> Int
nestedAccess r =
    r.a.b


first : ( Int, String ) -> Int
first t =
    t.0


appliedAccessors : { address : { city : String } } -> String
appliedAccessors r =
    .city (.address r)
