-- BIR: `|>` and `<|` rewrite into direct application, so a pipeline becomes
-- saturated calls (§8.2, the one place the front end changes a call's
-- argument list). `|>` is pipe-first: the left operand becomes the callee's
-- FIRST argument, so `xs |> List.map f` is `List.map xs f`. A bare callee
-- takes it as its only argument, grouping parentheses around the callee are
-- looked through, and a chain is left-associative. `<|` inserts at the other
-- end and is right-associative: `f a <| x` is `f a x`.
firstArgument : List Int → List Int
firstArgument xs = xs ▷ List.map double


bareCallee : List Int → Int
bareCallee xs = xs ▷ List.sum


throughParens : List Int → List Int
throughParens xs = xs ▷ (List.map double)


chain : List Int → Int
chain xs =
    xs
        ▷ List.map double
        ▷ List.filter big
        ▷ List.sum


applyLeft : Int → String
applyLeft n = String.fromInt ◁ n + 1


applyLeftNested : (Int → Int), Int → Int
applyLeftNested f x = f ◁ f ◁ x


double : Int → Int
double n = n * 2


big : Int → Bool
big n = n > 10
