-- BIR: `qualified_lower` and `qualified_upper` resolve their module part
-- through the import aliases to `qualified(alias -> module, name)`: a full
-- path used as its own alias, an explicit `as` alias, and a qualified
-- constructor in expression and pattern position (§6.2).
import Http
import Json.Decode
import Json.Encode as E


decoder : Json.Decode.Decoder Int
decoder = Json.Decode.int


encode : Int -> E.Value
encode n = E.int n


isTimeout : Http.Error -> Bool
isTimeout err =
    case err of
        Http.Timeout ->
            True

        _ ->
            False


timeout : Http.Error
timeout = Http.Timeout
