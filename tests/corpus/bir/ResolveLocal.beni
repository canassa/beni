-- BIR: every kind of local binding resolves to `local(index)` (§8.1):
-- function parameters, lambda parameters, `let` definitions, `let` pattern
-- variables, and `case` pattern variables; the innermost wins over
-- top-level names that are NOT otherwise in scope here.
f : Int, ( Int, Int ), Maybe Int -> Int
f a ( b, c ) m =
    let
        d = a + b
        ( g, h ) = ( c, d )
    in
    case m of
        Just n ->
            (\k -> k + n + g + h) d

        Nothing ->
            0
