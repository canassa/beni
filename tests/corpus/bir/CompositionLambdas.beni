-- BIR: `>>` and `<<` desugar into one-parameter lambdas (§8.2): `f >> g`
-- -> `\x -> g (f x)`, `f << g` -> `\x -> f (g x)`; a chain of three and a
-- composition applied immediately.
forward : String -> String
forward =
    String.trim >> String.toUpper >> String.reverse


backward : String -> String
backward =
    String.reverse << String.toUpper << String.trim


applied : Int -> Int
applied n =
    ((+) 1 >> (*) 2) n
