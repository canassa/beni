-- BIR: string interpolation lowers to an `interp` node listing chunks and
-- expressions in order (§8.2): a chunk-expr-chunk string, adjacent
-- expressions, an expression-only string, a string with escapes around the
-- interpolation, and a plain string that stays a literal.
greet : String, Int -> String
greet name n =
    "hello ${name}, ${n} new"


adjacent : Int, Int -> String
adjacent a b =
    "${a}${b}"


only : Int -> String
only a =
    "${a}"


escaped : Int -> String
escaped a =
    "\t${a + 1}\n\$"


plain : String
plain =
    "no interpolation"
