-- BIR: `_` lowers to a lambda over the innermost enclosing application
-- (§8.2): `f a _ c` -> `\x -> f a x c`, with a fresh local for the
-- parameter. A nested `_` belongs to the inner call, a placeholder may fill
-- the first position, and the lambda wraps the whole call, so everything
-- else in it is lowered inside the lambda.
addOne : List Int -> List Int
addOne xs =
    List.map (add 1 _) xs


firstPosition : Int -> Int
firstPosition n =
    apply (subtract _ n)


nested : Int -> Int
nested n =
    outer (inner _) n


add : Int, Int -> Int
add a b =
    a + b


subtract : Int, Int -> Int
subtract a b =
    a - b


apply : (Int -> Int) -> Int
apply f =
    f 1


outer : (Int -> Int), Int -> Int
outer f n =
    f n


inner : Int -> Int
inner n =
    n
