[{"code":"unclosed_delimiter","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupCommentSwallowsBrace.beni","start":{"line":8,"col":8},"end":{"line":8,"col":9}},"title":"UNCLOSED DELIMITER","message":"This `{` is never closed: the comment after it, `-- note}`, runs to the end of\nthe line, and the `}` on that line is part of the comment.\n\nA comment inside markup ends where its line ends, so a `{…}` that holds only a\ncomment closes on the next line:\n\n    {-- note\n    }"}]
