[{"code":"operator_not_a_function","severity":"error","span":{"file":"tests/corpus/parse/bad/OperatorNotAFunction.beni","start":{"line":6,"col":6},"end":{"line":6,"col":8}},"title":"OPERATOR IS NOT A FUNCTION","message":"I found `(|>)`, but `|>` is not a function.\n\n`(+)`, `(::)` and the rest name the 2-ary function the operator desugars to. `|>`\nand `<|` desugar to nothing: they rearrange the call they are written in — `x |> f a`\nis `f x a` and `f <| x` is `f x` — so there is no function to pass around. Write the\nlambda you meant, or name the argument."},{"code":"operator_not_a_function","severity":"error","span":{"file":"tests/corpus/parse/bad/OperatorNotAFunction.beni","start":{"line":10,"col":6},"end":{"line":10,"col":8}},"title":"OPERATOR IS NOT A FUNCTION","message":"I found `(<|)`, but `<|` is not a function.\n\n`(+)`, `(::)` and the rest name the 2-ary function the operator desugars to. `|>`\nand `<|` desugar to nothing: they rearrange the call they are written in — `x |> f a`\nis `f x a` and `f <| x` is `f x` — so there is no function to pass around. Write the\nlambda you meant, or name the argument."},{"code":"operator_not_a_function","severity":"error","span":{"file":"tests/corpus/parse/bad/OperatorNotAFunction.beni","start":{"line":14,"col":22},"end":{"line":14,"col":24}},"title":"OPERATOR IS NOT A FUNCTION","message":"I found `(|>)`, but `|>` is not a function.\n\n`(+)`, `(::)` and the rest name the 2-ary function the operator desugars to. `|>`\nand `<|` desugar to nothing: they rearrange the call they are written in — `x |> f a`\nis `f x a` and `f <| x` is `f x` — so there is no function to pass around. Write the\nlambda you meant, or name the argument."}]
