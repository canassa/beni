[{"code":"invalid_char_literal","severity":"error","span":{"file":"tests/corpus/parse/bad/InvalidCharLiteral.beni","start":{"line":4,"col":5},"end":{"line":4,"col":7}},"title":"INVALID CHAR LITERAL","message":"I found an empty character literal `''`.\n\nA character literal holds exactly one character: `'a'`, `'\\n'`, `'\\u{1F600}'`."},{"code":"invalid_char_literal","severity":"error","span":{"file":"tests/corpus/parse/bad/InvalidCharLiteral.beni","start":{"line":8,"col":5},"end":{"line":8,"col":9}},"title":"INVALID CHAR LITERAL","message":"I found the character literal `'ab'`, which holds more than one character.\n\nA character literal holds exactly one character: `'a'`, `'\\n'`, `'\\u{1F600}'`.\nFor text, use a string: `\"…\"`."}]
