[{"code":"args_after_question","severity":"error","span":{"file":"tests/corpus/parse/bad/ArgsAfterQuestion.beni","start":{"line":8,"col":10},"end":{"line":8,"col":11}},"title":"ARGUMENTS AFTER QUESTION MARK","message":"I found the argument `b` after a `?`.\n\nAfter `?` no further arguments may follow: `f a? b` reads as `(f a)? b`, which\nis not an application. To pass `a?` as one argument among others, write\n`f (a?) b`."}]
