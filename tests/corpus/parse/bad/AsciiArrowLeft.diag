[{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiArrowLeft.beni","start":{"line":9,"col":7},"end":{"line":9,"col":9}},"title":"REMOVED ASCII SYMBOL","message":"`<-` is written `←` now (U+2190 LEFTWARDS ARROW).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `<-` into `←` as it is typed.\n\nIf you meant less than a negative number, write `x < -1`, with a space."}]
