[{"code":"cons_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/ConsRemoved.beni","start":{"line":8,"col":7},"end":{"line":8,"col":9}},"title":"REMOVED OPERATOR","message":"`::` is no longer part of beni: a list is built and matched with brackets and a\nspread. Write this as:\n\n    [ x, f xs, …xs ]\n\n`[ x, …xs ]` is `x` followed by the elements of `xs`, and as a pattern it\nmatches a list of at least one element, binding its first element and the rest.\n`beni fmt --migrate-cons <file>` writes every `::` of a file this way."},{"code":"cons_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/ConsRemoved.beni","start":{"line":12,"col":11},"end":{"line":12,"col":13}},"title":"REMOVED OPERATOR","message":"`::` is no longer part of beni: a list is built and matched with brackets and a\nspread. Write this as:\n\n    [ x + 1, y, 2 ]\n\n`[ x, …xs ]` is `x` followed by the elements of `xs`, and as a pattern it\nmatches a list of at least one element, binding its first element and the rest.\n`beni fmt --migrate-cons <file>` writes every `::` of a file this way."},{"code":"cons_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/ConsRemoved.beni","start":{"line":17,"col":18},"end":{"line":17,"col":20}},"title":"REMOVED OPERATOR","message":"`::` is no longer part of beni: a list is built and matched with brackets and a\nspread. Write this as:\n\n    [ ( a, b ), …_ ]\n\n`[ x, …xs ]` is `x` followed by the elements of `xs`, and as a pattern it\nmatches a list of at least one element, binding its first element and the rest.\n`beni fmt --migrate-cons <file>` writes every `::` of a file this way."},{"code":"cons_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/ConsRemoved.beni","start":{"line":21,"col":31},"end":{"line":21,"col":33}},"title":"REMOVED OPERATOR","message":"`(::)` is no longer part of beni, with the `::` operator it named. The function\nis `List.cons`:\n\n    List.cons x xs\n\nand `[ x, …xs ]` is the same list written in brackets."}]
