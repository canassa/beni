[{"code":"unknown_foreign_effect","severity":"error","span":{"file":"tests/corpus/parse/bad/core/UnknownForeignEffect.beni","start":{"line":6,"col":13},"end":{"line":6,"col":16}},"title":"UNKNOWN FOREIGN EFFECT","message":"`pur` is not something a `foreign` declaration can say about itself.\n\nBetween `foreign` and the name goes one of three words: `pure` (total, never\nthrows, no side effect), `impure` (a side effect, but never waits) or `suspends`\n(may wait: a timer, the network)."}]
