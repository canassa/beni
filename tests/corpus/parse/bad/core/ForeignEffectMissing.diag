[{"code":"foreign_effect_missing","severity":"error","span":{"file":"tests/corpus/parse/bad/core/ForeignEffectMissing.beni","start":{"line":5,"col":13},"end":{"line":5,"col":16}},"title":"FOREIGN WITHOUT EFFECT","message":"This `foreign` declaration does not say what calling `add` may do.\n\nA `foreign` value has no body to infer that from, so it states it between\n`foreign` and its name, as one of three words:\n\n    foreign pure add : …        -- total, never throws, no side effect\n    foreign impure add : …      -- a side effect, but never waits\n    foreign suspends add : …    -- may wait: a timer, the network"}]
