[{"code":"bind_rhs_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/BindRhsForwardReference.beni","start":{"line":7,"col":16},"end":{"line":7,"col":21}},"title":"BIND USES A LATER BINDING","message":"`later` is bound after this `<-`, so the call cannot see it.\n\n`let x <- f a` passes everything after it to `f a` as a callback, which means\nthe bindings below the `<-` do not exist yet where the call is made. Move the\nbinding of `later` above the `<-`."}]
