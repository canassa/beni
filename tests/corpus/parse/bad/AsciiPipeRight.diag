[{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiPipeRight.beni","start":{"line":5,"col":9},"end":{"line":5,"col":11}},"title":"REMOVED ASCII SYMBOL","message":"`|>` is written `▷` now (U+25B7 WHITE RIGHT-POINTING TRIANGLE).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `|>` into `▷` as it is typed."},{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiPipeRight.beni","start":{"line":6,"col":9},"end":{"line":6,"col":11}},"title":"REMOVED ASCII SYMBOL","message":"`|>` is written `▷` now (U+25B7 WHITE RIGHT-POINTING TRIANGLE).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `|>` into `▷` as it is typed."}]
