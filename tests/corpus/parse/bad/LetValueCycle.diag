[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetValueCycle.beni","start":{"line":10,"col":13},"end":{"line":10,"col":14}},"title":"LET BINDING USED TOO SOON","message":"`b` is bound further down this `let`, on line 12.\n\nA `let` evaluates its value bindings in the order they are written, so `b` has no\nvalue yet where it is used here. Move the binding of `b` above this one. A `let`\nFUNCTION is different — it is hoisted, so it can be used before it is written."}]
