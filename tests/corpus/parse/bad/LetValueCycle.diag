[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetValueCycle.beni","start":{"line":8,"col":9},"end":{"line":8,"col":10}},"title":"LET BINDING USED TOO SOON","message":"`b` is bound further down this block, on line 9.\n\nA block evaluates its value bindings in the order they are written, so `b` has\nno value yet where it is used here. Move the binding of `b` above this one. A\nblock's FUNCTION is different — it is hoisted, so it can be used before it is\nwritten."}]
