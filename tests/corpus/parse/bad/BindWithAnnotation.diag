[{"code":"annotation_without_definition","severity":"error","span":{"file":"tests/corpus/parse/bad/BindWithAnnotation.beni","start":{"line":4,"col":5},"end":{"line":4,"col":6}},"title":"ANNOTATION WITHOUT DEFINITION","message":"This type annotation for `x` is not followed by a definition of `x`.\n\nThe next binding is a `←`, and a bind is not a definition: it takes no\nannotation, because the type it would name belongs to the callee. Remove the\nannotation, or write `x = …` instead of `x ← …`."}]
