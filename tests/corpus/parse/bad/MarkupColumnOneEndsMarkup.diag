[{"code":"unclosed_element","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupColumnOneEndsMarkup.beni","start":{"line":7,"col":5},"end":{"line":7,"col":9}},"title":"UNCLOSED ELEMENT","message":"I was parsing the children of this `<div>` and ran into `after` on column 1\nbefore finding the `</div>` that closes it.\n\nEverything inside the element must be indented more than column 1, the column of\nthe block it is in. `after` is not, so the element ended there and its closing\ntag is missing."},{"code":"unclosed_element","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupColumnOneEndsMarkup.beni","start":{"line":7,"col":10},"end":{"line":7,"col":15}},"title":"UNCLOSED ELEMENT","message":"I was parsing the children of this `<span>` and ran into `after` on column 1\nbefore finding the `</span>` that closes it.\n\nEverything inside the element must be indented more than column 1, the column of\nthe block it is in. `after` is not, so the element ended there and its closing\ntag is missing."}]
