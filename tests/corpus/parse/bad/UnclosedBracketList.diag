[{"code":"unclosed_delimiter","severity":"error","span":{"file":"tests/corpus/parse/bad/UnclosedBracketList.beni","start":{"line":5,"col":5},"end":{"line":5,"col":6}},"title":"UNCLOSED DELIMITER","message":"I was parsing a list and ran into `y` on column 1 before finding the `]` that\ncloses this `[`.\n\nEverything inside the brackets must be indented more than column 1, the column\nof the block they are in. `y` is not, so the block ended there and the `]` is\nmissing."},{"code":"unclosed_delimiter","severity":"error","span":{"file":"tests/corpus/parse/bad/UnclosedBracketList.beni","start":{"line":13,"col":5},"end":{"line":13,"col":6}},"title":"UNCLOSED DELIMITER","message":"I was parsing a record and got to the end of the file without finding the `}` that\ncloses this `{`."}]
