[{"code":"multiple_placeholders","severity":"error","span":{"file":"tests/corpus/parse/bad/MultiplePlaceholders.beni","start":{"line":4,"col":11},"end":{"line":4,"col":12}},"title":"TWO PLACEHOLDERS","message":"I found a second `_` in the same call.\n\nA call may leave one argument open: `f a _ c` is `λx -> f a x c`. Two open\narguments have no shorter form than the lambda they stand for, so write\n`f _ b _` out in full: `λx y -> f x b y`."}]
