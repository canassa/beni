[{"code":"two_spreads_in_pattern","severity":"error","span":{"file":"tests/corpus/parse/bad/ListPatternTwoSpreads.beni","start":{"line":7,"col":20},"end":{"line":7,"col":23}},"title":"TWO SPREADS IN ONE PATTERN","message":"This list pattern has a second spread.\n\nA list pattern may have one spread: the items before it match the first elements\nand the items after it the last ones, so with two there would be more than one\nway to split the list between them. Keep one, and match the rest with items:\n\n    [ first, ...middle, last ]"}]
