[{"code":"unclosed_delimiter","severity":"error","span":{"file":"tests/corpus/parse/bad/UnclosedDelimiter.beni","start":{"line":5,"col":5},"end":{"line":5,"col":6}},"title":"UNCLOSED DELIMITER","message":"I was parsing a parenthesised expression and ran into `g` on column 1 before finding the `)` that\ncloses this `(`.\n\nEverything inside the brackets must be indented more than column 1, the column\nof the block they are in. `g` is not, so the block ended there and the `)` is\nmissing."}]
