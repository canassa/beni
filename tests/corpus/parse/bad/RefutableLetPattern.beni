-- The first corpus fixture for `refutable_let_pattern`, which until now had
-- only an in-source parser test. It is the half of §7 that needs no types: a
-- literal and a list, with a spread or without, match some values of their
-- type and not others whatever that type is, so the parser refuses them in a
-- `let` without waiting for the checker. A CONSTRUCTOR there is admitted and
-- decided by the checker instead (`check/bad/RefutableLetCtor`).
--
-- refutable_let_pattern at 12:5, 18:5 and 24:5; refutable_parameter_pattern
-- at 35:5, because §6.7 desugars `p <- e` into a callback whose parameter is
-- `p`, so that position is named as a parameter wherever it is caught.
literal m =
    1 =
        m
    m


listLiteral m =
    [ x, y ] =
        m
    x


spread l =
    [ h, ...r ] =
        l
    h


withCallback : Maybe Int, (Maybe Int -> Int) -> Int
withCallback m body =
    body m


bound =
    [ v ] <- withCallback (Just 1)
    v
