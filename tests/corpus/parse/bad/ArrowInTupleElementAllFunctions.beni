-- parse/bad: the same trap as `ArrowInTupleElement` (language.md §3, §12.8),
-- with a function type in EVERY element, a shape that once slipped past in
-- silence as a nested function type nobody wrote. It is tuple_type_removed,
-- the message the product with each element in parentheses (7:5).
type alias Pair =
    (Int → Int, Bool → Bool)


pub run : Pair → Int
run _ =
    0
