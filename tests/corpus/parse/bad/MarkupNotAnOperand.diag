[{"code":"unexpected_token","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupNotAnOperand.beni","start":{"line":6,"col":5},"end":{"line":6,"col":7}},"title":"UNEXPECTED TOKEN","message":"I ran into `<-` where an expression should start. `<-` is one token, the arrow\nof a `let` bind (`x <- f a`), so this is no tag: a tag's name cannot begin with\n`-`.\n\nA tag's name starts with a letter: `<div>`, `<my-widget>`, `<Card>`."},{"code":"unexpected_token","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupNotAnOperand.beni","start":{"line":10,"col":6},"end":{"line":10,"col":7}},"title":"UNEXPECTED TOKEN","message":"I found markup after a `-`. Negation takes a number, and markup is not one.\n\nRemove the `-`, or negate the number you meant: `-x`, `-(a + b)`."}]
