[{"code":"unexpected_token","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupNotAnOperand.beni","start":{"line":6,"col":5},"end":{"line":6,"col":7}},"title":"UNEXPECTED TOKEN","message":"I ran into `<-` where an expression should start. `<-` is one token, the arrow\nof a bind (`x <- f a`), so this is no tag: a tag's name cannot begin with\n`-`.\n\nA tag's name starts with a letter: `<div>`, `<my-widget>`, `<Card>`."},{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupNotAnOperand.beni","start":{"line":6,"col":5},"end":{"line":6,"col":7}},"title":"REMOVED ASCII SYMBOL","message":"`<-` is written `←` now (U+2190 LEFTWARDS ARROW).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `<-` into `←` as it is typed.\n\nIf you meant less than a negative number, write `x < -1`, with a space."},{"code":"unexpected_token","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupNotAnOperand.beni","start":{"line":10,"col":6},"end":{"line":10,"col":7}},"title":"UNEXPECTED TOKEN","message":"I found markup after a `-`. Negation takes a number, and markup is not one.\n\nRemove the `-`, or negate the number you meant: `-x`, `-(a + b)`."}]
