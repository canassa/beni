[{"code":"let_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/LetRemoved.beni","start":{"line":13,"col":5},"end":{"line":13,"col":8}},"title":"REMOVED LET SYNTAX","message":"`let … in` is gone: a body is a block now, its bindings one per line and its\nvalue on the last. Write this one as:\n\n    n = count xs\n\n    doubled =\n        n * 2\n    if n > 0 then\n        let\n            half = doubled // 2\n        in\n        half + n\n    else\n        0\n\n`beni fmt --migrate-let <file>` writes every `let` of a file this way."},{"code":"let_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/LetRemoved.beni","start":{"line":20,"col":9},"end":{"line":20,"col":12}},"title":"REMOVED LET SYNTAX","message":"`let … in` is gone: a body is a block now, its bindings one per line and its\nvalue on the last. Write this one as:\n\n    half = doubled // 2\n    half + n\n\n`beni fmt --migrate-let <file>` writes every `let` of a file this way."},{"code":"let_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/LetRemoved.beni","start":{"line":29,"col":12},"end":{"line":29,"col":15}},"title":"REMOVED LET SYNTAX","message":"`let … in` is gone: a body is a block now, its bindings one per line and its\nvalue on the last. Write this one as:\n\n    m = n + 1\n    m * m\n\n`beni fmt --migrate-let <file>` writes every `let` of a file this way."}]
