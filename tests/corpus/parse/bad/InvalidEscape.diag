[{"code":"invalid_escape","severity":"error","span":{"file":"tests/corpus/parse/bad/InvalidEscape.beni","start":{"line":4,"col":7},"end":{"line":4,"col":9}},"title":"INVALID ESCAPE","message":"I found the escape `\\q`, which is not valid.\n\nThe escapes are \\n \\r \\t \\\\ \\\" \\$ \\' and \\u{…}. To write a backslash,\nuse `\\\\`."},{"code":"invalid_escape","severity":"error","span":{"file":"tests/corpus/parse/bad/InvalidEscape.beni","start":{"line":8,"col":8},"end":{"line":8,"col":10}},"title":"INVALID ESCAPE","message":"I found the escape `\\u`, which is not a valid Unicode escape.\n\nA Unicode escape is `\\u{…}` with one to six hex digits inside the braces,\nlike `\\u{41}` or `\\u{1F600}`, naming a Unicode scalar value (at most\n10FFFF, and not a surrogate in D800–DFFF)."}]
