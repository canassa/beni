[{"code":"question_in_lambda","severity":"error","span":{"file":"tests/corpus/parse/bad/QuestionInPlaceholderLambda.beni","start":{"line":9,"col":18},"end":{"line":9,"col":19}},"title":"QUESTION MARK IN LAMBDA","message":"This `?` is inside a lambda.\n\n`?` returns early from the nearest enclosing definition that has parameters, and\na lambda in between would have to return instead. Move the `?` out of the\nlambda, or turn the lambda into a named function in a block."},{"code":"question_in_lambda","severity":"error","span":{"file":"tests/corpus/parse/bad/QuestionInPlaceholderLambda.beni","start":{"line":12,"col":12},"end":{"line":12,"col":13}},"title":"QUESTION MARK IN LAMBDA","message":"This `?` is inside a lambda.\n\n`?` returns early from the nearest enclosing definition that has parameters, and\na lambda in between would have to return instead. Move the `?` out of the\nlambda, or turn the lambda into a named function in a block."},{"code":"question_in_lambda","severity":"error","span":{"file":"tests/corpus/parse/bad/QuestionInPlaceholderLambda.beni","start":{"line":15,"col":22},"end":{"line":15,"col":23}},"title":"QUESTION MARK IN LAMBDA","message":"This `?` is inside a lambda.\n\n`?` returns early from the nearest enclosing definition that has parameters, and\na lambda in between would have to return instead. Move the `?` out of the\nlambda, or turn the lambda into a named function in a block."}]
