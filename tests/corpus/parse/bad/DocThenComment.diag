[{"code":"doc_comment_unattached","severity":"error","span":{"file":"tests/corpus/parse/bad/DocThenComment.beni","start":{"line":3,"col":1},"end":{"line":3,"col":17}},"title":"UNATTACHED DOC COMMENT","message":"This `--|` doc comment is not attached to a declaration.\n\nA `--|` block documents the declaration that starts on the next non-blank line\n(`pub` included). It cannot come before an import, an ordinary `--` comment, a\nbinding of a block, or the end of the file. For a comment that is not\ndocumentation, use `--`."}]
