-- pipe_rhs_not_application at 8:11 (the `\`), 12:10 (the `if`), 16:10
-- (the `case`), 26:12 (the `let`), 34:14 (the `+`) and 38:13 (the `?`):
-- the right operand of `|>` must be an application (§6.7), because the
-- left operand becomes its FIRST argument and a block form, an operator
-- chain and a `?` have no argument list to insert into. §3's rule letting
-- a block be the last operand of a chain does not extend to `|>`.
lambdaRhs xs =
    xs |> \x -> x


ifRhs c a b =
    a |> if c then b else a


caseRhs f m =
    f |> case m of
        Just v ->
            v

        Nothing ->
            f


letRhs f x =
    x
        |> let
               y =
                   f x
           in
           y


chainRhs x f =
    x |> f 1 + 2


questionRhs x f =
    x |> f 1?
