-- A newline followed by a non-space byte at column 1 ends every markup mode
-- (frontend.md §9.1): the unclosed `<div>` does not swallow the rest of the
-- file as text. Its text run ends with the newline, `after` is lexed as the
-- declaration it is and checks, and `<span>` and `<div>` are each
-- unclosed_element at their `<` (7:10, 7:5), naming `after` on column 1.
view =
    <div><span>unclosed

after a b =
    a <b
