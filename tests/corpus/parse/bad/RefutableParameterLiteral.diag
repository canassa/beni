[{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/parse/bad/RefutableParameterLiteral.beni","start":{"line":6,"col":3},"end":{"line":6,"col":4}},"title":"REFUTABLE PARAMETER","message":"I found `0` in a parameter, but a parameter must always match.\n\nA literal and a list, with a spread or without, each match some arguments and\nnot others, whatever their type turns out to be, and there is nowhere for the\nrest to go. (A CONSTRUCTOR is allowed here when its type has only that one; I\nsay which after I have checked the types.) Take the argument whole and `case` on\nit:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/parse/bad/RefutableParameterLiteral.beni","start":{"line":11,"col":5},"end":{"line":11,"col":8}},"title":"REFUTABLE PARAMETER","message":"I found `'a'` in a parameter, but a parameter must always match.\n\nA literal and a list, with a spread or without, each match some arguments and\nnot others, whatever their type turns out to be, and there is nowhere for the\nrest to go. (A CONSTRUCTOR is allowed here when its type has only that one; I\nsay which after I have checked the types.) Take the argument whole and `case` on\nit:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/parse/bad/RefutableParameterLiteral.beni","start":{"line":16,"col":7},"end":{"line":16,"col":8}},"title":"REFUTABLE PARAMETER","message":"I found `\"` in a parameter, but a parameter must always match.\n\nA literal and a list, with a spread or without, each match some arguments and\nnot others, whatever their type turns out to be, and there is nowhere for the\nrest to go. (A CONSTRUCTOR is allowed here when its type has only that one; I\nsay which after I have checked the types.) Take the argument whole and `case` on\nit:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0"}]
