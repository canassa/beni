[{"code":"unbound_type_variable","severity":"error","span":{"file":"tests/corpus/parse/bad/UnboundTypeVariable.beni","start":{"line":5,"col":11},"end":{"line":5,"col":12}},"title":"UNBOUND TYPE VARIABLE","message":"The type variable `a` is not a parameter of this type.\n\nEvery type variable used in a `type` or `type alias` body must be declared as a\nparameter: `type alias Wrapper a = ...`."},{"code":"unbound_type_variable","severity":"error","span":{"file":"tests/corpus/parse/bad/UnboundTypeVariable.beni","start":{"line":9,"col":10},"end":{"line":9,"col":11}},"title":"UNBOUND TYPE VARIABLE","message":"The type variable `b` is not a parameter of this type.\n\nEvery type variable used in a `type` or `type alias` body must be declared as a\nparameter: `type alias Wrapper b = ...`."}]
