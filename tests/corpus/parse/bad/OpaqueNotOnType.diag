[{"code":"opaque_not_on_type","severity":"error","span":{"file":"tests/corpus/parse/bad/OpaqueNotOnType.beni","start":{"line":3,"col":5},"end":{"line":3,"col":11}},"title":"OPAQUE NOT ON TYPE","message":"`opaque` can only go on a custom type: `pub opaque type T = …`.\n\nIt hides the constructors of a type from other modules. A type alias or a value\nhas no constructors to hide, so `opaque` means nothing there."},{"code":"opaque_not_on_type","severity":"error","span":{"file":"tests/corpus/parse/bad/OpaqueNotOnType.beni","start":{"line":7,"col":5},"end":{"line":7,"col":11}},"title":"OPAQUE NOT ON TYPE","message":"`opaque` can only go on a custom type: `pub opaque type T = …`.\n\nIt hides the constructors of a type from other modules. A type alias or a value\nhas no constructors to hide, so `opaque` means nothing there."}]
