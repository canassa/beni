[{"code":"unexpected_token","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupSiblingsWithoutFragment.beni","start":{"line":7,"col":13},"end":{"line":7,"col":15}},"title":"UNEXPECTED TOKEN","message":"`<p` starts a second element right after `</p>`, where the markup before it\nended, so I read this `<` as a comparison.\n\nAn expression holds one element. To write elements side by side, put them in\na fragment, `<>…</>`, or in an element around them."},{"code":"unexpected_token","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupSiblingsWithoutFragment.beni","start":{"line":11,"col":11},"end":{"line":11,"col":14}},"title":"UNEXPECTED TOKEN","message":"`<hr` starts a second element right after `/>`, where the markup before it\nended, so I read this `<` as a comparison.\n\nAn expression holds one element. To write elements side by side, put them in\na fragment, `<>…</>`, or in an element around them."}]
