[{"code":"mismatched_closing_tag","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupMismatchedClosingTag.beni","start":{"line":6,"col":14},"end":{"line":6,"col":20}},"title":"MISMATCHED CLOSING TAG","message":"The closing tag `</span>` does not match the `<p>` it closes.\n\nA closing tag repeats its opening tag's name exactly: `<p>…</p>`. I read\n`</span>` as the end of `<p>` and went on."}]
