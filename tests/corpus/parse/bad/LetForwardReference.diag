[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetForwardReference.beni","start":{"line":10,"col":17},"end":{"line":10,"col":22}},"title":"LET BINDING USED TOO SOON","message":"`later` is bound further down this `let`, on line 11.\n\nA `let` evaluates its value bindings in the order they are written, so `later`\nhas no value yet where it is used here. Move the binding of `later` above this\none. A `let` FUNCTION is different — it is hoisted, so it can be used before it\nis written."}]
