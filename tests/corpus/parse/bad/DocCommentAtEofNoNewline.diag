[{"code":"doc_comment_unattached","severity":"error","span":{"file":"tests/corpus/parse/bad/DocCommentAtEofNoNewline.beni","start":{"line":4,"col":1},"end":{"line":4,"col":4}},"title":"UNATTACHED DOC COMMENT","message":"This `--|` doc comment is not attached to a declaration.\n\nA `--|` block documents the declaration that starts on the next non-blank line\n(`pub` included). It cannot come before an import, an ordinary `--` comment, a\n`let` binding, or the end of the file. For a comment that is not documentation,\nuse `--`."}]
