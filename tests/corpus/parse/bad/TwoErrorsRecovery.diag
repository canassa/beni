[{"code":"unclosed_delimiter","severity":"error","span":{"file":"tests/corpus/parse/bad/TwoErrorsRecovery.beni","start":{"line":5,"col":5},"end":{"line":5,"col":6}},"title":"UNCLOSED DELIMITER","message":"I was parsing a parenthesised expression and ran into `g` on column 1 before\nfinding the `)` that closes this `(`.\n\nEverything inside the brackets must be indented more than column 5, the column\nof the block they are in. `g` is not, so the block ended there and the `)` is\nmissing."},{"code":"invalid_char_literal","severity":"error","span":{"file":"tests/corpus/parse/bad/TwoErrorsRecovery.beni","start":{"line":13,"col":5},"end":{"line":13,"col":7}},"title":"INVALID CHAR LITERAL","message":"I found an empty character literal `''`.\n\nA character literal holds exactly one character: `'a'`, `'\\n'`, `'\\u{1F600}'`."}]
