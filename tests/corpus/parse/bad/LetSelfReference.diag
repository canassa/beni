[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetSelfReference.beni","start":{"line":8,"col":13},"end":{"line":8,"col":14}},"title":"LET BINDING USED TOO SOON","message":"`x` is defined in terms of itself.\n\nA `let` evaluates its value bindings in the order they are written, so `x` has\nno value yet inside its own right-hand side. Only a FUNCTION can be recursive:\ngive `x` a parameter, or compute it from a different binding."}]
