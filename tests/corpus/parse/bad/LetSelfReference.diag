[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetSelfReference.beni","start":{"line":9,"col":13},"end":{"line":9,"col":14}},"title":"LET BINDING USED TOO SOON","message":"`x` is defined in terms of itself.\n\nA `let` evaluates its value bindings in the order they are written, so `x` has no\nvalue yet inside its own right-hand side. Only a FUNCTION can be recursive: give\n`x` a parameter, or compute it from a different binding."}]
