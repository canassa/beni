[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetForwardThroughFunction.beni","start":{"line":11,"col":13},"end":{"line":11,"col":14}},"title":"LET BINDING USED TOO SOON","message":"Naming `f` here reads `b`, which is bound further down this `let`, on line 16.\n\nA `let` evaluates its value bindings in the order they are written, so this binding\nruns before `b` has a value — and naming `f` may call it, which reads `b`.\nMove the binding of `b` above this one."}]
