[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/LetForwardThroughFunction.beni","start":{"line":9,"col":9},"end":{"line":9,"col":10}},"title":"LET BINDING USED TOO SOON","message":"Naming `f` here reads `b`, which is bound further down this `let`, on line 11.\n\nA `let` evaluates its value bindings in the order they are written, so this\nbinding runs before `b` has a value — and naming `f` may call it, which reads\n`b`. Move the binding of `b` above this one."}]
