[{"code":"element_as_argument","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupElementAsArgument.beni","start":{"line":7,"col":7},"end":{"line":7,"col":10}},"title":"MARKUP AS AN ARGUMENT","message":"This `<` is a comparison, not the start of markup: it comes right after `f`,\nwhich ends an operand, so `<br` compares `f` with `br`, and what follows can\nonly be markup.\n\nMarkup is an operand, never a bare argument. Parenthesise it, or pass it with\n`<|`:\n\n    f (<br … />)\n    f <| <br … />"},{"code":"element_as_argument","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupElementAsArgument.beni","start":{"line":11,"col":7},"end":{"line":11,"col":9}},"title":"MARKUP AS AN ARGUMENT","message":"This `<` is a comparison, not the start of markup: it comes right after `f`,\nwhich ends an operand, so `<p` compares `f` with `p`, and what follows can\nonly be markup.\n\nMarkup is an operand, never a bare argument. Parenthesise it, or pass it with\n`<|`:\n\n    f (<p … />)\n    f <| <p … />"},{"code":"element_as_argument","severity":"error","span":{"file":"tests/corpus/parse/bad/MarkupElementAsArgument.beni","start":{"line":15,"col":7},"end":{"line":15,"col":13}},"title":"MARKUP AS AN ARGUMENT","message":"This `<` is a comparison, not the start of markup: it comes right after `f`,\nwhich ends an operand, so `<input` compares `f` with `input`, and what follows\ncan only be markup.\n\nMarkup is an operand, never a bare argument. Parenthesise it, or pass it with\n`<|`:\n\n    f (<input … />)\n    f <| <input … />"}]
