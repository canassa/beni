-- A float literal in a pattern is not in the grammar (language.md
-- §3, `PatAtom`), and saying so takes ONE diagnostic: `unexpected_token` at
-- the literal with a message about float patterns that suggests a
-- comparison (the owner's decision: no new code) — not CASE WITHOUT
-- BRANCHES ("ran into `1.5`, which is indented to column 9") followed by
-- UNEXPECTED TOKEN, which a pattern parser with no `.float` arm gives.


g x =
    case x of
        1.5 →
            "a"

        _ →
            "b"
