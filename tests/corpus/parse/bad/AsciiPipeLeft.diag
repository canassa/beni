[{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiPipeLeft.beni","start":{"line":4,"col":17},"end":{"line":4,"col":19}},"title":"REMOVED ASCII SYMBOL","message":"`<|` is written `◁` now (U+25C1 WHITE LEFT-POINTING TRIANGLE).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `<|` into `◁` as it is typed."}]
