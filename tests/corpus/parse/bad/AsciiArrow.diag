[{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiArrow.beni","start":{"line":5,"col":11},"end":{"line":5,"col":13}},"title":"REMOVED ASCII SYMBOL","message":"`->` is written `→` now (U+2192 RIGHTWARDS ARROW).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `->` into `→` as it is typed."},{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiArrow.beni","start":{"line":7,"col":9},"end":{"line":7,"col":11}},"title":"REMOVED ASCII SYMBOL","message":"`->` is written `→` now (U+2192 RIGHTWARDS ARROW).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `->` into `→` as it is typed."},{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiArrow.beni","start":{"line":12,"col":16},"end":{"line":12,"col":18}},"title":"REMOVED ASCII SYMBOL","message":"`->` is written `→` now (U+2192 RIGHTWARDS ARROW).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `->` into `→` as it is typed."}]
