[{"code":"ascii_symbol_removed","severity":"error","span":{"file":"tests/corpus/parse/bad/AsciiLessEqual.beni","start":{"line":4,"col":7},"end":{"line":4,"col":9}},"title":"REMOVED ASCII SYMBOL","message":"`<=` is written `≤` now (U+2264 LESS-THAN OR EQUAL TO).\n\n`beni fmt --migrate-unicode <file>` writes every one of a file this way, and an\neditor with beni support turns `<=` into `≤` as it is typed."}]
