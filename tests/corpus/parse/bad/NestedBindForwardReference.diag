[{"code":"bind_rhs_forward_reference","severity":"error","span":{"file":"tests/corpus/parse/bad/NestedBindForwardReference.beni","start":{"line":8,"col":27},"end":{"line":8,"col":32}},"title":"BIND USES A LATER BINDING","message":"`later` is bound after this `<-`, so the call cannot see it.\n\n`let x <- f a` passes everything after it to `f a` as a callback, which means\nthe bindings below the `<-` do not exist yet where the call is made. Move the\nbinding of `later` above the `<-`."}]
