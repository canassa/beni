[{"code":"pub_on_definition","severity":"error","span":{"file":"tests/corpus/parse/bad/PubOnDefinition.beni","start":{"line":4,"col":1},"end":{"line":4,"col":4}},"title":"PUB ON DEFINITION","message":"`pub` is on the definition of `f`, but `f` also has a type annotation.\n\nWhen a definition has an annotation, `pub` goes on the annotation line, like\n`pub f : …`. Remove it from the definition."}]
