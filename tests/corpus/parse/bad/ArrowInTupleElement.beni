-- parse/bad: the old tuple-element trap of language.md §3 — a bare arrow in
-- an element of `( … )`, read as the parameter list's — is a tuple type
-- written with commas, so it is tuple_type_removed and not
-- arrow_in_tuple_element (§12.8), its message the type written with `×`, the
-- function-typed element and the inner tuple in parentheses (7:5, 7:6).
type alias Handler =
    ((Int, Int) → Int, String)


pub run : Handler → Int
run h =
    0
