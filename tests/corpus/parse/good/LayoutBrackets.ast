(module
  (definition list
    (list
      (int 1)
      (int 2)
      (int 3)))
  (definition record
    (record
      (field a
        (int 1))
      (field b
        (int 2))
      (field c
        (int 3))))
  (definition inBinding
    (block
      (let_def xs
        (list
          (int 1)
          (int 2)))
      (ident xs)))
  (definition inBranch
    (pat_var n)
    (case
      (ident n)
      (branch
        (pat_int 1)
        (tuple
          (int 1)
          (int 2)))
      (branch
        (pat_wild)
        (tuple
          (int 0)
          (int 0))))))
