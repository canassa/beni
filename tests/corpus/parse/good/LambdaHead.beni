-- `λ` begins a lambda (language.md §12.1): the token `lambda`, two bytes,
-- with no space before its first parameter, in every place a lambda stands —
-- a body, an argument, a nested lambda, a thunk's `λ()`, a markup hole and an
-- attribute value. A multiline string's `\\` beside it stays a
-- `multiline_line`, and a string's `\\` stays an escape.
inc = λn -> n + 1


pairs xs = List.map xs λ( a, b ) -> a + b


nested = λa -> λb -> a + b


thunk = λ() -> 0


both = λ{ name } _ -> name


text =
    λx ->
        \\raw \x
        \\more


escaped = λ_ -> "a\\b"


rows items = <ul>{List.map items λi -> <li onClick={λ_ -> i}>{i}</li>}</ul>
