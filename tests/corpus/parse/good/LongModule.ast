(module
  (module_doc "Kanban board: model, update and view for a three-column task board.")
  (module_doc "Cards move between columns, can be edited inline, and persist as JSON.")
  (import Dict exposing
    (exposed Dict))
  (import Html exposing
    (exposed Html)
    (exposed button)
    (exposed div)
    (exposed h1)
    (exposed h2)
    (exposed input)
    (exposed li)
    (exposed span)
    (exposed text)
    (exposed ul))
  (import Html.Attributes exposing
    (exposed class)
    (exposed classList)
    (exposed placeholder)
    (exposed value))
  (import Html.Events exposing
    (exposed onClick)
    (exposed onInput))
  (import Json.Decode as Decode exposing
    (exposed Decoder))
  (import Json.Encode as Encode)
  (import Set exposing
    (exposed Set))
  (type_alias pub Card
    (doc "A single card on the board.")
    (type_record
      (record_type_field id
        (type_con Int))
      (record_type_field title
        (type_con String))
      (record_type_field description
        (type_con String))
      (record_type_field labels
        (type_con List
          (type_con String)))
      (record_type_field column
        (type_con Column))
      (record_type_field order
        (type_con Int))))
  (type_decl pub Column
    (doc "The three fixed columns.")
    (constructor Backlog)
    (constructor InProgress)
    (constructor Done))
  (type_decl Editing
    (doc "What the user is currently editing, if anything.")
    (constructor NotEditing)
    (constructor EditingTitle
      (type_con Int)
      (type_con String))
    (constructor EditingDescription
      (type_con Int)
      (type_con String)))
  (type_alias Drag
    (doc "Drag state: which card is being dragged and which column is hovered.")
    (type_record
      (record_type_field cardId
        (type_con Int))
      (record_type_field over
        (type_con Maybe
          (type_con Column)))))
  (type_alias pub Model
    (type_record
      (record_type_field cards
        (type_con Dict
          (type_con Int)
          (type_con Card)))
      (record_type_field nextId
        (type_con Int))
      (record_type_field editing
        (type_con Editing))
      (record_type_field drag
        (type_con Maybe
          (type_con Drag)))
      (record_type_field filter
        (type_con String))
      (record_type_field collapsed
        (type_con Set
          (type_con String)))
      (record_type_field newCardTitle
        (type_con String))
      (record_type_field errors
        (type_con List
          (type_con String)))))
  (type_decl pub Msg
    (constructor NoOp)
    (constructor SetNewCardTitle
      (type_con String))
    (constructor AddCard)
    (constructor DeleteCard
      (type_con Int))
    (constructor MoveCard
      (type_con Int)
      (type_con Column))
    (constructor StartEditTitle
      (type_con Int))
    (constructor StartEditDescription
      (type_con Int))
    (constructor EditInput
      (type_con String))
    (constructor CommitEdit)
    (constructor CancelEdit)
    (constructor DragStart
      (type_con Int))
    (constructor DragOver
      (type_con Column))
    (constructor DragEnd)
    (constructor Drop)
    (constructor SetFilter
      (type_con String))
    (constructor ToggleCollapse
      (type_con String))
    (constructor ToggleLabel
      (type_con Int)
      (type_con String))
    (constructor Loaded
      (type_paren
        (type_con Result
          (type_con Decode.Error)
          (type_paren
            (type_con List
              (type_con Card))))))
    (constructor KeyDown
      (type_con String)))
  (annotation pub init
    (type_con Model))
  (definition init
    (record
      (field cards
        (ident Dict.empty))
      (field nextId
        (int 1))
      (field editing
        (ctor NotEditing))
      (field drag
        (ctor Nothing))
      (field filter
        (string))
      (field collapsed
        (ident Set.empty))
      (field newCardTitle
        (string))
      (field errors
        (list))))
  (annotation pub columns
    (type_con List
      (type_con Column)))
  (definition columns
    (list
      (ctor Backlog)
      (ctor InProgress)
      (ctor Done)))
  (annotation pub columnName
    (type_fn
      (type_con Column)
      (type_con String)))
  (definition columnName
    (pat_var column)
    (case
      (ident column)
      (branch
        (pat_ctor Backlog)
        (string
          (chunk "Backlog")))
      (branch
        (pat_ctor InProgress)
        (string
          (chunk "In progress")))
      (branch
        (pat_ctor Done)
        (string
          (chunk "Done")))))
  (annotation columnKey
    (type_fn
      (type_con Column)
      (type_con String)))
  (definition columnKey
    (pat_var column)
    (case
      (ident column)
      (branch
        (pat_ctor Backlog)
        (string
          (chunk "backlog")))
      (branch
        (pat_ctor InProgress)
        (string
          (chunk "in_progress")))
      (branch
        (pat_ctor Done)
        (string
          (chunk "done")))))
  (annotation columnFromKey
    (type_fn
      (type_con String)
      (type_con Maybe
        (type_con Column))))
  (definition columnFromKey
    (pat_var key)
    (case
      (ident key)
      (branch
        (pat_string "backlog")
        (apply
          (ctor Just)
          (ctor Backlog)))
      (branch
        (pat_string "in_progress")
        (apply
          (ctor Just)
          (ctor InProgress)))
      (branch
        (pat_string "done")
        (apply
          (ctor Just)
          (ctor Done)))
      (branch
        (pat_wild)
        (ctor Nothing))))
  (annotation nextColumn
    (type_fn
      (type_con Column)
      (type_con Maybe
        (type_con Column))))
  (definition nextColumn
    (pat_var column)
    (case
      (ident column)
      (branch
        (pat_ctor Backlog)
        (apply
          (ctor Just)
          (ctor InProgress)))
      (branch
        (pat_ctor InProgress)
        (apply
          (ctor Just)
          (ctor Done)))
      (branch
        (pat_ctor Done)
        (ctor Nothing))))
  (annotation previousColumn
    (type_fn
      (type_con Column)
      (type_con Maybe
        (type_con Column))))
  (definition previousColumn
    (pat_var column)
    (case
      (ident column)
      (branch
        (pat_ctor Backlog)
        (ctor Nothing))
      (branch
        (pat_ctor InProgress)
        (apply
          (ctor Just)
          (ctor Backlog)))
      (branch
        (pat_ctor Done)
        (apply
          (ctor Just)
          (ctor InProgress)))))
  (annotation pub update
    (type_fn
      (type_con Msg)
      (type_con Model)
      (type_con Model)))
  (definition update
    (pat_var msg)
    (pat_var model)
    (case
      (ident msg)
      (branch
        (pat_ctor NoOp)
        (ident model))
      (branch
        (pat_ctor SetNewCardTitle
          (pat_var title))
        (record_update model
          (field newCardTitle
            (ident title))))
      (branch
        (pat_ctor AddCard)
        (let
          (let_def title
            (apply
              (ident String.trim)
              (field_access .newCardTitle
                (ident model))))
          (if
            (apply
              (ident String.isEmpty)
              (ident title))
            (apply
              (ident addError)
              (string
                (chunk "A card needs a title."))
              (ident model))
            (let
              (let_def card
                (record
                  (field id
                    (field_access .nextId
                      (ident model)))
                  (field title
                    (ident title))
                  (field description
                    (string))
                  (field labels
                    (list))
                  (field column
                    (ctor Backlog))
                  (field order
                    (pipe_right
                      (apply
                        (ident cardsIn)
                        (ctor Backlog)
                        (ident model))
                      (ident List.length)))))
              (record_update model
                (field cards
                  (apply
                    (ident Dict.insert)
                    (field_access .id
                      (ident card))
                    (ident card)
                    (field_access .cards
                      (ident model))))
                (field nextId
                  (add
                    (field_access .nextId
                      (ident model))
                    (int 1)))
                (field newCardTitle
                  (string)))))))
      (branch
        (pat_ctor DeleteCard
          (pat_var id))
        (pipe_right
          (record_update model
            (field cards
              (apply
                (ident Dict.remove)
                (ident id)
                (field_access .cards
                  (ident model)))))
          (ident renumber)))
      (branch
        (pat_ctor MoveCard
          (pat_var id)
          (pat_var column))
        (apply
          (ident moveCard)
          (ident id)
          (ident column)
          (ident model)))
      (branch
        (pat_ctor StartEditTitle
          (pat_var id))
        (case
          (apply
            (ident Dict.get)
            (ident id)
            (field_access .cards
              (ident model)))
          (branch
            (pat_ctor Just
              (pat_var card))
            (record_update model
              (field editing
                (apply
                  (ctor EditingTitle)
                  (ident id)
                  (field_access .title
                    (ident card))))))
          (branch
            (pat_ctor Nothing)
            (ident model))))
      (branch
        (pat_ctor StartEditDescription
          (pat_var id))
        (case
          (apply
            (ident Dict.get)
            (ident id)
            (field_access .cards
              (ident model)))
          (branch
            (pat_ctor Just
              (pat_var card))
            (record_update model
              (field editing
                (apply
                  (ctor EditingDescription)
                  (ident id)
                  (field_access .description
                    (ident card))))))
          (branch
            (pat_ctor Nothing)
            (ident model))))
      (branch
        (pat_ctor EditInput
          (pat_var str))
        (case
          (field_access .editing
            (ident model))
          (branch
            (pat_ctor NotEditing)
            (ident model))
          (branch
            (pat_ctor EditingTitle
              (pat_var id)
              (pat_wild))
            (record_update model
              (field editing
                (apply
                  (ctor EditingTitle)
                  (ident id)
                  (ident str)))))
          (branch
            (pat_ctor EditingDescription
              (pat_var id)
              (pat_wild))
            (record_update model
              (field editing
                (apply
                  (ctor EditingDescription)
                  (ident id)
                  (ident str)))))))
      (branch
        (pat_ctor CommitEdit)
        (apply
          (ident commitEdit)
          (ident model)))
      (branch
        (pat_ctor CancelEdit)
        (record_update model
          (field editing
            (ctor NotEditing))))
      (branch
        (pat_ctor DragStart
          (pat_var id))
        (record_update model
          (field drag
            (apply
              (ctor Just)
              (record
                (field cardId
                  (ident id))
                (field over
                  (ctor Nothing)))))))
      (branch
        (pat_ctor DragOver
          (pat_var column))
        (case
          (field_access .drag
            (ident model))
          (branch
            (pat_ctor Just
              (pat_var drag))
            (record_update model
              (field drag
                (apply
                  (ctor Just)
                  (record_update drag
                    (field over
                      (apply
                        (ctor Just)
                        (ident column))))))))
          (branch
            (pat_ctor Nothing)
            (ident model))))
      (branch
        (pat_ctor DragEnd)
        (record_update model
          (field drag
            (ctor Nothing))))
      (branch
        (pat_ctor Drop)
        (case
          (field_access .drag
            (ident model))
          (branch
            (pat_ctor Just
              (pat_record cardId over))
            (case
              (ident over)
              (branch
                (pat_ctor Just
                  (pat_var column))
                (apply
                  (ident moveCard)
                  (ident cardId)
                  (ident column)
                  (record_update model
                    (field drag
                      (ctor Nothing)))))
              (branch
                (pat_ctor Nothing)
                (record_update model
                  (field drag
                    (ctor Nothing))))))
          (branch
            (pat_ctor Nothing)
            (ident model))))
      (branch
        (pat_ctor SetFilter
          (pat_var str))
        (record_update model
          (field filter
            (apply
              (ident String.toLower)
              (ident str)))))
      (branch
        (pat_ctor ToggleCollapse
          (pat_var key))
        (if
          (apply
            (ident Set.member)
            (ident key)
            (field_access .collapsed
              (ident model)))
          (record_update model
            (field collapsed
              (apply
                (ident Set.remove)
                (ident key)
                (field_access .collapsed
                  (ident model)))))
          (record_update model
            (field collapsed
              (apply
                (ident Set.insert)
                (ident key)
                (field_access .collapsed
                  (ident model)))))))
      (branch
        (pat_ctor ToggleLabel
          (pat_var id)
          (pat_var label))
        (apply
          (ident updateCard)
          (ident id)
          (paren
            (apply
              (ident toggleLabel)
              (ident label)))
          (ident model)))
      (branch
        (pat_ctor Loaded
          (pat_var result))
        (case
          (ident result)
          (branch
            (pat_ctor Ok
              (pat_var cards))
            (record_update model
              (field cards
                (pipe_right
                  (pipe_right
                    (ident cards)
                    (apply
                      (ident List.map)
                      (paren
                        (lambda
                          (pat_var c)
                          (tuple
                            (field_access .id
                              (ident c))
                            (ident c))))))
                  (ident Dict.fromList)))
              (field nextId
                (add
                  (int 1)
                  (apply
                    (ident List.foldl)
                    (paren
                      (lambda
                        (pat_var c)
                        (pat_var acc)
                        (apply
                          (ident max)
                          (ident acc)
                          (field_access .id
                            (ident c)))))
                    (int 0)
                    (ident cards))))))
          (branch
            (pat_ctor Err
              (pat_var error))
            (apply
              (ident addError)
              (paren
                (apply
                  (ident Decode.errorToString)
                  (ident error)))
              (ident model)))))
      (branch
        (pat_ctor KeyDown
          (pat_var key))
        (apply
          (ident handleKey)
          (ident key)
          (ident model)))))
  (annotation addError
    (type_fn
      (type_con String)
      (type_con Model)
      (type_con Model)))
  (definition addError
    (pat_var message)
    (pat_var model)
    (record_update model
      (field errors
        (cons
          (ident message)
          (apply
            (ident List.take)
            (int 4)
            (field_access .errors
              (ident model)))))))
  (annotation updateCard
    (type_fn
      (type_con Int)
      (type_paren
        (type_fn
          (type_con Card)
          (type_con Card)))
      (type_con Model)
      (type_con Model)))
  (definition updateCard
    (pat_var id)
    (pat_var f)
    (pat_var model)
    (case
      (apply
        (ident Dict.get)
        (ident id)
        (field_access .cards
          (ident model)))
      (branch
        (pat_ctor Just
          (pat_var card))
        (record_update model
          (field cards
            (apply
              (ident Dict.insert)
              (ident id)
              (paren
                (apply
                  (ident f)
                  (ident card)))
              (field_access .cards
                (ident model))))))
      (branch
        (pat_ctor Nothing)
        (ident model))))
  (annotation toggleLabel
    (type_fn
      (type_con String)
      (type_con Card)
      (type_con Card)))
  (definition toggleLabel
    (pat_var label)
    (pat_var card)
    (if
      (apply
        (ident List.member)
        (ident label)
        (field_access .labels
          (ident card)))
      (record_update card
        (field labels
          (apply
            (ident List.filter)
            (paren
              (lambda
                (pat_var l)
                (neq
                  (ident l)
                  (ident label))))
            (field_access .labels
              (ident card)))))
      (record_update card
        (field labels
          (cons
            (ident label)
            (field_access .labels
              (ident card)))))))
  (annotation commitEdit
    (type_fn
      (type_con Model)
      (type_con Model)))
  (definition commitEdit
    (pat_var model)
    (let
      (let_def finished
        (record_update model
          (field editing
            (ctor NotEditing))))
      (case
        (field_access .editing
          (ident model))
        (branch
          (pat_ctor NotEditing)
          (ident model))
        (branch
          (pat_ctor EditingTitle
            (pat_var id)
            (pat_var title))
          (if
            (apply
              (ident String.isEmpty)
              (paren
                (apply
                  (ident String.trim)
                  (ident title))))
            (apply
              (ident addError)
              (string
                (chunk "Title cannot be empty."))
              (ident finished))
            (apply
              (ident updateCard)
              (ident id)
              (paren
                (lambda
                  (pat_var card)
                  (record_update card
                    (field title
                      (apply
                        (ident String.trim)
                        (ident title))))))
              (ident finished))))
        (branch
          (pat_ctor EditingDescription
            (pat_var id)
            (pat_var description))
          (apply
            (ident updateCard)
            (ident id)
            (paren
              (lambda
                (pat_var card)
                (record_update card
                  (field description
                    (ident description)))))
            (ident finished))))))
  (annotation moveCard
    (type_fn
      (type_con Int)
      (type_con Column)
      (type_con Model)
      (type_con Model)))
  (definition moveCard
    (pat_var id)
    (pat_var column)
    (pat_var model)
    (case
      (apply
        (ident Dict.get)
        (ident id)
        (field_access .cards
          (ident model)))
      (branch
        (pat_ctor Just
          (pat_var card))
        (if
          (eq
            (field_access .column
              (ident card))
            (ident column))
          (ident model)
          (let
            (let_def moved
              (record_update card
                (field column
                  (ident column))
                (field order
                  (apply
                    (ident List.length)
                    (paren
                      (apply
                        (ident cardsIn)
                        (ident column)
                        (ident model)))))))
            (pipe_right
              (record_update model
                (field cards
                  (apply
                    (ident Dict.insert)
                    (ident id)
                    (ident moved)
                    (field_access .cards
                      (ident model)))))
              (ident renumber)))))
      (branch
        (pat_ctor Nothing)
        (ident model))))
  (annotation renumber
    (type_fn
      (type_con Model)
      (type_con Model)))
  (definition renumber
    (pat_var model)
    (let
      (let_def renumberColumn
        (pat_var column)
        (pat_var cards)
        (pipe_right
          (pipe_right
            (apply
              (ident cardsIn)
              (ident column)
              (ident model))
            (apply
              (ident List.indexedMap)
              (paren
                (lambda
                  (pat_var index)
                  (pat_var card)
                  (record_update card
                    (field order
                      (ident index)))))))
          (apply
            (ident List.foldl)
            (paren
              (lambda
                (pat_var card)
                (pat_var acc)
                (apply
                  (ident Dict.insert)
                  (field_access .id
                    (ident card))
                  (ident card)
                  (ident acc))))
            (ident cards))))
      (record_update model
        (field cards
          (apply
            (ident List.foldl)
            (ident renumberColumn)
            (field_access .cards
              (ident model))
            (ident columns))))))
  (annotation cardsIn
    (type_fn
      (type_con Column)
      (type_con Model)
      (type_con List
        (type_con Card))))
  (definition cardsIn
    (pat_var column)
    (pat_var model)
    (pipe_right
      (pipe_right
        (pipe_right
          (field_access .cards
            (ident model))
          (ident Dict.values))
        (apply
          (ident List.filter)
          (paren
            (lambda
              (pat_var card)
              (eq
                (field_access .column
                  (ident card))
                (ident column))))))
      (apply
        (ident List.sortBy)
        (accessor .order))))
  (annotation visibleCardsIn
    (type_fn
      (type_con Column)
      (type_con Model)
      (type_con List
        (type_con Card))))
  (definition visibleCardsIn
    (pat_var column)
    (pat_var model)
    (pipe_right
      (apply
        (ident cardsIn)
        (ident column)
        (ident model))
      (apply
        (ident List.filter)
        (paren
          (apply
            (ident matchesFilter)
            (field_access .filter
              (ident model)))))))
  (annotation matchesFilter
    (type_fn
      (type_con String)
      (type_con Card)
      (type_con Bool)))
  (definition matchesFilter
    (pat_var filter)
    (pat_var card)
    (bool_or
      (apply
        (ident String.isEmpty)
        (ident filter))
      (bool_or
        (apply
          (ident String.contains)
          (ident filter)
          (paren
            (apply
              (ident String.toLower)
              (field_access .title
                (ident card)))))
        (bool_or
          (apply
            (ident String.contains)
            (ident filter)
            (paren
              (apply
                (ident String.toLower)
                (field_access .description
                  (ident card)))))
          (apply
            (ident List.any)
            (paren
              (lambda
                (pat_var label)
                (apply
                  (ident String.contains)
                  (ident filter)
                  (paren
                    (apply
                      (ident String.toLower)
                      (ident label))))))
            (field_access .labels
              (ident card)))))))
  (annotation handleKey
    (type_fn
      (type_con String)
      (type_con Model)
      (type_con Model)))
  (definition handleKey
    (pat_var key)
    (pat_var model)
    (case
      (tuple
        (ident key)
        (field_access .editing
          (ident model)))
      (branch
        (pat_tuple
          (pat_string "Escape")
          (pat_wild))
        (record_update model
          (field editing
            (ctor NotEditing))
          (field drag
            (ctor Nothing))))
      (branch
        (pat_tuple
          (pat_string "Enter")
          (pat_ctor EditingTitle
            (pat_wild)
            (pat_wild)))
        (apply
          (ident commitEdit)
          (ident model)))
      (branch
        (pat_tuple
          (pat_string "Enter")
          (pat_ctor NotEditing))
        (apply
          (ident update)
          (ctor AddCard)
          (ident model)))
      (branch
        (pat_tuple
          (pat_string "ArrowRight")
          (pat_ctor NotEditing))
        (apply
          (ident shiftSelected)
          (ident nextColumn)
          (ident model)))
      (branch
        (pat_tuple
          (pat_string "ArrowLeft")
          (pat_ctor NotEditing))
        (apply
          (ident shiftSelected)
          (ident previousColumn)
          (ident model)))
      (branch
        (pat_wild)
        (ident model))))
  (annotation shiftSelected
    (type_fn
      (type_paren
        (type_fn
          (type_con Column)
          (type_con Maybe
            (type_con Column))))
      (type_con Model)
      (type_con Model)))
  (definition shiftSelected
    (pat_var direction)
    (pat_var model)
    (case
      (field_access .drag
        (ident model))
      (branch
        (pat_ctor Just
          (pat_record cardId))
        (case
          (apply
            (ident Dict.get)
            (ident cardId)
            (field_access .cards
              (ident model)))
          (branch
            (pat_ctor Just
              (pat_var card))
            (case
              (apply
                (ident direction)
                (field_access .column
                  (ident card)))
              (branch
                (pat_ctor Just
                  (pat_var target))
                (apply
                  (ident moveCard)
                  (ident cardId)
                  (ident target)
                  (ident model)))
              (branch
                (pat_ctor Nothing)
                (ident model))))
          (branch
            (pat_ctor Nothing)
            (ident model))))
      (branch
        (pat_ctor Nothing)
        (ident model))))
  (annotation pub view
    (type_fn
      (type_con Model)
      (type_con Html
        (type_con Msg))))
  (definition view
    (pat_var model)
    (apply
      (ident div)
      (list
        (apply
          (ident class)
          (string
            (chunk "board"))))
      (list
        (apply
          (ident viewHeader)
          (ident model))
        (apply
          (ident viewErrors)
          (field_access .errors
            (ident model)))
        (apply
          (ident div)
          (list
            (apply
              (ident class)
              (string
                (chunk "columns"))))
          (paren
            (apply
