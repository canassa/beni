-- A `case` nested in a `case` branch: the inner branch list ends when a token
-- appears left of its column (§4), and that token either continues the OUTER
-- branch or starts the next outer branch. Three shapes: inner case as the
-- whole body; inner case inside a `let` whose `in` continues the outer branch;
-- inner branches only one column right of the outer pattern column.
combine : Maybe Int, Maybe Int → Int
combine a b =
    case a of
        Just x →
            case b of
                Just y →
                    x + y

                Nothing →
                    x

        Nothing →
            0


combineLet : Maybe Int, Maybe Int → Int
combineLet a b =
    case a of
        Just x →
            y =
                case b of
                    Just z →
                        z

                    Nothing →
                        0
            x + y

        Nothing →
            0


tight : Maybe Int, Maybe Int → Int
tight a b =
    case a of
        Just x →
         case b of
          Just y → x + y
          Nothing → x

        Nothing → 0
