-- `let x <- e` (§3 `LetBinding`, §6.7): a bind as the only binding, as the
-- last one, in the middle of a block, several in a row, with a tuple
-- pattern, with `_`, and inside a `case` branch, which opens its own `let`.
only f =
    x <- f 1
    x


afterOthers f =
    a = 1
    x <- f a
    x


inTheMiddle f g =
    a = 1
    x <- f a
    b = 2
    g x b


several f g =
    x <- f 1
    y <- g x
    x + y


tuplePattern f =
    ( x, y ) <- f 1
    x + y


ignored f g =
    _ <- f 1
    g 2


bareCallee f =
    x <- f
    x


inBranch f m =
    case m of
        Just v ->
            x <- f v
            x

        Nothing ->
            0
