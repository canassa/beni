(module
  (definition inc
    (lambda
      (pat_var n)
      (add
        (ident n)
        (int 1))))
  (definition pairs
    (pat_var xs)
    (apply
      (ident List.map)
      (ident xs)
      (lambda
        (pat_tuple
          (pat_var a)
          (pat_var b))
        (add
          (ident a)
          (ident b)))))
  (definition nested
    (lambda
      (pat_var a)
      (lambda
        (pat_var b)
        (add
          (ident a)
          (ident b)))))
  (definition thunk
    (lambda
      (pat_unit)
      (int 0)))
  (definition both
    (lambda
      (pat_record name)
      (pat_wild)
      (ident name)))
  (definition text
    (lambda
      (pat_var x)
      (multiline_string "raw \x" "more")))
  (definition escaped
    (lambda
      (pat_wild)
      (string
        (chunk "a\\b"))))
  (definition rows
    (pat_var items)
    (markup_element ul
      (markup_hole
        (apply
          (ident List.map)
          (ident items)
          (lambda
            (pat_var i)
            (markup_element li
              (markup_attr onClick braced
                (lambda
                  (pat_wild)
                  (ident i)))
              (markup_hole
                (ident i)))))))))
