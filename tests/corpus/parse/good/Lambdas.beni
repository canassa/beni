-- Lambdas with one, two and many parameters, destructuring parameters,
-- wildcards, a lambda applied directly, a lambda as an argument, and lambdas
-- returning lambdas.
inc = λn → n + 1


add = λa b → a + b


swap = λ( a, b ) → ( b, a )


nameOf = λ{ name } _ → name


curried = λa → λb → λc → a + b + c


applyTwice f x = (λg y → g (g y)) f x


sumPairs xs = List.map xs λ( a, b ) → a + b


ignoreAll = λ_ _ _ → ⊤


multiLine =
    λx →
        y = x + 1
        y * 2
