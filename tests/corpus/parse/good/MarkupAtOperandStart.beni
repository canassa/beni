-- A `<` followed by a letter or `>`, after a token that cannot end an
-- operand, opens markup (frontend.md §9.3): after `=`, `(`, `[` and `,`,
-- `->` and `<|`. The tokens show each `markup_open`, and the tree each
-- markup expression where the operand stands: a definition's body, an
-- argument in parentheses, list elements, a lambda's body, `<|`'s operand.
bold = <b />


paren f = f (<b />)


items = [ <li />, <li /> ]


row = λr -> <tr />


piped f = f <| <>x</>
