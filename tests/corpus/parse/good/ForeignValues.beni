-- `foreign pure name : Type` declarations (§5.4): private and `pub`, with and
-- without a doc comment, with type variables, function and record types.
-- Parsing is legal in every file; only lowering cares about `--core`.
--| Add two numbers.
pub foreign pure add : number, number -> number


pub foreign pure length : String -> Int


foreign pure unsafeCoerce : a -> b


--| Private, documented, record-typed.
foreign pure origin : { x : Float, y : Float }


double : Int -> Int
double n =
    add n n
