-- `foreign name : Type` declarations (§5.4): private and `pub`, with and
-- without a doc comment, with type variables, function and record types.
-- Parsing is legal in every file; only lowering cares about `--core`.
--| Add two numbers.
pub foreign add : number, number -> number


pub foreign length : String -> Int


foreign unsafeCoerce : a -> b


--| Private, documented, record-typed.
foreign origin : { x : Float, y : Float }


double : Int -> Int
double n =
    add n n
