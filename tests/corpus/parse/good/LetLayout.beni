-- `let` layout variants of §4 rule 3: `in` aligned with `let`; `in` on the
-- same line as the last body; `let` on the head line with bindings at an
-- unusual column set by the first binding; and nested lets whose inner `in`
-- ends the inner list but stays inside the outer binding's body.
a =
    let
        x =
            1
    in
    x


b =
    let x = 1
        y = 2 in x + y


c = let
      x = 1
      y =
        x
    in
      y


d =
    let
        outer =
            let
                inner =
                    3
            in
            inner
    in
    outer
