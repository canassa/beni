-- Operators, `then`, `else`, `of`, `->`, `=`, `:`, `|` and arguments
-- may all begin a line (§4 rule 5) as long as they sit right of the enclosing
-- block's indent; a binding's own `=` stays on its head's line in a block (§12.2).
type Msg
  = Inc
  | Dec
  |
    Reset


total xs =
    xs
        |> List.map (λx -> x * 2)
        |> List.filter (λx -> x > 2)
        |> List.sum


longSum a b c d =
    a
        + b
        + c
        + d


split a b =
    a
        - b - a
    - b


pick flag a b =
    if flag
    then a
    else b


branch m =
    case
        m
    of
        Just x
            ->
                x

        Nothing
            -> 0



args =
    max
        1
        2


annotated
    : Int
annotated
    =
    3
