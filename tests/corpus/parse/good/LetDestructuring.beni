-- Pattern bindings in `let` (§3, LetBinding): tuple, nested tuple, record,
-- and wildcard patterns, mixed with ordinary definitions, an annotated
-- binding, and a binding used before its textual position. A list pattern is
-- refutable (§7) and so lives in a `case` instead.
split : ( Int, ( String, Bool ) ) -> String
split input =
    let
        ( n, ( s, flag ) ) =
            input

        { name, age } =
            person

        ( first, second ) =
            case [ n, n + 1 ] of
                [ a, b ] ->
                    ( a, b )

                _ ->
                    ( n, n )

        _ =
            flag

        person =
            { name = s, age = n }

        total : Int
        total =
            first + second + age
    in
    "${name}:${total}"
