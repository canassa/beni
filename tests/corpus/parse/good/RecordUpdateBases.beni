-- The base of a record update is a name, a call whose head is a name or a
-- qualified name and whose arguments are atoms, the last of which may be a
-- lambda (language.md §12.3), or a parenthesised expression (language.md
-- §6.3, ownership-checker.md §31.15); a record literal still begins `name
-- =`. And `{ r | }` is any record, an extensible record type with no field
-- (language.md §3).
copy : { r | } → { r | }
copy r = r


named model = { model | count = 1 }


qualifiedCall model = { Record.copy model | count = 1 }


qualifiedValue = { Schema.defaultOptions ⊤ | maxDepth = 4 }


localCall defaults = { defaults ⊤ | count = 1, name = "n" }


atomArguments pick model = { pick model.form (Just 1) [ 2 ] | name = "n" }


placeholder f = { f _ | name = "n" }


parenthesised pick model = { (pick model) | count = 1 }


nestedBase model = { ({ model | count = 1 }) | count = 2 }


literal count = { count = count }


trailingLambda withConfig = { withConfig λx → x + 1 | count = 2 }
