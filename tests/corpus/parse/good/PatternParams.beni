-- Destructuring in function and lambda parameters (PatAtom only): tuples,
-- records, wildcards, unit, a parenthesised constructor pattern, `as`, and
-- nesting; the type used is declared after its first use. A constructor
-- parameter PARSES here whatever its type is — §7 leaves "does it match
-- everything?" to the checker — while a list parameter, with a spread or not, can never
-- match everything and is a parse error (`parse/bad/RefutableParameterList`).
first ( a, _ ) =
    a


fullName { firstName, lastName } =
    "${firstName} ${lastName}"


constant _ =
    0


fromUnit () =
    1


unbox (Box inner) =
    inner


type Box
    = Box Int


keep (( a, b ) as pair) =
    ( pair, a, b )


deep ( ( a, b ), { c } ) =
    a + b + c


lambdaParams =
    \( a, b ) { c } (Box d) -> a + b + c + d
