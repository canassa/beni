-- Mutually recursive `let` definitions: all bindings of one `let` are in scope
-- in every body (§7), regardless of textual order.
isEven : Int → Bool
isEven n =
    even k =
        if k == 0 then
            True
        else
            odd (k - 1)

    odd k =
        if k == 0 then
            False
        else
            even (k - 1)
    even n
