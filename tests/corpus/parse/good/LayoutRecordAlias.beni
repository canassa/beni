-- Layout spelling of BraceRecordAlias.beni. Its AST and BIR must be identical.
type alias Contact =
    --| The display name.
    name : String
    --| The postal address.
    address :
        --| The street.
        street : String
        --| The city.
        city : String
    --| A saturated greeting function.
    greet : String, Int -> String
    --| A type application split over several lines.
    result :
        Result
            String
            (List Int)
