[{"code":"trusted_types_sink","severity":"error","span":{"file":"Main.beni","start":{"line":13,"col":20},"end":{"line":13,"col":26}},"title":"TRUSTED TYPES SINK","message":"This project says `\"trustedTypes\": true` in its beni.json, and `srcdoc` hands\nthe frame its document as markup text, a Trusted Types sink. The page's Content\nSecurity Policy would refuse it, and the page would stop. Take it out, or take\nthe key out if the page is not served under Trusted Types."}]
