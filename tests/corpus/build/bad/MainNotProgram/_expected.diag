[{"code":"main_not_program","severity":"error","span":{"file":"Main.beni","start":{"line":5,"col":1},"end":{"line":5,"col":5}},"title":"MAIN IS NOT A PROGRAM","message":"`main` must be a `Node.Program`.\n\nThis one is annotated `Basics.Int`. The platform owns the type of the entry point and\nhands out the only values of it (`docs/design/boundary.md` §5); a `Program` is\nwhat you get back from one of its functions."}]
