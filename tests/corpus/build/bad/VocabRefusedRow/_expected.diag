[{"code":"duplicate_declaration","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":29,"col":13},"end":{"line":29,"col":21}},"title":"DUPLICATE DECLARATION","message":"`dialog` declares the fact `void` twice.\n\nA declaration's facts are a set (`docs/design/checker-v2.md` §25.2): write each\nonce."},{"code":"unbound_variable","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":35,"col":11},"end":{"line":35,"col":20}},"title":"NAMING ERROR","message":"The event `onProbe` takes its payload `via missing`, which is not a `foreign` or\nan annotated value of this module.\n\nA payload extractor is a `foreign` value, or a beni declaration with an\nannotation, declared beside the event (`docs/design/boundary.md` §9.3)."},{"code":"type_mismatch","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":38,"col":15},"end":{"line":38,"col":22}},"title":"TYPE MISMATCH","message":"The attribute `count` must have one of the value types a lowering can write.\n\nAn attribute's value type is `String`, `Int`, `Float`, `Bool` or\n`Maybe String` (`docs/design/language.md` §11.14)."},{"code":"type_mismatch","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":41,"col":15},"end":{"line":41,"col":23}},"title":"TYPE MISMATCH","message":"The attribute `data-*` must have one of the value types a lowering can write.\n\nAn attribute's value type is `String`, `Int`, `Float`, `Bool` or\n`Maybe String` (`docs/design/language.md` §11.14)."},{"code":"duplicate_declaration","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":47,"col":15},"end":{"line":47,"col":22}},"title":"DUPLICATE DECLARATION","message":"`label` is declared twice: the attribute `label` above answers the same names on\nthe same elements.\n\nOf two declarations that could answer a name, the exact one wins, then the\npattern with the longer literal part (`docs/design/language.md` §11.14); these\ntwo tie, so which one answered would be arbitrary."},{"code":"duplicate_declaration","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":53,"col":11},"end":{"line":53,"col":18}},"title":"DUPLICATE DECLARATION","message":"`title` is declared twice: the attribute `title` above answers the same names on\nthe same elements.\n\nOf two declarations that could answer a name, the exact one wins, then the\npattern with the longer literal part (`docs/design/language.md` §11.14); these\ntwo tie, so which one answered would be arbitrary."}]
