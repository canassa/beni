-- Any cannot cross an entry boundary, including inside a List.
import Js.Any as Any
import Page
import Worker


worker : Worker.Program (List Any.Any) Int ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle = λ_ _ _ → 0
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤


pub packet : Any.Any
packet = Any.pack { answer = 42 }
