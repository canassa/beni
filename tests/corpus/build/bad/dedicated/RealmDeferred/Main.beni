-- Stored and returned callbacks must keep their execution realm.
import Deferred
import Page
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


cell : Deferred.Deferred (⊤ → ⊤)
cell = Deferred.make ⊤


go _ =
    _ = Deferred.complete cell pageCb
    (Deferred.wait cell) ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
