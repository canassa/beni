-- A launch passed as a callback must fail before emitting a missing URL.
import Page
import Worker


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle = λmessage _ _ → message
        , stream = λ_ _ _ _ → ⊤
        }


apply :
      (Worker.Program String String ⊤ → Result Worker.OpenError (Worker.Handle String String))
    , Worker.Program String String ⊤
    → Result Worker.OpenError (Worker.Handle String String)
apply f p = f p


start : ⊤ → ⊤
start _ =
    _ = apply Worker.open worker
    ⊤


main : Page.Program
main = Page.program start
