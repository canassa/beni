-- A launch alias must be diagnosed instead of emitting a missing URL.
import Page
import Worker


worker : Worker.Program
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle = λmessage _ _ → message
        , stream = λ_ _ _ _ → ⊤
        }


openIt : Worker.Program → Result Worker.OpenError Worker.Handle
openIt = Worker.open


start : ⊤ → ⊤
start _ =
    _ = openIt worker
    ⊤


main : Page.Program
main = Page.program start
