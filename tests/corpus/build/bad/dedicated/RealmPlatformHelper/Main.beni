-- A native page operation must remain visible in the worker's inferred summary.
import Page
import Worker


worker : Worker.Program
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λmessage _ _ →
                Page.text message
                message
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
