-- Stored and returned callbacks must keep their execution realm.
import Cells as Ref
import Page
import Storage
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


cell : Ref.Slot (⊤ → ⊤)
cell = Ref.make λ⊤ → ⊤


setIt _ = Storage.replace cell pageCb


callIt _ = (Ref.get cell) ⊤


go _ =
    setIt ⊤
    callIt ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
