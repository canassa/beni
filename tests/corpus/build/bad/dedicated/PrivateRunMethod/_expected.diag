[{"code":"private_method","severity":"error","span":{"file":"Main.beni","start":{"line":20,"col":29},"end":{"line":20,"col":33}},"title":"PRIVATE METHOD","message":"`Browser.Worker.run` is private to the platform’s worker entry modules,\n`Browser.Worker` and `Browser.WorkerRuntime`.\n\n`x.run` needs the `run` of `Program`, declared in `Browser.Worker`.\n`Browser.Worker` declares it `pub`, but only those modules may use it."}]
