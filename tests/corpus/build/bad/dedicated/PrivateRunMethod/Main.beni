-- `worker.run` reaches `Browser.Worker.run`, which is `pub`, but only the
-- platform's worker entry modules may use it. The text names the method,
-- its type and those modules (#1755).
import Browser
import Browser.Worker as Worker


worker : Worker.Program ⊤ ⊤ (Worker.Protocol ⊤ ⊤ ⊥ String ⊥ ⊥)
worker =
    Worker.program
        { init = λ_ _ → Ok ⊤
        , start = λ_ _ → ⊤
        , handle = λ_ _ _ → Ok ⊤
        }


main : Browser.Program
main =
    Browser.program
        { init = λ⊤ → worker.run
        , update = λ_ model → model
        , view = λ_ → <main />
        }
