-- Stored and returned callbacks must keep their execution realm.
import Page
import Ref
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


type Box a
    = Box a


cell : Ref.Ref (Box (⊤ → ⊤))
cell = Ref.make (Box λ⊤ → ⊤)


put : Ref.Ref (Box a), a → ⊤
put r x = Ref.set r (Box x)


setIt _ = put cell pageCb


callIt _ =
    case Ref.get cell of
        Box callback →
            callback ⊤


go _ =
    setIt ⊤
    callIt ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
