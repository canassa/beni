[{"code":"worker_realm_violation","severity":"error","span":{"file":"Main.beni","start":{"line":8,"col":1},"end":{"line":8,"col":7}},"title":"WORKER REALM VIOLATION","message":"`RealmJs.timerString` uses `setTimeout` without a first argument that is\nprovably a function. A string there runs code the realm check cannot see.\nDynamic code is refused in entry realm `dedicatedWorker`."}]
