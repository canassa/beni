-- Stored and returned callbacks must keep their execution realm.
import Page
import Ref
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


go _ =
    cell = Ref.make λ⊤ → ⊤
    Ref.set cell pageCb
    (Ref.get cell) ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
