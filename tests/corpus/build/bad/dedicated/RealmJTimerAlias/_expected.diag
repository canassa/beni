[{"code":"worker_realm_violation","severity":"error","span":{"file":"Main.beni","start":{"line":8,"col":1},"end":{"line":8,"col":7}},"title":"WORKER REALM VIOLATION","message":"`RealmJs.timerAlias` uses `setTimeout` without a first argument that is provably\na function. A string there runs code the realm check cannot see. Dynamic code is\nrefused in entry realm `dedicatedWorker`."}]
