-- Stored and returned callbacks must keep their execution realm.
import Page
import RealmProbe
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


recv = RealmProbe.mkRecv ⊤


go _ = recv pageCb


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
