[{"code":"module_worker_import_scripts","severity":"error","span":{"file":"Main.beni","start":{"line":8,"col":1},"end":{"line":8,"col":7}},"title":"IMPORTSCRIPTS IN A MODULE WORKER","message":"`RealmJs.selfImportScripts` uses JavaScript access `self.importScripts`. A\nmodule worker has no `importScripts`, so entry realm `dedicatedWorker` would\nthrow `TypeError`. Use an ordinary static import."}]
