-- A nominal holder joins both callbacks even when only its safe field is called.
import Browser.Host.Document as Document
import Browser.Host.Window as Window
import Page
import Worker


dom : ⊤ → String
dom _ =
    case Document.querySelector (Window.document ⊤) "body" of
        Ok _ →
            "found"
        Err _ →
            "bad selector"


type Pair
    = Pair (⊤ → String) (⊤ → String)


actions = Pair (λ_ → "safe") dom


read pair =
    case pair of
        Pair safe _ →
            safe ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle = λ_ _ _ → read actions
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
