-- Stored and returned callbacks must keep their execution realm.
import Page
import Queue
import Worker


pageCb : ⊤ → ⊤
pageCb _ = Page.text "page"


cell : Queue.Queue (⊤ → ⊤)
cell = Queue.unbounded ⊤


go _ =
    _ = Queue.offer cell pageCb
    case Queue.take cell of
        Just cb →
            cb ⊤
        Nothing →
            ⊤


worker : Worker.Program String String ⊤
worker =
    Worker.program
        { init = λ_ _ → ⊤
        , start = λ_ _ → ⊤
        , handle =
            λ_ _ _ →
                go ⊤
                "safe"
        , stream = λ_ _ _ _ → ⊤
        }


main : Page.Program
main = Page.program λ_ →
    case Worker.open worker of
        Ok _ →
            ⊤
        Err _ →
            ⊤
