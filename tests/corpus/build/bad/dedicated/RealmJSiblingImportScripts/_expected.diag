[{"code":"module_worker_import_scripts","severity":"error","span":{"file":"tests/platforms/worker/RealmJs.js","start":{"line":4,"col":51},"end":{"line":4,"col":61}},"title":"IMPORTSCRIPTS IN A MODULE WORKER","message":"This file is kept in entry realm `dedicatedWorker`, and it uses JavaScript\naccess `globalThis.importScripts`. A module worker has no `importScripts`, so it\nwould throw `TypeError`. Use an ordinary static import."}]
