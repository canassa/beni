[{"code":"markup_type_in_foreign","severity":"error","span":{"file":"platform/Render.beni","start":{"line":4,"col":18},"end":{"line":4,"col":24}},"title":"MARKUP TYPE IN FOREIGN","message":"The `foreign` value `render` has a type that mentions the markup type\n`Html.Html`.\n\nIts JavaScript builds or reads the markup of one markup lowering, so it is\nlegal only in a platform whose own manifest names the lowering the build\nselects; under another, it would hand that lowering's runtime a value it\nmisreads. This build selects `ssr`, and this platform names none.\n\nHint: a markup primitive, `pub markup render : …` in the vocabulary module, is\nimplemented by every lowering's runtime and serves them all."}]
