[{"code":"trusted_types_sink","severity":"error","span":{"file":"Main.beni","start":{"line":13,"col":20},"end":{"line":13,"col":23}},"title":"TRUSTED TYPES SINK","message":"This project says `\"trustedTypes\": true` in its beni.json, and the raw attribute\n`innerHTML` writes its text into the page as markup, through `innerHTML`, a\nTrusted Types sink. The page's Content Security Policy would refuse it, and the\npage would stop. Take it out, or take the key out if the page is not served\nunder Trusted Types."},{"code":"raw_markup_attribute","severity":"warning","span":{"file":"Main.beni","start":{"line":13,"col":24},"end":{"line":13,"col":33}},"title":"RAW MARKUP ATTRIBUTE","message":"`innerHTML` writes its value into the page as markup, unescaped.\n\nWhatever the value holds becomes part of the page, script included, so only\nmarkup this program built itself is safe to give it."}]
