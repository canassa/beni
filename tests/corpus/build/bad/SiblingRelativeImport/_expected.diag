[{"code":"not_implemented","severity":"error","span":{"file":"platform/Prog.beni","start":{"line":6,"col":13},"end":{"line":6,"col":16}},"title":"NOT IMPLEMENTED YET","message":"`platform/Prog.js` imports \"./helper.js\", and I cannot relocate that yet.\n\nA sibling file is RENAMED as it is copied into the output — `Prog.js` becomes\n`<Module>.foreign.mjs`, so that every emitted file is an ES module by extension\n(`docs/design/backend.md` §2). A specifier that names a file would then point\nat a name that no longer exists, and the build would succeed while the program\nfailed to load. Rewriting them is M3b's; for now, import a package\n(`node:process`, a dependency) or inline the helper."}]
