[{"code":"no_methods_on_shape","severity":"error","span":{"file":"Main.beni","start":{"line":6,"col":7},"end":{"line":6,"col":17}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    Dict key v\n\nDict and Set have no compare because insertion order is part of their value.\nA type holding one cannot derive compare. Give your own wrapper a pub compare\nthat orders the fields you choose, or pass an ordering function instead.\n"}]
