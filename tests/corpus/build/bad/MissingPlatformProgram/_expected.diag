[{"code":"main_not_program","severity":"error","span":{"file":"Main.beni","start":{"line":5,"col":1},"end":{"line":5,"col":5}},"title":"MAIN IS NOT A PROGRAM","message":"`main` must be a `Start.Program`.\n\nThis one is annotated `Start.Program`. The platform owns the type of the entry\npoint and hands out the only values of it (`docs/design/boundary.md` §5); a\n`Program` is what you get back from one of its functions."}]
