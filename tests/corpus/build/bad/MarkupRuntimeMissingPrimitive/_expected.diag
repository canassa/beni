[{"code":"foreign_export_mismatch","severity":"error","span":{"file":"platforms/html/Html.beni","start":{"line":35,"col":12},"end":{"line":35,"col":15}},"title":"FOREIGN EXPORT MISMATCH","message":"The markup runtime `platform/markup.js` does not export `map`.\n\nA markup primitive is implemented by the build's markup runtime, one export of\nits name (`docs/design/boundary.md` §9.3, §9.4.5). Add\n`export const map = …;` to it."}]
