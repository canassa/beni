[{"code":"foreign_export_mismatch","severity":"error","span":{"file":"platform/markup.js","start":{"line":1,"col":1},"end":{"line":1,"col":1}},"title":"FOREIGN EXPORT MISMATCH","message":"This markup runtime does not export `escape`, which the markup lowering `ssr`\nimports.\n\nA markup runtime exports exactly what its lowering declares, the vocabulary's\nmarkup primitives and, when it is the program runtime too, `run`\n(`docs/design/boundary.md` §9.4.5). Add `export const escape = …;` taking 1\nparameter."}]
