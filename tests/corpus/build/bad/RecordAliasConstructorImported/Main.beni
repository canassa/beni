-- build/bad: an IMPORTED record alias's constructor is refused at emit,
-- `not_implemented` at `P`, until interface v3 carries the field names
-- (CK-39, slice R3). Its local twin builds the record (backend.md §4, D12,
-- CK-43); the checker types this use as an opaque nominal (CK-39), so the only
-- programs that reach emit use the value where no field is read, like this
-- one, and writing 7427828's tagged object for them would give one type two
-- shapes at run time.
import Node exposing (Program)
import Pt exposing (P)


main : Program
main =
    Node.printLines [ Debug.toString (P 1 "a") ]
