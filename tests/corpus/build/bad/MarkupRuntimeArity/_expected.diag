[{"code":"foreign_arity_mismatch","severity":"error","span":{"file":"platform/markup.js","start":{"line":6,"col":14},"end":{"line":6,"col":18}},"title":"FOREIGN ARITY MISMATCH","message":"`list` is written with 2 parameters, and the markup lowering `ssr` calls it with\n3 arguments.\n\nEvery call emitted code makes is saturated (`docs/design/backend.md` §6), so a\nmiscounted export takes an argument that never arrives\n(`docs/design/boundary.md` §4, check 4; §9.4.5). Write its parameter list at the\nexport: 3 parameters."},{"code":"foreign_arity_mismatch","severity":"error","span":{"file":"platforms/html/Html.beni","start":{"line":35,"col":12},"end":{"line":35,"col":15}},"title":"FOREIGN ARITY MISMATCH","message":"`platform/markup.js:11:14` writes `map` with 1 parameter, and `map` takes 2.\n\nA sibling export takes exactly the parameters its `foreign` declaration promises\n(`docs/design/boundary.md` §4, check 4). Every call the compiler emits is\nsaturated (`docs/design/backend.md` §6), so a miscount is never a partial\napplication: it is an argument that arrives nowhere."}]
