[{"code":"prerender_data_ignored","severity":"warning","span":{"file":"beni.json","start":{"line":1,"col":1},"end":{"line":1,"col":1}},"title":"DATA PROGRAM IGNORED","message":"This project names a data program in `\"build\".\"data\"`, and its `main` does not\nsay `Browser.prerenderData`, so the build neither builds nor runs it. Make\n`main` a `Browser.prerenderData`, or take `\"data\"` out\n(`docs/design/prerender.md` §8.5)."},{"code":"program_shape","severity":"error","span":{"file":"src/Main.beni","start":{"line":34,"col":8},"end":{"line":34,"col":29}},"title":"PROGRAM SHAPE","message":"`Browser.prerenderData` says which program the build prerenders from each page's\nvalue, so it is written where `main` says what the page's program is:\n`main = Browser.prerenderData (Page.schema ⊤) λpage → Tea.document { … }`, or\ninside a `Browser.mountAt` there (`docs/design/prerender.md` §8.4). Here it is\nsomewhere else, where the build would not see it."}]
