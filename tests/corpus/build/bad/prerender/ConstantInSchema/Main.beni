-- A constant computed from the clock, read by a schema's conversion that
-- `view` runs (docs/design/prerender.md §3.1, amended for #1170):
-- `Count.parse` runs `shifted`, whose code reads `Codec.seed`. A schema
-- member's conversions are in its plan, which the walk does not follow, so
-- it refuses the member's use when any constant of the program's modules
-- may have an effect. The build accepted it before, and the page held the
-- build machine's clock.
import Browser
import Codec exposing (Count)
import Html exposing (Html)
import Tea


type Msg
    = Inc


update : Msg, Int → Int
update msg model =
    case msg of
        Inc →
            model + 1


shown : Int → Int
shown model =
    case Count.parse "\"42\"" of
        Ok n →
            n + model

        Err _ →
            0


view : Int → Html Msg
view model =
    <div data-role="app">
        <output>{shown model}</output>
        <button onClick={Inc}>+</button>
    </div>


main : Tea.Program
main =
    Browser.prerender
        (Browser.mountAt (Tea.sandbox { init = λ⊤ → 0, update = update, view = view }) "root")
        [ "/" ]
