-- A prerendered `view` with `let`s: `browser-inline` does not compile one yet
-- (docs/design/browser-inline.md §8.2, amended 2026-11-23; §5, class 1).
import Browser
import Html exposing (Html)
import Tea


view : Int → Html Int
view n =
    label = "count ${String.fromInt n}"
    <main><output>{label}</output><button onClick={n + 1}>+</button></main>


main : Tea.Program
main = Browser.prerender (Tea.sandbox { init = λ⊤ → 0, update = λn _ → n, view = view }) [ "/" ]
