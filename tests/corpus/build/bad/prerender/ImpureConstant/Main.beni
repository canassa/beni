-- A top-level constant is computed when its module loads, in the build as
-- in the browser (docs/design/prerender.md §3.1, amended): one computed by
-- reading the clock makes the two first renders differ, so a `view` that
-- reads it is refused at the read.
import Browser
import Clock
import Html exposing (Html)
import Tea


type alias Model =
    count : Int


type Msg
    = Inc


seed : Int
seed = Clock.now ⊤


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }


view : Model → Html Msg
view model =
    <div data-role="app">
        <output>{model.count + seed}</output>
        <button onClick={Inc}>+</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt (Tea.sandbox { init = λ⊤ → { count = 0 }, update = update, view = view }) "root"
