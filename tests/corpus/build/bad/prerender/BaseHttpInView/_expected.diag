[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":25,"col":82},"end":{"line":25,"col":86}},"title":"SUSPENDING CALLBACK","message":"The `view` function here must not suspend: `Tea.sandbox` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `view` calls `greeting`, and `greeting` calls `Http.get`,\nwhich suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
