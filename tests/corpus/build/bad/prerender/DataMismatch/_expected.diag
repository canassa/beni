[{"code":"prerender_data_invalid","severity":"error","span":{"file":"src/Main.beni","start":{"line":32,"col":8},"end":{"line":32,"col":29}},"title":"PAGE DATA DOES NOT DECODE","message":"This program prerenders from each page's value, and its schema cannot decode the\ntext the data program gave for the route `/`, so the build has no value to\nrender the page from (`docs/design/prerender.md` §8.5):\n\n.start: expected a number\n\nThe data program encodes each value with its schema, and this program decodes it\nwith its own: the two must agree."}]
