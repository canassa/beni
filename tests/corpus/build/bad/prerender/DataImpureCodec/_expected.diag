[{"code":"prerender_impure","severity":"error","span":{"file":"src/Main.beni","start":{"line":33,"col":31},"end":{"line":33,"col":45}},"title":"IMPURE PRERENDERED PROGRAM","message":"This program prerenders from each page's value, and decoding the value runs this\nconversion, which may have an effect or wait: it may read or change something\noutside the program. The build decodes each page's value with the schema, and\nthe browser decodes the same text with it again before `init`, so a read of the\nhost, the clock or randomness could make the two values differ\n(`docs/design/prerender.md` §8.4, §3.1). Make the conversion pure."}]
