[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":31,"col":22},"end":{"line":31,"col":26}},"title":"SUSPENDING CALLBACK","message":"The `init` function here must not suspend: `Tea.element` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `init` calls `Http.get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
