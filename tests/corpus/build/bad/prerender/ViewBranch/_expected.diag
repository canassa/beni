[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":18,"col":82},"end":{"line":18,"col":86}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` does not compile a branch whose arms\nread what it binds, or a `view` whose body is an `if` or a `case`, on a page\nthat prerenders yet (`docs/design/browser-inline.md` §8.2; §5, class 1). Write\nthe `view` without it, or build this program with `--platform=browser-tea`,\nwhich compiles it."}]
