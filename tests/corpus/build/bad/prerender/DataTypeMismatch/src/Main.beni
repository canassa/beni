-- An `init` that reads a field the page's schema does not have
-- (docs/design/prerender.md §8.4): the value's type is the schema's Type
-- endpoint, so the checker refuses it, as it refuses any other expression.
import Browser
import Html exposing (Html)
import Start exposing (Start)
import Tea


type alias Model =
    count : Int


type Msg
    = Inc


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }


view : Model → Html Msg
view model =
    <main>
        <output id="count">{String.fromInt model.count}</output>
        <button id="inc" onClick={Inc}>+</button>
    </main>


main : Tea.Program
main = Browser.prerenderData (Start.schema ⊤) λstart →
    Tea.sandbox { init = λ⊤ → { count = start.begin }, update = update, view = view }
