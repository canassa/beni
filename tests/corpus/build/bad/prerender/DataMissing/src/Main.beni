-- A program that says `Browser.prerenderData` in a project whose
-- `beni.json` names no `"build"."data"` (docs/design/prerender.md §8.5
-- item 1): `prerender_needs_data`, against `beni.json` at 1:1, and nothing
-- is built or run.
import Browser
import Html exposing (Html)
import Start exposing (Start)
import Tea


type alias Model =
    count : Int


type Msg
    = Inc


update : Msg, Model → Model
update msg model =
    case msg of
        Inc →
            { model | count = model.count + 1 }


view : Model → Html Msg
view model =
    <main>
        <output id="count">{String.fromInt model.count}</output>
        <button id="inc" onClick={Inc}>+</button>
    </main>


main : Tea.Program
main = Browser.prerenderData (Start.schema ⊤) λstart →
    Tea.sandbox { init = λ⊤ → { count = start.start }, update = update, view = view }
