[{"code":"output_path_collision","severity":"error","span":{"file":"Main.beni","start":{"line":14,"col":1},"end":{"line":14,"col":5}},"title":"OUTPUT PATHS COLLIDE","message":"This program prerenders the routes `/About` and `/about`, whose pages are one\nfile on a file system that folds case, as macOS (APFS) and Windows (NTFS) do:\n\n- `About.html`, written for `/About`\n- `about.html`, written for `/about`\n\nA build's output is the same set of files on every file system, so this is\nrefused and nothing is written (`docs/design/prerender.md` §7.4;\n`docs/design/backend.md` §2). List each page once, under one spelling."}]
