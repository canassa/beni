[{"code":"unknown_exports_mode","severity":"error","span":{"file":"platform/beni.json","start":{"line":1,"col":1},"end":{"line":1,"col":1}},"title":"UNKNOWN EXPORTS MODE","message":"This platform declares `\"exports\"` as a list, which only an app's `beni.json`\nmay hold.\n\nA platform declares the mechanism, `\"exports\": \"program\"`, and the app lists the\nnames (`docs/design/boundary.md` §5.2)."}]
