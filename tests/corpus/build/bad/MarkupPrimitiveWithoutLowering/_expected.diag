[{"code":"unknown_markup_lowering","severity":"error","span":{"file":"platforms/node/beni.json","start":{"line":1,"col":1},"end":{"line":1,"col":1}},"title":"UNKNOWN MARKUP LOWERING","message":"This build uses the markup primitive `Html.text`, but the platform `node` names\nno markup lowering to implement it.\n\nA markup primitive is implemented by the runtime of the build's markup lowering\n(`docs/design/boundary.md` §9.3), which a platform names in its manifest's\n`\"markup\"` `\"lowering\"`, or inherits from a platform it depends on."}]
