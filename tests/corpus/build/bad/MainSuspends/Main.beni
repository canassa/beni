-- `must_not_suspend` at `main` (transparent-effects-proposal.md §15.2 item
-- 5, the owner's decision 5a): `main : Program` stays, and its body is
-- evaluated once, when the program starts, outside any fiber, so it must
-- not suspend. Here it calls `greeting`, whose body calls `Remote.lookup`,
-- which suspends because `Remote`'s record says so: the chain names the two
-- calls in this module and stops at the import (decision 7a). A thunk that
-- would suspend is a pure value to build (`later`), so it is no refusal.
import Prog exposing (Program)
import Remote


main : Program
main =
    later = λ⊤ → Remote.lookup "later"
    Prog.say (greeting "world")


greeting : String → String
greeting name = Remote.lookup name
