[{"code":"must_not_suspend","severity":"error","span":{"file":"Main.beni","start":{"line":13,"col":1},"end":{"line":13,"col":5}},"title":"MUST NOT SUSPEND","message":"`main` must not suspend: it is evaluated once, when the program starts, where\nnothing can wait for it.\n\nBut it may suspend: `main` calls `greeting`, and `greeting` calls\n`Remote.lookup`, which suspends.\n\nHint: `main` only describes the program. A value that may suspend can only be\ncomputed by a function the platform runs, never while `main` is evaluated.\n"}]
