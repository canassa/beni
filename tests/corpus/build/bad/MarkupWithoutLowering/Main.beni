-- `unknown_markup_lowering` (boundary.md §9.2) for markup itself: the
-- program's markup checks against the vocabulary its platform `bare`
-- inherits from `html`, and it survives elimination because `main` reaches
-- it; but markup compiles through the build's markup lowering and `bare`
-- names none, nor does `html`, so the build is refused against `bare`'s
-- manifest before a byte is written.
import Html exposing (Html)
import Prog exposing (Program)


greeting : String -> Html msg
greeting name = <p>Hello, {name}!</p>


main : Program
main =
    let
        _ = greeting "world"
    in
    Prog.say "hello"
