[{"code":"unknown_markup_lowering","severity":"error","span":{"file":"platform/beni.json","start":{"line":1,"col":1},"end":{"line":1,"col":1}},"title":"UNKNOWN MARKUP LOWERING","message":"This build writes markup in `Main.greeting`, but the platform `bare` names no\nmarkup lowering to compile it.\n\nMarkup compiles through the build's markup lowering (`docs/design/boundary.md`\n§9.4), which a platform names in its manifest's `\"markup\"` `\"lowering\"`, or\ninherits from a platform it depends on."}]
