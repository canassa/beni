-- A shared initial dictionary cannot establish the fold's invariant.
import Dict
import Tea


shared = Dict.insert Dict.empty 1 [ 0 ]


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                Dict.foldr (Dict.fromList [ ( 1, 1 ), ( 2, 2 ) ]) shared λ_ x acc →
                    Dict.update acc 1 λold → Just (List.append (Maybe.withDefault old []) [ x ])
        , update = λ_ model → model
        , view = λmodel → <p>{List.length (Maybe.withDefault (Dict.get model 1) [])}</p>
        }
