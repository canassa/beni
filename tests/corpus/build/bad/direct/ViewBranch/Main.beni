-- A `view` whose body, past its `let`s, computes its markup — an `if`
-- here — is not markup written in place, which `browser-direct` compiles a
-- `view`'s body as (docs/design/browser-direct.md §11.1; S4's amendment,
-- item 4, as built): `not_implemented` at the field, naming the markup that
-- holds it, `<>{…}</>`, where §5.5 compiles the branch.
import Html exposing (Html)
import Tea


view : Bool → Html {}
view on =
    label = if on then "on" else "off"

    if on then
        <b>{label}</b>
    else
        <i>{label}</i>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → True, update = λ_ m → m, view = view }
