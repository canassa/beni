-- An `update` a call computes is the single `*` message key, which
-- `browser-direct` compiles from slice S1 (docs/design/browser-direct.md
-- §4.1): until then it is `not_implemented` at the field, and the message
-- says it is a gap in the platform, not a rule of the language.
import Html exposing (Html)
import Tea


view : Int → Html Int
view _ = <p>count</p>


bump : Int, Int → Int
bump by n = n + by


withLogging : (Int, Int → Int) → (Int, Int → Int)
withLogging f = λmsg model → f msg model


main : Tea.Program
main = Tea.sandbox { init = 0, update = withLogging bump, view = view }
