[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":22,"col":41},"end":{"line":22,"col":52}},"title":"NOT IMPLEMENTED YET","message":"`browser-direct` does not compile an `update` that is computed — a call such as\n`withLogging update`, a local — yet: it is the single `*` message key, which\narrives with slice S1 (`docs/design/browser-direct.md` §4.1, §14). This is a gap\nin what the platform compiles, not a rule of the language: no guarantee is at\nstake, and the program is fine as written. Build this program with\n`--platform=browser-tea` until then."}]
