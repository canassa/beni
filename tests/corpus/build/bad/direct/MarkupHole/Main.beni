-- A hole whose value is a `case` choosing markup written in place is a
-- branch, item 3 of slice S4's amendment (docs/design/browser-direct.md
-- §5.5), not yet built: `not_implemented` at the hole. A `Maybe Html` or a
-- `List Html` hole, or markup held in a value, is the value path's since
-- S4's first step (`browser/direct/ValuePath`).
import Html exposing (Html)
import Tea


type Light
    = Red
    | Green


view : Light → Html {}
view light =
    <main>
        {case light of
            Red →
                <b>stop</b>

            Green →
                <i>go</i>
        }
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → Red, update = λ_ m → m, view = view }
