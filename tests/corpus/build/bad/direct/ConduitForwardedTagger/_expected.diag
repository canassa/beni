[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":62,"col":50},"end":{"line":62,"col":62}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`Response` changes a list it is handed in place, but Main.fromCallback sends\nwhat it returns, and it returns what Main.fromCallback hands it, which may be a\nlist the sender still holds.\n\n62|        { init = λ⊤ → ( Article { errors = [] }, fromCallback Response )\n                                                    ^^^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is sharing the checker can see: Main.fromCallback sends what it returns,\nand it returns what Main.fromCallback hands it, which may be a list the sender\nstill holds."}]
