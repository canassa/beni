-- A `let` of `view` that may have an effect, which its markup reads, is
-- not a derived value (the root does not take a `let` that may have an
-- effect, `backend.md` §15.4's `let` rule), and `browser-direct` would
-- evaluate it wherever the markup's values are — not once per message —
-- so it is refused: `not_implemented` at the `let`
-- (docs/design/browser-direct.md §5.4, §8.4, S4's amendment, item 4, as
-- built). `browser/direct/EveryRenderNested` writes the call in the hole.
import Html exposing (Html)
import Random
import Tea


roll : Int → Int
roll k = k + Random.value (Random.int 1 1000000)


view : Int → Html {}
view n =
    r = roll n

    <p>{r}</p>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = λ_ m → m, view = view }
