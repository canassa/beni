-- A helper-returned entry record retains its model in both init and view.
-- Updating the returned record must not erase the other fields' captures.
import Html exposing (Html)
import Tea


type alias Model =
    items : List Int


type alias Settings =
    init : ⊤ → Model
    update : ⊤, Model → Model
    view : Model → Html ⊤


settingsFor : Model → Settings
settingsFor m =
    { init = λ⊤ → m
    , update = λ_ model → model
    , view = λ_ → <button onClick={⊤}>{List.length m.items}</button>
    }


main : Tea.Program
main =
    m = { items = [ 7 ] }
    settings = settingsFor m
    Tea.sandbox { settings | update = λ_ model → { model | items = List.push model.items 8 } }
