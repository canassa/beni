-- `Tea.element` builds on `browser-tea`, and on `browser-direct` it is
-- `not_implemented` at the call, naming slice S5, which compiles programs
-- with effects (docs/design/browser-direct.md §10, §14).
import Cmd
import Html exposing (Html)
import Sub
import Tea


view : {} → Html {}
view _ = <p>effects</p>


main : Tea.Program
main =
    Tea.element
        { init = ( {}, Cmd.none )
        , update = λ_ m → ( m, Cmd.none )
        , view = view
        , subscriptions = λ_ → Sub.none
        }
