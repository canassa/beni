[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":58,"col":50},"end":{"line":58,"col":58}},"title":"LIST CHANGED WHILE STILL IN USE","message":"A lambda must return a list it owns, but Cmd.task edits what it returns, which\nmay be a list it does not own.\n\n58|        { init = λ⊤ → ( Article { errors = [] }, Cmd.task (λ⊤ → ⊤) λ_ → Response shared )\n                                                    ^^^^^^^^ the function is handed on here\n                                                                      ^ the function here may return a list it does not own\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: Cmd.task edits what it returns, which may\nbe a list it does not own."}]
