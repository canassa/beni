[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":58,"col":50},"end":{"line":58,"col":58}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`<lambda>` changes a list it is handed in place, but Cmd.task edits what it\nreturns, which may be a list it does not own.\n\n58|        { init = λ⊤ → ( Article { errors = [] }, Cmd.task (λ⊤ → ⊤) λ_ → Response shared )\n                                                    ^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is sharing the checker can see: Cmd.task edits what it returns, which may\nbe a list it does not own."}]
