[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":62,"col":50},"end":{"line":62,"col":63}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`Main.passedCommand` changes a list it is handed in place, but the elements of\n<Response …> may share one list.\n\n62|        { init = λ⊤ → ( Article { errors = [] }, passedCommand (Response shared) )\n                                                    ^^^^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is sharing the checker can see: the elements of <Response …> may share one\nlist."}]
