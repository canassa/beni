-- `browser-direct`'s slice S1 compiles text and attribute holes and view
-- events (docs/design/browser-direct.md §14); a `For` is `not_implemented`
-- at the `For`, naming slice S2 that adds rows, never a page that silently
-- shows nothing.
import Html exposing (Html)
import Tea


view : List Int → Html {}
view xs = <ul><For each={xs}>{λx → <li>{String.fromInt x}</li>}</For></ul>


main : Tea.Program
main = Tea.sandbox { init = [ 1, 2 ], update = λ_ m → m, view = view }
