-- A branch inside a `For` row — an `if` choosing the markup of a hole of
-- the row's element — is item 3 of slice S4's amendment
-- (docs/design/browser-direct.md §5.5), not yet built: `not_implemented`
-- at the hole, never a row that shows one arm for good. (A row that IS an
-- `if` is the value path's since S4's first step: `browser/direct/WholeFor`.)
import Html exposing (Html)
import Tea


view : List Int → Html {}
view xs =
    <ul>
        <For each={xs} keyed={False}>
            {λx → <li>{if x > 1 then <b>big</b> else <i>small</i>}</li>}
        </For>
    </ul>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → [ 1, 2 ], update = λ_ m → m, view = view }
