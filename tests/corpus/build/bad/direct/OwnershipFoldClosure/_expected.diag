[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":11,"col":29},"end":{"line":11,"col":47}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`[ …acc.values, x ]` adds to the end of `acc.values` itself, but List.foldr\nhands its parameter 2 what the callback returned before, which may be a list the\ncallback does not own.\n\n11|                    grown = [ …acc.values, x ]\n                               ^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo change a copy and leave `acc.values` as it was, copy it there:\n\n11|                    grown = [ …List.copy acc.values, x ]\n\nThis is sharing the checker can see: List.foldr hands its parameter 2 what the\ncallback returned before, which may be a list the callback does not own."},{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":13,"col":49},"end":{"line":13,"col":73}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`[ …acc.readers, reader ]` adds to the end of `acc.readers` itself, but\nList.foldr hands its parameter 2 what the callback returned before, which may be\na list the callback does not own.\n\n13|                    { values = grown, readers = [ …acc.readers, reader ] }\n                                                   ^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo change a copy and leave `acc.readers` as it was, copy it there:\n\n13|                    { values = grown, readers = [ …List.copy acc.readers, reader ] }\n\nThis is sharing the checker can see: List.foldr hands its parameter 2 what the\ncallback returned before, which may be a list the callback does not own."}]
