[{"code":"missing_form_attribute","severity":"error","span":{"file":"Main.beni","start":{"line":25,"col":18},"end":{"line":25,"col":22}},"title":"MISSING ATTRIBUTE","message":"This `<Show>` has no `keyed`, so it would not say when to rebuild what it shows.\n\nA `<Show>` remounts its body when its value changes: `keyed` for a new value by\nidentity, `keyed={.id}` for a new key. To patch the body in place instead, write\nthe `case` it would be:\n\n    case model.shown of\n        Just s →\n            <b>{s}</b>\n\n        Nothing →\n            <></>"}]
