-- A `Show` in markup this platform writes in place is item 3 of slice S4's
-- amendment (docs/design/browser-direct.md §5.5), not yet built:
-- `not_implemented` at it. Markup as a value — held in the model here, a
-- function's result, `Html.text` — compiles since S4's first step, the
-- value path (§5.2): this program's `init` holds two such values and builds.
import Html exposing (Html)
import Tea


badge : String → Html {}
badge label = <b>{label}</b>


plain : String → Html {}
plain label = Html.text label


type alias Model =
    shown : Maybe String
    held : List (Html {})


view : Model → Html {}
view model = <p><Show when={model.shown}>{λs → <b>{s}</b>}</Show></p>


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { shown = Just "x", held = [ badge "a", plain "b" ] }
        , update = λ_ m → m
        , view = view
        }
