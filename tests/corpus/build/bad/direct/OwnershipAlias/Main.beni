-- `list_still_used` through another name (ownership-checker.md §27.6, the
-- thesis's first example in §8.2): `saved` keeps `model.todos`, the arm
-- adds to the end of `model.todos` itself, and `saved` is read after the
-- change. The message shows the three places — where `saved` keeps the
-- list, the edit, the later read — and both fixes: copy at the edit, or
-- read `saved` before it.
import Html exposing (Html)
import Tea


type alias Model =
    todos : List Int
    before : Int


type Msg
    = Add Int


update : Msg, Model → Model
update msg model =
    case msg of
        Add n →
            saved = model.todos
            next = [ …model.todos, n ]
            { model | todos = next, before = List.length saved }


view : Model → Html Msg
view model = <button onClick={Add model.before}>{String.fromInt (List.length model.todos)}</button>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { todos = [], before = 0 }, update = update, view = view }
