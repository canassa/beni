-- Bike.shoot's local alias and its caller's later read: concatenation changes
-- the first operand, and both the returned record and a second call keep it.
import Html exposing (Html)
import Tea


shoot : { trail : List Int }, List Int → { trail : List Int } × Int
shoot bike other =
    walls = bike.trail ++ other
    ( bike, List.length walls )


update :
      Int
    , { red : { trail : List Int }, green : { trail : List Int } }
    → { red : { trail : List Int }, green : { trail : List Int } }
update _ model =
    ( red, _ ) = shoot model.red model.green.trail
    ( green, _ ) = shoot model.green model.red.trail
    { red = red, green = green }


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { red = { trail = [ 1 ] }, green = { trail = [ 2 ] } }
        , update = update
        , view = λ_ → <button onClick={0}>shoot</button>
        }
