[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":11,"col":17},"end":{"line":13,"col":32}},"title":"LIST MAY BE SHARED","message":"`List.foldl` changes a list it is handed in place, and the checker cannot show\nthat nothing else still holds the list.\n\n11|                List.foldl [ 1, 2 ] [] λx acc →\n                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n11|                List.foldl [ 1, 2 ] (List.copy [)] λx acc →\n\nThis is a limit of the checker, not proof of sharing: it was given to\nJavaScript, or kept by a callee."},{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":13,"col":21},"end":{"line":13,"col":32}},"title":"LIST MAY BE SHARED","message":"`[ …acc, x ]` adds to the end of `acc` itself, and the checker cannot show that\nnothing else still holds the list.\n\n13|                    [ …acc, x ]\n                       ^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n13|                    [ …List.copy acc, x ]\n\nThis is a limit of the checker, not proof of sharing: it was given to\nJavaScript, or kept by a callee."}]
