-- `view_changes_model` (ownership-checker.md §28.6; thesis Table 7.1, T13):
-- `view` shows the pinned rows before the recent ones with
-- `[ …model.pinned, …model.recent ]`, which adds to the end of
-- `model.pinned` itself — and the runtime hands `view` the model to read
-- only, keeping it for the next message.
import Html exposing (Html)
import Tea


type alias Model =
    pinned : List String
    recent : List String


update : String, Model → Model
update s model = { model | recent = [ s ] }


row : String → Html String
row s = <li onClick={s}>{s}</li>


view : Model → Html String
view model =
    shown = [ …model.pinned, …model.recent ]
    <ul>{List.map shown row}</ul>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → { pinned = [], recent = [] }, update = update, view = view }
