-- A model at entry that does not settle within the checker's limit of 32
-- rounds (`ownership-checker.md` §16.7's `fixpoint` row, §28's dated
-- amendment *the entry's fixpoints settle*; issue #229): `Pass` relays a
-- list one field along per message, so the fixpoint needs a round per
-- field, thirty-five here. The build is refused with one error at `main`,
-- naming the limit and saying it is the compiler's, never a proof dropped
-- in silence. `ownership/EntryRelay` is the same model with nine fields,
-- accepted.
import Html exposing (Html)
import Tea


type alias Model =
    a0 : List Int
    a1 : List Int
    a2 : List Int
    a3 : List Int
    a4 : List Int
    a5 : List Int
    a6 : List Int
    a7 : List Int
    a8 : List Int
    a9 : List Int
    a10 : List Int
    a11 : List Int
    a12 : List Int
    a13 : List Int
    a14 : List Int
    a15 : List Int
    a16 : List Int
    a17 : List Int
    a18 : List Int
    a19 : List Int
    a20 : List Int
    a21 : List Int
    a22 : List Int
    a23 : List Int
    a24 : List Int
    a25 : List Int
    a26 : List Int
    a27 : List Int
    a28 : List Int
    a29 : List Int
    a30 : List Int
    a31 : List Int
    a32 : List Int
    a33 : List Int
    b : List Int


type Msg
    = Pass
    | Poke


update : Msg, Model → Model
update msg m =
    case msg of
        Pass →
            { m
                | a0 = [ 1 ]
                , a1 = m.a0
                , a2 = m.a1
                , a3 = m.a2
                , a4 = m.a3
                , a5 = m.a4
                , a6 = m.a5
                , a7 = m.a6
                , a8 = m.a7
                , a9 = m.a8
                , a10 = m.a9
                , a11 = m.a10
                , a12 = m.a11
                , a13 = m.a12
                , a14 = m.a13
                , a15 = m.a14
                , a16 = m.a15
                , a17 = m.a16
                , a18 = m.a17
                , a19 = m.a18
                , a20 = m.a19
                , a21 = m.a20
                , a22 = m.a21
                , a23 = m.a22
                , a24 = m.a23
                , a25 = m.a24
                , a26 = m.a25
                , a27 = m.a26
                , a28 = m.a27
                , a29 = m.a28
                , a30 = m.a29
                , a31 = m.a30
                , a32 = m.a31
                , a33 = m.a32
            }

        Poke →
            { m | b = List.set m.b 0 9 }


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                { a0 = [ 0 ]
                , a1 = [ 1 ]
                , a2 = [ 2 ]
                , a3 = [ 3 ]
                , a4 = [ 4 ]
                , a5 = [ 5 ]
                , a6 = [ 6 ]
                , a7 = [ 7 ]
                , a8 = [ 8 ]
                , a9 = [ 9 ]
                , a10 = [ 10 ]
                , a11 = [ 11 ]
                , a12 = [ 12 ]
                , a13 = [ 13 ]
                , a14 = [ 14 ]
                , a15 = [ 15 ]
                , a16 = [ 16 ]
                , a17 = [ 17 ]
                , a18 = [ 18 ]
                , a19 = [ 19 ]
                , a20 = [ 20 ]
                , a21 = [ 21 ]
                , a22 = [ 22 ]
                , a23 = [ 23 ]
                , a24 = [ 24 ]
                , a25 = [ 25 ]
                , a26 = [ 26 ]
                , a27 = [ 27 ]
                , a28 = [ 28 ]
                , a29 = [ 29 ]
                , a30 = [ 30 ]
                , a31 = [ 31 ]
                , a32 = [ 32 ]
                , a33 = [ 33 ]
                , b = [ 0 ]
                }
        , update = update
        , view = λ_ → <button onClick={Pass}>pass</button>
        }
