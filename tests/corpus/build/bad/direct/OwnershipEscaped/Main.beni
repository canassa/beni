-- `list_may_be_shared` for a list a command keeps (ownership-checker.md
-- §28.6; thesis §8.2, *A command that captured the list*, T20): `Report`'s
-- command reads `model.items` when it runs, after `update` returns and
-- maybe after later messages, so `Add`'s push onto `model.items` cannot be
-- shown safe. The fix computes what the command needs first.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Log
import Sub
import Tea


type alias Model =
    items : List Int


type Msg
    = Add Int
    | Report


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Add n →
            ( { model | items = List.push model.items n }, Cmd.none )

        Report →
            ( model, Cmd.do λ⊤ → Log.info (String.fromInt (List.length model.items)) )


view : Model → Html Msg
view model =
    <main>
        <button onClick={Add (List.length model.items)}>add</button>
        <button onClick={Report}>report</button>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { items = [] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
