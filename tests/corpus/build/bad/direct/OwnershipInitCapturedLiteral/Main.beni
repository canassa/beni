-- An init capture also retained by view is shared (§22.2's capture amendment).
import Html exposing (Html)
import Tea


main : Tea.Program
main =
    m = { items = [ 7 ] }
    Tea.sandbox
        { init = λ⊤ → m
        , update = λ_ model → { model | items = List.push model.items 8 }
        , view = λ_ → <button onClick={⊤}>{List.length m.items}</button>
        }
