-- `list_still_used` by a value computed first (ownership-checker.md §28.6;
-- thesis Table 3.1's pending row, T1): `[ xs ]` is evaluated before the
-- push and holds `xs` until the tuple is built, so in place the tuple's
-- first item would hold the pushed list.
import Html exposing (Html)
import Tea


both : List Int → List (List Int) × List Int
both xs = ( [ xs ], List.push xs 1 )


sizes : List Int → Int
sizes xs =
    ( a, b ) = both xs
    List.length a + List.length b


view : Int → Html Int
view n = <p>{String.fromInt n}</p>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → sizes [ 0 ], update = λ_ m → m, view = view }
