-- init must build its model: a lambda returning a top-level value keeps it shared.
-- ownership-checker.md §22.2; TodoMVC's error after its queued save is repaired.
import Html exposing (Html)
import Tea


initial : { items : List Int }
initial = { items = [] }


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → initial
        , update = λ_ model → { model | items = List.push model.items 1 }
        , view = λmodel → <button onClick={⊤}>{List.length model.items}</button>
        }
