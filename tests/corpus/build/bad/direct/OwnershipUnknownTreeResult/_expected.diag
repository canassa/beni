[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":40,"col":5},"end":{"line":40,"col":16}},"title":"LIST MAY BE SHARED","message":"`update` changes `model#Tree.0` in place, and the checker cannot show that\nnothing else still holds the list.\n\n40|    Tea.sandbox\n       ^^^^^^^^^^^ the runtime hands `update` the model here\n\nCopy the list with `List.copy` where the model gets it, so that nothing else\nholds the list `update` changes.\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction the checker cannot identify, which may return a list something else\nholds."}]
