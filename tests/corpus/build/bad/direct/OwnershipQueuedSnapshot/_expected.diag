[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":41,"col":5},"end":{"line":41,"col":16}},"title":"LIST MAY BE SHARED","message":"`update` changes `model.items` in place, and the checker cannot show that\nnothing else still holds the list.\n\n41|    Tea.element\n       ^^^^^^^^^^^ the runtime hands `update` the model here\n\nCompute what a command or a subscription needs from the list before it is made,\nso that it keeps that value and not the list; or hand it a copy, made with\n`List.copy`.\n\nThis is a limit of the checker, not proof of sharing: at some message the\nruntime keeps it: a command or a subscription holds it, or update escapes it."}]
