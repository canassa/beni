[{"code":"invalid_entry_export","severity":"error","span":{"file":"beni.json","start":{"line":1,"col":1},"end":{"line":1,"col":1}},"title":"INVALID ENTRY EXPORT","message":"This project lists `flush` under `\"exports\"`, which is the name the entry file\nkeeps for a runtime's `flush`, which a release build can write beside it.\n\nEach name is one the entry file exports as `export { … as Name }`: an ASCII\nidentifier name, not `default` or `flush`, listed once\n(`docs/design/boundary.md` §9.12 (c))."}]
