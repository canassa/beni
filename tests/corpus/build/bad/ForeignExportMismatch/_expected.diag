[{"code":"foreign_export_mismatch","severity":"error","span":{"file":"platform/Prog.beni","start":{"line":11,"col":13},"end":{"line":11,"col":18}},"title":"FOREIGN EXPORT MISMATCH","message":"`platform/Prog.js` does not export `shout`.\n\nA sibling JavaScript file exports exactly the `foreign` values its module\ndeclares — no more, no fewer (`docs/design/boundary.md` §4, check 2). Add\n`export const shout = …;` to it, or delete the `foreign` declaration."},{"code":"foreign_export_mismatch","severity":"error","span":{"file":"platform/Prog.js","start":{"line":2,"col":14},"end":{"line":2,"col":21}},"title":"FOREIGN EXPORT MISMATCH","message":"This file exports `whisper`, and `platform/Prog.beni` declares no\n`foreign whisper`.\n\nA sibling JavaScript file exports exactly the `foreign` values its module\ndeclares — no more, no fewer (`docs/design/boundary.md` §4, check 2). One export\nper foreign value is one node in the dependency graph per foreign value, which\nis what keeps elimination declaration-granular; an extra export is a node\nnothing can reach. Declare `foreign whisper : …` in `platform/Prog.beni`, or\nstop exporting it here."}]
