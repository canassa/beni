import Js
import Rt


-- The platform probe supplies the cold descriptor ABI that the producer
-- supplies for markup. The mutable payload must be written on every call.
pub verify : ⊤ → String
verify ⊤ =
    seen = Js.ref ""
    stored = Js.ref Js.undefined
    value = Js.from { count = 1 }
    el = Js.call (Js.global "document") "createElement" [ Js.from "input" ]
    Js.to
        (Js.call (Js.global "Object") "defineProperty"
            [ el
            , Js.from "payload"
            , Js.from
                { get = λ⊤ → Js.read stored
                , set =
                    λnext →
                        Js.write stored next
                        Js.write seen (Js.read seen ++ String.fromInt (Js.to (Js.get next "count")))
                }
            ]
        )
    descriptor =
        Js.from
            { name = "payload"
            , immutable = False
            , get = λnode → Js.get node "payload"
            , set = λnode next → Js.set node "payload" next
            }
    Js.to (Js.apply (Js.from Rt.control) [ el, descriptor, value ])
    Js.set value "count" (Js.from 2)
    Js.to (Js.apply (Js.from Rt.control) [ el, descriptor, value ])
    Js.read seen
