[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":19},"end":{"line":12,"col":20}},"title":"SUSPENDING CALLBACK","message":"The `start` function here must not suspend: `Browser.Worker.program` hands it to\nthe platform, which calls it synchronously.\n\nBut it may suspend: it calls `Task.never`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
