[{"code":"duplicate_declaration","severity":"error","span":{"file":"platform/Vocab.beni","start":{"line":4,"col":12},"end":{"line":4,"col":18}},"title":"DUPLICATE DECLARATION","message":"The markup primitive `escape` has the name of an export the markup lowering\n`ssr` imports from its runtime.\n\nA markup primitive is the markup runtime's export of its name, beside the\nlowering's own exports (`docs/design/boundary.md` §9.4.5), so the two would be\none export. Rename the primitive."}]
