[{"code":"unknown_module","severity":"error","span":{"file":"Main.beni","start":{"line":1,"col":8},"end":{"line":1,"col":12}},"title":"UNKNOWN MODULE","message":"`Node` is a module of the platform `node`, which this build's platform depends\non, but no platform above it lists `Node` in `\"reexports\"`, so a program cannot\nimport it.\n\nA program may import the modules of the platform it is built for, and a module\nof a platform below it only when a platform on the way lists that module in its\nmanifest's `\"reexports\"` (`docs/design/boundary.md` §9.1)."},{"code":"unknown_module_alias","severity":"error","span":{"file":"Main.beni","start":{"line":8,"col":8},"end":{"line":8,"col":20}},"title":"UNKNOWN MODULE","message":"I cannot find a module named `Node`.\n\nThe qualified name `Node.Program` needs it. Check the spelling, or add an\nimport."},{"code":"unknown_module_alias","severity":"error","span":{"file":"Main.beni","start":{"line":9,"col":8},"end":{"line":9,"col":17}},"title":"UNKNOWN MODULE","message":"I cannot find a module named `Node`.\n\nThe qualified name `Node.done` needs it. Check the spelling, or add an import."},{"code":"private_name","severity":"error","span":{"file":"platform/Probe.beni","start":{"line":4,"col":11},"end":{"line":4,"col":29}},"title":"PRIVATE NAME","message":"This name is private to core runtime modules."}]
