-- The WebGPU engine is not part of the public surface
-- (docs/design/webgpu.md §2.1): `browser-tea` re-exports the public `Gpu`
-- modules and not `Gpu.Engine`, so a program over it that imports the
-- engine is `unknown_module`, decided by `platforms/browser-tea/beni.json`
-- alone: the build is for `browser-tea` itself. Since 2026-11-10 a direct
-- `browser` program cannot import it either (`build/bad/managed/GpuEngineHidden`).
import Gpu.Engine
import Html exposing (Html)
import Tea


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → Gpu.Engine.openChannelCount ⊤
        , update = λ_ m → m
        , view = λn → <p>{String.fromInt n}</p>
        }
