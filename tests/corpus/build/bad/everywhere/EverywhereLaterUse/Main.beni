-- `list_still_used` under `--ownership-everywhere` (`ownership-checker.md`
-- §28.10, §30.7): the project is built for `browser-tea` with the hidden
-- flag, so the ownership checker enforces as on a platform that edits lists
-- in place, and `List.push xs n` followed by a read of `xs` is refused.
-- Without the flag nothing is edited in place on `browser-tea` and the
-- program builds, which the harness checks too.
import Html exposing (Html)
import Tea


grownBy : List Int, Int → Int
grownBy xs n =
    ys = List.push xs n
    List.length ys + List.length xs


view : Int → Html Int
view n = <p>{String.fromInt n}</p>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → grownBy [ 1, 2 ] 3, update = λ_ m → m, view = view }
