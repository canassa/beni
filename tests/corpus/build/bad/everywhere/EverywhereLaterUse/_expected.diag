[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":13,"col":10},"end":{"line":13,"col":24}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`List.push` changes `xs` in place, but `xs` is read again afterwards.\n\n13|    ys = List.push xs n\n            ^^^^^^^^^^^^^^ the list is changed in place here\n14|    List.length ys + List.length xs\n                                    ^^ and `xs` is read here, after the change\n\nIf the list were changed in place, `xs` would see the change when it is read on\nline 14.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n13|    ys = List.push (List.copy xs) n\n\nThis is sharing the checker can see: `xs` is read on line 14, after the change."}]
