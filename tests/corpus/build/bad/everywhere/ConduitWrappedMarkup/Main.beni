-- Conduit's Article errors: rendering is a read, while Response is an owned send.
-- The rejected twin retains this same nested list in an event payload.
import Cmd
import Html exposing (Html)
import Sub
import Tea


type alias Page =
    errors : List String


type Model
    = Article Page


type Msg
    = Grow
    | Response (List String)
    | Share (List String)


update : Msg, Model → Model × Cmd.Cmd Msg
update msg model =
    case ( msg, model ) of
        ( Grow, Article page ) →
            ( Article { page | errors = List.push page.errors "more" }, Cmd.none )

        ( Response errors, Article page ) →
            ( Article { page | errors = errors }, Cmd.none )

        ( Share errors, Article page ) →
            ( Article { page | errors = errors }, Cmd.none )


viewErrors : msg, List String → Html msg
viewErrors dismiss errors =
    <section>
        <For each={errors} keyed={False}>{λerror → <p>{error}</p>}</For>
        <button id="grow" onClick={dismiss}>grow</button>
    </section>


type Slot msg
    = Slot (Html msg)


wrapped : List String → Slot Msg
wrapped errors = Slot (<button onClick={Share errors}>share</button>)


unwrap : Slot msg → Html msg
unwrap (Slot html) = html


view : Model → Html Msg
view model =
    case model of
        Article page →
            unwrap (wrapped page.errors)


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( Article { errors = [] }, Cmd.task (λ⊤ → [ "first" ]) Response )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
