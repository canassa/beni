[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":27,"col":5},"end":{"line":27,"col":17}},"title":"SUSPENDING CALLBACK","message":"This value holds a function that must not suspend: `Tea.document` hands it to\nthe platform, which calls it synchronously.\n\nBut it may suspend: `view` calls `page`, and `page` calls `Time.sleep`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":30,"col":18},"end":{"line":30,"col":22}},"title":"SUSPENDING CALLBACK","message":"The `view` function here must not suspend: `Tea.document` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `view` calls `page`, and `page` calls `Time.sleep`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
