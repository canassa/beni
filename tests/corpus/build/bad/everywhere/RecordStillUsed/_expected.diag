[{"code":"record_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":15,"col":12},"end":{"line":15,"col":25}},"title":"RECORD CHANGED WHILE STILL IN USE","message":"`{ p | x = 1 }` changes `p` itself, but `p` is used whole afterwards.\n\n15|both p = ( { p | x = 1 }, p )\n              ^^^^^^^^^^^^^ the record is changed in place here\n                             ^ and `p` is used here, after the change\n\nIf the record were changed in place, `p` would carry the new values of the\nchanged fields when it is used on line 15.\n\nTo change a copy and leave `p` as it was, copy it there:\n\n15|both p = ( { Record.copy p | x = 1 }, p )\n\nThis is sharing the checker can see: `p` is used whole on line 15, after the\nchange."}]
