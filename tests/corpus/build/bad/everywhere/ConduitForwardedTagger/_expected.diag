[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":62,"col":50},"end":{"line":62,"col":62}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`Response` must return a list it owns, but Main.fromCallback sends what it\nreturns, and it returns what Main.fromCallback hands it, which may be a list the\nsender still holds.\n\n62|        { init = λ⊤ → ( Article { errors = [] }, fromCallback Response )\n                                                    ^^^^^^^^^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: Main.fromCallback sends what it returns,\nand it returns what Main.fromCallback hands it, which may be a list the sender\nstill holds."}]
