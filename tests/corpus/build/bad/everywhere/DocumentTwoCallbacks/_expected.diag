[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":34,"col":18},"end":{"line":34,"col":25}},"title":"SUSPENDING CALLBACK","message":"The `init` function here must not suspend: `Tea.document` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `initial` calls `page`, and `page` calls `Time.sleep`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":36,"col":18},"end":{"line":36,"col":22}},"title":"SUSPENDING CALLBACK","message":"The `view` function here must not suspend: `Tea.document` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `view` calls `page`, and `page` calls `Time.sleep`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
