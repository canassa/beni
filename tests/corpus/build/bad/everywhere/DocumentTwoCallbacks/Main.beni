-- Two distinct callback paths must retain their own errors, even when both
-- ultimately wait through the same helper.
import Cmd exposing (Cmd)
import Sub
import Tea
import Time


type Msg
    = Inc


page : Int → Tea.Document Msg
page n =
    Time.sleep (Time.millis 1)
    { title = "count ${String.fromInt n}"
    , body = <button onClick={Inc}>{n}</button>
    }


initial : ⊤ → Int × Cmd Msg
initial ⊤ =
    _ = page 0
    ( 0, Cmd.none )


view : Int → Tea.Document Msg
view n = page n


main : Tea.Program
main =
    Tea.document
        { init = initial
        , update = λInc n → ( n + 1, Cmd.none )
        , view = view
        , subscriptions = λ_ → Sub.none
        }
