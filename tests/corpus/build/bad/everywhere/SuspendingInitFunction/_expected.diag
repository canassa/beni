[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":22,"col":29},"end":{"line":22,"col":37}},"title":"SUSPENDING CALLBACK","message":"The `init` function here must not suspend: `Tea.sandbox` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `slowInit` calls `Time.sleep`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
