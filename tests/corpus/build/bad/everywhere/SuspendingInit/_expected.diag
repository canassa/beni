[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":28,"col":34},"end":{"line":28,"col":35}},"title":"SUSPENDING CALLBACK","message":"The `init` function here must not suspend: `Tea.sandbox` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: it calls `slow`, and `slow` calls `Time.sleep`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
