[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":38,"col":25},"end":{"line":38,"col":27}},"title":"SUSPENDING CALLBACK","message":"This handler must not suspend: the page calls it synchronously, while the event\nis being dispatched.\n\nBut it may suspend: it calls `Net.load`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":40,"col":54},"end":{"line":40,"col":56}},"title":"SUSPENDING CALLBACK","message":"This row function must not suspend: the page calls it synchronously, while it\nrenders.\n\nBut it may suspend: it calls `Net.load`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":42,"col":43},"end":{"line":42,"col":45}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Html.map` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: it calls `Net.load`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":50,"col":20},"end":{"line":50,"col":26}},"title":"SUSPENDING CALLBACK","message":"The `update` function here must not suspend: `Browser.program` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: `update` calls `Net.load`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
