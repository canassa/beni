-- A class list with an entry whose name holds whitespace, and one that
-- repeats an earlier entry's name (docs/design/browser-inline.md §8.2, *A
-- class list*, amended 2026-11-11): the `dom` lowering hands such a list
-- to its runtime, which `browser-inline` does not ship; refused at the
-- element as a limit of the compiler, class 1 (§5, §8.7).
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    on : Bool


type Msg
    = Toggle


update : Msg, Model → Model
update msg model =
    case msg of
        Toggle →
            { model | on = not model.on }


view : Model → Html Msg
view model =
    <main>
        <p data-role="p" class={[ ( "on big", model.on ), ( "on", True ) ]}>x</p>
        <button data-role="toggle" onClick={Toggle}>t</button>
    </main>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { on = False }, update = update, view = view })
        "root"
