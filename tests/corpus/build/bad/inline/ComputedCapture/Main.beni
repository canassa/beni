-- A lifted start is handed its captures' values from the mount, and only a
-- literal can be written there (docs/design/browser-inline.md §7): the
-- interval here is computed and the key names none of it, so the start's capture `ms` is refused as a
-- limit of the compiler, class 4, naming it.
import Clock
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Tea


type Msg
    = Tick
    | Other


update : Msg, {} → {} × Cmd Msg
update msg model =
    case msg of
        Tick →
            ( model, Cmd.none )

        Other →
            ( model, Cmd.none )


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( {}, Cmd.none )
        , update = update
        , view = λ_ → <p>mounted</p>
        , subscriptions = λ_ → Clock.every (String.length "abcd" * 250) Tick
        }
