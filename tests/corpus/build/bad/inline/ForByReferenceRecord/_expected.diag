[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":41,"col":14},"end":{"line":41,"col":17}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` does not compile a `For` keyed by\nreference yet when its items are not a `String`, a number, a `Char`, a `Bool` or\nan `Order`: it would match the rows by keeping each item and comparing its\nidentity, which a write in place keeps (`docs/design/browser-inline.md` §9; §5,\nclass 1). Key the rows by a key function, `keyed={.id}`, or by position,\n`keyed={False}`."}]
