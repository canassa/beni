-- A view helper that waits violates the sync view boundary. The refusal is
-- transitive through the view's helper call, before lowering. Ported from
-- `build/bad/direct/`, whose `Tea.document` `browser-inline` does not have:
-- the helper computes the text the view shows, and waits first.
import Html exposing (Html)
import Task
import Tea


type Msg
    = Inc


label : Int → String
label n =
    Task.yieldNow ⊤
    "count ${String.fromInt n}"


view : Int → Html Msg
view n = <button onClick={Inc}>{label n}</button>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = λInc n → n + 1, view = view }
