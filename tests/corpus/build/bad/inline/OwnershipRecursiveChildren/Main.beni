-- Duplicate child-list ownership is never established by the entry fixpoint.
import Html exposing (Html)
import Tea


type Tree
    = Tree (List Tree)


type Msg
    = Grow
    | Share


grow : Tree → Tree
grow (Tree kids) =
    case kids of
        [] →
            Tree [ …kids, Tree [] ]
        _ →
            Tree (List.map kids λchild → grow child)


shared : ⊤ → Tree
shared ⊤ =
    child = Tree []
    Tree [ child, child ]


update : Msg, Tree → Tree
update msg tree =
    case msg of
        Grow →
            grow tree
        Share →
            shared ⊤


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → shared ⊤
        , update = update
        , view = λ_ → <button onClick={Grow}>grow</button>
        }
