[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":16,"col":31},"end":{"line":16,"col":80}},"title":"LIST MAY BE SHARED","message":"`List.append` changes `Maybe.withDefault old [` in place, and the checker cannot\nshow that nothing else still holds the list.\n\n16|                        Just (List.append (Maybe.withDefault old []) [ shared ])\n                                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n16|                        Just (List.append ((List.copy (Maybe.withDefault old [))]) [ shared ])\n\nThis is a limit of the checker, not proof of sharing: Dict.update supplies its\nparameter 1 borrowed (⊤)."},{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":18,"col":27},"end":{"line":18,"col":95}},"title":"LIST MAY BE SHARED","message":"`List.map` changes a list it is handed in place, and the checker cannot show\nthat nothing else still holds the list.\n\n18|                    Just (List.map (Maybe.withDefault old []) λchild → List.append child [ 9 ])\n                             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is a limit of the checker, not proof of sharing: Dict.update supplies its\nparameter 1 borrowed (⊤)."}]
