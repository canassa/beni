-- Owning each outer list does not license writing its shared children.
import Dict
import Tea


shared = [ 0 ]


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                built = List.foldl [ 1, 2 ] Dict.empty λk acc →
                    Dict.update acc k λold →
                        Just (List.append (Maybe.withDefault old []) [ shared ])
                Dict.update built 1 λold →
                    Just (List.map (Maybe.withDefault old []) λchild → List.append child [ 9 ])
        , update = λ_ model → model
        , view = λmodel → <p>{List.length (Dict.values model)}</p>
        }
