[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":10,"col":21},"end":{"line":10,"col":35}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`List.push` changes `xs` in place, but a value computed earlier in the same\nexpression still holds the list.\n\n10|both xs = ( [ xs ], List.push xs 1 )\n               ^ this value, computed first, still holds the list\n                       ^^^^^^^^^^^^^^ the list is changed in place here\n\nIf the list were changed in place, that value would already hold the change when\nit is used.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n10|both xs = ( [ xs ], List.push (List.copy xs) 1 )\n\nThis is sharing the checker can see: the value computed first holds the list\nuntil the expression uses it."}]
