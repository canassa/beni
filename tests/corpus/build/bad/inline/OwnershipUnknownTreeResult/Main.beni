-- A callback result with no known class is not a future fresh allocation.
-- The model's invariant cannot prove its child lists exclusive.
import Html exposing (Html)
import Tea


type Tree
    = Tree (List Tree)


type Msg
    = Replace (⊤ → Tree)
    | Grow


grow : Tree → Tree
grow (Tree kids) =
    case kids of
        [] →
            Tree [ …kids, Tree [] ]
        _ →
            Tree (List.map kids λchild → grow child)


update : Msg, Tree → Tree
update msg tree =
    case msg of
        Replace make →
            make ⊤
        Grow →
            grow tree


shared : Tree
shared = Tree [ Tree [] ]


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → Tree []
        , update = update
        , view = λ_ → <button onClick={Replace λ⊤ → shared}>grow</button>
        }
