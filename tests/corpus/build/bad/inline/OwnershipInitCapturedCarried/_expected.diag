[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":17,"col":5},"end":{"line":17,"col":16}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`<update>` changes `model.items` in place, but another part of the same\noperation reads the same list.\n\n17|    Tea.sandbox\n       ^^^^^^^^^^^ the runtime hands `<update>` the model here\n\nIf the list were changed in place, the other part would read it changed.\n\nCopy the list with `List.copy` where the model gets it, so that nothing else\nholds the list `<update>` changes.\n\nThis is sharing the checker can see: two parts of one operation reach the same\nlist."}]
