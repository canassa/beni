-- Another module's markup inside a piece, three modules deep: `Outer.view`
-- shows `Inner.view` through `Html.map`. A piece's own markup is one
-- element with no piece in it, so this is a limit of the compiler
-- (docs/design/browser-inline.md §8.4, §8.7).
import Browser
import Html exposing (Html)
import Outer
import Tea


type alias Model =
    g : Outer.Model


type Msg
    = OuterMsg Outer.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        OuterMsg sub →
            { model | g = Outer.update sub model.g }


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (Outer.view model.g) OuterMsg}
        <span data-role="after">after</span>
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { g = Outer.init ⊤ }, update = update, view = view })
        "root"
