[{"code":"sync_boundary","severity":"error","span":{"file":"platform/Clock.beni","start":{"line":14,"col":27},"end":{"line":14,"col":28}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Sub.on` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: it calls `tick`, and `tick` calls `Task.yieldNow`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
