-- A subscription whose start waits, as `Time.every`'s body does on
-- `browser`, needs the task kernel: `Sub.on`'s start is `sync`, so the
-- checker refuses the layer's start (docs/design/browser-inline.md §3).
import Clock
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub exposing (Sub)
import Tea


type Msg
    = Tick


init : ⊤ → {} × Cmd Msg
init ⊤ = ( {}, Cmd.none )


update : Msg, {} → {} × Cmd Msg
update _ model = ( model, Cmd.none )


subscriptions : {} → Sub Msg
subscriptions _ = Clock.every Tick


view : {} → Html Msg
view _ = <div />


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = subscriptions }
