[{"code":"program_shape","severity":"error","span":{"file":"Main.beni","start":{"line":47,"col":77},"end":{"line":47,"col":83}},"title":"PROGRAM SHAPE","message":"Key `Restore` writes the whole model, a record of several fields, in one value,\nwhich hides which of its fields changed, so no binding of the page can be chosen\nfor it: `browser-inline` writes only the bindings a key's writes reach, and\nnever checks the whole page again (`docs/design/browser-inline.md` §8.7; §5,\nclass 3). Write the fields the arm changes, as a record update of the model —\n`{ model | field = … }` — or, for a replacement of the whole model, a declared\n`replace` once the language has one."}]
