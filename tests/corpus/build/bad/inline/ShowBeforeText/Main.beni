-- A `Show` followed by text in its element: a region stands before the
-- element after it or at its element's end (browser-inline.md §8.2,
-- amended 2026-11-23, *A `Show`*), class 1 (§5).
import Html exposing (Html)
import Tea


view : Maybe Int → Html ⊤
view shown =
    <main>
        <Show when={shown} keyed>{λn → <b>{n}</b>}</Show>
        after
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → Just 1, update = λ_ m → m, view = view }
