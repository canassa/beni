-- A style list held as a value (docs/design/browser-inline.md §8.2, *A
-- class or style list*, amended 2026-11-23): its entries are not written
-- in place, so none can be baked or written by name; refused at the
-- element as a limit of the compiler, class 1 (§5, §8.7).
import Browser
import Html exposing (Html)
import Tea


type alias Model =
    styles : List (String × String)


type Msg
    = Flip


update : Msg, Model → Model
update msg model =
    case msg of
        Flip →
            { model | styles = [ ( "color", "red" ) ] }


view : Model → Html Msg
view model =
    <main>
        <p data-role="p" style={model.styles}>x</p>
        <button data-role="flip" onClick={Flip}>flip</button>
    </main>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { styles = [] }, update = update, view = view })
        "root"
