[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":11},"end":{"line":12,"col":12}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` has no markup value yet; it compiles\nmarkup only as a program's `view`, written in place\n(`docs/design/browser-inline.md` §5, class 1). Write markup held, passed or\nreturned by a helper in place in the `view`, or build this program with\n`--platform=browser-tea`."},{"code":"view_not_compiled","severity":"error","span":{"file":"Main.beni","start":{"line":20,"col":64},"end":{"line":20,"col":73}},"title":"VIEW NOT COMPILED","message":"This program's `view` is a value computed when the page runs, not a function\nwhose body the compiler can reach as markup, so `browser-inline` cannot compile\nit: the platform has no renderer to hand a `view` it did not compile. Name a\nfunction, or write a lambda, whose body is the markup\n(`docs/design/browser-inline.md` §5, class 3)."}]
