-- `list_still_used` through a function that holds the list
-- (ownership-checker.md §28.6; thesis §8.2, *A closure that keeps the
-- list*, T7): `count` captures `rows`, `rows` is extended, and `count` is
-- called afterwards — in place it would count the new row too.
import Html exposing (Html)
import Tea


extended : List Int, Int → Int
extended rows r =
    count = λ⊤ → List.length rows
    more = List.push rows r
    count ⊤ + List.length more


view : Int → Html Int
view n = <p>{String.fromInt n}</p>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → extended [ 1 ] 2, update = λ_ m → m, view = view }
