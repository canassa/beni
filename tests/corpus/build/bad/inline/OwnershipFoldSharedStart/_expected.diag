[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":15,"col":52},"end":{"line":15,"col":96}},"title":"LIST MAY BE SHARED","message":"`List.append` changes `Maybe.withDefault old [` in place, and the checker cannot\nshow that nothing else still holds the list.\n\n15|                    Dict.update acc 1 λold → Just (List.append (Maybe.withDefault old []) [ x ])\n                                                      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n15|                    Dict.update acc 1 λold → Just (List.append ((List.copy (Maybe.withDefault old [))]) [ x ])\n\nThis is a limit of the checker, not proof of sharing: Dict.update supplies its\nparameter 1 borrowed (⊤)."}]
