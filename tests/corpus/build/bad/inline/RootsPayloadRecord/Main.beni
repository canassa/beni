-- Two roots and a model the page's message carries
-- (`docs/design/browser-inline.md` §8.4, amended 2026-10-22;
-- `ownership-checker.md` §31.9): `Restore` makes the message's records the
-- model's, and the widgets' arms then write them in place while the page's
-- handler may still hold them. The ownership checker refuses the program
-- with its record error before any root is written; no root plan makes the
-- sharing legitimate, and nothing falls back to a copy.
import Browser
import Html exposing (Html)
import Tea
import W1
import W2


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { w1 = W1.init ⊤, w2 = W2.init ⊤ }
            , update = update
            , view = view
            }
        )
        "root"


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg
    | Restore Model


update : Msg, Model → Model
update msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            { model | w2 = W2.update sub model.w2 }

        Restore saved →
            saved


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
        {Html.map (W2.view model.w2 model.w1) W2Msg}
        <button
            data-role="restore"
            onClick={Restore { w1 = { cups = 0 }, w2 = { venue = "saved" } }}
        >
            Restore
        </button>
    </div>
