[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":41,"col":10},"end":{"line":41,"col":21}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: this program's subscriptions depend on its model, and\n`browser-inline` compiles a set of subscriptions that is the same for the page's\nlife; a set that changes it does not compile yet\n(`docs/design/browser-inline.md` §3; §5, class 1). Write `subscriptions` so that\nit does not read the model, and let `update` ignore what it does not need."}]
