[{"code":"not_implemented","severity":"error","span":{"file":"Pages.beni","start":{"line":30,"col":10},"end":{"line":30,"col":16}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: this event's handler value is not one constructor that\ntakes the event's payload or nothing, so `browser-inline` evaluates it at the\nevent; it reads a `let` of this other module's `view`, which must then be a memo\nnode, and another module's markup has none yet (`docs/design/browser-inline.md`\n§8.7; §5, class 4). The program is valid: it builds with\n`--platform=browser-tea`."}]
