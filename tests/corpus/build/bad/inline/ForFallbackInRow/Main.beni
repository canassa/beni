-- A `For` with a `fallback` inside a `For`'s row: the page's `For` shows its
-- fallback in a region of its own (browser-inline.md §9, amended
-- 2026-11-24), a row's `For` does not yet, class 1 (§5), refused at the
-- inner `For`.
import Browser
import Html exposing (Html)
import Tea


view : List (List String) → Html ⊤
view groups =
    <ul>
        <For each={groups} keyed={False}>
            {λg →
                <li>
                    <ol>
                        <For each={g} keyed={False} fallback={<li>none</li>}>
                            {λs → <li>{s}</li>}
                        </For>
                    </ol>
                </li>
            }
        </For>
    </ul>


main : Browser.Program
main = Tea.sandbox { init = λ⊤ → [ [ "a" ], [] ], update = λ_ m → m, view = view }
