-- A `view` whose body past its `let`s is an `if`: a branch at the page's root, which
-- `browser-inline` does not compile yet (docs/design/browser-inline.md §8.2, amended
-- 2026-11-23; §5, class 1).
import Html exposing (Html)
import Tea


view : Int → Html Int
view n =
    label = "count ${String.fromInt n}"
    if n > 3 then
        <main><p>{label}</p></main>
    else
        <section><button onClick={n + 1}>{label}</button></section>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = λn _ → n, view = view }
