-- An arm of a branch region with a `let` that no hole reads: not compiled
-- yet (docs/design/browser-inline.md §8.2, amended 2026-11-23; §5, class 1).
import Html exposing (Html)
import Tea


view : Maybe String → Html {}
view name =
    <main>
        {case name of
            Just s →
                _ = Debug.log "shown" s
                <b>{s}</b>

            Nothing →
                <i>none</i>
        }
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → Just "ada", update = λ_ m → m, view = view }
