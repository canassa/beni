-- Game.initBikes and Board.init: each reset reuses the initial list. Editing
-- the active model must not change that seed. init's closure is repeatable.
import Html exposing (Html)
import Tea


initial : { cells : List Int }
initial = { cells = [ 0 ] }


update : Bool, { cells : List Int } → { cells : List Int }
update reset model = if reset then initial else { model | cells = List.set model.cells 0 1 }


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → initial
        , update = update
        , view = λ_ → <button onClick={True}>reset</button>
        }
