-- A branch in a row's `<pre>` whose first text is a newline, followed by
-- text: the parser drops that newline, so the comment the branch stands
-- before would not be where its place says (browser-inline.md §8.2,
-- amended 2026-11-24, *in a unit too*), class 1 (§5).
import Html exposing (Html)
import Tea


view : List Bool → Html ⊤
view rows =
    <ul>
        <For each={rows} keyed={False}>
            {λon → <li><pre>&#10;{if on then <b>on</b> else <i>off</i>}tail</pre></li>}
        </For>
    </ul>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → [ True ], update = λ_ m → m, view = view }
