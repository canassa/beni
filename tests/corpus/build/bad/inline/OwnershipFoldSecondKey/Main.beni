-- The fold stores one grown list at two keys of its accumulator.
import Dict
import Tea


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                Dict.foldl (Dict.fromList [ ( 1, 1 ), ( 2, 2 ) ]) Dict.empty λ_ x acc →
                    grown = Dict.update acc 1 λold →
                        Just (List.append (Maybe.withDefault old []) [ x ])
                    taps = Maybe.withDefault (Dict.get grown 1) []
                    Dict.insert grown 2 taps
        , update = λ_ model → model
        , view = λmodel → <p>{List.length (Maybe.withDefault (Dict.get model 1) [])}</p>
        }
