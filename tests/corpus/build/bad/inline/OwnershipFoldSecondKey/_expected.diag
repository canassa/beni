[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":29},"end":{"line":13,"col":76}},"title":"LIST MAY BE SHARED","message":"`Dict.update` changes the dictionary `acc` in place, and another use may still\nhold its storage.\n\n12|                    grown = Dict.update acc 1 λold →\n                               ^^^^^^^^^^^^^^^^^^^^^^^^ the storage is changed here\n\nChanging the slots or order would also change what the old dictionary observes.\n\nMake an explicit storage copy with `Dict.copy` before this write. Stored values\nremain shared; copy a stored value too if you need to change that value.\n\nTo keep the old storage unchanged, copy it at this use:\n\n12|                    grown = Dict.update (Dict.copy acc) 1 λold →\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may"},{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":29},"end":{"line":13,"col":76}},"title":"LIST MAY BE SHARED","message":"`Dict.update` changes `acc[*]` in place, and the checker cannot show that\nnothing else still holds the list.\n\n12|                    grown = Dict.update acc 1 λold →\n                               ^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may."},{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":15,"col":21},"end":{"line":15,"col":45}},"title":"LIST MAY BE SHARED","message":"`Dict.insert` changes the dictionary `grown` in place, and another use may still\nhold its storage.\n\n15|                    Dict.insert grown 2 taps\n                       ^^^^^^^^^^^^^^^^^^^^^^^^ the storage is changed here\n\nChanging the slots or order would also change what the old dictionary observes.\n\nMake an explicit storage copy with `Dict.copy` before this write. Stored values\nremain shared; copy a stored value too if you need to change that value.\n\nTo keep the old storage unchanged, copy it at this use:\n\n15|                    Dict.insert (Dict.copy grown) 2 taps\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may"}]
