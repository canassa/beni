[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":29},"end":{"line":13,"col":76}},"title":"LIST MAY BE SHARED","message":"`Dict.update` changes `acc#Dict.0#Node.2` in place, and the checker cannot show\nthat nothing else still holds the list.\n\n12|                    grown = Dict.update acc 1 λold →\n                               ^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may."}]
