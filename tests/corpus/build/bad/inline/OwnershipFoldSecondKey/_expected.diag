[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":11,"col":17},"end":{"line":11,"col":27}},"title":"LIST CHANGED WHILE STILL IN USE","message":"value <call Dict.foldl> is refused: supply: the function can answer one cell at\ntwo places, and the callee hands the answer back\n\nThe step 0 prototype of the ownership checker (`--ownership=v3`) refuses a write\nthat it cannot show to be safe. Call the function directly where it writes, or\nhand it straight to the call that runs it, or change a copy (`List.copy`)."}]
