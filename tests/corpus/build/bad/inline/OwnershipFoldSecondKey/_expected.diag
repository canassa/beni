[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":29},"end":{"line":13,"col":76}},"title":"LIST MAY BE SHARED","message":"`Dict.update` changes the dictionary `acc` in place, and it needs the values\nstored in it not to share a list. They may.\n\n12|                    grown = Dict.update acc 1 λold →\n                               ^^^^^^^^^^^^^^^^^^^^^^^^ the values are changed here\n\nA storage copy with `Dict.copy` does not help: it is shallow, and the copy holds\nthe same values.\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may"},{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":12,"col":29},"end":{"line":13,"col":76}},"title":"LIST MAY BE SHARED","message":"`Dict.update` changes `acc[*]` in place, and the checker cannot show that\nnothing else still holds the list.\n\n12|                    grown = Dict.update acc 1 λold →\n                               ^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may."},{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":15,"col":21},"end":{"line":15,"col":45}},"title":"LIST MAY BE SHARED","message":"`Dict.insert` changes the dictionary `grown` in place, and it needs the values\nstored in it not to share a list. They may.\n\n15|                    Dict.insert grown 2 taps\n                       ^^^^^^^^^^^^^^^^^^^^^^^^ the values are changed here\n\nA storage copy with `Dict.copy` does not help: it is shallow, and the copy holds\nthe same values.\n\nThis is a limit of the checker, not proof of sharing: it needs what Dict.foldl\nsupplies it not to share, and it may"}]
