-- A subscription's tagger must give one of the program's message keys with
-- the pushed value as its field (docs/design/browser-inline.md §3): here it
-- wraps the value in a constructor of its own, so the key's field is not the
-- value. The analysis cannot split the key on the value's own shape, so the
-- program is refused at its call as a limit of the compiler, class 4 (§5).
import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea


type Box
    = Box Value


type Msg
    = Pushed Box
    | Tick


init : ⊤ → {} × Cmd Msg
init ⊤ = ( {}, Cmd.none )


update : Msg, {} → {} × Cmd Msg
update msg model =
    case msg of
        Pushed _ →
            ( model, Cmd.none )

        Tick →
            ( model, Cmd.none )


subscriptions : {} → Sub Msg
subscriptions _ = Push.onPush λv → Pushed (Box v)


view : {} → Html Msg
view _ = <div />


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"
