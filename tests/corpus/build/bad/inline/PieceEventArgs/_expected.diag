[{"code":"not_implemented","severity":"error","span":{"file":"Pages.beni","start":{"line":29,"col":10},"end":{"line":29,"col":16}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` wires an event of another module's\nmarkup to a handler of the constructor it sends, and this event's handler value\nis not one constructor taking the event's payload or nothing\n(`docs/design/browser-inline.md` §8.7; §5, class 4). The program is valid: it\nbuilds with `--platform=browser-tea`."}]
