[{"code":"not_implemented","severity":"error","span":{"file":"Pages.beni","start":{"line":29,"col":10},"end":{"line":29,"col":16}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` wires an event of another module's\nmarkup by the constructor alone, which takes the event's payload or nothing, and\nthis event's handler value is a constructor applied to values, or not a\nconstructor (`docs/design/browser-inline.md` §8.7; §5, class 4). The program is\nvalid: it builds with `--platform=browser-tea`."}]
