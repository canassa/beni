[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":31,"col":18},"end":{"line":31,"col":19}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` has no run-time markup value yet; it\ncompiles markup written in place, and a `let`, a constant or a helper's argument\nthat names markup where a hole shows it (`docs/design/browser-inline.md` §8.2;\n§5, class 1). Show this markup in a hole of the `view` or of a helper, or build\nthis program with `--platform=browser-tea`."},{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":41,"col":9},"end":{"line":41,"col":10}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` does not compile markup held in data\nor chosen at run time, or a branch whose arms are not each one element or\n`<></>` yet (`docs/design/browser-inline.md` §5, class 1). Write the `view`\nwithout it, or build this program with `--platform=browser-tea`, which compiles\nit."}]
