[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":31,"col":18},"end":{"line":31,"col":19}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` has no markup value yet; it compiles\nmarkup only as a program's `view`, written in place\n(`docs/design/browser-inline.md` §5, class 1). Write markup held, passed or\nreturned by a helper in place in the `view`, or build this program with\n`--platform=browser-tea`."},{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":41,"col":9},"end":{"line":41,"col":10}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` does not compile markup held in data\nor chosen at run time, or a branch whose arms are not each one element or\n`<></>` yet (`docs/design/browser-inline.md` §5, class 1). Write the `view`\nwithout it, or build this program with `--platform=browser-tea`, which compiles\nit."}]
