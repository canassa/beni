[{"code":"record_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":17,"col":10},"end":{"line":17,"col":21}},"title":"RECORD CHANGED WHILE STILL IN USE","message":"`update` changes the record at `model.w1` in place, but another part of the same\noperation holds the same record.\n\n17|        (Tea.sandbox\n            ^^^^^^^^^^^ the runtime hands `update` the model here\n\nIf the record were changed in place, the other part would see it changed.\n\nCopy the record with `Record.copy` where the model gets it, so that nothing else\nholds the record `update` changes.\n\nThis is sharing the checker can see: two parts of one operation reach the same\nrecord."}]
