[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":39,"col":20},"end":{"line":39,"col":26}},"title":"SUSPENDING CALLBACK","message":"The `update` function here must not suspend: `Tea.sandbox` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
