[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":10,"col":19},"end":{"line":10,"col":41}},"title":"LIST MAY BE SHARED","message":"`List.append` changes `taps` in place, and the checker cannot show that nothing\nelse still holds the list.\n\n10|    Just ( first, List.append taps [ t ] )\n                     ^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n10|    Just ( first, List.append (List.copy taps) [ t ] )\n\nThis is a limit of the checker, not proof of sharing: Dict.update supplies its\nparameter 1 borrowed (⊤)."}]
