[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":20,"col":27},"end":{"line":20,"col":39}},"title":"LIST MAY BE SHARED","message":"`Main.want` changes the dictionary `old` in place, and another use may still\nhold its storage.\n\n20|                changed = want 1 2 old\n                             ^^^^^^^^^^^^ the storage is changed here\n\nChanging the slots or order would also change what the old dictionary observes.\n\nMake an explicit storage copy with `Dict.copy` before this write. Stored values\nremain shared; copy a stored value too if you need to change that value.\n\nTo keep the old storage unchanged, copy it at this use:\n\n20|                changed = want 1 2 (Dict.copy old)\n\nThis is a limit of the checker, not proof of sharing: the callee needs the\nlist's elements not to share, and they may"}]
