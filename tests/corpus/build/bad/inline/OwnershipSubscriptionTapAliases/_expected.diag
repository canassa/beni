[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":20,"col":27},"end":{"line":20,"col":39}},"title":"LIST MAY BE SHARED","message":"`Main.want` changes the dictionary `old` in place, and it needs the values\nstored in it not to share a list. They may.\n\n20|                changed = want 1 2 old\n                             ^^^^^^^^^^^^ the values are changed here\n\nA storage copy with `Dict.copy` does not help: it is shallow, and the copy holds\nthe same values.\n\nThis is a limit of the checker, not proof of sharing: the callee needs the\nlist's elements not to share, and they may"}]
