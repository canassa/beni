-- A generic helper given aliased lists must reject destructive focus.
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


want : Int, Int, Dict Int (Int × List Int) → Dict Int (Int × List Int)
want k t d = Dict.update d k λcurrent →
    ( first, taps ) = Maybe.withDefault current ( 0, [] )
    Just ( first, List.append taps [ t ] )


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                taps = [ 1 ]
                old = Dict.insert (Dict.insert (Dict.empty ⊤) 1 ( 0, taps )) 2 ( 0, taps )
                changed = want 1 2 old
                ( size changed 1, size changed 2 )
        , update = λ_ model → model
        , view = λ( a, b ) → <p>{a}:{b}</p>
        }


size : Dict Int (Int × List Int), Int → Int
size model k =
    ( _, taps ) = Maybe.withDefault (Dict.get model k) ( 0, [] )
    List.length taps
