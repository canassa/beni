-- A running or queued body really holds this list before the append.
import Html exposing (Html)
import Task
import Tea


type Policy
    = Restart
    | Concurrent


unsafe : List Int → List Int × Task.Soon
unsafe runs =
    old = List.filter runs λ_ → True
    fiber = Task.soon λ⊤ → Debug.log "old ${String.fromInt (List.length old)}" ⊤
    ( [ …old, 2 ], fiber )


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                ( jobs, _ ) = unsafe [ 1 ]
                List.length jobs
        , update = λ_ model → model
        , view = λmodel → <p>{model}</p>
        }
