-- Sternhalma.setupBoard's fold mutates a seed that is read for every setup.
import Html exposing (Html)
import Tea


initial : List Int
initial = [ 0 ]


setup : Int → List Int
setup n = List.foldl [ n ] initial λvalue cells → List.set cells 0 value


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → 0
        , update = λn _ → List.sum (setup n)
        , view = λn → <button onClick={n + 1}>{String.fromInt n}</button>
        }
