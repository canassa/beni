-- A core row must not hide a suspending callback in a command.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Task
import Tea


type Msg
    = Done


command : (⊤ → Msg) → Cmd Msg
command body = Cmd.perform λsend → send (List.foldl [ 1 ] Done λ_ _ → body ⊤)


init : ⊤ → Int × Cmd Msg
init ⊤ =
    ( 0
    , command λ⊤ →
        Task.yieldNow ⊤
        Done
    )


update : Msg, Int → Int × Cmd Msg
update Done model = ( model + 1, Cmd.none )


view : Int → Html Msg
view model = <p>{model}</p>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = λ_ → Sub.none }
