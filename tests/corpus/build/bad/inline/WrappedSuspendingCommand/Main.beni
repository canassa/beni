-- A `Cmd.perform` body that passes through a higher-order function is read
-- by what it is applied to (browser/inline/CommandBodyWrapped). Here the
-- wrapped body waits, so the command needs the task kernel: refused, class 2
-- (docs/design/browser-inline.md §4, §5; issue #1003).
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Task
import Tea


type Msg
    = Go
    | Done


through : (a → b) → (a → b)
through f = λx → f x


update : Msg, Int → Int × Cmd Msg
update msg model =
    case msg of
        Go →
            ( model
            , Cmd.perform
                (through λsend →
                    Task.yieldNow ⊤
                    send Done
                )
            )

        Done →
            ( model + 1, Cmd.none )


view : Int → Html Msg
view model = <button onClick={Go}>{model}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( 0, Cmd.none ), update = update, view = view, subscriptions = λ_ → Sub.none }
