-- A declaration whose ownership summary does not settle within the checker's
-- limit of 32 rounds (`ownership-checker.md` §16.7): `rotate` hands its
-- forty lists on one place round each time it calls itself, so each round of
-- its recursive group adds one result provenance. The build is refused with
-- one error at the declaration, naming it and the limit, and saying that the
-- limit is the compiler's — never a summary cut to fit.
import Html exposing (Html)
import Tea


rotate :
      Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    → List Int
rotate k p00 p01 p02 p03 p04 p05 p06 p07 p08 p09 p10 p11 p12 p13 p14 p15 p16 p17 p18 p19 p20 p21 p22 p23 p24 p25 p26 p27 p28 p29 p30 p31 p32 p33 p34 p35 p36 p37 p38 p39 =
    if k == 0 then
        p00
    else
        rotate
            (k - 1)
            p01
            p02
            p03
            p04
            p05
            p06
            p07
            p08
            p09
            p10
            p11
            p12
            p13
            p14
            p15
            p16
            p17
            p18
            p19
            p20
            p21
            p22
            p23
            p24
            p25
            p26
            p27
            p28
            p29
            p30
            p31
            p32
            p33
            p34
            p35
            p36
            p37
            p38
            p39
            p00


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → { items = [ 7 ] }
        , update = λ_ model → { model | items = List.push model.items 8 }
        , view = λmodel → <p>{List.length model.items}</p>
        }
