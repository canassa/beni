-- A view helper whose body is a `case` that is a branch region, called in a
-- hole followed by text: the region's arm is put before the element after
-- it, or at its element's end, so it is refused as the same `case` written
-- at the hole is (docs/design/browser-inline.md §8.4, amended 2026-11-23,
-- #2498; §5, class 1).
import Html exposing (Html)
import Tea


banner : Maybe String → Html {}
banner name =
    case name of
        Just s →
            <b>{s}</b>

        Nothing →
            <i>none</i>


view : Maybe String → Html {}
view name =
    <p>
        {banner name}
        and more
    </p>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → Just "ada", update = λ_ m → m, view = view }
