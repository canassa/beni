-- A component in a `For` row, which the simple form does not compile
-- (browser-inline.md §9, amended 2026-11-23), class 1 (§5), refused at the
-- component.
import Badge
import Browser
import Html exposing (Html)
import Tea


view : List String → Html ⊤
view items = <ul><For each={items}>{λs → <li><Badge text={s} /></li>}</For></ul>


main : Browser.Program
main = Tea.sandbox { init = λ⊤ → [ "a" ], update = λ_ m → m, view = view }
