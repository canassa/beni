-- `Pages.view` calls its helper `jump` with an argument that may have an
-- effect (`Debug.log`), and the helper's button sends `Go target`. An event
-- of another module's markup whose handler value is not one constructor
-- goes through the dispatcher, its value read at the event
-- (docs/design/browser-inline.md §8.4, amended 2026-11-24), which enters
-- the helper's call again. The program's own `view` keeps the arguments its
-- binding evaluated for such a handler (§8.2); another module's markup does
-- not yet: a limit of the compiler, class 4 (§5), reported at the event,
-- never the argument evaluated again at the event.
import Browser
import Html exposing (Html)
import Pages
import Tea


type alias Model =
    pages : Pages.Model


type Msg
    = PagesMsg Pages.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        PagesMsg sub →
            { model | pages = Pages.update sub model.pages }


view : Model → Html Msg
view model =
    <div>
        {Html.map (Pages.view model.pages) PagesMsg}
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { pages = Pages.init ⊤ }, update = update, view = view })
        "root"
