[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":47,"col":10},"end":{"line":47,"col":18}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: this program hands another module's markup an argument\nthat is neither a path of the model nor a constant, and `browser-inline` writes\nthat markup's bindings to read each argument where the model holds it\n(`docs/design/browser-inline.md` §8.4; §5, class 4). Hand the function a field\nof the model, and compute the value in it. The program is valid: it builds with\n`--platform=browser-tea`."}]
