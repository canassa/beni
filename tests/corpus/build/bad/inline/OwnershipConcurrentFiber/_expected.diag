[{"code":"list_may_be_shared","severity":"error","span":{"file":"Main.beni","start":{"line":16,"col":7},"end":{"line":16,"col":18}},"title":"LIST MAY BE SHARED","message":"`[ …old, 2 ]` adds to the end of `old` itself, and the checker cannot show that\nnothing else still holds the list.\n\n16|    ( [ …old, 2 ], fiber )\n         ^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n16|    ( [ …List.copy old, 2 ], fiber )\n\nThis is a limit of the checker, not proof of sharing: it was given to\nJavaScript, or kept by a callee."}]
