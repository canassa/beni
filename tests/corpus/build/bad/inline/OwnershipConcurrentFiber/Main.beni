-- A running or queued body really holds this list before the append.
import Html exposing (Html)
import Task exposing (Fiber)
import Tea


type Policy
    = Restart
    | Concurrent


unsafe : List Int → List Int × Fiber Int
unsafe runs =
    old = List.filter runs λ_ → True
    fiber = Task.spawn λ⊤ → List.length old
    ( [ …old, 2 ], fiber )


main : Tea.Program
main =
    Tea.sandbox
        { init =
            λ⊤ →
                ( jobs, _ ) = unsafe [ 1 ]
                List.length jobs
        , update = λ_ model → model
        , view = λmodel → <p>{model}</p>
        }
