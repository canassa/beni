-- `Counter.update` is not a `case` on its message: it hands the message to
-- `bump`, so `Counter` has no arm piece for a key, and `Main`'s handler,
-- which takes `Inc`'s fields and no message, cannot call it
-- (docs/design/browser-inline.md §8.4, `deep_split`): a limit, class 4
-- (§5), reported at the call.
import Browser
import Counter
import Html exposing (Html)
import Tea


type alias Model =
    c : Counter.Model


type Msg
    = CounterMsg Counter.Msg


step : Msg, Model → Model
step msg model =
    case msg of
        CounterMsg sub →
            { model | c = Counter.update sub model.c }


update : Msg, Model → Model
update msg model = step msg model


view : Model → Html Msg
view model =
    <div data-role="app">
        <output>{model.c.count}</output>
        <button data-role="inc" onClick={CounterMsg Counter.Inc}>+</button>
        <button data-role="dec" onClick={CounterMsg Counter.Dec}>-</button>
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox { init = λ⊤ → { c = Counter.init ⊤ }, update = update, view = view })
        "root"
