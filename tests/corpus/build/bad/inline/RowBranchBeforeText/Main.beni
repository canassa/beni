-- A branch in a `For`'s row followed by text: a branch region stands before
-- the element after it or at its element's end (browser-inline.md §9,
-- amended 2026-11-23, *A branch in a row*), class 1 (§5).
import Html exposing (Html)
import Tea


view : List (Maybe String) → Html {}
view rows =
    <ul>
        <For each={rows} keyed={False}>
            {λrow →
                <li>
                    {case row of
                        Just s →
                            <b>{s}</b>

                        Nothing →
                            <i>none</i>
                    }
                    after
                </li>
            }
        </For>
    </ul>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → [ Just "a", Nothing ], update = λ_ m → m, view = view }
