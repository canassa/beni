[{"code":"list_still_used","severity":"error","span":{"file":"Main.beni","start":{"line":41,"col":5},"end":{"line":41,"col":16}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`update` changes `model#Tree.0` and `model⟨Tree⟩⁺#Tree.0` in place, but the\ncallee needs the list's elements not to share, and they may.\n\n41|    Tea.sandbox\n       ^^^^^^^^^^^ the runtime hands `update` the model here\n\nCopy the list with `List.copy` where the model gets it, so that nothing else\nholds the list `update` changes.\n\nThis is sharing the checker can see: the callee needs the list's elements not to\nshare, and they may."}]
