[{"code":"not_implemented","severity":"error","span":{"file":"Main.beni","start":{"line":14,"col":19},"end":{"line":14,"col":22}},"title":"NOT IMPLEMENTED YET","message":"A limit of the compiler: `browser-inline` does not compile a `For` whose row\nfunction is not a lambda whose body is one element written in place, or an `if`\nor a `case` whose arms are each one element or `<></>`, yet\n(`docs/design/browser-inline.md` §5, class 1). Write the `view` without it, or\nbuild this program with `--platform=browser-tea`, which compiles it."}]
