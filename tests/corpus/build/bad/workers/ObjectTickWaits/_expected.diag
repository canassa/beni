[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":20,"col":9},"end":{"line":20,"col":10}},"title":"SUSPENDING CALLBACK","message":"The `tick` function here must not suspend: `Worker.Object.define` hands it to\nthe platform, which calls it synchronously.\n\nBut it may suspend: `waits` calls `Task.sleep`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
