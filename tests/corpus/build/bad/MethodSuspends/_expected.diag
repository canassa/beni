[{"code":"sync_boundary","severity":"error","span":{"file":"Main.beni","start":{"line":7,"col":25},"end":{"line":7,"col":26}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Probe.install` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
