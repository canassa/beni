[{"code":"no_methods_on_shape","severity":"error","span":{"file":"Main.beni","start":{"line":9,"col":36},"end":{"line":9,"col":37}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    Wrapped\n\nDict and Set have no compare because insertion order is part of their value.\nA type holding one cannot derive compare. Give your own wrapper a pub compare\nthat orders the fields you choose, or pass an ordering function instead.\n"}]
