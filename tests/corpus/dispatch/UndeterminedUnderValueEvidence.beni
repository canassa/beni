-- dispatch: where a proven-undetermined answer is the `undetermined` leaf
-- and where it is the structural function itself (checker-v2.md §12.2,
-- §13.1). `Lower` reads a leaf's method off its nearest derived ancestor,
-- so the leaf is written only below one of the same method: under a value's
-- evidence (`List.eq`'s element, a user `eq`'s `where`) it is `ext Basics
-- eq` or `primitive num_compare`, at any depth. `run/UndeterminedUnderValueEvidence`
-- runs these. R6b's first P6 wrote the leaf there (review B1).
pub type Pair a
    = Pair a Int


pub eq : Pair a, Pair a -> Bool
    where a.eq : a, a -> Bool
eq (Pair x i) (Pair y j) =
    x == y && i == j


pub nestedEq : Bool
nestedEq =
    [ [] ] == [ [] ]


pub nestedLess : Bool
nestedLess =
    [ [] ] < [ [] ]


pub member : Bool
member =
    List.member [ [] ] []


pub custom : Bool
custom =
    Pair (Pair [] 1) 1 == Pair (Pair [] 2) 1


pub underDerived : Bool
underDerived =
    Just [ [] ] == Nothing
