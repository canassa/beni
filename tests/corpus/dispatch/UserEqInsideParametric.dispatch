module UserEqInsideParametric
  decl eq evidence=0 arity=2 convention=plain
  decl lists evidence=0 arity=0 convention=plain
  decl listsOfRecords evidence=0 arity=0 convention=plain
  decl maybes evidence=0 arity=0 convention=plain
  decl okId evidence=0 arity=0 convention=plain
  decl results evidence=0 arity=0 convention=plain
  decl tuples evidence=0 arity=0 convention=plain
  decl listsOfInts evidence=0 arity=0 convention=plain
  derived 0 compare UserEqInsideParametric.Id context=0
    body 0 primitive num_compare
    body 1 primitive num_compare
  derived 1 eq r$key context=1
    context 0 param=0 method=eq
  derived 2 eq t2 context=2
    context 0 param=0 method=eq
    context 1 param=1 method=eq
  site 20 callee primitive strict_eq
  site 36 callee ext List eq
    evidence top eq
  site 50 callee ext List eq
    evidence derived 1
      top eq
  site 64 callee ext_derived Maybe.Maybe eq
    arg top eq
  site 83 callee ext_derived Result.Result eq
    arg primitive strict_eq
    arg top eq
  site 97 callee derived 2
    arg top eq
    arg primitive strict_eq
  site 104 callee ext List eq
