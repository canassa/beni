-- A `For` row and a `Show` body in every shape (checker-v2.md §25.4): a
-- function, `{viewRow}`, whose arity its type decides (`row`); a
-- placeholder application, `{viewCell model _}`, which is a lambda of one
-- parameter; a lambda of two, whose second is the position; and a function
-- of two parameters, `{viewAt}`, which takes the position too. `Show` by
-- identity over a `String` (primitive) and by key over a record (not).
import Html exposing (Html)


type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    names : List String
    user : Maybe Row
    title : Maybe String


viewRow : Row → Html msg
viewRow row = <li>{row.label}</li>


viewCell : Model, Row → Html msg
viewCell model row = <li>{row.id}</li>


viewAt : String, Int → Html msg
viewAt name position = <li>{name}{position}</li>


pub view : Model → Html msg
view model =
    <div>
        <For each={model.rows} keyed={.id}>{viewRow}</For>
        <For each={model.rows} keyed={False}>{viewCell model _}</For>
        <For each={model.names}>{λname position → <li>{name}{position}</li>}</For>
        <For each={model.names}>{viewAt}</For>
        <Show when={model.title} keyed>{λtitle → <h1>{title}</h1>}</Show>
        <Show when={model.user} keyed={.id} fallback={<p>Nobody</p>}>{viewRow}</Show>
    </div>
