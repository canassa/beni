-- dispatch: `w3 1` has a tuple type three doublings deep whose two
-- halves are one type at every level, so the table SHARES a term per level
-- (checker-v2.md §13.1). The dump prints a shared term
-- with arguments in full once, as `<term> #<n>`, and every later
-- occurrence as `<term> = #<n>` (§13.2); printed
-- as a tree it would double per level, and 32 levels would never finish.
w1 x = ( x, x )


w2 x = w1 (w1 x)


w3 x = w2 (w2 x)


pub same : Bool
same = w3 1 == w3 2
