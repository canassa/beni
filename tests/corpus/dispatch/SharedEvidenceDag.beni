-- dispatch: CK-136. `w3 1` has a tuple type three doublings deep whose two
-- halves are one type at every level, so the table SHARES a term per level
-- (checker-v2.md §13.1 as amended by R6b). The dump prints a shared term
-- with arguments in full once, as `<term> #<n>`, and every later
-- occurrence as `<term> = #<n>` (§13.2 as amended by R15-fix-B); printed
-- as a tree it doubled per level, and 32 levels never finished.
w1 x =
    ( x, x )


w2 x =
    w1 (w1 x)


w3 x =
    w2 (w2 x)


pub same : Bool
same =
    w3 1 == w3 2
