[{"code":"shadowing","severity":"error","span":{"file":"tests/corpus/regress/LetSiblingShadowedByLambdaParam.beni","start":{"line":13,"col":41},"end":{"line":13,"col":46}},"title":"SHADOWING","message":"The name `total` is already bound on line 15.\n\nShadowing is not allowed: a binding cannot reuse a name that is in scope,\nwhether from an enclosing binding, a top-level declaration, an `exposing` list\nor the prelude. Rename one of them."}]
