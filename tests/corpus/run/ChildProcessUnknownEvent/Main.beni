-- run: an `error` event of the child whose code is a name the table does
-- not own — `toString`, which every object inherits — is not a
-- `ChildProcess.RunError`, and so a defect that ends the program
-- (boundary.md §9.14 (e), CLAUDE.md rule 9). The handler reads the table
-- by its own keys alone; a lookup that walked the prototype would answer
-- an `Err`, a silent wrong answer. The program must exit 1 with Node's
-- report of the error and print nothing after it.
import ChildProcess
import Debug
import Fault
import Io
import Node exposing (Program)


main : Program
main = Io.run λ⊤ →
    Fault.breakSpawns ⊤
    Debug.log "before the run" ⊤
    case ChildProcess.run (ChildProcess.command "/bin/sh" [ "-c", "true" ]) of
        Ok _ →
            Node.print "ran"

        Err _ →
            Node.print "an error value"
