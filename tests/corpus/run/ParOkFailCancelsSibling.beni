-- run: `Task.parOk` fails fast (transparent-effects-proposal.md §17.7;
-- report 23 row 26). The second branch answers `Err` at 10 ms; the first,
-- due at 50, is cancelled and its cleanup waited for, and that `Err` is
-- the answer — the release prints first, and the first branch's own line
-- never does. Two `Ok`s answer `Ok` of both, in argument order.
import Clock
import Duration
import Io
import Node exposing (Program)
import Task


slowOk : ⊤ → Result String Int
slowOk ⊤ = Task.bracket (λ⊤ → ⊤) (λ_ _ → Debug.log "slow released" ⊤) λ_ →
    Task.sleep (Duration.millis 50)
    Debug.log "slow finished" ⊤
    Ok 1


fastErr : ⊤ → Result String Int
fastErr ⊤ =
    Task.sleep (Duration.millis 10)
    Debug.log "fast failed" (Err "boom")


main : Program
main = Io.run λ⊤ →
    clock = Clock.virtual 0

    caller = Task.spawn λ⊤ →
        Clock.run clock λ⊤ →
            failing = Task.parOk slowOk fastErr
            _ = Debug.log "answer" failing
            Task.parOk (λ⊤ → Ok "a") λ⊤ → Ok "b"
    Clock.adjust clock (Duration.millis 100)
    Node.print (Debug.toString (Task.join caller))
