-- The safe twins of `SanitiserPassedTupleRow` (`ownership-v2.md` §2.11.3,
-- §2.13.6, `taken`): `List.update`'s callback passed on by a helper over a
-- list of tuples, through each shape there, on fresh rows and on rows that
-- share only a key the callback does not write. v2 accepts each edit in
-- place, and the sanitised run prints the same.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


rows : List (List Int × List Int) → String
rows rs = String.join (List.map rs λ( k, vs ) → show k ++ ":" ++ show vs) ";"


upd :
      List (List Int × List Int)
    , (List Int × List Int → List Int × List Int)
    → List (List Int × List Int)
upd rs f = List.update rs 1 f


updVia :
      List (List Int × List Int)
    , (List Int × List Int → List Int × List Int)
    → List (List Int × List Int)
updVia rs f = List.update rs 1 λv → f v


updTwo :
      List (List Int × List Int)
    , (List Int × List Int → List Int × List Int)
    → List (List Int × List Int)
updTwo rs f = upd rs f


updTwice :
      List (List Int × List Int)
    , (List Int × List Int → List Int × List Int)
    → List (List Int × List Int)
updTwice rs f = List.update (List.update rs 0 f) 1 f


updNested :
      List (List Int × (List Int × List Int))
    , (List Int × (List Int × List Int) → List Int × (List Int × List Int))
    → List (List Int × (List Int × List Int))
updNested rs f = List.update rs 1 f


main : Program
main =
    fresh = upd [ ( [ 1 ], [ 4 ] ), ( [ 2 ], [ 4 ] ) ] λ( a, vs ) → ( a, List.push vs 8 )
    k = [ 1 ]
    keyed = upd [ ( k, [ 0 ] ), ( k, [ 1 ] ) ] λ( a, vs ) → ( a, List.push vs 3 )
    via = updVia [ ( k, [ 0 ] ), ( k, [ 1 ] ) ] λ( a, vs ) → ( a, List.push vs 8 )
    two = updTwo [ ( k, [ 0 ] ), ( k, [ 1 ] ) ] λ( a, vs ) → ( a, List.push vs 8 )
    twice = updTwice [ ( k, [ 0 ] ), ( k, [ 1 ] ) ] λ( a, vs ) → ( a, List.push vs 8 )
    nested = updNested [ ( k, ( [ 0 ], k ) ), ( k, ( [ 1 ], k ) ) ] λ( a, ( vs, b ) ) →
        ( a, ( List.push vs 9, b ) )
    Node.printLines
        [ rows fresh
        , rows keyed
        , rows via
        , rows two
        , rows twice
        , String.join (List.map nested λ( a, ( vs, b ) ) → show vs) ";"
        , show k
        ]
