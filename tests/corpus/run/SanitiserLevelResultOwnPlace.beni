-- A `⟲` at a call's result covers the levels above the result slot's own place (`ownership-v2.md` §2.1, #2195):
-- `m` is at `A`, and the walk up from it meets `A` again before `T`. Stopped there, `T`'s fold was never said,
-- the recursive reader met no arrival at `#P.0⟲`, and `k` was edited while live.
import List
import Node exposing (Program)
import String


type T
    = Leaf (List Int)
    | Wa A
    | P T Int


type A
    = A1 T
    | A2 B


type B
    = Bb A


wr : T → Int
wr t =
    case t of
        Leaf xs →
            List.length (List.push xs 1)
        Wa u →
            wrA u
        P u _ →
            wr u


wrA : A → Int
wrA u =
    case u of
        A1 t →
            wr t
        A2 (Bb v) →
            wrA v


hg : T → T
hg t0 =
    case t0 of
        P (Wa (A2 (Bb m))) _ →
            P (Wa (A2 (Bb m))) 0
        _ →
            Leaf []


main : Program
main =
    k = [ 1 ]
    a = wr (hg (P (Wa (A2 (Bb (A1 (Leaf k))))) 0))
    Node.print (String.fromInt (a + List.length k))
