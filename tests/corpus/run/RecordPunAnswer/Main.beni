-- A tuple read as a record below a type variable of a callee's answer: the
-- caller's slot `.0.a=` gets its cells from the callee's one location,
-- which holds the tuple's cells and no object, so the slot is a cell no
-- claim names and v3 refuses the update (ownership-v3-kernel.md §3.4). The
-- write was of the list alone, and in place `t`'s number read 5.
import Node exposing (Program)
import Pun


go : Int → String
go n =
    t = ( n, [ 1 ] )
    pr : { a : Int, b : List Int } × Int
    pr = Pun.convPair t
    case pr of
        ( p, _ ) →
            p2 = { p | a = 5 }
            case t of
                ( m, _ ) →
                    "${String.fromInt p2.a} ${String.fromInt m}"


main : Program
main = Node.print (go 0)
