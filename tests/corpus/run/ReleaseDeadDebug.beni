-- run: `backend.md` §9 item 1's zero-use rule, the half that is about
-- correctness rather than bytes, as amended on 2026-09-30.
--
-- Three `Debug.log`s in `report`, through `log`, which the checker infers
-- `impure` because `Debug.log` is `foreign impure`:
--
--   1. `first` is read, so it survives and prints;
--   2. `ignored` is read by NOTHING. Until 2026-09-30 a release build
--      dropped the binding whole and its line did not appear, which made
--      this the one fixture whose two builds printed different things (it
--      carried a `.release-expected`). The release optimiser now keeps an
--      unread binding whose right-hand side may be impure, `Debug.log`
--      included (`language.md` §6, *What an optimiser may assume*), so both
--      builds print it;
--   3. `second` is read, so it survives and prints AFTER the first two: the
--      surviving order did not move.
--
-- The corpus's release pass reaches `Debug` only through the hidden,
-- test-only `--allow-debug` (§9's *`Debug` is refused, not pinned*); a user's
-- `--release` build of this program is refused. What that flag exposes is
-- now the same program the development build runs. A pure binding nothing
-- reads is still dropped, which only bytes can show:
-- `emit/release/ReleaseDropsPureBinding`.
--
-- `dropped` is the third kind and belongs to `run/DceDebugLog`: a whole
-- declaration nothing reaches, deleted by the reachability walk in BOTH
-- builds, so neither golden has its line.
import Node exposing (Program)
import String


log : String, Int -> Int
log label v = Debug.log label v


pub dropped : Int
dropped = log "dead.declaration" 99


report : Int -> Int
report n =
    first = log "dead.first" n
    ignored = log "dead.ignored" (n * 10)
    second = log "dead.second" (n + 1)
    first + second


main : Program
main = Node.printLines [ String.fromInt (report 2) ]
