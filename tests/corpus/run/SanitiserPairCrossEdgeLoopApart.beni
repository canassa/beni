-- The accepted twin: the same four fields, whose first function answers a list it
-- makes, so no field holds `q` and `push` writes it in place (§2.9.2, #2146).
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


loop :
      (List Int, List Int → List Int)
    , (List Int, List Int → List Int)
    , (List Int → List Int)
    , (List Int → List Int)
    , List Int
    , List Int
    , List Int
    , List Int
    , Int
    → List Int × List Int × List Int × List Int
loop kh ka kb kc h a b c n =
    if n == 0 then
        ( h, a, b, c )
    else
        loop kh ka kb kc (kh a c) (ka b h) (kb a) (kc b) (n - 1)


main : Program
main =
    q = [ 1 ]
    r =
        loop
            (λu v → if List.length u > 5 then u else if List.length v > 5 then v else [ 7 ])
            (λu v → if List.length u > 0 then u else v)
            (λv → v)
            (λv → v)
            []
            []
            []
            []
            8
    w = ( r.3, r.0 )
    z = List.push q 2
    Node.print (show z ++ "|" ++ show w.0)
