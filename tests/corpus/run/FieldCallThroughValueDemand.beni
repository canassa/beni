-- `ma` reaches `mb` by VALUE and `mb` reaches `ma` by dispatch, so
-- the SCC order checks `mb` first in every declaration order, and `mb`'s
-- in-flight call types `ma`'s `x` only after `ma`'s `x.combine 1` was
-- solved. Under the *Deferred receiver* rule (static-dispatch-spike.md
-- §11, amended 2026-09-26) the record arrives before the constraint is
-- generalised, so it is the field call in every order, never
-- `no_methods_on_shape`. Expected `5`.
--
-- Oracle twin: this file with `ma : K, { combine :
-- Int -> Int } -> Int` and `mb : K, Int -> Int` annotated prints `5`. As
-- written, it must not be refused.
import Node exposing (Program)


type K
    = K Int


pub ma (K n) x =
    let
        _ = mb (K n) 0
    in
    x.combine 1


pub mb (K n) y =
    if n > 0 then
        y
    else
        let
            _ = (K 1).ma { combine = \z -> z + 1 }
        in
        y


main : Program
main = Node.printLines [ String.fromInt ((K 0).mb 5) ]
