-- The `Set` operations nothing ran: `empty`, `singleton`, `remove`,
-- `isEmpty`, `member`, `size`, `union`, `intersect` and `diff`, plus the
-- two edges a set is supposed to absorb — inserting a value that is already
-- in it, and removing one that never was ("If the value is not found, no
-- changes are made").
--
-- `toList` is documented "sorted from lowest to highest", so every line
-- here is also an assertion about ORDER, and the inputs are deliberately
-- given out of order.
import Node exposing (Program)
import Set exposing (Set)
import String


show : Set String -> String
show set =
    "{" ++ String.join (Set.toList set) "," ++ "}"


flag : Bool -> String
flag b =
    if b then
        "True"
    else
        "False"


left : Set String
left =
    Set.fromList [ "b", "a" ]


right : Set String
right =
    Set.fromList [ "c", "b" ]


main : Program
main =
    Node.printLines
        [ show Set.empty
        , show (Set.singleton "Tom")
        , flag (Set.isEmpty Set.empty)
        , flag (Set.isEmpty (Set.singleton "Tom"))
        , flag (Set.member left "a")
        , flag (Set.member left "z")
        , flag (Set.member Set.empty "a")
        , String.fromInt (Set.size Set.empty)
        , String.fromInt (Set.size left)
        , show (Set.fromList [ "c", "a", "b", "a", "c" ])
        , String.fromInt (Set.size (Set.fromList [ "a", "a", "a" ]))
        , show (Set.insert left "a")
        , String.fromInt (Set.size (Set.insert left "a"))
        , show (Set.remove left "z")
        , show (Set.remove left "a")
        , show (Set.remove Set.empty "z")
        , show (Set.union left right)
        , show (Set.union left Set.empty)
        , show (Set.intersect left right)
        , show (Set.intersect left Set.empty)
        , show (Set.diff left right)
        , show (Set.diff right left)
        , show (Set.diff left left)
        , String.fromInt (Set.foldl left 0 (\v acc -> String.length v + acc))
        , String.join (Set.foldr left [] (\v acc -> v :: acc)) ","
        , show (Set.filter left (\v -> v == "a"))
        , show (Set.map left (\v -> v ++ "!"))
        ]
