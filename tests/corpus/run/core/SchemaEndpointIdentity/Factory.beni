-- Imported generic builders retain checked endpoint evidence through compiled composition.
import Schema exposing (Schema)


pub decimal : Schema String Int
decimal =
    Schema.converted Schema.string
        (Schema.conversion
            (λtext →
                case String.toInt text of
                    Just value →
                        Ok value
                    Nothing →
                        Err [ Schema.issue "expected integer" ]
            )
            λvalue → Ok (String.fromInt value)
        )


pub repeated : Schema e a → Schema (List e) (List a)
repeated schema = Schema.list schema
