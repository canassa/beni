-- run: every Elm-shaped way of building a list by prepending still builds
-- the right list on the array-backed `List`, at 3 000 elements:
--
--   * an accumulator built with `[ x, …acc ]` and then `List.reverse`;
--   * `List.foldr` whose callback prepends;
--   * a persistent stack pushed and popped at its FRONT, old versions kept
--     and read at the end;
--   * `[ …acc, x ]` in a loop, which `List.append` answers by pushing,
--     and `acc ++ [ x ]`, which calls `List.append` too since `++` on
--     lists does (`plans/list-arrays.md` O6).
--
-- A prepend copies the list by design (`language.md` §6.8, *`[ x, …xs ]`
-- copies*, the owner's decision of 2026-10-11): the first three are
-- quadratic, which is why this is 3 000 elements and not the 100 000 it
-- was while the trie had a claimable head, and why the first two are
-- `prepend_in_loop` warnings. The last two push and stay linear.
import List
import Node exposing (Program)
import String


size : Int
size = 3000


prependAll : Int, List Int → List Int
prependAll n acc =
    if n ≤ 0 then
        acc
    else
        prependAll (n - 1) [ size - n + 1, …acc ]


growBack : Int, List Int → List Int
growBack n acc =
    if n ≤ 0 then
        acc
    else
        growBack (n - 1) [ …acc, size - n + 1 ]


-- `++` on lists calls `List.append` (O6), so this is `growBack`'s cost.
growPlus : Int, List Int → List Int
growPlus n acc =
    if n ≤ 0 then
        acc
    else
        growPlus (n - 1) (acc ++ [ size - n + 1 ])


type alias Stack =
    top : List Int
    kept : List (List Int)


-- Two pushes and a pop at the front, over and over; every 300th
-- version kept.
churn : Int, Stack → Stack
churn i s =
    if i ≥ size then
        s
    else
        top =
            case Int.mod i 3 of
                2 →
                    case s.top of
                        [ _, …rest ] →
                            rest

                        [] →
                            []

                _ →
                    [ i, …s.top ]

        kept =
            if Int.mod i 300 == 0 then
                List.push s.kept top
            else
                s.kept
        churn (i + 1) { top = top, kept = kept }


summary : List Int → String
summary xs =
    String.join
        [ String.fromInt (List.length xs)
        , Debug.toString (List.head xs)
        , Debug.toString (List.last xs)
        , String.fromInt (List.sum xs)
        ]
        " "


main : Program
main =
    backwards = prependAll size []

    stack = churn 0 { top = [], kept = [] }
    Node.printLines
        [ summary backwards
        , summary (List.reverse backwards)
        , summary (List.foldr backwards [] λx acc → [ x * 2, …acc ])
        , summary (growBack size [])
        , summary (growPlus size [])
        , summary stack.top
        , String.join (List.map stack.kept summary) " | "
        ]
