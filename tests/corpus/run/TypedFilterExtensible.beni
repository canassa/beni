-- run: a function over an extensible record updates two record types
-- (`backend.md` §9, *Declared-type filtering of fact 3*: a row variable's
-- type is wild). The update in `bump` makes its object at `{ r | count :
-- Int }`, so that object's site has no key and passes the filters of both
-- callers' closed bindings; `label` and `size` are read only from what
-- `bump` returned. Both builds print the same.
import Node exposing (Program)


type alias Tag =
    count : Int
    label : String


type alias Bin =
    count : Int
    size : Float


bump : { r | count : Int } → { r | count : Int }
bump r = { r | count = r.count + 1 }


main : Program
main =
    tag : Tag
    tag = bump { count = 1, label = "tag" }

    bin : Bin
    bin = bump (bump { count = 10, size = 2.5 })
    Node.printLines
        [ "${tag.label} ${String.fromInt tag.count}"
        , "${String.fromFloat bin.size} ${String.fromInt bin.count}"
        ]
