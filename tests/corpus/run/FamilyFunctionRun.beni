-- A function read at a family's payload runs on `a`: `T` recurs with larger arguments
-- (`Wrap (T (List a))`). The call does not change `k`, so the program prints 2 in development
-- and in release. It was in `ownership/` until #2225, because `--release` did not end on it.
import List
import Node exposing (Program)
import String


type T a
    = Leaf a
    | Wrap (T (List a))


run : List (T (List Int → List Int)), List Int → List (List Int)
run ts a = List.map ts λt →
    case t of
        Wrap (Leaf [ f ]) →
            f a

        _ →
            a


main : Program
main =
    k = [ 1 ]
    x = run [ Wrap (Leaf [ λv → List.push v 2 ]) ] k
    Node.print (String.fromInt (List.length x + List.length k))
