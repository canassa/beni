-- An unannotated function's dot-call `x.compare y` promotes a requirement,
-- and each use of the function answers it: with the DERIVED `compare` of a
-- type that declares none (`Colour`, `Pair Colour`), with the table's on a
-- primitive, and on a closed record, where the promoted requirement has no
-- field accessor to be and derives as `<` does (checker-v2.md §21.1).
-- Oracle twin: `before` annotated `before : a, a -> Bool where a.compare :
-- a, a -> Order` prints the same.
import Node exposing (Program)


type Colour
    = Red
    | Blue


type Pair a
    = Pair a a


before x y = x.compare y == LT


same x y = x.eq y


yes : Bool → String
yes b =
    if b then
        "T"
    else
        "F"


main : Program
main =
    Node.printLines
        [ yes (before Red Blue)
        , yes (before Blue Red)
        , yes (before (Pair Red Blue) (Pair Blue Red))
        , yes (before 1 2)
        , yes (before "b" "a")
        , yes (before { k = 1, v = Red } { k = 1, v = Blue })
        , yes (same (Pair 1 2) (Pair 1 2))
        , yes (same Red Blue)
        ]
