-- NestedTraversalShared (Appendix B, S4; R-4.6.9, R-3.1): `zs[0][j]` and
-- `zs[1][j]` are one list, because the inner traversal of `xs` runs once per
-- outer item. The nested write is refused.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


each : List Int, List (List Int), (List Int → List Int) → List (List (List Int))
each ws xs f = List.map ws λ_ → List.map xs f


main : Program
main =
    xs = [ [ 1 ], [ 2 ] ]
    zs = each [ 1, 2 ] xs λl → l
    ws = List.map zs λinner → List.map inner λl → List.push l 1
    Node.print (String.join (List.map ws show) "|")
