-- What `core/List` shares and what it copies, observed through a test
-- platform's `refEq` (`backend.md` §15.8).
--
--   * The ELEMENTS a function passes through — `filter`, `take`,
--     `partition`, `append`, `concat` — are the input's own values
--     (invariant 6): a markup lowering's reference check per row input
--     skips work only for the very same value, so these print `same`.
--   * The LIST a function builds is always a fresh one (the owner's
--     decision of 2026-10-13, `backend.md` §4, *Identity*, amended): `append
--     xs []`, `append [] ys`, `concat` of one non-empty list, `concatMap`
--     whose callback answered one, and `sort` of one element print
--     `copied`. Until that decision they returned their input itself, and
--     these five lines printed `same`.
--
-- `xs ++ ys tail`, `concat last` and `concatMap last` have printed `copied`
-- since lists became arrays (`plans/list-arrays.md` §3): an array cannot
-- share a tail, so `List.drop (a ++ b) 2` is an equal list and not `b`
-- itself.
import Identity
import List
import Node


type alias Row =
    id : Int


show : String, Bool → String
show label b =
    if b then
        label ++ " same"
    else
        label ++ " copied"


main : Node.Program
main =
    rows = [ { id = 1 }, { id = 2 }, { id = 3 } ]
    single = [ 5 ]

    firstOf xs =
        case xs of
            [ x, …_ ] →
                Identity.refEq x (headOr rows)

            [] →
                False

    a = [ 1, 2 ]
    b = [ 3, 4 ]
    joined = List.concat [ [], a, [], b, [], [] ]

    mapped = List.concatMap [ 1, 2, 3 ] λn →
        if n == 2 then
            b
        else
            []

    mappedTwo = List.concatMap [ 1, 2, 3 ] λn →
        if n == 3 then
            []
        else if n == 1 then
            a
        else
            b

    ( kept, _ ) = List.partition rows λr → r.id < 2
    Node.printLines
        [ show "filter element" (firstOf (List.filter rows λr → r.id == 1))
        , show "take element" (firstOf (List.take rows 2))
        , show "partition element" (firstOf kept)
        , show "append element" (firstOf (List.append rows [ { id = 9 } ]))
        , show "concat element" (firstOf (List.concat [ [], rows ]))
        , show "append xs []" (Identity.refEq (List.append rows []) rows)
        , show "append [] ys" (Identity.refEq (List.append [] rows) rows)
        , show "xs ++ ys tail" (Identity.refEq (List.drop (a ++ b) 2) b)
        , show "concat one" (Identity.refEq (List.concat [ a ]) a)
        , show "concat last" (Identity.refEq (List.drop joined 2) b)
        , show "concatMap alone" (Identity.refEq mapped b)
        , show "concatMap last" (Identity.refEq (List.drop mappedTwo 2) b)
        , show "sort one" (Identity.refEq (List.sort single) single)
        ]


headOr : List Row → Row
headOr xs =
    case xs of
        [ x, …_ ] →
            x

        [] →
            { id = 0 }
