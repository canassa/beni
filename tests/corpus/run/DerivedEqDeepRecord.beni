-- `==` on a record type nested 40 deep builds and runs. The derived
-- `eq` of each level hands the next level's as a part, and `Lower.derivedValue`
-- has no `max_part_depth` cap to stop at with INTERNAL ERROR "I cannot tell
-- what this call dispatches to": such a cap is not unreachable — an
-- annotation cannot say a type that deep, but an unannotated record literal
-- infers one — and it is not needed (the evidence tree cannot point back at
-- itself, checker-v2.md §13.1). Expected `eq`, `ne`.
--
-- Oracle twin: this file with 20 levels in place of 40 prints
-- `eq`, `ne`.
import Node exposing (Program)


a =
    { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = 1 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }


b =
    { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = { x = 2 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }


main : Program
main =
    Node.printLines [ if a == a then "eq" else "ne", if a == b then "eq" else "ne" ]
