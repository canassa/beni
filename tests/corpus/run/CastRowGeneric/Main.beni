-- A generic function that calls the cast row `returned a → b` (JavaScript `{a: a, b:
-- []}`), handed to `apply` and read as `Int × List Int`. The row was an identity, so
-- `g` did not cast either (ownership-v3-kernel.md §3.4, §6 rule 10).
import Node exposing (Program)
import Pun


g : a → b
g q = Pun.wrapPair q


apply : (a → b), a → b
apply f q = f q


go : Int → String
go n =
    x0 = [ n ]
    h : Int × List Int
    h = apply g x0
    ( hq, _ ) = h
    z : List Int
    z = Pun.conv hq
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
