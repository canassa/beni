-- A closure writes the contents of a cell it captured, in place
-- (`ownership-v3-kernel.md` §13 item 11). Each holder that runs it judges
-- the write where it runs: called directly, twice; handed to a function
-- that calls it; called many times by `List.map`; run by `Task.scope`; a
-- closure that reads the cell through its handle after an update; one that
-- stores a list it made, which the maker then edits in place; and an update
-- of the maker's own after a closure's; a list the closure stores and
-- answers, its answer dropped. No holder reads the old contents, so
-- each runs in place and prints what the copying program prints. Its live
-- twin is `CellClosureWritesLive`.
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


apply : (⊤ → ⊤) → ⊤
apply f = f ⊤


applyList : (⊤ → List Int) → List Int
applyList f = f ⊤


direct : ⊤ → String
direct ⊤ =
    r = Ref.make [ 1 ]
    c = λ⊤ → Ref.update r λxs → List.push xs 2
    c ⊤
    c ⊤
    ints (Ref.get r)


handed : ⊤ → String
handed ⊤ =
    r = Ref.make [ 1 ]
    apply λ⊤ → Ref.update r λxs → List.push xs 2
    ints (Ref.get r)


many : ⊤ → String
many ⊤ =
    r = Ref.make [ 1 ]
    _ = List.map [ 1, 2, 3 ] λx → Ref.update r λxs → List.push xs x
    ints (Ref.get r)


readsHandle : ⊤ → String
readsHandle ⊤ =
    r = Ref.make [ 1 ]
    k = λ⊤ → ints (Ref.get r)
    Ref.update r λxs → List.push xs 2
    k ⊤


storedFresh : ⊤ → String
storedFresh ⊤ =
    r = Ref.make [ 1 ]
    apply λ⊤ → Ref.set r [ 9 ]
    Ref.update r λxs → List.push xs 2
    ints (Ref.get r)


thenOwn : ⊤ → String
thenOwn ⊤ =
    r = Ref.make [ 1 ]
    apply λ⊤ → Ref.update r λxs → List.push xs 2
    Ref.update r λxs → List.push xs 3
    ints (Ref.get r)


scoped : ⊤ → String
scoped ⊤ =
    r = Ref.make [ 1 ]
    Task.scope λ_ → Ref.update r λxs → List.push xs 2
    ints (Ref.get r)


storeDropped : ⊤ → String
storeDropped ⊤ =
    r = Ref.make [ 1 ]
    _ = applyList λ⊤ →
        ys = [ 9 ]
        Ref.set r ys
        ys
    Ref.update r λxs → List.push xs 5
    ints (Ref.get r)


main : Program
main = Io.run λ⊤ →
    Node.printLines
        [ direct ⊤
        , handed ⊤
        , many ⊤
        , readsHandle ⊤
        , storedFresh ⊤
        , thenOwn ⊤
        , scoped ⊤
        , storeDropped ⊤
        ]
