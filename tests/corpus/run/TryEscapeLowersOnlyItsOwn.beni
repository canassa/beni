-- A `let`-local `?` whose target escapes to the declaration lowers
-- only its own variables — its subject, its target's result and its value —
-- and nothing else young beside them (checker-v2.md §4.5):
-- `twice`, in the same `let` as `v = u?`, is still generalised and used at
-- two types, while `u` and `v` go down with the escaping target (`g`'s
-- result is `k`'s) and the `?` is decided as `Maybe` by the `case` after the
-- `let`.
-- Expected `Just ((1,1),("s","s"))` (how `Debug.toString` prints a pair
-- of pairs) and `7`.
--
-- Oracle twin: this file with `f : (( ( Int, Int ), (
-- String, String ) ) -> Maybe ( ( Int, Int ), ( String, String ) )) -> (
-- Maybe ( ( Int, Int ), ( String, String ) ), Int )` and `g : Maybe Int ->
-- Maybe ( ( Int, Int ), ( String, String ) )` annotated prints the
-- expected two lines. Committing the `?` to `Result` at once would
-- refuse the file with TYPE MISMATCH `Maybe a` against `Result b c`.
import Node exposing (Program)


f k =
    g u =
        v = u?
        twice x = ( x, x )
        k ( twice v, twice "s" )
    ( g (Just 1)
    , case k ( ( 0, 0 ), ( "", "" ) ) of
        Just _ →
            7

        Nothing →
            0
    )


main : Program
main =
    ( first, second ) = f λp → Just p
    Node.printLines [ Debug.toString first, String.fromInt second ]
