-- An answer read whole at a family's payload (`ownership-v2.md` §2.1, *An
-- arrival's level*), the write in `main` alone: `mid` finds a list at `U`'s
-- payload, where one place stands for every level, so `pick`'s result holds
-- all of `h`'s answer, deep. `main` writes that result, and the list is `k`'s:
-- refused. `SanitiserAnswerWhole` has this write beside another, which keeps
-- the program refused without the rule; here, without it, `k` is edited in place.
import List
import Node exposing (Program)
import String


show : List Int → String
show xs = String.join (List.map xs String.fromInt) ","


type U a
    = UL a
    | UC (U a)
    | UW (U (List a))


fu : U a, (a → List Int) → List Int
fu t f =
    case t of
        UL x →
            f x

        UC y →
            fu y f

        UW r →
            fu r λl →
                case l of
                    [ x, …_ ] →
                        f x

                    _ →
                        []


mid : U (List Int) → List Int
mid t = fu t λl → l


apply : (⊤ → a) → a
apply f = f ⊤


pick : (⊤ → U (List Int)) → List Int
pick h = mid (apply h)


main : Program
main =
    k = [ 1 ]
    n = List.push (pick λ⊤ → UC (UW (UL [ k ]))) 2
    Node.print (show n ++ "|" ++ show k)
