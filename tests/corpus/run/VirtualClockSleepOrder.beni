-- run: sleepers on a virtual clock wake in time order, with no wall time
-- (transparent-effects-proposal.md §17.6). Three fibers sleep 30, 10 and
-- 20 ms on one `Clock.virtual`, started in that order; one `Clock.adjust`
-- of 30 ms wakes them 10, 20, 30, each reading the clock at its own wake
-- time. Two sleepers due at the same time wake in the order they began to
-- sleep. Nothing waits on a real timer, so the program ends at once.
import Clock
import Duration
import Io
import Node exposing (Program)
import Task exposing (Fiber)


sleeper : Clock.Virtual, String, Int → Fiber ()
sleeper clock name ms = Task.spawn λ() →
    Clock.run clock λ() →
        _ = Task.sleep (Duration.millis ms)
        _ = Debug.log "${name} woke at" (Clock.now ())
        ()


main : Program
main = Io.run λ() →
    clock = Clock.virtual 1000
    a = sleeper clock "a" 30
    b = sleeper clock "b" 10
    c = sleeper clock "c" 20
    d = sleeper clock "d" 20
    _ = Clock.adjust clock (Duration.millis 30)
    _ = Task.joinAll [ a, b, c, d ]
    Node.print "done"
