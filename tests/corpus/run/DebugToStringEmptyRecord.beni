-- run: `Debug.toString` prints the empty record as `{}`, as Elm does, and
-- not `{  }`. A record alias's constructor reaches it:
-- `type alias E = {}` makes `E` a constant that IS the empty record
-- (backend.md §4), not the tag `"E"`.
import Node exposing (Program)


type alias E =
    {}


main : Program
main = Node.printLines [ Debug.toString {}, Debug.toString E, Debug.toString { a = {} } ]
