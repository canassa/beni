-- A supply that keeps a row, and a callback that writes a field of it (`ownership-v2.md`
-- §2.1, *The row of a record*): a comparison of the two slots' words took `…` and `.b`
-- for two slots, so the write of what is kept was no kept write. The sanitised run
-- trapped; refused.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


type alias L =
    List Int


c : { r | a : L }, ({ r | a : L } → x) → x × { r | a : L }
c rec f =
    g = λ⊤ → f { rec | a = [] }
    y = g ⊤
    ( y, rec )


main : Program
main =
    k = [ 1 ]
    ( y, r ) = c { a = [], b = k } λs → List.push s.b 1
    Node.print (show y ++ "|" ++ show r.b)
