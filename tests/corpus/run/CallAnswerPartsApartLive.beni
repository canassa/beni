-- The live twin of `CallAnswerPartsApart`: after the push, the written list
-- is read through another name (the argument, the cell, the other part of a
-- pair that holds one list twice), so each push is refused
-- (ownership-v3-kernel.md §4.1, #2583).
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


sel : List Int × List Int → List Int × List Int
sel p = ( p.0, p.1 )


swap : List Int × List Int → List Int × List Int
swap p = ( p.1, p.0 )


selected : List Int × List Int → String
selected p =
    case sel p of
        ( a, b ) →
            "selected ${ints (List.push a 8)} ${ints b} ${ints p.0}"


swapped : List Int × List Int → String
swapped p =
    case swap p of
        ( _, b ) →
            "swapped ${ints (List.push b 8)} ${ints p.0}"


got : Ref (List Int × List Int) → String
got r =
    case Ref.get r of
        ( a, b ) →
            "got ${ints (List.push a 8)} ${ints b} ${ints (Ref.get r).0}"


deep : (List Int × List Int) × List Int → (List Int × List Int) × List Int
deep p = ( ( p.0.1, p.0.0 ), p.1 )


nested : (List Int × List Int) × List Int → String
nested p =
    case deep p of
        ( ( a, _ ), c ) →
            "nested ${ints (List.push a 8)} ${ints c} ${ints p.0.1}"


same : ⊤ → String
same ⊤ =
    l = [ 1 ]
    case sel ( l, l ) of
        ( a, b ) →
            "same ${ints (List.push a 8)} ${ints b}"


main : Program
main =
    Node.printLines
        [ selected ( [ 1 ], [ 2 ] )
        , swapped ( [ 1 ], [ 2 ] )
        , got (Ref.make ( [ 1 ], [ 2 ] ))
        , nested ( ( [ 1 ], [ 2 ] ), [ 3 ] )
        , same ⊤
        ]
