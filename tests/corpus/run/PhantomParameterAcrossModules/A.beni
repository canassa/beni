-- A phantom type argument that is a function blocks neither `==` nor
-- explicit `Basics.eq` ACROSS modules (checker-v2.md §11.4, §21.1): the
-- marker walk reads an imported type's
-- `payload_params` — an opaque type's from its exported row, a private
-- type's reached through a published scheme from its hidden row
-- (§14.2) — and descends only where a payload can hold a value. Expected
-- `True`, `False`, `True`, `True`, `False` — never NOT EQUATABLE
-- `Tag (Int -> Int)` / `Hid (Int -> Int)`. The oracle twin is
-- the same project with `Int` for the phantom argument, which prints the
-- same five lines.
--
pub opaque type Tag a
    = Tag Int


type Hid a
    = Hid Int


pub make : Int -> Tag (Int -> Int)
make n =
    Tag n


pub hidden : Int -> Hid (Int -> Int)
hidden n =
    Hid n
