-- A function value that is one of two lambdas (a join) answers what the
-- callee hands it: here the second arm keeps its parameter in its answer.
-- The callee's answer holds what either arm answers, so the list it was
-- handed is read through `v` after the push and the push is refused
-- (ownership-v3-kernel.md §6 rules 2 and 7). Each arm is its own answer: the walk
-- stopped at the first arm, which answers no list, and read `v` as holding
-- nothing.
import List
import Node exposing (Program)
import String


type V
    = Ok
    | Bad (List Int)


handOne : (List Int → V), List Int, List Int → V × List Int
handOne g xs ys = ( g xs, ys )


handBoth : (List Int → V), List Int → V × List Int
handBoth g xs = ( g xs, xs )


vshow : V → String
vshow v =
    case v of
        Ok →
            "ok"

        Bad l →
            String.join (List.map l String.fromInt) ","


keepsArg : Bool → String
keepsArg b =
    xs = [ 1 ]
    ( v, ys ) = handOne (if b then λ_ → Ok else λl → Bad l) xs [ 2 ]
    zs = List.push xs 9
    "${vshow v} ${String.fromInt (List.length zs)} ${String.fromInt (List.length ys)}"


keepsBoth : Bool → String
keepsBoth b =
    ( v, ys ) = handBoth (if b then λ_ → Ok else λl → Bad l) [ 1 ]
    zs = List.push ys 9
    "${vshow v} ${String.fromInt (List.length zs)}"


main : Program
main = Node.printLines [ keepsArg False, keepsBoth False ]
