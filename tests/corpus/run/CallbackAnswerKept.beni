-- A callback that a holder runs keeps the answer of the function it is
-- handed (`Ref.set` of a top-level cell): what the holder hands there can be
-- in that answer, so it escapes where the callback meets the holder
-- (`ownership-v3-kernel.md` §6 rule 8, `Frame.flowCode`). Before, only the
-- flag of the parameter's own location was read: `y`, handed to
-- `List.map` inside a closure, did not escape, its push was accepted, and the
-- cell read the pushed list in place.
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


holder : Ref (List Int)
holder = Ref.make []


stash : List Int → List ⊤
stash y = List.map [ λ⊤ → y ] λq → Ref.set holder (q ⊤)


main : Program
main =
    y = [ 1 ]
    _ = stash y
    z = List.push y 2
    Node.print "${ints z} ${ints (Ref.get holder)}"
