-- Own methods that are mutually recursive THROUGH DISPATCH check in
-- any order: the dispatch back-edge merges their top-level groups into one
-- mutually recursive group (the owner's decision as amended, checker-v2.md
-- §10.4), and a merged frame does not default. First shape: `am` and
-- `bm` call each other through `.am ()` and `.bm`, with a `?` inside `bm`;
-- `am (K 4) ()` is `4`. Second: `size` and `weight` call each
-- other, and `weight`'s `let` helper `g` is generalised in `y`, so
-- `weight (K 1) ()` is `( ( 1, "a" ), ( 1, 3 ) )`. Expected `4`, `1 a`, `1 3`.
--
-- Oracle twin: this file with the four methods annotated
-- (`am : K, () -> Int`, `bm : Box (Maybe a), (a -> Maybe b) -> Maybe b`,
-- `size : Box a, () -> Int`, `weight : K, () -> ( ( Int, String ), ( Int,
-- Int ) )`) prints exactly the expected three lines. As written, in either
-- declaration order of each pair, it must not be refused with METHOD NEEDS
-- AN ANNOTATION.
import Node exposing (Program)


type K
    = K Int


type Box a
    = Box a


pub am (K n) u = Maybe.withDefault ((Box (Just n)).bm λv → Just v) 0


pub bm (Box m) fn =
    _ = λw → (K 0).am ⊤
    fn (m?)


pub size (Box _) u =
    _ = λw → (K 0).weight ⊤
    1


pub weight (K n) u =
    g x y = ( (Box x).size ⊤, y )
    ( g 1 "a", g 2 3 )


main : Program
main =
    ( ( one, a ), ( two, three ) ) = weight (K 1) ⊤
    Node.printLines
        [ String.fromInt (am (K 4) ⊤)
        , String.fromInt one ++ " " ++ a
        , String.fromInt two ++ " " ++ String.fromInt three
        ]
