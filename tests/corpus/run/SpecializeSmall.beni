-- A small function written wherever it is called (`backend.md` §9,
-- *Whole-program specialisation*, slice 8), beside what must defeat it,
-- printing the same in both builds — the order arguments are evaluated in
-- is `Debug.log`'s:
--
--   * an identity, a wrapper of another call and a function of two
--     arguments that reads each once, called from several places;
--   * an argument with an effect, read first by the body: evaluated once,
--     before the body's own call;
--   * an argument with an effect read after the body's own call, or twice,
--     or not at all: the call stays, and each argument is evaluated once,
--     in order;
--   * a field every record gives one small function, called through it.
import Node


identity : a -> a
identity x = x


wrap : Int -> Int
wrap n = twice n + 1


twice : Int -> Int
twice n = Debug.log "twice" n * 2


addThen : Int, Int -> Int
addThen a b = a + twice b


thenAdd : Int, Int -> Int
thenAdd a b = twice a + b


both : Int -> Int
both n = n * n


ignore : Int -> Int
ignore _ = 0


type alias Op =
    name : String
    apply : Int -> Int


apply : Op, Int -> Int
apply op n = op.apply n


main : Node.Program
main =
    Node.printLines
        (List.map
            [ identity 1
            , identity (Debug.log "identity" 2)
            , wrap 3
            , wrap (Debug.log "wrap" 4)
            , addThen (Debug.log "a" 5) 6
            , addThen 7 (Debug.log "b" 8)
            , thenAdd 9 (Debug.log "after" 10)
            , thenAdd 11 12
            , both (Debug.log "both" 13)
            , both 14
            , ignore (Debug.log "ignored" 15)
            , ignore 16
            , apply { name = "w", apply = wrap } 17
            , apply { name = "v", apply = wrap } 18
            ]
            String.fromInt
        )
