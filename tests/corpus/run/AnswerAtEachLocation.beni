run : (Int → T), Int, List Int → List Int
run mk k xs =
    t = through mk k
    u = through mk (k + 1)
    List.push xs (size t + size u)


make : Int → T
make k = C0 [ k ] [ k, k ]


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


main : Node.Program
main = Node.print (ints (run make 3 [ 1, 2 ]))
