-- FoldCallbackFeedback (Appendix B, S4; R-5.2.2, R-5.3.2): a feedback result
-- re-returned. The fold's accumulator holds the seed list again after every
-- round, so the elements of the answer are one list and the element write is
-- refused.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


main : Program
main =
    seed = [ 0 ]
    acc = List.foldl [ 1, 2, 3 ] [ seed ] λ_ a → List.append a [ seed ]
    r = List.map acc λl → List.push l 9
    Node.print (show r)
