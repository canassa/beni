-- CallbackResultTwice (Appendix B, S4; R-4.6.2, R-4.8.17): `twice` calls its
-- callback twice and returns the first answer twice, so `[ y, y ]` holds one
-- list in two places. The element write is refused: written in place, the
-- other position would print 1,9 too.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


twice : (⊤ → List Int) → List (List Int)
twice f =
    y = f ⊤
    _ = f ⊤
    [ y, y ]


main : Program
main =
    r = twice λ⊤ → [ 1 ]
    Node.print (show (List.update r 0 λl → List.push l 9))
