-- ReleaseUnusedPatternAlias (#1654; backend.md §9, *The release
-- optimiser*): nothing reads the alias `pair` of `read` or the alias
-- `both` of `sum`, so release liveness drops their bindings. Lowering
-- gives each alias the same subject node that `a` and `b` read their
-- fields of. A binding must go without a change to that node, or the
-- release build reads `a` and `b` of `undefined`.
-- Expected: both builds print `87`.
import Io
import Node
import Ref


type Pair
    = Pair (Ref.Ref Int) (Ref.Ref Int)


read : Pair → Int
read ((Pair a b) as pair) = Ref.get a + Ref.get b


sum : Ref.Ref Int × Ref.Ref Int → Int
sum (( a, b ) as both) = Ref.get a + Ref.get b


main : Node.Program
main = Io.run λ⊤ →
    first = read (Pair (Ref.make 20) (Ref.make 22))
    second = read (Pair (Ref.make 30) (Ref.make 12))
    third = sum ( Ref.make 1, Ref.make 2 )
    Node.print (String.fromInt (first + second + third))
