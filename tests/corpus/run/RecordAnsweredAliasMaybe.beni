-- A callee writes a field of the record in a `Just` and answers its other
-- parameter, and the caller hands it one record at both places (kernel §5
-- test 2, §11). In place the answer would be the written object, "5 5",
-- where the copying program prints "5 0". v3 refuses the call.
import Node exposing (Program)


type alias P =
    a : Int
    b : Int


g : Maybe P, P → P × P
g m v =
    case m of
        Just u →
            ( { u | a = u.a + 5 }, v )

        Nothing →
            ( v, v )


f : P → P × P
f q = g (Just q) q


main : Program
main =
    case f { a = 0, b = 0 } of
        ( u, v ) →
            Node.print "${String.fromInt u.a} ${String.fromInt v.a}"
