-- `List.map` of a function that casts, read as a list of `List Int × Int`:
-- the elements' second parts hold the list. The function handed to
-- `List.map` casts, so the call's wide element location, read with a part
-- of no location below it, escapes (ownership-v3-kernel.md §3.4).
import Node exposing (Program)
import Pun


g : a → b
g x = Pun.conv ( x, x )


second : List Int × Int, Int → Int
second q _ =
    ( _, k ) = q
    k


go : Int → String
go n =
    x0 = [ n ]
    ps : List (List Int × Int)
    ps = List.map [ x0 ] g
    h = List.foldl ps 0 second
    z : List Int
    z = Pun.conv h
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
