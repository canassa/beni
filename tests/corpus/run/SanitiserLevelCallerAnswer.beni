-- `SanitiserLevelCaller` through a callback (`ownership-v2.md` §2.1, #2223): `mk` puts its callback's answer at a
-- type variable's slot, and at `G R` the answer's `k` folds above it. The caller says the answer there, whole,
-- and `k`, still live, is refused.
import List
import Maybe
import Node exposing (Program)
import String


type G a
    = GL a
    | GP (G a) Int


type R
    = RL (List Int)
    | RW (G R)


wrG : G R → Int
wrG t =
    case t of
        GL r →
            wrR r
        GP u _ →
            wrG u


wrR : R → Int
wrR t =
    case t of
        RL xs →
            List.length (List.push xs 1)
        RW u →
            wrG u


wrM : Maybe (G R) → Int
wrM t =
    case t of
        Just u →
            wrG u
        Nothing →
            0


mk : (Int → a), Int → Maybe (G a)
mk f n = Just (GP (GL (f n)) 0)


main : Program
main =
    k = [ 1 ]
    a = wrM (mk (λn → RW (GL (RL k))) 1)
    Node.print (String.fromInt (a + List.length k))
