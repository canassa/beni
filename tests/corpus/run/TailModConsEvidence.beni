-- run: tail recursion modulo cons in a function with evidence parameters
-- (`docs/design/backend.md` §8, *Tail calls modulo cons*). The hidden
-- leading parameter of the `where` clause is an ordinary loop parameter,
-- carried or not by §8's syntactic test, exactly as in a plain tail loop.
--
-- `removeAll` forwards its evidence unchanged. `tagged` is the other half:
-- its consing step calls itself at a DIFFERENT instantiation, so the
-- checker writes a different evidence expression at that site, the
-- evidence slot is carried, and a loop that assumed it invariant would
-- compare two equal `Box`es with `String`'s `==` and answer 0. Both run deep enough to overflow Node's
-- default stack without the rewrite.
import List
import Node exposing (Program)
import String


removeAll : List a, a -> List a
    where a.eq : a, a -> Bool
removeAll xs value =
    case xs of
        [] ->
            []

        [ x, ...rest ] ->
            if x == value then
                removeAll rest value
            else
                [ x, ...removeAll rest value ]


type Box
    = Box Int


tagged : List a, a, Int -> List Int
    where a.eq : a, a -> Bool
tagged xs value n =
    if n <= 0 then
        []
    else
        case xs of
            [] ->
                []

            [ x, ..._ ] ->
                [ (if x == value then
                      1
                   else
                      0
                  )
                , ...tagged [ Box 1 ] (Box 1) (n - 1)
                ]


main : Program
main =
    let
        noisy = List.map (List.range 1 100000) (λi -> modBy i 4)
    in
    Node.printLines
        [ String.join (List.map (removeAll [ 1, 2, 1, 3 ] 1) String.fromInt) ","
        , String.fromInt (List.length (removeAll noisy 0))
        , String.join (List.map (tagged [ "a" ] "b" 3) String.fromInt) ","
        , String.fromInt (List.sum (tagged [ "a" ] "b" 100000))
        ]
