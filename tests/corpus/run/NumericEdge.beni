-- The arithmetic that JavaScript does NOT do the way beni says it does:
-- integer division truncates towards zero, `modBy` takes the sign of the
-- modulus and `remainderBy` the sign of the dividend, and a zero divisor
-- produces an `Int` rather than an infinity.
import Node exposing (Program)
import String


main : Program
main =
    Node.printLines
        [ String.fromInt (3 // 2)
        , String.fromInt (negate 3 // 2)
        , String.fromInt (3 // negate 2)
        , String.fromInt (1 // 0)
        , String.fromInt (modBy 4 11)
        , String.fromInt (modBy 4 (negate 1))
        , String.fromInt (remainderBy 4 11)
        , String.fromInt (remainderBy 4 (negate 1))
        , String.fromInt (round 1.5)
        , String.fromInt (round (negate 1.5))
        , String.fromInt (floor 1.9)
        , String.fromInt (ceiling 1.1)
        , String.fromInt (truncate (negate 1.9))
        , String.fromFloat (sqrt 9.0)
        , String.fromFloat (toFloat 5)
        , String.fromInt (clamp 100 200 42)
        , String.fromInt (max 3 9)
        , String.fromInt (min 3 9)
        ]
