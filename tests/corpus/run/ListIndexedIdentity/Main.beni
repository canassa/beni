-- Which operations of `core/List` give back their input ITSELF when the
-- result would equal it, and which build a fresh list, observed through a
-- test platform's `refEq` (`backend.md` §4, *Identity*; `language.md`
-- §6.8).
--
-- The writers, and `drop`, give back the input (`same`):
--
--   * every write out of range: `set`, `update`, `swap`, `insertAt`,
--     `removeAt`, with a negative index and one at or past the end
--     (`insertAt` at `length` is in range: it appends);
--   * `swap xs i i`, and `set`, `update` and `swap` that write the value
--     already there (the same value, `===`, not an equal one), on a plain
--     list and on a list written to past its threshold alike;
--   * `pop []`;
--   * `drop xs 0`, a view by representation.
--
-- A writer's result is its input whether or not it wrote anything, as it
-- is when it writes in place; nothing else is promised of these lines.
--
-- The functions that read a list and build another give a fresh list
-- (`copied`) even when it would equal their input — the owner's decision
-- of 2026-10-13, which reversed the identity promises these lines pinned
-- as `same` until then: `slice` and `take` covering the whole list,
-- `filter` keeping every element, `reverse`, `sort`, `sortWith` and
-- `sortBy` of fewer than two elements, and `map` and `indexedMap` whose
-- every result is the element they were given.
--
-- The trailing `copied` lines are a write in range, a partial `slice`, a
-- `filter` that drops one and a `map` that changes one.
import Identity
import List
import Node


show : String, Bool → String
show label b =
    if b then
        label ++ " same"
    else
        label ++ " copied"


main : Node.Program
main =
    xs = [ 1, 2, 3 ]

    empty = List.drop xs 3

    one = [ 7 ]

    pair = [ 4, 4 ]

    -- Past `push`'s threshold: a list that has been written to.
    wide = List.foldl (List.range 1 40) [] λn acc → List.push acc n
    Node.printLines
        [ show "set -1" (Identity.refEq (List.set xs (-1) 9) xs)
        , show "set length" (Identity.refEq (List.set xs 3 9) xs)
        , show "update -1" (Identity.refEq (List.update xs (-1) λx → x + 1) xs)
        , show "update length" (Identity.refEq (List.update xs 3 λx → x + 1) xs)
        , show "swap -1" (Identity.refEq (List.swap xs (-1) 0) xs)
        , show "swap length" (Identity.refEq (List.swap xs 0 3) xs)
        , show "swap i i" (Identity.refEq (List.swap xs 1 1) xs)
        , show "insertAt -1" (Identity.refEq (List.insertAt xs (-1) 0) xs)
        , show "insertAt past length" (Identity.refEq (List.insertAt xs 4 0) xs)
        , show "removeAt -1" (Identity.refEq (List.removeAt xs (-1)) xs)
        , show "removeAt length" (Identity.refEq (List.removeAt xs 3) xs)
        , show "slice all" (Identity.refEq (List.slice xs 0 3) xs)
        , show "slice clamped" (Identity.refEq (List.slice xs (-9) 9) xs)
        , show "take all" (Identity.refEq (List.take xs 3) xs)
        , show "take more" (Identity.refEq (List.take xs 9) xs)
        , show "drop 0" (Identity.refEq (List.drop xs 0) xs)
        , show "pop []" (Identity.refEq (List.pop empty) empty)
        , show "filter all" (Identity.refEq (List.filter xs λx → x > 0) xs)
        , show "reverse one" (Identity.refEq (List.reverse one) one)
        , show "reverse []" (Identity.refEq (List.reverse empty) empty)
        , show "sort []" (Identity.refEq (List.sort empty) empty)
        , show "sortWith one" (Identity.refEq (List.sortWith one λa b → Basics.compare a b) one)
        , show "sortBy one" (Identity.refEq (List.sortBy one λa → a) one)
        , show "set same" (Identity.refEq (List.set xs 1 2) xs)
        , show "update same" (Identity.refEq (List.update xs 1 λx → x) xs)
        , show "swap equal" (Identity.refEq (List.swap pair 0 1) pair)
        , show "set same written" (Identity.refEq (List.set wide 35 36) wide)
        , show "map identity" (Identity.refEq (List.map xs λx → x) xs)
        , show "indexedMap identity" (Identity.refEq (List.indexedMap xs λ_ x → x) xs)
        , show "map identity written" (Identity.refEq (List.map wide λx → x) wide)
        , show "set in range" (Identity.refEq (List.set xs 1 9) xs)
        , show "insertAt length" (Identity.refEq (List.insertAt xs 3 0) xs)
        , show "slice part" (Identity.refEq (List.slice xs 0 2) xs)
        , show "filter one out" (Identity.refEq (List.filter xs λx → x > 1) xs)
        , show "set written" (Identity.refEq (List.set wide 35 0) wide)
        , show "map one changed" (Identity.refEq (List.map xs λx → if x == 2 then 20 else x) xs)
        ]
