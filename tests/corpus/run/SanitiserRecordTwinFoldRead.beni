-- `SanitiserRecordTwinFold`'s refused twin (`ownership-v2.md` §2.8; #1018): the callback answers one
-- record at two fields, and it reads `v.b` after it wrote `v.a`. From the second step on, the two are
-- one object, so that read is stale where the update is a store: `seen` is 2 and not 1. Checker v2
-- refuses the fold.
import Node exposing (Program)


type alias D =
    tag : String
    count : Int


type alias Acc =
    a : D
    b : D
    seen : Int


bump : Int, D → D
bump n d = { d | count = d.count + n }


step : Int, Acc → Acc
step n v =
    r = bump n v.a
    { a = r, b = r, seen = v.b.count }


run : List Int, Acc → Acc
run ns t = List.foldl ns t λn v → step n v


main : Program
main =
    out = run [ 1, 1 ] { a = { tag = "a", count = 0 }, b = { tag = "b", count = 100 }, seen = 0 }
    Node.printLines [ String.fromInt out.seen, String.fromInt out.a.count ]
