-- A regression guard: a `let` helper whose receiver is its OWN
-- parameter and whose argument is the outer `x` — `g y = y.combine x` — is
-- used twice at `T`, so `f 5` is `( 6, 7 )`. The helper generalises over
-- its own receiver's requirement while the outer `x` stays the enclosing
-- function's, so both uses resolve `combine` at `T` and read the same
-- outer argument.
import Node exposing (Program)


type T
    = T Int


pub combine : T, Int -> Int
combine (T a) b =
    a + b


f x =
    let
        g y =
            y.combine x
    in
    ( g (T 1), g (T 2) )


main : Program
main =
    let
        ( a, b ) =
            f 5
    in
    Node.printLines [ String.fromInt a ++ " " ++ String.fromInt b ]
