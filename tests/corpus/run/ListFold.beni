-- Folding, mapping and filtering: the library is subject first and function
-- last, so the list leads and every one of them passes a FUNCTION as its
-- final argument. Currying is gone (`fast-compiler.md` §9.3), so each of
-- those is an ordinary closure of known arity.
import List
import Node exposing (Program)
import String


main : Program
main =
    Node.printLines
        [ String.fromInt (List.foldl (List.range 1 10) 0 (λx acc -> x + acc))
        , String.fromInt (List.foldr [ 1, 2, 3 ] 0 (λx acc -> x - acc))
        , String.fromInt (List.sum (List.map (List.range 1 5) (λn -> n * n)))
        , String.fromInt (List.product [ 1, 2, 3, 4 ])
        , String.fromInt (List.length (List.filter (List.range 1 10) (λn -> modBy n 2 == 0)))
        , String.join (List.map (List.sort [ 3, 1, 2 ]) String.fromInt) ","
        , String.join (List.map (List.take (List.range 1 10) 3) String.fromInt) ","
        , String.join (List.map (List.drop (List.range 1 10) 7) String.fromInt) ","
        ]
