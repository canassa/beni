-- Ordinary recursion through `==` or `<` builds. A call to a member
-- of the same recursive group gets exactly the evidence its callee ends up
-- taking (static-dispatch-spike.md §6.4, §7.2; checker-v2.md §12.3). Eight
-- forms, one per line group: `countdown`, `growTo` (`String`
-- with no `number`), `sumDown`, `largest`, `sym` and
-- `symFlip`, `findMax` and `step` (at `Int` and `String`), and
-- `a1` and `b1` (two constraints). Expected `T`, `T`, `10`, `q`, `T`, `9`,
-- `q`, `0`, `1`.
--
-- Oracle twin: this file with every recursive function
-- annotated (`countdown : Int -> Bool`, `growTo : String, String -> Bool`,
-- `sumDown : Int -> Int`, `largest : List String, String -> String`,
-- `sym`/`symFlip : Int, Int -> Bool`, `findMax : List a, a -> a` and
-- `step : List a, a, a -> a` with `where a.compare : a, a -> Order`, and
-- `a1`/`b1 : List a, List a -> Int` with `where a.eq : a, a -> Bool,
-- a.compare : a, a -> Order`) prints exactly the expected nine lines. As
-- written, `build` must not stop with INTERNAL ERROR "The
-- hidden arguments of this call do not add up" at the recursive calls.
import Node exposing (Program)


countdown n =
    if n == 0 then
        True

    else
        countdown (n - 1)


growTo n m =
    if m == n then
        True

    else
        growTo (n ++ "x") m


sumDown n =
    if n > 0 then
        n + sumDown (n - 1)

    else
        0


largest xs m =
    case xs of
        [] ->
            m

        x :: r ->
            largest r
                (if x > m then
                    x

                 else
                    m
                )


sym x y =
    if x == y then
        True

    else
        symFlip x y


symFlip x y =
    sym y x


findMax xs best =
    case xs of
        [] ->
            best

        x :: r ->
            step r x best


step r x best =
    if x > best then
        findMax r x

    else
        findMax r best


a1 xs ys =
    case xs of
        [] ->
            0

        x :: r ->
            (if List.member ys x then
                1

             else
                0
            )
                + b1 r ys


b1 xs ys =
    case ys of
        [] ->
            a1 xs []

        y :: r ->
            if y < y then
                99

            else
                a1 xs r


flag : Bool -> String
flag b =
    if b then
        "T"

    else
        "F"


main : Program
main =
    Node.printLines
        [ flag (countdown 3)
        , flag (growTo "y" "yx")
        , String.fromInt (sumDown 4)
        , largest [ "b", "q" ] "a"
        , flag (sym 1 1)
        , String.fromInt (findMax [ 3, 9, 2 ] 0)
        , findMax [ "b", "q" ] "a"
        , String.fromInt (a1 [ 1, 2, 3 ] [ 2, 3 ])
        , String.fromInt (a1 [ "x" ] [ "x" ])
        ]
