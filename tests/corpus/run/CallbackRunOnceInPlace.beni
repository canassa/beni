-- The safe twin of `CallbackRunTwiceLive`: `hold` runs its function once and
-- lets it go nowhere else, so the list the function captured is at one place
-- of `hold`'s answer, and v3 accepts the push of each element in place
-- (`ownership-v3-kernel.md` §12 item 8, `Fn.single`).
import List
import Node exposing (Program)
import String


hold : (⊤ → List Int) → List (List Int)
hold f = [ f ⊤ ]


run : List Int → String
run xs =
    rows = List.map (hold λ⊤ → xs) λl → List.push l 9
    String.join (List.map (List.concat rows) String.fromInt) ","


main : Program
main = Node.printLines [ run [ 1, 2 ] ]
