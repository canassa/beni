type alias Letters =
    a : Int
    b : String


type alias Counter =
    step : Int → Int
    name : String


pairText : Pair → String
pairText p = "${String.fromInt p.zeta}/${String.fromInt p.alpha}"


main : Node.Program
main =
    rect : Rect
    rect = Rect 2 3 "rect"

    disc : Disc
    disc = { radius = 4, name = "disc" }

    pairs = [ Shapes.pairOf 1 9, Shapes.pairOf 9 1, Shapes.pairOf 5 5, Shapes.pairOf 0 9 ]

    byPair = Dict.fromList (List.map pairs λp → ( p, p.zeta + p.alpha ))

    letters : Letters
    letters = { a = 1, b = "b" }

    tuple = ( letters.b, letters.a )

    counter : Counter
    counter = { step = λn → n + 10, name = "counter" }
    Node.printLines
        [ Shapes.nameOf rect
        , Shapes.nameOf disc
        , Shapes.nameOf (Shapes.rename disc "renamed")
        , String.fromInt (Shapes.area rect)
        , String.fromInt (disc.radius + rect.width + rect.height)
        , String.join (List.map (List.sort pairs) pairText) " "
        , String.join (List.map (Dict.keys byPair) pairText) " "
        , if Shapes.pairOf 1 2 == Shapes.pairOf 1 2 then "equal" else "unequal"
        , if Shapes.pairOf 2 1 < Shapes.pairOf 1 2 then "zeta second" else "zeta first"
        , String.fromInt (Shapes.zetaOf (Shapes.pairOf 7 8))
        , case tuple of
            ( b, a ) →
                "${b} ${String.fromInt a}"
        , "${counter.name} ${String.fromInt (counter.step 1)}"
        , String.fromInt (wideSum wide)
        , String.fromInt (wideSum { wide | f60 = 0 })
        ]
