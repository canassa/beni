-- Every field read, so the last ones are spelled with two characters.
wideSum : Wide → Int
wideSum w =
    w.f01
        + w.f02
        + w.f03
        + w.f04
        + w.f05
        + w.f06
        + w.f07
        + w.f08
        + w.f09
