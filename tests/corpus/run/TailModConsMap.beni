-- run: the fail-first fixture of tail recursion modulo cons
-- (`docs/design/backend.md` §8, *Tail calls modulo cons*). `mapRec` is the
-- textbook `map` an Elm programmer writes, `[ f x, ...mapRec rest f ]`: the
-- self-call is not a tail call, it is spread last in a list in return position,
-- so without the rewrite every element is a stack frame and Node's default
-- stack overflows long before 100 000 of them. `filterRec` mixes the two
-- kinds of step in one loop: the kept branch conses, the dropping branch is
-- an ordinary tail self-call.
--
-- Before the rewrite both died with `RangeError: Maximum call stack size
-- exceeded`. The small lists pin the order of the result, which a loop that
-- built the list backwards would get wrong without overflowing.
import List
import Node exposing (Program)
import String


mapRec : List a, (a -> b) -> List b
mapRec xs f =
    case xs of
        [] ->
            []

        [ x, ...rest ] ->
            [ f x, ...mapRec rest f ]


filterRec : List a, (a -> Bool) -> List a
filterRec xs keep =
    case xs of
        [] ->
            []

        [ x, ...rest ] ->
            if keep x then
                [ x, ...filterRec rest keep ]
            else
                filterRec rest keep


show : List Int -> String
show xs = String.join (List.map xs String.fromInt) ","


main : Program
main =
    let
        big = List.range 1 100000
        doubled = mapRec big (\x -> x * 2)
        odd = filterRec big (\x -> modBy x 2 == 1)
    in
    Node.printLines
        [ show (mapRec [ 1, 2, 3 ] (\x -> x * 10))
        , show (filterRec [ 1, 2, 3, 4, 5 ] (\x -> x /= 3))
        , show (mapRec [] (\x -> x + 1))
        , String.fromInt (List.length doubled)
        , String.fromInt (List.sum doubled)
        , show (List.take doubled 3)
        , String.fromInt (List.length odd)
        , String.fromInt (List.sum odd)
        ]
