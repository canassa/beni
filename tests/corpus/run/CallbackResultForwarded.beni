-- CallbackResultForwarded (Appendix B, S4; R-4.6.2, R-4.8.17): `h` forwards
-- its callback's second answer, and `k` stores that answer twice. The write
-- of one element is refused.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


h : (⊤ → List Int) → List Int
h f =
    _ = f ⊤
    f ⊤


k : (⊤ → List Int) → List (List Int)
k f =
    a = h f
    [ a, a ]


main : Program
main =
    r = k λ⊤ → [ 1 ]
    Node.print (show (List.update r 0 λl → List.push l 9))
