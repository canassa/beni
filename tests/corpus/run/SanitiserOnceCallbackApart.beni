-- The twin of `SanitiserOnceCallbackShared` (`ownership-v2.md` §2.11.3, *a taken
-- supply*): the same callbacks over lists of apart lists, a list the
-- callee builds of apart parts, a lambda that passes the label on,
-- and rows that share only a key the callback does not write. v2 accepts every
-- edit in place; the sanitised run prints what the plain run prints.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


shows : List (List Int) → String
shows ls = String.join (List.map ls show) ";"


push1 : List Int → List Int
push1 l = List.push l 1


app : a, (a → b) → b
app v f = f v


pair : a, a, (List a → b) → b
pair v w f = f [ v, w ]


opt : Maybe a, (a → b) → Maybe b
opt m f = Maybe.map m λz → f z


keyed :
      List (List Int × List Int)
    , (List Int × List Int → List Int × List Int)
    → List (List Int × List Int)
keyed rs f = List.update rs 1 λ( a, b ) → f ( a, b )


main : Program
main =
    key = [ 4 ]
    rows = keyed [ ( key, [ 1 ] ), ( key, [ 2 ] ) ] λ( k, vs ) → ( k, List.push vs 8 )
    Node.printLines
        [ shows (app [ [ 1 ], [ 2 ] ] λl → List.map l push1)
        , shows (Maybe.withDefault (Maybe.map (Just [ [ 1 ], [ 2 ] ]) λl → List.map l push1) [])
        , shows (app [ [ 1 ], [ 2 ] ] λl → app l λm → List.map m push1)
        , shows (app [ [ 1 ], [ 2 ] ] λl → List.update l 0 push1)
        , shows (pair [ 1 ] [ 2 ] λl → List.map l push1)
        , shows (Maybe.withDefault (opt (Just [ [ 1 ], [ 2 ] ]) λl → List.map l push1) [])
        , String.join (List.map rows λ( k, vs ) → show k ++ ":" ++ show vs) ";"
        ]
