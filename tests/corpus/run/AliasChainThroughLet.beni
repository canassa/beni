-- A `let` chain of 1 100 bindings through `wrap : a -> Id a`
-- builds a 1 100-link alias chain over `Int`. `TypeStore.resolved` must not
-- stop at 1 024 links and answer `err`: the `==` below would be a
-- `poisoned` wanted, `check` would exit 0 and `build` say INTERNAL ERROR
-- ("I cannot tell what this call dispatches to"). Expected:
-- it builds and prints `T`. Oracle twin: the same program with 1 000
-- bindings prints `T`.
import Node exposing (Program)


type alias Id a =
    a


wrap : a -> Id a
wrap x = x


one : Int
one = 1


g : Bool
g =
    a0 = wrap one

    a1 = wrap a0

    a2 = wrap a1

    a3 = wrap a2

