-- BuilderCallbackImportedShared (Appendix B, S4; R-5.2.9, R-4.6.3):
-- BuilderCallbackSharing across a module boundary. `Lib.mapShared` maps a
-- callback that answers one top-level list of `Lib`, and its block says so:
-- the inner write of its result is refused, as the direct one is.
import Lib
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


main : Program
main =
    ys = List.update (Lib.mapShared [ 1, 2 ]) 1 λl → List.push l 7
    Node.print "${show ys} ${show (Lib.mapShared [ 3 ])}"
