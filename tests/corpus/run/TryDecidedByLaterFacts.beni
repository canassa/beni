-- A `?` is decided by the facts of its whole declaration, not the
-- first ones the solver meets (the owner's decision as amended, checker-v2.md
-- §8.1, §8.6). In `h` the `==` on `m` comes after `m?` and says nothing about
-- the shape, and the result `Just (…)` says `Maybe`. In `f` the `?` is on
-- `g`'s parameter and only `k`'s later use `k 5` inside `Maybe.withDefault`
-- says `Maybe` (the parameter is not named `h`, so it does
-- not shadow the top-level `h`). Expected `Just 2`, `Nothing`, `Just 2`, `6`.
--
-- Oracle twin: this file with `h : Maybe Int -> Maybe Int`,
-- `f : (Int -> Maybe Int) -> ( Maybe Int, Int )` and `g : Maybe Int -> Maybe
-- Int` annotated prints exactly the expected four lines. Committing both
-- `?` to `Result` at once would refuse the file with TYPE MISMATCH
-- `Maybe a` against `Result b c`.
import Node exposing (Program)


h m =
    v = m?
    if m == m then
        Just (v + 1)
    else
        Nothing


f k =
    g u = k (u?)
    ( g (Just 1), Maybe.withDefault (k 5) 0 )


main : Program
main =
    ( first, second ) = f λn → Just (n + 1)
    Node.printLines
        [ Debug.toString (h (Just 1))
        , Debug.toString (h Nothing)
        , Debug.toString first
        , String.fromInt second
        ]
