-- An accumulator loop builds a plain array (`backend.md` §8, *Accumulators
-- build a plain array*): a loop whose list parameter every step passes on
-- unchanged, prepended to or appended to, and that is read nowhere else
-- but at an exit, pushes onto one array it owns and joins it with the
-- entry value once, at the exit. What it must keep is what the cons loop
-- gave: the list, in order, over 100 000 elements; the heads evaluated in
-- written order (`Debug.log`), each step's before the next argument; the
-- entry list itself when no step was taken (`refEq`); the entry list's
-- elements after a prepended run and before an appended one; an exit that
-- returns the accumulator inside a tuple (the table app's `buildFrom`); a
-- `let` function; and a loop that also reads the accumulator, which is
-- left as it was.
import Identity
import List
import Node
import String


countdown : Int, List Int → List Int
countdown n acc =
    if n ≤ 0 then
        acc
    else
        countdown (n - 1) [ n, …acc ]


countup : Int, Int, List Int → List Int
countup i n acc =
    if i > n then
        acc
    else
        countup (i + 1) n [ …acc, i ]


pairs : Int, List String → List String
pairs n acc =
    if n ≤ 0 then
        acc
    else
        pairs (Debug.log "next" (n - 1))
            [ Debug.log "first" "${String.fromInt n}a"
            , Debug.log "second" "${String.fromInt n}b"
            , …acc
            ]


build : Int, Int, List { id : Int } → List { id : Int } × Int
build id seed rows =
    if id < 1 then
        ( rows, seed )
    else
        build (id - 1) (seed + id) [ { id = id }, …rows ]


withLet : Int → List Int
withLet n =
    go : Int, List Int → List Int
    go k acc = if k ≥ n then acc else go (k + 1) [ k * k, …acc ]
    go 0 []


-- Reads the accumulator in a `case`: not a building loop.
capped : Int, List Int → List Int
capped n acc =
    case acc of
        [ x, …_ ] →
            if x ≥ n then acc else capped n [ x + 1, …acc ]

        [] →
            capped n [ 0 ]


show : List Int → String
show xs = String.join (List.map xs String.fromInt) ","


main : Node.Program
main =
    big = countdown 100000 []
    entry = [ 7, 8 ]
    ( rows, seed ) = build 4 0 []
    Node.printLines
        [ "${String.fromInt (List.length big)} ${show (List.take big 3)} ${String.fromInt (List.foldl big 0 (+))}"
        , show (countdown 3 [ 100, 200 ])
        , show (countup 1 4 [ 0 ])
        , String.join (pairs 2 [ "end" ]) ","
        , if Identity.refEq (countdown 0 entry) entry then
            "no step: the entry list"
          else
            "no step: copied"
        , if Identity.refEq (countup 5 4 entry) entry then
            "no append: the entry list"
          else
            "no append: copied"
        , "${show (List.map rows .id)} ${String.fromInt seed}"
        , show (withLet 4)
        , show (capped 3 [])
        ]
