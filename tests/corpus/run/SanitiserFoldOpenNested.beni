-- A rest past the fold onto a literal of another form (`ownership-v2.md` §2.1, *A step
-- past a fold*, #2062): the value `findA` hands its callback is below the fold, so the
-- steps a reader takes from it are `T`'s, and the literal there is a list. They name
-- nothing in it, and an empty read says fresh. An arrival past a `var` keeps no rest.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


shows : List (List Int) → String
shows ls = String.join (List.map ls show) ";"


type T a
    = Leaf a
    | Wrap (T (List a))


findL : T a, (a → List Int) → List Int
findL t f =
    case t of
        Leaf x →
            f x

        Wrap u →
            findL u λl →
                case l of
                    [ x, …_ ] →
                        f x

                    _ →
                        []


findA : T a, (a → b), b → b
findA t f z =
    case t of
        Leaf x →
            f x

        Wrap u →
            findA u
                (λl →
                    case l of
                        [ x, …_ ] →
                            f x

                        _ →
                            z
                )
                z


pk : T (List Int) → T (List Int)
pk t = t


get : T (List Int) → List Int
get t = findL t λl → l


main : Program
main =
    k = [ 1 ]
    n = List.push (findA (Wrap (Leaf [ Wrap (Leaf [ k ]) ])) (λt → findL t λl → l) []) 2
    m = [ 1 ]
    o = List.push (get (findA (Wrap (Leaf [ Wrap (Leaf [ m ]) ])) pk (Leaf []))) 2
    Node.print (show n ++ "|" ++ show k ++ "|" ++ show o ++ "|" ++ show m)
