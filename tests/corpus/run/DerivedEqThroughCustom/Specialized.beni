-- This custom equality is deliberately specialized to Holder Int. A wrapper
-- around that exact application may derive equality through the method.
pub type Holder a
    = Holder a String (Int → Int)


pub eq : Holder Int, Holder Int → Bool
eq left right =
    case left of
        Holder _ labelLeft _ →
            case right of
                Holder _ labelRight _ →
                    labelLeft == labelRight
