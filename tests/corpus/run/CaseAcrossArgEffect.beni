-- run: a `case` on what a function returns, fused across the call under
-- `--release` (`backend.md` §9, *Slice 9 across a call*, amended 2026-10-24
-- for #946), with an argument that is not an atom: it is bound first and
-- kept, though its parameter is never read, so its `Debug.log` still runs,
-- once, before the body. The development build prints the same.
import Node


type Answer
    = Yes Int
    | No


judge : Int, Int → Answer
judge tag n =
    doubled = n * 2
    if doubled > 4 then
        Yes doubled
    else
        No


reply : Int → String
reply n =
    case judge (Debug.log "tag" n) (n + 1) of
        Yes k →
            "yes ${String.fromInt k}"

        No →
            "no"


main : Node.Program
main = Node.printLines (List.map [ 1, 5 ] reply)
