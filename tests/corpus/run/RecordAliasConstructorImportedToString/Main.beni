-- run: an IMPORTED record alias's constructor builds the RECORD (backend.md
-- §4's record-alias row), with the same keys as its local twin: the
-- interface carries the alias's field names (checker-v2.md §14.2), so
-- `Debug.toString (P 1 "a")` prints the record. Without the field names
-- emit would have to refuse it, since a tagged object would give one type
-- two shapes at run time.
--
-- Oracle twin: the local alias (`run/RecordAliasConstructor.beni`) prints the
-- record the same way.
import Node exposing (Program)
import Pt exposing (P)


main : Program
main = Node.printLines [ Debug.toString (P 1 "a") ]
