-- See Main.beni: a component module, its `view` and three members.
import Html exposing (Html)


pub type alias Props msg =
    title : String
    wide : Bool
    children : Html msg


pub defaults : Props msg
defaults = { title = "untitled", wide = False, children = <></> }


pub view : Props msg -> Html msg
view props =
    <section class={[ ( "card", True ), ( "wide", props.wide ) ]}>
        <h2>{props.title}</h2>
        {props.children}
    </section>


pub header : { text : String } -> Html msg
header props = <header>{props.text}</header>


pub listOf : { items : List String, children : String -> Html msg } -> Html msg
listOf props = <ul><For each={props.items}>{props.children}</For></ul>


pub badge : { label : String, children : Html msg } -> Html msg
badge props = <span title={props.label}>{props.children}</span>
