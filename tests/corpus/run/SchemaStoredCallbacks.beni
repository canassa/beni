-- An interpreter retains a suspended callback and reports no callable as data.
import Io
import Node
import Schema exposing (Schema)
import Task


forward : Int → Result (List Schema.Issue) (⊤ → Int)
forward number = Ok λ⊤ →
    Task.yieldNow ⊤
    number


backward : (⊤ → Int) → Result (List Schema.Issue) Int
backward _ = Err [ Schema.issue "callback refused" ]


description : Schema Int (⊤ → Int)
description =
    Schema.flip
        (Schema.flip
            (Schema.converted Schema.int (Schema.conversion forward backward))
        )


main : Node.Program
main = Io.run λ⊤ →
    case Schema.decode description 42 of
        Ok callback →
            resumed = callback ⊤
            defaults = Schema.defaultOptions ⊤
            options = { defaults | reportInput = True }
            report =
                case Schema.encodeWith description options callback of
                    Err [ problem ] →
                        case problem.input of
                            Nothing →
                                "opaque input"
                            Just _ →
                                "callable leaked into data"
                    _ →
                        "missing conversion failure"
            Node.printLines [ String.fromInt resumed, report ]
        Err _ →
            Node.print "callback lost"
