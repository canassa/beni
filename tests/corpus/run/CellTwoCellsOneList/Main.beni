-- Two cells that could hold one list hold two (ownership-v3-kernel.md §13
-- item 12 (e), *One cell at two places is decided on cells*, amended for code
-- reader CR14's U2): the shapes of CellTwoCellsOneListLive, where each second
-- cell gets a copy. A writer fiber of each cell pushes in place onto a list no
-- other cell holds, and every program is accepted.
import Duration
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


madeOfOne : ⊤ → String
madeOfOne ⊤ =
    l = [ 1 ]
    r1 = Ref.make l
    r2 = Ref.make (List.copy l)
    _ = Task.spawn λ⊤ → Ref.update r1 λx → List.push x 5
    _ = Task.spawn λ⊤ → Ref.update r2 λx → List.push x 6
    Task.sleep (Duration.millis 5)
    "${ints (Ref.get r1)} ${ints (Ref.get r2)}"


setAfter : ⊤ → String
setAfter ⊤ =
    r1 = Ref.make [ 1 ]
    r2 = Ref.make [ 0 ]
    _ = Task.spawn λ⊤ → Ref.update r1 λx → List.push x 5
    _ = Task.spawn λ⊤ → Ref.update r2 λx → List.push x 6
    Ref.set r2 (List.copy (Ref.get r1))
    Task.sleep (Duration.millis 5)
    "${ints (Ref.get r1)} ${ints (Ref.get r2)}"


raced : ⊤ → String
raced ⊤ =
    l = [ 1 ]
    r1 = Ref.make l
    r2 = Ref.make (List.copy l)
    w1 =
        λ⊤ →
            Ref.update r1 λx → List.push x 5
            Task.sleep (Duration.millis 2)
    w2 =
        λ⊤ →
            Ref.update r2 λx → List.push x 6
            Task.sleep (Duration.millis 3)
    Task.race w1 w2
    "${ints (Ref.get r1)} ${ints (Ref.get r2)}"


main : Program
main = Io.run λ⊤ →
    Node.printLines
        [ madeOfOne ⊤
        , setAfter ⊤
        , raced ⊤
        ]
