-- `ownership-v2.md` §2.8, *a refused record line is an error*: `twice` updates `r` two times. The
-- first update is refused, because the old record is updated again, and a build that enforces
-- stops there. Written in place, `s` and `t` are one object, and the answer is 1224.
import Node exposing (Program)


twice : { x : Int, y : Int } → Int
twice r =
    s = { r | x = r.x + 1 }
    t = { r | x = r.x + 10 }
    s.x * 100 + t.x + r.x + s.y


main : Program
main = Node.printLines [ String.fromInt (twice { x = 1, y = 2 }) ]
