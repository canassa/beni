-- Rows inside rows (language.md §11.9, §11.18; backend.md §15.6): a `For`
-- row compiled in place holds a `Show` body and a `For` row of its own,
-- each placed by the lowering inside the outer row's function, and each
-- reads the outer row's item and position and a local of the view — the
-- compiler binds a row's parameters to the names the lowering chose, so
-- an inner row reads the outer one's by closure.
import Html exposing (Html)
import Node
import Ssr


type alias Group =
    name : String
    items : List String
    lead : Maybe String


view : String, List Group -> Html msg
view sep groups =
    <div>
        <For each={groups} keyed={.name}>
            {λg i ->
                <section>
                    <Show when={g.lead} keyed>{λl -> <b>{l}{sep}{i}</b>}</Show>
                    <For each={g.items}>{λitem j -> <i>{g.name}{sep}{item}{sep}{i}{j}</i>}</For>
                </section>
            }
        </For>
    </div>


main : Node.Program
main =
    Node.print
        (Ssr.render
            (view "/"
                [ { name = "a", items = [ "x", "y" ], lead = Just "L" }
                , { name = "b", items = [], lead = Nothing }
                ]
            )
        )
