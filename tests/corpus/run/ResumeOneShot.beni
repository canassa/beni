-- run: `Task.resume` answers a wait a program started itself, once
-- (transparent-effects-proposal.md §17.3; report 23 row 3).
--
--   - The waiter's registration keeps its `Resume` in a `Ref`; the main
--     fiber resumes it with 1 and then with 2. The first answers the wait;
--     the second does nothing, so the waiter goes on with 1.
--   - `resume` queues the waiter and returns: the line after both resumes
--     prints before the waiter's, which runs at a later turn.
--   - A `resume` called while the registration is still running answers
--     the wait at once: nothing parks, and no other fiber runs between.
import Io
import Node exposing (Program)
import Ref
import Task


main : Program
main = Io.run λ⊤ →
    slot = Ref.make Nothing

    waiter = Task.spawn λ⊤ →
        v = Task.callback λr →
            Ref.set slot (Just r)
            λ⊤ → ⊤
        Debug.log "waiter woke with" v
    Task.yieldNow ⊤

    case Ref.get slot of
        Just r →
            Task.resume r 1
            Task.resume r 2

        Nothing →
            Debug.log "never registered" ⊤
    Debug.log "resumed twice" ⊤
    first = Task.join waiter
    other = Task.spawn λ⊤ → Debug.log "another fiber ran" ⊤

    now = Task.callback λr →
        Task.resume r 3
        λ⊤ → ⊤
    _ = Debug.log "answered at once" now
    Task.join other
    Node.print "joined ${String.fromInt first}"
