-- The supplied twin of `WideCallbackFresh`: every list of `use`'s answer is
-- the parameter `x`, so `r.a0.b0` is `r.a1.b1`, and `demo`'s push must copy
-- (§2.9.3, *A subtree held whole*; #2413). v2 refuses it.
import List
import Node exposing (Program)
import String


type alias R =
    b0 : List Int
    b1 : List Int
    b2 : List Int
    b3 : List Int


type alias H =
    a0 : R
    a1 : R
    a2 : R
    a3 : R


h : (⊤ → R) → H
h f = { a0 = f ⊤, a1 = f ⊤, a2 = f ⊤, a3 = f ⊤ }


use : List Int → H
use x = h λ⊤ → { b0 = x, b1 = x, b2 = x, b3 = x }


demo : List Int → List Int × List Int
demo x =
    r = use x
    ( List.push r.a0.b0 1, r.a1.b1 )


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


main : Program
main =
    p = demo [ 7 ]
    Node.print (show p.0 ++ "|" ++ show p.1)
