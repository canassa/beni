-- run (checker-v2.md §8.4): a `let` generalises a
-- `let` function binding wherever the `let` stands — inside a lambda, a
-- `case` branch or an `if` branch too. The generator marks a binder below a
-- lambda or branch `.ended` once its occurs check is placed; reading that
-- as "not a header" would hold every constrained variable in such a `let`
-- and refuse its helper at its second type. `A`'s `eq` is
-- always `True` and `B`'s always `False`, so structural evidence would
-- print differently: each `same` must receive its own type's `eq`.
-- Expected `TF`, `TF`, `TF`, `TF`.
import B exposing (B)
import Node exposing (Program)


type A
    = A Int


pub eq : A, A -> Bool
eq a b = True


verdict : Bool, Bool -> String
verdict x y = (if x then "T" else "F") ++ (if y then "T" else "F")


inLambda : List Int -> List String
inLambda xs =
    List.map xs
        (λx ->
            same p q = p == q
            verdict (same (A x) (A 0)) (same (B.B x) (B.B x))
        )


inCase : Int -> String
inCase n =
    case n of
        0 ->
            same p q = p == q
            verdict (same (A 1) (A 2)) (same (B.B 1) (B.B 1))

        _ ->
            "x"


inIf : Int -> String
inIf n =
    if n == 0 then
        same p q = p == q
        verdict (same (A 1) (A 2)) (same (B.B 1) (B.B 1))
    else
        "y"


main : Program
main = Node.printLines (inLambda [ 1, 2 ] ++ [ inCase 0, inIf 0 ])
