-- run: a fiber resumes through its own scheduler
-- (transparent-effects-proposal.md §17.5, amended 2026-10-22). Two fibers
-- that yield three times each: under the program's one scheduler they
-- alternate, since `yieldNow` queues a fiber behind the other; under two
-- schedulers each drain runs its own queue to the end, so one fiber's lines
-- come before the other's. The fibers `withScheduler`'s work starts belong
-- to the scheduler too: `p` and `q` are spawned inside it.
import Io
import Node exposing (Program)
import Task


say : String → ⊤
say line = Debug.log line ⊤


steps : String, Int → ⊤
steps name n =
    if n == 0 then
        ⊤
    else
        say "${name} ${String.fromInt n}"
        Task.yieldNow ⊤
        steps name (n - 1)


main : Program
main = Io.run λ⊤ →
    say "one scheduler"
    a = Task.spawn λ⊤ → steps "a" 3
    b = Task.spawn λ⊤ → steps "b" 3
    Task.join a
    Task.join b
    say "two schedulers"
    first = Task.scheduler λ⊤ → ⊤
    second = Task.scheduler λ⊤ → ⊤
    c = Task.spawn λ⊤ → Task.withScheduler first λ⊤ → steps "c" 3
    d = Task.spawn λ⊤ → Task.withScheduler second λ⊤ → steps "d" 3
    Task.join c
    Task.join d
    say "spawned inside"
    p = Task.spawn λ⊤ → Task.withScheduler first λ⊤ → Task.join (Task.spawn λ⊤ → steps "p" 3)
    q = Task.spawn λ⊤ → Task.withScheduler second λ⊤ → Task.join (Task.spawn λ⊤ → steps "q" 3)
    Task.join p
    Task.join q
    Node.done
