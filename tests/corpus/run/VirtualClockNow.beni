-- run: `Clock.now` on a virtual clock (transparent-effects-proposal.md
-- §17.6) reads the clock's own time: what `Clock.virtual` set, then that
-- plus each `adjust`, whatever the wall clock does. An `adjust` of `zero`
-- changes nothing. Two virtual clocks are independent.
import Clock
import Duration
import Io
import Node exposing (Program)


main : Program
main = Io.run λ⊤ →
    a = Clock.virtual 5000
    b = Clock.virtual 0
    _ = Debug.log "a at first" (Clock.run a Clock.now)
    Clock.adjust a (Duration.seconds 2)
    _ = Debug.log "a after 2 s" (Clock.run a Clock.now)
    Clock.adjust a Duration.zero
    _ = Debug.log "a after zero" (Clock.run a Clock.now)
    Clock.adjust b (Duration.millis 7)
    _ = Debug.log "b after 7 ms" (Clock.run b Clock.now)
    Node.print
        "a then b: ${String.fromInt (Clock.run a Clock.now - Clock.run b Clock.now)} ms apart"
