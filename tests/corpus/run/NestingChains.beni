-- run: long operator chains, pipelines and nested calls, at lengths where
-- `backend.md` §4's *Emitted JavaScript nests only as deep as the source*
-- changes their shape, with every operand logged so that what the
-- program can see is pinned:
--
--   `&&` / `||`   one flat run, `a && b && c`, where they printed as
--                 `a && (b && …)`: the operands run left to right and stop at
--                 the first that decides (`language.md` §6.5). `hoisting`
--                 has a `case` among its operands, which needs statements —
--                 everything after it runs only when the operands before it
--                 said so
--   `+` `++`       70 terms: past `nesting.spill` the chain is bound to a
--                 `const` every 64 or so calls. Operands still run in written
--                 order, `++` included, although it groups to the right
--   `[ … ]`        70 elements, which were a chain of `::` until the list
--                 syntax (`language.md` §6.8) made them one literal, in
--                 written order
--   `|>` / nested  70 calls deep, innermost first
import Node exposing (Program)


n : String, Int → Int
n label v = Debug.log label v


s : String, String → String
s label v = Debug.log label v


b : String, Bool → Bool
b label v = Debug.log label v


inc : Int → Int
inc x = Debug.log "inc" (x + 1)


main : Program
main =
    conj =
        b "and1" True
            && b "and2" True
            && b "and3" True
            && b "and4" True
            && b "and5" True
