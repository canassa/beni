-- Host-owned methods stay in the sibling; beni checks receiver calls.
import Js


pub foreign pure counter : Int → Js.Value


foreign pure nestedObject : Int → Js.Value


foreign pure outer : ⊤ → Js.Value


foreign pure cachedObject : ⊤ → Js.Value


pub bump : Js.Value → Int
bump o = Js.to (Js.call o "bump" [])


pub nested : Int → Int
nested k = Js.to (Js.call (nestedObject k) "twice" [])


pub inner : ⊤ → String
inner ⊤ =
    made = Js.call (outer ⊤) "make" []
    own : String
    own = Js.to (Js.call made "own" [])
    seen : String
    seen = Js.to (Js.get made "outerName")
    "${own} ${seen}"


pub cached : ⊤ → String
cached ⊤ =
    o = cachedObject ⊤
    a : String
    a = Js.to (Js.call o "plain" [])
    b : String
    b = Js.to (Js.call o "plain" [])
    runs : Int
    runs = Js.to (Js.get o "runs")
    "${a} ${b} ${String.fromInt runs}"
