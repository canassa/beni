-- Set preserves insertion order, including in equality (#294).
import List
import Node exposing (Program)
import Set
import String


show : Set.Set Int → String
show set = Set.toList set ▷ List.map String.fromInt ▷ String.join ","


main : Program
main =
    set = Set.fromList [ 3, 1, 3, 2 ]
    Node.printLines
        [ show set
        , Set.foldl set "" λn acc → acc ++ String.fromInt n
        , Set.foldr set "" λn acc → acc ++ String.fromInt n
        , if Set.fromList [ 1, 2 ] == Set.fromList [ 2, 1 ] then "equal" else "different"
        , show (Set.insert (Set.remove (Set.fromList [ 3, 1 ]) 3) 3)
        ]
