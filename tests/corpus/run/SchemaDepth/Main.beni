-- The depth bound (`schema.md` §5, G3): entering a field, an element or a
-- variant's payload is one level, tested before the descent, and a value
-- one level past the bound is a `DepthExceeded` at the child it stopped —
-- never a stack overflow. A `Chain` link is a payload and a field, two
-- levels, so n links need depth 2n: at `maxDepth` 0, 1, 2, the default 512
-- and the ceiling, the longest chain that fits decodes — from text, as a
-- typed value, and printed back — and one link more fails at the place it
-- stopped. The ceiling is the largest `maxDepth` a root accepts, recursion
-- to it fits Node's stack, and one more, or a negative one, is
-- `InvalidOptions`. A `Value` printed nests within the bound as well, and
-- one deeper than `JSON.stringify` can recurse fails as a value.
import Node
import Schema exposing (Schema)
import Show


type Chain
    = End
    | Link { next : Chain }


toNext ( (), next ) = { next = next }


fromNext r = ( (), r.next )


chain : Schema Chain Chain
chain =
    Schema.recursive
        "Chain"
        (λself ->
            let
                link =
                    Schema.injection
                        Link
                        (λc ->
                            case c of
                                Link r ->
                                    Just r

                                End ->
                                    Nothing
                        )

                end =
                    Schema.injection
                        (λ() -> End)
                        (λc ->
                            case c of
                                End ->
                                    Just ()

                                Link _ ->
                                    Nothing
                        )

                next =
                    Schema.record
                        (Schema.fields |> Schema.field "next" self)
                        (Schema.mapping toNext fromNext)
                        (Schema.mapping toNext fromNext)
            in
            Schema.tagged "t"
                [ Schema.nullary "End" "end" end end, Schema.variant "Link" "link" next link link ]
        )


text : Int -> String
text n = String.repeat "{\"t\":\"link\",\"next\":" n ++ "{\"t\":\"end\"}" ++ String.repeat "}" n


typed : Int -> Chain
typed n = build n End


build : Int, Chain -> Chain
build n acc =
    if n <= 0 then
        acc
    else
        build (n - 1) (Link { next = acc })


links : Chain -> Int
links c = count c 0


count : Chain, Int -> Int
count c n =
    case c of
        End ->
            n

        Link r ->
            count r.next (n + 1)


bound : Int -> Schema.Options
bound d = { defaultOptions | maxDepth = d }


-- The path a failure names is n links long: shown by its length.
issues : Result (List Schema.Issue) a -> String
issues r =
    case r of
        Ok _ ->
            "Ok"

        Err found ->
            String.join
                (List.map
                    found
                    (λi ->
                        Show.issue { i | path = [] }
                            ++ " at depth "
                            ++ String.fromInt (List.length i.path)
                    )
                )
                " | "


at : Int, Int -> String
at d n =
    "maxDepth "
        ++ String.fromInt d
        ++ ", "
        ++ String.fromInt n
        ++ " links: "
        ++ Show.result (Schema.parseWith chain (bound d) (text n)) (λc -> String.fromInt (links c))
        ++ " / "
        ++ Show.result
            (Schema.decodeWith chain (bound d) (typed n))
            (λc -> String.fromInt (links c))
        ++ " / "
        ++ Show.result
            (Schema.printWith chain (bound d) (typed n))
            (λs -> String.fromInt (String.length s))


over : Int, Int -> String
over d n =
    "maxDepth "
        ++ String.fromInt d
        ++ ", "
        ++ String.fromInt n
        ++ " links: "
        ++ issues (Schema.parseWith chain (bound d) (text n))
        ++ " / "
        ++ issues (Schema.encodeWith chain (bound d) (typed n))
        ++ " / "
        ++ issues (Schema.printWith chain (bound d) (typed n))


nested : Int -> Schema.Value
nested n =
    case Schema.parse Schema.value (String.repeat "[" n ++ String.repeat "]" n) of
        Ok v ->
            v

        Err _ ->
            nested 0


-- Deeper than `JSON.stringify` can recurse: `JSON.parse` reads it without
-- recursing, and printing it is a `DepthExceeded`, not a stack overflow.
deep : String
deep = String.repeat "[" 20000 ++ String.repeat "]" 20000


main : Node.Program
main =
    Node.printLines
        [ at 0 0
        , over 0 1
        , at 1 0
        , over 1 1
        , at 2 1
        , over 2 2
        , at 512 256
        , over 512 257
        , at Schema.maxDepthCeiling (Schema.maxDepthCeiling // 2)
        , over Schema.maxDepthCeiling (Schema.maxDepthCeiling // 2 + 1)
        , "-- the default is 512"
        , Show.result (Schema.parse chain (text 256)) (λc -> String.fromInt (links c))
        , issues (Schema.parse chain (text 257))
        , "-- options"
        , issues (Schema.parseWith chain (bound (Schema.maxDepthCeiling + 1)) (text 0))
        , issues (Schema.parseWith chain (bound (-1)) (text 0))
        , issues (Schema.decodeWith Schema.int (bound 0) 5)
        , "-- a Value"
        , Show.result (Schema.printWith Schema.value (bound 3) (nested 3)) (λs -> s)
        , Show.result (Schema.printWith Schema.value (bound 3) (nested 4)) (λs -> s)
        , issues (Schema.printWith Schema.value (bound 3) (nested 5))
        , issues (Schema.printWith (Schema.list Schema.value) (bound 3) [ nested 4 ])
        , Show.result (Schema.printWith (Schema.list Schema.value) (bound 3) [ nested 3 ]) (λs -> s)
        , issues
            (Schema.parse Schema.value deep |> Result.andThen (λv -> Schema.print Schema.value v))
        ]


defaultOptions : Schema.Options
defaultOptions = Schema.defaultOptions
