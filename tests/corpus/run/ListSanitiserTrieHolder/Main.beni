-- A platform keeps a view behind the checker's back. The fixture name
-- predates the typed array migration: the view now shares the base array
-- rather than trie storage. A subsequent in-place write poisons that base,
-- so materialising the retained view must trap. The plain build prints nothing.
import Keeper
-- Both the retained view and the changed list keep the element type.
-- The sanitiser observes the base array when the view is materialised.
import List
import Node


main : Node.Program
main =
    long = List.push (List.range 1 40) 41
    _ = Keeper.keep (List.drop long 1)
    written = List.push long 42
    Node.printLines (Keeper.audit written)
