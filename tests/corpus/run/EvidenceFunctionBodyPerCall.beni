-- run (language.md §6 *Evaluation order*, checker-v2.md
-- §12.5): a value with no parameters, a function TYPE and a `where` clause is
-- defined over its type's parameters, and its body — here the `let` that
-- builds `table` — must not run at EACH CALL, where the identical value without
-- the `where` computes it once, at load. The body runs once
-- per evidence: three calls of `lookup` with one instantiation print one
-- `table (where)` line, at the first call, as three calls of `lookupPlain`
-- print one at load. A curried definition here would print JavaScript
-- source text for the sum, and a body run per call would print three
-- `table (where)` lines.
import Node exposing (Program)


lookup : a -> a
    where a.eq : a, a -> Bool
lookup =
    let
        table = Debug.log (List.range 1 3) "table (where)"
    in
    λx ->
        if List.length table == 3 && x == x then
            x
        else
            x


lookupPlain : Int -> Int
lookupPlain =
    let
        table = Debug.log (List.range 1 3) "table (plain)"
    in
    λx ->
        if List.length table == 3 then
            x
        else
            x


main : Program
main =
    Node.printLines
        [ String.fromInt (lookup 1 + lookup 2 + lookup 3)
        , String.fromInt (lookupPlain 1 + lookupPlain 2 + lookupPlain 3)
        ]
