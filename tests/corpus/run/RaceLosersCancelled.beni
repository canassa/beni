-- run: `Task.race` cancels the loser and waits for its cleanup before it
-- answers (transparent-effects-proposal.md §17.7; report 23 row 29, A10).
-- On a virtual clock the fast branch returns at 10 ms; the slow one, due
-- at 50, is cancelled — and since its release waits 5 ms of its own, the
-- answer comes only after that. The loser's release prints before the
-- winner's value, and the loser's line after its sleep never does.
import Clock
import Duration
import Io
import Node exposing (Program)
import Task


main : Program
main = Io.run λ⊤ →
    clock = Clock.virtual 0

    caller = Task.spawn λ⊤ →
        Clock.run clock λ⊤ →
            winner =
                Task.race
                    (λ⊤ →
                        Task.bracket
                            (λ⊤ → ⊤)
                            (λ_ _ →
                                Task.sleep (Duration.millis 5)
                                Debug.log "loser released at ${String.fromInt (Clock.now ⊤)}" ⊤
                            )
                            λ_ →
                                Task.sleep (Duration.millis 50)
                                Debug.log "loser finished" "slow"
                    )
                    λ⊤ →
                        Task.sleep (Duration.millis 10)
                        "fast"
            Debug.log "winner at ${String.fromInt (Clock.now ⊤)}" winner
    Clock.adjust clock (Duration.millis 100)
    _ = Task.join caller
    Node.print "done"
