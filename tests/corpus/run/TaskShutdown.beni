-- run: `Task.shutdown`, called directly (boundary.md §9.8.14 (c)–(f)).
--
--   - It returns at once and runs nothing itself: the fiber that called it
--     goes on to its end, and the teardown starts in a later task.
--   - Every fiber of every root scope is cancelled and its releases run,
--     each once and told `Cancelled`: within a fiber last first, a child's
--     before its parent's, the fibers in the order they were started.
--   - A release that waits goes on waiting, until the deadline (250 ms):
--     one that ends before it finishes; one that does not is cut short
--     there, and the release registered before it in its fiber runs. The
--     one that ends sleeps 1 ms, so only a stall of nearly the whole
--     deadline on a loaded machine could push its timer past it.
--   - Work `soon` queued before the call is dropped unrun, and `soon`
--     queues nothing after it; a fiber started after it is cancelled
--     before its first line; a second call does nothing.
--   - `done` is called once every fiber has ended, with the number of
--     releases the deadline cut short.
--   - A fiber waiting on a `Deferred` nothing completes is cancelled like
--     the rest (transparent-effects-proposal.md §17.4): its wait ends and
--     its release runs.
import Deferred
import Io
import Node exposing (Program)
import Task exposing (Cancelled, Done, Exit)


say : String → ()
say line = Debug.log line ()


outcome : Exit a → String
outcome exit =
    case exit of
        Done _ →
            "Done"

        Cancelled →
            "Cancelled"


guarded : String, (() → a) → a
guarded name body = Task.bracket (λ() → ()) (λ_ exit → say "${name} released: ${outcome exit}") λ_ →
    body ()


main : Program
main = Io.run λ() →
    root = Task.openRoot ()
    _ = Task.spawnIn root λ() → guarded "a outer" λ() → guarded "a inner" λ() → Io.sleep 100000
    _ = Task.spawnIn root λ() → guarded "b" λ() → Io.sleep 100000

    _ = Task.spawnIn root λ() →
        Task.bracket
            (λ() → ())
            (λ_ _ →
                _ = Io.sleep 1
                say "c released after a wait"
            )
            λ_ → Io.sleep 100000

    _ = Task.spawnIn root λ() →
        guarded "d first" λ() →
            Task.bracket
                (λ() → ())
                (λ_ _ →
                    _ = Io.sleep 100000
                    say "d stuck released"
                )
                λ_ → Io.sleep 100000

    _ = Task.spawnIn root λ() →
        guarded "e parent" λ() →
            _ = Task.spawn λ() → guarded "e child" λ() → Io.sleep 100000
            Io.sleep 100000

    unanswered = Deferred.make ()
    _ = Task.spawnIn root λ() → guarded "f, waiting on a Deferred," λ() → Deferred.wait unanswered

    -- Twice: the first lets every fiber start, the second lets the child
    -- `e` started start too.
    _ = Task.yieldNow ()
    _ = Task.yieldNow ()
    _ = Task.soon λ() → say "queued before runs"
    _ = Task.shutdown 250 λcut → say "done, ${String.fromInt cut} cut short"
    _ = Task.shutdown 5 λ_ → say "the second call's done"
    _ = Task.spawnIn root λ() → say "late runs"
    _ = Task.soon λ() → say "queued after runs"
    _ = say "shutdown returned"
    Node.done
