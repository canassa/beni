--! `Js.finally` in a platform module (`backend.md` §4, *`Js.finally` is
--! `try … finally`*): the cleanup runs after the body returns and after it
--! throws, in every position a call can stand in, and the effects happen in
--! the order the call names them. `trail` records them.

import Js


log : Js.Ref String
log = Js.ref ""


--| Record one effect.
pub note : String -> ()
note s = Js.write log "${Js.read log}${s}; "


--| What was recorded since the last `take`, and a fresh record.
pub take : () -> String
take () =
    seen = Js.read log
    _ = Js.write log ""
    seen


--| `f ()`, or what it threw: a test's only way to watch a throw go past.
pub foreign impure attempt : (() -> String) -> String


fail : String -> a
fail m = Js.throw (Js.construct (Js.global "Error") [ Js.from m ])


--| In tail position: the body's value is returned from inside the guard.
pub tail : Int -> Int
tail x =
    Js.finally
        (λ() ->
            _ = note "body"
            x + 1
        )
        (λ() -> note "cleanup")


--| As a value: bound, then used after the cleanup ran.
pub valued : Int -> String
valued x =
    v =
        Js.finally
            (λ() ->
                _ = note "body"
                x * 2
            )
            (λ() -> note "cleanup")

    _ = note "after"
    String.fromInt v


--| Discarded: the body's statements, then the cleanup's.
pub discarded : () -> String
discarded () =
    _ = Js.finally (λ() -> note "body") (λ() -> note "cleanup")
    _ = note "after"
    "done"


--| The body throws in tail position: the cleanup runs, the throw goes on.
pub throwsTail : () -> String
throwsTail () =
    Js.finally
        (λ() ->
            _ = note "body"
            fail "boom"
        )
        (λ() -> note "cleanup")


--| The body throws where its value is bound: nothing after it runs.
pub throwsValued : () -> String
throwsValued () =
    v : String
    v =
        Js.finally
            (λ() ->
                _ = note "body"
                fail "bang"
            )
            (λ() -> note "cleanup")

    _ = note "unreached"
    v


--| The body throws where its value is discarded.
pub throwsDiscarded : () -> String
throwsDiscarded () =
    _ = Js.finally (λ() -> fail "crash") (λ() -> note "cleanup")
    _ = note "unreached"
    "unreached"


--| Nested guards unwind innermost first.
pub nested : () -> String
nested () =
    Js.finally
        (λ() ->
            Js.finally
                (λ() ->
                    _ = note "inner"
                    fail "deep"
                )
                (λ() -> note "inner cleanup")
        )
        (λ() -> note "outer cleanup")


--| A function made by a call that records it.
make : String, Int -> (() -> Int)
make s v =
    _ = note "make ${s}"
    λ() ->
        _ = note s
        v


cleanupOf : String -> (() -> ())
cleanupOf s =
    _ = note "make ${s}"
    λ() -> note s


--| Arguments that are not lambdas are evaluated first, in order, and
--| called in their blocks.
pub ordered : () -> Int
ordered () = Js.finally (make "body" 7) (cleanupOf "cleanup")


--| Functions passed in.
pub passed : (() -> Int), (() -> ()) -> Int
passed f g = Js.finally f g


--| `Js.finally` itself passed as a value: the sibling's function.
pub asValue : (() -> Int), (() -> ()) -> Int
asValue f g = apply Js.finally f g


apply : ((() -> Int), (() -> ()) -> Int), (() -> Int), (() -> ()) -> Int
apply h f g = h f g


--| `f` under a latch, called from one place in another module: a release
--| build writes its body, `try` and all, where that call is.
pub latched : (() -> ()) -> ()
latched f =
    _ = note "lock"
    _ = Js.finally f (λ() -> note "unlock")
    note "unlocked"


--| In tail position of a function that loops: the guard does not take the
--| loop's jump inside it.
pub sumTo : Int, Int -> Int
sumTo n acc =
    if n == 0 then
        Js.finally (λ() -> acc) (λ() -> note "summed")
    else
        sumTo (n - 1) (acc + n)
