-- run: what `ChildProcess.run` asks of Node for a child's standard input,
-- and what it does with the input pipe, where a real child shows nothing
-- or shows it only by a race (boundary.md §9.14 (k), (e)). Each child is
-- the test platform's, in place of `child_process.spawn`'s, and notes what
-- somebody did to its standard input.
--
--   - `NoInput`, which `command` gives: no pipe (`ignore`, which is
--     `/dev/null`);
--   - `Text ""`: a pipe, as for any text, and the platform ends it. The
--     child goes on only when its input pipe is closed, so a platform that
--     writes nothing for an empty text leaves this program with nothing to
--     wake it;
--   - a text: a pipe. Its `error` event with the code `EPIPE`, by Node's
--     route for a write that failed, is a child that stopped reading, and
--     not an error: `run` goes on waiting, and answers with what the child
--     did after that. The write of an empty text fails the same way
--     (measured: Node gives `EPIPE` for it when the child stopped first).
--     The child notes each write that it fails, so each of the two lines
--     shows that the write came: of 0 bytes, and of 4;
--   - a start that failed: nothing writes to the child's standard input,
--     which Node makes all the same;
--   - output over `maxOutput` from a child that never reads: the platform
--     destroys the input pipe with the output pipes, before it signals the
--     child, and the pending write gives no error.
import ChildProcess exposing (Command, Output, RunError)
import Fault
import Io
import Node exposing (Program)


child : Command
child = ChildProcess.command "/bin/sh" [ "-c", "true" ]


describe : String, Result RunError Output → String
describe label result =
    case result of
        Ok output →
            case output.status of
                ChildProcess.Exited code →
                    label
                        ++ ": exited "
                        ++ String.fromInt code
                        ++ ", stdout "
                        ++ quote output.stdout

                ChildProcess.Signalled name →
                    label ++ ": signalled " ++ name

        Err ChildProcess.NotFound →
            label ++ ": not found"

        Err ChildProcess.OutputTooLarge →
            label ++ ": output too large"

        Err _ →
            label ++ ": another error"


quote : String → String
quote text = "\"" ++ String.replace text "\n" "\\n" ++ "\""


-- The line, and what the children noted up to now. The run of the line is
-- over when this is called: an argument is a value before its call.
noted : String → String
noted line = line ++ "; the child noted: " ++ Fault.notes ⊤


main : Program
main = Io.run λ⊤ →
    Fault.failInput "EPIPE"
    none = noted (describe "no input" (ChildProcess.run child))
    empty =
        noted
            (describe "an empty text, EPIPE"
                (ChildProcess.run { child | stdin = ChildProcess.Text "" })
            )
    broken =
        noted
            (describe "a text, EPIPE"
                (ChildProcess.run { child | stdin = ChildProcess.Text "text" })
            )
    Fault.failStart ⊤
    failed =
        noted
            (describe "a start that failed"
                (ChildProcess.run { child | stdin = ChildProcess.Text "text" })
            )
    Fault.neverRead ⊤
    tooLarge =
        noted
            (describe "too large, input not read"
                (ChildProcess.run { child | stdin = ChildProcess.Text "text", maxOutput = 10 })
            )
    Node.printLines [ none, empty, broken, failed, tooLarge ]
