-- run: a walk by `[ x, ...rest ]` over 100 000 elements, the list carried
-- in a record rather than as the walk's own parameter, over each form a
-- list takes (`backend.md` §7, *List patterns over arrays*): a plain list,
-- whose `rest` is a view; a view; a trie built by `push`, whose tail is a
-- trie that copies at most 31 elements once every 32 steps; and a trie
-- built by prepending, whose tail inside its head is a new header. Each
-- step is O(1), so the walk is linear, and it is a tail call, so a loop
-- (`backend.md` §8). A second walk takes two elements a step,
-- `[ a, b, ...rest ]`, so a tail that starts past a head's count too.
--
-- `backend.md` §8's scalar views, which turn a walk of a function's OWN
-- list parameter into an index loop, do not apply here: the list is a
-- record field, which is how most programs carry one.
import List
import Node exposing (Program)
import String


size : Int
size = 100000


type alias Walk =
    items : List Int
    total : Int
    steps : Int


walk : Walk → Walk
walk w =
    case w.items of
        [ x, …rest ] →
            walk { items = rest, total = w.total + x, steps = w.steps + 1 }

        [] →
            w


walkPairs : Walk → Walk
walkPairs w =
    case w.items of
        [ a, b, …rest ] →
            walkPairs { items = rest, total = w.total + a * b, steps = w.steps + 1 }

        _ →
            w


pushed : List Int
pushed = List.foldl (List.range 1 size) [] λn acc → List.push acc n


prepended : List Int
prepended = List.foldr (List.range 1 size) [] λn acc → [ n, …acc ]


viewOf : List Int → List Int
viewOf xs =
    case xs of
        [ _, …rest ] →
            rest

        [] →
            []


show : String, List Int → String
show label xs =
    one = walk { items = xs, total = 0, steps = 0 }

    two = walkPairs { items = xs, total = 0, steps = 0 }
    String.join
        [ label
        , String.fromInt one.steps
        , String.fromInt one.total
        , String.fromInt two.steps
        , String.fromInt two.total
        ]
        " "


main : Program
main =
    Node.printLines
        [ show "plain" (List.range 1 size)
        , show "view" (viewOf (List.range 0 size))
        , show "pushed" pushed
        , show "prepended" prepended
        ]
