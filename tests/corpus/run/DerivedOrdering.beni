-- The derived `compare` of §9, executed
-- (`docs/design/static-dispatch-spike.md` §9.2, §9.3, §9.4, §8.3).
--
-- `emit/DerivedCompare.beni` and `emit/DerivedCompareNominal.beni` pin
-- what these functions LOOK like; this pins that they answer what the
-- language means. Every line here is one that a plausible wrong emission
-- also compiles:
--
--   - declaration order, not alphabetic. `Rank` is `Low | Mid | High`, so
--     `Low < High` is `True` — and `"Low" < "High"` as JavaScript strings
--     is `False`, which is what a `compare` without the `$order` table of
--     §9.4 would print.
--   - the tag test before the payload. `Circle 9 < Rect 1 1` is `True`
--     because `Circle` is declared first, whatever the numbers say.
--   - padding slots are not compared (A.12). `Circle 1` carries a `null`
--     in slot `b` and `Rect 1 1` carries a number there; comparing the
--     slot rather than the position would order them by `null < 1`.
--   - lexicographic, in FIELD-NAME order for a record and slot order for a
--     tuple, with an early return: `{ name = "b", rank = Low }` sorts
--     after `{ name = "a", rank = High }` because `name` comes before
--     `rank` by text.
--   - `String` is `String.compare` and `Char` is a code-point comparison,
--     never `<` on the JavaScript values (§3.2, A.26). The astral pair is
--     the case that tells them apart.
--   - one evidence parameter per type parameter, in declaration order
--     (A.20): `Outcome x a = Ok a | Err x` hands `Ok`'s payload `$m$1`.
--   - a recursive type calls itself.
--   - a position nothing inhabits. `Ok 1` never fixes `x`, so the `x`
--     slot of `Outcome`'s evidence is an `err` target — and the value
--     handed there still has to be a function of two arguments returning
--     an `Order`, not `Basics.eq`'s `Bool`.
--
-- The last block runs the same comparison through a `where`-constrained
-- generic, so the derived function is in VALUE position (§8.2) and reaches
-- its operands as `$m$0` rather than inline.
import Node exposing (Program)
import String


pub type Rank
    = Low
    | Mid
    | High


pub type Shape
    = Circle Int
    | Rect Int Int


pub type Outcome x a
    = Ok a
    | Err x


pub type Tree
    = Leaf
    | Node Tree Tree


type alias Row =
    { name : String, rank : Rank }


show : Bool -> String
show b =
    if b then
        "True"

    else
        "False"


order : a, a -> String
    where a.compare : a, a -> Order
order x y =
    case x.compare y of
        LT ->
            "LT"

        EQ ->
            "EQ"

        GT ->
            "GT"


main : Program
main =
    Node.printLines
        [ show (Low < High)
        , show (High < Low)
        , show (Mid <= Mid)
        , show (Circle 9 < Rect 1 1)
        , show (Circle 1 < Circle 2)
        , show (Rect 1 2 < Rect 1 3)
        , show (Rect 1 3 < Rect 1 2)
        , order (Circle 1) (Rect 1 1)
        , order (Ok 1) (Ok 2)
        , order (Ok 2) (Err 9)
        , order (Err 1) (Err 2)
        , order (Node Leaf Leaf) Leaf
        , order (Node Leaf (Node Leaf Leaf)) (Node Leaf Leaf)
        , order { name = "a", rank = High } { name = "b", rank = Low }
        , order { name = "b", rank = Low } { name = "b", rank = High }
        , order ( 'a', "z" ) ( 'a', "y" )
        , order '\u{10000}' '\u{E000}'
        , order "\u{10000}" "\u{E000}"
        ]
