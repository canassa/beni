-- An untouched field keeps its identity (language.md §11.12, backend.md
-- §15.8), observed through a test platform's `refEq`: after `select`, the
-- model's `rows` and `title` are the very values they were — not copies —
-- while `selected` is a new value, and a record update of a record update
-- keeps the fields neither touched. It is what makes a markup lowering's
-- reference check per hole and per row input correct, and the release
-- build, whose optimiser could break it, runs this too.
import Identity
import Node


type alias Model =
    rows : List { id : Int }
    selected : Int
    title : String


select : Model, Int -> Model
select model id = { model | selected = id }


rename : Model, String -> Model
rename model title = { model | title = title }


show : Bool -> String
show b =
    if b then
        "same"
    else
        "different"


main : Node.Program
main =
    model = { rows = [ { id = 1 }, { id = 2 } ], selected = 0, title = "t" }

    next = select model 3

    later = rename (select next 4) "u"
    Node.printLines
        [ show (Identity.refEq model.rows next.rows)
        , show (Identity.refEq model.title next.title)
        , show (Identity.refEq model next)
        , show (Identity.refEq model.rows later.rows)
        , show (Identity.refEq model.title later.title)
        ]
