-- A parameter's cell written in place (a push of a loan) before an early
-- return (`?`), and renewed after it: on the way of the early return the
-- cell still holds the written contents, which the caller reads after the
-- call. So the frame reads them at that return, and the push is refused
-- (`ownership-v3-kernel.md` §13, item 7). Before, the renewal named the old
-- contents as the written parameter's new name, and the push ran in place.
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


grow : Ref (List Int), Int → Result String Int
grow r n =
    cur = Ref.get r
    ys = List.push cur n
    _ = (if n == 2 then Err "x" else Ok 1)?
    Ref.set r [ 7 ]
    Ok (List.length ys)


main : Program
main =
    r = Ref.make [ 0 ]
    _ = grow r 2
    Node.print (ints (Ref.get r))
