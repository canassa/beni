-- Research report 150 §11's residual: `fm : Maybe a → b` reads `v : a` at `b`, handed to
-- `apply` as a function value and read as `List Int × Int`. A value of one type
-- variable read at another was no cast; it is now, by the types
-- (ownership-v3-kernel.md §3.4).
import Node exposing (Program)
import Pun


apply : (a → b), a → b
apply f q = f q


go : Int → String
go n =
    x0 = [ n ]
    h : List Int × Int
    h = apply Pun.fm (Just ( x0, x0 ))
    ( _, hq ) = h
    z : List Int
    z = Pun.conv hq
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
