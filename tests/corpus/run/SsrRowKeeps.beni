-- A `For` row keeps its item in a `Ref`: the runtime calls the row with
-- each item of `each`, so the row is applied to them as at a call site and
-- the item escapes (ownership-v3-kernel.md §6.12). The write after the
-- render is refused under --ownership=v3; in place, the `Ref` would read
-- the pushed row.
import Html exposing (Html)
import List
import Node exposing (Program)
import Ref exposing (Ref)
import Ssr


keep : Ref (List Int), List Int → Html msg
keep seen r =
    Ref.set seen r
    <li>{List.length r}</li>


main : Program
main =
    rows = [ List.copy [ 1 ], List.copy [ 2 ] ]
    seen = Ref.make []
    list = <ul><For each={rows} keyed={False}>{λr → keep seen r}</For></ul>
    page = Ssr.render list
    edited = List.update rows 1 λr → List.push r 9
    Node.printLines
        [ page, String.fromInt (List.length (Ref.get seen)), String.fromInt (List.length edited) ]
