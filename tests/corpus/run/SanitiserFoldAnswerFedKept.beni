-- A fold whose callback edits an element of its accumulator in place and
-- also puts a part of its answer in a cell it captures (`ownership-v2.md`
-- §2.11.3, *a label's answer handed back to it*, at the caller): the next
-- run edits that part in place, and the cell sees the edit. The run's
-- answer is apart from every older object only while the known code keeps
-- nothing, so v2 refuses each fold, the callback written as a lambda and
-- as a named helper. Accepted, the build prints another cell.
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


shows : List (List Int) → String
shows ls = String.join (List.map ls show) ";"


first : List (List Int) → List Int
first acc = Maybe.withDefault (List.get acc 0) []


-- The cell keeps the answer's first element; the next run pushes onto it.
lambda : ⊤ → List String
lambda ⊤ =
    r = Ref.make [ [ 0 ], [ 5 ] ]
    out = List.foldl [ 1, 2, 3 ] [ [ 0 ], [ 5 ] ] λx acc →
        a = List.update acc 0 λl → List.push l x
        Ref.update r λold → [ [ List.length (Maybe.withDefault (List.get old 1) []) ], first a ]
        a
    [ shows out, shows (Ref.get r) ]


step : Ref (List (List Int)), Int, List (List Int) → List (List Int)
step r x acc =
    a = List.update acc 0 λl → List.push l x
    Ref.update r λold → [ [ List.length (Maybe.withDefault (List.get old 1) []) ], first a ]
    a


helper : ⊤ → List String
helper ⊤ =
    r = Ref.make [ [ 0 ], [ 5 ] ]
    out = List.foldl [ 1, 2, 3 ] [ [ 0 ], [ 5 ] ] λx acc → step r x acc
    [ shows out, shows (Ref.get r) ]


main : Program
main = Node.printLines [ …lambda ⊤, …helper ⊤ ]
