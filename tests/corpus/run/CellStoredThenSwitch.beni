-- A helper stores a value into its parameter's cell, reaches a call where
-- another fiber could run (a `Ref` operation, `Task.yieldNow`), and then
-- it or its caller writes the stored value in place (#2592). The caller's
-- cell has no other holder, so no other fiber can take the stored value
-- while the helper is parked: each write is accepted and runs in place
-- (ownership-v3-kernel.md §13 item 12, amended). Before, what the helper
-- stored escaped at every such call, for its caller too.
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


stepOk : Int → Result String ⊤
stepOk k = if k > 0 then Ok ⊤ else Err "x"


storeRead : Ref (List Int) → ⊤
storeRead r =
    Ref.set r [ 9 ]
    _ = List.length (Ref.get r)
    ⊤


storeUpdate : Ref (List Int) → ⊤
storeUpdate r =
    Ref.set r [ 9 ]
    Ref.update r λl → List.push l 1


storePark : Ref (List Int) → ⊤
storePark r =
    Ref.set r [ 4 ]
    Task.yieldNow ⊤
    Ref.update r λl → List.push l 5


viaHelper : Ref (List Int) → ⊤
viaHelper r = storePark r


issue : ⊤ → String
issue ⊤ =
    r = Ref.make [ 1 ]
    storeRead r
    Ref.update r λl → List.push l 3
    ints (Ref.get r)


updated : ⊤ → String
updated ⊤ =
    r = Ref.make [ 1 ]
    storeUpdate r
    Ref.update r λl → List.push l 2
    ints (Ref.get r)


parked : ⊤ → String
parked ⊤ =
    r = Ref.make [ 1 ]
    storePark r
    viaHelper r
    Ref.update r λl → List.push l 6
    ints (Ref.get r)


recur : ⊤ → String
recur ⊤ =
    r = Ref.make [ 1 ]
    loop : Int → Result String ⊤
    loop n =
        if n <= 0 then
            Ok ⊤
        else
            stepOk n?
            Ref.set r [ n ]
            loop (n - 1)
    _ = loop 3
    Ref.update r λl → List.push l 7
    ints (Ref.get r)


scoped : ⊤ → String
scoped ⊤ =
    r = Ref.make [ 1 ]
    Task.scope λ_ →
        Ref.set r [ 3 ]
        Task.yieldNow ⊤
        Ref.update r λl → List.push l 4
    ints (Ref.get r)


main : Program
main = Io.run λ⊤ → Node.printLines [ issue ⊤, updated ⊤, parked ⊤, recur ⊤, scoped ⊤ ]
