-- A run whose error nothing reads is a validator (`schema.md` §6, *A run whose
-- failure is never read is a validator*), and in a program with fewer than
-- `SchemaValid.shape_threshold` such runs it keeps its compiled worker (*How a
-- program chooses between shapes and workers*). Every input below is read
-- twice, by such a run and by one that reads its error, and each line prints
-- both answers; the corpus also builds this through the library. Its inputs
-- are derived types and another module's schema: custom types in each of their forms, tuples of the wrong length, a `Maybe` field absent and `null`, `Char`, `Int32`, `⊤`, and JSON text with a duplicate key and a `__proto__` key. `run/SchemaErrorUnreadShapes` reads them all through
-- shapes, against the same answers.
import Hosts
import Int32 exposing (Int32)
import Json
import Node
import Parts
import Schema exposing (Value)


schema Placed =
    label : String
    at : Parts.Point


type Color
    = Red
    | Gray Int
    | Rgb Int Int Int


type alias Item =
    pos : Int × Int
    color : Color
    label : Maybe String
    tags : List (Maybe Char)
    small : Int32
    unit : ⊤


placedValid : Value → String
placedValid v =
    case Schema.read (Placed.schema ⊤) v of
        Ok p →
            "${p.label} at ${String.fromInt p.at.x}, ${String.fromInt p.at.y}"

        Err _ →
            "invalid"


placedRead : Value → String
placedRead v =
    case Schema.read (Placed.schema ⊤) v of
        Ok p →
            "${p.label} at ${String.fromInt p.at.x}, ${String.fromInt p.at.y}"

        Err issues →
            "invalid (${String.fromInt (List.length issues)})"


placed : String, Value → String
placed label v = "${label}: ${placedValid v} | ${placedRead v}"


none : Item
none =
    { pos = ( 0, 0 ), color = Red, label = Nothing, tags = [], small = Int32.fromInt 0, unit = ⊤ }


itemText : Item → String
itemText it = Debug.toString it


itemValid : Value → String
itemValid v =
    found : Item
    found = Result.withDefault (Json.decodeValue v) none
    if found == none then "invalid" else itemText found


itemRead : Value → String
itemRead v =
    case Json.decodeValue v of
        Ok it →
            itemText it

        Err issues →
            "invalid (${String.fromInt (List.length issues)})"


itemDecode : String → String
itemDecode text =
    case Json.decode text of
        Ok it →
            itemText it

        Err _ →
            "invalid"


itemDecodeRead : String → String
itemDecodeRead text =
    case Json.decode text of
        Ok it →
            itemText it

        Err issues →
            "invalid (${String.fromInt (List.length issues)})"


itemFlaky : String, Value → String
itemFlaky label v =
    keys = [ "pos", "color", "label", "tags", "small", "unit" ]
    "${label}: ${itemValid (Hosts.flaky v keys)} | ${itemRead (Hosts.flaky v keys)}"


item : String, Value → String
item label v = "${label}: ${itemValid v} | ${itemRead v}"


itemJson : String, String → String
itemJson label text = "${label}: ${itemDecode text} | ${itemDecodeRead text}"


goodItem : Value
goodItem =
    Hosts.parse
        "{\"pos\":[1,2],\"color\":{\"Rgb\":[1,2,3]},\"label\":\"l\",\"tags\":[\"x\",null,\"y\"],\"small\":7,\"unit\":[]}"


main : Node.Program
main =
    Node.printLines
        [ placed "placed" (Hosts.parse "{\"label\":\"p\",\"at\":{\"x\":1,\"y\":2}}")
        , placed "placed y 1.5" (Hosts.parse "{\"label\":\"p\",\"at\":{\"x\":1,\"y\":1.5}}")
        , itemFlaky "flaky item" goodItem
        , item "item" goodItem
        , item "gray" (Hosts.with goodItem "color" (Hosts.parse "{\"Gray\":5}"))
        , item "red" (Hosts.with goodItem "color" (Hosts.parse "\"Red\""))
        , item "red with arguments" (Hosts.with goodItem "color" (Hosts.parse "{\"Red\":[]}"))
        , item "gray without" (Hosts.with goodItem "color" (Hosts.parse "\"Gray\""))
        , item "rgb two" (Hosts.with goodItem "color" (Hosts.parse "{\"Rgb\":[1,2]}"))
        , item "two keys" (Hosts.with goodItem "color" (Hosts.parse "{\"Red\":1,\"Gray\":2}"))
        , item "constructor key" (Hosts.with goodItem "color" (Hosts.parse "\"constructor\""))
        , item "label missing" (Hosts.with goodItem "label" (Hosts.undefined ⊤))
        , item "label null" (Hosts.with goodItem "label" (Hosts.parse "null"))
        , item "pos three" (Hosts.with goodItem "pos" (Hosts.parse "[1,2,3]"))
        , item "pos 1.5" (Hosts.with goodItem "pos" (Hosts.parse "[1.5,2]"))
        , item "tag two characters" (Hosts.with goodItem "tags" (Hosts.parse "[\"xy\"]"))
        , item "small 2^31" (Hosts.with goodItem "small" (Hosts.parse "2147483648"))
        , item "unit one" (Hosts.with goodItem "unit" (Hosts.parse "[1]"))
        , itemJson "decode" "{\"pos\":[3,4],\"color\":\"Red\",\"tags\":[],\"small\":-1,\"unit\":[]}"
        , itemJson
            "decode bad"
            "{\"pos\":[3,4],\"color\":\"Blue\",\"tags\":[],\"small\":-1,\"unit\":[]}"
        , itemJson "decode not JSON" "nope"
        , itemJson
            "decode label absent"
            "{\"pos\":[3,4],\"color\":\"Red\",\"tags\":[],\"small\":-1,\"unit\":[]}"
        , itemJson
            "decode label null"
            "{\"pos\":[3,4],\"color\":\"Red\",\"label\":null,\"tags\":[],\"small\":-1,\"unit\":[]}"
        , itemJson
            "decode duplicate key and __proto__"
            "{\"pos\":[3,4],\"color\":\"Red\",\"small\":-1,\"small\":2,\"tags\":[],\"unit\":[],\"__proto__\":{\"label\":\"x\"}}"
        , itemJson
            "decode duplicate key, last bad"
            "{\"pos\":[3,4],\"color\":\"Red\",\"small\":2,\"small\":1.5,\"tags\":[],\"unit\":[]}"
        ]
