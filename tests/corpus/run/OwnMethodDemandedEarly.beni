-- An own untyped method used inside a `let` or a `case` above its
-- definition checks: the use is deferred to the using group's boundary and
-- the method's group is checked when it is first demanded (the owner's
-- decision, checker-v2.md §10.2). Three shapes, each using
-- a method written further down: `pair` (`size` through
-- a `let` helper used at two types), `pairAnnotated` (the same
-- helper with `g : a -> Int`) and `boxes` (`makeBox` in a
-- `case` scrutinee, then `map2` in a `let` helper used at two types).
-- Expected `1 1`, `1 1`, `4 3`.
--
-- Oracle twin: this file with `size`, `makeBox` and `map2`
-- moved above `pair` prints exactly
-- the expected three lines. As written, no use may be refused with
-- METHOD NEEDS AN ANNOTATION.
import Node exposing (Program)


type K
    = K Int


type Box a
    = Box a


pair u =
    g x = (Box x).size ()
    ( g 1, g "s" )


pairAnnotated u =
    g : a -> Int
    g y = (Box y).size ()
    ( g 1, g "s" )


boxes u =
    case (K u).makeBox () of
        o ->
            g h = o.map2 h
            ( g λx -> x + 1, g String.fromInt )


pub size (Box _) u = 1


pub makeBox (K n) u = Box n


pub map2 (Box v) fn = Box (fn v)


unbox (Box v) = v


both : ( Int, Int ) -> String
both ( a, b ) = String.fromInt a ++ " " ++ String.fromInt b


main : Program
main =
    ( n, s ) = boxes 3
    Node.printLines
        [ both (pair 0), both (pairAnnotated 0), String.fromInt (unbox n) ++ " " ++ unbox s ]
