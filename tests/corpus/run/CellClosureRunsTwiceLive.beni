-- A callee can run a closure more than once within one call
-- (`ownership-v3-kernel.md` §13 item 11): a closure that writes the contents
-- of a cell it captured and then stores a value there writes that value in
-- place on its next run. So the write is of what the renewal names too, and
-- each program here, whose frame reads the stored value after the call, is
-- refused: a captured list stored by `Ref.set`, another captured cell's
-- contents, a captured list answered by the update's function, by
-- `List.map` and by `List.foldl`, and a list a spawned fiber
-- reads after it parks. Were the write accepted, the stored list would read
-- the second push in place.
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


twice : (⊤ → ⊤) → ⊤
twice f =
    f ⊤
    f ⊤


stored : ⊤ → String
stored ⊤ =
    ys = [ 4 ]
    r = Ref.make [ 1 ]
    twice λ⊤ →
        Ref.update r λxs → List.push xs 2
        Ref.set r ys
    ints ys


otherCell : ⊤ → String
otherCell ⊤ =
    r = Ref.make [ 1 ]
    s = Ref.make [ 0 ]
    twice λ⊤ →
        Ref.update r λxs → List.push xs 2
        Ref.set r (Ref.get s)
    ints (Ref.get s)


answered : ⊤ → String
answered ⊤ =
    ys = [ 4 ]
    r = Ref.make [ 1, 1 ]
    twice λ⊤ → Ref.update r λxs → if List.length xs == 2 then ys else List.push xs 2
    ints ys


mapped : ⊤ → String
mapped ⊤ =
    ys = [ 4 ]
    r = Ref.make [ 1 ]
    _ = List.map [ 1, 2 ] λ_ →
        Ref.update r λxs → List.push xs 2
        Ref.set r ys
    ints ys


folded : ⊤ → String
folded ⊤ =
    ys = [ 4 ]
    r = Ref.make [ 1 ]
    n = List.foldl [ 1, 2 ] 0 λ_ k →
        Ref.update r λxs → List.push xs 2
        Ref.set r ys
        k + 1
    "${String.fromInt n} ${ints ys}"


fiber : ⊤ → String
fiber ⊤ =
    r = Ref.make [ 1 ]
    ys = [ 4 ]
    f = Task.spawn λ⊤ →
        Io.sleep 5
        ints ys
    twice λ⊤ →
        Ref.update r λxs → List.push xs 5
        Ref.set r ys
    Task.join f


main : Program
main = Io.run λ⊤ →
    Node.printLines [ stored ⊤, otherCell ⊤, answered ⊤, mapped ⊤, folded ⊤, fiber ⊤ ]
