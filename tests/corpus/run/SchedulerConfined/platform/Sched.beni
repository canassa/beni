--! A test platform's scheduler: its `run` passes a throw out of the drain to
--! a promise whose rejection handler names the one error this fixture
--! throws and throws every other again (`CLAUDE.md` rule 9), so a defect
--! under the scheduler does not end the Node process and the fixture can
--! show what runs after it.

import Js
import Task exposing (Scheduler)


--| A scheduler named `name`, whose drains run in a promise reaction of
--| their own, with `hook` for a defect under it.
pub make : String, sync (⊤ → ⊤) → Scheduler
make name hook =
    Task.schedulerWith
        (λdrain → later name (Js.from drain))
        (λdrain → later name (Js.from drain))
        hook


-- Run `drain` in a reaction of a resolved promise. A throw out of it
-- rejects the reaction's promise; the handler names the fixture's one
-- error and throws the rest again.
foreign impure later : String, Js.Value → ⊤
