-- Functions stored, passed and returned. A function-typed value in flight
-- is an ordinary closure of known arity (`backend.md` §6), so every one of
-- these is a direct call of the arity written at the call site.
--
-- `pick` RETURNS a function, which is a 1-ary function whose result is
-- 1-ary — not a 2-ary function. Calling it therefore takes two
-- applications, `(pick True) 5`, because `pick True 5` would be one call of
-- two arguments (`language.md` §6.7).
--
-- `16 |> bump` is the same closure reached through a pipe: `|>` puts the
-- left operand FIRST, so it is `bump 16`. The right operand has to be a
-- name or an application, which is why the lambdas here are applied
-- directly instead.
import List
import Node exposing (Program)
import String


compose : (b -> c), (a -> b), a -> c
compose g f x = g (f x)


twice : (a -> a), a -> a
twice f x = f (f x)


pick : Bool -> (Int -> Int)
pick big =
    if big then
        λn -> n * 100
    else
        λn -> n + 1


main : Program
main =
    let
        bump = pick False
    in
    Node.printLines
        [ String.fromInt (compose (λn -> n + 1) (λn -> n * 2) 5)
        , String.fromInt (twice (λn -> n * 3) 2)
        , String.fromInt ((pick True) 5)
        , String.fromInt ((pick False) 5)
        , String.join (List.map (List.map [ 1, 2 ] (pick True)) String.fromInt) ","
        , String.fromInt ((identity (λn -> n - 1)) 10)
        , String.fromInt (16 |> bump)
        , String.fromInt ((λn -> n + 1) ((λn -> n * 2) 5))
        ]
