-- run: fibers side by side (docs/design/transparent-effects-proposal.md
-- §16.4, §16.5). Three children sleep different lengths; each logs when it
-- wakes, so the log is the order of the timers, not the order of the
-- spawns. `join` hands each child's value back whatever order they ended
-- in, and joining a child that has already ended answers at once. The
-- values are joined in spawn order, so the result line does not depend on
-- the timers at all.
import Debug
import Io
import Node exposing (Program)
import Task


worker : String, Int -> Int
worker name ms =
    _ = Io.sleep ms
    _ = Debug.log "woke" name
    ms * 2


main : Program
main = Io.run λ() ->
    a = Task.spawn λ() -> worker "a" 30
    b = Task.spawn λ() -> worker "b" 10
    c = Task.spawn λ() -> worker "c" 20
    total = Task.join a + Task.join b + Task.join c
    again = Task.join b
    Node.print (String.fromInt total ++ " " ++ String.fromInt again)
