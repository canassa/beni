-- run: a waiter on a scheduler that stops does not lose the permit that
-- another scheduler hands it after the stop's deadline (#1051;
-- transparent-effects-proposal.md §17.9 point 7, amended 2026-11-05, which
-- `Semaphore`'s hand-off shares). A waiter that the stop cannot interrupt
-- keeps its scheduler from stopping for good, so the hand-off is resumed
-- through that scheduler's own queue, and the waiter runs with the permit
-- and gives it back; then the stop ends, and the waiter behind it gets the
-- permit. A waiter in a release that the deadline cuts runs its canceller,
-- so it leaves the line and the permit goes to the next waiter. `t` is the
-- waiter on the scheduler `s` that stops, `u` a waiter on the program's
-- scheduler, and the permit is released from a third scheduler. Each
-- stop's deadline is 1 ms or 10 s, and the main fiber sleeps 20 ms after
-- the stop: a timer fires only once every microtask has run, so the order
-- does not depend on the machine.
import Duration
import Io
import Node exposing (Program)
import Semaphore exposing (Semaphore)
import Task exposing (Cancelled, Done, Exit, Scheduler)


outcome : Exit a → String
outcome exit =
    case exit of
        Done _ →
            "Done"

        Cancelled →
            "Cancelled"


report : String, Int → ⊤
report name cut =
    _ = Debug.log "${name}: stop done, cut" cut
    ⊤


holding : Semaphore, String, String → ⊤
holding sem name who = Semaphore.withPermit sem λ⊤ → Debug.log "${name}: ${who} has the permit" ⊤


-- The wait is in an `uninterruptible` region.
masked : Semaphore, String → ⊤
masked sem name = Task.uninterruptible λ⊤ → holding sem name "t"


-- The wait is in a release that runs when the use returns, before the
-- stop: a release cannot be interrupted.
returned : Semaphore, String → ⊤
returned sem name = Task.bracket (λ⊤ → ⊤) (λ_ _ → holding sem name "t") λ_ → ⊤


-- The wait is in a release that the stop's cancellation runs.
released : Semaphore, String → ⊤
released sem name =
    Task.bracket
        (λ⊤ → ⊤)
        (λ_ _ →
            Debug.log "${name}: t release waits" ⊤
            holding sem name "t"
        )
        λ_ → Task.never ⊤


-- The main fiber holds the one permit. `u` joins the line after `t` has
-- joined it, and after the deadline.
scenario : Scheduler, String, Int, (Semaphore, String → ⊤) → ⊤
scenario other name deadline body =
    s = Task.scheduler λ⊤ → ⊤
    sem = Semaphore.make 1
    Semaphore.acquire sem 1

    t = Task.withScheduler s λ⊤ →
        f = Task.spawn λ⊤ → body sem name
        Task.yieldNow ⊤
        f
    Task.stopScheduler s deadline (report name _)
    Task.sleep (Duration.millis 20)
    u = Task.spawn λ⊤ → holding sem name "u"
    Task.yieldNow ⊤
    _ = Debug.log "${name}: s busy" (Task.schedulerBusy s)
    Task.withScheduler other λ⊤ → Semaphore.release sem 1
    _ = Debug.log "${name}: t" (outcome (Task.wait t))
    _ = Debug.log "${name}: u" (outcome (Task.wait u))
    _ = Debug.log "${name}: available" (Semaphore.available sem)
    ⊤


main : Program
main = Io.run λ⊤ →
    other = Task.scheduler λ⊤ → ⊤
    scenario other "masked" 1 masked
    scenario other "returned" 1 returned
    scenario other "cut" 1 released
    scenario other "long" 10000 released
    Node.done
