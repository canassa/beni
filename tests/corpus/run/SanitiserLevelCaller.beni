-- A cycle a type variable closes at the caller folds out of a result's arrival (`ownership-v2.md` §2.1, #2223):
-- `hg`'s own type has no fold below `m`, a type variable's slot, but at `G R` a walk below it returns to
-- `G R` and folds above it. The caller says the arrival there, whole, and `k`, still live, is refused.
import List
import Maybe
import Node exposing (Program)
import String


type G a
    = GL a
    | GP (G a) Int


type R
    = RL (List Int)
    | RW (G R)


wrG : G R → Int
wrG t =
    case t of
        GL r →
            wrR r
        GP u _ →
            wrG u


wrR : R → Int
wrR t =
    case t of
        RL xs →
            List.length (List.push xs 1)
        RW u →
            wrG u


wrM : Maybe (G R) → Int
wrM t =
    case t of
        Just u →
            wrG u
        Nothing →
            0


hg : G a → Maybe (G a)
hg t =
    case t of
        GP (GL m) _ →
            Just (GP (GL m) 0)
        _ →
            Nothing


main : Program
main =
    k = [ 1 ]
    v = GP (GL (RW (GL (RL k)))) 0
    a = wrM (hg v)
    Node.print (String.fromInt (a + List.length k))
