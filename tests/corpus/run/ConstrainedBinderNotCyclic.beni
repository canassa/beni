-- A regression guard: a variable whose only self-reference is through
-- its own requirement — `x.eq : x, x -> Bool` — is not a cycle, and
-- `Basics.eq` under an `==` on the same variables is not "a function
-- inside" (checker-v2.md §8.2 walks `structural` successors only).
--
--
import Node exposing (Program)


f x y = x == y


g x y =
    if x == y then
        Basics.eq x y
    else
        False


show : Bool -> String
show value =
    if value then
        "True"
    else
        "False"


main : Program
main = Node.printLines [ show (f 1 1), show (g "a" "a"), show (g 1 2) ]
