-- See Box.beni.
import Box
import Node exposing (Program)
import O1
import Row75


show : Bool → String
show b =
    if b then
        "True"
    else
        "False"


main : Program
main =
    Node.printLines
        [ show (Box.Box "a" 11 == Box.Box "b" 15)
        , show (Box.Box "a" 11 < Box.Box "a" 25)
        , show (Box.Box "a" 11 == Box.Box "a" 15)
        , show (O1.use 1 11)
        , show (O1.use 3 13)
        , if Row75.compare (Row75.U 1) (Row75.U 2) == LT then
            "custom eq used"
          else
            "custom eq ignored"
        ]
