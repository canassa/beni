-- run: a use of a module's own unannotated method is
-- deferred to the using group's boundary, so it checks whatever the source
-- order (the owner's decision, checker-v2.md §10). No annotation is ever
-- required on a method for ordering reasons, and `method_needs_annotation`
-- is retired. Three shapes, one module each, every one using `eq` ABOVE its
-- unannotated definition: `Box` (`compare` compares `Box`es
-- with `==` directly, through a tuple and through a record), `O1` (a
-- private `eq`) and `Row75` (`U`'s `compare` needs `T`'s
-- `eq`). Expected `False`, `True`, `True`, `True`, `True`, `custom eq used`.
--
-- Oracle twin: this project with each `eq` moved above its
-- first use prints
-- exactly the expected six lines. As written, no module may be refused
-- with METHOD NEEDS AN ANNOTATION.
--
-- `Box`'s payload is a `String` rather than a type variable: an unannotated `pub`
-- method with a `where` is the `ambiguous_method_receiver` warning, and a
-- `run/` fixture must build silently.
pub type Box
    = Box String Int


pub compare x y =
    let
        same =
            x == y

        viaTuple =
            ( x, 0 ) == ( y, 0 )

        viaRecord =
            { v = x } == { v = y }
    in
    if same && viaTuple && viaRecord then
        EQ

    else
        case x of
            Box _ m ->
                case y of
                    Box _ n ->
                        Basics.compare m n


pub eq x y =
    case x of
        Box a m ->
            case y of
                Box b n ->
                    a == b && m // 10 == n // 10
