-- See Box.beni.
pub type T
    = T Int


pub type U
    = U Int


pub compare a b =
    s = T 1 == T 2
    case ( a, b ) of
        ( U x, U y ) →
            if s then
                LT
            else
                EQ


pub eq a b =
    case ( a, b ) of
        ( T _, T _ ) →
            True
