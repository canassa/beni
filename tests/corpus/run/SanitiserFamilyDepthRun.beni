-- What a whole read at a family's payload owes a record's row (`ownership-v2.md` §2.1, *The
-- exit rule*): `F`'s only context is a function, so its payload has no step, and a value read
-- through the row stays deep there: a constructor at the slot holds its list below itself. Refused.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


type F a
    = FL a
    | FW (F (⊤ → a))


type Rc a
    = RL a
    | RW (Rc { v : a, n : Int })


rRec : Rc a, a → a
rRec r d =
    case r of
        RL x →
            x

        RW u →
            (rRec u { v = d, n = 0 }).v


updQ : { r | q : List Int } → { r | q : List Int }
updQ r = { r | q = [ 4 ] }


low : F a, a → a
low v d =
    case v of
        FL x →
            x

        _ →
            d


rowField : List Int → List Int
rowField k =
    v = { p = FL (RL k), q = [ 3 ] }
    w = low (updQ v).p (RL [ 7 ])
    List.push (rRec w [ 7 ]) 9


main : Program
main =
    k = [ 1 ]
    Node.print (show (rowField k) ++ "|" ++ show k)
