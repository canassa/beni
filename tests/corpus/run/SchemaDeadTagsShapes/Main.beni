fillers : Value → String
fillers v =
    "fillers ${String.fromInt (filler1 v + filler2 v + filler3 v + filler4 v + filler5 v + filler6 v + filler7 v + filler8 v + filler9 v + filler10 v + filler11 v + filler12 v + filler13 v + filler14 v + filler15 v + filler16 v + filler17 v + filler18 v + filler19 v + filler20 v + filler21 v + filler22 v + filler23 v + filler24 v + filler25 v + filler26 v + 0)}"
