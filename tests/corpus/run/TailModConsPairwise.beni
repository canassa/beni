-- run: `pairwise`, the shape that puts the element it matched back on the
-- front of the rest before recursing,
-- `[ ( a, b ), ...pairwise [ b, ...rest ] ]` (`docs/design/backend.md` §8,
-- *Tail calls modulo cons*, *A cons step in the bracket spelling*). The
-- argument of the self-call is itself a list with a spread, an ordinary
-- expression there and not a second step of the loop; only the spread of the
-- self-call, last in its list, builds into the result. It overflowed the
-- stack at 100 000 elements.
import List
import Node exposing (Program)
import String


pairwise : List a -> List ( a, a )
pairwise xs =
    case xs of
        [ a, b, ...rest ] ->
            [ ( a, b ), ...pairwise [ b, ...rest ] ]

        _ ->
            []


main : Program
main =
    let
        small = pairwise [ 1, 2, 3, 4 ]

        big = pairwise (List.range 1 100000)
    in
    Node.printLines
        [ String.join
            (List.map small (\( a, b ) -> String.fromInt a ++ "-" ++ String.fromInt b))
            ","
        , String.fromInt (List.length (pairwise [ 1 ]))
        , String.fromInt (List.length big)
        , String.fromInt (List.foldl big 0 (\( a, b ) acc -> acc + b - a))
        ]
