-- The recursive twin of `check/bad/DeferredReceiverGeneralised`
-- (a regression guard):
-- `f` calls `g` back, so `f` and `g` are one binding group, `g`'s record
-- reaches `f`'s `x` before `f`'s constraint is generalised, and `x.combine
-- n` is the field call (static-dispatch-spike.md §11 *Deferred receiver*,
-- amended 2026-09-26). This pair pins the rule's non-local edge: a caller in
-- the same recursive group decides what `x.m a` means, as HM's monomorphic
-- recursion lets a caller decide a parameter's type.
-- `g 1` is `f 1 { combine = \z -> z + 1 }`, which is `2`. Expected `2`.
--
-- Miscompiled, it would pass `f` a `compare` evidence it does
-- not take, and the program would print `EQ`.
import Node exposing (Program)


f n x =
    if n > 5 then
        g n
    else
        x.combine n


g n =
    if n > 5 then
        n
    else
        f n { combine = λz -> z + 1 }


main : Program
main = Node.printLines [ String.fromInt (g 1) ]
