-- run: a promise-backed primitive (docs/design/transparent-effects-proposal.md
-- §16.5). `Io.readFile` starts a `fs.promises.readFile`, parks the fiber,
-- and is resumed once with a `Result` when the promise settles — here with
-- `Err Io.NotFound`, for a file that does not exist. A second fiber
-- ticks while the first waits, so the wait is a real one: other fibers run.
import Debug
import Io
import Node exposing (Program)
import Task


main : Program
main =
    Io.run
        (\() ->
            let
                reader = Task.spawn (\() -> Io.readFile "this file does not exist.txt")
                _ = Task.spawn (\() -> Debug.log () "another fiber ran")
                answer =
                    case Task.join reader of
                        Ok text ->
                            "read " ++ String.fromInt (String.length text)

                        Err Io.NotFound ->
                            "could not read: not found"

                        Err _ ->
                            "could not read, for another reason"
            in
            Node.print answer
        )
