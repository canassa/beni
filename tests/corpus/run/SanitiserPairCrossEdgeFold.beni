-- A cross edge is no head (`ownership-v2.md` §2.9.2, *The fixed point of the pairs*,
-- #2146). The fields are `H → [ A, C, q ]`, `A → [ H, B ]`, `B → [ A ]`, `C → [ B ]`.
-- `A` closes before `C` reads `B`, and a depth test took `C` for a head: it solved
-- `C` with `no`, so `push` wrote `q` under `w`. Rows are numbered, not depthed.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


main : Program
main =
    q = [ 1 ]
    kh = λu v → if List.length u > 5 then u else if List.length v > 5 then v else q
    ka = λu v → if List.length u > 0 then u else v
    kb = λv → v
    kc = λv → v
    r = List.foldl [ 1, 2, 3, 4, 5, 6, 7, 8 ] ( [], [], [], [] ) λi acc →
        ( kh acc.1 acc.3, ka acc.2 acc.0, kb acc.1, kc acc.2 )
    w = ( r.3, r.0 )
    z = List.push q 2
    Node.print (show z ++ "|" ++ show w.0)
