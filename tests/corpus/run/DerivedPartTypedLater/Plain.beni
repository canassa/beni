-- The same shape without a function: compared structurally, `v` would
-- print `not lt`, because the second fields differ.
pub type T
    = T Int Int


pub eq left right =
    case left of
        T n _ →
            case right of
                T m _ →
                    n == m


pub compare left right =
    same = { v = left } == { v = right }
    case left of
        T n _ →
            case right of
                T m _ →
                    if same then
                        LT
                    else
                        GT
