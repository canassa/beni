-- `T` holds a function, so `==` on it exists only through `eq` below. The
-- record comparison in `compare` is written while `left` is still an
-- unsolved variable: the record's part for `v` must become `eq`, not a
-- structural comparison that ignores it (and not `err`).
pub type T
    = T Int (Int -> Int)


pub eq left right =
    case left of
        T n _ ->
            case right of
                T m _ ->
                    n == m


pub compare left right =
    let
        same =
            { v = left } == { v = right }
    in
    case left of
        T n _ ->
            case right of
                T m _ ->
                    if same then
                        LT
                    else
                        GT
