--! A test platform: worded rows with beni bodies that reach no JavaScript, whose words claim less than their bodies do.

import Dict exposing (Dict)
import Help
import Js
import Mk
import Ref exposing (Ref)


--| `shallow`, and the body reads the list at key 1.
pub peekBody : borrowed shallow Dict Int (List Int) → Int
peekBody d = List.length (Maybe.withDefault (Dict.get d 1) [])


--| `fresh`, and the body answers its parameter.
pub same : borrowed List Int → fresh List Int
same l = l


--| `fresh`, and the function the body answers holds its parameter.
pub later : borrowed List Int → fresh (⊤ → Int)
later l = λ⊤ → List.length l


--| `many`, and the body keeps the function in a cell.
pub keepFn : many (⊤ → Int) → Ref (⊤ → Int)
keepFn f = Ref.make f


--| `shallow`, and the body reads the list at a key that a derived
--| comparison of two tuples chooses: a comparison of values that hold no
--| cell reaches no JavaScript.
pub peekCompare : borrowed shallow Dict Int (List Int) → Int
peekCompare d =
    k = if ( 1, 2 ) == ( 2, 1 ) then 2 else 1
    List.length (Maybe.withDefault (Dict.get d k) [])


--| `shallow`, and a walk that gives up: a loop over a tuple of twenty lists
--| whose walk does not settle. No word of it can be checked.
pub peekRotate : borrowed shallow Dict Int (List Int) → Int
peekRotate d =
    xs = Maybe.withDefault (Dict.get d 1) []
    loop :
          Int
        , List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
        → List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
              × List Int
    loop n ( b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19 ) =
        if n == 0 then
            ( b0
            , b1
            , b2
            , b3
            , b4
            , b5
            , b6
            , b7
            , b8
            , b9
            , b10
            , b11
            , b12
            , b13
            , b14
            , b15
            , b16
            , b17
            , b18
            , b19
            )
        else
            loop
                (n - 1)
                ( b19
                , b0
                , b1
                , b2
                , b3
                , b4
                , b5
                , b6
                , b7
                , b8
                , b9
                , b10
                , b11
                , b12
                , b13
                , b14
                , b15
                , b16
                , b17
                , b18
                )
    ( a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19 ) =
        loop 0 ( xs, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [] )
    List.length a0


--| `exclusive`, and the body answers one new list at two places.
pub freshTwice : ⊤ → fresh exclusive List (List Int)
freshTwice ⊤ =
    t = [ 1 ]
    [ t, t ]


--| `shallow`, and the body reads the list at key 1 beside a call of
--| `round`, a body over JavaScript that is handed a `Float` and answers an
--| `Int`: it sees no cell of `d`, so the body is checked.
pub peekRound : borrowed shallow Dict Int (List Int) → Int
peekRound d = if round 1.5 == 2 then List.length (Maybe.withDefault (Dict.get d 1) []) else 0


--| `fresh`, and the body answers its parameter beside a call of `round`.
pub sameRound : borrowed List Int → fresh List Int
sameRound l = if round 1.5 == 2 then l else []


--| `shallow` beside text that JavaScript makes from numbers.
pub peekText : borrowed shallow Dict Int (List Int) → Int
peekText d =
    s = String.fromInt (7 // 2) ++ Debug.toString (toFloat 1)
    if String.length s > 0 then List.length (Maybe.withDefault (Dict.get d 1) []) else 0


--| `shallow` beside an identity compare of two new lists, in a helper of
--| no words: what JavaScript is handed holds no cell of `d`.
pub peekSame : borrowed shallow Dict Int (List Int) → Int
peekSame d =
    if newSame ⊤ && Js.same [ 1 ] [ 1 ] then
        0
    else
        List.length (Maybe.withDefault (Dict.get d 1) [])


newSame : ⊤ → Bool
newSame ⊤ = Js.same [ 2 ] [ 2 ]


--| `fresh`, an alias of a function that answers its parameter.
pub aliasSame : borrowed List Int → fresh List Int
aliasSame = keep


keep : List Int → List Int
keep l = l


--| `shallow`, an alias of a function of another module that reads the
--| list at key 1.
pub aliasPeek : borrowed shallow Dict Int (List Int) → Int
aliasPeek = Help.inner


--| `fresh`, an alias of a function that answers a record holding its parameter.
pub aliasWrap : borrowed List Int → fresh { items : List Int }
aliasWrap = wrap


wrap : List Int → { items : List Int }
wrap l = { items = l }


--| An alias of a function at a type variable: its contract is at other
--| types than the words', so no word of it can be checked.
pub aliasAny : borrowed List Int → fresh List Int
aliasAny = anyCopy


anyCopy : a → a
anyCopy x = x


--| `exclusive`, and the body answers one new value at two places: at a
--| type variable, the value of a row of the platform, which can be a cell.
pub dupeMade : ⊤ → fresh exclusive List a
dupeMade ⊤ =
    x = Mk.make ⊤
    [ x, x ]


--| `once`, and the body hands the function a new value it answers too.
pub giveMade : once (a → ⊤) → fresh a
giveMade g =
    x = Mk.make ⊤
    g x
    x


--| `fresh`, and the function value an `if` answers is `keep`: a body of no
--| parameter that is no name, no lambda and no partial has no walk at the
--| words' types.
pub ifSame : borrowed List Int → fresh List Int
ifSame = if True then keep else keep


--| `fresh`, and the function value a field holds is `keep`.
pub fieldSame : borrowed List Int → fresh List Int
fieldSame = table.f


table : { f : List Int → List Int }
table = { f = keep }
