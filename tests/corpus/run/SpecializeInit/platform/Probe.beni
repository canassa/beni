--! Definite initialisation (`backend.md` §9, *Slice 4*, amended
--! 2026-10-03) where it fires and beside what must defeat it: each answer
--! is the same in both builds.

import Js


type alias V =
    Js.Value


kind : V
kind = Js.from { m = λ_ -> Js.from { s = Js.from "node" } }


block : V
block = Js.from { t = kind }


-- Every instance `m` makes gets `t` and `b` before anything reads them.
unit : V -> V
unit b =
    let
        i = Js.call (Js.get b "t") "m" [ Js.from 0 ]

        _ = Js.set i "t" (Js.get b "t")

        _ = Js.set i "b" b
    in
    i


patch : V, V -> String
patch i b =
    if Js.same b (Js.get i "b") then
        "same"
    else
        "other"


-- One call writes `b`, the other does not: a read may be `undefined`.
bare : () -> V
bare () = Js.from { s = Js.from "node" }


marked : () -> V
marked () =
    let
        i = bare ()

        _ = Js.set i "b" block
    in
    i


shown : V -> String
shown i =
    if Js.isUndefined (Js.get i "b") then
        "nothing shown"
    else
        "a block shown"


-- The value written reads the key it is written to, through a call, before
-- the write: the read sees it missing. The instance comes from a kind's
-- method, as `unit`'s does, and `describe` is called twice, so that neither
-- is written where it is called.
other : V
other = Js.from { m = λ_ -> Js.from { s = Js.from "node" } }


describe : V -> String
describe i =
    if Js.isUndefined (Js.get i "c") then
        "unset"
    else
        "set"


described : () -> V
described () =
    let
        i = Js.call other "m" [ Js.from 0 ]

        _ = Js.set i "c" (Js.from (describe i))
    in
    i


pub demo : () -> List String
demo () =
    [ patch (unit block) block
    , shown (marked ())
    , shown (bare ())
    , Js.to (Js.get (described ()) "c")
    , describe (Js.from { c = "given" })
    ]
