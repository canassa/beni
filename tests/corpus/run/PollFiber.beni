-- run: `Task.poll` (transparent-effects-proposal.md §17.3) says how a fiber
-- ended without waiting: `Nothing` while it runs — and while it is
-- cancelled but still running its cleanup — `Just (Done v)` once it
-- returned, `Just Cancelled` once its cancellation has finished.
import Io
import Node exposing (Program)
import Task


main : Program
main = Io.run λ⊤ →
    quick = Task.spawn λ⊤ →
        Task.yieldNow ⊤
        42
    _ = Debug.log "quick, started" (Task.poll quick)
    Task.yieldNow ⊤
    Task.yieldNow ⊤
    _ = Debug.log "quick, returned" (Task.poll quick)

    slow = Task.spawn λ⊤ →
        Task.bracket
            (λ⊤ → ⊤)
            (λ_ _ →
                Task.yieldNow ⊤
                Debug.log "slow released" ⊤
            )
            λ_ → Task.never ⊤
    Task.yieldNow ⊤
    watcher = Task.spawn λ⊤ → Debug.log "slow, cleaning up" (Task.poll slow)
    Task.cancel slow
    _ = Task.join watcher
    _ = Debug.log "slow, cancelled" (Task.poll slow)
    Node.print "done"
