-- Walked platform code, no row: `box x = Js.to (Js.array [ Js.from x ])`, a `Js.Value`
-- made of parts and read at a type variable. The caller reads it at the
-- argument's own type, `List Int`; the argument is at an `Int` element. A
-- `Js.Value` read at a type variable was no cast (kernel §3.4: `core/` reads its
-- arrays back so); one the frame made of parts holds them below its place, and
-- they escape there now (ownership-v3-kernel.md §3.4, *What a value was made from*).
import Node exposing (Program)
import Pun


go : Int → String
go n =
    x0 = [ n ]
    h : List Int
    h = Pun.box x0
    z : List Int
    z = Pun.conv (Maybe.withDefault (List.head h) 0)
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
