-- `_` (§6.7) and `let x <- f a` (§6.7) composing, run. Three claims neither
-- feature makes alone:
--   `insideRest` puts a `_` in the rest of the block, after the `<-`, so the
--   lifted lambda is built inside the callback the bind passed along and
--   still closes over the name the bind introduced.
--   `nestedInCallee` puts a `_` inside an argument of the bind's own call:
--   the placeholder belongs to that inner application, and the bind's call
--   still receives the rest of the block as its last argument.
--   `pipedIntoHole` reaches a placeholder call through `|>`, which §8
--   rewrites first, so the piped operand becomes the call's FIRST argument
--   and the `_` is lifted only afterwards, over the rewritten call: the
--   hole lands in the slot AFTER the operand, not the one it was written
--   in. `n |> subtract _` is `subtract n _`, so the result is `n - 100`
--   and not `100 - n`. `subtract` is not commutative, so both facts are
--   visible in the output.
import List
import Node exposing (Program)
import String


subtract : Int, Int -> Int
subtract a b = a - b


twice : Int, (Int -> String) -> String
twice n body = body n ++ "/" ++ body (n + 1)


usingAll : List (Int -> Int), (List Int -> String) -> String
usingAll fs body = body (List.map fs λf -> f 7)


insideRest : String
insideRest =
    n <- twice 10
    String.join (List.map (List.map [ 1, 2 ] (subtract n _)) String.fromInt) ","


nestedInCallee : String
nestedInCallee =
    applied <- usingAll [ subtract 100 _, subtract _ 100 ]
    String.join (List.map applied String.fromInt) ","


pipedIntoHole : String
pipedIntoHole =
    n <- twice 1
    String.fromInt ((n |> subtract _) 100)


main : Program
main =
    Node.printLines
        [ insideRest
        , nestedInCallee
        , pipedIntoHole
        ]
