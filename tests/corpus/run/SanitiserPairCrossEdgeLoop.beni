-- A cross edge is no head (`ownership-v2.md` §2.9.2, *The fixed point of the pairs*,
-- #2146). The fields are `H → [ A, C, q ]`, `A → [ H, B ]`, `B → [ A ]`, `C → [ B ]`.
-- `A` closes before `C` reads `B`, and a depth test took `C` for a head: it solved
-- `C` with `no`, so `push` wrote `q` under `w`. Rows are numbered, not depthed.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


loop :
      (List Int, List Int → List Int)
    , (List Int, List Int → List Int)
    , (List Int → List Int)
    , (List Int → List Int)
    , List Int
    , List Int
    , List Int
    , List Int
    , Int
    → List Int × List Int × List Int × List Int
loop kh ka kb kc h a b c n =
    if n == 0 then
        ( h, a, b, c )
    else
        loop kh ka kb kc (kh a c) (ka b h) (kb a) (kc b) (n - 1)


main : Program
main =
    q = [ 1 ]
    r =
        loop
            (λu v → if List.length u > 5 then u else if List.length v > 5 then v else q)
            (λu v → if List.length u > 0 then u else v)
            (λv → v)
            (λv → v)
            []
            []
            []
            []
            8
    w = ( r.3, r.0 )
    z = List.push q 2
    Node.print (show z ++ "|" ++ show w.0)
