-- run: `closeRoot` runs a scheduler's deferred finalisers in a fiber of that
-- scheduler (transparent-effects-proposal.md §17.5, amended 2026-10-22):
-- the root scope belongs to the scheduler of its first fiber, so a stop
-- afterwards cuts a deferred finaliser that still waits, and counts it.
import Deferred exposing (Deferred)
import Duration
import Io
import Node exposing (Program)
import Task


say : String → ⊤
say line = Debug.log line ⊤


finish : Deferred Int, Int → ⊤
finish done cut =
    _ = Deferred.complete done cut
    ⊤


main : Program
main = Io.run λ⊤ →
    s = Task.scheduler λ⊤ → ⊤
    done = Deferred.make ⊤
    root = Task.openRoot ⊤

    Task.withScheduler s λ⊤ →
        _ = Task.spawnIn root λ⊤ → ⊤

        Task.defer root λ_ →
            say "deferred start"
            Task.sleep (Duration.millis 20)
            say "deferred end"
        Task.yieldNow ⊤
    Task.closeRoot root
    -- The deferred finaliser runs under the scheduler: queued on it, so
    -- this fiber, lent to it, goes on after it has started.
    Task.withScheduler s λ⊤ → Task.yieldNow ⊤
    Task.stopScheduler s 1 (finish done _)
    _ = Debug.log "cut" (Deferred.wait done)
    Node.done
