-- `core/Int32.beni`'s bit operations, including the three places a reader
-- can be caught out.
--
--   - **A shift count is taken modulo 32**, because JavaScript's shift
--     operators read only its low five bits. So a count of 32 is a shift of
--     0, a count of 33 is a shift of 1, and a count of -1 is a shift of 31.
--     The same masking is what makes `rotateLeft n 0` and `rotateLeft n 32`
--     the identity rather than a special case in the beni definition.
--   - **`shiftRight` is arithmetic and `shiftRightZero` is logical.** On a
--     negative number they disagree in the only way that matters: one keeps
--     the sign and the other fills with zeros, and `shiftRightZero (-16) 4`
--     is 268435455 where `shiftRight (-16) 4` is -1.
--   - **`shiftRightZero` stays an `Int32`.** JavaScript's `>>>` produces an
--     UNSIGNED number, so without the `| 0` in `core/Int32.js` a zero shift
--     would turn -1 into 4294967295 — a value the type does not hold. The
--     two `toUnsignedInt` lines show both readings of the same bits.
--
-- `rotateLeft` and `rotateRight` are written in beni over the shifts and
-- are what a hash or a PRNG mixes with; 0x12345678 rotated by 8 is
-- 0x34567812 one way and 0x78123456 the other, which is a rotation you can
-- read by eye. Every value below was computed independently in node.
import Int32 exposing (Int32)
import Node exposing (Program)
import String


show : Int32 -> String
show n = String.fromInt (Int32.toInt n)


unsigned : Int32 -> String
unsigned n = String.fromInt (Int32.toUnsignedInt n)


main : Program
main =
    Node.printLines
        [ show (Int32.shiftLeft Int32.one 0)
        , show (Int32.shiftLeft Int32.one 4)
        , show (Int32.shiftLeft Int32.one 31)
        , show (Int32.shiftLeft Int32.one 32)
        , show (Int32.shiftLeft Int32.one 33)
        , show (Int32.shiftLeft Int32.one (-1))
        , show (Int32.shiftRight (Int32.fromInt 16) 4)
        , show (Int32.shiftRight (Int32.fromInt (-16)) 4)
        , show (Int32.shiftRight (Int32.fromInt (-1)) 31)
        , show (Int32.shiftRight Int32.minValue 31)
        , show (Int32.shiftRight Int32.minValue 1)
        , show (Int32.shiftRightZero (Int32.fromInt 16) 4)
        , show (Int32.shiftRightZero (Int32.fromInt (-16)) 4)
        , show (Int32.shiftRightZero (Int32.fromInt (-1)) 31)
        , show (Int32.shiftRightZero Int32.minValue 1)
        , show (Int32.shiftRightZero (Int32.fromInt (-1)) 0)
        , unsigned (Int32.shiftRightZero (Int32.fromInt (-16)) 4)
        , unsigned (Int32.shiftRight (Int32.fromInt (-16)) 4)
        , show (Int32.rotateLeft Int32.one 1)
        , show (Int32.rotateLeft Int32.minValue 1)
        , show (Int32.rotateLeft (Int32.fromInt 0x12345678) 8)
        , show (Int32.rotateLeft (Int32.fromInt 12345) 0)
        , show (Int32.rotateLeft (Int32.fromInt 12345) 32)
        , show (Int32.rotateLeft (Int32.fromInt 0x9e3779b9) 13)
        , show (Int32.rotateRight (Int32.fromInt 2) 1)
        , show (Int32.rotateRight Int32.one 1)
        , show (Int32.rotateRight (Int32.fromInt 0x12345678) 8)
        , show (Int32.rotateRight (Int32.fromInt 12345) 0)
        , show (Int32.rotateRight (Int32.fromInt 0x9e3779b9) 13)
        , show (Int32.complement Int32.zero)
        , show (Int32.complement (Int32.fromInt 0x0f0f0f0f))
        , show (Int32.complement Int32.minValue)
        , show (Int32.complement Int32.maxValue)
        , show (Int32.and (Int32.fromInt 0xff00ff00) (Int32.fromInt 0x0f0f0f0f))
        , unsigned (Int32.or (Int32.fromInt 0xff00ff00) (Int32.fromInt 0x0f0f0f0f))
        , unsigned (Int32.xor (Int32.fromInt 0xff00ff00) (Int32.fromInt 0x0f0f0f0f))
        , show (Int32.and (Int32.fromInt 0xdeadbeef) (Int32.fromInt 0xff))
        , show (Int32.shiftRightZero (Int32.fromInt 0xdeadbeef) 24)
        ]
