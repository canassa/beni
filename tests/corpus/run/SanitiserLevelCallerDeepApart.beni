-- The twin of `SanitiserLevelCallerDeep`: the list below the caller's fold is not `k`, so the edit in place is accepted.
import List
import Maybe
import Node exposing (Program)
import String


type G a
    = GL a
    | GP (G a) Int


type B r
    = B r


type R
    = RL (List Int)
    | RW (G (B R))


wrG : G (B R) → Int
wrG t =
    case t of
        GL (B r) →
            wrR r
        GP u _ →
            wrG u


wrR : R → Int
wrR t =
    case t of
        RL xs →
            List.length (List.push xs 1)
        RW u →
            wrG u


wrM : Maybe (G (B R)) → Int
wrM t =
    case t of
        Just u →
            wrG u
        Nothing →
            0


hg : G a → Maybe (G a)
hg t =
    case t of
        GP (GL m) _ →
            Just (GP (GL m) 0)
        _ →
            Nothing


main : Program
main =
    k = [ 1 ]
    j = [ 2 ]
    v = GP (GL (B (RW (GL (B (RL j)))))) 0
    a = wrM (hg v)
    Node.print (String.fromInt (a + List.length k))
