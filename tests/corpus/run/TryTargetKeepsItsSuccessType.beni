-- run: a `?` whose subject is an outer variable and whose target is a `let`
-- definition's result: the target keeps its own success type polymorphic,
-- so `g` is used at two result types (checker-v2.md §4.5,
-- §21.1: the subject and the value go down to the
-- target's rank, never the target to the subject's). The `?` is defaulted to
-- `Result` at `g`'s boundary. Lowering the whole target to `u`'s rank
-- would refuse the program.
import Node exposing (Program)


f u =
    g k = k (u?)
    ( g λv → Ok v, g λv → Ok (String.fromInt v) )


main : Program
main = Node.printLines [ Debug.toString (f (Ok 1)), Debug.toString (f (Err "no")) ]
