-- CK-190: a `let` chain of 65 single-use aliases, each binding the
-- one before it. Under `--release` backend.md §9 item 1 inlines every
-- link; at 31dd4bd the printer stopped following the substitutions after
-- 64 steps and printed a name whose binding had been dropped, which the
-- renamer then spelled as an unrelated top-level's short name: past 128
-- links the release build printed `7` (the value of `k`), a function's
-- source, or threw a ReferenceError. Expected: both builds print `42`
-- then `7`. Oracle twin: the development build, which inlines nothing.
import Node exposing (Program)
import String


k : Int
k =
    7


v : Int -> Int
v x0 =
    let
        x1 =
            x0

        x2 =
            x1

        x3 =
            x2

        x4 =
            x3

        x5 =
            x4

        x6 =
            x5

        x7 =
            x6

        x8 =
            x7

        x9 =
            x8

        x10 =
            x9

        x11 =
            x10

        x12 =
            x11

        x13 =
            x12

        x14 =
            x13

        x15 =
            x14

        x16 =
            x15

        x17 =
            x16

        x18 =
            x17

        x19 =
            x18

        x20 =
            x19

        x21 =
            x20

        x22 =
            x21

        x23 =
            x22

        x24 =
            x23

        x25 =
            x24

        x26 =
            x25

        x27 =
            x26

        x28 =
            x27

        x29 =
            x28

        x30 =
            x29

        x31 =
            x30

        x32 =
            x31

        x33 =
            x32

        x34 =
            x33

        x35 =
            x34

        x36 =
            x35

        x37 =
            x36

        x38 =
            x37

        x39 =
            x38

        x40 =
            x39

        x41 =
            x40

        x42 =
            x41

        x43 =
            x42

        x44 =
            x43

        x45 =
            x44

        x46 =
            x45

        x47 =
            x46

        x48 =
            x47

        x49 =
            x48

        x50 =
            x49

        x51 =
            x50

        x52 =
            x51

        x53 =
            x52

        x54 =
            x53

        x55 =
            x54

        x56 =
            x55

        x57 =
            x56

        x58 =
            x57

        x59 =
            x58

        x60 =
            x59

        x61 =
            x60

        x62 =
            x61

        x63 =
