-- `read` sees the keys ordinary JavaScript access sees (`schema.md` §5,
-- *Host values*, amended 2026-10-17, the owner): a field inherited from a
-- prototype, or a class's getter, is read; a key present with the value
-- `undefined` is absent, so an optional field is `Missing` (decoding
-- defaults, §11, are not built) and a required field is refused; a field
-- named like a key `Object.prototype` has is never taken from the
-- prototype; and a key a page set on `Object.prototype` is read through it
-- by compiled workers (the last line pollutes it). Both output modes
-- must match this independent golden.
import Hosts
import Node
import Schema exposing (Missing, Present, Value)


schema Point =
    x : Int
    y : Int optional


schema Named =
    toString : String


point : String, Value → String
point label v =
    case Schema.read (Point.schema ⊤) v of
        Ok p →
            label ++ ": " ++ String.fromInt p.x ++ ", " ++ shown p.y

        Err issues →
            label ++ ": " ++ String.fromInt (List.length issues) ++ " issue"


shown : Schema.Presence Int → String
shown y =
    case y of
        Present n →
            String.fromInt n

        Missing →
            "missing"


named : String, Value → String
named label v =
    case Schema.read (Named.schema ⊤) v of
        Ok n →
            label ++ ": " ++ n.toString

        Err issues →
            label ++ ": " ++ String.fromInt (List.length issues) ++ " issue"


main : Node.Program
main =
    Node.printLines
        [ point "inherited y" (Hosts.inherited ⊤)
        , point "getters" (Hosts.getters ⊤)
        , point "undefined y" (Hosts.undefinedY ⊤)
        , point "undefined x" (Hosts.undefinedX ⊤)
        , named "inherited toString" (Hosts.plain ⊤)
        , named "own toString" (Hosts.ownToString ⊤)
        , runtimePoint (Hosts.getters ⊤)
        , runtimeTag (Hosts.getters ⊤)
        , compiledPayload
            "compiled payload"
            "{\"kind\":\"own\",\"value\":7,\"nested\":{\"count\":3}}"
        , compiledPayload
            "compiled nested extra"
            "{\"kind\":\"own\",\"value\":7,\"nested\":{\"count\":3,\"kind\":\"own\"}}"
        , point "polluted prototype" (Hosts.polluted ⊤)
        ]


toPoint ( ( ⊤, x ), y ) = { x = x, y = y }


fromPoint p = ( ( ⊤, p.x ), p.y )


runtimePoint : Value → String
runtimePoint input =
    schema =
        Schema.record
            (Schema.fields ▷ Schema.field "x" Schema.int ▷ Schema.optional "y" Schema.int)
            (Schema.mapping toPoint fromPoint)
            (Schema.mapping toPoint fromPoint)
    case Schema.read schema input of
        Ok p →
            "runtime getters: " ++ String.fromInt p.x ++ ", " ++ shown p.y
        Err _ →
            "runtime getters: failed"


type Tag
    = Own


runtimeTag : Value → String
runtimeTag input =
    inject = Schema.injection (λ⊤ → Own) λ_ → Just ⊤
    schema = Schema.tagged "kind" [ Schema.nullary "Own" "own" inject inject ]
    case Schema.read schema input of
        Ok Own →
            "runtime tag getter: own"
        Err _ →
            "runtime tag getter: failed"


schema CompiledPayload =
    value : Int
    nested :
        count : Int


type CompiledTag
    = CompiledTag CompiledPayload.Type


compiledTag : Schema.Schema CompiledTag CompiledTag
compiledTag =
    inject = Schema.injection CompiledTag λ(CompiledTag p) → Just p
    Schema.tagged "kind"
        [ Schema.variant "CompiledTag" "own" (CompiledPayload.schema ⊤) inject inject ]


compiledPayload : String, String → String
compiledPayload label text =
    opts = { (Schema.defaultOptions ⊤) | unknownKeys = Schema.Reject }
    case Schema.parseWith compiledTag opts text of
        Ok (CompiledTag p) →
            label ++ ": " ++ String.fromInt p.value ++ "/" ++ String.fromInt p.nested.count
        Err [ issue ] →
            case issue.path of
                [ Schema.Field "nested", Schema.Field "kind" ] →
                    label ++ ": /nested/kind"
                _ →
                    label ++ ": wrong path"
        Err _ →
            label ++ ": failed"
