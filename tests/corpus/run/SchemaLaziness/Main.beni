-- What the library engine runs, and when (`schema.md` §5, *Traversal and
-- failure rules*), seen through `Debug.log`, the corpus's one instrument
-- for evaluation order — kept apart from `SchemaFailures` and
-- `SchemaDescribe` so that those two build as release programs do, with
-- nothing reaching `Debug`. Under `FirstError` traversal is lazy: a
-- sibling after the first failure is never started, while `AllErrors`
-- starts every one; a whole-record conversion waits for all its fields and
-- runs only when they all succeeded; and describing a schema runs none of
-- its conversions, though decoding with it runs each once.
import Node
import Schema exposing (AllErrors, Conversion, Reject, Schema)
import Show


logged : String → Conversion String String
logged name =
    Schema.conversion
        (λs →
            _ = Debug.log name s
            if s == "bad" then
                Err [ Schema.issue (name ++ " is bad") ]
            else
                Ok s
        )
        λs → Ok s


type alias Three =
    x : String
    y : String
    z : String


toThree ( ( ( ⊤, x ), y ), z ) = { x = x, y = y, z = z }


fromThree t = ( ( ( ⊤, t.x ), t.y ), t.z )


three : Schema Three Three
three =
    Schema.record
        (Schema.fields
            ▷ Schema.field "x" (Schema.converted Schema.string (logged "x"))
            ▷ Schema.field "y" (Schema.converted Schema.string (logged "y"))
            ▷ Schema.field "z" (Schema.converted Schema.string (logged "z"))
        )
        (Schema.mapping toThree fromThree)
        (Schema.mapping toThree fromThree)


joined : Schema Three String
joined =
    Schema.converted
        three
        (Schema.conversion
            (λt →
                _ = Debug.log "whole record" t.x
                Ok (t.x ++ t.y ++ t.z)
            )
            λs → Ok { x = s, y = "", z = "" }
        )


loud : Schema String String
loud = Schema.converted Schema.string (logged "a conversion ran")


all : Schema.Options
all = { errors = AllErrors, unknownKeys = Reject, maxDepth = 512, reportInput = False }


first : Schema.Options
first = { errors = Schema.FirstError, unknownKeys = Reject, maxDepth = 512, reportInput = False }


issues : Result (List Schema.Issue) a → String
issues r = Show.result r λ_ → ""


described : Schema e a → String
described s =
    case (Schema.describe s).root of
        Schema.Converted _ →
            "a conversion, described"

        _ →
            "something else"


main : Node.Program
main =
    Node.printLines
        [ issues (Schema.parseWith three first "{\"x\":\"1\",\"y\":\"bad\",\"z\":\"3\"}")
        , issues (Schema.parseWith three all "{\"x\":\"1\",\"y\":\"bad\",\"z\":\"3\"}")
        , issues (Schema.parseWith joined all "{\"x\":\"1\",\"y\":\"bad\",\"z\":\"3\"}")
        , Show.result (Schema.parseWith joined all "{\"x\":\"1\",\"y\":\"2\",\"z\":\"3\"}") λs → s
        , described loud
        , Show.result (Schema.decode loud "once") λs → s
        ]
