-- run (language.md §6 *Evaluation order*): a constrained value with no
-- parameters and a non-function type — a thunk, `($m…) => value` — computes
-- its value once per EVIDENCE, not at every read. `blank` is read three times
-- at `Int`, once at `Colour` and once more at `Int`: its `Debug.log` fires at
-- the first `Int` read, at the `Colour` one, and again at the second `Int`
-- read, because the value kept is the last evidence's (`Lower.memoArrow`):
-- `Int`'s `eq` is the module's `===` helper, `Colour`'s its derived function.
-- It never fires at all five reads.
import Node exposing (Program)


type Colour
    = Red
    | Green Int


blank : List a
    where a.eq : a, a -> Bool
blank = Debug.log "blank" []


sizeInts : List Int -> Int
sizeInts xs = List.length xs


sizeColours : List Colour -> Int
sizeColours xs = List.length xs


main : Program
main =
    Node.printLines
        [ String.fromInt (sizeInts blank + sizeInts blank + sizeInts blank)
        , String.fromInt (sizeColours blank)
        , String.fromInt (sizeInts blank)
        ]
