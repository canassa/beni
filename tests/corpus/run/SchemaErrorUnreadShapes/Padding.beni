--! Nineteen more runs whose error nothing reads, so that the program holds at
--! least `SchemaValid.shape_threshold` shape runs and every one of them takes
--! its shape (`schema.md` §6, *How a program chooses between shapes and
--! workers*).

import Schema exposing (Value)


schema Alpha =
    alpha : Int


alphaValid : Value → Bool
alphaValid v =
    case Schema.read (Alpha.schema ⊤) v of
        Ok _ →
            True

        Err _ →
            False


schema Bravo =
    bravo : Int


bravoValid : Value → Bool
bravoValid v =
    case Schema.read (Bravo.schema ⊤) v of
        Ok _ →
            True

        Err _ →
