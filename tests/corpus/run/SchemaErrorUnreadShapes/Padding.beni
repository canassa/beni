--| How many of the nineteen read `v`.
pub count : Value → Int
count v =
    List.length
        (List.filter
            [ alphaValid v
            , bravoValid v
            , charlieValid v
            , deltaValid v
            , echoValid v
            , foxtrotValid v
            , golfValid v
            , hotelValid v
            , indiaValid v
            , julietValid v
            , kiloValid v
            , limaValid v
            , mikeValid v
            , novemberValid v
            , oscarValid v
            , papaValid v
            , quebecValid v
            , romeoValid v
            , sierraValid v
            ]
            λb → b
        )
