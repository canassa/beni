-- SplitTraversalJoin (Appendix B, S4; R-4.6.2, R-5.4.2): two traversals of two
-- different entries, `xs` and its reverse, are joined and their elements
-- written. The lists are the same objects, so the write is refused.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


build : List (List Int) → List (List Int)
build xs =
    a = List.map xs λl → l
    b = List.map (List.reverse xs) λl → l
    List.map (a ++ b) λl → List.push l 1


main : Program
main = Node.print (show (build [ [ 1 ], [ 2 ] ]))
