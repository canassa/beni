-- The empty needle, pinned for every `String` function that takes one.
--
-- `indexes s ""` is `[]` — Elm's `_String_indexes` returns `Nil` whenever
-- `sub.length < 1`, and `run/StringCodePoints.beni` already pins that. But
-- `contains` must not be WRITTEN over `indexes` (`case indexes str sub of
-- [] -> …`): it would inherit that rule and answer `False` for an empty needle. Every
-- ordinary definition of "contains" says the opposite: the empty string is a
-- substring of every string, at position 0. Elm agrees — `_String_contains`
-- is `str.indexOf(sub) > -1`, and `"abc".indexOf("")` is `0`, not `-1`. The
-- two rules are not in tension: `indexes` answers "at which positions", and
-- there is a defensible reading in which that is nowhere; `contains` answers
-- "is it in there", and the answer is yes.
--
-- `startsWith` and `endsWith` are not written over `indexes` — they compare
-- `left`/`right` against the needle, and `left s 0 == ""` — so they already
-- said `True`, which is also what Elm's kernel says. They are pinned here so
-- that a later rewrite of either one over `indexes` cannot quietly take the
-- empty needle with it.
--
-- `replace` and `split` share the empty-needle rule by construction:
-- `replace str "" after` is `join (split str "") after`, and
-- `split str ""` splits into CODE POINTS. So `replace "abc" "" "-"` is
-- `"a-b-c"` — the same answer JavaScript's `"abc".split("").join("-")` gives,
-- which is what Elm's `replace` reduces to — and `replace "a😀b" "" "-"` is
-- `"a-😀-b"`, where Elm would hand back two surrogate halves around a `-`.
-- `split "" ""` is `[]`, not `[ "" ]`: an empty string has no code points.
import Node exposing (Program)
import String


yesNo : Bool -> String
yesNo b =
    if b then
        "yes"
    else
        "no"


shown : List String -> String
shown xs =
    String.fromInt (List.length xs) ++ ":" ++ String.join (List.map xs λx -> "<" ++ x ++ ">") ","


main : Program
main =
    Node.printLines
        -- The empty string is a substring of every string, including itself.
        [ yesNo (String.contains "abc" "")
        , yesNo (String.contains "" "")
        , yesNo (String.contains "a\u{1F600}b" "")

        -- …while `indexes` still answers "nowhere", which is the rule
        -- `run/StringCodePoints.beni` pins and this fixture does not change.
        , String.fromInt (List.length (String.indexes "abc" ""))
        , String.fromInt (List.length (String.indices "abc" ""))

        -- A needle that IS found still answers `True`, so the fix is not a
        -- constant `True`.
        , yesNo (String.contains "theory" "the")
        , yesNo (String.contains "theory" "hat")
        , yesNo (String.contains "" "a")

        -- Both ends: every string starts with and ends with "".
        , yesNo (String.startsWith "abc" "")
        , yesNo (String.startsWith "" "")
        , yesNo (String.endsWith "abc" "")
        , yesNo (String.endsWith "" "")

        -- `replace` with an empty needle separates every character.
        , String.replace "abc" "" "-"
        , String.replace "" "" "-"
        , String.replace "a\u{1F600}b" "" "-"

        -- `split` on an empty separator, at both extremes.
        , shown (String.split "abc" "")
        , shown (String.split "" "")
        , shown (String.split "" "x")
        ]
