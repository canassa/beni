-- run (checker-v2.md §20.4): a monomorphic constrained `let`
-- helper (static-dispatch-spike.md §6.4 rule (a)) would make the
-- two calls `x ~ List x`. The `==` obligation on that cyclic receiver
-- would ask for the element's `eq` forever, or at best be an
-- `infinite_type` at the `==`.
-- A `let` generalises (§8.4): `inner`'s `eq` is an operator's, so
-- `inner` generalises and its two uses are two instantiations: the program
-- is valid and prints `True`, `False`. Were the helper monomorphic
-- again, the harness's timeout would bound the endless variant.
--
import Node exposing (Program)


pairEq x y =
    inner a b = a == b
    inner x y && inner [ x ] [ y ]


text : Bool → String
text b =
    if b then
        "True"
    else
        "False"


main : Program
main = Node.printLines [ text (pairEq 'a' 'a'), text (pairEq 'a' 'b') ]
