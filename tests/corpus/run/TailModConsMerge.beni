-- run: merge sort as a textbook writes it (`docs/design/backend.md` §8,
-- *Tail calls modulo cons*). `merge` matches both lists at once and re-conses
-- the head it did not take, so each of its two consing branches is a step
-- of the loop and the two `[]` rows return the other list as the rest of the
-- result. `mergeSort`'s own recursion is only as deep as the split, but
-- `merge`'s was as deep as the output, and overflowed at 100 000.
--
-- `split` builds its halves by pushing, `[ …left, x ]`: a prepend copies
-- the list (`language.md` §6.8, amended 2026-10-11), so a split that
-- prepended would be quadratic in its own right. Which element lands in
-- which half, and in what order, does not change what the sort returns.
import List
import Node exposing (Program)
import String


mergeSort : List Int → List Int
mergeSort xs =
    case xs of
        [] →
            []

        [ x ] →
            [ x ]

        _ →
            case split xs [] [] of
                ( left, right ) →
                    merge (mergeSort left) (mergeSort right)


split : List a, List a, List a → List a × List a
split xs left right =
    case xs of
        [] →
            ( left, right )

        [ x, …rest ] →
            split rest right [ …left, x ]


merge : List Int, List Int → List Int
merge xs ys =
    case ( xs, ys ) of
        ( [], _ ) →
            ys

        ( _, [] ) →
            xs

        ( [ x, …xt ], [ y, …yt ] ) →
            if x ≤ y then
                [ x, …merge xt [ y, …yt ] ]
            else
                [ y, …merge [ x, …xt ] yt ]


show : List Int → String
show xs = String.join (List.map xs String.fromInt) ","


main : Program
main =
    evens = List.map (List.range 1 50000) λx → x * 2
    odds = List.map (List.range 0 49999) λx → x * 2 + 1
    merged = merge evens odds
    sorted = mergeSort (List.reverse (List.range 1 100000))
    Node.printLines
        [ show (mergeSort [ 5, 3, 9, 1, 4, 1 ])
        , show (merge [ 1, 4 ] [ 2, 3, 5, 6 ])
        , String.fromInt (List.length merged)
        , String.fromInt (List.sum merged)
        , show (List.take merged 4)
        , String.fromInt (List.length sorted)
        , show (List.take sorted 3)
        , show (List.drop sorted 99997)
        ]
