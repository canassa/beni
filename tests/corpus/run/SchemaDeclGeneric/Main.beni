-- A generic declaration's parse and print (schema.md §6, Generic
-- parameters). Runtime schema arguments supply compiled child workers.
-- The child receives the context the specialised parent made, so
-- its issues retain the parent's path and obey its options.
-- Under AllErrors the parent and child report in traversal order.
-- An argument written in a declaration, such as Page Pair in a field,
-- is compiled like every other reference. Construction failures in
-- each reached argument are checked before the input is read.
-- A parameter the declaration never reaches is not inspected.
-- Recursive generic references preserve their argument workers.
-- Development and release output share independent expected answers.
-- Stored argument slots call their compiled workers directly.
import Node
import Schema exposing (Conversion, Schema)
import Show


pub schema Page a =
    items : List a
    total : Int


pub schema Pair =
    left : Int
    right : Int


pub schema Pages =
    pairs : Page Pair
    names : Page String


pub schema Tagged a b =
    first : a


pub schema Boxed a tagged "box" of
    Full as "full"
        content : a
        rest : Boxed a
    Empty as "empty"


decimalInt : Conversion String Int
decimalInt =
    Schema.conversion
        (λs →
            case String.toInt s of
                Just n →
                    Ok n

                Nothing →
                    Err [ Schema.issue ("not a decimal integer: " ++ s) ]
        )
        λn → Ok (String.fromInt n)


counted : Schema String Int
counted = Schema.converted Schema.string decimalInt


all : Schema.Options
all =
    { errors = Schema.AllErrors, unknownKeys = Schema.Reject, maxDepth = 512, reportInput = False }


ints : Page.Type Int → String
ints p = String.fromInt p.total ++ ": " ++ String.join (List.map p.items String.fromInt) ","


showPages : Pages.Type → String
showPages p =
    String.join
        (List.map p.pairs.items λx → String.fromInt x.left ++ "-" ++ String.fromInt x.right)
        ","
        ++ " / "
        ++ String.join p.names.items ","


boxed : Boxed.Type Int → String
boxed b =
    case b of
        Boxed.Full f →
            String.fromInt f.content ++ " " ++ boxed f.rest

        Boxed.Empty →
            "."


main : Node.Program
main =
    Node.printLines
        [ "-- a schema passed at run time"
        , Show.result (Page.parse Schema.int "{\"items\":[1,2],\"total\":2}") ints
        , Show.result (Page.parse counted "{\"items\":[\"3\",\"4\"],\"total\":2}") ints
        , Show.result (Page.parse counted "{\"items\":[\"3\",\"x\"],\"total\":2}") ints
        , Show.result
            (Page.parseWith counted all "{\"items\":[\"3\",\"x\",5],\"total\":\"2\",\"more\":1}")
            ints
        , Show.result (Page.print counted { items = [ 5, 6 ], total = 2 }) λs → s
        , Show.result (Page.print Schema.int { items = [ 9007199254740992 ], total = 2 }) λs → s
        , "-- arguments checked first"
        , Show.result (Page.parse (Schema.tagged "k" []) "{\"items\":[],\"total\":0}") ints
        , Show.result
            (Page.parseWith
                Schema.int
                { Record.copy all | maxDepth = -1 }
                "{\"items\":[],\"total\":0}"
            )
            ints
        , Show.result (Tagged.parse Schema.int (Schema.tagged "unused" []) "{\"first\":1}") λt →
            String.fromInt t.first
        , "-- arguments written in a declaration"
        , Show.result
            (Pages.parse
                "{\"pairs\":{\"items\":[{\"left\":1,\"right\":2}],\"total\":1},\"names\":{\"items\":[\"a\"],\"total\":1}}"
            )
            showPages
        , Show.result
            (Pages.parseWith
                all
                "{\"pairs\":{\"items\":[{\"left\":1}],\"total\":1},\"names\":{\"items\":[2],\"total\":1}}"
            )
            showPages
        , Show.result
            (Pages.print
                { pairs = { items = [ { left = 1, right = 2 } ], total = 1 }
                , names = { items = [], total = 0 }
                }
            )
            λs → s
        , "-- a generic recursive union"
        , Show.result
            (Boxed.parse
                Schema.int
                "{\"box\":\"full\",\"content\":1,\"rest\":{\"box\":\"full\",\"content\":2,\"rest\":{\"box\":\"empty\"}}}"
            )
            boxed
        , Show.result
            (Boxed.parse
                Schema.int
                "{\"box\":\"full\",\"content\":1,\"rest\":{\"box\":\"full\",\"content\":\"2\",\"rest\":{\"box\":\"empty\"}}}"
            )
            boxed
        , Show.result (Boxed.print Schema.int (Boxed.Full { content = 7, rest = Boxed.Empty })) λs →
            s
        , "-- decode, encode, read and write, with a schema passed at run time"
        , Show.result (Schema.decode (Page.schema (Schema.tagged "k" [])) { items = [], total = 0 }) λ_ →
            "?"
        ]
