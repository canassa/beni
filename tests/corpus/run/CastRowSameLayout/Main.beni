-- A platform row of a type variable read at another, `returned a → b`, whose JavaScript
-- answers `[a]`. The caller fills both variables with `List Int`, so the types say the
-- answer is the argument; the JavaScript puts it at an `Int` element. The place
-- graph has one place for every type variable, so the row was no cast and its
-- call an identity: the push of `x0` was accepted, and in place it pushed onto the
-- array that `z` still is. The row casts by its types now, at every instance, and
-- the list escapes at the call (ownership-v3-kernel.md §3.4, §6 rule 10).
import Node exposing (Program)
import Pun


go : Int → String
go n =
    x0 = [ n ]
    h : List Int
    h = Pun.wrap x0
    z : List Int
    z = Pun.conv (Maybe.withDefault (List.head h) 0)
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
