-- `docs/design/backend.md` §7: records and tuples nested inside
-- constructors, and a tuple scrutinee with a row that binds the WHOLE
-- tuple — which turns the tuple-literal rule off and builds the object.
--
-- A tuple is the sole constructor of a one-constructor union, so it never
-- becomes a test and only widens the matrix; a record pattern is *anything*
-- with one binding per named field, because a record type has no
-- alternatives. `both` is the off-switch: its second row names the pair, so
-- the object is allocated and the rows still have to agree about it.
import Node exposing (Program)
import String


type alias Point =
    x : Int
    y : Int


type Item
    = At Point ( Int, Int )
    | Gone


place : Item -> String
place item =
    case item of
        At { x, y } ( 0, b ) ->
            "origin ${String.fromInt (x + y)} then ${String.fromInt b}"

        At { x, y } ( a, b ) ->
            "at ${String.fromInt (x + y)} of ${String.fromInt (a + b)}"

        Gone ->
            "gone"


both : Int, Int -> String
both a b =
    case ( a, b ) of
        ( 0, 0 ) ->
            "both zero"

        whole ->
            "pair ${String.fromInt whole.0} ${String.fromInt whole.1}"


main : Program
main =
    Node.printLines
        [ place (At { x = 1, y = 2 } ( 0, 9 ))
        , place (At { x = 1, y = 2 } ( 3, 4 ))
        , place Gone
        , both 0 0
        , both 5 6
        ]
