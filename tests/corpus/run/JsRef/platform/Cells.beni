--! `Js.Ref` in a platform module (`backend.md` §4, *A `Js.Ref` that does not
--! escape is a `let`*): cells written as a `let` and cells that escape into
--! `{ v }`, each read and written, and the program sees the same thing.

import Js


--| A counter whose cell is captured by the closure it returns: a `let`.
pub counter : Int → (⊤ → Int)
counter start =
    n = Js.ref start
    λ⊤ →
        Js.write n (Js.read n + 1)
        Js.read n


--| A module-level cell only this module reads and writes: a `let`.
calls : Js.Ref Int
calls = Js.ref 0


--| How many times it has been called, counting this one.
pub tick : ⊤ → Int
tick ⊤ =
    Js.write calls (Js.read calls + 1)
    Js.read calls


--| One step of a loop that counts in a cell.
countDown : Js.Ref Int, Int → ⊤
countDown total k =
    if k == 0 then
        ⊤
    else
        Js.write total (Js.read total + k)
        countDown total (k - 1)


--| A cell passed to another function escapes: `{ v }`, and the writes the
--| callee makes are the caller's to read.
pub sumTo : Int → Int
sumTo n =
    total = Js.ref 0

    countDown total n
    Js.read total


pair : Int, ⊤ → String
pair a _ = String.fromInt a


--| A read written before a write is evaluated before it: `1`, not `2`.
pub readThenWrite : String
readThenWrite =
    r = Js.ref 1
    pair (Js.read r) (Js.write r 2)


--| A value read out of a cell keeps what it read when the cell changes.
pub snapshot : String
snapshot =
    r = Js.ref "before"

    seen = Js.read r

    Js.write r "after"
    "${seen} ${Js.read r}"


--| A cell made and returned escapes; each call makes a new one.
pub fresh : ⊤ → Js.Ref Int
fresh ⊤ = Js.ref 0


pub freshAreDistinct : Bool
freshAreDistinct =
    a = fresh ⊤

    b = fresh ⊤

    Js.write a 5
    Js.read b == 0 && Js.read a == 5
