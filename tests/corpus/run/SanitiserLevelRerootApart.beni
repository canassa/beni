-- The twin of `SanitiserLevelReroot`: `k` is not read after the write, so the edit in place is accepted.
import List
import Node exposing (Program)
import String


type T
    = L (List Int)
    | W (T × Int)
    | E


cut : T → T
cut t0 =
    case t0 of
        W ( W m, _ ) →
            W m
        _ →
            E


rd : T → Int
rd t =
    case t of
        W ( W ( L xs, _ ), _ ) →
            List.length (List.push xs 1)
        _ →
            0


main : Program
main =
    k = [ 1 ]
    a = rd (cut (W ( W ( W ( L k, 0 ), 0 ), 0 )))
    Node.print (String.fromInt a)
