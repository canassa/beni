-- JoinedClosureTables (Appendix B, S4 J×G; R-5.4.2, R-5.5.5): the arms of
-- `if` join closures whose capture tables differ. In `reordered` the tables
-- have one length and another order, and each arm writes its first capture;
-- in `unequal` they have different lengths. The captured lists are read after
-- the call, so each write is refused. JoinedClosureTablesExclusive is the twin
-- that reads them no more.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


reordered : Bool → String
reordered c =
    a = [ 1 ]
    b = [ 2 ]
    f = if c then λ⊤ → ( List.push a 7, b ) else λ⊤ → ( List.push b 7, a )
    ( r, s ) = f ⊤
    "${ints r} ${ints s} ${ints a} ${ints b}"


unequal : Bool → String
unequal c =
    a = [ 1 ]
    b = [ 2 ]
    d = [ 3 ]
    f =
        if c then
            λ⊤ → List.push a 7
        else
            λ⊤ → List.push (List.push b 7) (List.length a + List.length d)
    r = f ⊤
    "${ints r} ${ints a}"


main : Program
main = Node.print "${reordered True} ${unequal True}"
