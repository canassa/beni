-- A regression guard for a private `eq`'s inside half (the owner's decision
-- as amended, checker-v2.md §11.3): a private `eq`
-- answers dispatch inside its own module, directly (`inside`) and through a
-- derived shape the module compares (`insideTuple`), so both compare modulo
-- 10 and print `True` (`Debug.toString`). The outside half, where every such comparison from
-- another module is `private_method`, is
-- `check/bad/PrivateEqThroughThirdModule`.
pub type T
    = T Int


eq : T, T → Bool
eq a b =
    case ( a, b ) of
        ( T x, T y ) →
            Int.mod x 10 == Int.mod y 10


pub inside : T, T → Bool
inside a b = a == b


pub insideTuple : T, T → Bool
insideTuple a b = ( a, 0 ) == ( b, 0 )
