""
  []
"plain text"
  [Paragraph [Text "plain text"]]
"# One\n## Two ##\nSetext\n======\nTwo\n---"
  [Heading 1 [Text "One"],Heading 2 [Text "Two"],Heading 1 [Text "Setext"],Heading 2 [Text "Two"]]
"***\n- - -"
  [ThematicBreak,ThematicBreak]
"    indented\n\n```js extra\nfenced\n```"
  [CodeBlock Nothing "indented\n",CodeBlock (Just "js") "fenced\n"]
"> quoted\n> > twice"
  [BlockQuote [Paragraph [Text "quoted"],BlockQuote [Paragraph [Text "twice"]]]]
"- a\n- b\n\n1. one\n2) two"
  [BulletList True [[Paragraph [Text "a"]],[Paragraph [Text "b"]]],OrderedList 1 True [[Paragraph [Text "one"]]],OrderedList 2 True [[Paragraph [Text "two"]]]]
"3. loose\n\n4. list"
  [OrderedList 3 False [[Paragraph [Text "loose"]],[Paragraph [Text "list"]]]]
"*em* **strong** `code` \\* escaped"
  [Paragraph [Emphasis [Text "em"],Text " ",Strong [Text "strong"],Text " ",CodeSpan "code",Text " * escaped"]]
"[link](/url \"title\") ![image](/img.png) <https://example.com> <a@b.c>"
  [Paragraph [Link "/url" (Just "title") [Text "link"],Text " ",Image "/img.png" Nothing [Text "image"],Text " ",Link "https://example.com" Nothing [Text "https://example.com"],Text " ",Link "mailto:a@b.c" Nothing [Text "a@b.c"]]]
"[ref][]\n\n[ref]: /target 'with title'"
  [Paragraph [Link "/target" (Just "with title") [Text "ref"]]]
"hard  \nbreak\\\nand soft\nbreak"
  [Paragraph [Text "hard",HardBreak,Text "break",HardBreak,Text "and soft",SoftBreak,Text "break"]]
"<div>\n*block html*\n</div>\n\ninline <b>html</b>"
  [HtmlBlock "<div>\n*block html*\n</div>",Paragraph [Text "inline ",HtmlInline "<b>",Text "html",HtmlInline "</b>"]]
"&amp; &copy; &ClockwiseContourIntegral; &#35; &#x22; &MadeUp;"
  [Paragraph [Text "& © ∲ # \" &MadeUp;"]]
"[a](javascript:alert(1)) [b](<a b>)"
  [Paragraph [Link "javascript:alert(1)" Nothing [Text "a"],Text " ",Link "a%20b" Nothing [Text "b"]]]
