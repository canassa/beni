-- BuilderCallbackFresh (Appendix B, S4; R-5.2.9, R-4.6.3): the accepted twin of
-- BuilderCallbackSharing. The callback answers a fresh list at each run, so
-- the inner write of the result is accepted.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


main : Program
main =
    ys = List.map [ 1, 2 ] λ_ → [ 5 ]
    zs = List.update ys 0 λl → List.push l 9
    Node.print (show zs)
