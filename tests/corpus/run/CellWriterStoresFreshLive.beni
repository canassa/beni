-- The live twins of CellWriterStoresFresh: a loan of an element of the
-- contents, or of a value of a `Dict` in a cell, taken before a function
-- that `Ref.update` runs writes that element in place, in a writer fiber or
-- in the frame, and read after; a loan of an element stored back in the
-- cell beside it, in a list of lists or a `Dict`, and written there in
-- place (the review of 2026-11-22); and, the pessimistic side, a writer
-- fiber that inserts a fresh list in a fold (#2698). Each read in the others
-- sees the old value. Each write is refused.
import Dict exposing (Dict)
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


showN : List (List Int) → String
showN ls = String.join (List.map ls ints) "|"


showD : Dict Int (List Int) → String
showD d = String.join (List.map (Dict.toList d) λ( a, b ) → "${String.fromInt a}=${ints b}") " "


elementInFiber : ⊤ → String
elementInFiber ⊤ =
    c = Ref.make [ [ 0 ] ]
    el = List.get (Ref.get c) 0
    a = Task.spawn λ⊤ → Ref.update c λd → List.update d 0 λl → List.push l 9
    Task.join a
    "${showN (Ref.get c)} ${ints (Maybe.withDefault el [])}"


dictValue : ⊤ → String
dictValue ⊤ =
    c = Ref.make (Dict.fromList [ ( 0, [ 0 ] ) ])
    v = Dict.get (Ref.get c) 0
    a = Task.spawn λ⊤ → Ref.update c λd → Dict.update d 0 λm → Maybe.map m λl → List.push l 3
    Task.join a
    "${showD (Ref.get c)} ${ints (Maybe.withDefault v [])}"


elementHere : ⊤ → String
elementHere ⊤ =
    c = Ref.make [ [ 0 ] ]
    el = List.get (Ref.get c) 0
    Ref.update c λd → List.update d 0 λl → List.push l 9
    "${showN (Ref.get c)} ${ints (Maybe.withDefault el [])}"


storedBack : ⊤ → String
storedBack ⊤ =
    c = Ref.make [ [ 0 ] ]
    el = Maybe.withDefault (List.get (Ref.get c) 0) []
    Ref.update c λd → List.push d [ 1 ]
    Ref.update c λd → List.push d el
    Ref.update c λd → List.update d 0 λz → List.set z 0 9
    showN (Ref.get c)


dictStoredBack : ⊤ → String
dictStoredBack ⊤ =
    c = Ref.make (Dict.fromList [ ( 0, [ 0 ] ) ])
    el = Maybe.withDefault (Dict.get (Ref.get c) 0) []
    Ref.update c λd → Dict.insert d 1 el
    Ref.update c λd → Dict.update d 0 λm → Maybe.map m λv → List.set v 0 9
    showD (Ref.get c)


-- The pessimistic side (#2698): a writer fiber whose fold inserts a fresh
-- list into the cell at each run stores a value in its captured cell that
-- is there at the fold's next switch point, as two updates in a row are, so
-- it is no writer and is refused where it is spawned (ownership-v3-kernel.md
-- §13 item 12, *A run of a writer*, amended 2026-11-26). It is safe.
dictFold : ⊤ → String
dictFold ⊤ =
    c = Ref.make (Dict.fromList [ ( 0, [ 0 ] ) ])
    a = Task.spawn λ⊤ →
        List.foldl (List.range 1 30) 0 λi acc →
            Ref.update c λd → Dict.insert d (Int.mod i 3) [ i ]
            acc + 1
    x = Task.join a
    "${String.fromInt x} ${showD (Ref.get c)}"


main : Program
main = Io.run λ⊤ →
    Node.printLines
        [ elementInFiber ⊤, dictValue ⊤, elementHere ⊤, storedBack ⊤, dictStoredBack ⊤, dictFold ⊤ ]
