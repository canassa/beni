-- A `tuple_index` or `interpolatable` obligation whose variable
-- belongs to an OUTER scope is not decided at an inner `let` (checker.md
-- §6.4, checker-v2.md §8.5): `p.0` inside `f`'s `let` waits for `snd p` to
-- make `p` a pair, and `${n}` inside `h`'s `let` waits for `String.length n`.
-- Expected `3`, `3`, `3`, `n = x1`.
--
-- Oracle twin: the controls `g` and `k`, which index `p`
-- outside any `let`, print `3` and `3`; and this file with `f` annotated
-- `( Int, Int ) -> Int` and `h` annotated `String -> String` prints `3`,
-- `3`, `3`, `n = x1`. As written, it must not be refused with AMBIGUOUS
-- TUPLE at `p.0` or AMBIGUOUS INTERPOLATION at `${n}`.
import Node exposing (Program)


snd : ( Int, Int ) -> Int
snd ( _, b ) = b


f p =
    a = p.0
    a + snd p


g p = snd p + p.0


k p = p.0 + snd p


h n =
    s = "n = ${n}"
    s ++ String.fromInt (String.length n)


main : Program
main =
    Node.printLines
        [ String.fromInt (f ( 1, 2 ))
        , String.fromInt (g ( 1, 2 ))
        , String.fromInt (k ( 1, 2 ))
        , h "x"
        ]
