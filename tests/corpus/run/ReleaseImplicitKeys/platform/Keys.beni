--! Keys the host reads with no member expression (`backend.md` §9, fact 3).
--! Host-owned coercion functions come from the sibling. Their implicit
--! valueOf/toString keys must remain observable; pad is an ordinary field.

import Js


--| `ToPrimitive` on `&`. Development is `1`. A release build that drops
--| `valueOf` is `0`.
pub coerced : ⊤ → Int
coerced ⊤ =
    o = Js.object [ ( "valueOf", seven ⊤ ), ( "pad", 1 ) ]
    n : Int
    n = Js.to o
    Js.bitAnd n 1


--| A template converts with `toString`. Development is `x5y`.
pub shown : ⊤ → String
shown ⊤ =
    o = Js.object [ ( "toString", five ⊤ ), ( "pad", 1 ) ]
    hole : String
    hole = Js.to o
    "x${hole}y"


--| A write of `valueOf` after the literal. Same coercion as `coerced`.
pub assigned : ⊤ → Int
assigned ⊤ =
    o = Js.object [ ( "pad", 1 ) ]
    Js.set o "valueOf" (seven ⊤)
    n : Int
    n = Js.to o
    Js.bitAnd n 1


-- Host-owned function; no program closure crosses Js.Value.
foreign pure seven : ⊤ → Js.Value


foreign pure five : ⊤ → Js.Value
