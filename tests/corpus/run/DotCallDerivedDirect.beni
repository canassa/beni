-- A hand-written dot-call `x.eq y` or `x.compare y` reaches the DERIVED
-- method whenever the receiver's type declares none, as `==` and `<` do
-- (checker-v2.md §21.1): on an all-nullary type, on a type with payloads,
-- on a tuple, and the table's on a primitive. A dot-call on a RECORD is
-- still the record's field call. Oracle twin: every `a.compare b` written
-- `compare a b` and every `a.eq b` written `a == b` prints the same.
import Node exposing (Program)


type Colour
    = Red
    | Green
    | Blue


type Box a
    = Box a
    | Empty


show : Order -> String
show o =
    case o of
        LT ->
            "LT"

        EQ ->
            "EQ"

        GT ->
            "GT"


yes : Bool -> String
yes b =
    if b then
        "T"
    else
        "F"


main : Program
main =
    Node.printLines
        [ show ((Red).compare Blue)
        , show ((Blue).compare Green)
        , yes ((Green).eq Green)
        , yes ((Red).eq Green)
        , show ((Box 1).compare (Box 2))
        , show ((Box "b").compare Empty)
        , yes ((Box [ 1, 2 ]).eq (Box [ 1, 2 ]))
        , show (( 1, "b" ).compare ( 1, "a" ))
        , yes (( Red, 2 ).eq ( Red, 2 ))
        , show ((3).compare 4)
        , yes ({ eq = \n -> n > 2 }.eq 3)
        ]
