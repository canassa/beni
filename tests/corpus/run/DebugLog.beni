-- `Debug.log` is boundary.md §4's one deliberate violation of the two-shape
-- rule: a pure type that writes to the console. It takes the value first and
-- the label second, and returns the value unchanged, so it can be dropped
-- into the middle of an expression without moving any other code.
import Node exposing (Program)
import String


main : Program
main =
    doubled = Debug.log "input" 21 * 2
    Node.printLines
        [ Debug.toString [ 1, 2, 3 ]
        , Debug.toString (Just "x")
        , Debug.toString Nothing
        , Debug.toString { name = "Ada" }
        , String.fromInt doubled
        ]
