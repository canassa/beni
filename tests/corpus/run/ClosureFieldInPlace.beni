-- The safe twin of `ClosureFieldLive`: `mk` answers a closure that reads
-- `m.key` beside the record, and the push of `m.items` in place is accepted:
-- a closure is observed only through its runs, so in the answer it holds the
-- one field its run reads (`ownership-v3-kernel.md` §6 rule 3, *Every holder
-- of a closure observes it only through its runs*).
import List
import Node exposing (Program)
import String


type alias M =
    key : Int
    items : List Int


mk : M → (⊤ → Int) × M
mk m = ( λ⊤ → m.key, m )


run : M → String
run m =
    ( k, m2 ) = mk m
    m3 = { m2 | items = List.push m2.items 9 }
    "${String.fromInt (k ⊤)} ${String.fromInt (List.length m3.items)}"


main : Program
main = Node.printLines [ run { key = 1, items = [ 1, 2 ] } ]
