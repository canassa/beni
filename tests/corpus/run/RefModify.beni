-- run: core's `Ref` (transparent-effects-proposal.md §17.4, §17.2):
-- `make`, `get`, `set`, `update` and `modify`, in both builds. `modify`
-- answers what its function computed from the old value and leaves the new
-- one. An `update` whose function writes the same cell itself is overruled
-- by `update`'s own write, which comes last — the documented consequence
-- of the program's own code, not a race. A `Ref` hands out its value
-- shared — any holder may have kept what `get` read — so a callback that
-- pushes onto the list it is handed pushes onto a copy
-- (`ownership-checker.md` §30; `check/bad/direct/RefUpdateShared` is the
-- refused twin without it).
import Node exposing (Program)
import Ref exposing (Ref)


main : Program
main =
    counter = Ref.make 10
    first = Ref.get counter
    Ref.set counter 20
    afterSet = Ref.get counter
    Ref.update counter λn → n + 1
    afterUpdate = Ref.get counter
    old = Ref.modify counter λn → ( n * 100, 0 )
    afterModify = Ref.get counter
    Ref.update counter λn →
        Ref.set counter 99
        n + 5
    afterSelfWrite = Ref.get counter
    names = Ref.make [ "a" ]
    Ref.update names λns → List.push (List.copy ns) "b"
    joined = String.join (Ref.get names) ","

    Node.printLines
        [ "made ${String.fromInt first}"
        , "set ${String.fromInt afterSet}"
        , "updated ${String.fromInt afterUpdate}"
        , "modify answered ${String.fromInt old}, left ${String.fromInt afterModify}"
        , "update over its own write ${String.fromInt afterSelfWrite}"
        , "list ${joined}"
        ]
