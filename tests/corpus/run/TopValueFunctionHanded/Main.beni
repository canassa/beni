-- A top-level value of another module whose value is a function with no
-- cell, a constructor, is handed to a helper that runs it on a list: the
-- answer holds the list. Each push writes a copy, accepted
-- (ownership-v3-kernel.md §13 item 12, *A defect*, (d), #2674). Its live
-- twin is TopValueFunctionHandedLive.
import Lib
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


apply : a, b, (a, b → c) → c
apply u v f = f u v


handed : ⊤ → String
handed ⊤ =
    k = [ 1 ]
    x = (apply [] k Lib.ctor).a
    n = List.push (List.copy k) 2
    "${show n} ${show x}"


handedAgain : ⊤ → String
handedAgain ⊤ =
    k = [ 1 ]
    x = (apply [] k Lib.again).a
    n = List.push (List.copy k) 2
    "${show n} ${show x}"


main : Program
main = Node.printLines [ handed ⊤, handedAgain ⊤ ]
