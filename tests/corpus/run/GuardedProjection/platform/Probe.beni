import Js


pick value = Js.optMatch value (λ⊤ → { x = -1 }) λpresent → present


pub known n =
    value = pick (Js.some { x = n })
    value.x


pub joined choose n =
    candidate = if choose then Js.some { x = n } else Js.none ⊤
    value = pick candidate
    value.x


marker = { x = 7 }


through value = Js.optMatch value (λ⊤ → marker) λpresent → present


pub narrowed choose =
    candidate = if choose then Js.some marker else Js.none ⊤
    value = through candidate
    if Js.same value marker then Js.same value marker else False


count : Js.Ref Int
count = Js.ref 0


make ⊤ =
    Js.write count (Js.read count + 1)
    { x = 42 }


pub effect ⊤ =
    value = pick (Js.some (make ⊤))
    value.x + Js.read count


pub presence choose =
    candidate = if choose then Js.some marker else Js.none ⊤
    Js.optMatch candidate (λ⊤ → False) λpresent → Js.same present marker
