-- The twins (`ownership-v2.md` §2.1, *A step past a fold*, #2062). `ys` IS the object at
-- the fold, not something below it: no step past a `var`, so its arrival reads by
-- structure and `ee` stays apart from what is written. A copy of what arrives is
-- the copy's own, and past a fold, a value nothing else holds may be edited whole.
import List
import Node exposing (Program)
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


shows : List (List Int) → String
shows ls = String.join (List.map ls show) ";"


type T a
    = Leaf a
    | Wrap (T (List a))


findL : T a, (a → List Int) → List Int
findL t f =
    case t of
        Leaf x →
            f x

        Wrap u →
            findL u λl →
                case l of
                    [ x, …_ ] →
                        f x

                    _ →
                        []


shallow : T a, (List a → b), b → b
shallow t g z =
    case t of
        Wrap (Leaf ys) →
            g ys

        _ →
            z


write : T a, (List a → List a) → List a
write t g =
    case t of
        Wrap (Leaf ys) →
            g ys

        _ →
            []


main : Program
main =
    ee = [ 1 ]
    r = shallow (Wrap (Leaf [ ee ])) (λo → o) []
    n = List.push r [ 2 ]
    ff = [ 1 ]
    w = write (Wrap (Leaf [ ff ])) λo → List.push o [ 2 ]
    k = [ 1 ]
    a = List.push (findL (Leaf k) λl → List.copy l) 2
    gone = findL (Wrap (Leaf [ [ 1 ] ])) λl → List.push l 2
    leaf = findL (Leaf [ k ]) λl → [ List.length (List.push l []) ]
    Node.print
        (shows n
            ++ "|"
            ++ show ee
            ++ "|"
            ++ shows w
            ++ "|"
            ++ show ff
            ++ "|"
            ++ show k
            ++ "|"
            ++ show a
            ++ "|"
            ++ show gone
            ++ "|"
            ++ show leaf
        )
