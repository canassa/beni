{"socket": "c", "path": "/c"}
{"pause": "c"}
{"send": "c", "text": "small"}
# Answered once the session waits in `drain`.
{"method": "GET", "path": "/filled"}
{"resume": "c"}
{"receive": "c", "until": "drained"}
