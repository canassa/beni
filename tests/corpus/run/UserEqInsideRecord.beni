-- A user's own `pub eq`, reached from INSIDE a shape the compiler derived
-- (`docs/design/static-dispatch-spike.md` §3.3, §9.2, A.46, A.60).
--
-- `core/Basics.js`'s
-- `eq` is one structural walk: it compares every reachable primitive with
-- `===` and knows nothing about a `pub eq`. A derived `eq` does know —
-- the checker put the method in the table as the field's part — and the two
-- disagree here on purpose: `Id`'s `eq` compares the MAJOR number only, so
-- `{ k = Id 1 2 } == { k = Id 1 99 }` is `True` by the table and `False` by
-- the walk. The backend emits the record shape's
-- own function and hands it `M$eq` as the field's evidence.
--
-- The second line is the same record shape with a DIFFERENT element type,
-- which is what makes the evidence a property of the use and not of the
-- function (A.46): one `eq$r$k` serves both, and the argument tells them
-- apart. The last two put the method one level deeper — inside a tuple
-- inside the record — because a walk that only looked at the top-level
-- target accepted exactly that program and printed the wrong answer.
import Node exposing (Program)


pub type Id
    = Id Int Int


-- Two ids are the same when their MAJOR numbers are.
pub eq : Id, Id -> Bool
eq a b =
    case a of
        Id majorA _ ->
            case b of
                Id majorB _ ->
                    majorA == majorB


show : Bool -> String
show b =
    if b then
        "True"
    else
        "False"


main : Program
main =
    Node.printLines
        [ show ({ k = Id 1 2 } == { k = Id 1 99 })
        , show ({ k = 1 } == { k = 1 })
        , show ({ k = Id 1 2 } == { k = Id 9 2 })
        , show (( Id 1 2, "a" ) == ( Id 1 99, "a" ))
        , show ({ k = ( Id 1 2, 3 ) } == { k = ( Id 1 99, 3 ) })
        , show ({ k = ( Id 1 2, 3 ) } == { k = ( Id 1 99, 4 ) })
        ]
