-- A regression guard: an own `eq` reached through a helper, in the order
-- `eq`, `helper`, `use`. `T`'s own `eq` compares modulo 10 through
-- `helper`, so `use 1 11` is `True` and `use 1 2` is `False`. It must
-- print the same in every order.
--
import Node exposing (Program)


type T
    = T Int


eq (T x) (T y) =
    helper x y


helper x y =
    modBy x 10 == modBy y 10


use a b =
    T a == T b


show : Bool -> String
show value =
    if value then
        "True"

    else
        "False"


main : Program
main =
    Node.printLines [ show (use 1 11), show (use 1 2) ]
