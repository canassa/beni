-- `Maybe` and `Result`, the two types every fallible core function returns.
-- Both have an argument-taking constructor, so `Nothing` is padded to the
-- same shape as `Just` rather than being a bare tag.
import List
import Maybe
import Node exposing (Program)
import Result
import String


parse : String -> String
parse text =
    case String.toInt text of
        Just n ->
            "got ${String.fromInt n}"

        Nothing ->
            "not a number"


main : Program
main =
    Node.printLines
        [ parse "123"
        , parse "1.3"
        , String.fromInt (Maybe.withDefault (String.toInt "42") 0)
        , String.fromInt (Maybe.withDefault (String.toInt "x") 0)
        , String.fromInt (Maybe.withDefault (Maybe.map (Just 21) (λn -> n * 2)) 0)
        , String.fromInt (Result.withDefault (Ok 7) 0)
        , String.fromInt (Result.withDefault (Err "nope") 0)
        , String.fromInt (Maybe.withDefault (List.head [ 5, 6 ]) 0)
        , String.fromInt (Maybe.withDefault (List.maximum [ 3, 9, 4 ]) 0)
        ]
