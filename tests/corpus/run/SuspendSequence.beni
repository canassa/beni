-- run: sequencing through a suspension point
-- (docs/design/transparent-effects-proposal.md §16.1, §16.3). Every call
-- that may suspend is a hoist, like `?`, so what was written before it is
-- evaluated before it and what was written after it runs in its
-- continuation — on the slow path, where `Io.sleep` parks the fiber and a
-- timer resumes it, and on the fast path, where `Task.join` of a fiber that
-- has already ended answers at once and nothing parks.
--
-- The `Debug.log` lines are the order the source writes: an argument
-- before a suspending argument of the same call, a record field before a
-- suspending field, a `let` before and after. A lowering that evaluated the
-- suspending call first, or dropped what follows it, prints a different
-- sequence or nothing at all.
import Debug
import Io
import Node exposing (Program)
import Task


slow : String → Int
slow label =
    _ = Debug.log "before sleep" label
    Io.sleep 1
    _ = Debug.log "after sleep" label
    String.length label


fast : Task.Fiber Int, String → Int
fast done label =
    _ = Debug.log "before join" label
    n = Task.join done
    _ = Debug.log "after join" label
    n


pair : Int, Int → Int
pair a b = a * 100 + b


main : Program
main = Io.run λ⊤ →
    done = Task.spawn λ⊤ → 7
    Io.sleep 1
    a = pair (Debug.log "first argument" 1) (slow "second argument")
    b = fast done "joined"
    r = { x = Debug.log "field x" 2, y = slow "field y" }
    Node.printLines [ String.fromInt a, String.fromInt b, String.fromInt (r.x + r.y) ]
