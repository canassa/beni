-- A function that a `schema` declaration names in a `via` writes the list
-- it is handed. The compiled print worker calls it with `v.items`, which
-- `main` reads after the print: in place, it would print 3, not 2. A `via`
-- conversion is a value in the default location
-- (ownership-v3-kernel.md §6.14), so the write is refused under
-- --ownership=v3 at the `via`.
import Io
import Node exposing (Program)
import Schema


back : List Int → Result (List Schema.Issue) (List Int)
back l = Ok (List.push l 3)


schema Box =
    items : List Int via (Schema.conversion Ok back)


main : Program
main = Io.run λ⊤ →
    v = { items = [ 1, 2 ] }
    printed = Box.print v
    Debug.log (String.fromInt (List.length v.items)) ⊤
    case printed of
        Ok text →
            Debug.log text ⊤

        Err _ →
            Debug.log "error" ⊤
    Node.done
