-- Closures: a lambda that captures, a `let` function that captures, and a
-- function returned from one. There is no partial application any more
-- (`language.md` §6.7) — `_` fills ONE missing argument and anything else
-- is written as the lambda it stands for, which is what the last three
-- lines do.
import List
import Node exposing (Program)
import String


add3 : Int, Int, Int -> Int
add3 a b c =
    a + b + c


apply : (Int -> Int), Int -> Int
apply f n =
    f n


main : Program
main =
    let
        addOne =
            \b c -> add3 1 b c

        addOneTwo =
            add3 1 2 _

        counterFrom start =
            \step -> start + step
    in
    Node.printLines
        [ String.fromInt (add3 1 2 3)
        , String.fromInt (addOne 2 3)
        , String.fromInt (addOneTwo 3)
        , String.fromInt (apply (add3 1 2 _) 3)
        , String.fromInt (apply (\n -> n * 2) 21)
        , String.fromInt ((counterFrom 10) 5)
        , String.join "," (List.map String.fromInt (List.map (add3 1 1 _) [ 1, 2, 3 ]))
        ]
