-- The accepted twin of `SanitiserFiberReader` and `SanitiserFiberBranch`
-- (`ownership-v2.md` §2.13.7): the same fibers, but the edit replaces the
-- cell's contents with a new list instead of editing them in place. A
-- replacement changes no list a loan names, so a loan held across a sleep
-- in another fiber still reads the old contents, and v2 accepts each.
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


type alias Model =
    world : Ref (List Int)
    seen : Ref String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


grow : List Int → List Int
grow xs = List.push (List.copy xs) 1


watch : Ref (List Int), Ref String → ⊤
watch r out =
    _ = Task.spawn λ⊤ →
        v = Ref.get r
        Io.sleep 10
        Ref.set out (ints v)
    ⊤


watchModel : Model → ⊤
watchModel m =
    _ = Task.spawn λ⊤ →
        v = Ref.get m.world
        Io.sleep 10
        Ref.set m.seen (ints v)
    ⊤


direct : ⊤ → String
direct ⊤ =
    r = Ref.make [ 0 ]
    out = Ref.make ""
    watch r out
    Io.sleep 1
    Ref.update r grow
    Io.sleep 20
    "direct ${Ref.get out} ${ints (Ref.get r)}"


field : ⊤ → String
field ⊤ =
    m = { world = Ref.make [ 0 ], seen = Ref.make "" }
    watchModel m
    Io.sleep 1
    Ref.set m.world [ 0, 2 ]
    Io.sleep 20
    "field ${Ref.get m.seen} ${ints (Ref.get m.world)}"


look : Ref (List Int), ⊤ → String
look r _ =
    v = Ref.get r
    Io.sleep 10
    ints v


bump : Ref (List Int), ⊤ → ⊤
bump r _ =
    Io.sleep 1
    Ref.update r grow


inline : ⊤ → String
inline ⊤ =
    r = Ref.make [ 0 ]
    ( a, _ ) =
        Task.par
            (λ⊤ →
                v = Ref.get r
                Io.sleep 10
                ints v
            )
            λ⊤ →
                Io.sleep 1
                Ref.update r grow
    "inline ${a} ${ints (Ref.get r)}"


callees : ⊤ → String
callees ⊤ =
    r = Ref.make [ 0 ]
    ( a, _ ) = Task.par (look r _) (bump r _)
    "callees ${a} ${ints (Ref.get r)}"


main : Program
main = Io.run λ⊤ →
    a = direct ⊤
    b = field ⊤
    c = inline ⊤
    d = callees ⊤
    Node.printLines [ a, b, c, d ]
