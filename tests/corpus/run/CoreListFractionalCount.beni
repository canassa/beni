-- An `Int` is a double, so `2 ^ (0 - 1)` is `0.5` and `2 ^ 1024 - 2 ^ 1024`
-- is NaN. A count is not a position (`CoreListFractionalIndex`): `repeat`,
-- `range`, `initialize` and `String.repeat` cut a fractional count toward
-- zero, and read NaN and a count below 1 as 0 (`language.md` §6.8, *An index
-- or a count that is not a whole number*). They reached `new Array(1.5)`,
-- which throws `RangeError`. The count of `range lo hi` is `hi - lo + 1`, so
-- every element stays at most `hi`. The length that `pad`, `padLeft` and
-- `padRight` pad to is a count too. Whole numbers keep their old answers:
-- the last block.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs = "[" ++ String.join (List.map xs String.fromInt) "," ++ "]"


half : Int
half = 2 ^ (0 - 1)


nan : Int
nan = 2 ^ 1024 - 2 ^ 1024


main : Program
main =
    Node.printLines
        [ ints (List.repeat 7 (1 + half))
        , ints (List.repeat 7 (2 + half))
        , ints (List.repeat 7 half)
        , ints (List.repeat 7 (negate half))
        , ints (List.repeat 7 nan)
        , ints (List.range 0 (1 + half))
        , ints (List.range 0 half)
        , ints (List.range half 2)
        , ints (List.range (negate half) 1)
        , ints (List.range 0 nan)
        , ints (List.range nan 3)
        , ints (List.initialize (2 + half) λi → i * 10)
        , ints (List.initialize half λi → i * 10)
        , ints (List.initialize nan λi → i * 10)
        , String.repeat "ab" (1 + half)
        , String.repeat "ab" half
        , String.repeat "ab" nan
        , String.padLeft "1" (3 + half) '.'
        , String.padRight "1" (3 + half) '.'
        , String.pad "1" (5 + half) '.'
        , String.pad "1" (4 + half) '.'
        , String.padLeft "1" nan '.'
        , String.pad "1" nan '.'
        , ints (List.repeat 7 2)
        , ints (List.repeat 7 0)
        , ints (List.range 1 3)
        , ints (List.range 3 1)
        , ints (List.initialize 3 λi → i * 10)
        , String.repeat "ab" 2
        , String.padLeft "1" 3 '.'
        , String.padRight "1" 3 '.'
        , String.pad "1" 5 '.'
        , String.pad "1" 4 '.'
        ]
