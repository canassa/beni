-- LinkedSupplyVersion (Appendix B, S4; R-5.3.2, R-5.3.3): the callback answers
-- its element twice, so every inner list holds one list at two positions and
-- the nested write is refused.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


main : Program
main =
    ys = List.map [ [ 1 ], [ 2 ] ] λl → [ l, l ]
    zs = List.map ys λpair → List.map pair λl → List.push l 1
    Node.print (String.join (List.map zs show) "|")
