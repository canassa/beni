-- run: a TEA-style `view`, 20 levels deep with 30 children a level and a
-- `List.map` lambda every level — the shape a UI is written in.
-- The lambdas' bodies nest inside the calls that hold them, so the emitter
-- binds the calls holding them to `const`s (`backend.md` §4) and it builds,
-- runs and loads in every browser.
import Node exposing (Program)


type Attr
    = Attr String String


type Html
    = Node String (List Attr) (List Html)
    | Text String


div : List Attr, List Html → Html
div attrs kids = Node "div" attrs kids


text : String → Html
text s = Text s


cls : String → Attr
cls c = Attr "class" c


count : Html → Int
count h =
    case h of
        Text _ →
            1

        Node _ _ kids →
            1 + List.sum (List.map kids count)


view : { items : List Int } → Html
view model =
    div [ cls "c0", Attr "id" "x0" ]
        [ text "first0"
        , text "b0.0"
        , text "b0.1"
        , text "b0.2"
        , text "b0.3"
        , text "b0.4"
        , text "b0.5"
        , text "b0.6"
        , text "b0.7"
        , text "b0.8"
        , text "b0.9"
        , text "b0.10"
        , text "b0.11"
        , text "b0.12"
        , div
            []
            (List.map model.items λit0 →
                div [ cls "c1", Attr "id" "x1" ]
                    [ text "first1"
                    , text "b1.0"
                    , text "b1.1"
                    , text "b1.2"
