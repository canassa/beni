-- Item 6 of the release optimiser (`backend.md` §9) keeps a forwarding
-- lambda whose callee is a local `const` declared after it: a `const` is
-- bound at its statement, so `const g = h` there would read `h` before its
-- initialisation, where `const g = (x) => h(x)` reads it when called. `ahead`
-- reads the lambda twice, `stored` stores it, `lambdas` makes a recursive
-- pair, and `named` the same pair as local functions, which are hoisted.
-- (A read of the lambda between it and its callee is `let_used_too_soon`:
-- the checker refuses it.) Both builds print the same.
import Node


ahead : Int → List (Int → Int)
ahead n =
    g = λx → h x
    h = λx → x + n
    [ g, h, g ]


stored : Int → List (Int → Int)
stored n =
    g = λx → h x
    h =
        λx →
            if x ≤ 0 then
                n
            else
                g (x - 1)
    [ g, h ]


lambdas : Int → Int
lambdas n =
    g = λx → h x
    h =
        λx →
            if x ≤ 0 then
                100
            else
                1 + g (x - 1)
    g n


named : Int → Int
named n =
    g x = h x
    h x =
        if x ≤ 0 then
            100
        else
            1 + g (x - 1)
    g n


show : List (Int → Int) → String
show fs = String.join (List.map fs λf → String.fromInt (f 1)) " "


main : Node.Program
main =
    Node.printLines
        [ "ahead " ++ show (ahead 5)
        , "stored " ++ show (stored 7)
        , "lambdas " ++ String.fromInt (lambdas 3)
        , "named " ++ String.fromInt (named 3)
        ]
