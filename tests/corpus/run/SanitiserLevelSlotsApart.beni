-- A list a join does not hold stays out of it (`ownership-v2.md` §2.1, #2197): `j` is dead after its write, and `k` is read only.
import List
import Node exposing (Program)
import String


type T
    = E
    | Leaf (List Int)
    | N U


type U
    = X
    | A T U
    | B U T


wr : T → Int
wr t =
    case t of
        E →
            0
        Leaf xs →
            List.length (List.push xs 1)
        N u →
            wrU u


wrU : U → Int
wrU u =
    case u of
        X →
            0
        A p q →
            wr p + wrU q
        B q p →
            wrU q + wr p


rd : T → Int
rd t =
    case t of
        E →
            0
        Leaf xs →
            List.length xs
        N u →
            rdU u


rdU : U → Int
rdU u =
    case u of
        X →
            0
        A p q →
            rd p + rdU q
        B q p →
            rdU q + rd p


hg : T → T
hg x = N (B (A E (B X x)) E)


hj : T, T → T
hj x y = N (B (A y (B X x)) E)


main : Program
main =
    k = [ 1 ]
    j = [ 2 ]
    a = wr (hg (N (A (N (B X (Leaf j))) X)))
    b = rd (hj (N (A (N (B X (Leaf [ 3 ]))) X)) (Leaf k))
    Node.print (String.fromInt (a + b + List.length k))
