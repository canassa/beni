-- A regression guard: a `case` scrutinee calls own methods written
-- BEFORE it, and the later `let` helper `q` generalises, so
-- `q 1` and `q "s"` both check and `f 3` is `( 3, 3 )`. The same program
-- with the methods written after is the harder order; this one must stay
-- right.
import Node exposing (Program)


type K
    = K Int


type Box a
    = Box a


pub g (Box a) u = 0


pub h (K m) u = Box m


pub combine (Box a) z = a


f n =
    case ( (\y -> y.h ()) (K n), (Box 1).g () ) of
        ( r, _ ) ->
            let
                q z = r.combine z
            in
            ( q 1, q "s" )


main : Program
main =
    let
        ( a, b ) = f 3
    in
    Node.printLines [ String.fromInt a ++ " " ++ String.fromInt b ]
