-- run: `Log.annotate` (transparent-effects-proposal.md §17.11) puts a key
-- and a value on every line of the function it runs, outermost first. An
-- inner `annotate` of a key that is there replaces its value in its
-- place. A key that is an integer index keeps its place too, where a
-- JavaScript object, Effect's, would put it first (§17.12 item 12); and
-- `__proto__` is a key like any other. A fiber started inside copies the
-- annotations and keeps them after `annotate` returns; the caller's lines
-- have none again.
import Io
import Log exposing (Entry)
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


record : Ref (List String), Entry → ⊤
record seen entry =
    pairs = String.join (List.map entry.annotations λ( key, value ) → "${key}=${value}") ", "
    Ref.update seen λlines → [ …List.copy lines, "${entry.message} [${pairs}]" ]


main : Program
main = Io.run λ⊤ →
    seen = Ref.make []
    Log.withSink (record seen _) λ⊤ →
        Log.annotate "request" "r1" λ⊤ →
            Log.annotate "user" "7" λ⊤ →
                Log.info "both"
                Log.annotate "request" "r2" λ⊤ → Log.info "the request replaced, in its place"
                Log.info "the request back"
            Log.info "the user gone"
            Log.annotate "1" "x" λ⊤ →
                Log.annotate "__proto__" "p" λ⊤ → Log.info "an integer key, and __proto__"
        child = Log.annotate "fiber" "child" λ⊤ →
            Task.spawn λ⊤ →
                Task.yieldNow ⊤
                Log.info "from the child, after annotate returned"
        Log.info "from the caller, after annotate returned"
        Task.join child
    Node.printLines (Ref.get seen)
