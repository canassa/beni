-- run: the fail-first fixture of `docs/design/backend.md` §8. A
-- two-parameter accumulator counting to a million is a million frames
-- without the tail-call loop, and Node 24 overflows a shape like this one
-- somewhere between 5 000 and 10 000 frames — so before the loop landed this
-- program died with `RangeError: Maximum call stack size exceeded` rather
-- than printing anything.
--
-- §8 makes the loop MANDATORY and not an optimisation for exactly this
-- reason: no JavaScript engine reliably eliminates a tail call, V8 shipped
-- it and reverted it, SpiderMonkey never shipped it.
import Node exposing (Program)
import String


count : Int, Int -> Int
count n acc =
    if n <= 0 then
        acc
    else
        count (n - 1) (acc + n)


main : Program
main = Node.printLines [ String.fromInt (count 1000000 0) ]
