-- run: `&&` and `||` chains of 300 operands that each need statements (a
-- `let` in every operand). `backend.md` §4: from the first such operand the
-- chain is a temporary and one FLAT `if` per operand — `if ($t) { …; $t = … }`,
-- `if (!$t)` for `||` — rather than one nested block per operand, a scope
-- each, which Firefox refuses past 251. Every operand is logged:
-- the operands run in order and stop at the first that decides, operand 250.
import Node exposing (Program)


b : String, Int -> Int
b label v =
    Debug.log v label


conj : Int -> Bool
conj k =
    (let
        y1 =
            b "t1" k
     in
     y1 > -1000
    )
        && (let
               y2 =
                   b "t2" k
            in
            y2 > -1000
           )
        && (let
               y3 =
