-- An own untyped method demanded two `let`s deep checks exactly as it
-- does written first (checker-v2.md §10.2): `size` is
-- first needed inside `g`, a `let` function inside `f`, a `let` function
-- inside `outer`, so its group is nested in a fresh top-level-kind frame
-- above three open frames. Its scheme, and `g`'s, must be the ones the
-- other order gives — `dump --stage=types` is the same in every
-- declaration order — and `g` still generalises, so
-- `( g a, g "s" )` checks. `size`'s own `let` helper `h` is generalised
-- in the nested frame. Expected `1 1`.
--
-- Oracle twin: this file with `size` written first
-- prints `1 1`. As written, it must not be refused with METHOD NEEDS AN ANNOTATION.
import Node exposing (Program)


type Box a
    = Box a


outer u =
    f a =
        g x = (Box x).size ⊤
        ( g a, g "s" )
    f u


pub size (Box v) u =
    h y = ( y, v )
    ( _, _ ) = h True
    ( one, _ ) = h 1
    one


main : Program
main =
    ( a, b ) = outer 0
    Node.printLines [ String.fromInt a ++ " " ++ String.fromInt b ]
