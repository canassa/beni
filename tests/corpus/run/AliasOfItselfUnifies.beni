-- A variable unified with an alias of itself is not an infinite
-- type. `wrap x : Id a` where `x : a`, and `Id a` IS `a`. Binding the flex
-- `a` to the alias `Id a`, whose expansion is `a` itself, would make a
-- cycle through the alias's expansion and report INFINITE TYPE `a = Id a`
-- at the binder. Expected: it builds and prints
-- `a` twice. Oracle twin: `g x = [ x, x ]` prints the same.
import Node exposing (Program)


type alias Id a =
    a


wrap : a -> Id a
wrap x =
    x


g x =
    [ x, wrap x ]


main : Program
main =
    Node.printLines (g "a")
