-- The controls of `SanitiserClosureSlotHolder` (`ownership-v2.md` §2.9.1,
-- #1956): the function in the tuple reads another list than the one the
-- closure edits. v2 accepts each edit, and the sanitised run prints the
-- golden.
import List
import Node exposing (Program)
import String


tuple : List Int, List Int → List Int × Int
tuple xs other =
    t = ( λ⊤ → List.length other, xs )
    f =
        λ⊤ →
            ( h, ys ) = t
            ( List.push ys 1, h ⊤ )
    f ⊤


g : (⊤ → Int) × List Int → List Int × Int
g t =
    ( h, ys ) = t
    ( List.push ys 1, h ⊤ )


passed : List Int, List Int → List Int × Int
passed xs other = g ( λ⊤ → List.length other, xs )


show : List Int × Int → String
show p =
    ( a, n ) = p
    "${String.fromInt (List.length a)} ${String.fromInt n}"


main : Program
main = Node.print "${show (tuple [ 5 ] [ 6, 7 ])} ${show (passed [ 5 ] [ 6, 7 ])}"
