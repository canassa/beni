-- The live twins of CellParkedMoved (#2600): a body moves the cell's own
-- old contents to another location of the cell (two parts of a pair
-- swapped, the second part copied to the first), parks, and puts them
-- back; a writer fiber its caller spawned writes the first part in place
-- while the body is parked, which holds the second part's old list then, a
-- loan the caller took before and reads after. The body is a helper over
-- the cell, a closure `List.map` runs, or a `List.foldl` callback. A copy
-- keeps the loan as it was, so each writer is refused.
import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String
import Task


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


showP : List Int × List Int → String
showP ( x, y ) = ints x ++ " " ++ ints y


swapPark : Ref (List Int × List Int) → ⊤
swapPark r =
    Ref.update r λ( x, y ) → ( y, x )
    Task.yieldNow ⊤
    Ref.update r λ( x, y ) → ( y, x )


direct : ⊤ → String
direct ⊤ =
    r = Ref.make ( [ 1 ], [ 2 ] )
    ( _, bb ) = Ref.get r
    a = Task.spawn λ⊤ → Ref.update r λ( x, y ) → ( List.push x 9, y )
    swapPark r
    Task.join a
    ints bb ++ " " ++ showP (Ref.get r)


mapped : ⊤ → String
mapped ⊤ =
    r = Ref.make ( [ 1 ], [ 2 ] )
    ( _, bb ) = Ref.get r
    a = Task.spawn λ⊤ → Ref.update r λ( x, y ) → ( List.push x 8, y )
    _ = List.map [ ⊤ ] λ⊤ →
        Ref.update r λ( x, y ) → ( y, x )
        Task.yieldNow ⊤
        Ref.update r λ( x, y ) → ( y, x )
    Task.join a
    ints bb ++ " " ++ showP (Ref.get r)


copied : ⊤ → String
copied ⊤ =
    r = Ref.make ( [ 1 ], [ 2 ] )
    ( _, bb ) = Ref.get r
    a = Task.spawn λ⊤ → Ref.update r λ( x, y ) → ( List.push x 7, y )
    List.foldl [ ⊤ ] ⊤ λu acc →
        Ref.update r λ( x, y ) → ( y, y )
        Io.sleep 1
        Ref.update r λ( x, y ) → ( [ 1 ], y )
    Task.join a
    ints bb ++ " " ++ showP (Ref.get r)


main : Program
main = Io.run λ⊤ → Node.printLines [ direct ⊤, mapped ⊤, copied ⊤ ]
