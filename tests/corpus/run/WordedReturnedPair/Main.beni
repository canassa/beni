-- A platform row `returned a → a × Int` whose JavaScript answers the
-- parameter at both parts: the word puts it at the first part, and the
-- second, a part of no location, can hold it too. A wide parameter placed
-- in a result with a part of no location below it escapes
-- (ownership-v3-kernel.md §6 rule 10). Before, the second part, read out as
-- an `Int`, held nothing.
import Node exposing (Program)
import Pun


go : Int → String
go n =
    x0 = [ n ]
    p = Pun.twice x0
    ( _, h ) = p
    z : List Int
    z = Pun.conv h
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
