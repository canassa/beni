-- A foreign-visible tagged producer keeps $ and string tags in release.
import Carrier exposing (Choice, Dropped, Kept)
import Ghost
import Node


choose : ⊤ → Choice
choose ⊤ = Kept ⊤


show : Choice → String
show choice =
    case choice of
        Kept _ →
            "kept"

        Dropped _ →
            Ghost.message ⊤


main : Node.Program
main = Node.print (show (Carrier.carry choose))
