-- `Dict` is written in beni over an explicit comparator, which is what
-- dropping `comparable` costs and buys. This exercises a large chunk of
-- core through one program.
import Dict
import List
import Node exposing (Program)
import String


main : Program
main =
    let
        empty =
            Dict.empty String.compare

        counts =
            Dict.insert (Dict.insert empty "a" 1) "b" 2
    in
    Node.printLines
        [ String.fromInt (Dict.size counts)
        , String.fromInt (Maybe.withDefault (Dict.get counts "a") 0)
        , String.fromInt (Maybe.withDefault (Dict.get counts "z") 0)
        , String.join (Dict.keys counts) ","
        , String.join (List.map (Dict.values counts) String.fromInt) ","
        , String.fromInt (Dict.size (Dict.remove counts "a"))
        ]
