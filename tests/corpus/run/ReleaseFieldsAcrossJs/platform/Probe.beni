--! A test platform whose JavaScript reads and builds beni values by name,
--! through both doors the wall has (`boundary.md` §4, *What JavaScript may
--! read of a beni value*): `foreign` annotations that name a record and a
--! tagged type, and `Js.from`/`Js.to` used at a record type. Every field and
--! tag it names keeps its source spelling under `--release`; everything else
--! the program builds is renamed (`backend.md` §9, *Item 4, taken up*).

import Js


--| A record a sibling reads and builds by its field names.
pub type alias Point =
    x : Int
    label : String


--| A tagged type a sibling reads by its tags.
pub type Shape
    = Circle Float
    | Square Float


--| The sibling reads `p.label` and `p.x`.
pub foreign pure describe : Point → String


--| The sibling builds `{ label, x }`.
pub foreign pure origin : ⊤ → Point


--| The sibling switches on `s.$`, a tag spelled `"Circle"` or `"Square"`.
pub foreign pure area : Shape → Float


--| Whatever it is handed, handed back: a type variable is opaque, so the
--| record passed here is renamed like any other.
pub foreign pure keep : a → a


--| The sibling builds a plain object; `Js.to` reads it as a record.
foreign pure made : ⊤ → Js.Value


--| A record that crosses by `Js.to`.
pub fromJs : ⊤ → { kind : String, count : Int }
fromJs ⊤ = Js.to (made ⊤)


--| A record that crosses by `Js.from` and is read back by name.
pub second : { first : Int, second : String } → String
second r = Js.to (Js.get (Js.from r) "second")
