-- PositionsRepeatArg (Appendix B, S4; R-4.6.2, R-4.6.7): `f x x` stores one
-- list at two positions of the result, so an element write at `[*].a` is
-- refused. Written in place, the second record would print 1,9 too.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


f : List Int, List Int → List { a : List Int }
f p q = [ { a = p }, { a = q } ]


main : Program
main =
    x = [ 1 ]
    r = List.update (f x x) 0 λel → { el | a = List.push el.a 9 }
    Node.print (String.join (List.map r λel → ints el.a) ";")
