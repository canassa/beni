-- A row `returned a → b` whose JavaScript answers `{p: [], q: a}` (with the record's own
-- property names, which a release build shortens), read at the
-- argument's own record type: the record is at the `Int` field `q`. A cast of
-- `h.q` back reads the record that the update wrote in place (ownership-v3-kernel.md
-- §3.4, §6 rule 10).
import Node exposing (Program)
import Pun


type alias R =
    p : List Int
    q : Int


go : Int → String
go n =
    r0 = { p = [ n ], q = n }
    h : R
    h = Pun.swapIn r0
    back : R
    back = Pun.conv h.q
    s = { r0 | q = 50 }
    "${String.fromInt s.q} ${String.fromInt back.q}"


main : Program
main = Node.print (go 1)
