-- The safe twin of `DictUpdateFoldAliasLive`: a fold builds a dictionary of
-- lists with `Dict.update`, whose callback appends to the list it is handed,
-- as `browser/tea/SubscriptionTapFold` does. The callback's parameter is the
-- value at the key, apart from the values at the other keys, `update` runs it
-- once, and `Dict.empty`'s values hold no cell (`ownership-v3-kernel.md` §12
-- item 8), so v3 accepts each write in place.
import Dict
import List
import Node exposing (Program)
import String


add k kind t d = Dict.update d k λcurrent →
    ( first, items ) = Maybe.withDefault current ( kind, [] )
    Just ( first, List.append items [ t ] )


build xs = List.foldl xs (Dict.empty ⊤) λ( k, kind, t ) d → add k kind t d


show : Int × (List Int × List (List Int)) → String
show ( k, ( kind, items ) ) =
    joined = String.join (List.map (List.concat [ kind, …items ]) String.fromInt) ","
    "${String.fromInt k}: ${joined}"


main : Program
main =
    d =
        build
            [ ( 1, [ 10 ], [ 1 ] )
            , ( 2, [ 20 ], [ 2 ] )
            , ( 1, [ 30 ], [ 3 ] )
            , ( 3, [ 40 ], [ 4 ] )
            , ( 2, [ 50 ], [ 5 ] )
            ]
    Node.printLines (List.map (Dict.toList d) show)
