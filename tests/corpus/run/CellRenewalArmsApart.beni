-- A cell's renewal is the union of what each arm of a body leaves in it,
-- and a run leaves one of them (blind round BN's undo stack): an arm that
-- moves `present` to `future` and an arm that leaves both as they were
-- leave the old `present` at one place each. The callee claims that one
-- run leaves no cell at two locations of the cell, and the caller reads
-- the claim where it makes the version, so a later write of `present` is
-- no write of `future` (ownership-v3-kernel.md §13 item 5, amended
-- 2026-11-22). Each write is accepted and runs in place.
import List
import Maybe
import Node exposing (Program)
import Ref exposing (Ref)
import String


type alias Hist =
    { past : List (List Int), present : List Int, future : List (List Int) }


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


undoOnce : Ref Hist → ⊤
undoOnce r =
    Ref.update r λh →
        case List.last h.past of
            Just p →
                { past = List.take h.past (List.length h.past - 1), present = List.copy p, future = List.push h.future h.present }
            Nothing →
                h


direct : ⊤ → String
direct ⊤ =
    r = Ref.make { past = [ [ 1 ] ], present = [ 2 ], future = [] }
    Ref.update r λh →
        case List.last h.past of
            Just p →
                { past = List.take h.past (List.length h.past - 1), present = List.copy p, future = List.push h.future h.present }
            Nothing →
                h
    Ref.update r λh → { h | present = List.push h.present 5 }
    ints (Ref.get r).present


helper : ⊤ → String
helper ⊤ =
    r = Ref.make { past = [ [ 1 ], [ 3 ] ], present = [ 2 ], future = [] }
    undoOnce r
    undoOnce r
    undoOnce r
    Ref.update r λh → { h | present = List.push h.present 5 }
    ints (Ref.get r).present


empty : ⊤ → String
empty ⊤ =
    r = Ref.make { past = [], present = [ 2 ], future = [] }
    undoOnce r
    Ref.update r λh → { h | present = List.push h.present 5 }
    ints (Ref.get r).present


main : Program
main = Node.printLines [ direct ⊤, helper ⊤, empty ⊤ ]
