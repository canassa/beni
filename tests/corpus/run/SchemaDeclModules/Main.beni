-- Schemas across modules (`schema.md` §6): `Users` names `Models`' generic
-- `Page` applied to its `User`, and a nullable `User`, so its workers call
-- the imported workers with the context, depth and path they made — a
-- failure deep in `Models` is named by its whole path, and under `AllErrors`
-- every module's issues come in one traversal order. An imported tagged
-- union's constructors build, match and compare in this module, and its
-- derived equality is the declaring module's. The corpus also builds this
-- with every root through the library (§10).
import Models exposing (Page, Tree, User)
import Node
import Schema
import Show


pub schema Users =
    page : Page User
    owner : User nullable


all : Schema.Options
all =
    { errors = Schema.AllErrors, unknownKeys = Schema.Reject, maxDepth = 512, reportInput = False }


showUsers : Users.Type → String
showUsers u =
    "users "
        ++ String.fromInt u.page.total
        ++ " "
        ++ String.join (List.map u.page.items λx → x.name ++ ":" ++ String.fromInt x.age) ","


showTree : Tree.Type → String
showTree t =
    case t of
        Tree.Leaf r →
            String.fromInt r.value

        Tree.Branch r →
            "[" ++ String.join (List.map r.children showTree) " " ++ "]"


main : Node.Program
main =
    Node.printLines
        [ Show.result
            (Users.parse
                "{\"page\":{\"items\":[{\"name\":\"a\",\"age\":\"3\"}],\"total\":1},\"owner\":null}"
            )
            showUsers
        , Show.result
            (Users.parse
                "{\"page\":{\"items\":[{\"name\":\"a\",\"age\":\"x\"},{\"name\":1,\"age\":\"y\"}],\"total\":1},\"owner\":null}"
            )
            showUsers
        , Show.result
            (Users.parseWith
                all
                "{\"page\":{\"items\":[{\"name\":\"a\",\"age\":\"x\"},{\"name\":1,\"age\":\"y\",\"z\":0}],\"total\":1.5},\"owner\":{}}"
            )
            showUsers
        , Show.result
            (Users.print
                { page = { items = [ { name = "a", age = 3 } ], total = 1 }, owner = Schema.Null }
            )
            λs → s
        , Show.result
            (Users.printWith all
                { page =
                    { items = [ { name = "a", age = -3 }, { name = "b", age = -4 } ], total = 1 }
                , owner = Schema.NonNull { name = "c", age = -1 }
                }
            )
            λs → s
        , Show.result
            (Tree.parse
                "{\"kind\":\"branch\",\"children\":[{\"kind\":\"leaf\",\"value\":1},{\"kind\":\"branch\",\"children\":[{\"kind\":\"leaf\",\"value\":\"2\"}]}]}"
            )
            showTree
        , Show.result
            (Tree.print
                (Tree.Branch
                    { children = [ Tree.Leaf { value = 1 }, Tree.Branch { children = [] } ] }
                )
            )
            λs → s
        , Show.result
            (Page.parse (User.schema ()) "{\"items\":[{\"name\":\"d\",\"age\":\"z\"}],\"total\":1}")
            λp → String.fromInt p.total
        , if Tree.Leaf { value = 1 } == Tree.Leaf { value = 1 } then "equal" else "different"
        , if Tree.Leaf { value = 1 } == Tree.Branch { children = [] } then "equal" else "different"
        ]
