-- JoinedClosureAlias (Appendix B, S4 J×G; R-5.4.2, R-5.5.5): the arms of `if`
-- join two closures that edit their captures. `g = f`, then `f ⊤` and `g ⊤`
-- are two calls of one joined closure, and each is refused: the once token is
-- counted across the alias.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


twice : Bool → String
twice c =
    a = [ 1 ]
    b = [ 2 ]
    f = if c then λ⊤ → List.push a 7 else λ⊤ → List.push b 8
    g = f
    r = f ⊤
    s = g ⊤
    "${ints r} ${ints s}"


main : Program
main = Node.print (twice True)
