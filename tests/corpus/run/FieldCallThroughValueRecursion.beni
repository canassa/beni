-- A dot-call on a parameter another member of its recursive group (here by value)
-- types, `x.combine 1`, is the field call in every declaration order: a
-- dot-call whose receiver becomes a record before its constraint is
-- generalised is the field call, whenever the record arrives
-- (static-dispatch-spike.md §11 *Deferred receiver*, amended 2026-09-26;
-- checker-v2.md §10.8). Taking the choice when the node was first solved
-- would make the orders where the record comes in through an in-flight
-- call first build and print `5`, and the others
-- `no_methods_on_shape`.
-- The same through VALUE recursion: `fa` written
-- first is the order at risk (`fb` first is the other). Expected `5`.
--
-- Oracle twin: this file with `fa : Int, { combine
-- : Int -> Int } -> Int` and `fb : Int, Int -> Int` annotated prints `5`.
-- As written, it must not be refused with UNKNOWN METHOD.
import Node exposing (Program)


fa n x =
    let
        _ = fb n 0
    in
    x.combine 1


fb n y =
    if n > 0 then
        y
    else
        let
            _ = fa 1 { combine = λz -> z + 1 }
        in
        y


main : Program
main = Node.printLines [ String.fromInt (fb 0 5) ]
