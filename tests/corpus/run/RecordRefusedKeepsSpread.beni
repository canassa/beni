-- `ownership-v2.md` §2.8, *the emitter reads the rows*: a module's records are written in place only
-- where the record pass refused no line. `twice` updates `r` two times. The first update is refused,
-- because the old record is updated again. So no update of this module is a store: written in place,
-- `s` and `t` are one object, and the answer is 1224.
import Node exposing (Program)


twice : { x : Int, y : Int } → Int
twice r =
    s = { r | x = r.x + 1 }
    t = { r | x = r.x + 10 }
    s.x * 100 + t.x + r.x + s.y


main : Program
main = Node.printLines [ String.fromInt (twice { x = 1, y = 2 }) ]
