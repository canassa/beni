-- `arrL x = Js.to (Js.array [ Js.from x ])` read at `List b`, a type variable below the
-- reading's root, handed to `apply` and read as `List Int`: the argument is at an
-- `Int` element (ownership-v3-kernel.md §3.4, *What a value was made from*).
import Node exposing (Program)
import Pun


apply : (a → b), a → b
apply f q = f q


go : Int → String
go n =
    x0 = [ n ]
    h : List Int
    h = apply Pun.arrL x0
    z : List Int
    z = Pun.conv (Maybe.withDefault (List.head h) 0)
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
