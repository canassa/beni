-- `describe` of statically known schemas ships no library interpreter
-- (`schema.md` §6, *What `describe` ships*): a declaration's description is
-- its node, made without a builder and without boxing, and `describe` reads
-- it. Its answer is the library's: a renamed key beside the field's name, an
-- optional field, a `via`'s source with its target left opaque, a tagged
-- union's variants, a generic declaration given a composition, and the
-- definitions of recursive declarations — one per nongeneric declaration
-- however often it is named, numbered in the order `describe` first meets
-- them, and one per use of a generic recursive declaration, since each use
-- makes its own. Two declarations that name each other are two definitions,
-- each named once: `Odd` and `Even` as constants, and the generic `Ping` and
-- `Pong`, whose descriptions hand their parameter round, close the cycle
-- inside one use rather than make a new definition per reference; so do
-- `Rock`, `Paper` and `Scissors`, each of which names the other two.
import Node
import Schema exposing (Conversion, Definition, FieldShape, Schema, Shape, VariantShape)


schema Note =
    id : Int
    title : String as "note-title" optional
    count : String via decimalInt
    by : Float nullable


schema Tree tagged "node" of
    Leaf as "leaf"
        label : String
    Branch as "branch"
        kids : List Tree


schema Forest =
    first : Tree
    second : List Tree


schema Chain a tagged "k" of
    Link as "link"
        value : a
        rest : Chain a
    End as "end"


schema Pair =
    left : Chain Int
    right : Chain Int


schema Odd tagged "o" of
    OddOne as "one"
        next : List Even


schema Even tagged "e" of
    EvenMore as "more"
        next : List Odd
    EvenEnd as "end"


schema Ping a tagged "ping" of
    PingValue as "value"
        value : a
        pong : Pong a
    PingEnd as "end"


schema Pong a tagged "pong" of
    PongNext as "next"
        ping : Ping a


schema Rock a tagged "r" of
    RockBeats as "beats"
        value : a
        paper : List (Paper a)
        scissors : List (Scissors a)


schema Paper a tagged "p" of
    PaperBeats as "beats"
        rock : List (Rock a)
        scissors : List (Scissors a)


schema Scissors a tagged "s" of
    ScissorsBeats as "beats"
        rock : List (Rock a)
        paper : List (Paper a)


decimalInt : Conversion String Int
decimalInt =
    Schema.conversion
        (λs →
            case String.toInt s of
                Just n →
                    Ok n

                Nothing →
                    Err [ Schema.issue "not a decimal integer" ]
        )
        λn → Ok (String.fromInt n)


shape : Shape → String
shape s =
    case s of
        Schema.Primitive k →
            primitive k

        Schema.ListOf child →
            "List (" ++ shape child ++ ")"

        Schema.NullableOf child →
            "Nullable (" ++ shape child ++ ")"

        Schema.RecordOf fields →
            "{ " ++ String.join (List.map fields field) ", " ++ " }"

        Schema.TaggedOf discriminator variants →
            "tagged \""
                ++ discriminator
                ++ "\" [ "
                ++ String.join (List.map variants variant) " | "
                ++ " ]"

        Schema.Converted child →
            "Converted (" ++ shape child ++ ")"

        Schema.Flipped child →
            "Flipped (" ++ shape child ++ ")"

        Schema.TypeOnly child →
            "TypeOnly (" ++ shape child ++ ")"

        Schema.EncodedOnly child →
            "EncodedOnly (" ++ shape child ++ ")"

        Schema.Reference id →
            "#" ++ String.fromInt id

        Schema.Invalid message →
            "Invalid \"" ++ message ++ "\""

        Schema.TupleOf items →
            "( " ++ String.join (List.map items shape) ", " ++ " )"

        Schema.ConstructorsOf ctors →
            "constructors [ " ++ String.join (List.map ctors λc → c.name) " | " ++ " ]"

        Schema.MaybeOf child →
            "Maybe (" ++ shape child ++ ")"


field : FieldShape → String
field f =
    f.name
        ++ (if f.key == f.name then
               ""
            else
               " as \"" ++ f.key ++ "\""
           )
        ++ (if f.optional then
               " optional"
            else
               ""
           )
        ++ " : "
        ++ shape f.shape


variant : VariantShape → String
variant v =
    v.name
        ++ " as \""
        ++ v.tag
        ++ "\""
        ++ (case v.payload of
               Just p →
                   " " ++ shape p

               Nothing →
                   ""
           )


primitive : Schema.PrimitiveKind → String
primitive k =
    case k of
        Schema.StringKind →
            "String"

        Schema.BoolKind →
            "Bool"

        Schema.IntKind →
            "Int"

        Schema.FloatKind →
            "Float"

        Schema.FiniteFloatKind →
            "FiniteFloat"

        Schema.NullKind →
            "Null"

        Schema.ValueKind →
            "Value"

        Schema.CharKind →
            "Char"

        Schema.Int32Kind →
            "Int32"

        Schema.NeverKind →
            "⊥"


definition : Definition → String
definition d = "  #" ++ String.fromInt d.id ++ " " ++ d.name ++ " = " ++ shape d.shape


describe : Schema e a → String
describe s =
    d = Schema.describe s
    String.join [ shape d.root, …List.map d.definitions definition ] "\n"


main : Node.Program
main =
    Node.printLines
        [ describe (Note.schema ⊤)
        , describe (Tree.schema ⊤)
        , describe (Forest.schema ⊤)
        , describe (Schema.list (Schema.nullable (Tree.schema ⊤)))
        , describe (Chain.schema (Schema.list (Note.schema ⊤)))
        , describe (Pair.schema ⊤)
        , describe (Schema.converted Schema.string decimalInt)
        , describe (Odd.schema ⊤)
        , describe (Schema.list (Even.schema ⊤))
        , describe (Ping.schema Schema.int)
        , describe (Pong.schema Schema.string)
        , describe (Rock.schema Schema.bool)
        , case Schema.parse (Tree.schema ⊤) "{\"node\":\"leaf\",\"label\":\"a\"}" of
            Ok _ →
                "parsed"

            Err _ →
                "failed"
        ]
