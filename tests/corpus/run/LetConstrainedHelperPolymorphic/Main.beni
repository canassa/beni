-- run (checker-v2.md §8.4): a `let`
-- FUNCTION binding whose requirement is its own generalises over it and
-- takes it as a hidden parameter (`$l<inst>$<k>`, backend.md §4), so each
-- use instantiates it at its own type.
--
--   - `pairEq`: `inner`'s `eq` is an operator's, so
--     `inner` generalises and `inner x y` and `inner [ x ] [ y ]` are two
--     instantiations — no `x ~ List x`, and no `infinite_type`
--     (`run/LetHelperCyclicReceiver`).
--   - `describe`'s `show` needs `render` through `label`'s `where` clause
--     (a scheme's requirement, not a dot-call's own, which the owner's rule
--     of 2026-09-26 keeps monomorphic), and is used at `Colour` and at
--     `Shape.Shape`, which both have one.
--
-- Expected `True`, `False`, `True`, `False`, `<red1><square2>`.
--
-- Oracle twin: `inner` and `show` lifted to top-level
-- declarations with the `where` clauses written out print exactly the
-- expected lines. As written, it must not refuse `pairEq` with INFINITE
-- TYPE or `describe` with TYPE MISMATCH at `show s`.
import Node exposing (Program)
import Shape exposing (Shape, Square)


pub type Colour
    = Red
    | Green


pub render : Colour, Int -> String
render c n =
    case c of
        Red ->
            "red" ++ String.fromInt n

        Green ->
            "green" ++ String.fromInt n


label : a, Int -> String
    where a.render : a, Int -> String
label x n = x.render n


pairEq x y =
    let
        inner a b = a == b
    in
    inner x y && inner [ x ] [ y ]


describe : Colour, Shape -> String
describe c s =
    let
        show x = "<" ++ label x 1 ++ ">"
    in
    show c ++ show s


text : Bool -> String
text b =
    if b then
        "True"
    else
        "False"


main : Program
main =
    Node.printLines
        [ text (pairEq 1 1)
        , text (pairEq "a" "b")
        , text (pairEq { v = Green } { v = Green })
        , text (pairEq ( 1, "x" ) ( 1, "y" ))
        , describe Red (Square 2)
        ]
