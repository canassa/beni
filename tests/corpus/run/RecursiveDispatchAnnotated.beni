-- A regression guard (checker-v2.md §6.6,
-- §10.6): a recursive dispatch program with the method that is used at two types
-- ANNOTATED, `eq : Box a, Box a -> Bool`. A reference to an annotated
-- member of a group that is checking instantiates its scheme and is never a
-- back-edge, so `show` and `eq` do not merge, and `show` compares `Box Int`
-- and `Box String` with the one `eq`. `ordering_test.zig` checks it with
-- its declarations reversed, the order that once failed. Expected `a`, `b`.
import Node exposing (Program)


type K
    = K Int


type Box a
    = Box a


pub show (K n) u =
    if Box 1 == Box 2 && n == 0 then
        "a"
    else if Box "x" == Box "y" then
        "b"
    else
        "c"


pub eq : Box a, Box a → Bool
eq (Box a) (Box b) =
    _ = λw → (K 0).show ⊤
    True


main : Program
main = Node.printLines [ (K 0).show ⊤, (K 1).show ⊤ ]
