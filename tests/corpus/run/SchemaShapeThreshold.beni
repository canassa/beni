-- Thirty `Json.decodeValue` runs: the shapes/workers fork (`schema.md` §6)
-- counts a program's validator runs against `SchemaValid.shape_threshold`
-- (29), and thirty crosses it, so the default build takes the shapes side —
-- the bytes `--schema-shapes=always` gives — and not the workers side
-- `--schema-shapes=never` gives. It is the fixture the differential tests
-- (`backend.md` §9, issue #432) build with the edge lists the binary
-- carries and with lists made here: the fork's `schema_shapes` is a fact
-- a row must carry, and this program is on the other side of the
-- threshold from the rows the binary carries.
import Json
import Node
import Schema exposing (Value)


w0 : Value → Int
w0 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w1 : Value → Int
w1 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w2 : Value → Int
w2 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


