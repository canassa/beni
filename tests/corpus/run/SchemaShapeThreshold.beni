w18 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w19 : Value → Int
w19 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w20 : Value → Int
w20 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w21 : Value → Int
w21 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w22 : Value → Int
