w26 : Value → Int
w26 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w27 : Value → Int
w27 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w28 : Value → Int
w28 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


w29 : Value → Int
w29 v = (Result.withDefault (Json.decodeValue v) { n = 1 }).n


main : Node.Program
main =
    case Schema.parse Schema.value "{\"n\":7}" of
        Ok v →
            Node.print
                (String.fromInt
                    (w0 v
                        + w1 v
                        + w2 v
                        + w3 v
                        + w4 v
                        + w5 v
                        + w6 v
                        + w7 v
                        + w8 v
                        + w9 v
                        + w10 v
                        + w11 v
                        + w12 v
                        + w13 v
                        + w14 v
                        + w15 v
                        + w16 v
                        + w17 v
                        + w18 v
                        + w19 v
                        + w20 v
                        + w21 v
                        + w22 v
                        + w23 v
                        + w24 v
                        + w25 v
                        + w26 v
                        + w27 v
                        + w28 v
                        + w29 v
                    )
                )

        Err _ →
            Node.print "x"
