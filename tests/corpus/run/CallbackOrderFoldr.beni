-- run: `foldr` is the one exception to the front-to-back callback rule, and
-- its back-to-front order is its CONTRACT rather than an artefact of being
-- written as reverse-then-`foldl` (`checker.md` Appendix B). This fixture
-- exists so that nobody "fixes" `foldr` the way `map` was fixed: all four
-- `foldr`s — `List`, `String`, `Dict` and `Set` — hand the callback the LAST
-- element first, and the matching `foldl`s hand it the first.
import Dict exposing (Dict)
import List
import Node exposing (Program)
import Set exposing (Set)
import String


note : String, Int -> Int
note tag n = Debug.log tag n


noteChar : String, Char -> Char
noteChar tag ch = Debug.log tag ch


numbers : Dict Int Int
numbers = Dict.fromList [ ( 1, 10 ), ( 2, 20 ), ( 3, 30 ) ]


members : Set Int
members = Set.fromList [ 1, 2, 3 ]


main : Program
main =
    listLeft = List.foldl [ 1, 2, 3 ] [] λx acc -> [ note "List.foldl" x, ...acc ]
    listRight = List.foldr [ 1, 2, 3 ] [] λx acc -> [ note "List.foldr" x, ...acc ]
    stringLeft = String.foldl "abc" "" λch acc -> String.cons acc (noteChar "String.foldl" ch)

    stringRight = String.foldr "abc" "" λch acc -> String.cons acc (noteChar "String.foldr" ch)

    dictLeft = Dict.foldl numbers [] λk _ acc -> [ note "Dict.foldl" k, ...acc ]
    dictRight = Dict.foldr numbers [] λk _ acc -> [ note "Dict.foldr" k, ...acc ]
    setLeft = Set.foldl members [] λv acc -> [ note "Set.foldl" v, ...acc ]
    setRight = Set.foldr members [] λv acc -> [ note "Set.foldr" v, ...acc ]
    Node.printLines
        [ Debug.toString listLeft
        , Debug.toString listRight
        , stringLeft
        , stringRight
        , Debug.toString dictLeft
        , Debug.toString dictRight
        , Debug.toString setLeft
        , Debug.toString setRight
        ]
