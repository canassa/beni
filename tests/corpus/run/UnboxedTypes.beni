-- run: a type of one constructor with one field is its field under
-- `--release` (`backend.md` §9, *A type of one constructor with one field
-- is its field*), and every program prints the same in both builds:
-- built, read by a parameter pattern and by a `case`, compared by its
-- derived `==` and `compare` and by `==` against a constructor, passed as a
-- function, held in a record that an update leaves alone, nested in another
-- such type, and core's `Duration`, `Dict` and `Set`, each a type of this
-- kind, through their own modules. A record held by such a type passes through
-- a generic function and is read back through a binding of the type, whose
-- representation key is the record's (`backend.md` §9, *Declared-type
-- filtering of fact 3*), so the binding keeps the record and the release
-- build keeps the field only it reads.
import Dict
import Duration
import Node exposing (Program)
import Set


type Meters
    = Meters Float


type Box a
    = Box a


type Tagged
    = Tagged (Box String)


type alias Spot =
    row : Int
    col : Int


type Cell
    = Cell Spot


type alias Trip =
    name : String
    length : Meters


add : Meters, Meters → Meters
add (Meters a) (Meters b) = Meters (a + b)


show : Meters → String
show m =
    case m of
        Meters x →
            "${String.fromFloat x} m"


unbox : Box a → a
unbox (Box x) = x


label : Tagged → String
label (Tagged (Box s)) = s


both : a, a, Bool → a
both x y first = if first then x else y


column : Cell → String
column c =
    case c of
        Cell s →
            String.fromInt s.col


yes : Bool → String
yes b = if b then "yes" else "no"


main : Program
main =
    trip : Trip
    trip = { name = "walk", length = Meters 2.5 }

    renamed = { trip | name = "stroll" }

    lengths = List.map [ 1.0, 3.0, 2.0 ] Meters

    cell : Cell
    cell = both (Cell { row = 1, col = 6 }) (Cell { row = 2, col = 9 }) (List.length lengths > 1)

    boxed : Box Spot
    boxed = both (Box { row = 3, col = 4 }) (Box { row = 5, col = 8 }) False

    longest = List.foldl lengths (Meters 0.0) λm best → if best < m then m else best
    Node.printLines
        [ show (add (Meters 1.5) (Meters 2.0))
        , show renamed.length
        , yes (renamed.length == Meters 2.5)
        , yes (Meters 1.0 == Meters 2.0)
        , yes (Meters 1.0 < Meters 2.0)
        , show longest
        , String.join (List.map (List.sort lengths) show) ", "
        , unbox (Box "boxed")
        , String.fromInt (unbox (unbox (Box (Box 7))))
        , label (Tagged (Box "nested"))
        , yes (Box [ 1, 2 ] == Box [ 1, 2 ])
        , String.fromInt (Duration.toMillis (Duration.sum (Duration.seconds 1) (Duration.millis 5)))
        , String.join (Dict.keys (Dict.insert (Dict.singleton "b" 2) "a" 1)) ","
        , String.fromInt (Set.size (Set.fromList [ 3, 1, 3 ]))
        , column cell
        , String.fromInt (unbox boxed).col
        ]
