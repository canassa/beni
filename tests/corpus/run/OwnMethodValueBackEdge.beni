-- A back-edge BY VALUE merges (checker-v2.md §10.4):
-- `use` needs `T`'s `m` through dispatch, and `m`'s body calls `use` by
-- value. The SCC order checks `use` first whatever the source order (`m`
-- depends on it); `use` nests `m` at its demand, and `m`'s reference to
-- `use` — a `checking` group lower on the stack — merges `m`'s top-level
-- frame into `use`'s, which generalises both at once: `main` uses `use` at
-- `String` and at `Bool`. Expected `7 s`, `3`.
--
-- Oracle twin: this file with `use : Int, a -> (
-- Int, a )` and `m : T, a -> ( Int, a )` annotated prints exactly the
-- expected lines. As written, it must not be refused with METHOD NEEDS AN ANNOTATION.
import Node exposing (Program)


type T
    = T Int


use n x =
    if n <= 0 then
        ( 0, x )

    else
        let
            ( k, y ) =
                (T n).m x
        in
        ( k + 1, y )


pub m (T n) x =
    let
        ( k, y ) =
            use (n - 1) x
    in
    ( k * 2, y )


main : Program
main =
    let
        ( a, s ) =
            use 3 "s"

        ( b, _ ) =
            use 2 True
    in
    Node.printLines [ String.fromInt a ++ " " ++ s, String.fromInt b ]
