-- The live twin of `WriterValuesRouted`: each written dictionary, set or
-- list is read through its old name after the write, so in place the read
-- would see the write. v3 refuses each call, however the writer value was
-- reached (`ownership-v3-kernel.md` §12 item 5). With v3's later-read test
-- broken, each of them is accepted, and the oracle routes the value where
-- it is made: the sanitised build traps and the in-place build prints
-- other lines.
import Dict exposing (Dict)
import Io
import Node exposing (Program)
import Set exposing (Set)


type alias D =
    Dict Int Int


idW : (D, Int, Int → D) → (D, Int, Int → D)
idW f = f


idR : (D, Int → D) → (D, Int → D)
idR f = f


idU : (D, Int, (Maybe Int → Maybe Int) → D) → (D, Int, (Maybe Int → Maybe Int) → D)
idU f = f


idP : (D, (Int, Int → Int) → D) → (D, (Int, Int → Int) → D)
idP f = f


idSet : (Set Int, Int → Set Int) → (Set Int, Int → Set Int)
idSet f = f


idL : (List Int, Int → List Int) → (List Int, Int → List Int)
idL f = f


idLU : (List Int, Int, (Int → Int) → List Int) → (List Int, Int, (Int → Int) → List Int)
idLU f = f


apply : (D, Int, Int → D), D → D
apply f d = f d 3 30


applyOne : (D → D), D → D
applyOne f d = f d


applyLU : (List Int, Int, (Int → Int) → List Int), List Int → List Int
applyLU f xs = f xs 0 λn →
    Io.sleep 1
    n + 100


base : ⊤ → D
base ⊤ = Dict.fromList [ ( 1, 10 ), ( 2, 20 ) ]


render : D → String
render d =
    String.join (List.map (Dict.toList d) λ( k, v ) → "${String.fromInt k}=${String.fromInt v}") ","


members : Set Int → String
members s = String.join (List.map (Set.toList s) String.fromInt) ","


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


go : ⊤ → List String
go ⊤ =
    w = idW Dict.insert
    a0 = base ⊤
    a = w a0 3 30
    ww = idW (idW Dict.insert)
    b0 = base ⊤
    b = ww b0 4 40
    lw = (λq → q) Dict.insert
    c0 = base ⊤
    c = lw c0 5 50
    d0 = base ⊤
    d = apply (idW Dict.insert) d0
    r = idR Dict.remove
    e0 = base ⊤
    e1 = r e0 1
    si = idSet Set.insert
    f0 = Set.fromList [ 1, 2 ]
    f = si f0 3
    ins = Dict.insert
    wa = idW ins
    g0 = base ⊤
    g = wa g0 6 60
    h = λx → w x 7 70
    i0 = base ⊤
    i = h i0
    j0 = base ⊤
    j = applyOne (λx → w x 8 80) j0
    lp = idL List.push
    k0 = [ 1, 2 ]
    k = lp k0 3
    part = w _ 9 90
    l0 = base ⊤
    l = part l0
    u = idU Dict.update
    m0 = base ⊤
    m = u m0 1 λ_ → Just 7
    srt = idP Dict.sortBy
    n0 = base ⊤
    n = srt n0 λx _ →
        Io.sleep 1
        0 - x
    o0 = [ 1, 2 ]
    o = applyLU (idLU List.update) o0
    [ render a
    , render a0
    , render b
    , render b0
    , render c
    , render c0
    , render d
    , render d0
    , render e1
    , render e0
    , members f
    , members f0
    , render g
    , render g0
    , render i
    , render i0
    , render j
    , render j0
    , ints k
    , ints k0
    , render l
    , render l0
    , render m
    , render m0
    , render n
    , render n0
    , ints o
    , ints o0
    ]


main : Program
main = Io.run λ⊤ → Node.printLines (go ⊤)
