-- A regression guard: an own method used inside a `let` helper at two
-- types checks when the method is ANNOTATED (`size`, written after its
-- user) or written FIRST (`weight`, unannotated). Both must keep checking;
-- the unannotated method written after its user is a separate case.
-- Each helper is used at two types, so a helper held monomorphic by its
-- method's position would be refused.
import Node exposing (Program)


type Box a
    = Box a


pub weight (Box _) u = 2


viaAnnotated u =
    g x = (Box x).size ()
    ( g 1, g "s" )


viaFirst u =
    g x = (Box x).weight ()
    ( g 1, g "s" )


pub size : Box a, () → Int
size b u = 1


both : Int × Int → String
both ( a, b ) = String.fromInt a ++ " " ++ String.fromInt b


main : Program
main = Node.printLines [ both (viaAnnotated 0), both (viaFirst 0) ]
