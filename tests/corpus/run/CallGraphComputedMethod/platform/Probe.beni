--! A test platform that keeps a function in a JavaScript array and takes
--! it out again by a computed index through the typed array protocol
--! (#685). The release specialiser's call graph must count the function as
--! called. Fact 3 reads the method of an array as anything, and calling it
--! escapes the receiver, and so the function the array holds, whichever way
--! the method's name is written.

import Browser.Host.Array as Array
import Js


--| `f n`, with `f` kept in an array and taken out by `pop`, a name made
--| at run time.
pub viaComputed : (Int → Int), Int → Int
viaComputed f n =
    frames = Array.make ⊤
    Array.push frames f
    index = Array.size frames - 1
    g = Array.getOr frames index λx → x
    g n
