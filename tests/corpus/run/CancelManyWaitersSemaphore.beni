-- run: cancelling many waiters at once costs time linear in their number
-- (transparent-effects-proposal.md §17.9). Fibers wait for the one permit of
-- a `Semaphore`; closing their scope cancels them all. The `Semaphore`
-- still works afterwards: a `release` frees the permit.
import Io
import List
import Node exposing (Program)
import Semaphore exposing (Semaphore)
import Task


count : Int
count = 480000


main : Program
main = Io.run λ⊤ →
    s = Semaphore.make 1
    Semaphore.acquire s 1
    Task.scope λscope →
        _ = List.foldl (List.range 1 count) 0 λi n →
            _ = Task.spawnIn scope λ⊤ → Semaphore.withPermit s λ⊤ → ⊤
            n + i
        Task.yieldNow ⊤
    _ = Debug.log "available while held" (Semaphore.available s)
    Semaphore.release s 1
    _ = Debug.log "available after release" (Semaphore.available s)
    _ = Debug.log "try" (Semaphore.tryWithPermits s 1 λ⊤ → "in")
    Node.print "done"
