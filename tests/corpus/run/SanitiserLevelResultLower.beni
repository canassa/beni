-- A `⟲` at a call's result is said at each fold a walk below the result slot reaches, a lower one too
-- (`ownership-v2.md` §2.1, #2195): a step onto `A2` from below `m` folds onto `A03 (A32 (A20 ⟲` without
-- passing the higher `A0` fold. Dropped as below that one and read from a path that was not the object's,
-- `k` was edited while live.
import List
import Node exposing (Program)
import String


type A0
    = L0 (List Int)
    | A03 A3
    | A01 A1
    | E0


type A3
    = A32 A2
    | A30 A0


type A2
    = L2 (List Int)
    | A20 A0
    | A23 A3


type A1
    = A11 A1
    | A12 A2


wr : A0 → Int
wr t =
    case t of
        A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 (A32 (L2 xs))))))))) →
            List.length (List.push xs 1)
        _ →
            0


hg : A0 → A0
hg t0 =
    case t0 of
        A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 m))))))) →
            A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 m)))))))
        _ →
            E0


main : Program
main =
    k = [ 1 ]
    a = wr (hg (A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 (A32 (L2 k)))))))))))
    Node.print (String.fromInt (a + List.length k))
