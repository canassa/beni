pub type Sorted a
    = Sorted (List a)


pub eq : Sorted a, Sorted a -> Bool
    where a.compare : a, a -> Order
eq (Sorted l) (Sorted r) =
    case l of
        [] ->
            case r of
                [] ->
                    True

                _ ->
                    False

        x :: _ ->
            case r of
                y :: _ ->
                    not (x < y) && not (y < x)

                [] ->
                    False
