-- Queue row 75, D3 (checker-v2.md §10.2, R7): an unannotated `pub compare`
-- is written before this module's unannotated `pub eq`, and both `==` on a
-- `T` inside it — the direct one and the one reached through the record's
-- part — need that `eq`. 875f623 compiled both in silence: the first to
-- `undefined`, the second to a structural comparison that ignored `eq`.
-- Checker v1 then refused both with `method_needs_annotation` (this was
-- `check/bad/MethodNeedsAnnotation/` until the cut-over, R11). Checker v2
-- checks `eq` at its first demand, so the program is valid and both
-- comparisons use it: `eq` says `T m` equals `T n` when `m + 1 == n`, so
-- `T 1 == T 2` is `True` where a structural comparison says `False`.
-- `first` and `second` are the same two comparisons as top-level values,
-- also written above `eq`, so each answer is printed on its own line.
pub type T
    = T Int


pub type K
    = K Int


pub compare left right =
    let
        direct =
            T 1 == T 2

        nested =
            { v = T 1 } == { v = T 2 }
    in
    case left of
        K a ->
            case right of
                K b ->
                    if direct || nested then
                        EQ
                    else
                        Basics.compare a b


pub first =
    T 1 == T 2


pub second =
    { v = T 1 } == { v = T 2 }


pub eq a b =
    case a of
        T m ->
            case b of
                T n ->
                    m + 1 == n
