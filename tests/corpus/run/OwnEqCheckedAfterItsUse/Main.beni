-- The answers of `M`'s `compare`, `first` and `second`: `EQ`, `True` and
-- `True`, because `M.eq` answers every `==` on a `T` although it is written
-- after all three (D3). A structural `==` would print `LT`, `False`, `False`.
import M
import Node exposing (Program)


showBool : Bool -> String
showBool b =
    if b then
        "True"
    else
        "False"


showOrder : Order -> String
showOrder o =
    case o of
        LT ->
            "LT"

        EQ ->
            "EQ"

        GT ->
            "GT"


main : Program
main =
    Node.printLines
        [ showOrder (M.compare (M.K 1) (M.K 2))
        , showBool M.first
        , showBool M.second
        ]
