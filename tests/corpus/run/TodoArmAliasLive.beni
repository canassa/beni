-- The live twin of `TodoArmInPlace`: the arm of `pick` that answers answers
-- the list twice, so a push of one part in place would change the other.
-- The arm that is `Debug.todo` answers nothing, and v3 still refuses the
-- push (`ownership-v3-kernel.md` §6 rule 10, *A call that never answers*).
import List
import Node exposing (Program)
import String


pick : Int, List Int → List Int × List Int
pick n xs = if n == 0 then Debug.todo "no" else ( xs, xs )


run : List Int → String
run xs =
    ( a, b ) = pick 1 xs
    String.join (List.map (List.append (List.push a 9) b) String.fromInt) ","


main : Program
main = Node.printLines [ run [ 1, 2 ] ]
