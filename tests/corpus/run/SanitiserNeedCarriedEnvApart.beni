-- The twin of `SanitiserNeedCarriedEnv` (`ownership-v2.md` §2.11.3): the
-- stored closure captures a reader, which carries no need, and the writer is
-- run directly on a fresh answer. Both are accepted, and the write is edited
-- in place.
import Dict exposing (Dict)
import List
import Node exposing (Program)
import String


show : List Int → String
show xs = String.join (List.map xs String.fromInt) ","


appE : Dict Int (⊤ → ((⊤ → List Int) → List Int)), List Int → List Int
appE o k =
    case Dict.get o 1 of
        Just h →
            (h ⊤) λ⊤ → k

        Nothing →
            []


main : Program
main =
    k = [ 1 ]
    wr = λs → List.push (s ⊤) 2
    rd = λs → s ⊤
    y = appE (Dict.singleton 1 λ⊤ → rd) k
    z = wr λ⊤ → [ 7 ]
    Node.print (show y ++ "|" ++ show z ++ "|" ++ show k)
