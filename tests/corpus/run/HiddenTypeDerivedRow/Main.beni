-- CK-89: see A.beni.
import A
import Node exposing (Program)


show : Bool -> String
show value =
    if value then
        "True"

    else
        "False"


main : Program
main =
    Node.printLines
        [ show (A.make 1 == A.make 1)
        , show (A.make 1 == A.make 2)
        , show (A.make "a" < A.make "b")
        ]
