-- `describe` answers a schema's whole graph as plain data, both endpoints
-- (`schema.md` §5): a field's declared name beside its external key, a
-- tagged union's discriminator and each variant's name, tag and payload, a
-- conversion's source with its target left opaque, and a flip or a
-- projection as the node it is — a double flip is the schema it began as.
-- A recursive schema is one definition, named by a reference wherever it
-- is used, its own body included; one nested in another is a definition of
-- its own, met once, so every reference resolves exactly once; and two
-- schemas built with one name are two definitions. Describing runs no
-- conversion: the one here would log if it ran.
import Node
import Schema exposing (Conversion, Definition, FieldShape, Schema, Shape, VariantShape)


loud : Conversion String Int
loud =
    Schema.conversion
        (\s ->
            let
                _ = Debug.log s "a conversion ran"
            in
            Ok 0
        )
        (\n -> Ok (String.fromInt n))


one ( (), a ) = { a = a }


unOne r = ( (), r.a )


two ( ( (), a ), b ) = { a = a, b = b }


unTwo r = ( ( (), r.a ), r.b )


type alias Flat e =
    id : e
    tags : List String
    note : Schema.Presence (Schema.Nullable Float)


toFlat ( ( ( (), id ), tags ), note ) = { id = id, tags = tags, note = note }


fromFlat r = ( ( ( (), r.id ), r.tags ), r.note )


flat : Schema (Flat String) (Flat Int)
flat =
    Schema.record
        (Schema.fields
            |> Schema.field "id" (Schema.converted Schema.string loud)
            |> Schema.key "the-id"
            |> Schema.field "tags" (Schema.list Schema.string)
            |> Schema.optional "note" (Schema.nullable Schema.finiteFloat)
        )
        (Schema.mapping toFlat fromFlat)
        (Schema.mapping toFlat fromFlat)


type Shape2
    = Dot
    | Circle { a : Float }


shape2 : Schema Shape2 Shape2
shape2 =
    let
        dot =
            Schema.injection
                (\() -> Dot)
                (\s ->
                    case s of
                        Dot ->
                            Just ()

                        _ ->
                            Nothing
                )

        circle =
            Schema.injection
                Circle
                (\s ->
                    case s of
                        Circle r ->
                            Just r

                        _ ->
                            Nothing
                )
    in
    Schema.tagged
        "shape"
        [ Schema.nullary "Dot" "dot" dot dot
        , Schema.variant
            "Circle"
            "circle"
            (Schema.record
                (Schema.fields |> Schema.field "a" Schema.float)
                (Schema.mapping one unOne)
                (Schema.mapping one unOne)
            )
            circle
            circle
        ]


-- A recursive schema with another inside it: an `Outer` holds an `Inner`
-- tree and more `Outer`s; an `Inner` holds more `Inner`s.
type Outer
    = Outer { a : Inner, b : List Outer }


type Inner
    = Inner { a : List Inner }


inner : Schema Inner Inner
inner =
    Schema.recursive
        "Inner"
        (\self ->
            let
                i = Schema.injection Inner (\(Inner r) -> Just r)
            in
            Schema.tagged
                "t"
                [ Schema.variant
                    "Inner"
                    "inner"
                    (Schema.record
                        (Schema.fields |> Schema.field "a" (Schema.list self))
                        (Schema.mapping one unOne)
                        (Schema.mapping one unOne)
                    )
                    i
                    i
                ]
        )


outer : Schema Outer Outer
outer =
    Schema.recursive
        "Outer"
        (\self ->
            let
                o = Schema.injection Outer (\(Outer r) -> Just r)
            in
            Schema.tagged
                "t"
                [ Schema.variant
                    "Outer"
                    "outer"
                    (Schema.record
                        (Schema.fields
                            |> Schema.field "a" inner
                            |> Schema.field "b" (Schema.list self)
                        )
                        (Schema.mapping two unTwo)
                        (Schema.mapping two unTwo)
                    )
                    o
                    o
                ]
        )


-- Two schemas, one name.
twice : Schema (List Int) (List Int)
twice = Schema.list (Schema.recursive "Same" (\_ -> Schema.int))


twins : Schema { a : List Int, b : List Int } { a : List Int, b : List Int }
twins =
    Schema.record
        (Schema.fields
            |> Schema.field "a" twice
            |> Schema.field "b" (Schema.list (Schema.recursive "Same" (\_ -> Schema.int)))
        )
        (Schema.mapping two unTwo)
        (Schema.mapping two unTwo)


shape : Shape -> String
shape s =
    case s of
        Schema.Primitive k ->
            primitive k

        Schema.ListOf child ->
            "List (" ++ shape child ++ ")"

        Schema.NullableOf child ->
            "Nullable (" ++ shape child ++ ")"

        Schema.RecordOf fields ->
            "{ " ++ String.join (List.map fields field) ", " ++ " }"

        Schema.TaggedOf discriminator variants ->
            "tagged \""
                ++ discriminator
                ++ "\" [ "
                ++ String.join (List.map variants variant) " | "
                ++ " ]"

        Schema.Converted child ->
            "Converted (" ++ shape child ++ ")"

        Schema.Flipped child ->
            "Flipped (" ++ shape child ++ ")"

        Schema.TypeOnly child ->
            "TypeOnly (" ++ shape child ++ ")"

        Schema.EncodedOnly child ->
            "EncodedOnly (" ++ shape child ++ ")"

        Schema.Reference id ->
            "#" ++ String.fromInt id

        Schema.Invalid message ->
            "Invalid \"" ++ message ++ "\""


field : FieldShape -> String
field f =
    f.name
        ++ (if f.key == f.name then
               ""
            else
               " as \"" ++ f.key ++ "\""
           )
        ++ (if f.optional then
               " optional"
            else
               ""
           )
        ++ " : "
        ++ shape f.shape


variant : VariantShape -> String
variant v =
    v.name
        ++ " as \""
        ++ v.tag
        ++ "\""
        ++ (case v.payload of
               Just p ->
                   " " ++ shape p

               Nothing ->
                   ""
           )


primitive : Schema.PrimitiveKind -> String
primitive k =
    case k of
        Schema.StringKind ->
            "String"

        Schema.BoolKind ->
            "Bool"

        Schema.IntKind ->
            "Int"

        Schema.FloatKind ->
            "Float"

        Schema.FiniteFloatKind ->
            "FiniteFloat"

        Schema.NullKind ->
            "Null"

        Schema.ValueKind ->
            "Value"


definition : Definition -> String
definition d = "  #" ++ String.fromInt d.id ++ " " ++ d.name ++ " = " ++ shape d.shape


describe : Schema e a -> String
describe s =
    let
        d = Schema.describe s
    in
    String.join [ shape d.root, ...List.map d.definitions definition ] "\n"


main : Node.Program
main =
    Node.printLines
        [ describe flat
        , describe (Schema.flip flat)
        , describe (Schema.flip (Schema.flip flat))
        , describe (Schema.typeOnly flat)
        , describe (Schema.encodedOnly (Schema.list Schema.bool))
        , describe (Schema.nullable Schema.null)
        , describe Schema.value
        , describe shape2
        , describe outer
        , describe (Schema.list inner)
        , describe twins
        ]
