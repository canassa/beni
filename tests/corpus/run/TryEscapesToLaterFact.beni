-- A `?` whose variables escape its `let` is decided by a later fact of
-- the declaration they escape to, not defaulted at the `let` (the owner's
-- decision as amended, checker-v2.md §8.1, §8.6) — the dispatch-free half of
-- `TryDecidedByLaterFacts`, whose `h` compares with `==`.
-- In `f` the `?` is on `g`'s parameter, `g`'s result is `k`'s, and only
-- `Maybe.withDefault (k 5) 0`, after the `let`, says `Maybe`. In `h` the fact
-- after `m?` (`List.isEmpty [ m ]`) says nothing about the shape, and the
-- result `Just (…)` says `Maybe`. Expected `Just 2`, `Nothing`, `Just 2`, `6`.
--
-- Oracle twin: this file with `f : (Int -> Maybe Int) -> (
-- Maybe Int, Int )` and `h : Maybe Int -> Maybe Int` annotated prints exactly
-- the expected four lines. Committing both `?` to `Result` at once would
-- refuse the file with TYPE MISMATCH `Maybe a` against `Result b c`.
import Node exposing (Program)


h m =
    let
        v = m?
    in
    if List.isEmpty [ m ] then
        Nothing
    else
        Just (v + 1)


f k =
    let
        g u = k (u?)
    in
    ( g (Just 1), Maybe.withDefault (k 5) 0 )


main : Program
main =
    let
        ( first, second ) = f (λn -> Just (n + 1))
    in
    Node.printLines
        [ Debug.toString (h (Just 1))
        , Debug.toString (h Nothing)
        , Debug.toString first
        , String.fromInt second
        ]
