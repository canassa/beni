-- run: a root scope and `Task.running` (boundary.md §9.8.7;
-- transparent-effects-proposal.md §16.5, amended 2026-10-01).
--
--   - A fiber started in a root scope runs until it ends; `running` says
--     so before and not after.
--   - `closeRoot` cancels every fiber still running in the scope without
--     waiting: the release of its bracket runs when the fiber is resumed,
--     after `closeRoot` has returned.
--   - A fiber started in a closed root scope is cancelled before its first
--     line runs.
import Io
import Node exposing (Program)
import Task exposing (Cancelled, Done)


say : String -> ()
say line =
    Debug.log () line


main : Program
main =
    Io.run
        (\() ->
            let
                root =
                    Task.openRoot ()
                quick =
                    Task.spawnIn root (\() -> say "quick runs")
                _ =
                    Debug.log (Task.running quick) "quick running"
                _ =
                    Task.join quick
                _ =
                    Debug.log (Task.running quick) "quick running"
                slow =
                    Task.spawnIn
                        root
                        (\() ->
                            Task.bracket
                                (\() -> ())
                                (\_ exit ->
                                    case exit of
                                        Done _ ->
                                            say "slow done"
                                        Cancelled ->
                                            say "slow cancelled"
                                )
                                (\_ -> Io.sleep 100000)
                        )
                _ =
                    Task.yieldNow ()
                _ =
                    Task.closeRoot root
                _ =
                    say "closed"
                _ =
                    Task.wait slow
                late =
                    Task.spawnIn root (\() -> say "late runs")
                _ =
                    Debug.log (Task.wait late) "late ended"
            in
            Node.done
        )
