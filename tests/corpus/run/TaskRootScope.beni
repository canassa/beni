-- run: a root scope and `Task.running` (boundary.md §9.8.7;
-- transparent-effects-proposal.md §16.5, amended 2026-10-01).
--
--   - A fiber started in a root scope runs until it ends; `running` says
--     so before and not after.
--   - `closeRoot` cancels every fiber still running in the scope without
--     waiting: the release of its bracket runs when the fiber is resumed,
--     after `closeRoot` has returned.
--   - A fiber started in a closed root scope is cancelled before its first
--     line runs.
import Io
import Node exposing (Program)
import Task exposing (Cancelled, Done)


say : String → ⊤
say line = Debug.log line ⊤


main : Program
main = Io.run λ⊤ →
    root = Task.openRoot ⊤
    quick = Task.spawnIn root λ⊤ → say "quick runs"
    _ = Debug.log "quick running" (Task.running quick)
    Task.join quick
    _ = Debug.log "quick running" (Task.running quick)
    slow = Task.spawnIn root λ⊤ →
        Task.bracket
            (λ⊤ → ⊤)
            (λ_ exit →
                case exit of
                    Done _ →
                        say "slow done"
                    Cancelled →
                        say "slow cancelled"
            )
            λ_ → Io.sleep 100000
    Task.yieldNow ⊤
    Task.closeRoot root
    say "closed"
    _ = Task.wait slow
    late = Task.spawnIn root λ⊤ → say "late runs"
    _ = Debug.log "late ended" (Task.wait late)
    Node.done
