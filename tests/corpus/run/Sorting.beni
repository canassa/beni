-- There is no `comparable` (`fast-compiler.md` §3.1); the `compare` method
-- is what replaced it. `sort` orders anything that has one, `sortBy` takes
-- a key that has one — a `String` key as readily as a number — and
-- `sortWith` takes an ordering you write, for sorting by something that is
-- not the type's own order. `"a" < "b"` now works too.
import List
import Node exposing (Program)
import String


type alias Person =
    name : String
    age : Int


people : List Person
people = [ { name = "Bob", age = 7 }, { name = "Ada", age = 36 }, { name = "Cy", age = 21 } ]


names : List Person -> String
names ps = String.join (List.map ps (\p -> p.name)) ","


main : Program
main =
    Node.printLines
        [ String.join (List.map (List.sort [ 3, 1, 2 ]) String.fromInt) ","
        , names (List.sortBy people (\p -> p.age))
        , names (List.sortWith people (\a b -> String.compare a.name b.name))
        , names (List.sortWith people (\a b -> compare b.age a.age))
        , names (List.sortBy people (\p -> p.name))
        ]
