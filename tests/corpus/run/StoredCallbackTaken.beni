-- StoredCallbackTaken (Appendix B, S4): StoredCallbackResult's green twin.
-- Returning the taken item stays precise: the write of the item is accepted.
import List
import Node exposing (Program)
import String


ints : List Int → String
ints xs =
    sep = ","
    String.join (List.map xs String.fromInt) sep


show : List (List Int) → String
show xss = String.join (List.map xss ints) ";"


main : Program
main =
    r = List.update [ [ 0 ], [ 2 ] ] 0 λl → List.push l 9
    Node.print (show r)
