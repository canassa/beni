--! A test platform: worded rows with beni bodies that reach no JavaScript, whose words are true of their bodies.

import Dict exposing (Dict)
import Ref exposing (Ref)


--| `shallow`: the body reads the dictionary's storage alone.
pub sizeBody : borrowed shallow Dict Int (List Int) → Int
sizeBody d = Dict.size d


--| `returned`: the body answers its parameter.
pub same : returned List Int → List Int
same l = l


--| `fresh`: the body answers a new list, a copy of its parameter.
pub copied : borrowed List Int → fresh List Int
copied l = List.copy l


--| `escaped`: the body keeps the function in a cell.
pub keepFn : escaped (⊤ → Int) → Ref (⊤ → Int)
keepFn f = Ref.make f
