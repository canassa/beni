-- run: `Clock.adjust` lets what it wakes run as far as it can before it
-- wakes the next sleeper (transparent-effects-proposal.md §17.6, the
-- departure from Effect's one yield). `busy` wakes at 10 ms and yields
-- three times before it sleeps again, 15 ms; `late` wakes at 20 ms. All
-- three of `busy`'s steps print before `late` wakes, and `busy`'s second
-- sleep, due at 25 ms, is inside the same 30 ms `adjust`, so it wakes in
-- it too.
import Clock
import Duration
import Io
import Node exposing (Program)
import Task


main : Program
main = Io.run λ() →
    clock = Clock.virtual 0

    busy = Task.spawn λ() →
        Clock.run clock λ() →
            _ = Task.sleep (Duration.millis 10)
            _ = Debug.log "busy woke at" (Clock.now ())
            _ = Task.yieldNow ()
            _ = Debug.log "busy step" 1
            _ = Task.yieldNow ()
            _ = Debug.log "busy step" 2
            _ = Task.yieldNow ()
            _ = Debug.log "busy step" 3
            _ = Task.sleep (Duration.millis 15)
            Debug.log "busy woke again at" (Clock.now ())

    late = Task.spawn λ() →
        Clock.run clock λ() →
            _ = Task.sleep (Duration.millis 20)
            Debug.log "late woke at" (Clock.now ())
    _ = Clock.adjust clock (Duration.millis 30)
    _ = Debug.log "adjust returned at" (Clock.run clock Clock.now)
    _ = Task.joinAll [ busy, late ]
    Node.print "done"
