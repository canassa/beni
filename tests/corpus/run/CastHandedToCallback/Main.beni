-- A function that casts can hand the cast value on instead of answering it:
-- `feed x g = g (Js.to (Js.from x))` hands `[ x0 ]` to the callback, which reads
-- it as `List Int` (the list at an `Int` element) and casts the element back. The
-- cast marked only the answer, so nothing escaped; a callee that casts lets what
-- it hands its function parameters escape now (ownership-v3-kernel.md §3.4;
-- research report 151's review).
import Node exposing (Program)
import Pun


go : Int → String
go n =
    x0 = [ n ]
    z : List Int
    z = Pun.feed [ x0 ] λy → Pun.conv (Maybe.withDefault (List.head y) 0)
    x = List.length (List.push x0 9)
    "${String.fromInt x} ${String.fromInt (List.length z)}"


main : Program
main = Node.print (go 1)
