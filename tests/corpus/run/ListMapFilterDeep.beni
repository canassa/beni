-- run: fixing the callback order of `map`, `filter`, `filterMap` and
-- `partition` must not cost their stack safety. All four were made `foldl`
-- and then `reverse`, and are now cons steps (`[ func x, ...map rest func ]`);
-- either way the code generator turns them into a labelled loop
-- (`backend.md` §8, and its *Tail calls modulo cons*), so twenty thousand
-- cells, where a non-tail recursion over a list overflows Node's default
-- stack at about 8 000, go through each of them without touching the
-- JavaScript stack — the same guarantee `ListFoldDeep` pins for the folds
-- themselves.
import List
import Node exposing (Program)
import String


cells : List Int
cells = List.range 1 20000


main : Program
main =
    ( big, small ) = List.partition cells (λn -> n > 19000)
    Node.printLines
        [ String.fromInt (List.foldl (List.map cells (λn -> n * 2)) 0 (λx acc -> x + acc))
        , String.fromInt (List.length (List.filter cells (λn -> n > 19000)))
        , String.fromInt (List.length (List.filterMap cells (λn -> Just n)))
        , String.fromInt (List.length big + List.length small)
        ]
