-- The live twin of `LoanStoredLocal`'s `outlives`: the list built from the
-- loan is read through its element after the update, so the update may not
-- edit the contents in place (ownership-v3-kernel.md §13, #2584). `count`
-- reads only the built list's own array, which the update does not write.
import List
import Node exposing (Program)
import Ref exposing (Ref)
import String


returned : Ref (List Int) → List (List Int)
returned r =
    xs = Ref.get r
    List.push [] xs


outlivesLive : ⊤ → String
outlivesLive ⊤ =
    r = Ref.make [ 0 ]
    ys = returned r
    Ref.update r λxs → List.push xs 1
    String.fromInt (List.foldl ys 0 λl n → n + List.length l)


count : ⊤ → String
count ⊤ =
    r = Ref.make [ 0 ]
    ys = returned r
    Ref.update r λxs → List.push xs 1
    String.fromInt (List.length ys + List.length (Ref.get r))


main : Program
main = Node.printLines [ outlivesLive ⊤, count ⊤ ]
