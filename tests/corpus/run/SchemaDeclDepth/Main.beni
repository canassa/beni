-- The depth bound through a declaration's specialised code (`schema.md` §5,
-- G3; §6): a field, an element or a payload is one level, tested before the
-- descent, and one level past the bound is a `DepthExceeded` at the child it
-- stopped. A `Chain` link is a payload and a field, two levels, so n links
-- need depth 2n: at `maxDepth` 0, 1, 2, the default 512 and the ceiling, the
-- longest chain that fits is parsed and printed back, and one link more
-- fails where it stopped. At the ceiling the specialised workers recurse
-- inside Node's stack, as the library does. A `Value` inside a record is
-- printed within the bound left at its depth. The corpus also builds this
-- with every root through the library (§10).
import Node
import Schema
import Show


pub schema Chain tagged "t" of
    Link as "link"
        next : Chain
    End as "end"


pub schema Holder =
    held : Value
    rows : List (List Int)


text : Int → String
text n = String.repeat "{\"t\":\"link\",\"next\":" n ++ "{\"t\":\"end\"}" ++ String.repeat "}" n


typed : Int → Chain.Type
typed n = build n Chain.End


build : Int, Chain.Type → Chain.Type
build n acc =
    if n ≤ 0 then
        acc
    else
        build (n - 1) (Chain.Link { next = acc })


links : Chain.Type → Int
links c = count c 0


count : Chain.Type, Int → Int
count c n =
    case c of
        Chain.End →
            n

        Chain.Link r →
            count r.next (n + 1)


bound : Int → Schema.Options
bound d = { defaultOptions | maxDepth = d }


defaultOptions : Schema.Options
defaultOptions = Schema.defaultOptions


-- The path a failure names is n links long: shown by its length.
issues : Result (List Schema.Issue) a → String
issues r =
    case r of
        Ok _ →
            "Ok"

        Err found →
            String.join
                (List.map found λi →
                    Show.issue { i | path = [] }
                        ++ " at depth "
                        ++ String.fromInt (List.length i.path)
                )
                " | "


at : Int, Int → String
at d n =
    "maxDepth "
        ++ String.fromInt d
        ++ ", "
        ++ String.fromInt n
        ++ " links: "
        ++ Show.result (Chain.parseWith (bound d) (text n)) λc → String.fromInt (links c)
        ++ " / "
        ++ Show.result (Chain.printWith (bound d) (typed n)) λs → String.fromInt (String.length s)


over : Int, Int → String
over d n =
    "maxDepth "
        ++ String.fromInt d
        ++ ", "
        ++ String.fromInt n
        ++ " links: "
        ++ issues (Chain.parseWith (bound d) (text n))
        ++ " / "
        ++ issues (Chain.printWith (bound d) (typed n))


nested : Int → Schema.Value
nested n = Show.host (String.repeat "[" n ++ String.repeat "]" n)


main : Node.Program
main =
    Node.printLines
        [ at 0 0
        , over 0 1
        , at 1 0
        , over 1 1
        , at 2 1
        , over 2 2
        , at 512 256
        , over 512 257
        , at Schema.maxDepthCeiling (Schema.maxDepthCeiling // 2)
        , over Schema.maxDepthCeiling (Schema.maxDepthCeiling // 2 + 1)
        , "-- the default is 512"
        , Show.result (Chain.parse (text 256)) λc → String.fromInt (links c)
        , issues (Chain.parse (text 257))
        , "-- options"
        , issues (Chain.parseWith (bound (Schema.maxDepthCeiling + 1)) (text 0))
        , issues (Chain.printWith (bound (-1)) Chain.End)
        , "-- a Value and a list of lists, inside a record"
        , Show.result (Holder.printWith (bound 4) { held = nested 3, rows = [ [ 1 ] ] }) λs → s
        , issues (Holder.printWith (bound 4) { held = nested 5, rows = [] })
        , issues (Holder.parseWith (bound 2) "{\"held\":[[[[]]]],\"rows\":[[1]]}")
        , issues (Holder.printWith (bound 2) { held = nested 0, rows = [ [ 1 ] ] })
        ]
