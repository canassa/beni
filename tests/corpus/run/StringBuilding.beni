-- Strings are native JavaScript strings (`backend.md` §4); `++` is
-- `Basics.append` over two representations.
import Node exposing (Program)
import String


main : Program
main =
    Node.printLines
        [ "butter" ++ "fly"
        , String.join [ "a", "b", "c" ] ", "
        , String.repeat "ab" 3
        , String.reverse "stressed"
        , String.toUpper "skinner"
        , String.slice "snakes on a plane!" 7 9
        , String.slice "snakes on a plane!" 0 (0 - 7)
        , String.fromInt (String.length "innumerable")
        , String.trim "  hats \n"
        ]
