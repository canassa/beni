-- A family's `⟲` at a call's result is said at each fold above the result slot, as a regular type's is
-- (`ownership-v2.md` §2.1, #2195, *A family*): `SanitiserLevelResultLower` over `A0 (List Int)`, where
-- `A30` raises the level. The folds are on the family's one graph, and a copy read at the payload is
-- read whole there. Read from a path that was not the object's, `k` was edited while live.
import List
import Node exposing (Program)
import String


type A0 a
    = L0 a
    | A03 (A3 a)
    | A01 (A1 a)
    | E0


type A3 a
    = A32 (A2 a)
    | A30 (A0 (List a))


type A2 a
    = L2 a
    | A20 (A0 a)
    | A23 (A3 a)


type A1 a
    = A11 (A1 a)
    | A12 (A2 a)


wr : A0 (List Int) → Int
wr t =
    case t of
        A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 (A32 (L2 xs))))))))) →
            List.length (List.push xs 1)

        _ →
            0


hg : A0 a → A0 a
hg t0 =
    case t0 of
        A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 m))))))) →
            A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 m)))))))

        _ →
            E0


main : Program
main =
    k = [ 1 ]
    a = wr (hg (A03 (A32 (A20 (A01 (A11 (A11 (A12 (A23 (A32 (L2 k)))))))))))
    Node.print (String.fromInt (a + List.length k))
