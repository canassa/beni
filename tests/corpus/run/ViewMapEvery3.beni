-- run: a TEA-style `view`, 80 levels deep with 6 children a level and a
-- `List.map` lambda every 3 levels — the shape a UI is written in. Review of R2c, S1:
-- the lambdas' bodies nest inside the calls that hold them, so the emitter
-- binds the calls holding them to `const`s (`backend.md` §4) and it builds,
-- runs and loads in every browser, as it did before R2c.
import Node exposing (Program)


type Attr
    = Attr String String


type Html
    = Node String (List Attr) (List Html)
    | Text String


div : List Attr, List Html -> Html
div attrs kids =
    Node "div" attrs kids


text : String -> Html
text s =
    Text s


cls : String -> Attr
cls c =
    Attr "class" c


count : Html -> Int
count h =
    case h of
        Text _ ->
            1

        Node _ _ kids ->
            1 + List.sum (List.map kids count)


view : { items : List Int } -> Html
view model =
    div [ cls "c0", Attr "id" "x0" ]
        [ text "first0"
        , text "b0.0"
        , div
            []
            (List.map
                model.items
                (\it0 ->
                    div [ cls "c1", Attr "id" "x1" ]
                        [ text "first1"
                        , text "b1.0"
                        , div [ cls "n1" ]
                            [ div [ cls "c2", Attr "id" "x2" ]
                                [ text "first2"
                                , text "b2.0"
                                , div [ cls "n2" ]
                                    [ div [ cls "c3", Attr "id" "x3" ]
                                        [ text "first3"
                                        , text "b3.0"
                                        , div
                                            []
