-- A function of a type variable that answers what it is handed as a
-- record: `toR`'s answer's slot `.a=` holds the cells of its parameter's
-- one location. The caller hands it a tuple, whose cells are its list's,
-- and the tuple's object, which the update writes, is no cell of it, so
-- the slot holds `outside` (ownership-v3-kernel.md §3.4) and v3 refuses the
-- update. It wrote the list's cell alone before, and in place `t`'s number
-- read 5.
import Node exposing (Program)
import Pun


type alias R =
    a : Int
    b : List Int


toR : a → R
toR x = Pun.conv x


go : Int → String
go n =
    t = ( n, [ 1 ] )
    p = toR t
    p2 = { p | a = 5 }
    case t of
        ( m, _ ) →
            "${String.fromInt p2.a} ${String.fromInt m}"


main : Program
main = Node.print (go 0)
