-- A callback a callee hands back, where an edit in place would change a list
-- something else still reads (`ownership-v2.md` §2.11.3, §2.11.4): `ident`'s writer called twice on one list, a
-- capture writer called twice, folds over a composition that keeps the accumulator in a cell, keeps the list it is
-- handed or answers a capture, a writer applied to a capture (or to a label's answer that is one) of a code run
-- twice (`two λ⊤ → f y`, which trapped on master), and a capture writer a callee runs once and hands back (itself, in
-- a record or a `Just`, through `ident`) that the caller runs again or hands to a callee that runs it. Each is
-- refused; were it accepted, the sanitised run would read the list a later call had pushed onto in place
-- (#2395, #2410).
import Node exposing (Program)
import Ref
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


shows : List (List Int) → String
shows ls = String.join (List.map ls show) ";"


ident : a → a
ident f = f


comp : (x, a → b), (x, b → c) → (x, a → c)
comp f g = λx a → g x (f x a)


comp2 : (x, a → b), (a, b → c) → (x, a → c)
comp2 f g = λx a → g a (f x a)


twice : Int → String
twice n =
    f = ident λl → List.push l 1
    xs = [ n ]
    p = f xs
    q = f xs
    "${show p} ${show q}"


captureTwice : Int → String
captureTwice n =
    k = [ n ]
    f = ident λ⊤ → List.push k 1
    a = f ⊤
    b = f ⊤
    "${show a} ${show b}"


keptInCell : Int → String
keptInCell n =
    r = Ref.make []
    acc =
        List.foldl
            [ 1, 2 ]
            [ [ n ] ]
            (comp (λx a → List.push a [ x ]) λ_ v →
                Ref.set r v
                v
            )
    "${shows acc} ${shows (Ref.get r)}"


keptBeside : Int → String
keptBeside n =
    r = Ref.make []
    acc =
        List.foldl
            [ 1, 2 ]
            [ [ n ] ]
            (comp2 (λx a → List.push a [ x ]) λa v →
                Ref.set r a
                v
            )
    "${shows acc} ${shows (Ref.get r)}"


answersCapture : Int → String
answersCapture n =
    k = [ 9 ]
    acc = List.foldl [ 1, 2 ] [ n ] (comp (λx a → List.push a x) λ_ v → k)
    "${show acc} ${show k}"


two : (⊤ → a) → a × a
two h = ( h ⊤, h ⊤ )


later : List Int, (List Int → List Int) → (⊤ → List Int)
later y g = λ⊤ → g y


push1 : List Int → List Int
push1 l = List.push l 1


capturedTwice : Int → String
capturedTwice n =
    y = [ n ]
    f = push1
    ( a, b ) = two λ⊤ → f y
    "${show a} ${show b}"


laterTwice : Int → String
laterTwice n =
    ( a, b ) = two (later [ n ] push1)
    "${show a} ${show b}"


thunkOf : (⊤ → List Int), (List Int → List Int) → (⊤ → List Int)
thunkOf y g = λ⊤ → g (y ⊤)


answeredTwice : Int → String
answeredTwice n =
    y = [ n ]
    g = λ⊤ → y
    f = push1
    ( a, b ) = two λ⊤ → f (g ⊤)
    "${show a} ${show b}"


thunkTwice : Int → String
thunkTwice n =
    l = [ n ]
    ( a, b ) = two (thunkOf (λ⊤ → l) push1)
    "${show a} ${show b}"


runBack : (⊤ → List Int) → (⊤ → List Int)
runBack f =
    _ = f ⊤
    f


runBackIn : (⊤ → List Int) → { run : ⊤ → List Int }
runBackIn f =
    _ = f ⊤
    { run = f }


runBackJust : (⊤ → List Int) → Maybe (⊤ → List Int)
runBackJust f =
    _ = f ⊤
    Just f


apply : (⊤ → List Int) → List Int
apply f = f ⊤


ranBack : Int → String
ranBack n =
    k = [ n ]
    g = runBack λ⊤ → List.push k 1
    show (g ⊤)


ranBackField : Int → String
ranBackField n =
    k = [ n ]
    r = runBackIn λ⊤ → List.push k 1
    g = r.run
    show (g ⊤)


ranBackIdent : Int → String
ranBackIdent n =
    k = [ n ]
    g = ident (runBack λ⊤ → List.push k 1)
    show (g ⊤)


ranBackJust : Int → String
ranBackJust n =
    k = [ n ]
    case runBackJust λ⊤ → List.push k 1 of
        Just g →
            show (g ⊤)

        Nothing →
            ""


ranBackApplied : Int → String
ranBackApplied n =
    k = [ n ]
    p = λl → List.push l 1
    g = runBack λ⊤ → p k
    show (apply g)


ranBackAgain : Int → String
ranBackAgain n =
    k = [ n ]
    p = λl → List.push l 1
    g = ident λ⊤ → p k
    show (apply (runBack g))


main : Program
main =
    Node.print
        "${twice 0} ${captureTwice 0} ${keptInCell 0} ${keptBeside 0} ${answersCapture 0} ${capturedTwice 0} ${laterTwice 0} ${answeredTwice 0} ${thunkTwice 0} ${ranBack 0} ${ranBackField 0} ${ranBackIdent 0} ${ranBackJust 0} ${ranBackApplied 0} ${ranBackAgain 0}"
