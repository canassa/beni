-- run: `Task.forEach` answers in list order whatever order the calls end
-- in (transparent-effects-proposal.md §17.7; report 23 row 27). On a
-- virtual clock the calls sleep 30, 10 and 20 ms, all at once, and end
-- 10, 20, 30; the answer is still in list order. An empty list answers
-- `[]` and starts nothing.
import Clock
import Duration
import Io
import Node exposing (Program)
import Task


main : Program
main = Io.run λ⊤ →
    clock = Clock.virtual 0

    caller = Task.spawn λ⊤ →
        Clock.run clock λ⊤ →
            Task.forEach [ 30, 10, 20 ] 3 λms →
                Task.sleep (Duration.millis ms)
                Debug.log "ended" ms
    Clock.adjust clock (Duration.millis 100)
    _ = Debug.log "answer" (Task.join caller)
    Node.print (Debug.toString (Task.forEach [] 3 λn → Debug.log "never" n))
