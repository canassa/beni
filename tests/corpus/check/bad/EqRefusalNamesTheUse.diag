[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":21,"col":5},"end":{"line":21,"col":6}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`, which `h` requires:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":26,"col":16},"end":{"line":26,"col":17}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    F\n\nThat type does not support `Basics.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":31,"col":17},"end":{"line":31,"col":18}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.neq`:\n\n    F\n\nThat type does not support `Basics.neq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":40,"col":5},"end":{"line":40,"col":9}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":49,"col":5},"end":{"line":49,"col":16}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    F\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
