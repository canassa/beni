[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":20,"col":12},"end":{"line":20,"col":13}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`, which `h` requires:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":24,"col":13},"end":{"line":24,"col":22}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    F\n\nThat type does not support `Basics.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":28,"col":16},"end":{"line":28,"col":26}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.neq`:\n\n    F\n\nThat type does not support `Basics.neq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":35,"col":11},"end":{"line":35,"col":15}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqRefusalNamesTheUse.beni","start":{"line":42,"col":18},"end":{"line":42,"col":29}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    F\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
