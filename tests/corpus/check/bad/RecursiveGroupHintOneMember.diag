[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RecursiveGroupHintOneMember.beni","start":{"line":33,"col":24},"end":{"line":33,"col":25}},"title":"TYPE MISMATCH","message":"The 1st argument to `hh` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `hh` needs the 1st argument to be:\n\n    number\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To join text use `++`.\n\nHint: this comes from `mb`, which is in a recursive group with `ma`, `mc`, so\nits type is not known here yet. Annotate `mb` and each use can instantiate it.\n"}]
