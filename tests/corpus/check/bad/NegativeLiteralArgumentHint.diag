[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/NegativeLiteralArgumentHint.beni","start":{"line":12,"col":5},"end":{"line":12,"col":8}},"title":"TYPE MISMATCH","message":"The 1st argument to (-) is not what I expect:\n\nThis argument is:\n\n    Int -> Int\n\nBut (-) needs the 1st argument to be:\n\n    Int\n\nHint: `dec -1` is a subtraction, `dec - 1`. To pass a negative number as\nan argument, put it in parentheses: `dec (-1)`.\n"}]
