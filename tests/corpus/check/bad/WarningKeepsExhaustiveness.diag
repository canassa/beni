[{"code":"ambiguous_method_receiver","severity":"warning","span":{"file":"tests/corpus/check/bad/WarningKeepsExhaustiveness.beni","start":{"line":22,"col":5},"end":{"line":22,"col":9}},"title":"CONSTRAINT IN AN INFERRED INTERFACE","message":"`pick` is `pub`, has no annotation, and its inferred type carries 1 method\nconstraint(s):\n\n    a, a, Colour → String where a.eq : a, a → Bool\n\nEditing the body can change this, and changing it re-checks every importer.\n\nHint: an annotation pins it.\n"},{"code":"missing_patterns","severity":"error","span":{"file":"tests/corpus/check/bad/WarningKeepsExhaustiveness.beni","start":{"line":24,"col":9},"end":{"line":24,"col":13}},"title":"MISSING PATTERNS","message":"This `case` does not have branches for all possibilities:\n\nMissing possibilities include:\n\n    Blue\n\nI would have to crash if I saw one of those. Add branches for them!\n\nHint: if you want to write a branch's code later, `Debug.todo \"…\"` holds the\nplace and has whatever type the branch needs.\n"},{"code":"ambiguous_method_receiver","severity":"warning","span":{"file":"tests/corpus/check/bad/WarningKeepsExhaustiveness.beni","start":{"line":34,"col":5},"end":{"line":34,"col":9}},"title":"CONSTRAINT IN AN INFERRED INTERFACE","message":"`size` is `pub`, has no annotation, and its inferred type carries 1 method\nconstraint(s):\n\n    a, a, Shape → Int where a.eq : a, a → Bool\n\nEditing the body can change this, and changing it re-checks every importer.\n\nHint: an annotation pins it.\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/WarningKeepsExhaustiveness.beni","start":{"line":34,"col":15},"end":{"line":34,"col":21}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Square _\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n →\n                n\n\n            Nothing →\n                0\n"}]
