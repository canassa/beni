-- CK-72: (the twin) `RecursiveGroupReceiverNeedsAnnotation.beni` with `g`
-- written first (round 3's `sccB`): the same single `kind_mismatch` at
-- `q "s"`, with the hint to annotate `g`, whatever the order. On 7427828
-- `check` exits 0, and `build` stops with INTERNAL ERROR "The hidden
-- arguments of this call do not add up".


type Box a
    = Box a


pub combine (Box a) z =
    Box a


g n =
    if n > 100 then
        Box n

    else
        let
            _ =
                f (n + 1)
        in
        Box n


f n =
    let
        r =
            g n

        q z =
            r.combine z
    in
    ( q 1, q "s" )
