[{"code":"too_many_inferred_constraints","severity":"error","span":{"file":"tests/corpus/check/bad/TooManyInferredConstraints.beni","start":{"line":11,"col":5},"end":{"line":11,"col":9}},"title":"TOO MANY INFERRED CONSTRAINTS","message":"`wide` has no annotation, and the type I inferred for it needs 65 methods.\nI stop at 64.\n\nThe first 5 are `m01`, `m02`, `m03`, `m04` and `m05`.\n\nEach one is an argument I have to pass at every call to `wide`, and a line in\nthis module's interface that every importer is checked against. A list this\nlong is almost always a chain of unannotated helpers, each one inheriting\nwhat the one before it needed.\n\nHint: annotate `wide`. An annotation pins the type, and a `where` clause you\nwrite yourself may name as many methods as you like.\n"}]
