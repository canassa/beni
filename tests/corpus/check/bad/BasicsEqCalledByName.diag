[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/BasicsEqCalledByName.beni","start":{"line":7,"col":17},"end":{"line":7,"col":20}},"title":"TYPE MISMATCH","message":"The 2nd argument to `eq` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `eq` needs the 2nd argument to be:\n\n    number\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: to read a number out of text, use `String.toInt` or `String.toFloat`.\n"}]
