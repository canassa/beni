-- Explicit `Basics.eq` on a `type` that wraps a schema endpoint
-- whose `via` target holds a function is `not_equatable` (checker-v2.md
-- §11.4): the structural gate of a
-- `type` is "no function reachable from its payloads", through its
-- module's endpoints and their `via` targets — the same fact `==` reads
-- off the derived contexts. It is not the table-build bit ("no function
-- in its declaration"), which cannot see a `via` target and would refuse
-- `==` on `Holds` while accepting `Basics.eq` on it: two answers to one
-- question.
--
-- (2026-10-02: `Basics.eq` and `Basics.neq` ask for `eq` through a
-- `where` clause, as `==` does — static-dispatch-spike.md §3.1, amended —
-- and no longer through the `equatable` marker. The refusal stands; it is
-- reached the way a `where` clause's is.)
import Schema exposing (Conversion)


conv : Conversion Int Mine
conv = Debug.todo "checker-only conversion"


type Mine
    = Mine (Int → Int)


pub schema Loop tagged "kind" of
    Step as "step"
        payload : Int via conv


type Holds
    = Holds Loop.Type


mk : Int → Holds
mk n = Debug.todo "h"


viaEq : Bool
viaEq = mk 1 == mk 2


viaBasics : Bool
viaBasics = Basics.eq (mk 1) (mk 2)
