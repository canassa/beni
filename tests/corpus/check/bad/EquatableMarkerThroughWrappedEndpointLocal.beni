-- CK-120: explicit `Basics.eq` on a `type` that wraps a schema endpoint
-- whose `via` target holds a function is `not_equatable` (checker-v2.md
-- §11.4 *as amended by R8b's review round*): the structural gate of a
-- `type` is "no function reachable from its payloads", through its
-- module's endpoints and their `via` targets — the same fact `==` reads
-- off the derived contexts. On 7427828, and in v2 before R8b's review
-- round, the gate was the table-build bit ("no function in its
-- declaration"), which cannot see a `via` target: `==` on `Holds` was
-- refused and `Basics.eq` on it accepted, two answers to one question.
import Schema exposing (Conversion)


conv : Conversion Int Mine
conv =
    Debug.todo "checker-only conversion"


type Mine
    = Mine (Int -> Int)


pub schema Loop tagged "kind" of
    Step as "step"
        payload : Int via conv


type Holds
    = Holds Loop.Type


mk : Int -> Holds
mk n =
    Debug.todo "h"


viaEq : Bool
viaEq =
    mk 1 == mk 2


viaBasics : Bool
viaBasics =
    Basics.eq (mk 1) (mk 2)
