[{"code":"unknown_method","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallCompareDerivedUnannotated.beni","start":{"line":24,"col":5},"end":{"line":24,"col":11}},"title":"UNKNOWN METHOD","message":"`Colour` has no method called `compare`.\n\nI resolve `x.compare` in the module that declares `x`'s type. That module is\n`DotCallCompareDerivedUnannotated`, and it has no `pub` value called `compare`.\n\nI can write a `compare` for a type that declares none, but only for `<`, `>`,\n`<=` and `>=`, and for a `where` clause, which ask for it by name. A dot-call\n`x.compare` means the module's own `pub` value, so it never gets a derived one.\n\nHint: `before` calls `x.compare` and has no annotation. Write `x < y` there\ninstead, or give `before` an annotation that asks for it:\n`where a.compare : a, a -> Order`.\n"}]
