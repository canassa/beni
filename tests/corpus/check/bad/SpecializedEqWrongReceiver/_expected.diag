[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":28,"col":9},"end":{"line":28,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Wrapper\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at a type\nthat `Holder.eq` does not have.\n\nHint: give `Holder.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":33,"col":9},"end":{"line":33,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Before\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at a type\nthat `Holder.eq` does not have.\n\nHint: give `Holder.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":38,"col":9},"end":{"line":38,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    After\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at a type\nthat `Holder.eq` does not have.\n\nHint: give `Holder.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":43,"col":10},"end":{"line":43,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Generic String\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":48,"col":10},"end":{"line":48,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    { value : Holder String }\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at this type:\n\n    Holder String, Holder String -> Bool\n\nbut `Holder.eq` is:\n\n    Holder Int, Holder Int -> Bool\n\nHint: give `Holder.eq` that type, or compare the values another way.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":53,"col":10},"end":{"line":53,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    ( Holder String, Int )\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at this type:\n\n    Holder String, Holder String -> Bool\n\nbut `Holder.eq` is:\n\n    Holder Int, Holder Int -> Bool\n\nHint: give `Holder.eq` that type, or compare the values another way.\n"}]
