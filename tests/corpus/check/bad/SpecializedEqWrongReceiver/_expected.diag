[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":27,"col":9},"end":{"line":27,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Wrapper\n\n`Wrapper` gets its `==` from what it holds, and its `Wrapper` holds:\n\n    Holder String\n\nComparing that needs the `eq` of `Holder` at a type that `Holder.eq` does not\nhave.\n\nHint: give `Holder.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":32,"col":9},"end":{"line":32,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Before\n\n`Before` gets its `==` from what it holds, and its `Before` holds:\n\n    Wrapper\n\nComparing that needs the `eq` of `Holder` at a type that `Holder.eq` does not\nhave.\n\nHint: give `Holder.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":37,"col":9},"end":{"line":37,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    After\n\n`After` gets its `==` from what it holds, and its `After` holds:\n\n    Wrapper\n\nComparing that needs the `eq` of `Holder` at a type that `Holder.eq` does not\nhave.\n\nHint: give `Holder.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":41,"col":30},"end":{"line":41,"col":32}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Generic String\n\n`Generic` gets its `==` from what it holds, and it holds a `Holder`, whose `eq`\nis `Holder.eq`, for one type of `Holder` only. So `Generic` has `==` only as:\n\n    Generic Int\n\nHint: use it at that type, or give `Holder.eq` a type that works for every\n`Holder`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":45,"col":29},"end":{"line":45,"col":31}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    { value : Holder String }\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at this type:\n\n    Holder String, Holder String → Bool\n\nbut `Holder.eq` is:\n\n    Holder Int, Holder Int → Bool\n\nHint: give `Holder.eq` that type, or compare the values another way.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SpecializedEqWrongReceiver/Main.beni","start":{"line":49,"col":28},"end":{"line":49,"col":30}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Holder String × Int\n\nIt holds a `Holder`, and comparing that needs the `eq` of `Holder` at this type:\n\n    Holder String, Holder String → Bool\n\nbut `Holder.eq` is:\n\n    Holder Int, Holder Int → Bool\n\nHint: give `Holder.eq` that type, or compare the values another way.\n"}]
