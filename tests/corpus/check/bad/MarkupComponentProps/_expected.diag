[{"code":"spread_not_first","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupComponentProps/Main.beni","start":{"line":11,"col":25},"end":{"line":11,"col":29}},"title":"SPREAD NOT FIRST","message":"This spread is not the first attribute of `<Card>`.\n\nA component's spread is the record its other attributes update, so it comes\nfirst and there is one: `<Card {...defaults} title=\"x\" />`. Move it to the\nfront."},{"code":"spread_not_first","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupComponentProps/Main.beni","start":{"line":12,"col":28},"end":{"line":12,"col":32}},"title":"SPREAD NOT FIRST","message":"This spread is not the first attribute of `<Card>`.\n\nA component's spread is the record its other attributes update, so it comes\nfirst and there is one: `<Card {...defaults} title=\"x\" />`. Move it to the\nfront."},{"code":"duplicate_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupComponentProps/Main.beni","start":{"line":13,"col":15},"end":{"line":13,"col":23}},"title":"DUPLICATE ATTRIBUTE","message":"`<Card>` is given `children` twice: as an attribute here, and between its tags.\n\nWhat is written between the tags IS the `children` field, so the second would\nsilently win. Keep one of the two."}]
