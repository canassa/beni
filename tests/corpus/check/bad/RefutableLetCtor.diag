[{"code":"refutable_let_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableLetCtor.beni","start":{"line":13,"col":5},"end":{"line":13,"col":9}},"title":"REFUTABLE PATTERN","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Nothing\n\nA `let` pattern has to match whatever it is given, so there is nowhere for those\nto go and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_let_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableLetCtor.beni","start":{"line":19,"col":15},"end":{"line":19,"col":16}},"title":"REFUTABLE PATTERN","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    ( Nothing, _ )\n\nA `let` pattern has to match whatever it is given, so there is nowhere for those\nto go and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"}]
