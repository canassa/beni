[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ListElementFromContext.beni","start":{"line":9,"col":8},"end":{"line":9,"col":9}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    number\n\nBut this list needs its elements to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: want to turn a number into a `String`? Use `String.fromInt` or\n`String.fromFloat`.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ListElementFromContext.beni","start":{"line":17,"col":16},"end":{"line":17,"col":17}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    number\n\nBut this list needs its elements to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: want to turn a number into a `String`? Use `String.fromInt` or\n`String.fromFloat`.\n"}]
