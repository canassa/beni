-- A `where` clause that disagrees with the receiver's own method
-- names both: "The `where a.compare` clause of `f` does not match the
-- `compare` of `Int`", then the clause's type and the method's, reported at
-- the call, with the roles the right way round (static-dispatch-spike.md
-- §10.13; the `.where_clause` category) — not "Something is off
-- here: This is: `Int, Int -> Int` But I need: `Int, Int -> Order`", naming
-- neither the clause nor the method.


f : a, a -> Int
    where a.compare : a, a -> Int
f x y =
    x.compare y + 1


n : Int
n =
    1


use : Int
use =
    f n n
