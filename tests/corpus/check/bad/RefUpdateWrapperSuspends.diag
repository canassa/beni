[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/RefUpdateWrapperSuspends.beni","start":{"line":20,"col":27},"end":{"line":20,"col":28}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `adjust` hands it on to a function that calls it\nsynchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
