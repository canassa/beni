-- `Holder.eq` is specialised to `Holder Int`, so `L`, which holds a
-- `Holder String`, has no equality. The `==` sits in an unannotated `pub
-- compare`, which is not checked ahead of the rest as a priority group:
-- the `==` asks `L`'s derived context (checker-v2.md §11.2): `not_equatable`
-- here, never a comparison accepted early.
import Holder


pub type L
    = L (Holder.Holder String)


pub type K
    = K Int


pub compare left right =
    let
        same =
            L (Holder.Holder "a" identity) == L (Holder.Holder "b" identity)
    in
    case left of
        K a ->
            case right of
                K b ->
                    if same then
                        EQ
                    else
                        Basics.compare a b


identity : Int -> Int
identity v =
    v
