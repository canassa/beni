[{"code":"try_shape","severity":"error","span":{"file":"tests/corpus/check/bad/TryShape.beni","start":{"line":4,"col":10},"end":{"line":4,"col":11}},"title":"BAD QUESTION MARK","message":"`?` needs a `Result` or a `Maybe`, and this is neither:\n\n    Int\n\nThe enclosing definition returns:\n\n    Result String Int\n\nHint: `e?` unwraps an `Ok`/`Just` and returns the `Err`/`Nothing` from the\nenclosing definition, so both have to be the same shape. There is no\nconversion between `Result` and `Maybe`.\n"}]
