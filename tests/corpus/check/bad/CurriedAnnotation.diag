[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CurriedAnnotation.beni","start":{"line":9,"col":13},"end":{"line":9,"col":14}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    a, b -> c\n\nBut the type annotation says it should be:\n\n    Int -> Int -> Int\n\nHint: this annotation is in Elm's curried form. A beni function takes all\nof its arguments at once, and its type lists them before one arrow:\n\n    Int, Int -> Int\n"}]
