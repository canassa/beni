[{"code":"cyclic_value","severity":"error","span":{"file":"tests/corpus/check/bad/CyclicValueThroughMethod.beni","start":{"line":16,"col":1},"end":{"line":16,"col":7}},"title":"VALUE DEFINED IN TERMS OF ITSELF","message":"`bumped` is defined in terms of itself:\n\n    bumped → bump → bumped\n\nA top-level value is computed once, when the module is loaded, so there is no\norder in which I can compute these: each of them is already needed before it\nhas a value.\n\nNaming `bump` counts as calling it, so whatever its body reads is read\nwhile `bumped` is being computed.\n\nHint: a FUNCTION may be recursive, because its body runs when it is called and\nnot when the module loads. Give one of these a parameter, or compute it from\nsomething outside the circle.\n"}]
