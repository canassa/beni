-- A receiver made cyclic by `( y, y ) == y` must be caught by the
-- occurs check before method resolution walks it (checker-v2.md §8.2, §9.5):
-- `infinite_type`, once per form, and the checker stops. A resolver that
-- recursed `targetFor → fillPart → derivedUse` on the cyclic graph
-- would never finish. Where each is reported is open (see the
-- `.codes`).

f : Int -> Int
f z =
    let
        k y = ( y, y ) == y
    in
    z


g : Int -> Int
g z =
    case (\y -> ( y, y ) == y) of
        _ ->
            z
