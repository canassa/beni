[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CallStyleUnitMethodCall.beni","start":{"line":5,"col":14},"end":{"line":5,"col":21}},"title":"TYPE MISMATCH","message":"`List.length` is not the method this call needs:\n\n    List a → Int\n\nbut the call wants:\n\n    List Int, b → Int\n\nA method of `List` is a `pub` value of the module that declares it, so\n`List.length` is the `length` of `List`, and it has to have the type the call\nwants.\n\nHint: give `length` that type, or rename it if it is not meant to be a method\nof `List`.\n\nHint: this nullary method needs no extra argument. Write `xs.length`.\n"}]
