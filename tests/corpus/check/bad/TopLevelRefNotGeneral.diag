[{"code":"impure_polymorphic_value","severity":"error","span":{"file":"tests/corpus/check/bad/TopLevelRefNotGeneral.beni","start":{"line":9,"col":1},"end":{"line":9,"col":6}},"title":"IMPURE POLYMORPHIC VALUE","message":"`cells` is computed by an impure call, once, when its module is loaded, but its\ntype is not one type:\n\n    cells : Ref (List a)\n\nIt leaves `a` open. An impure call can make something that holds values, such\nas a new `Ref`, and one such thing cannot hold every type: written as one type\nand read as another, it would give a wrong answer.\n\nHint: annotate `cells` with the one type it holds, or give it a parameter so\nthat each call makes a new one.\n"}]
