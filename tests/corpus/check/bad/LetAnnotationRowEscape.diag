[{"code":"rigid_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetAnnotationRowEscape.beni","start":{"line":10,"col":11},"end":{"line":10,"col":12}},"title":"TYPE MISMATCH","message":"The type annotation of `g` promises more than its body keeps:\n\n    g : { r | x : Int } -> { r | x : Int }\n\nThe annotation says `r` can be ANY type, but the body ties `r` to a type that\ncomes from `coerce`, the definition `g` is written inside. That type is fixed\nfor each call of `coerce`, so `g` does not work for every `r`.\n\nHint: write the enclosing definition's type in the annotation instead of `r`,\nor remove the annotation and let the type be inferred.\n"}]
