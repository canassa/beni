[{"code":"missing_where_constraint","severity":"error","span":{"file":"tests/corpus/check/bad/MissingWhereConstraint.beni","start":{"line":6,"col":19},"end":{"line":6,"col":25}},"title":"MISSING CONSTRAINT","message":"I need `a.scale` here, and the annotation does not allow it.\n\nThis call needs `a` to have a method `scale`:\n\n    scale : a, b -> a\n\nbut the annotation says `a` is any type at all.\n\nHint: add it to the annotation:\n\n    where a.scale : a, b -> a\n"}]
