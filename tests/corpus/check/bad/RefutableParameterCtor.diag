[{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterCtor.beni","start":{"line":21,"col":5},"end":{"line":21,"col":9}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Nothing\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterCtor.beni","start":{"line":26,"col":7},"end":{"line":26,"col":13}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Square _\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterCtor.beni","start":{"line":31,"col":9},"end":{"line":31,"col":16}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Just _\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterCtor.beni","start":{"line":36,"col":9},"end":{"line":36,"col":13}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Pair Nothing _\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterCtor.beni","start":{"line":41,"col":19},"end":{"line":41,"col":20}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    ( Nothing, _ )\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"}]
