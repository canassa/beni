[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SiblingTypeCompareResolution/Main.beni","start":{"line":15,"col":12},"end":{"line":15,"col":13}},"title":"TYPE MISMATCH","message":"`Two.compare` is not the method this call needs:\n\n    A, A -> Order\n\nbut the call wants:\n\n    B, B -> Order\n\nA method of `B` is a `pub` value of the module that declares it, which is\n`Two`, and a module's `pub` values are ONE namespace — so `compare` is the\nmethod of every type `Two` declares.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
