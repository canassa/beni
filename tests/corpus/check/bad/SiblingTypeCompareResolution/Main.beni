-- The `compare` and all-nullary variant: `<` on `Two.B` must not
-- reuse `Two.A`'s resolution of `compare`. By the module rule `Two`'s one
-- `pub compare : A, A -> Order` is `B`'s too, so `B1 < B2` is the
-- module-rule clash. A resolution at `A` in `f` memoised per (module,
-- value, method) without the receiver's type would make `g`'s
-- comparison call A's reversed `compare` on two `B`s.
import Two


f : Two.A -> Bool
f a =
    a < a


g : Bool
g =
    Two.B1 < Two.B2
