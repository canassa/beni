[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/KindMismatch.beni","start":{"line":5,"col":12},"end":{"line":5,"col":13}},"title":"TYPE MISMATCH","message":"The 2nd argument to (++) is not what I expect:\n\nThis argument is:\n\n    number\n\nBut (++) needs the 2nd argument to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*`, `<`, `>`, `<=` and `>=` work on numbers only. To join\ntext use `++`, and to order it use `String.compare`.\n"}]
