-- A wrong own-method signature is one mistake. `pub eq : T, Int ->
-- Bool` is not `T, T -> Bool`, and both `==` below need `eq`. The TYPE
-- MISMATCH ("`Main.eq` is not the method this call needs") must not be
-- reported once per use, n identical messages for n uses.
-- Expected: one, said at the method's
-- declaration, against the use-independent `T, T -> Bool`.
type T
    = T Int


pub eq : T, Int -> Bool
eq (T a) b =
    a == b


one =
    T 1 == T 1


two =
    T 2 == T 2
