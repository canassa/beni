[{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/CyclicReceiverResolution.beni","start":{"line":10,"col":20},"end":{"line":10,"col":22}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type here:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = a × a\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"},{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/CyclicReceiverResolution.beni","start":{"line":16,"col":25},"end":{"line":16,"col":27}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type here:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = a × a\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"}]
