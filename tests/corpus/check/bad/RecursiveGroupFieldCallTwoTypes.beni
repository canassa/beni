-- CK-105: a field call on a parameter another member of the recursive group
-- types (`x.f z`, `x` typed by `mb`'s in-flight call) is the field call in
-- every order (static-dispatch-spike.md §11 *Deferred receiver*, amended
-- 2026-09-26), and inside the group `x` is monomorphic: `h 1` and `h "s"`
-- cannot both hold. One `kind_mismatch` at `h "s"`, byte-identical in every
-- declaration order (`scenario/PERM`); before the amendment the orders
-- disagreed on the code (R7's adversarial review, F5's `T104`).
type K
    = K Int


pub ma (K n) x =
    let
        _ =
            (K n).mb 0
    in
    let
        h z =
            x.f z

        ( r1, _ ) =
            ( h 1, h "s" )
    in
    r1


pub mb (K n) y =
    if n > 0 then
        y

    else
        let
            _ =
                (K 1).ma { f = \z -> z }
        in
        y
