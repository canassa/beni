[{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/CompareOnTypeHoldingFunction.beni","start":{"line":14,"col":16},"end":{"line":14,"col":17}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    Handler\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/CompareOnTypeHoldingFunction.beni","start":{"line":18,"col":14},"end":{"line":18,"col":16}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Handler\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
