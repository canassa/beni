[{"code":"name_removed","severity":"error","span":{"file":"tests/corpus/check/bad/NameRemovedUnqualified.beni","start":{"line":6,"col":10},"end":{"line":6,"col":15}},"title":"REMOVED NAME","message":"`modBy` was removed: beni's `modBy n 2` read as Elm's `modBy 2 n`. Write\n`Int.mod n 2`, the arguments in the order they had. `Int` is a prelude\nmodule, so it needs no import.\n\n`beni fmt --migrate-names <file>` rewrites every use in a file."},{"code":"name_removed","severity":"error","span":{"file":"tests/corpus/check/bad/NameRemovedUnqualified.beni","start":{"line":10,"col":11},"end":{"line":10,"col":18}},"title":"REMOVED NAME","message":"`logBase` was removed: beni's `logBase x 10` read as Elm's `logBase 10 x`. Write\n`Float.log x 10`, the arguments in the order they had. `Float` is a prelude\nmodule, so it needs no import.\n\n`beni fmt --migrate-names <file>` rewrites every use in a file."}]
