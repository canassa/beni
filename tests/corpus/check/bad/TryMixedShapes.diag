[{"code":"try_shape","severity":"error","span":{"file":"tests/corpus/check/bad/TryMixedShapes.beni","start":{"line":5,"col":21},"end":{"line":5,"col":22}},"title":"BAD QUESTION MARK","message":"`?` needs a `Result` or a `Maybe`, and this is neither:\n\n    Maybe Int\n\nThe enclosing definition returns:\n\n    Result String Int\n\nHint: `e?` unwraps an `Ok`/`Just` and returns the `Err`/`Nothing` from the\nenclosing definition, so both have to be the same shape. There is no\nconversion between `Result` and `Maybe`.\n"}]
