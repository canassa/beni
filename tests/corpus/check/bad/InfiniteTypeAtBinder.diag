[{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/InfiniteTypeAtBinder.beni","start":{"line":17,"col":15},"end":{"line":17,"col":16}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type for `y`:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = a -> b\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"},{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/InfiniteTypeAtBinder.beni","start":{"line":17,"col":27},"end":{"line":17,"col":28}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type for `y`:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = a -> b\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"},{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/InfiniteTypeAtBinder.beni","start":{"line":23,"col":9},"end":{"line":23,"col":10}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type for `y`:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = a -> b\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"}]
