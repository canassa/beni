[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetDeferredNotGeneral.beni","start":{"line":12,"col":38},"end":{"line":12,"col":42}},"title":"TYPE MISMATCH","message":"The 1st argument to `poll` is not what I expect:\n\nThis argument is:\n\n    Deferred String\n\nBut `poll` needs the 1st argument to be:\n\n    Deferred Int\n\nHint: `cell` is a value of a block that is computed, once, where it is\nwritten: its right-hand side calls something, or is an `if`, a `case` or a\nblock. A computation can make something that holds values, such as a new\n`Ref`, and one such thing cannot hold two types, so `cell` has ONE type inside\nthe definition that holds it (`docs/design/checker-v2.md` §8.4). The first\nuse fixed the type; this one disagrees.\n\nGive `cell` a parameter, so that each call makes a new one, to use it at two.\n"}]
