[{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOperator/Main.beni","start":{"line":8,"col":14},"end":{"line":8,"col":16}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\n`==` needs the `eq` of `T`, and `M` declares `eq` without `pub`, so\nit is private to that module and cannot be used from here.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOperator/Main.beni","start":{"line":12,"col":16},"end":{"line":12,"col":17}},"title":"PRIVATE METHOD","message":"`M.compare` is not `pub`.\n\n`<` needs the `compare` of `T`, and `M` declares `compare` without `pub`, so\nit is private to that module and cannot be used from here.\n\nHint: add `pub` to `compare` in `M`.\n"}]
