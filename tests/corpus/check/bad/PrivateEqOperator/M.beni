-- `T`'s `eq` and `compare` are private to `M` (checker-v2.md §11.3).
pub type T
    = T Int


eq : T, T → Bool
eq left right =
    case left of
        T x →
            case right of
                T y →
                    x == y


compare : T, T → Order
compare left right =
    case left of
        T x →
            case right of
                T y →
                    Basics.compare x y
