-- A `let` annotation `g : a -> a` whose body returns the enclosing
-- `x` is false — `a` is tied to `x`'s type, so it is not "any type". It is
-- `rigid_mismatch` at `x` (checker-v2.md §8.3), and `g`'s scheme is
-- poisoned so the caller below is not checked against the false annotation.
-- Checked clean, `f` would be `a -> String`, and `f 5` would reach
-- `String.toUpper` with an Int.

f x =
    g : a → a
    g y = x
    g "hello"


shout : String
shout = String.toUpper (f 5)
