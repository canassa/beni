[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/TaskSuspendingCanceller.beni","start":{"line":5,"col":23},"end":{"line":5,"col":24}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Task.callback` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
