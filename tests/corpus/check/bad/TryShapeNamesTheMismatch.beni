-- A `?` that cannot apply says WHICH leg failed — the enclosing
-- definition's return shape, or the error types — rather than that a
-- `Maybe` or a `Result` "is neither" (the owner's decision, checker-v2.md
-- §8.6: "the enclosing definition returns `Result String Int`, and this is
-- a `Maybe Int`", or "the error types differ") — never "`?` needs a
-- `Result` or a `Maybe`, and this is neither: `Maybe Int`" (or
-- `Result Int Int`).

fromMaybe : Maybe Int → Result String Int
fromMaybe m = Ok (m? + 1)


otherError : Result Int Int → Result String Int
otherError r = Ok (r? + 1)
