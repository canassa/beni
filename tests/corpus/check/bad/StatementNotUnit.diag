[{"code":"statement_not_unit","severity":"error","span":{"file":"tests/corpus/check/bad/StatementNotUnit.beni","start":{"line":14,"col":5},"end":{"line":14,"col":19}},"title":"UNUSED VALUE","message":"This line is a statement, so its value is thrown away — but it is a `List Int`,\nnot `()`.\n\n`push` returns a new `List Int` and changes nothing. Bind the result and use it:\n\n    xs2 = List.push xs 4\n\nor, if throwing it away is what you mean, say so:\n\n    _ = List.push xs 4"},{"code":"statement_not_unit","severity":"error","span":{"file":"tests/corpus/check/bad/StatementNotUnit.beni","start":{"line":20,"col":5},"end":{"line":20,"col":10}},"title":"UNUSED VALUE","message":"This line is a statement, so its value is thrown away — but it is an `Int`, not\n`()`.\n\nBind the result and use it:\n\n    result = n + 1\n\nor, if throwing it away is what you mean, say so:\n\n    _ = n + 1"},{"code":"statement_not_unit","severity":"error","span":{"file":"tests/corpus/check/bad/StatementNotUnit.beni","start":{"line":26,"col":5},"end":{"line":28,"col":10}},"title":"UNUSED VALUE","message":"This line is a statement, so its value is thrown away — but it is a `List Int`,\nnot `()`.\n\n`push` returns a new `List Int` and changes nothing. Bind the result and use it:\n\n    xs2 = List.push xs 4\n\nor, if throwing it away is what you mean, say so:\n\n    _ = List.push xs 4"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/StatementNotUnit.beni","start":{"line":34,"col":18},"end":{"line":34,"col":21}},"title":"TYPE MISMATCH","message":"The 2nd argument to `push` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `push` needs the 2nd argument to be:\n\n    Int\n\nHint: to read a number out of text, use `String.toInt` or `String.toFloat`.\n"}]
