[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":22,"col":13},"end":{"line":22,"col":14}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    number\n\nBut the type annotation says it should be:\n\n    Int32\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Int32` has no arithmetic operators on purpose: its arithmetic wraps\nat 32 bits, and `+` reading like `Int`'s would hide that. Use `Int32.add`,\n`sub`, `mul`, `div`, `rem` or `mod` — as a method, `a.add b`, or qualified,\n`Int32.add a b`. `==`, `<` and the other comparisons do work.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":26,"col":20},"end":{"line":26,"col":21}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    number\n\nBut the type annotation says it should be:\n\n    Int32\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Int32` has no arithmetic operators on purpose: its arithmetic wraps\nat 32 bits, and `+` reading like `Int`'s would hide that. Use `Int32.add`,\n`sub`, `mul`, `div`, `rem` or `mod` — as a method, `a.add b`, or qualified,\n`Int32.add a b`. `==`, `<` and the other comparisons do work.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":30,"col":17},"end":{"line":30,"col":18}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    number\n\nBut the type annotation says it should be:\n\n    Int32\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Int32` has no arithmetic operators on purpose: its arithmetic wraps\nat 32 bits, and `+` reading like `Int`'s would hide that. Use `Int32.add`,\n`sub`, `mul`, `div`, `rem` or `mod` — as a method, `a.add b`, or qualified,\n`Int32.add a b`. `==`, `<` and the other comparisons do work.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":34,"col":16},"end":{"line":34,"col":17}},"title":"TYPE MISMATCH","message":"The 1st argument to (//) is not what I expect:\n\nThis argument is:\n\n    Int32\n\nBut (//) needs the 1st argument to be:\n\n    Int\n\nHint: beni does not implicitly convert between `Int` and `Int32`. Use\n`Int32.fromInt` to go one way, and `Int32.toInt` or `Int32.toUnsignedInt`\nto go the other.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":34,"col":18},"end":{"line":34,"col":20}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    Int\n\nBut the type annotation says it should be:\n\n    Int32\n\nHint: beni does not implicitly convert between `Int` and `Int32`. Use\n`Int32.fromInt` to go one way, and `Int32.toInt` or `Int32.toUnsignedInt`\nto go the other.\n"}]
