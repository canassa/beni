[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":23,"col":7},"end":{"line":23,"col":8}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    number\n\nBut the type annotation says it should be:\n\n    Int32\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Int32` has no arithmetic operators on purpose: its arithmetic wraps\nat 32 bits, and `+` reading like `Int`'s would hide that. Use `Int32.add`,\n`sub`, `mul`, `div`, `rem` or `mod` — as a method, `a.add b`, or qualified,\n`Int32.add a b`. `==`, `<` and the other comparisons do work.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":28,"col":7},"end":{"line":28,"col":8}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    number\n\nBut the type annotation says it should be:\n\n    Int32\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Int32` has no arithmetic operators on purpose: its arithmetic wraps\nat 32 bits, and `+` reading like `Int`'s would hide that. Use `Int32.add`,\n`sub`, `mul`, `div`, `rem` or `mod` — as a method, `a.add b`, or qualified,\n`Int32.add a b`. `==`, `<` and the other comparisons do work.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":33,"col":7},"end":{"line":33,"col":8}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    number\n\nBut the type annotation says it should be:\n\n    Int32\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Int32` has no arithmetic operators on purpose: its arithmetic wraps\nat 32 bits, and `+` reading like `Int`'s would hide that. Use `Int32.add`,\n`sub`, `mul`, `div`, `rem` or `mod` — as a method, `a.add b`, or qualified,\n`Int32.add a b`. `==`, `<` and the other comparisons do work.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":38,"col":5},"end":{"line":38,"col":6}},"title":"TYPE MISMATCH","message":"The 1st argument to (//) is not what I expect:\n\nThis argument is:\n\n    Int32\n\nBut (//) needs the 1st argument to be:\n\n    Int\n\nHint: beni does not implicitly convert between `Int` and `Int32`. Use\n`Int32.fromInt` to go one way, and `Int32.toInt` or `Int32.toUnsignedInt`\nto go the other.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperators.beni","start":{"line":38,"col":7},"end":{"line":38,"col":9}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    Int\n\nBut the type annotation says it should be:\n\n    Int32\n\nHint: beni does not implicitly convert between `Int` and `Int32`. Use\n`Int32.fromInt` to go one way, and `Int32.toInt` or `Int32.toUnsignedInt`\nto go the other.\n"}]
