-- One explicit `Basics.eq` asks one question, and says "no" once
-- (checker-v2.md §11.4; the first failure by name text is the one reported).
-- The comparison's walk flags `x` and `y`; `[ x, y ]` merges them; `x 1`
-- makes the merged variable a function. The two flags carry the same
-- question, so ONE `not_equatable`, at the comparison's argument — not one
-- per flag, and never a clean check: the walk must not accept a variable
-- inside a structure.
--
h x y =
    let
        t = Basics.eq ( x, y ) ( x, y )

        l = [ x, y ]
    in
    x 1
