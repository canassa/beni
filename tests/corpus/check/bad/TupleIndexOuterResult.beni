-- A `tuple_index` on an outer variable is decided at the boundary
-- that owns the variable (checker-v2.md §4.5, §8.5): once `snd p` makes `p`
-- a pair of `Int`s, `a = p.0` is an `Int`, and `String.length a` is a
-- `type_mismatch` at `a` — not AMBIGUOUS TUPLE at `p.0`, which is sound
-- but the wrong code, and never a clean check that runs `String.length`
-- on a number.


snd : ( Int, Int ) -> Int
snd ( _, b ) =
    b


f p =
    let
        a =
            p.0
    in
    ( a + snd p, String.length a )
