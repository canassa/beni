[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/UnrelatedEqDoesNotGrantCapability/Main.beni","start":{"line":10,"col":9},"end":{"line":10,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Wrapper\n\n`Wrapper` gets its `==` from what it holds, and its `Wrapper` holds:\n\n    HasFn\n\nComparing that needs the `eq` of `HasFn` at a type that `Payload.eq` does not\nhave.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
