[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/UnrelatedEqDoesNotGrantCapability/Main.beni","start":{"line":10,"col":9},"end":{"line":10,"col":11}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Wrapper\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
