[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EquatableMarkerUncheckedSchema.beni","start":{"line":23,"col":7},"end":{"line":23,"col":16}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    Mine\n\nThat type does not support `Basics.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
