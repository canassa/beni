[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/RefUpdateSuspends.beni","start":{"line":11,"col":29},"end":{"line":11,"col":30}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Ref.update` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
