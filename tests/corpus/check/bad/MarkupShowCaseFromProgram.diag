[{"code":"invalid_keyed","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupShowCaseFromProgram.beni","start":{"line":11,"col":13},"end":{"line":11,"col":26}},"title":"INVALID KEYED","message":"`keyed={False}` would make a `<Show>` that never remounts, which is a `case`.\n\nWrite `keyed`, or `keyed={.id}` for a key, or the `case` itself:\n\n    case model.selected of\n        Just item →\n            <section>\n                <h2>{item.title}</h2>\n            </section>\n\n        Nothing →\n            <p>Nothing picked</p>"},{"code":"missing_form_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupShowCaseFromProgram.beni","start":{"line":19,"col":10},"end":{"line":19,"col":14}},"title":"MISSING ATTRIBUTE","message":"This `<Show>` has no `keyed`, so it would not say when to rebuild what it shows.\n\nA `<Show>` remounts its body when its value changes: `keyed` for a new value by\nidentity, `keyed={.id}` for a new key. To patch the body in place instead, write\nthe `case` it would be:\n\n    case model.hovered of\n        Just value →\n            viewCard value\n\n        Nothing →\n            <></>"}]
