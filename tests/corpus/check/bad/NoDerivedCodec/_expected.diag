[{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":26,"col":17},"end":{"line":26,"col":28}},"title":"CANNOT DERIVE A CODEC","message":"`{ name : String, onClick : Int → Int }` cannot be read from JSON or written to\nit: at `onClick`, `Int → Int` is a function, which JSON has no form for.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":30,"col":20},"end":{"line":30,"col":31}},"title":"CANNOT DERIVE A CODEC","message":"`List (Fiber Int)` cannot be read from JSON or written to it: at `[]`,\n`Fiber Int` is a foreign type, `Fiber`, whose values JSON has no form for, and\nits module declares no `codec`.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":34,"col":19},"end":{"line":34,"col":30}},"title":"CANNOT DERIVE A CODEC","message":"`Secret` cannot be read from JSON or written to it: it is an opaque type of\n`Hidden`, whose constructors this module cannot see: declare\n`pub codec : ⊤ → Codec Secret` in `Hidden`, where\n`pub codec u = Schema.structural u` reads its shape.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":38,"col":14},"end":{"line":38,"col":31}},"title":"CANNOT DERIVE A CODEC","message":"`Secret` cannot be read from JSON or written to it: it is read by\n`Schema.structural` only in the module that declares it, whose constructors are\nits own: anywhere else it would build values that skip the checks its module\nmakes.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":42,"col":19},"end":{"line":42,"col":30}},"title":"CANNOT DERIVE A CODEC","message":"`{ r | name : String }` cannot be read from JSON or written to it: it is an\nextensible record, whose other fields are not known.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":46,"col":20},"end":{"line":46,"col":31}},"title":"CANNOT DERIVE A CODEC","message":"`List (Maybe (Maybe Int))` cannot be read from JSON or written to it: at `[]`,\n`Maybe (Maybe Int)` is a `Maybe` of a type that reads `null` itself, so\n`Nothing` and `Just` of that `null` would be one JSON value: outside a record\nfield use `Schema.Nullable`, or make it a field.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":50,"col":17},"end":{"line":50,"col":28}},"title":"CANNOT DERIVE A CODEC","message":"`Presence Int` cannot be read from JSON or written to it: it says whether a\nrecord field's key is there, so it is read only as a field's type.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":54,"col":23},"end":{"line":54,"col":34}},"title":"CANNOT DERIVE A CODEC","message":"`{ box : Box Int }` cannot be read from JSON or written to it: at `box`,\n`Box Int` has a module `codec` that needs evidence, so it is used only where it\nis the decoded type itself.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":58,"col":13},"end":{"line":58,"col":24}},"title":"CANNOT DERIVE A CODEC","message":"`Dict String Int` cannot be read from JSON or written to it: it is a `Dict`,\nwhich a derived codec does not read yet (issue #205): use a `List` of pairs, or\na declared schema.\n"},{"code":"no_derived_codec","severity":"error","span":{"file":"tests/corpus/check/bad/NoDerivedCodec/Main.beni","start":{"line":62,"col":24},"end":{"line":62,"col":35}},"title":"CANNOT DERIVE A CODEC","message":"`{ right : Right }` cannot be read from JSON or written to it: at `right`,\n`Right` has its module's `codec`, which is not `⊤ → Codec Right`: a module's one\n`codec` is the method of every type the module declares.\n"}]
