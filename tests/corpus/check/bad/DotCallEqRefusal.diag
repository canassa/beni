[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallEqRefusal.beni","start":{"line":16,"col":18},"end":{"line":16,"col":21}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallEqRefusal.beni","start":{"line":21,"col":18},"end":{"line":21,"col":21}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    number -> number\n\nThere is a function in there, and comparing functions is not decidable:\ndeciding whether two functions agree on every input is the halting problem.\n\nHint: compare the values the functions produce, or store something you can\ncompare — a name, an id — next to the function.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallEqRefusal.beni","start":{"line":26,"col":5},"end":{"line":26,"col":6}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
