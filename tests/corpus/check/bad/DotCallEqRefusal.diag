[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallEqRefusal.beni","start":{"line":14,"col":23},"end":{"line":14,"col":26}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallEqRefusal.beni","start":{"line":18,"col":27},"end":{"line":18,"col":30}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    number -> number\n\nThere is a function in there, and comparing functions is not decidable:\ndeciding whether two functions agree on every input is the halting problem.\n\nHint: compare the values the functions produce, or store something you can\ncompare — a name, an id — next to the function.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DotCallEqRefusal.beni","start":{"line":22,"col":13},"end":{"line":22,"col":14}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`:\n\n    F\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
