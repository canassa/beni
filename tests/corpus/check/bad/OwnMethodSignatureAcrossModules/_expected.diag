[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/OwnMethodSignatureAcrossModules/M.beni","start":{"line":12,"col":1},"end":{"line":12,"col":3}},"title":"TYPE MISMATCH","message":"`M.eq` cannot be the `eq` of `T`:\n\n    T, Int → Bool\n\nbut the `eq` of `T` has to be:\n\n    T, T → Bool\n\nA method of `T` is a `pub` value of the module that declares it, so\n`M.eq` is the `eq` of `T`, and it has to have that type.\n\nHint: give `eq` that type, or rename it if it is not meant to be a method\nof `T`.\n"}]
