[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/PowGivesFloat.beni","start":{"line":10,"col":17},"end":{"line":10,"col":18}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    Float\n\nBut the type annotation says it should be:\n\n    Int\n\nHint: `^` always gives a `Float`. For an `Int` power, use `^^`: `2 ^^ 3` is\nthe `Int` 8.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/PowGivesFloat.beni","start":{"line":18,"col":21},"end":{"line":18,"col":22}},"title":"TYPE MISMATCH","message":"The 1st argument to `double` is not what I expect:\n\nThis argument is:\n\n    Float\n\nBut `double` needs the 1st argument to be:\n\n    Int\n\nHint: `^` always gives a `Float`. For an `Int` power, use `^^`: `2 ^^ 3` is\nthe `Int` 8.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/PowGivesFloat.beni","start":{"line":22,"col":21},"end":{"line":22,"col":22}},"title":"TYPE MISMATCH","message":"The 2nd argument to (≥) is not what I expect:\n\nThis argument is:\n\n    Float\n\nBut (≥) needs the 2nd argument to be:\n\n    Int\n\nHint: `^` always gives a `Float`. For an `Int` power, use `^^`: `2 ^^ 3` is\nthe `Int` 8.\n"}]
