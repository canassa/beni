[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EquatableMarkerThroughWrappedEndpoint/Main.beni","start":{"line":16,"col":12},"end":{"line":16,"col":14}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Holds\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EquatableMarkerThroughWrappedEndpoint/Main.beni","start":{"line":21,"col":16},"end":{"line":21,"col":20}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Holds\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
