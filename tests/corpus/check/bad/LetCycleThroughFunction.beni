-- `n = get ()` where `get` reads `n` is `n` defined in terms of
-- itself through `get`, and the message names that cycle, `n → get → n`,
-- rather than calling `n`'s own binding "further down this `let`" (the
-- direct path already says `.self`, `bir/Lower.zig`). It never says
-- "Naming `get` here reads `n`, which is bound further down this
-- `let`, on line 13" when line 13 is `n`'s own binding.

value : Int
value =
    let
        get u = n + 1

        n = get ()
    in
    n
