[{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/IndirectFunctionAcrossModules/Main.beni","start":{"line":14,"col":7},"end":{"line":14,"col":8}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    Indirect\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"}]
