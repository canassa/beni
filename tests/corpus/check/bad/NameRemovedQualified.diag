[{"code":"name_removed","severity":"error","span":{"file":"tests/corpus/check/bad/NameRemovedQualified.beni","start":{"line":6,"col":9},"end":{"line":6,"col":27}},"title":"REMOVED NAME","message":"`remainderBy` was removed: beni's `remainderBy n 3` read as Elm's\n`remainderBy 3 n`. Write `Int.rem n 3`, the arguments in the order they had.\n`Int` is a prelude module, so it needs no import.\n\n`beni fmt --migrate-names <file>` rewrites every use in a file."},{"code":"name_removed","severity":"error","span":{"file":"tests/corpus/check/bad/NameRemovedQualified.beni","start":{"line":10,"col":14},"end":{"line":10,"col":26}},"title":"REMOVED NAME","message":"`modBy` was removed: beni's `modBy n 2` read as Elm's `modBy 2 n`. Write\n`Int.mod n 2`, the arguments in the order they had. `Int` is a prelude\nmodule, so it needs no import.\n\n`beni fmt --migrate-names <file>` rewrites every use in a file."}]
