[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/MutualGroupLocals.beni","start":{"line":15,"col":11},"end":{"line":15,"col":12}},"title":"TYPE MISMATCH","message":"The 2nd argument to `f` is not what I expect:\n\nThis argument is:\n\n    number\n\nBut `f` needs the 2nd argument to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: want to turn a number into a `String`? Use `String.fromInt` or\n`String.fromFloat`.\n"}]
