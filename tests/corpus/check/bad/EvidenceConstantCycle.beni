-- A constant with evidence parameters is CALLED at every read, so it
-- does not defer its own evaluation and a value defined in
-- terms of itself is `cyclic_value` whether or not it carries a `where`
-- (checker.md §6.7; checker-v2.md §12.5). Letting the `where` make the
-- cycle check count `zs` as deferring would check clean, and the built
-- program would die with `RangeError: Maximum call stack size exceeded` in
-- `Main$zs`. The control, this file without the `where` clause (and with
-- `\x -> True` for the filter, which no longer compares), is VALUE
-- DEFINED IN TERMS OF ITSELF at the position below.

zs : List a
    where a.eq : a, a → Bool
zs = List.filter zs λx → x == x


ints : List Int
ints = zs
