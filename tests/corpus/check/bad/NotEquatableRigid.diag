[{"code":"missing_where_constraint","severity":"error","span":{"file":"tests/corpus/check/bad/NotEquatableRigid.beni","start":{"line":11,"col":26},"end":{"line":11,"col":28}},"title":"MISSING CONSTRAINT","message":"I need `a.eq` here, and the annotation does not allow it.\n\nThis call needs `a` to have a method `eq`:\n\n    eq : a, a -> Bool\n\nbut the annotation says `a` is any type at all.\n\nHint: add it to the annotation:\n\n    where a.eq : a, a -> Bool\n"}]
