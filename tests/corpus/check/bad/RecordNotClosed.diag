[{"code":"record_not_closed","severity":"error","span":{"file":"tests/corpus/check/bad/RecordNotClosed.beni","start":{"line":5,"col":5},"end":{"line":5,"col":6}},"title":"RECORD NOT CLOSED","message":"This has to work with ANY record that has these fields:\n\n    { r | x : Int }\n\nBut the value here is one specific record:\n\n    { x : a }\n\nHint: `{ r | … }` means \"any record with at least these fields\", so a\ncaller may pass one with more. A record literal and a record alias are\nclosed, so neither can stand in for one.\n"}]
