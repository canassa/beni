[{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqThroughThirdModule/C.beni","start":{"line":6,"col":23},"end":{"line":6,"col":25}},"title":"PRIVATE METHOD","message":"`A.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `A`, which is inside:\n\n    Wrap\n\n`A` declares `eq` without `pub`, and it is the `eq` of every type `A`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `A`.\n"}]
