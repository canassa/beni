-- A private `eq` across three modules (checker-v2.md §11.3, the owner's
-- decision as amended 2026-09-24). `A`'s `eq` compares modulo 10 and is
-- private, so it answers only inside `A`. `B` wraps an `A.T` and compares
-- nothing: its `Wrap` has no `eq` anyone may use, and its record says so
-- (`private_method`, naming `A.T`: §14.2). `C` compares
-- two `B.Wrap`s: `private_method` at its `==`, and the message says which
-- private method, of which type, the value holds. `C` must not build, and
-- `B`'s row must say why, not merely "derives" or "does not
-- support".
pub type T
    = T Int


eq : T, T → Bool
eq left right =
    case left of
        T x →
            case right of
                T y →
                    Int.mod x 10 == Int.mod y 10


pub inside : T, T → Bool
inside a b = a == b
