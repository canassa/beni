[{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/IndirectFunctionPayload.beni","start":{"line":22,"col":7},"end":{"line":22,"col":8}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    IndirectFn\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/IndirectFunctionPayload.beni","start":{"line":27,"col":7},"end":{"line":27,"col":9}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    IndirectFn\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
