[{"code":"import_cycle","severity":"error","span":{"file":"tests/corpus/check/bad/Cycle/A.beni","start":{"line":5,"col":8},"end":{"line":5,"col":9}},"title":"IMPORT CYCLE","message":"These modules import each other in a circle:\n\n    A → B → C → A\n\nBeni compiles modules in dependency order, so a circle has no place to start.\nMove what they share into a module of its own and have both import that."}]
