[{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/LetHelperCyclicReceiver.beni","start":{"line":10,"col":15},"end":{"line":10,"col":17}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type here:\n\nHere is my best effort at writing it down:\n\n    a  =  … a …\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"}]
