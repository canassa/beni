[{"code":"missing_where_constraint","severity":"error","span":{"file":"tests/corpus/check/bad/MissingWhereAtUse.beni","start":{"line":16,"col":11},"end":{"line":16,"col":13}},"title":"MISSING CONSTRAINT","message":"I need `a.eq` here, and the annotation does not allow it.\n\nThis call needs `a` to have a method `eq`:\n\n    eq : a, a -> Bool\n\nbut `a` is any type at all. `eq` is required by `==`.\n\nHint: add it to the annotation:\n\n    where a.eq : a, a -> Bool\n"}]
