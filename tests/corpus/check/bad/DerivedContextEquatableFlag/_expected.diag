[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedContextEquatableFlag/Main.beni","start":{"line":21,"col":20},"end":{"line":21,"col":22}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    W (Int -> Int)\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
