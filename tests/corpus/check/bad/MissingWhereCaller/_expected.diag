[{"code":"missing_where_constraint","severity":"error","span":{"file":"tests/corpus/check/bad/MissingWhereCaller/Main.beni","start":{"line":12,"col":5},"end":{"line":12,"col":12}},"title":"MISSING CONSTRAINT","message":"I need `a.pick` here, and the annotation does not allow it.\n\nThis call needs `a` to have a method `pick`:\n\n    pick : a, a -> a\n\nbut `a` is any type at all. `pick` is required by `top`.\n\nHint: add it to the annotation:\n\n    where a.pick : a, a -> a\n"}]
