[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ModuleRuleClash.beni","start":{"line":27,"col":7},"end":{"line":27,"col":9}},"title":"TYPE MISMATCH","message":"`ModuleRuleClash.eq` is not the method this call needs:\n\n    Version, Version -> Bool\n\nbut the call wants:\n\n    Colour, Colour -> Bool\n\nA method of `Colour` is a `pub` value of the module that declares it, which is\n`ModuleRuleClash`, and a module's `pub` values are ONE namespace — so `eq` is\nthe method of every type `ModuleRuleClash` declares.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
