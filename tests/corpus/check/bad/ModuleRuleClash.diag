[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ModuleRuleClash.beni","start":{"line":21,"col":1},"end":{"line":21,"col":3}},"title":"TYPE MISMATCH","message":"`ModuleRuleClash.eq` cannot be the `eq` of `Colour`:\n\n    Version, Version → Bool\n\nbut the `eq` of `Colour` has to be:\n\n    Colour, Colour → Bool\n\nA method of `Colour` is a `pub` value of the module that declares it, which is\n`ModuleRuleClash`, and a module's `pub` values are ONE namespace — so `eq` is\nthe method of every type `ModuleRuleClash` declares.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
