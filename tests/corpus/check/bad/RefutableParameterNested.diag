[{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterNested.beni","start":{"line":7,"col":13},"end":{"line":7,"col":17}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Nothing\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterNested.beni","start":{"line":13,"col":12},"end":{"line":13,"col":16}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Nothing\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"},{"code":"refutable_parameter_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/RefutableParameterNested.beni","start":{"line":25,"col":9},"end":{"line":25,"col":13}},"title":"REFUTABLE PARAMETER","message":"This pattern does not match every value of its type:\n\nMissing possibilities include:\n\n    Nothing\n\nA parameter has to match whatever it is given, so there is nowhere for those to\ngo and I would have to crash. Take the value whole and `case` on it:\n\n    un m =\n        case m of\n            Just n ->\n                n\n\n            Nothing ->\n                0\n"}]
