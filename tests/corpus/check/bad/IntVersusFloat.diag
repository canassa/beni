[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/IntVersusFloat.beni","start":{"line":5,"col":5},"end":{"line":5,"col":6}},"title":"TYPE MISMATCH","message":"The 1st argument to (/) is not what I expect:\n\nThis argument is:\n\n    Int\n\nBut (/) needs the 1st argument to be:\n\n    Float\n\nHint: beni does not implicitly convert `Int` to `Float`. Use `toFloat` to go\none way and `round`, `floor`, `ceiling` or `truncate` to go the other.\n"}]
