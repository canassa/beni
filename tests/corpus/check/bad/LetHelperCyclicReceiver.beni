-- Queue row 76: a constrained `let` helper is monomorphic
-- (static-dispatch-spike.md §11), so the two calls make `x ~ List x`. The
-- `==` obligation on that cyclic receiver asked for the element's `eq`
-- forever — 875f623 panicked after about 10 s and the row 72 tree never
-- finished. It is an infinite type, reported once, at the `==`, as `a = List
-- a` since R11 (CK-57). `abuse_test.zig` holds the time-bounded twin.
pairEq x y =
    let
        inner a b =
            a == b
    in
    inner x y && inner [ x ] [ y ]
