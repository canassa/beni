[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RecursiveDispatchTwoTypes.beni","start":{"line":20,"col":21},"end":{"line":20,"col":23}},"title":"TYPE MISMATCH","message":"`eq` is used at two types inside a group that is recursive through method calls\n(`eq` → `show` → `eq`). Inside the group it has one type:\n\n    Box number, Box number -> Bool\n\nbut this use wants:\n\n    Box String, Box String -> Bool\n\nHint: an annotation on `eq` lets each use instantiate it.\n"}]
