[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/WhereClauseMismatchNamesClause.beni","start":{"line":23,"col":5},"end":{"line":23,"col":6}},"title":"TYPE MISMATCH","message":"The `where a.compare` clause of `f` does not match the `compare` of `Int`:\n\nWith `a` as `Int`, the clause asks for:\n\n    Int, Int -> Int\n\nBut the `compare` of `Int` is:\n\n    Int, Int -> Order\n\nHint: `compare` means the same thing at every type, `a, a -> Order`, so a\n`where` clause that names it has to give it that type.\n"}]
