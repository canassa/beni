[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaEndpointInFlightFunction.beni","start":{"line":17,"col":39},"end":{"line":17,"col":41}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Loop.Type\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
