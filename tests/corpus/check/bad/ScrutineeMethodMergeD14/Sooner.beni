-- See Later.beni. The same module with the methods first.
type K
    = K Int


type Box a
    = Box a


pub g (Box a) u = 0


pub h (K m) u =
    _ = λw → (K 0).f ()
    Box m


pub combine (Box a) z = a


pub f (K n) u =
    case ( (λy → y.h ()) (K n), (Box 1).g (), (Box "s").g () ) of
        ( r, _, _ ) →
            q z = r.combine z
            ( q 1, q "s" )
