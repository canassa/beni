-- More variants: a parameterised type used short of its arguments in
-- a constructor — parenthesised, beside another argument, in a record
-- field, under `List`, as the type's own name (`Trip`), and a local `Int`
-- that takes a parameter — is WRONG TYPE ARITY, and each type is then
-- compared, so derivation meets its payload. The builder poisons a partial
-- application (`Types.Builder.apply`): no `app` in the store has fewer
-- arguments than its type has parameters.
type Foo a
    = Box a


type K1
    = K1 (Foo)


type K2
    = K2 Int Foo


type K3
    = K3 { f : Foo }


type K4
    = K4 (List Foo)


type Trip a b c
    = Trip a b c Trip


type Int a
    = I a


type K5
    = K5 Int


f1 : K1 -> K1 -> Bool
f1 a b = a == b


f2 : K2 -> K2 -> Bool
f2 a b = a == b


f3 : K3 -> K3 -> Bool
f3 a b = a == b


f4 : K4 -> K4 -> Order
f4 a b = compare a b


f5 : K5 -> K5 -> Bool
f5 a b = a == b


f6 : Trip Char Char Char -> Bool
f6 t = t == t
