[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/MethodSignatureNoClash.beni","start":{"line":20,"col":11},"end":{"line":20,"col":13}},"title":"TYPE MISMATCH","message":"`MethodSignatureNoClash.eq` is not the method this call needs:\n\n    Mod, Int -> Bool\n\nbut the call wants:\n\n    Mod, Mod -> Bool\n\nA method of `Mod` is a `pub` value of the module that declares it, so\n`MethodSignatureNoClash.eq` is the `eq` of `Mod`, and it has to have the type\nthe call wants.\n\nHint: give `eq` that type, or rename it if it is not meant to be a method\nof `Mod`.\n"}]
