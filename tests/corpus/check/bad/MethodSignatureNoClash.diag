[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/MethodSignatureNoClash.beni","start":{"line":13,"col":1},"end":{"line":13,"col":3}},"title":"TYPE MISMATCH","message":"`MethodSignatureNoClash.eq` cannot be the `eq` of `Mod`:\n\n    Mod, Int -> Bool\n\nbut the `eq` of `Mod` has to be:\n\n    Mod, Mod -> Bool\n\nA method of `Mod` is a `pub` value of the module that declares it, so\n`MethodSignatureNoClash.eq` is the `eq` of `Mod`, and it has to have that type.\n\nHint: give `eq` that type, or rename it if it is not meant to be a method\nof `Mod`.\n"}]
