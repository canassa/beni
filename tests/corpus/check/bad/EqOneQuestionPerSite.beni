-- One explicit `Basics.eq` whose argument holds a function and a type
-- with a function inside says `not_equatable` ONCE per comparison, not once
-- per part (checker-v2.md §11.4), and it names the
-- FUNCTION: the walk visits a tuple's elements and a record's fields in
-- order, so `k : Int -> Int` is met before `Box`, and the message is not
-- "That type does not support `==`", the reason of `Box`.
--
--
type Box
    = Box (Int → Int)


k : Int → Int
k n = n


t : Bool
t = Basics.eq ( k, Box k ) ( k, Box k )


u : Bool
u = Basics.eq { a = k, b = Box k } { a = k, b = Box k }
