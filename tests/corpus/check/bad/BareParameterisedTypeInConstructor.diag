[{"code":"wrong_type_arity","severity":"error","span":{"file":"tests/corpus/check/bad/BareParameterisedTypeInConstructor.beni","start":{"line":10,"col":9},"end":{"line":10,"col":12}},"title":"WRONG TYPE ARITY","message":"`Foo` takes 1 type argument, but here it has 0.\n\nEvery type constructor is fully applied — beni has no higher-kinded types — so\nthe number has to match the declaration exactly."}]
