[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ImportedErrorValueComparedEverywhere/A.beni","start":{"line":8,"col":9},"end":{"line":8,"col":10}},"title":"TYPE MISMATCH","message":"The 2nd argument to (+) is not what I expect:\n\nThis argument is:\n\n    String\n\nBut (+) needs the 2nd argument to be:\n\n    number\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To join text use `++`.\n"}]
