-- check/bad: §6.4 rule (a) and §10.5. A `let` binding is never generalised
-- over a variable carrying a method constraint (until D5, R14), so `show` is
-- monomorphic inside `report`, the first use pins it to `Int`, and the
-- second is a conflict rather than a second instantiation. Since R11 `Int`'s
-- missing `render` is reported first, where `show n` pins it (eager draining,
-- checker-v2.md §9.1). The fix is a top-level annotated declaration.
pub report : Int, String -> String
report n s =
    let
        show x =
            x.render 1
    in
    show n ++ show s
