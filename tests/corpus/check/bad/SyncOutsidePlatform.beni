-- check/bad: `sync` outside a platform package is `misplaced_sync`
-- (transparent-effects-proposal.md §15.2 item 1, amended 2026-10-02: only a
-- package that may write `foreign` may write `sync`). The declaration is
-- read without the mark, so `apply` checks as it would unmarked. `wrap`'s
-- `sync` is not followed by `(`, so it is an ordinary type variable, as it
-- always was.
apply : sync (Int -> Int), Int -> Int
apply f n = f n


wrap : sync -> List sync
wrap x = [ x ]
