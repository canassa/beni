[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaWrapperExclusionThroughOwnType.beni","start":{"line":38,"col":7},"end":{"line":38,"col":9}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Holds\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
