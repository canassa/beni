[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/MethodCallArgumentRegion.beni","start":{"line":14,"col":17},"end":{"line":14,"col":18}},"title":"TYPE MISMATCH","message":"The 2nd argument to `add` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `add` needs the 2nd argument to be:\n\n    Int\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To read a number out of\ntext use `String.toInt` or `String.toFloat`.\n"}]
