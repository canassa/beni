-- (the twin) `DerivedContextReentrant/` with `same` written before
-- `key`: the same one `type_mismatch` at `"s"` in
-- `other`, never NOT EQUATABLE `W`.
pub type Holder a
    = Holder a


pub eq : Holder a, Holder a -> Bool
    where a.key : a, () -> Int
eq left right =
    case left of
        Holder l ->
            case right of
                Holder r ->
                    l.key () == r.key ()
