[{"code":"spread_on_element","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupSpreadOnElement.beni","start":{"line":5,"col":10},"end":{"line":5,"col":14}},"title":"SPREAD ON AN ELEMENT","message":"`<div>` cannot take a spread: a spread `{...record}` is the first attribute of a\ncomponent, whose record it extends.\n\nA spread of attributes onto an element is not supported yet. Write the\nattributes it would set one by one."}]
