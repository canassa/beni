[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/SchedulerHookWaits.beni","start":{"line":13,"col":23},"end":{"line":13,"col":27}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Task.scheduler` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: `hook` calls `Task.sleep`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
