[{"code":"cyclic_value","severity":"error","span":{"file":"tests/corpus/check/bad/EvidenceFunctionConstantCycleThroughLambda.beni","start":{"line":29,"col":1},"end":{"line":29,"col":2}},"title":"VALUE DEFINED IN TERMS OF ITSELF","message":"`h` is defined in terms of itself:\n\n    h → k → h\n\nA top-level value is computed from its own initialiser: once, when the module\nis loaded, or — for one with a `where` clause, like `h` — when it is first\nused with its evidence. Either way there is no order in which I can compute\nthese: each of them is already needed before it has a value.\n\nNaming `k` counts as calling it, so whatever its body reads is read\nwhile `h` is being computed.\n\nHint: a FUNCTION may be recursive, because its body runs when it is called and\nnot when the module loads. Give one of these a parameter, or compute it from\nsomething outside the circle.\n"}]
