[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EquatableMarkerThroughWrappedEndpointLocal.beni","start":{"line":38,"col":10},"end":{"line":38,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Holds\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EquatableMarkerThroughWrappedEndpointLocal.beni","start":{"line":43,"col":16},"end":{"line":43,"col":18}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    Holds\n\nThat type does not support `Basics.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
