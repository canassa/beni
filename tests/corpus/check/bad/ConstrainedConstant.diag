[{"code":"constrained_constant","severity":"error","span":{"file":"tests/corpus/check/bad/ConstrainedConstant.beni","start":{"line":15,"col":5},"end":{"line":15,"col":10}},"title":"CONSTRAINED CONSTANT","message":"`blank` takes no arguments but needs `k.compare`.\n\nA value that needs a method has to receive it, which would make `blank` a\nfunction of one hidden argument, and that is not what its type says.\n\nHint: give it a parameter, annotate it at a concrete type, or write the `where`\nclause in its annotation.\n"}]
