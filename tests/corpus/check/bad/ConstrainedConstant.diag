[{"code":"constrained_constant","severity":"error","span":{"file":"tests/corpus/check/bad/ConstrainedConstant.beni","start":{"line":10,"col":5},"end":{"line":10,"col":11}},"title":"CONSTRAINED CONSTANT","message":"`equals` takes no arguments but needs `a.eq`.\n\nA value that needs a method has to receive it, which would make `equals` a\nfunction of one hidden argument, and that is not what its type says.\n\nHint: give it a parameter, or annotate it at a concrete type.\n"}]
