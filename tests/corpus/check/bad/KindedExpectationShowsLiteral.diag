[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/KindedExpectationShowsLiteral.beni","start":{"line":6,"col":18},"end":{"line":6,"col":19}},"title":"TYPE MISMATCH","message":"The 2nd argument to (+) is not what I expect:\n\nThis argument is:\n\n    { a : number, b : String }\n\nBut (+) needs the 2nd argument to be:\n\n    number2\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To join text use `++`.\n"}]
