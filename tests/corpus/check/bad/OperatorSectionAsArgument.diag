[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionAsArgument.beni","start":{"line":9,"col":30},"end":{"line":9,"col":31}},"title":"TYPE MISMATCH","message":"The 3rd argument to `foldl` is not what I expect:\n\nThis argument is:\n\n    Int, Int → Bool\n\nBut `foldl` needs the 3rd argument to be:\n\n    Int, Int → Int\n\nHint: I work out a call's argument types from left to right, and once an\nargument fits I move on. So the mistake may be in one of the earlier\narguments rather than in this one.\n"}]
