-- A CLOSED schema endpoint compared while its schema's group is in
-- flight is checked once the group is done (checker-v2.md §11.5:
-- deferred, as §11.2's closed in-flight branch
-- defers). `conv`'s target is inferred in the same group as the comparison,
-- as `Int -> Int`, so `Loop.Type` holds a function, and the deferred check
-- refuses the `==` with `not_equatable` at its use. It must not check
-- clean by reading the endpoint's properties as the last settle left them,
-- before `conv`'s target exists.
import Schema exposing (Conversion)


mk : Int -> Conversion Int (Int -> Int)
mk n = Debug.todo "checker-only conversion"


conv =
    if Loop.Step { payload = \x -> x } == Loop.Step { payload = \x -> x + 1 } then
        mk 0
    else
        mk 1


pub schema Loop tagged "kind" of
    Step as "step"
        payload : Int via conv
