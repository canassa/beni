[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedPinnedThroughHelper/Main.beni","start":{"line":26,"col":5},"end":{"line":26,"col":9}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    W String\n\n`W` gets its `==` from what it holds, and it holds a `Holder`, whose\n`eq` is `H.eq`, for one type of `Holder` only. So `W` has `==` only as:\n\n    W Int\n\nHint: use it at that type, or give `H.eq` a type that works for every\n`Holder`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedPinnedThroughHelper/Main.beni","start":{"line":31,"col":12},"end":{"line":31,"col":14}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    W String\n\n`W` gets its `==` from what it holds, and it holds a `Holder`, whose\n`eq` is `H.eq`, for one type of `Holder` only. So `W` has `==` only as:\n\n    W Int\n\nHint: use it at that type, or give `H.eq` a type that works for every\n`Holder`.\n"}]
