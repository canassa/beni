[{"code":"untyped_srcdoc_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedSrcdocAttribute.beni","start":{"line":11,"col":17},"end":{"line":11,"col":25}},"title":"UNTYPED SRCDOC ATTRIBUTE","message":"`\"srcdoc\"` writes a whole document into a frame as an untyped attribute.\n\nA page runs that document, its scripts included, so a value there could inject\none. Load the frame's document from a URL, `src={url}`."},{"code":"untyped_srcdoc_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedSrcdocAttribute.beni","start":{"line":12,"col":17},"end":{"line":12,"col":25}},"title":"UNTYPED SRCDOC ATTRIBUTE","message":"`\"SrcDoc\"` writes a whole document into a frame as an untyped attribute.\n\nA page runs that document, its scripts included, so a value there could inject\none. Load the frame's document from a URL, `src={url}`."}]
