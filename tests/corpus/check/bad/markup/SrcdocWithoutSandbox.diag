[{"code":"srcdoc_without_sandbox","severity":"error","span":{"file":"tests/corpus/check/bad/markup/SrcdocWithoutSandbox.beni","start":{"line":15,"col":17},"end":{"line":15,"col":23}},"title":"SRCDOC WITHOUT A SAFE SANDBOX","message":"This `<iframe>` writes `srcdoc`, but it has no `sandbox`.\n\nWithout a `sandbox`, the frame runs the document with the page's origin, and\nits scripts can read and change this page. Write a constant `sandbox`:\n\n    <iframe sandbox=\"\" srcdoc={page} />\n\n`sandbox=\"allow-scripts\"` lets the document run its scripts, in an origin of its\nown, where they cannot reach this page."},{"code":"srcdoc_without_sandbox","severity":"error","span":{"file":"tests/corpus/check/bad/markup/SrcdocWithoutSandbox.beni","start":{"line":16,"col":32},"end":{"line":16,"col":38}},"title":"SRCDOC WITHOUT A SAFE SANDBOX","message":"This `<iframe>` writes `srcdoc`, and its `sandbox` comes from a value, so I\ncannot see its tokens.\n\nIf the value holds `allow-same-origin`, the frame runs the document with the\npage's origin, and its scripts can read and change this page. Write the\n`sandbox` as a constant:\n\n    <iframe sandbox=\"\" srcdoc={page} />\n\n`sandbox=\"allow-scripts\"` lets the document run its scripts, in an origin of its\nown, where they cannot reach this page."},{"code":"srcdoc_without_sandbox","severity":"error","span":{"file":"tests/corpus/check/bad/markup/SrcdocWithoutSandbox.beni","start":{"line":17,"col":41},"end":{"line":17,"col":47}},"title":"SRCDOC WITHOUT A SAFE SANDBOX","message":"This `<iframe>` writes `srcdoc`, and its `sandbox` comes from a value, so I\ncannot see its tokens.\n\nIf the value holds `allow-same-origin`, the frame runs the document with the\npage's origin, and its scripts can read and change this page. Write the\n`sandbox` as a constant:\n\n    <iframe sandbox=\"\" srcdoc={page} />\n\n`sandbox=\"allow-scripts\"` lets the document run its scripts, in an origin of its\nown, where they cannot reach this page."},{"code":"s