-- `child_not_renderable` (checker-v2.md §25.4): a hole shows a `String`,
-- `Int`, `Float`, `Bool` or `Char` as text, or markup, `Maybe` markup or a
-- `List` of it. A record is none of them (11:10), and a `List` of strings is
-- not a list of markup (12:10). No conversion is ever written for a hole.
import Html exposing (Html)


pub view : { count : Int }, List String → Html msg
view model names =
    <div>
        {model}
        {names}
    </div>
