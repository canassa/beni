[{"code":"missing_form_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/ShowNotKeyedUnicodeArrow.beni","start":{"line":10,"col":10},"end":{"line":10,"col":14}},"title":"MISSING ATTRIBUTE","message":"This `<Show>` has no `keyed`, so it would not say when to rebuild what it shows.\n\nA `<Show>` remounts its body when its value changes: `keyed` for a new value by\nidentity, `keyed={.id}` for a new key. To patch the body in place instead, write\nthe `case` it would be:\n\n    case title of\n        Just t →\n            <p>{t}</p>\n\n        Nothing →\n            <></>"}]
