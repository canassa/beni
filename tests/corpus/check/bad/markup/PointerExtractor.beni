-- No program can call the pointer events' extractor (boundary.md §9.8.20
-- (d), amended 2026-10-22). `Html.pointer` is not `pub`, so an `onClick`
-- handler that passes its `Event` to it is refused by name. The handler
-- of `onPointerDown`, whose `via` names it, is accepted.
-- `PointerExtractorType` names its parameter type, which is private too.
import Html exposing (Html)


type Msg
    = Aimed Html.Pointer
    | Clicked


pub view : Html Msg
view =
    <div>
        <button onPointerDown={Aimed} />
        <button onClick={Clicked} />
        <button onClick={λevent → Aimed (Html.pointer event)} />
    </div>
