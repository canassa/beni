[{"code":"void_element_with_children","severity":"error","span":{"file":"tests/corpus/check/bad/markup/VoidElementWithChildren.beni","start":{"line":8,"col":12},"end":{"line":8,"col":16}},"title":"VOID ELEMENT WITH CHILDREN","message":"`<br>` is given children, but its platform declares it `void`: it takes none,\nand they would be dropped.\n\nWrite it self-closing, `<br />`, and put the children beside it."}]
