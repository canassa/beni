[{"code":"key_not_primitive","severity":"error","span":{"file":"tests/corpus/check/bad/markup/KeyNotPrimitive.beni","start":{"line":16,"col":34},"end":{"line":16,"col":36}},"title":"KEY IS NOT PRIMITIVE","message":"This key is not a type whose `==` is identity:\n\n    Todo\n\nKeys are compared by identity, and two equal keys must be one row, so a key is a\n`String`, `Int`, `Float`, `Char`, `Bool` or `Order`. A record compared by\nidentity would make two equal keys two rows.\n\nHint: key by a field, `keyed={.id}`."},{"code":"key_not_primitive","severity":"error","span":{"file":"tests/corpus/check/bad/markup/KeyNotPrimitive.beni","start":{"line":17,"col":37},"end":{"line":17,"col":39}},"title":"KEY IS NOT PRIMITIVE","message":"This key is not a type whose `==` is identity:\n\n    { id : Int, label : String }\n\nKeys are compared by identity, and two equal keys must be one row, so a key is a\n`String`, `Int`, `Float`, `Char`, `Bool` or `Order`. A record compared by\nidentity would make two equal keys two rows.\n\nHint: key by a field, `keyed={.id}`."},{"code":"key_not_primitive","severity":"error","span":{"file":"tests/corpus/check/bad/markup/KeyNotPrimitive.beni","start":{"line":22,"col":51},"end":{"line":22,"col":54}},"title":"KEY IS NOT PRIMITIVE","message":"I cannot tell what type this key has, and a key's type must be known.\n\nKeys are compared by identity, and two equal keys must be one row, so a key is a\n`String`, `Int`, `Float`, `Char`, `Bool` or `Order`. A record compared by\nidentity would make two equal keys two rows.\n\nHint: key by a field, `keyed={.id}`."}]
