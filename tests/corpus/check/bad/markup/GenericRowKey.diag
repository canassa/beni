[{"code":"key_not_primitive","severity":"error","span":{"file":"tests/corpus/check/bad/markup/GenericRowKey.beni","start":{"line":8,"col":43},"end":{"line":8,"col":51}},"title":"KEY IS NOT PRIMITIVE","message":"I cannot tell what type this key has, and a key's type must be known.\n\nKeys are compared by identity, and two equal keys must be one row, so a key is a\n`String`, `Int`, `Float`, `Char`, `Bool` or `Order`. A record compared by\nidentity would make two equal keys two rows.\n\nHint: key by a field, `keyed={.id}`."}]
