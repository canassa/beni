[{"code":"untyped_event_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedContextMenu.beni","start":{"line":10,"col":17},"end":{"line":10,"col":32}},"title":"UNTYPED EVENT ATTRIBUTE","message":"`\"oncontextmenu\"` writes an event handler as an untyped attribute.\n\nA page runs the text of an attribute whose name begins with `on` as script, so\na value there could inject one. Handle the event with the typed event\nattribute the vocabulary declares, which takes a message:\n\n    onClick={Clicked}\n\nHint: this element takes `onContextMenu`."}]
