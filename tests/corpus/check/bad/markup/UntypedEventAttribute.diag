[{"code":"untyped_event_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedEventAttribute.beni","start":{"line":11,"col":13},"end":{"line":11,"col":22}},"title":"UNTYPED EVENT ATTRIBUTE","message":"`\"onclick\"` writes an event handler as an untyped attribute.\n\nA page runs the text of an attribute whose name begins with `on` as script, so\na value there could inject one. Handle the event with the typed event\nattribute the vocabulary declares, which takes a message:\n\n    onClick={Clicked}\n\nHint: this element takes `onClick`."},{"code":"untyped_event_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedEventAttribute.beni","start":{"line":11,"col":34},"end":{"line":11,"col":47}},"title":"UNTYPED EVENT ATTRIBUTE","message":"`\"ONMOUSEOVER\"` writes an event handler as an untyped attribute.\n\nA page runs the text of an attribute whose name begins with `on` as script, so\na value there could inject one. Handle the event with the typed event\nattribute the vocabulary declares, which takes a message:\n\n    onClick={Clicked}"}]
