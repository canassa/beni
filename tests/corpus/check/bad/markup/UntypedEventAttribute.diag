[{"code":"untyped_event_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedEventAttribute.beni","start":{"line":10,"col":21},"end":{"line":10,"col":30}},"title":"UNTYPED EVENT ATTRIBUTE","message":"`\"onclick\"` writes an event handler as an untyped attribute.\n\nA page runs the text of an attribute whose name begins with `on` as script, so\na value there could inject one. Handle the event with the typed event\nattribute the vocabulary declares, which takes a message:\n\n    onClick={Clicked}\n\nHint: this element takes `onClick`."},{"code":"untyped_event_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/markup/UntypedEventAttribute.beni","start":{"line":10,"col":42},"end":{"line":10,"col":55}},"title":"UNTYPED EVENT ATTRIBUTE","message":"`\"ONMOUSEOVER\"` writes an event handler as an untyped attribute.\n\nA page runs the text of an attribute whose name begins with `on` as script, so\na value there could inject one. Handle the event with the typed event\nattribute the vocabulary declares, which takes a message:\n\n    onClick={Clicked}"}]
