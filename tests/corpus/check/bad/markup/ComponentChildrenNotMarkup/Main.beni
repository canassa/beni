-- Markup written between a component's tags is its `children`, and a
-- component whose `children` is not markup is told so, naming the field and
-- its type (language.md §11.8): `Label.view` takes a `String`, so
-- `<Label><b>x</b></Label>` is a type_mismatch at the tag (13:10), not a
-- complaint that the markup sends other messages than the markup around it.
import Html exposing (Html)
import Ui.Label as Label


pub view : Html msg
view =
    <div>
        <Label>
            <b>x</b>
        </Label>
    </div>
