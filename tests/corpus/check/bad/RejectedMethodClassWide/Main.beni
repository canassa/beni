-- A method a concrete type rejected is rejected in silence for every
-- later use on the same class, whatever order the class was merged in:
-- §9.5's flag is OR-merged on every union (checker-v2.md §9.5).
-- `x` and `y` become one `T` in both functions — through
-- `[ x, y ]` in `f1` and `[ y, x ]` in `f2` — so `y.foo ()` is `x.foo ()`'s
-- rejection again: ONE `unknown_method` per function, not one per use.
-- Keeping the flag on the root at rejection time would report `f2`'s
-- second use, so the list's order would change
-- the diagnostics.
import T exposing (T)


f1 x y =
    let
        a = x.foo ()
        b = [ x, T.T 1 ]
        c = [ x, y ]
        d = y.foo ()
    in
    0


f2 x y =
    let
        a = x.foo ()
        b = [ x, T.T 1 ]
        c = [ y, x ]
        d = y.foo ()
    in
    0
