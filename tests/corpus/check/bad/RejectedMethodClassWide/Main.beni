-- CK-37: a method a concrete type rejected is rejected in silence for every
-- later use on the same class, whatever order the class was merged in:
-- §9.5's flag is OR-merged on every union (checker-v2.md §9.5; as built by
-- R6a's review, S3). `x` and `y` become one `T` in both functions — through
-- `[ x, y ]` in `f1` and `[ y, x ]` in `f2` — so `y.foo ()` is `x.foo ()`'s
-- rejection again: ONE `unknown_method` per function. On 68186fa v1 reports
-- all four uses; R6a's first round kept the flag on the root at rejection
-- time and reported `f2`'s second (review F3), so the list's order changed
-- the diagnostics.
import T exposing (T)


f1 x y =
    let
        a =
            x.foo ()

        b =
            [ x, T.T 1 ]

        c =
            [ x, y ]

        d =
            y.foo ()
    in
    0


f2 x y =
    let
        a =
            x.foo ()

        b =
            [ x, T.T 1 ]

        c =
            [ y, x ]

        d =
            y.foo ()
    in
    0
