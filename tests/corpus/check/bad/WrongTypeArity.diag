[{"code":"wrong_type_arity","severity":"error","span":{"file":"tests/corpus/check/bad/WrongTypeArity.beni","start":{"line":4,"col":12},"end":{"line":4,"col":17}},"title":"WRONG TYPE ARITY","message":"`Maybe` takes 1 type argument, but here it has 0.\n\nEvery type constructor is fully applied — beni has no higher-kinded types — so\nthe number has to match the declaration exactly."},{"code":"wrong_type_arity","severity":"error","span":{"file":"tests/corpus/check/bad/WrongTypeArity.beni","start":{"line":9,"col":12},"end":{"line":9,"col":15}},"title":"WRONG TYPE ARITY","message":"`Int` takes 0 type arguments, but here it has 1.\n\nEvery type constructor is fully applied — beni has no higher-kinded types — so\nthe number has to match the declaration exactly."}]
