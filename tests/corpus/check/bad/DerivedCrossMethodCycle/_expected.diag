[{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedCrossMethodCycle/CompareFirst.beni","start":{"line":13,"col":8},"end":{"line":13,"col":9}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    T\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedCrossMethodCycle/CompareFirst.beni","start":{"line":16,"col":8},"end":{"line":16,"col":10}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    T\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedCrossMethodCycle/EqFirst.beni","start":{"line":13,"col":8},"end":{"line":13,"col":10}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    T\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedCrossMethodCycle/EqFirst.beni","start":{"line":16,"col":8},"end":{"line":16,"col":9}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    T\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"}]
