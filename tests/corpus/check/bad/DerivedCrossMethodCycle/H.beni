-- A regression guard: derived contexts that depend ACROSS `eq` and
-- `compare`. `H.eq` needs `a.compare` and `H.compare` needs `a.eq`, and
-- `T` holds an `H.Holder (Maybe T)` beside a `P.Q`, which wraps a function
-- and has a `compare` but no `eq`. So `T` answers neither: `==` is
-- `not_equatable` and `<` is `no_methods_on_shape`, in both orders of the
-- two comparisons (`EqFirst` and `CompareFirst`). The fixpoint over derived
-- contexts must refuse both exactly so.
--
pub type Holder a
    = Holder a


pub eq : Holder a, Holder a → Bool
    where a.compare : a, a → Order
eq (Holder x) (Holder y) = x.compare y == EQ


pub compare : Holder a, Holder a → Order
    where a.eq : a, a → Bool
compare (Holder x) (Holder y) =
    if x.eq y then
        EQ
    else
        LT
