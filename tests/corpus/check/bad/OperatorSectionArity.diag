[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":14,"col":13},"end":{"line":14,"col":15}},"title":"TOO FEW ARGS","message":"The (==) operator expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    a\n\nHint: every call supplies every argument. To make a function out of this one,\nwrite the missing argument as `_`: `f a _` is `λx -> f a x`.\n"},{"code":"too_many_args","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":18,"col":12},"end":{"line":18,"col":13}},"title":"TOO MANY ARGS","message":"The (<) operator expects 2 arguments, but it got 3.\n\nAre there any missing commas? Or missing parentheses?\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":22,"col":21},"end":{"line":22,"col":22}},"title":"TYPE MISMATCH","message":"The 2nd argument to (<) is not what I expect:\n\nThis argument is:\n\n    number\n\nBut (<) needs the 2nd argument to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: want to turn a number into a `String`? Use `String.fromInt` or\n`String.fromFloat`.\n"},{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":26,"col":17},"end":{"line":26,"col":18}},"title":"TOO FEW ARGS","message":"This value expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    a\n\nHint: every call supplies every argument. To make a function out of this one,\nwrite the missing argument as `_`: `f a _` is `λx -> f a x`.\n"}]
