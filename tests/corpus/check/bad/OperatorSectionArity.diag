[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":10,"col":6},"end":{"line":10,"col":8}},"title":"TOO FEW ARGS","message":"The (==) operator expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    a\n\nHint: every call supplies every argument. To make a function out of this one,\nwrite the missing argument as `_`: `f a _` is `\\x -> f a x`.\n"},{"code":"too_many_args","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":15,"col":6},"end":{"line":15,"col":7}},"title":"TOO MANY ARGS","message":"The (<) operator expects 2 arguments, but it got 3.\n\nAre there any missing commas? Or missing parentheses?\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":20,"col":9},"end":{"line":20,"col":10}},"title":"TYPE MISMATCH","message":"The 1st argument to (<) is not what I expect:\n\nThis argument is:\n\n    String\n\nBut (<) needs the 1st argument to be:\n\n    number\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*`, `<`, `>`, `<=` and `>=` work on numbers only. To join\ntext use `++`, and to order it use `String.compare`.\n"},{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/bad/OperatorSectionArity.beni","start":{"line":25,"col":5},"end":{"line":25,"col":6}},"title":"TOO FEW ARGS","message":"This value expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    a\n\nHint: every call supplies every argument. To make a function out of this one,\nwrite the missing argument as `_`: `f a _` is `\\x -> f a x`.\n"}]
