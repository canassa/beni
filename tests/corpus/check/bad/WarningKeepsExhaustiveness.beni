-- A WARNING on a declaration does not switch off its exhaustiveness
-- and refutability checks — only a type ERROR does (checker.md §6.6,
-- checker-v2.md §15.2). Both declarations are `pub` and unannotated with an
-- inferred `a.eq`, so each gets the `ambiguous_method_receiver` warning, and
-- each still gets its own error: `pick`'s `case` lacks `Blue`, and `size`'s
-- parameter pattern `(Circle r)` is refutable. Printing only the two
-- warnings and exiting 0 would build a program where `pick 1 1 Blue` prints
-- `green` and `size 1 1 (Square 7)` prints `7`. The same file without `pub`
-- reports both errors, at the positions below.

type Colour
    = Red
    | Green
    | Blue


type Shape
    = Circle Int
    | Square Int


pub pick a b c =
    if a == b then
        case c of
            Red ->
                "red"

            Green ->
                "green"
    else
        "no"


pub size a b (Circle r) =
    if a == b then
        r
    else
        0
