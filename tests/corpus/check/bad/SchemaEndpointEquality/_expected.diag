[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaEndpointEquality/Main.beni","start":{"line":6,"col":10},"end":{"line":6,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Box.Type\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaEndpointEquality/Main.beni","start":{"line":11,"col":10},"end":{"line":11,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    A.Type\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
