[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaEndpointEquality/Main.beni","start":{"line":5,"col":24},"end":{"line":5,"col":26}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Box.Type\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaEndpointEquality/Main.beni","start":{"line":9,"col":31},"end":{"line":9,"col":33}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    A.Type\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
