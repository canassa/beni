[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetQueueNotGeneral.beni","start":{"line":13,"col":26},"end":{"line":13,"col":39}},"title":"TYPE MISMATCH","message":"The 2nd argument to `offer` is not what I expect:\n\nThis argument is:\n\n    Int\n\nBut `offer` needs the 2nd argument to be:\n\n    String\n\nHint: `box` is a value of a block that is computed, once, where it is\nwritten: its right-hand side calls something, or is an `if`, a `case` or a\nblock. A computation can make something that holds values, such as a new\n`Ref`, and one such thing cannot hold two types, so `box` has ONE type inside\nthe definition that holds it (`docs/design/checker-v2.md` §8.4). The first\nuse fixed the type; this one disagrees.\n\nGive `box` a parameter, so that each call makes a new one, to use it at two.\n"}]
