[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementFailedInsideEq/Main.beni","start":{"line":18,"col":27},"end":{"line":18,"col":29}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Hid Key\n\nIt holds a `Key`, and comparing that needs the `key` of `Key` at this type:\n\n    Key, () -> Int\n\nbut `Key.key` is:\n\n    Key, () -> String\n\nHint: give `Key.key` that type, or compare the values another way.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementFailedInsideEq/Main.beni","start":{"line":23,"col":19},"end":{"line":23,"col":21}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    W\n\nIt holds a `Key`, and comparing that needs the `key` of `Key` at a type that\n`Key.key` does not have.\n\nHint: give `Key.key` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementFailedInsideEq/Main.beni","start":{"line":28,"col":25},"end":{"line":28,"col":27}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Wrap\n\nIt holds a `T`, and comparing that needs the `eq` of `T` at a type that\n`Odd.eq` does not have.\n\nHint: give `Odd.eq` the type it is asked for, or compare the values another\nway.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementFailedInsideEq/Wrapped.beni","start":{"line":19,"col":11},"end":{"line":19,"col":13}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    W\n\n`W` gets its `==` from what it holds, and its `W` holds:\n\n    Holder Key\n\nComparing that needs the `key` of `Key` at a type that `Key.key` does not\nhave.\n\nHint: give `Key.key` the type it is asked for, or compare the values another\nway.\n"}]
