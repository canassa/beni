-- See Main.beni. A concrete payload: the derived context's own pass
-- meets `Key.key` at the wrong type, so the reason rides on the answer here
-- and on the published row in `Main`.
import Holder
import Key


pub type W
    = W (Holder.Holder Key.Key)


pub mkW : Int -> W
mkW n = W (Holder.Holder (Key.Key n))


local : Bool
local = mkW 1 == mkW 2
