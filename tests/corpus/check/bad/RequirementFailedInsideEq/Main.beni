-- `==` refused because a method a derived `==` needs exists with the
-- wrong type names that method and says why, instead of NOT EQUATABLE's
-- "a function anywhere inside it rules the whole type out" — no function is
-- involved in any of these (static-dispatch-spike.md §10.13). The reason is
-- decided at the use (`hidden`, with both types), read off a derived
-- context's answer (`Wrapped.local`) and off a published row (`wrapped`,
-- `wrap`) — never "That type does not support `==`" with the function
-- hint for all four.
import Hidden
import Key
import Odd
import Wrap
import Wrapped


hidden : Bool
hidden =
    Hidden.mk (Key.Key 1) == Hidden.mk (Key.Key 2)


wrapped : Bool
wrapped =
    Wrapped.mkW 1 == Wrapped.mkW 2


wrap : Bool
wrap =
    Wrap.Wrap (Odd.T 1) == Wrap.Wrap (Odd.T 2)
