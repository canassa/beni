[{"code":"too_many_inferred_constraints","severity":"error","span":{"file":"tests/corpus/check/bad/CapNamesReceivers.beni","start":{"line":9,"col":1},"end":{"line":9,"col":2}},"title":"TOO MANY INFERRED CONSTRAINTS","message":"`f` has no annotation, and the type I inferred for it needs 70 methods.\nI stop at 64.\n\nThe first 5 are `a.eq`, `b.eq`, `c.eq`, `d.eq` and `e.eq`.\n\nEach one is an argument I have to pass at every call to `f`, and a line in\nthis module's interface that every importer is checked against. A list this\nlong is almost always a chain of unannotated helpers, each one inheriting\nwhat the one before it needed.\n\nHint: annotate `f`. An annotation pins the type, and a `where` clause you\nwrite yourself may name as many methods as you like.\n"}]
