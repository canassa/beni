[{"code":"type_dispatch_needs_annotation","severity":"error","span":{"file":"tests/corpus/check/bad/TypeDispatchUnannotated.beni","start":{"line":7,"col":13},"end":{"line":7,"col":20}},"title":"TYPE DISPATCH NEEDS AN ANNOTATION","message":"`a` is a type, not a value, and I need to be told what `a.decode` is.\n\n`a` is a type variable of this declaration's annotation, so `a.decode` is a\ndispatch on the type. That needs a `where` clause naming it:\n\n    where a.decode : a -> Result String a2\n"}]
