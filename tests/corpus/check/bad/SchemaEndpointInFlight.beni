-- A comparison of a PARAMETRIC schema endpoint made while the
-- schema's own group is in flight (checker-v2.md §11.2 *Blocked*,
-- §11.5). `conv` is unannotated and compares
-- `Page.Type`s, and `Page`'s `via` is `conv`, so `conv` and `Page` are one
-- group: the endpoint's payload is `conv`'s target, which is being
-- inferred at the comparison, and `Page` has a parameter, so its context's
-- entries would depend on it. The comparison is `method_needs_annotation`,
-- naming the schema and the conversion to annotate; annotating `conv` takes
-- it out of the group and lifts it. A CLOSED endpoint in the same position
-- is deferred and checked once the group is done
-- (`tests/corpus/check/good/SchemaEndpointInFlightClosed.beni`). It must
-- not check clean by reading the endpoint's properties as the last settle
-- left them, before `conv`'s target exists.
import Schema exposing (Conversion)


mk : Int -> Conversion Int Int
mk n = Debug.todo "checker-only conversion"


conv =
    if Page.One { item = 1, extra = 1 } == Page.One { item = 2, extra = 2 } then
        mk 0
    else
        mk 1


pub schema Page a tagged "kind" of
    One as "one"
        item : a
        extra : Int via conv
