-- `missing_where_constraint` is reported at the use that needs the
-- method — here the `==` — never at the annotation or an unrelated
-- declaration (static-dispatch-spike.md §6.2 Rule U2, "at the flex's
-- region"; checker-v2.md §15.4, the resolver reports at `w.origin`). The
-- unrelated `type` above it (its payload `Int`), or without it the
-- annotation's `a`, is the wrong place: the report is at the use's own
-- region, not at a region nothing set.

type Unrelated
    = Unrelated Int


direct : a, a -> Bool
direct x y = [ x ] == [ y ]
