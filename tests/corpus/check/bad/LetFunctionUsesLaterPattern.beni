-- A `let` function may use a variable a `let` PATTERN binds further
-- down (a function is hoisted), and the variable's type must reach it. Here
-- `c` returns `a`, and `String.length a` makes `a` a `String`, so `f`'s
-- argument is `( String, b )` and `f ( 5, 0 )` is a mismatch at the tuple.
-- A `let` SCC that gave no edge to a pattern binding would solve and
-- generalise `c`'s group before the pattern's: `f : ( a, b ) -> ( c, Int )`,
-- and `bad` would check clean — `String.length` would then run on `5`.
-- checker-v2.md §6.2: a pattern is an SCC target for every
-- variable it binds.


f p =
    let
        c u =
            a

        ( a, b ) =
            p
    in
    ( c 1, String.length a )


bad =
    f ( 5, 0 )
