-- A declaration that failed is published as `<error>`, not as its
-- partially solved type. This is `check/bad/DeferredReceiverJoinedInGroup`
-- with its top-level declarations reversed: `ma` is refused
-- (`no_methods_on_shape` at `h x`) in either order, and `Publish.fill`
-- must not publish its scheme: in source
-- order `ma : K, { combine : number -> number } -> number2`; reversed, as
-- here, `… -> number`. Were it published, `Main`'s use would check against
-- the first and be a TYPE MISMATCH against the second (`Float` for `Int`),
-- so a dependent's verdict would follow the order of a failed module's declarations.
-- Expected: `Lib`'s one error, and `Main` silent against a poisoned `ma`.
-- Oracle twin: `Lib` in source order (`check/bad/…InGroup`'s) gives only
-- `Lib`'s error.
pub ma (K n) x =
    _ = (K n).mb 0

    p = x.combine 1

    q = h x
    p + q


pub mb (K n) y =
    if n > 0 then
        y
    else
        _ = (K 1).ma { combine = λz -> z + 1 }
        y


h a = a.combine 1


pub type K
    = K Int
