[{"code":"rigid_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetRefAnnotatedTooGeneral.beni","start":{"line":10,"col":9},"end":{"line":10,"col":12}},"title":"TYPE MISMATCH","message":"The type annotation of `r` promises more than its value can keep:\n\n    r : Ref (List a)\n\nThe annotation says `a` can be ANY type, but the value of `r` is made by a\ncall, once, where it is written. A call can make something that holds a `a`,\nsuch as a new `Ref`, and one such thing cannot hold every type: written as\none type and read as another, it would give a wrong answer.\n\nHint: write the type `r` holds in the annotation instead of `a`, or give\n`r` a parameter so that each call makes a new one.\n"}]
