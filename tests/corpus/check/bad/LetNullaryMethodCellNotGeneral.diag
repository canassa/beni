[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetNullaryMethodCellNotGeneral.beni","start":{"line":22,"col":31},"end":{"line":22,"col":32}},"title":"TYPE MISMATCH","message":"The 1st argument to (+) is not what I expect:\n\nThis argument is:\n\n    String\n\nBut (+) needs the 1st argument to be:\n\n    Int\n\nHint: `r` is a value of a block that is computed, once, where it is\nwritten: its right-hand side calls something, or is an `if`, a `case` or a\nblock. A computation can make something that holds values, such as a new\n`Ref`, and one such thing cannot hold two types, so `r` has ONE type inside\nthe definition that holds it (`docs/design/checker-v2.md` §8.4). The first\nuse fixed the type; this one disagrees.\n\nGive `r` a parameter, so that each call makes a new one, to use it at two.\n"}]
