[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SubjectFirstSwap.beni","start":{"line":9,"col":14},"end":{"line":9,"col":28}},"title":"TYPE MISMATCH","message":"The 1st argument to `map` is not what I expect:\n\nThis argument is:\n\n    Int -> String\n\nBut `map` needs the 1st argument to be:\n\n    List a\n\nHint: this function looks like it belongs in the 2nd argument, which takes\none. beni's functions take their subject first — `List.map list f`, where\nElm writes `List.map f list` — so the arguments may be the wrong way round.\n"}]
