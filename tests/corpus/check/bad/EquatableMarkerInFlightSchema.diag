[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EquatableMarkerInFlightSchema.beni","start":{"line":27,"col":8},"end":{"line":27,"col":17}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    Loop.Type\n\nThat type does not support `Basics.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
