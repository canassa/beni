-- Explicit `Basics.eq` on a closed schema endpoint compared while
-- the schema's group is in flight (checker-v2.md §11.4): `h` compares
-- `Loop.Type`s, `conv` calls `h`, and
-- `Loop`'s `via` is `conv`, so the gate cannot be read while `h` is checked.
-- It is asked again in P5, when `conv`'s target is known to be
-- `Int -> Int`: `not_equatable` at the comparison — as the `==` twin says
-- (`SchemaEndpointInFlightFunction`). The unfilled target must never read
-- as "no function", which would accept the program.
--
import Schema exposing (Conversion)


mk : Int → Conversion Int (Int → Int)
mk n = Debug.todo "checker-only conversion"


mkLoop : Int → Loop.Type
mkLoop n = Debug.todo "l"


h n =
    if Basics.eq (mkLoop n) (mkLoop 2) then
        n
    else
        n


conv = mk (h 1)


pub schema Loop tagged "kind" of
    Step as "step"
        payload : Int via conv
