-- check/bad: `==` on a tuple whose first position is a type that holds a
-- function is `not_equatable` at the comparison (static-dispatch-spike.md
-- §6.3; checker-v2.md §9.5, THE derivability verdict). `h` is still a
-- variable when the comparison is solved and becomes `Handler` only in the
-- `then` branch, so the verdict is asked of a position that was a flex when
-- the shape was first walked. A `walked` shortcut that never re-asked would
-- accept this program.
--
type Handler
    = Handler (Int -> Int)


check h =
    if ( h, 1 ) == ( h, 1 ) then
        [ h, Handler (λn -> n) ]
    else
        []
