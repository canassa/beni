-- The two-member form of `EvidenceFunctionConstantCycle`.
-- `h` and `k` are point-free values of function type with a `where`, each
-- defined through the other: one `cyclic_value` for the circle, at `h`.
-- A clean check here would build a program that overflows the stack when run.
compose : (b → c), (a → b) → (a → c)
compose f g = λx → f (g x)


keep : a → a
    where a.eq : a, a → Bool
keep x =
    if x == x then
        x
    else
        x


twice : (a → a) → (a → a)
twice f = λx → f (f x)


h : a → a
    where a.eq : a, a → Bool
h = compose k keep


k : a → a
    where a.eq : a, a → Bool
k = twice h
