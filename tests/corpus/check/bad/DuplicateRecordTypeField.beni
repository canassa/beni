-- A record TYPE that names one field twice is `duplicate_field` at
-- the second one, the same code a record literal gets (language.md §4) —
-- not a clean check while unused that, used, cascades into "This record
-- does not have a `a` field: `{ a : a }` … need `{ a : Int, a : String }`",
-- with the declaration dumped as `? -> String`.

type alias R =
    a : Int
    a : String
