-- While a mutually recursive group is solved, each member's locals
-- are its own (checker-v2.md §6.2: the solver reads no generation-time
-- context). `y` is a `String` (it reaches
-- `String.toUpper`), so `g`'s `f a 5` is a `type_mismatch` at `5`. Resolving
-- `f`'s locals against `g`'s would infer `f : number, number2 -> Int`, and
-- the built program would die with `TypeError: s.toUpperCase is not a function`.


f x y =
    if x == 0 then
        String.length (String.toUpper y)

    else
        g (x - 1)


g a =
    f a 5


use : Int
use =
    g 1
