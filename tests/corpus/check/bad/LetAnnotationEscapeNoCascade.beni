-- After an escape is reported, what the body tied the rigid to — the
-- lambda parameter `z` — is poisoned with it, so the application to `x` adds
-- no second message about `a` outside `g` (checker-v2.md §8.3): no TYPE
-- MISMATCH at 16:9 naming `g`'s `a`, and the escape itself is not missed.
--
coerce : b → String
coerce x =
    (λz →
        g : a → a
        g y = z
        g "s"
    )
        x
