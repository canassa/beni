-- A `Show` that does not say when it remounts is told the `case` it would
-- be, written from its own `when`, body and `fallback` (language.md §11.18):
-- `keyed={False}` (11:13) and a missing `keyed` (19:10), a multi-line body
-- kept as written, a body that is a function called with the value, and an
-- empty fragment for a `Show` with no `fallback`.
view model =
    <div>
        <Show
            when={model.selected}
            fallback={<p>Nothing picked</p>}
            keyed={False}
        >
            {λitem ->
                <section>
                    <h2>{item.title}</h2>
                </section>
            }
        </Show>
        <Show when={model.hovered}>{viewCard}</Show>
    </div>


viewCard card = <p>{card.title}</p>
