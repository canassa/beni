[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CallStyleFieldIsFunction.beni","start":{"line":6,"col":14},"end":{"line":6,"col":21}},"title":"TYPE MISMATCH","message":"This is not a record with a `length` field:\n\nIt is:\n\n    List Int\n\nBut I need a record like:\n\n    { r | length : Int }\n\nHint: `length` is a function of `List`, not a field. Write `List.length xs` — a\nmethod call needs its other arguments, `x.m a`, so one that takes none is\nwritten as a call.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CallStyleFieldIsFunction.beni","start":{"line":10,"col":17},"end":{"line":10,"col":22}},"title":"TYPE MISMATCH","message":"This is not a record with a `take` field:\n\nIt is:\n\n    List Int\n\nBut I need a record like:\n\n    { r | take : List Int }\n\nHint: `take` is a function of `List`, not a field, and it takes 1 more argument:\nwrite them after it, `xs.take …`.\n"}]
