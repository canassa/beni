[{"code":"vocabulary_outside_platform","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupVocabularyOutsidePlatform.beni","start":{"line":4,"col":1},"end":{"line":4,"col":20}},"title":"VOCABULARY OUTSIDE PLATFORM","message":"This vocabulary declaration is outside a platform package.\n\n`pub element`, `pub attribute`, `pub event` and `pub markup` declare the markup\na platform offers (`docs/design/language.md` §11.14). Like `foreign`, they are\nlegal in a package whose manifest says `\"platform\": true`, and nowhere else."},{"code":"vocabulary_outside_platform","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupVocabularyOutsidePlatform.beni","start":{"line":7,"col":1},"end":{"line":7,"col":16}},"title":"VOCABULARY OUTSIDE PLATFORM","message":"This vocabulary declaration is outside a platform package.\n\n`pub element`, `pub attribute`, `pub event` and `pub markup` declare the markup\na platform offers (`docs/design/language.md` §11.14). Like `foreign`, they are\nlegal in a package whose manifest says `\"platform\": true`, and nowhere else."}]
