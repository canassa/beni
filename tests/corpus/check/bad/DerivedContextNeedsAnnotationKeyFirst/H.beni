-- (the twin) `DerivedContextNeedsAnnotation/` with `key` written
-- before the types `T` and `W` whose context it is asked for — the only
-- other order its one value declaration has. The same single
-- `method_needs_annotation` naming `key` (checker-v2.md
-- §11.2), never NOT EQUATABLE `W a`.
pub type Holder a
    = Holder a


pub eq : Holder a, Holder a → Bool
    where a.key : a, ⊤ → Int
eq left right =
    case left of
        Holder l →
            case right of
                Holder r →
                    l.key ⊤ == r.key ⊤
