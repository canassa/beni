[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/BridgeBlockResult.beni","start":{"line":4,"col":13},"end":{"line":4,"col":27}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`List.push` changes `xs` in place, but `xs` is read again afterwards.\n\n4|    grown = List.push xs 2\n              ^^^^^^^^^^^^^^ the list is changed in place here\n5|    xs\n      ^^ and `xs` is read here, after the change\n\nIf the list were changed in place, `xs` would see the change when it is read on\nline 5.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n4|    grown = List.push (List.copy xs) 2\n\nThis is sharing the checker can see: `xs` is read on line 5, after the change."}]
