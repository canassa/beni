[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/BridgeFoldBorrow.beni","start":{"line":9,"col":5},"end":{"line":9,"col":15}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`BridgeFoldBorrow.step` changes a list it is handed in place, but List.foldl\nhands its parameter 2 what the callback returned before, which may be a list the\ncallback does not own.\n\n9|    List.foldl rows [] step\n      ^^^^^^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is sharing the checker can see: List.foldl hands its parameter 2 what the\ncallback returned before, which may be a list the callback does not own."}]
