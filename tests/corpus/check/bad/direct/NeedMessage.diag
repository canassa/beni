[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":26,"col":12},"end":{"line":26,"col":16}},"title":"LIST CHANGED WHILE STILL IN USE","message":"A lambda must return a list it owns, but NeedMessage.edit edits what it returns,\nwhich may be a list it does not own.\n\n26|inline ⊤ = edit λ⊤ → shared\n              ^^^^ the function is handed on here\n                   ^ the function here may return a list it does not own\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: NeedMessage.edit edits what it returns,\nwhich may be a list it does not own."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":32,"col":5},"end":{"line":32,"col":9}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`give` must return a list it owns, but NeedMessage.edit edits what it returns,\nwhich may be a list it does not own.\n\n31|    give = λ⊤ → shared\n              ^ the function here may return a list it does not own\n32|    edit give\n       ^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: NeedMessage.edit edits what it returns,\nwhich may be a list it does not own."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":38,"col":5},"end":{"line":38,"col":9}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`r.load` must return a list it owns, but NeedMessage.edit edits what it returns,\nwhich may be a list it does not own.\n\n37|    r = { load = λ⊤ → shared }\n                    ^ the function here may return a list it does not own\n38|    edit r.load\n       ^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: NeedMessage.edit edits what it returns,\nwhich may be a list it does not own."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":42,"col":13},"end":{"line":42,"col":47}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `(later λ⊤ → [ 4 ]) ⊤` in place, and the checker cannot show\nthat nothing else still holds the list.\n\n42|carried ⊤ = List.push ((later λ⊤ → [ 4 ]) ⊤) 5\n               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n42|carried ⊤ = List.push (List.copy ((later λ⊤ → [ 4 ]) ⊤)) 5\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction the checker cannot identify, which may return a list something else\nholds."}]
