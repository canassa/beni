[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":53,"col":12},"end":{"line":53,"col":16}},"title":"LIST CHANGED WHILE STILL IN USE","message":"A lambda must return a list it owns, but NeedMessage.edit edits what it returns,\nwhich may be a list it does not own.\n\n53|inline ⊤ = edit λ⊤ → shared\n              ^^^^ the function is handed on here\n                   ^ the function here may return a list it does not own\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: NeedMessage.edit edits what it returns,\nwhich may be a list it does not own."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":59,"col":5},"end":{"line":59,"col":9}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`give` must return a list it owns, but NeedMessage.edit edits what it returns,\nwhich may be a list it does not own.\n\n58|    give = λ⊤ → shared\n              ^ the function here may return a list it does not own\n59|    edit give\n       ^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: NeedMessage.edit edits what it returns,\nwhich may be a list it does not own."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":65,"col":5},"end":{"line":65,"col":9}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`r.load` must return a list it owns, but NeedMessage.edit edits what it returns,\nwhich may be a list it does not own.\n\n64|    r = { load = λ⊤ → shared }\n                    ^ the function here may return a list it does not own\n65|    edit r.load\n       ^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: NeedMessage.edit edits what it returns,\nwhich may be a list it does not own."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":69,"col":13},"end":{"line":69,"col":47}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `(later λ⊤ → [ 4 ]) ⊤` in place, and the checker cannot show\nthat nothing else still holds the list.\n\n69|carried ⊤ = List.push ((later λ⊤ → [ 4 ]) ⊤) 5\n               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n69|carried ⊤ = List.push (List.copy ((later λ⊤ → [ 4 ]) ⊤)) 5\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction the checker cannot identify, which may return a list something else\nholds."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/direct/NeedMessage.beni","start":{"line":73,"col":12},"end":{"line":73,"col":21}},"title":"LIST MAY BE SHARED","message":"`NeedMessage.Fixed.parse` must return a list it owns, and the checker cannot\nshow that it does.\n\n73|member s = editParse Fixed.parse s\n              ^^^^^^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is a limit of the checker, not proof of sharing: NeedMessage.editParse\nedits what it returns, which may be a list it does not own."}]
