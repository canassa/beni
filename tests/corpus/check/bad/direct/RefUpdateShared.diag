[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/direct/RefUpdateShared.beni","start":{"line":13,"col":28},"end":{"line":13,"col":44}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `ns` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n13|    Ref.update names λns → List.push ns \"b\"\n                              ^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n13|    Ref.update names λns → List.push (List.copy ns) \"b\"\n\nThis is a limit of the checker, not proof of sharing: Ref.update supplies its\nparameter 1 borrowed (⊤)."}]
