-- ownership (§16.7, issue #272): a declaration that reaches a limit is one
-- error, and what follows from its pessimistic summary is not a second one.
-- `rotateF` does not settle within 32 rounds, so its summary is the
-- pessimistic one; before, `writer` and `reader` were refused beside the
-- limit (a `need` told as a list changed while in use, and a `pending`
-- line), though only the limit is the cause. Now those lines take the
-- `limit` cause and the build has the limit's error alone.
rotateF :
      (List Int → List Int)
    , Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    , List Int
    → List Int
rotateF f k p00 p01 p02 p03 p04 p05 p06 p07 p08 p09 p10 p11 p12 p13 p14 p15 p16 p17 p18 p19 p20 p21 p22 p23 p24 p25 p26 p27 p28 p29 p30 p31 p32 p33 p34 p35 p36 p37 p38 p39 =
    if k == 0 then
        f p00
    else
        rotateF
            f
            (k - 1)
            p01
            p02
            p03
            p04
            p05
            p06
            p07
            p08
            p09
            p10
            p11
            p12
            p13
            p14
            p15
            p16
            p17
            p18
            p19
            p20
            p21
            p22
            p23
            p24
            p25
            p26
            p27
            p28
            p29
            p30
            p31
            p32
            p33
            p34
            p35
            p36
            p37
            p38
            p39
            p00


pub writer : List Int → List Int
writer xs =
    rotateF
        (λys → List.push ys 1)
        3
        xs
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []


pub reader : List Int → List Int × List Int
reader xs =
    ( rotateF
        (λys → ys)
        3
        xs
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
        []
    , xs
    )


-- A writing function handed to `rotateF` and also stored in a record that
-- leaves the walk's sight has an error of its own, which the limit's must
-- not hide: `storedAndHanded` (a lambda) and `storedFunction` (a top-level
-- function) are each still reported where the function is stored.
type alias Holder =
    f : List Int → List Int


pushOne : List Int → List Int
pushOne ys = List.push ys 1


pub storedAndHanded : List Int → List Int × Holder
storedAndHanded xs =
    g = λys → List.push ys 1
    r =
        rotateF
            g
            3
            xs
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
    ( r, { f = g } )


pub storedFunction : List Int → List Int × Holder
storedFunction xs =
    r =
        rotateF
            pushOne
            3
            xs
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
            []
    ( r, { f = pushOne } )
