[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/direct/SchemaConversionShared.beni","start":{"line":18,"col":15},"end":{"line":18,"col":31}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `ws` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n14|run held input =\n       ^^^^ `held` keeps the list here\n16|    case Schema.parse (Schema.converted Schema.string back) input of\n                          ^^^^^^^^^^^^^^^^ `held` may hold the list through this call\n18|            ( List.push ws \"x\", held )\n                 ^^^^^^^^^^^^^^ the list is changed in place here\n                                   ^^^^ and `held` is read here, after the change\n\nTo be safe, change a copy:\n\n18|            ( List.push (List.copy ws) \"x\", held )\n\nThis is a limit of the checker, not proof of sharing: held may hold it through\nthe call at 16:24, and is read at 18:13."}]
