[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/ListSpreadShared.beni","start":{"line":9,"col":7},"end":{"line":9,"col":17}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`[ …xs, 4 ]` adds to the end of `xs` itself, but `xs` is read again afterwards.\n\n9|    [ [ …xs, 4 ], [ …xs, …xs ], xs ]\n        ^^^^^^^^^^ the list is changed in place here\n                       ^^ and `xs` is read here, after the change\n\nIf the list were changed in place, `xs` would see the change when it is read on\nline 9.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n9|    [ [ …List.copy xs, 4 ], [ …xs, …xs ], xs ]\n\nThis is sharing the checker can see: `xs` is read on line 9, after the change."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/direct/ListSpreadShared.beni","start":{"line":9,"col":19},"end":{"line":9,"col":31}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`[ …xs, …xs ]` adds to the end of `xs` itself, but another part of the same\noperation reads the same list.\n\n9|    [ [ …xs, 4 ], [ …xs, …xs ], xs ]\n                    ^^^^^^^^^^^^ the list is changed in place here\n\nIf the list were changed in place, the other part would read it changed.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n9|    [ [ …xs, 4 ], [ …List.copy xs, …xs ], xs ]\n\nThis is sharing the checker can see: two parts of one operation reach the same\nlist."}]
