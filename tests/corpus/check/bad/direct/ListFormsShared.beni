-- `run/ListForms` with its forms shared: a top-level list spread into a
-- longer one and set at an index, and one form appended to every other
-- while it is still read. Lists are edited in place, so each would change
-- a list another reader still sees (`ownership-checker.md` §30); the
-- checker refuses all three, and `run/ListForms` makes each form in a
-- function and copies `xs` instead.
plain : List Int
plain = List.range 1 40


pub longer : ⊤ → List Int
longer ⊤ = [ …plain, 41 ]


pub larger : ⊤ → List Int
larger ⊤ = List.set plain 39 41


pub lengths : List Int, List (List Int) → List Int
lengths xs others = List.map others λys → List.length (xs ++ ys)
