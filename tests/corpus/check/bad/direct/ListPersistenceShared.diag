[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/direct/ListPersistenceShared.beni","start":{"line":12,"col":13},"end":{"line":12,"col":26}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `v` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n10|run versions =\n       ^^^^^^^^ `versions#Dict.0#Node.2` keeps the list here\n11|    v = Dict.get versions 0 ▷ Maybe.withDefault []\n                                 ^^^^^^^^^^^^^^^^^ `versions#Dict.0#Node.2` may hold the list through this call\n12|    newer = List.push v 3\n               ^^^^^^^^^^^^^ the list is changed in place here\n13|    ( newer, Dict.get versions 0 )\n                         ^^^^^^^^ and `versions#Dict.0#Node.2` is read here, after the change\n\nTo be safe, change a copy:\n\n12|    newer = List.push (List.copy v) 3\n\nThis is a limit of the checker, not proof of sharing: versions#Dict.0#Node.2 may\nhold it through the call at 11:31, and is read at 13:14."}]
