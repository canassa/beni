[{"code":"name_removed","severity":"error","span":{"file":"tests/corpus/check/bad/NameRemovedMethod.beni","start":{"line":6,"col":11},"end":{"line":6,"col":17}},"title":"REMOVED NAME","message":"`modBy` was removed: beni's `modBy n 2` read as Elm's `modBy 2 n`. Write\n`Int.mod n 2`, the arguments in the order they had. `Int` is a prelude\nmodule, so it needs no import.\n\n`beni fmt --migrate-names <file>` rewrites every use in a file."}]
