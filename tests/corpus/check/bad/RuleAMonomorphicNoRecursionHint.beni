-- CK-72: D14's hint is attached only to a mismatch D14 caused (checker-v2.md
-- §10.8). `pairK` is monomorphic because its type carries `==`'s
-- requirement and a constrained `let` is not generalised until R14 (§8.4's
-- switch, rule (a)) — not because of the recursive group `f`/`g` — and the
-- same helper in a non-recursive declaration gets the same error with no
-- hint. R7's first cut added "this comes from a recursive group (`f`,
-- `g`) … Annotate `f`, `g`", which does not help (R7's adversarial review,
-- F4).
f n x =
    let
        pairK z =
            ( z, z == z )

        ( a1, _ ) =
            pairK 1

        ( a2, _ ) =
            pairK "s"
    in
    g n x


g n x =
    if n > 0 then
        x

    else
        f 1 x
