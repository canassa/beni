-- The recursive-group hint is attached only to a mismatch the recursive-group
-- rule caused (checker-v2.md §10.8). `pairK` is monomorphic because the only
-- requirement its type carries is a dot-call's own, which a `let` does not
-- generalise (§8.4) — not because of the recursive
-- group `f`/`g` — and the same helper in a non-recursive declaration gets
-- the same error with no hint. "This comes from a
-- recursive group (`f`, `g`) … Annotate `f`, `g`" would not help here.
-- The helper is not `z == z`: a `let` generalises over an operator's
-- requirement, so that program is valid.
type T
    = T Int


pub same : T, T -> Bool
same (T a) (T b) = a == b


f n x =
    pairK z = ( z, z.same z )

    ( a1, _ ) = pairK (T 1)

    ( a2, _ ) = pairK "s"
    g n x


g n x =
    if n > 0 then
        x
    else
        f 1 x
