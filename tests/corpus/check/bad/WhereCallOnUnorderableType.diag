[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/WhereCallOnUnorderableType.beni","start":{"line":29,"col":8},"end":{"line":29,"col":13}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`, which `eqGen` requires:\n\n    Handler\n\nThat type does not support `.eq`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/WhereCallOnUnorderableType.beni","start":{"line":33,"col":8},"end":{"line":33,"col":14}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    Handler\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"}]
