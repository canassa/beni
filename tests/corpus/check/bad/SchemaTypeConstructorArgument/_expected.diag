[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaTypeConstructorArgument/Main.beni","start":{"line":26,"col":15},"end":{"line":26,"col":16}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    number\n\nBut this list needs its elements to be:\n\n    Item.Type\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaTypeConstructorArgument/Main.beni","start":{"line":30,"col":24},"end":{"line":30,"col":27}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    String\n\nBut this list needs its elements to be:\n\n    Item.Type\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaTypeConstructorArgument/Main.beni","start":{"line":34,"col":22},"end":{"line":34,"col":26}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    Bool\n\nBut this list needs its elements to be:\n\n    Item.Type\n\nHint: beni has no \"truthiness\" — numbers, strings and lists are never\nautomatically a `Bool`. Do the conversion explicitly.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaTypeConstructorArgument/Main.beni","start":{"line":38,"col":23},"end":{"line":38,"col":24}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    number\n\nBut this list needs its elements to be:\n\n    Item.Type\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n"}]
