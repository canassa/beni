-- check/bad: one explicit `Basics.eq` on a record holding a function and a
-- variable later used as a function says `not_equatable` ONCE, whatever
-- order the interner gave the two field names (checker-v2.md §11.4, I13; R5's
-- structural review, B1: checker v2 as first built printed it twice when
-- `fnf` was interned before `flexf`). `flexf` is interned first here — the
-- first declaration names it; `EqOneQuestionRecordNamesFirst` is the twin
-- that interns `fnf` first. The golden is checker v1's.
flexf =
    1


k : Int -> Int
k n =
    n


h x =
    let
        t =
            Basics.eq { fnf = k, flexf = x } { fnf = k, flexf = x }
    in
    x 1
