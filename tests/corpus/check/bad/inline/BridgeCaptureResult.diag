[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/BridgeCaptureResult.beni","start":{"line":5,"col":13},"end":{"line":5,"col":27}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`List.push` changes `xs` in place, but `xs` is read again afterwards.\n\n5|    grown = List.push xs 2\n              ^^^^^^^^^^^^^^ the list is changed in place here\n6|    List.update [ [ 0 ] ] 0 λ_ → xs\n                                   ^^ and `xs` is read here, after the change\n\nIf the list were changed in place, `xs` would see the change when it is read on\nline 6.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n5|    grown = List.push (List.copy xs) 2\n\nThis is sharing the checker can see: `xs` is read on line 6, after the change."}]
