[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/ViewOfAnotherModuleInRow/Main.beni","start":{"line":33,"col":65},"end":{"line":33,"col":74}},"title":"LIST CHANGED WHILE STILL IN USE","message":"value Page.item is refused: call: another module's view, whose handlers it reads\nwhere their event fires, is used here as no piece of a view's markup: a lowering\ncan keep what a render of it made\n\nThe ownership checker refuses a write that it cannot show to be safe. Call the\nfunction directly where it writes, or hand it straight to the call that runs it,\nor change a copy (`List.copy`)."}]
