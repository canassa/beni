-- CK-233: a callee pushes what its callback returns, and the callback returns the
-- callee's own parameter: the caller's list is written while it is still read.
-- Confirmed by the in-place interpreter (bridge lead v6-17-5271); see
-- proofs/ownership/CONSTRUCTIONS-RESULTS.md. The call writes `xs`, which the
-- result record reads after it (ownership-checker.md §16.4, amended
-- 2026-10-15); the class is ownership/BridgeReturnedParameter.
pushReturned p f =
    b = f p
    List.push b 3


identity x = x


pub run ⊤ =
    xs = [ 1, 3, 2 ]
    r = pushReturned xs identity
    { f0 = r, f2 = xs }
