-- CK-223: a fold calls validators supplied from its list's elements.
-- Each validator makes its errors. Preserve that fact through work's call.
type Validation
    = Valid
    | Invalid (List Int)


collect : List (⊤ → Validation) → Validation
collect works = List.foldl works Valid λwork acc →
    case ( acc, work ⊤ ) of
        ( Invalid left, Invalid right ) →
            Invalid (left ++ right)

        ( Invalid left, Valid ) →
            Invalid left

        ( Valid, result ) →
            result


fresh : ⊤ → Validation
fresh ⊤ = Invalid [ 1 ]


pub run : ⊤ → List Int
run ⊤ =
    case collect [ fresh ] of
        Invalid xs →
            List.push xs 2

        Valid →
            []


kept : List Int
kept = [ 1 ]


shared : ⊤ → Validation
shared ⊤ = Invalid kept


pub refused : ⊤ → List Int
refused ⊤ =
    case collect [ shared ] of
        Invalid xs →
            List.push xs 2

        Valid →
            []
