[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/ListPersistenceShared.beni","start":{"line":12,"col":13},"end":{"line":12,"col":26}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `v` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n12|    newer = List.push v 3\n               ^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n12|    newer = List.push (List.copy v) 3\n\nThis is a limit of the checker, not proof of sharing: the list came from\nJavaScript."}]
