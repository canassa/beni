-- A function in a record's field, called as a method (`box.go ⊤`), starts a
-- fiber that hosts a writer of a cell it made, and a masked call follows.
-- The field's function is applied with its contract, and what that contract
-- hosts is noted as at any call of known code (`knownRuns`,
-- ownership-v3-kernel.md §13 item 12, *A defect*, (d), *The ways in*; code
-- reader CR15's U1), so the masked call is refused. Before, only the
-- refusal of the hosting function on its way into the record held.
import Cmd exposing (Cmd)
import Duration
import Html exposing (Html)
import List
import Log
import Ref exposing (Ref)
import String
import Sub
import Task
import Tea


type Msg
    = Done


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


deep : Int → Int
deep n = if n < 0 then 0 else 1 + deep (n + 1)


hosting : ⊤ → ⊤
hosting ⊤ =
    r = Ref.make [ 1, 2 ]
    _ = Task.spawn λ⊤ →
        Task.sleep (Duration.millis 1)
        Ref.update r λl →
            l2 = List.push l 5
            n = deep 0
            if n > 0 then l2 else l2
    Task.sleep (Duration.millis 5)
    Log.info (ints (Ref.get r))


masker : ⊤ → ⊤
masker ⊤ = Task.uninterruptible λ⊤ → Task.sleep (Duration.millis 30)


work : ⊤ → ⊤
work ⊤ =
    box = { go = λ⊤ → Task.spawn hosting }
    _ = box.go ⊤
    masker ⊤
    Task.sleep (Duration.millis 120)


init : ⊤ → Int × Cmd Msg
init ⊤ =
    Task.start work λ_ → ⊤
    ( 0, Cmd.none )


update : Msg, Int → Int × Cmd Msg
update msg model =
    case msg of
        Done →
            ( model + 1, Cmd.none )


view : Int → Html Msg
view model = <p>{model}</p>


main : Tea.Program
main = Tea.element { init = init, update = update, view = view, subscriptions = λ_ → Sub.none }
