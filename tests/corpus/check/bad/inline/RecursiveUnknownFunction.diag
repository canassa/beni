[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/RecursiveUnknownFunction.beni","start":{"line":20,"col":9},"end":{"line":20,"col":30}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `(a 1) ⊤` in place, and the checker cannot show that nothing\nelse still holds the list.\n\n20|bad ⊤ = List.push ((a 1) ⊤) 2\n           ^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n20|bad ⊤ = List.push (List.copy ((a 1) ⊤)) 2\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction value that may be one of several functions, and the checker does not\njoin what each returns."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/RecursiveUnknownFunction.beni","start":{"line":28,"col":21},"end":{"line":28,"col":43}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `choice ⊤` in place, and the checker cannot show that\nnothing else still holds the list.\n\n28|badThroughValue ⊤ = List.push (choice ⊤) 2\n                       ^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n28|badThroughValue ⊤ = List.push (List.copy (choice ⊤)) 2\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction value that may be one of several functions, and the checker does not\njoin what each returns."}]
