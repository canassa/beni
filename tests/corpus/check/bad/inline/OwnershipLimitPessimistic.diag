[{"code":"ownership_limit","severity":"error","span":{"file":"tests/corpus/check/bad/inline/OwnershipLimitPessimistic.beni","start":{"line":52,"col":1},"end":{"line":52,"col":8}},"title":"OWNERSHIP CHECK TOO LARGE","message":"`OwnershipLimitPessimistic.rotateF`'s ownership summary did not settle within\nthe checker's limit of 32 rounds (ownership-checker.md §16.7).\n\nThis is a limit of the compiler, not sharing in your code: the checker\ncannot tell which lists `rotateF` changes or keeps, so it refuses the build\nrather than guess."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/OwnershipLimitPessimistic.beni","start":{"line":211,"col":15},"end":{"line":211,"col":29}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `ys` in place, and the function that does it goes where the\nchecker cannot see every call of it: it is stored in a record.\n\n211|    g = λys → List.push ys 1\n                  ^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n211|    g = λys → List.push (List.copy ys) 1\n\nThis is a limit of the checker, not proof of sharing: a call it cannot see may\nhand the function a list something else still holds."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/OwnershipLimitPessimistic.beni","start":{"line":305,"col":10},"end":{"line":305,"col":11}},"title":"LIST MAY BE SHARED","message":"`OwnershipLimitPessimistic.pushOne` changes a list it is handed in place, and\nthe function that does it goes where the checker cannot see every call of it: it\nis stored in a record.\n\n305|    ( r, { f = pushOne } )\n             ^ the list is changed in place here\n\nCall it where it is written, or have it change a copy, made with `List.copy`.\n\nThis is a limit of the checker, not proof of sharing: a call it cannot see may\nhand the function a list something else still holds."}]
