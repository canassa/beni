[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/EscapedListExplanation.beni","start":{"line":9,"col":5},"end":{"line":9,"col":19}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `xs` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n9|    List.push xs 1\n      ^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n9|    List.push (List.copy xs) 1\n\nThis is a limit of the checker, not proof of sharing: it was given to\nJavaScript, or kept by a callee."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/EscapedListExplanation.beni","start":{"line":15,"col":7},"end":{"line":15,"col":21}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `xs` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n13|laterRead xs =\n             ^^ `xs` keeps the list here\n15|    ( List.push xs 1, List.length xs )\n         ^^^^^^^^^^^^^^ the list is changed in place here\n                                     ^^ and `xs` is read here, after the change\n\nTo be safe, change a copy:\n\n15|    ( List.push (List.copy xs) 1, List.length xs )\n\nThis is a limit of the checker, not proof of sharing: xs is read again at 15:23;\nit was given to JavaScript, or kept by a callee."}]
