[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/FunctionElementBorrowed.beni","start":{"line":25,"col":14},"end":{"line":25,"col":21}},"title":"LIST MAY BE SHARED","message":"A lambda must return a list it owns, and the checker cannot show that it does.\n\n25|        case collect [ Invalid ] kept of\n                ^^^^^^^ the function is handed on here\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is a limit of the checker, not proof of sharing:\nFunctionElementBorrowed.collect edits what it returns, which may be a list it\ndoes not own."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/FunctionElementBorrowed.beni","start":{"line":27,"col":17},"end":{"line":27,"col":31}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `xs` in place, and the checker cannot show that nothing else\nstill holds the list.\n\n27|                List.push xs 2\n                   ^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n27|                List.push (List.copy xs) 2\n\nThis is a limit of the checker, not proof of sharing: the list came from\nJavaScript."}]
