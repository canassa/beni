[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/UnknownCalleeShared.beni","start":{"line":20,"col":5},"end":{"line":20,"col":22}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `f ⊤` in place, and the checker cannot show that nothing\nelse still holds the list.\n\n20|    List.push (f ⊤) 3\n       ^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n20|    List.push (List.copy (f ⊤)) 3\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction value that may be one of several functions, and the checker does not\njoin what each returns."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/UnknownCalleeShared.beni","start":{"line":33,"col":17},"end":{"line":33,"col":25}},"title":"LIST CHANGED WHILE STILL IN USE","message":"A lambda must return a list it owns, but UnknownCalleeShared.fromList edits what\nit returns, which may be a list it does not own.\n\n33|badFromList ⊤ = fromList [ λ⊤ → shared ]\n                   ^^^^^^^^ the function is handed on here\n                              ^ the function here may return a list it does not own\n\nHave the function return a list it owns: a new list, or a copy made with\n`List.copy`.\n\nThis is sharing the checker can see: UnknownCalleeShared.fromList edits what it\nreturns, which may be a list it does not own."}]
