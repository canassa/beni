[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/UnknownCalleeShared.beni","start":{"line":19,"col":5},"end":{"line":19,"col":22}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `f ⊤` in place, and the checker cannot show that nothing\nelse still holds the list.\n\n19|    List.push (f ⊤) 3\n       ^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n19|    List.push (List.copy (f ⊤)) 3\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction value that may be one of several functions, and the checker does not\njoin what each returns."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/UnknownCalleeShared.beni","start":{"line":26,"col":13},"end":{"line":26,"col":30}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `f ⊤` in place, and the checker cannot show that nothing\nelse still holds the list.\n\n26|            List.push (f ⊤) 3\n               ^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n26|            List.push (List.copy (f ⊤)) 3\n\nThis is a limit of the checker, not proof of sharing: it came from a call of a\nfunction the checker cannot identify, which may return a list something else\nholds."}]
