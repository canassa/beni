[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/CapturedSubscriptionShared.beni","start":{"line":28,"col":12},"end":{"line":28,"col":17}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`CapturedSubscriptionShared.every` changes a list it is handed in place, but the\nelements of <literal> may share one list.\n\n28|shared ⊤ = every [ 1 ]\n              ^^^^^ the list is changed in place here\n\nCopy the list with `List.copy` before it is changed, so the change cannot reach\nanything else that holds it.\n\nThis is sharing the checker can see: the elements of <literal> may share one\nlist."}]
