[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/BridgeCaptureOperand.beni","start":{"line":8,"col":5},"end":{"line":8,"col":14}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`<lambda>` changes `xs` in place, but another part of the same operation reads\nthe same list.\n\n8|    change xs\n      ^^^^^^^^^ the list is changed in place here\n\nIf the list were changed in place, the other part would read it changed.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n8|    change (List.copy xs)\n\nThis is sharing the checker can see: two parts of one operation reach the same\nlist."}]
