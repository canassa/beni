[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/InPlaceLaterUse.beni","start":{"line":7,"col":10},"end":{"line":7,"col":24}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`List.push` changes `xs` in place, but `xs` is read again afterwards.\n\n7|    ys = List.push xs n\n           ^^^^^^^^^^^^^^ the list is changed in place here\n8|    List.length ys + List.length xs\n                                   ^^ and `xs` is read here, after the change\n\nIf the list were changed in place, `xs` would see the change when it is read on\nline 8.\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n7|    ys = List.push (List.copy xs) n\n\nThis is sharing the checker can see: `xs` is read on line 8, after the change."}]
