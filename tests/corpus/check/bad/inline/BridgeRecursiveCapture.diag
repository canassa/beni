[{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/BridgeRecursiveCapture.beni","start":{"line":5,"col":37},"end":{"line":5,"col":63}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`List.push` changes `loop (n - 1` in place, but something, a function that holds\nthe list, is used afterwards.\n\n5|    loop n = if n == 0 then xs else List.push (loop (n - 1)) n\n                                      ^^^^^^^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo change a copy and leave the list as it was, copy it there:\n\n5|    loop n = if n == 0 then xs else List.push (List.copy (loop (n - 1))) n\n\nThis is sharing the checker can see: loop, a closure holding it, is used at 7:5."}]
