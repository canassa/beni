[{"code":"top_level_list_changed","severity":"error","span":{"file":"tests/corpus/check/bad/inline/ListFormsShared.beni","start":{"line":12,"col":12},"end":{"line":12,"col":26}},"title":"TOP-LEVEL LIST CHANGED","message":"`[ …plain, 41 ]` adds to the end of `ListFormsShared.plain` itself, but it is\n`plain`, a top-level value.\n\n12|longer ⊤ = [ …plain, 41 ]\n              ^^^^^^^^^^^^^^ the list is changed in place here\n\n8|plain = List.range 1 40\n  ^^^^^ the top-level list is defined here\n\nA top-level value is shared by every part of the program and never changes:\nchanged in place, it would change for every part that reads it.\n\nMake `plain` a function that builds a fresh value at each call, or change a\ncopy: `List.copy plain`.\n\nThis is the language's rule for top-level values, whether or not anything else\nreads the list (ownership-checker.md §4.2)."},{"code":"top_level_list_changed","severity":"error","span":{"file":"tests/corpus/check/bad/inline/ListFormsShared.beni","start":{"line":16,"col":12},"end":{"line":16,"col":32}},"title":"TOP-LEVEL LIST CHANGED","message":"`List.set` changes `ListFormsShared.plain` in place, but it is `plain`, a\ntop-level value.\n\n16|larger ⊤ = List.set plain 39 41\n              ^^^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\n8|plain = List.range 1 40\n  ^^^^^ the top-level list is defined here\n\nA top-level value is shared by every part of the program and never changes:\nchanged in place, it would change for every part that reads it.\n\nMake `plain` a function that builds a fresh value at each call, or change a\ncopy: `List.copy plain`.\n\nThis is the language's rule for top-level values, whether or not anything else\nreads the list (ownership-checker.md §4.2)."},{"code":"list_still_used","severity":"error","span":{"file":"tests/corpus/check/bad/inline/ListFormsShared.beni","start":{"line":20,"col":56},"end":{"line":20,"col":64}},"title":"LIST CHANGED WHILE STILL IN USE","message":"`xs ++ ys` adds to the end of `xs` itself, but it is handed to List.map, which\nmay call it more than once.\n\n20|lengths xs others = List.map others λys → List.length (xs ++ ys)\n                                                          ^^^^^^^^ the list is changed in place here\n\nTo change a copy and leave `xs` as it was, copy it there:\n\n20|lengths xs others = List.map others λys → List.length (List.copy xs ++ ys)\n\nThis is sharing the checker can see: it is handed to List.map, which may call it\nmore than once."}]
