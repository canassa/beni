[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/SchemaRuntimeCapturedList.beni","start":{"line":18,"col":13},"end":{"line":18,"col":33}},"title":"LIST MAY BE SHARED","message":"`List.push` changes `result` in place, and the checker cannot show that nothing\nelse still holds the list.\n\n18|            List.push result \"x\"\n               ^^^^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n18|            List.push (List.copy result) \"x\"\n\nThis is a limit of the checker, not proof of sharing: a schema answered it whose\nfunctions the checker does not follow — one built at run time, or a conversion\nit cannot place."}]
