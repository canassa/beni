type Validation
    = Valid
    | Invalid (List Int)


firstOf : List (⊤ → Validation) → (⊤ → Validation)
firstOf works =
    λ⊤ →
        case works of
            [] →
                Valid

            [ work, …rest ] →
                case work ⊤ of
                    Valid →
                        (firstOf rest) ⊤

                    invalid →
                        invalid


pub run : ⊤ → List Int
run ⊤ =
    case (firstOf [ λ⊤ → Valid, λ⊤ → Invalid kept ]) ⊤ of
        Invalid xs →
            List.push xs 2

        Valid →
            []


kept : List Int
kept = [ 1 ]
