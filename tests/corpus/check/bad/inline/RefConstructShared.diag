[{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/RefConstructShared.beni","start":{"line":12,"col":27},"end":{"line":12,"col":37}},"title":"LIST MAY BE SHARED","message":"`[ …xs, 2 ]` adds to the end of `xs` itself, and the checker cannot show that\nnothing else still holds the list.\n\n12|    Ref.update cell λxs → [ …xs, 2 ]\n                             ^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n12|    Ref.update cell λxs → [ …List.copy xs, 2 ]\n\nThis is a limit of the checker, not proof of sharing: Ref.update supplies its\nparameter 1 borrowed (⊤)."},{"code":"list_may_be_shared","severity":"error","span":{"file":"tests/corpus/check/bad/inline/RefConstructShared.beni","start":{"line":20,"col":52},"end":{"line":20,"col":67}},"title":"LIST MAY BE SHARED","message":"`[ …s.items, 2 ]` adds to the end of `s.items` itself, and the checker cannot\nshow that nothing else still holds the list.\n\n20|    _ = Ref.modify cell λs → ( snapshot, { items = [ …s.items, 2 ] } )\n                                                      ^^^^^^^^^^^^^^^ the list is changed in place here\n\nTo be safe, change a copy:\n\n20|    _ = Ref.modify cell λs → ( snapshot, { items = [ …List.copy s.items, 2 ] } )\n\nThis is a limit of the checker, not proof of sharing: Ref.modify supplies its\nparameter 1 borrowed (⊤)."}]
