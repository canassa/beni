[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/SiblingTypeEqResolution/Main.beni","start":{"line":20,"col":15},"end":{"line":20,"col":17}},"title":"TYPE MISMATCH","message":"`Two.eq` is not the method this call needs:\n\n    A, A -> Bool\n\nbut the call wants:\n\n    B, B -> Bool\n\nA method of `B` is a `pub` value of the module that declares it, which is\n`Two`, and a module's `pub` values are ONE namespace — so `eq` is the\nmethod of every type `Two` declares.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
