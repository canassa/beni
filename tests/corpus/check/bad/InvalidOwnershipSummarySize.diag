[{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":15,"col":1},"end":{"line":15,"col":32}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"This `@ownership_summary_size` is below the allowance it would raise.\n\nThe value raises an allowance; it never lowers one. A declaration's is at\nleast its module's, and a module's at least the default, 65536."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":19,"col":1},"end":{"line":19,"col":33}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"The value of `@ownership_summary_size` is a decimal integer.\n\nWrite the digits alone, with no sign, separator or other base:\n`@ownership_summary_size(131072)`."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":23,"col":1},"end":{"line":23,"col":25}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"This attribute is not one beni knows.\n\nThe one attribute is `@ownership_summary_size`: it raises how much\nthe ownership checker may build for one declaration, or for every\ndeclaration of the module when it starts with `module`."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":27,"col":1},"end":{"line":27,"col":37}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"This `@ownership_summary_size` is larger than the checker can count.\n\nThe largest value is 4294967294. A declaration that needs more than that\nis too large to check: split it into smaller declarations."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":31,"col":1},"end":{"line":31,"col":32}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"`@ownership_summary_size` raises a top-level value, and this\ndeclaration is not one.\n\nA type, an alias, a `foreign` value or a schema has no ownership summary\nof its own. Put the line before the function that needs it, or raise the\nwhole module with `@ownership_summary_size(module, …)`."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":36,"col":1},"end":{"line":36,"col":40}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"A module's `@ownership_summary_size(module, …)` stands at the start of\nthe file, before the first import or declaration.\n\nComments and blank lines may come before it. Move the line up, or\nremove `module` to raise the declaration that follows it instead."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":40,"col":1},"end":{"line":40,"col":32}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"This `@ownership_summary_size` has no declaration to raise.\n\nThe line stands directly before a top-level value's annotation, or its\ndefinition when it has none. Comments may come between them; another\nattribute or declaration may not."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":46,"col":1},"end":{"line":46,"col":32}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"This `@ownership_summary_size` has no declaration to raise.\n\nThe line stands directly before a top-level value's annotation, or its\ndefinition when it has none. Comments may come between them; another\nattribute or declaration may not."},{"code":"invalid_ownership_summary_size","severity":"error","span":{"file":"tests/corpus/check/bad/InvalidOwnershipSummarySize.beni","start":{"line":50,"col":1},"end":{"line":50,"col":32}},"title":"INVALID OWNERSHIP SUMMARY SIZE","message":"This `@ownership_summary_size` has no declaration to raise.\n\nThe line stands directly before a top-level value's annotation, or its\ndefinition when it has none. Comments may come between them; another\nattribute or declaration may not."}]
