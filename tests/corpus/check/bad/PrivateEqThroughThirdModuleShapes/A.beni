-- CK-22: D1 across three modules, every shape that can hold the private
-- `eq` (checker-v2.md §11.3): `B`'s wrapper built by a function and by its
-- constructor, a parameterised wrapper, `C`'s own wrapper of `B`'s, and a
-- list. Each is `private_method` at its `==`, naming `A.T`. On 7427828 every
-- one builds and prints `False`.
pub type T
    = T Int


eq : T, T -> Bool
eq left right =
    case left of
        T x ->
            case right of
                T y ->
                    modBy x 10 == modBy y 10


pub inside : T, T -> Bool
inside a b =
    a == b
