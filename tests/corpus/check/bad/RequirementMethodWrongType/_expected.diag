[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementMethodWrongType/Main.beni","start":{"line":12,"col":28},"end":{"line":12,"col":33}},"title":"TYPE MISMATCH","message":"`K.show` is not the method this call needs:\n\n    K, ⊤ → Int\n\nbut the call wants:\n\n    K, ⊤ → String\n\nA method of `K` is a `pub` value of the module that declares it, so\n`K.show` is the `show` of `K`, and it has to have the type the call wants.\n\nHint: give `show` that type, or rename it if it is not meant to be a method\nof `K`.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementMethodWrongType/Main.beni","start":{"line":16,"col":25},"end":{"line":16,"col":27}},"title":"TYPE MISMATCH","message":"`K.key` is not the method this call needs:\n\n    K, ⊤ → String\n\nbut the call wants:\n\n    K, ⊤ → Int\n\nA method of `K` is a `pub` value of the module that declares it, so\n`K.key` is the `key` of `K`, and it has to have the type the call wants.\n\nHint: give `key` that type, or rename it if it is not meant to be a method\nof `K`.\n"}]
