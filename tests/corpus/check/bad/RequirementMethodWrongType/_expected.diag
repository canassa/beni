[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementMethodWrongType/Main.beni","start":{"line":13,"col":22},"end":{"line":13,"col":27}},"title":"TYPE MISMATCH","message":"`K.show` is not the method this call needs:\n\n    K, () -> Int\n\nbut the call wants:\n\n    K, () -> String\n\nA method of `K` is a `pub` value of the module that declares it, which is\n`K`, and a module's `pub` values are ONE namespace — so `show` is the\nmethod of every type `K` declares.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RequirementMethodWrongType/Main.beni","start":{"line":18,"col":21},"end":{"line":18,"col":23}},"title":"TYPE MISMATCH","message":"`K.key` is not the method this call needs:\n\n    K, () -> String\n\nbut the call wants:\n\n    K, () -> Int\n\nA method of `K` is a `pub` value of the module that declares it, which is\n`K`, and a module's `pub` values are ONE namespace — so `key` is the\nmethod of every type `K` declares.\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
