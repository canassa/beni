-- CK-52: the "module-rule clash" hint is printed only when the module
-- declares at least two types and the method's first parameter names a
-- different one (checker-v2.md §15.4). This module declares one type, so
-- `eq : Mod, Int -> Bool` failing to be `Mod`'s `eq` is a plain signature
-- mismatch. On 7427828 the message still says "this is the module-rule
-- clash of … §11. Move one of the types into a module of its own".


pub type Mod
    = Mod Int


pub eq : Mod, Int -> Bool
eq a b =
    True


same : Bool
same =
    Mod 1 == Mod 2
