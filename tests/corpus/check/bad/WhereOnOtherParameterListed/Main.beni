-- check/bad: a requirement on another parameter asked of a type that holds
-- the receiver but has no such method is `unknown_method`, as v1 reports:
-- `List` has no `describe`. Not a cycle (checker-v2.md §9.5, withdrawn
-- premise; round-2 review of R6a, N1) — R6a's lineage rule reported
-- `infinite_type` here.
import Box exposing (Box)


listed : Box Int -> String
listed bx =
    let
        w =
            [ bx ]
    in
    bx.describe w
