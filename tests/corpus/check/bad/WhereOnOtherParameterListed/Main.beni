-- check/bad: a requirement on another parameter asked of a type that holds
-- the receiver but has no such method is `unknown_method`:
-- `List` has no `describe`. Not a cycle (checker-v2.md §9.5): a lineage
-- rule that called this a cycle would report `infinite_type` here.
--
import Box exposing (Box)


listed : Box Int -> String
listed bx =
    let
        w =
            [ bx ]
    in
    bx.describe w
