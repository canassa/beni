[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqOneQuestionPerSite.beni","start":{"line":23,"col":5},"end":{"line":23,"col":14}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    Int → Int\n\nThere is a function in there, and comparing functions is not decidable:\ndeciding whether two functions agree on every input is the halting problem.\n\nHint: compare the values the functions produce, or store something you can\ncompare — a name, an id — next to the function.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/EqOneQuestionPerSite.beni","start":{"line":27,"col":5},"end":{"line":27,"col":14}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    { a : Int → Int, b : a }\n\nThere is a function in there, and comparing functions is not decidable:\ndeciding whether two functions agree on every input is the halting problem.\n\nHint: compare the values the functions produce, or store something you can\ncompare — a name, an id — next to the function.\n"}]
