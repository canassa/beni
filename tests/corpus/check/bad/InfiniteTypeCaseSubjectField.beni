-- CK-04: `InfiniteTypeCaseSubject`'s cycle through ONE record field. Before
-- R4b's review v2 said `nesting_too_deep` ("more than 4200 levels", "give the
-- inner part a type alias") at `[ r, s ]` — wrong code, false advice. v1 reports at the body.
g r s =
    case [ r, { a = r } ] of
        _ ->
            case [ s, { a = s } ] of
                _ ->
                    [ r, s ]
