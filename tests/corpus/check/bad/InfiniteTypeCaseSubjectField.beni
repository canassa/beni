-- `InfiniteTypeCaseSubject`'s cycle through ONE record field: an
-- `infinite_type`, never `nesting_too_deep` ("more than 4200 levels", "give the
-- inner part a type alias") at `[ r, s ]` — wrong code, false advice.
g r s =
    case [ r, { a = r } ] of
        _ ->
            case [ s, { a = s } ] of
                _ ->
                    [ r, s ]
