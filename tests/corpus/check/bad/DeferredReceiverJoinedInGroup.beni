-- The program of `run/FieldCallThroughMember` with `ma`
-- also passing `x` to `h`, whose inferred `where a.combine` requirement joins
-- the dot-call `x.combine 1` on `x` (static-dispatch-spike.md §6.1 invariant
-- 3). The joined class has a requirement, which has no field accessor to be,
-- so when `mb`'s record reaches `x` it is `no_methods_on_shape` at `h x` —
-- in every declaration order (an order that checks `mb` first must not make
-- the class a field call and then report an internal evidence miscount;
-- every order refuses it).
type K
    = K Int


h a = a.combine 1


pub mb (K n) y =
    if n > 0 then
        y
    else
        _ = (K 1).ma { combine = λz → z + 1 }
        y


pub ma (K n) x =
    _ = (K n).mb 0

    p = x.combine 1

    q = h x
    p + q
