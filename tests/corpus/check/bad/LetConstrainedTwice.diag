[{"code":"unknown_method","severity":"error","span":{"file":"tests/corpus/check/bad/LetConstrainedTwice.beni","start":{"line":12,"col":15},"end":{"line":12,"col":22}},"title":"UNKNOWN METHOD","message":"`Int` has no method called `render`.\n\nI resolve `x.render` in the module that declares `x`'s type. That module is\n`Basics`, and it has no `pub` value called `render`.\n\nHint: `Basics` exposes:\n\n    `abs`, `acos`, `add`, `always`, `and`, `append`, `asin`,\n    `atan` and 40 more.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetConstrainedTwice.beni","start":{"line":13,"col":20},"end":{"line":13,"col":21}},"title":"TYPE MISMATCH","message":"The 1st argument to `show` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `show` needs the 1st argument to be:\n\n    Int\n\nHint: `show` is a `let` binding whose type needs a `render` method only\nthrough a dot-call, which could still turn out to call a record's field,\nso the binding has ONE type inside the definition that holds it\n(`docs/design/checker-v2.md` §8.4). The first use fixed the type; this is\nthe second.\n\nMove `show` out to a top-level declaration and annotate it with\n`where … .render : …` to use it at two.\n"}]
