[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetConstrainedTwice.beni","start":{"line":13,"col":20},"end":{"line":13,"col":21}},"title":"TYPE MISMATCH","message":"The 1st argument to `show` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `show` needs the 1st argument to be:\n\n    Int\n\nHint: `show` is a `let` binding whose type needs a `render` method, and such a\nbinding is used at ONE type inside the definition that holds it\n(`docs/design/static-dispatch-spike.md` §6.4). The first use fixed the type;\nthis is the second.\n\nMove `show` out to a top-level declaration and annotate it with\n`where … .render : …` to use it at two.\n"}]
