[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaWrapperExclusion.beni","start":{"line":32,"col":10},"end":{"line":32,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Wrap\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/SchemaWrapperExclusion.beni","start":{"line":37,"col":10},"end":{"line":37,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Fn.Type\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
