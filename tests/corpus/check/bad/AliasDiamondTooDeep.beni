type alias Name =
    String


type Unused
    = Unused (A300 Int)


pub type Shown
    = Shown (A300 Int)


type Used
    = Used (A300 Int) String


pub f : A300 Int → Int
f _ = "s"


pub g : A300 Int → Name
g _ = 1


pub u : Int
u = keep (Used 1 2)


keep : Used → Int
keep _ = 1
