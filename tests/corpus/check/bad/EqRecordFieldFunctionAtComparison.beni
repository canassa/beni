-- A record compared with `Basics.eq` whose field is later used as a
-- function is `not_equatable` AT THE COMPARISON (checker-v2.md §11.4): the
-- question is asked where
-- `r` meets the comparison's argument, not where `r` later becomes a record
-- (`r.x`). The flag on `r` must survive `r` becoming a record whose field is
-- still a variable, or the program would check clean.
g r =
    let
        b = Basics.eq r r
        n = r.x + 1
        fn = r.f
    in
    ( b, fn n )


use = g { x = 1, f = \n -> n + 1 }
