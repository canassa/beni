-- The sub-wanted form. `combine`'s own requirement `a.mix` becomes a
-- sub-wanted on `r`, another recursive-group member's result, when
-- `(Box r).combine z` resolves inline; the recursive-group rule (checker-v2.md
-- §10.7) lowers it, so `q` is monomorphic and `( q 1, q "s" )` is one
-- `kind_mismatch` at `q "s"` with the hint "Annotate `g`", in every order.
-- `FirstF` writes `f` first, `FirstG` writes `g` first. Accepting either
-- would mean an INTERNAL ERROR at build in one order and
-- `{ a = Box K 1, b = Box K 1 }` printed in the other.
type K
    = K Int


type Box a
    = Box a


pub mix (K n) b = K n


combine : Box a, b → Box a
    where a.mix : a, b → a
combine (Box a) z = Box (a.mix z)


f n =
    r = g n
    q z = (Box r).combine z
    ( q 1, q "s" )


g n =
    if n > 100 then
        K n
    else
        _ = f (n + 1)
        K n
