-- CK-76: the sub-wanted form. `combine`'s own requirement `a.mix` becomes a
-- sub-wanted on `r`, another recursive-group member's result, when
-- `(Box r).combine z` resolves inline; D14 (checker-v2.md §10.7, round 4)
-- lowers it, so `q` is monomorphic and `( q 1, q "s" )` is one
-- `kind_mismatch` at `q "s"` with the hint "Annotate `g`", in every order.
-- `FirstF` is round 4's `subA`, `FirstG` is `subB`. On 7427828 `check`
-- accepts both; `build` of `subA` is INTERNAL ERROR, and `subB` runs and
-- prints `{ a = Box K 1, b = Box K 1 }`.
type K
    = K Int


type Box a
    = Box a


pub mix (K n) b =
    K n


combine : Box a, b -> Box a
    where a.mix : a, b -> a
combine (Box a) z =
    Box (a.mix z)


f n =
    let
        r =
            g n

        q z =
            (Box r).combine z
    in
    ( q 1, q "s" )


g n =
    if n > 100 then
        K n
    else
        let
            _ =
                f (n + 1)
        in
        K n
