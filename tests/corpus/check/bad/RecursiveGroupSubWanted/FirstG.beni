-- See FirstF.beni. The same module with `g` written first.
type K
    = K Int


type Box a
    = Box a


pub mix (K n) b = K n


combine : Box a, b → Box a
    where a.mix : a, b → a
combine (Box a) z = Box (a.mix z)


g n =
    if n > 100 then
        K n
    else
        _ = f (n + 1)
        K n


f n =
    r = g n
    q z = (Box r).combine z
    ( q 1, q "s" )
