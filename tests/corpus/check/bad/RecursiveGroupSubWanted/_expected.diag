[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RecursiveGroupSubWanted/FirstF.beni","start":{"line":28,"col":14},"end":{"line":28,"col":17}},"title":"TYPE MISMATCH","message":"The 1st argument to `q` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `q` needs the 1st argument to be:\n\n    number\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: to read a number out of text, use `String.toInt` or `String.toFloat`.\n\nHint: `r` comes from `g`, which is in a recursive group with `f`, so its type is\nnot known here yet. Annotate `g` and each use can instantiate it.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RecursiveGroupSubWanted/FirstG.beni","start":{"line":29,"col":14},"end":{"line":29,"col":17}},"title":"TYPE MISMATCH","message":"The 1st argument to `q` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `q` needs the 1st argument to be:\n\n    number\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: to read a number out of text, use `String.toInt` or `String.toFloat`.\n\nHint: `r` comes from `g`, which is in a recursive group with `f`, so its type is\nnot known here yet. Annotate `g` and each use can instantiate it.\n"}]
