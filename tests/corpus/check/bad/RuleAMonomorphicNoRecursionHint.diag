[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RuleAMonomorphicNoRecursionHint.beni","start":{"line":28,"col":19},"end":{"line":28,"col":20}},"title":"TYPE MISMATCH","message":"The 1st argument to `pairK` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `pairK` needs the 1st argument to be:\n\n    T\n\nHint: `pairK` is a `let` binding whose type needs a `same` method only\nthrough a dot-call, which could still turn out to call a record's field,\nso the binding has ONE type inside the definition that holds it\n(`docs/design/checker-v2.md` §8.4). The first use fixed the type; this is\nthe second.\n\nMove `pairK` out to a top-level declaration and annotate it with\n`where … .same : …` to use it at two.\n"}]
