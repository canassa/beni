[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/TopLevelFixedClassSync.beni","start":{"line":35,"col":29},"end":{"line":35,"col":30}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Ref.update` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: it calls `apply`, and a function in `apply` calls `f`, and\n`slowDouble` calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/TopLevelFixedClassSync.beni","start":{"line":60,"col":17},"end":{"line":60,"col":24}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `runSync` hands it on to a function that calls\nit synchronously.\n\nBut it may suspend: `Task.yieldNow` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
