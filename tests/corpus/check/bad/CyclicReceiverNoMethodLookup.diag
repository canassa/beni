[{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/CyclicReceiverNoMethodLookup.beni","start":{"line":10,"col":25},"end":{"line":10,"col":29}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type here:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = Maybe a\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"},{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/CyclicReceiverNoMethodLookup.beni","start":{"line":13,"col":26},"end":{"line":13,"col":28}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type here:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = Maybe a\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"}]
