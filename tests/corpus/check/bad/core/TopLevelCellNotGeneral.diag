[{"code":"impure_polymorphic_value","severity":"error","span":{"file":"tests/corpus/check/bad/core/TopLevelCellNotGeneral.beni","start":{"line":5,"col":1},"end":{"line":5,"col":7}},"title":"IMPURE POLYMORPHIC VALUE","message":"`shared` is computed by an impure call, once, when its module is loaded, but its\ntype is not one type:\n\n    shared : Cell { x : List a }\n\nIt leaves `a` open. An impure call can make something that holds values, such\nas a new `Ref`, and one such thing cannot hold every type: written as one type\nand read as another, it would give a wrong answer.\n\nHint: annotate `shared` with the one type it holds, or give it a parameter so\nthat each call makes a new one.\n"},{"code":"impure_polymorphic_value","severity":"error","span":{"file":"tests/corpus/check/bad/core/TopLevelCellNotGeneral.beni","start":{"line":8,"col":1},"end":{"line":8,"col":9}},"title":"IMPURE POLYMORPHIC VALUE","message":"`optional` is computed by an impure call, once, when its module is loaded, but\nits type is not one type:\n\n    optional : Cell { x : Opt payload }\n\nIt leaves `payload` open. An impure call can make something that holds values,\nsuch as a new `Ref`, and one such thing cannot hold every type: written as one\ntype and read as another, it would give a wrong answer.\n\nHint: annotate `optional` with the one type it holds, or give it a parameter so\nthat each call makes a new one.\n"},{"code":"impure_polymorphic_value","severity":"error","span":{"file":"tests/corpus/check/bad/core/TopLevelCellNotGeneral.beni","start":{"line":11,"col":1},"end":{"line":11,"col":10}},"title":"IMPURE POLYMORPHIC VALUE","message":"`reference` is computed by an impure call, once, when its module is loaded, but\nits type is not one type:\n\n    reference : Ref (List a)\n\nIt leaves `a` open. An impure call can make something that holds values, such\nas a new `Ref`, and one such thing cannot hold every type: written as one type\nand read as another, it would give a wrong answer.\n\nHint: annotate `reference` with the one type it holds, or give it a parameter so\nthat each call makes a new one.\n"}]
