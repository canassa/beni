[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsCellRecord.beni","start":{"line":9,"col":15},"end":{"line":9,"col":16}},"title":"TYPE MISMATCH","message":"A Js.Cell has identity and writable fields. Record.copy and record update\napply to immutable records, so neither can consume a Cell.\n\nRead a field with Js.cellRead and write it with Js.cellWrite. To create a\nseparate cell, construct it from the field values explicitly.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsCellRecord.beni","start":{"line":10,"col":26},"end":{"line":10,"col":30}},"title":"TYPE MISMATCH","message":"A Js.Cell has identity and writable fields. Record.copy and record update\napply to immutable records, so neither can consume a Cell.\n\nRead a field with Js.cellRead and write it with Js.cellWrite. To create a\nseparate cell, construct it from the field values explicitly.\n"},{"code":"unknown_method","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsCellRecord.beni","start":{"line":11,"col":13},"end":{"line":11,"col":15}},"title":"UNKNOWN METHOD","message":"A Js.Cell has identity, so structural equality and ordering do not apply.\n\nCompare cell identity with Js.same in runtime code, or read and compare\nthe particular field values.\n"}]
