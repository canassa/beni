[{"code":"invalid_js_object","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsObjectKey.beni","start":{"line":16,"col":25},"end":{"line":16,"col":26}},"title":"INVALID OBJECT FIELDS","message":"`Js.object` writes its fields as an object literal's, so they must be a list\nliteral of pairs, `Js.object [ ( \"key\", value ), … ]`.\n\nThis key is not a string literal: a key is a property name, written as it\nwill appear in the JavaScript."},{"code":"invalid_js_object","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsObjectKey.beni","start":{"line":20,"col":27},"end":{"line":20,"col":32}},"title":"INVALID OBJECT FIELDS","message":"`Js.object` writes its fields as an object literal's, so they must be a list\nliteral of pairs, `Js.object [ ( \"key\", value ), … ]`.\n\nThis key is not a JavaScript identifier: letters, digits, `_` and `$`, not\nbeginning with a digit."},{"code":"invalid_js_object","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsObjectKey.beni","start":{"line":24,"col":26},"end":{"line":24,"col":37}},"title":"INVALID OBJECT FIELDS","message":"`Js.object` writes its fields as an object literal's, so they must be a list\nliteral of pairs, `Js.object [ ( \"key\", value ), … ]`.\n\nThis key is `__proto__`, which in an object literal sets the object's\nprototype rather than making a field."},{"code":"invalid_js_object","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsObjectKey.beni","start":{"line":28,"col":50},"end":{"line":28,"col":53}},"title":"INVALID OBJECT FIELDS","message":"`Js.object` writes its fields as an object literal's, so they must be a list\nliteral of pairs, `Js.object [ ( \"key\", value ), … ]`.\n\nThis key is written twice: an object has one field of each name."},{"code":"invalid_js_object","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsObjectKey.beni","start":{"line":32,"col":25},"end":{"line":32,"col":26}},"title":"INVALID OBJECT FIELDS","message":"`Js.object` writes its fields as an object literal's, so they must be a list\nliteral of pairs, `Js.object [ ( \"key\", value ), … ]`.\n\nThis field is not written as a pair `( \"key\", value )`."},{"code":"invalid_js_object","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsObjectKey.beni","start":{"line":36,"col":23},"end":{"line":36,"col":29}},"title":"INVALID OBJECT FIELDS","message":"`Js.object` writes its fields as an object literal's, so they must be a list\nliteral of pairs, `Js.object [ ( \"key\", value ), … ]`.\n\nThis argument is not written as a list literal."}]
