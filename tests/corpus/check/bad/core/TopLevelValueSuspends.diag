[{"code":"must_not_suspend","severity":"error","span":{"file":"tests/corpus/check/bad/core/TopLevelValueSuspends.beni","start":{"line":13,"col":1},"end":{"line":13,"col":7}},"title":"MUST NOT SUSPEND","message":"`answer` must not suspend: it is a value, evaluated once, when its module is\nloaded, where nothing can wait for it.\n\nBut it may suspend: `answer` calls `fetch`, which suspends.\n\nHint: make it a function — `\\() -> …` or a parameter — and call it where waiting\nis possible, from a function the platform runs.\n"},{"code":"must_not_suspend","severity":"error","span":{"file":"tests/corpus/check/bad/core/TopLevelValueSuspends.beni","start":{"line":21,"col":1},"end":{"line":21,"col":6}},"title":"MUST NOT SUSPEND","message":"`total` must not suspend: it is a value, evaluated once, when its module is\nloaded, where nothing can wait for it.\n\nBut it may suspend: `total` calls `twice`, and `twice` calls `fetch`, which\nsuspends.\n\nHint: make it a function — `\\() -> …` or a parameter — and call it where waiting\nis possible, from a function the platform runs.\n"}]
