[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTypes.beni","start":{"line":20,"col":15},"end":{"line":20,"col":22}},"title":"TYPE MISMATCH","message":"The attribute `count` must have one of the value types a lowering can write.\n\nAn attribute's value type is `String`, `Int`, `Float`, `Bool` or\n`Maybe String` (`docs/design/language.md` §11.14)."},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTypes.beni","start":{"line":23,"col":15},"end":{"line":23,"col":22}},"title":"TYPE MISMATCH","message":"The attribute `class` takes a class list, so its value type must be `String`.\n\nA `classes` or `styles` attribute is written as a string or as a list\n(`docs/design/language.md` §11.19)."},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTypes.beni","start":{"line":26,"col":11},"end":{"line":26,"col":20}},"title":"TYPE MISMATCH","message":"The event `onClick` has no `via`, so its payload is the event object itself, and\nits type must be a `foreign type`.\n\nName an extractor with `via` to hand a handler anything else\n(`docs/design/language.md` §11.14)."},{"code":"unbound_variable","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTypes.beni","start":{"line":29,"col":11},"end":{"line":29,"col":20}},"title":"NAMING ERROR","message":"The event `onInput` takes its payload `via plain`, which is not a `foreign`\nvalue of this module.\n\nA payload extractor is a `foreign` value declared beside the event\n(`docs/design/boundary.md` §9.3)."},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTypes.beni","start":{"line":32,"col":11},"end":{"line":32,"col":20}},"title":"TYPE MISMATCH","message":"The event `onCheck` takes its payload `via targetValue`, whose type does not\nfit.\n\nThe extractor takes the event object, a `foreign type`, and returns the\nevent's payload type (`docs/design/checker-v2.md` §25.2)."},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTypes.beni","start":{"line":35,"col":12},"end":{"line":35,"col":17}},"title":"TYPE MISMATCH","message":"The markup primitive `empty` must be a function whose type mentions the markup\ntype.\n\nA primitive builds or transforms markup at run time, and each lowering's runtime\nimplements it (`docs/design/boundary.md` §9.3)."}]
