-- check/bad (core): `misplaced_ownership_word` (ownership-checker.md §24.4),
-- lowering's, at the word, and the word dropped. A word stands in front of a
-- parameter of the signature's arrow or its result: not inside a type
-- (`one`), not on a value that is not a function (`two`). `once`, `many` and
-- `owned` describe a function written out, not an alias of one (`three`) or
-- a list (`four`). A result word on a parameter (`five`), a parameter word on
-- the result (`six`). Words that cannot both hold: a word twice (`seven`),
-- `borrowed` with another (`eight`), `aliased` with `returned` (`nine`),
-- `consumed` on a function (`ten`), `once` with `many` (`eleven`), `owned`
-- alone (`twelve`), two results (`thirteen`), `exclusive` without `fresh`
-- (`fourteen`). A signature in parentheses is a type like any other: its
-- words are inside it (`fifteen`). Outside a signature a word is an ordinary
-- type variable, so `keep` means what it always meant.
type alias Handler =
    Int → Int


pub foreign pure one : List (borrowed Int) → Int


pub foreign pure two : fresh Int


pub foreign pure three : once Handler → Int


pub foreign pure four : many List Int → Int


pub foreign pure five : fresh List Int → Int


pub foreign pure six : Int → borrowed List Int


pub foreign pure seven : borrowed borrowed List Int → Int


pub foreign pure eight : escaped borrowed List Int → Int


pub foreign pure nine : aliased returned List Int → List Int


pub foreign pure ten : consumed (Int → Int) → Int


pub foreign pure eleven : once many (Int → Int) → Int


pub foreign pure twelve : owned (Int → Int) → Int


pub foreign pure thirteen : List Int → fresh unknown List Int


pub foreign pure fourteen : Int → exclusive List Int


pub foreign pure fifteen : (borrowed List Int → Int)


keep : fresh → List fresh
keep x = [ x ]
