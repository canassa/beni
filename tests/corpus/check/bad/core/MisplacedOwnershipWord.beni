-- check/bad (core): `misplaced_ownership_word` (ownership-checker.md §24.4),
-- lowering's, at the word, and the word dropped. A word stands in front of a
-- parameter of the signature's arrow or its result: not inside a type
-- (`one`), not on a value that is not a function (`two`). `once`, `many` and
-- `owned` describe a function written out, not an alias of one (`three`) or
-- a list (`four`). A result word on a parameter (`five`), a parameter word on
-- the result (`six`). Words that cannot both hold: a word twice (`seven`),
-- `borrowed` with another (`eight`), `aliased` with `returned` (`nine`),
-- `consumed` on a function (`ten`), `once` with `many` (`eleven`), `owned`
-- alone (`twelve`), two results (`thirteen`), `exclusive` without `fresh`
-- (`fourteen`). A signature in parentheses is a type like any other: its
-- words are inside it (`fifteen`). Outside a signature a word is an ordinary
-- type variable, so `keep` means what it always meant. Since 2026-10-16 a
-- `List` of functions written out takes a function's words, for each element
-- (`sixteen`, no line), but only core's `List` and written out: another
-- type of one function (`seventeen`), or an alias of such a list
-- (`eighteen`), is refused.
type Box a
    = Box a


type alias Thunks =
    List (Int → Int)


type alias Handler =
    Int → Int


pub foreign pure one : List (borrowed Int) → Int


pub foreign pure two : fresh Int


pub foreign pure three : once Handler → Int


pub foreign pure four : many List Int → Int


pub foreign pure five : fresh List Int → Int


pub foreign pure six : Int → borrowed List Int


pub foreign pure seven : borrowed borrowed List Int → Int


pub foreign pure eight : escaped borrowed List Int → Int


pub foreign pure nine : aliased returned List Int → List Int


pub foreign pure ten : consumed (Int → Int) → Int


pub foreign pure eleven : once many (Int → Int) → Int


pub foreign pure twelve : owned (Int → Int) → Int


pub foreign pure thirteen : List Int → fresh unknown List Int


pub foreign pure fourteen : Int → exclusive List Int


pub foreign pure fifteen : (borrowed List Int → Int)


keep : fresh → List fresh
keep x = [ x ]


pub foreign pure sixteen : many List (Int → Int) → Int


pub foreign pure seventeen : many Box (Int → Int) → Int


pub foreign pure eighteen : many Thunks → Int


-- The ownership checker v2's words (`ownership-v2.md` §2.13.6). A
-- parameter's word on the result (`nineteen`), a result's on a parameter
-- (`twenty`); `taken` on a parameter that is not a function written out
-- (`twentyOne`); `cellupdate` on a function not marked `sync` (`twentyTwo`,
-- and then `cellwrite` has no companion); a cell word on the wrong
-- parameter (`twentyThree`); `cellnew` without a `consumed` first parameter
-- (`twentyFour`); two cell operations (`twentyFive`), two results
-- (`twentySix`), and `cellupdate` with a word it already says
-- (`twentySeven`).
pub foreign pure nineteen : Int → written List Int


pub foreign pure twenty : lent List Int → Int


pub foreign pure twentyOne : taken List Int, Int → Int


pub foreign pure twentyTwo : cellwrite Box a, cellupdate (a → a) → ⊤


pub foreign pure twentyThree : Int, cellread Box a → Int


pub foreign pure twentyFour : Box a → cellnew Box a


pub foreign pure twentyFive : cellread cellwrite Box a, consumed cellstored a → ⊤


pub foreign pure twentySix : written returned List a, Int → fresh builderdone List a


pub foreign pure twentySeven : cellwrite Box a, once cellupdate sync (a → a) → ⊤


-- The type words and `failure`, where they cannot stand: `sequence` on a
-- type of two parameters, `cell` on a type of none and on a type that is
-- not opaque, `sender` on an alias whose function does not return `⊤`,
-- `sequence` on an alias and on a `foreign` value; `failure` on a type of
-- three constructors.
pub sequence foreign type Two a b


pub opaque cell type NoParam
    = NoParam Int


cell type NotOpaque a
    = NotOpaque a


pub sender type alias NotUnit msg =
    msg → Int


pub sequence type alias Seq a =
    List a


sequence foreign pure twentyEight : Int → Int


pub type Three e a
    = One a
    | failure Two e
    | Other
