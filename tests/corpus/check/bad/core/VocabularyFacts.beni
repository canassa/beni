-- A vocabulary declaration's facts are a set with at most one namespace and
-- at most one list form (checker-v2.md §25.2): a word written twice (7:13),
-- an element in two namespaces (10:13), an attribute both `classes` and
-- `styles` (13:15) and an element named twice after `on` (16:15) are each
-- `duplicate_declaration`, and the row is published as absent.

pub element "img" void void


pub element "math" svg mathml


pub attribute "look" classes styles : String


pub attribute "size" on "img" "img" : Int
