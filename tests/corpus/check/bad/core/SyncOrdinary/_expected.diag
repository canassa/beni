[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncOrdinary/Main.beni","start":{"line":7,"col":37},"end":{"line":7,"col":45}},"title":"SUSPENDING CALLBACK","message":"The `view` function here must not suspend: `Plat.program` hands it on to a\nfunction that calls it synchronously.\n\nBut it may suspend: `Plat.get` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncOrdinary/Main.beni","start":{"line":12,"col":15},"end":{"line":12,"col":16}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Lib.page` hands it on to a function that calls\nit synchronously.\n\nBut it may suspend: it calls `Plat.get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncOrdinary/Plat.beni","start":{"line":17,"col":12},"end":{"line":17,"col":16}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `race`'s signature marks it `sync`, so every\ncaller is held to it.\n\nBut it may suspend: `get` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
