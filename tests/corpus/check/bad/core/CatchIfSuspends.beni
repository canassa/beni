-- check/bad (core): `Js.catchIf`'s three arguments are `sync` (`backend.md`
-- §4, *`Js.catchIf` is `try … catch`*). A body that suspended would leave
-- the `try` before its rest ran, and a throw from that rest would reach no
-- `catch`; so a body (16:10), a test (25:10) or a handler (34:10) that may
-- suspend is `sync_boundary`, at the argument.
import Js
import Task


pub foreign suspends get : Int -> Int


body : Int -> Int
body n = Js.catchIf (λ() -> get n) (λ_ -> True) λ_ -> 0


test : Int -> Int
test n = Js.catchIf (λ() -> n) (λ_ -> get n == 0) λ_ -> 0


handler : Int -> Int
handler n = Js.catchIf (λ() -> n) (λ_ -> True) λ_ -> get n
