[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncThroughParameter/Main.beni","start":{"line":6,"col":21},"end":{"line":6,"col":29}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Lib.onType` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: `Plat.get` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncThroughParameter/Main.beni","start":{"line":10,"col":21},"end":{"line":10,"col":23}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Lib.onType` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: it calls `Lib.load`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
