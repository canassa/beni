[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncThroughParameter/Main.beni","start":{"line":7,"col":16},"end":{"line":7,"col":24}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Lib.onType` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: `Plat.get` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncThroughParameter/Main.beni","start":{"line":12,"col":17},"end":{"line":12,"col":18}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Lib.onType` hands it on to a function that\ncalls it synchronously.\n\nBut it may suspend: it calls `Lib.load`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
