[{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/core/PrivateForeignCompare/Main.beni","start":{"line":17,"col":7},"end":{"line":17,"col":8}},"title":"PRIVATE METHOD","message":"`Handles.compare` is not `pub`.\n\nThis needs the `compare` of `Handle`, declared in `Handles`, which is inside:\n\n    Wraps\n\n`Handles` declares `compare` without `pub`, and it is the `compare` of every\ntype `Handles` declares, so it is private to that module: it cannot be used from\nhere, directly or inside another value.\n\nHint: add `pub` to `compare` in `Handles`.\n"}]
