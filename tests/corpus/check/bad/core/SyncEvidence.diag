[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncEvidence.beni","start":{"line":28,"col":5},"end":{"line":28,"col":15}},"title":"SUSPENDING CALLBACK","message":"The `probe` this call hands `countWhere` must not suspend: `countWhere` calls it\nsynchronously.\n\nBut it may suspend: `probe` calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncEvidence.beni","start":{"line":42,"col":5},"end":{"line":42,"col":10}},"title":"SUSPENDING CALLBACK","message":"This value holds a function that must not suspend: `==` calls it, through the\ntype's own comparison, and a comparison never suspends.\n\nBut it may suspend: the function it holds calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
