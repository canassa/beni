[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":18,"col":18},"end":{"line":18,"col":20}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `onEvent` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":28,"col":19},"end":{"line":28,"col":23}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `onEvent` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: `load` calls `fetch`, and `fetch` calls `get`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":36,"col":18},"end":{"line":36,"col":22}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `onEvent` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: `each` calls `List.map` with a function that calls `get`,\nwhich suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":40,"col":39},"end":{"line":40,"col":43}},"title":"SUSPENDING CALLBACK","message":"The `view` function here must not suspend: `program` hands it to the platform,\nwhich calls it synchronously.\n\nBut it may suspend: `load` calls `fetch`, and `fetch` calls `get`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
