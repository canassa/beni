[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":19,"col":14},"end":{"line":19,"col":15}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `onEvent` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":33,"col":13},"end":{"line":33,"col":17}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `onEvent` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: `load` calls `fetch`, and `fetch` calls `get`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":43,"col":13},"end":{"line":43,"col":17}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `onEvent` hands it to the platform, which calls\nit synchronously.\n\nBut it may suspend: `each` calls `List.map` with a function that calls `get`,\nwhich suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/SyncBoundaryArgument.beni","start":{"line":48,"col":32},"end":{"line":48,"col":36}},"title":"SUSPENDING CALLBACK","message":"The `view` function here must not suspend: `program` hands it to the platform,\nwhich calls it synchronously.\n\nBut it may suspend: `load` calls `fetch`, and `fetch` calls `get`, which\nsuspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
