[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/MethodSuspends.beni","start":{"line":9,"col":19},"end":{"line":9,"col":20}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.method` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
