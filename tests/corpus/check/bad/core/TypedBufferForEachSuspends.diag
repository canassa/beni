[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/TypedBufferForEachSuspends.beni","start":{"line":8,"col":39},"end":{"line":8,"col":40}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.Buffer.forEach` hands it to the platform,\nwhich calls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/TypedBufferForEachSuspends.beni","start":{"line":12,"col":33},"end":{"line":12,"col":47}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.Buffer.forEach` hands it to the platform,\nwhich calls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/TypedBufferForEachSuspends.beni","start":{"line":20,"col":51},"end":{"line":20,"col":52}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.Buffer.forEachWhile` hands it to the\nplatform, which calls it synchronously.\n\nBut it may suspend: it calls `Task.yieldNow`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
