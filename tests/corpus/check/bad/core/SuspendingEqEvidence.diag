[{"code":"must_not_suspend","severity":"error","span":{"file":"tests/corpus/check/bad/core/SuspendingEqEvidence.beni","start":{"line":19,"col":1},"end":{"line":19,"col":3}},"title":"MUST NOT SUSPEND","message":"`eq` must not suspend: it is what `==` and `/=` call on `Remote`, and a\ncomparison never suspends. `List` compares its elements from JavaScript, where\nnothing can wait.\n\nBut it may suspend: `eq` calls `lookup`, which suspends.\n\nHint: compare what the values hold, and do the work that suspends before\ncomparing them.\n"},{"code":"must_not_suspend","severity":"error","span":{"file":"tests/corpus/check/bad/core/SuspendingEqEvidence.beni","start":{"line":23,"col":1},"end":{"line":23,"col":8}},"title":"MUST NOT SUSPEND","message":"`compare` must not suspend: it is what `<`, `<=`, `>`, `>=`, `min` and `max`\ncall on `Remote`, and a comparison never suspends. `List` compares its elements\nfrom JavaScript, where nothing can wait.\n\nBut it may suspend: `compare` calls `eq`, and `eq` calls `lookup`, which\nsuspends.\n\nHint: compare what the values hold, and do the work that suspends before\ncomparing them.\n"}]
