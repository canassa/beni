[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsCellSharedEffect.beni","start":{"line":18,"col":27},"end":{"line":18,"col":38}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `requireSync` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: `park` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
