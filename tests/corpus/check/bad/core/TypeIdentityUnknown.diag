[{"code":"type_identity_unknown","severity":"error","span":{"file":"tests/corpus/check/bad/core/TypeIdentityUnknown.beni","start":{"line":17,"col":5},"end":{"line":17,"col":19}},"title":"UNKNOWN TYPE IDENTITY","message":"This key's type mentions `a`, a type variable no `where` clause here\nconstrains, so I cannot tell which type the key is of.\n\nA key carries its type's identity (`docs/design/boundary.md` §9.8.3), and a\nfunction generic over the type passes on its own: it has one for each type\nvariable it has a requirement on.\n\nHint: add `where a.compare : a, a → Order` to the annotation.\n"}]
