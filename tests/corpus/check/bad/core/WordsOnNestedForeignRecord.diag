[{"code":"misplaced_ownership_word","severity":"error","span":{"file":"tests/corpus/check/bad/core/WordsOnNestedForeignRecord.beni","start":{"line":2,"col":51},"end":{"line":2,"col":59}},"title":"MISPLACED OWNERSHIP WORD","message":"The ownership word `borrowed` is inside a type.\n\nA word describes a whole parameter or the whole result, so it stands in front\nof a parameter of the signature's arrow or in front of its result:\n`join : borrowed List String, String → String`. Move it there, or remove it."}]
