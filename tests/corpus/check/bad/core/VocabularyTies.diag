[{"code":"duplicate_declaration","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTies.beni","start":{"line":14,"col":13},"end":{"line":14,"col":16}},"title":"DUPLICATE DECLARATION","message":"`p` is declared twice: the element `p` above answers the same names on the\nsame elements.\n\nOf two declarations that could answer a name, the exact one wins, then the\npattern with the longer literal part (`docs/design/language.md` §11.14); these\ntwo tie, so which one answered would be arbitrary."},{"code":"duplicate_declaration","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTies.beni","start":{"line":20,"col":15},"end":{"line":20,"col":20}},"title":"DUPLICATE DECLARATION","message":"`*-y` is declared twice: the attribute `x-*` above answers the same names on the\nsame elements.\n\nOf two declarations that could answer a name, the exact one wins, then the\npattern with the longer literal part (`docs/design/language.md` §11.14); these\ntwo tie, so which one answered would be arbitrary."},{"code":"duplicate_declaration","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTies.beni","start":{"line":26,"col":11},"end":{"line":26,"col":20}},"title":"DUPLICATE DECLARATION","message":"`onClick` is declared twice: the attribute `onClick` above answers the same\nnames on the same elements.\n\nOf two declarations that could answer a name, the exact one wins, then the\npattern with the longer literal part (`docs/design/language.md` §11.14); these\ntwo tie, so which one answered would be arbitrary."},{"code":"duplicate_declaration","severity":"error","span":{"file":"tests/corpus/check/bad/core/VocabularyTies.beni","start":{"line":38,"col":13},"end":{"line":38,"col":19}},"title":"DUPLICATE DECLARATION","message":"`*-b*` is declared twice: the element `a*-*` above answers the same names on the\nsame elements.\n\nOf two declarations that could answer a name, the exact one wins, then the\npattern with the longer litera