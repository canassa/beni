-- Two declarations of one namespace that could answer the same name on the
-- same elements are `duplicate_declaration` at the later one
-- (checker-v2.md §25.2): an exact name twice (13:13), two patterns whose
-- literal parts are one length and some name matches both (19:15), and an
-- event named like an attribute (25:11). The same name on disjoint elements
-- (28:15, 31:15) is no tie.
pub foreign type Event


pub element "p"


pub element "p"


pub attribute "x-*" : String


pub attribute "*-y" : String


pub attribute "onClick" : String


pub event "onClick" : Event


pub attribute "value" on "input" : String


pub attribute "value" on "option" : String
