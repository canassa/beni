[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/ViaSuspends.beni","start":{"line":21,"col":11},"end":{"line":21,"col":19}},"title":"SUSPENDING CALLBACK","message":"This event's payload extractor must not suspend: a lowering calls it\nsynchronously, while the event is dispatched, outside any fiber\n(`docs/design/boundary.md` §9.3).\n\nBut it may suspend: `waits` calls `Js.suspending`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/ViaSuspends.beni","start":{"line":24,"col":11},"end":{"line":24,"col":21}},"title":"SUSPENDING CALLBACK","message":"This event's payload extractor must not suspend: a lowering calls it\nsynchronously, while the event is dispatched, outside any fiber\n(`docs/design/boundary.md` §9.3).\n\nBut it may suspend: `waitsF` suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
