[{"code":"invalid_js_module","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsModuleNotLiteral.beni","start":{"line":12,"col":19},"end":{"line":12,"col":23}},"title":"INVALID HOST MODULE","message":"`Js.module` writes its specifier as a static import's, so it must be a string\nliteral written in place: `Js.module \"node:path\"`.\n\nThis argument is not a string literal."}]
