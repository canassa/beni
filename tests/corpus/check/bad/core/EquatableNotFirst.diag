[{"code":"equatable_not_first_occurrence","severity":"error","span":{"file":"tests/corpus/check/bad/core/EquatableNotFirst.beni","start":{"line":5,"col":26},"end":{"line":5,"col":35}},"title":"EQUATABLE MARKER REPEATED","message":"This type variable is already marked `equatable`.\n\nThe prefix marks the VARIABLE, at its first occurrence, not the argument it\nstands in front of: `eq : equatable a -> a -> Bool` is a function of two\narguments whose type is one marked `a`. Write the marker once."},{"code":"equatable_not_first_occurrence","severity":"error","span":{"file":"tests/corpus/check/bad/core/EquatableNotFirst.beni","start":{"line":9,"col":15},"end":{"line":9,"col":24}},"title":"EQUATABLE MARKER REPEATED","message":"This type variable is already marked `equatable`.\n\nThe prefix marks the VARIABLE, at its first occurrence, not the argument it\nstands in front of: `eq : equatable a -> a -> Bool` is a function of two\narguments whose type is one marked `a`. Write the marker once."}]
