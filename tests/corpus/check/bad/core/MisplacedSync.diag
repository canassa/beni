[{"code":"misplaced_sync","severity":"error","span":{"file":"tests/corpus/check/bad/core/MisplacedSync.beni","start":{"line":12,"col":24},"end":{"line":12,"col":28}},"title":"MISPLACED SYNC","message":"`sync` marks a function type, and this is not one written out.\n\nWrite the function type itself inside the parentheses, as in\n`sync (String -> msg)`: the mark belongs to that one arrow. An alias of a\nfunction type is not enough, because the mark must be where the arrow is."},{"code":"misplaced_sync","severity":"error","span":{"file":"tests/corpus/check/bad/core/MisplacedSync.beni","start":{"line":15,"col":30},"end":{"line":15,"col":34}},"title":"MISPLACED SYNC","message":"This `sync` marks a function the platform hands back to beni, not one it\nreceives.\n\n`sync` says that the platform calls a function synchronously, so the function\nmust never suspend. That is a promise about a function the platform is GIVEN:\na parameter of the declaration, or something inside one. A function it returns,\nor passes to a callback of its own, is the platform's, and its declared rung\nalready says what calling it may do. Remove the `sync`."},{"code":"misplaced_sync","severity":"error","span":{"file":"tests/corpus/check/bad/core/MisplacedSync.beni","start":{"line":18,"col":27},"end":{"line":18,"col":31}},"title":"MISPLACED SYNC","message":"This `sync` marks a function the platform hands back to beni, not one it\nreceives.\n\n`sync` says that the platform calls a function synchronously, so the function\nmust never suspend. That is a promise about a function the platform is GIVEN:\na parameter of the declaration, or something inside one. A function it returns,\nor passes to a callback of its own, is the platform's, and its declared rung\nalready says what calling it may do. Remove the `sync`."}]
