[{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/core/CompareOnForeignWithUnrelatedCompare.beni","start":{"line":26,"col":16},"end":{"line":26,"col":17}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    ( Handle, Int )\n\nIt holds a `Handle`, and ordering that needs the `compare` of `Handle` at this\ntype:\n\n    Handle, Handle -> Order\n\nbut `CompareOnForeignWithUnrelatedCompare.compare` is:\n\n    Tag, Tag -> Order\n\nHint: this is the module-rule clash of\n`docs/design/static-dispatch-spike.md` §11. Move one of the types into a\nmodule of its own, or give the two methods different names.\n"}]
