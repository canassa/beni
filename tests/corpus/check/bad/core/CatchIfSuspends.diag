[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/CatchIfSuspends.beni","start":{"line":16,"col":10},"end":{"line":16,"col":11}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.catchIf` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/CatchIfSuspends.beni","start":{"line":25,"col":10},"end":{"line":25,"col":11}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.catchIf` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/CatchIfSuspends.beni","start":{"line":34,"col":10},"end":{"line":34,"col":11}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.catchIf` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
