[{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/CatchIfSuspends.beni","start":{"line":14,"col":22},"end":{"line":14,"col":23}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.catchIf` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/CatchIfSuspends.beni","start":{"line":18,"col":32},"end":{"line":18,"col":33}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.catchIf` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"},{"code":"sync_boundary","severity":"error","span":{"file":"tests/corpus/check/bad/core/CatchIfSuspends.beni","start":{"line":22,"col":46},"end":{"line":22,"col":47}},"title":"SUSPENDING CALLBACK","message":"This function must not suspend: `Js.catchIf` hands it to the platform, which\ncalls it synchronously.\n\nBut it may suspend: it calls `get`, which suspends.\n\nHint: a function called synchronously cannot wait for anything. Do the work that\nsuspends before handing this function over, and pass it what that work produced.\n"}]
