[{"code":"invalid_js_module","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsModuleNotBuiltin.beni","start":{"line":9,"col":17},"end":{"line":9,"col":25}},"title":"INVALID HOST MODULE","message":"`Js.module` imports a host built-in, a `node:` or `cloudflare:` module, whose\nevaluation the program cannot observe (`docs/design/backend.md` §9, *Host\nimports*).\n\nThis specifier names something else. A package could run anything when it is\nevaluated, and a path would name a file the output tree does not hold."},{"code":"invalid_js_module","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsModuleNotBuiltin.beni","start":{"line":13,"col":18},"end":{"line":13,"col":33}},"title":"INVALID HOST MODULE","message":"`Js.module` imports a host built-in, a `node:` or `cloudflare:` module, whose\nevaluation the program cannot observe (`docs/design/backend.md` §9, *Host\nimports*).\n\nThis specifier names something else. A package could run anything when it is\nevaluated, and a path would name a file the output tree does not hold."}]
