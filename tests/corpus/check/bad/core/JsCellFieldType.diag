[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/core/JsCellFieldType.beni","start":{"line":8,"col":31},"end":{"line":8,"col":37}},"title":"TYPE MISMATCH","message":"This is not a record with a `state` field:\n\nIt is:\n\n    { state : number }\n\nBut I need a record like:\n\n    { state : String }\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `cell` is a value of a block that is computed, once, where it is\nwritten: its right-hand side calls something, or is an `if`, a `case` or a\nblock. A computation can make something that holds values, such as a new\n`Ref`, and one such thing cannot hold two types, so `cell` has ONE type inside\nthe definition that holds it (`docs/design/checker-v2.md` §8.4). The first\nuse fixed the type; this one disagrees.\n\nGive `cell` a parameter, so that each call makes a new one, to use it at two.\n"}]
