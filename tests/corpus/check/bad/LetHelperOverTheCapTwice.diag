[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetHelperOverTheCapTwice.beni","start":{"line":142,"col":13},"end":{"line":142,"col":16}},"title":"TYPE MISMATCH","message":"The 1st argument to `h` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `h` needs the 1st argument to be:\n\n    Char\n\nHint: `h` is a `let` binding whose type needs more than 64 methods, one\nof them an `eq` method, and past that many a `let` binding is not\ngeneralised: it has ONE type inside the definition that holds it\n(`docs/design/static-dispatch-spike.md` §10.11). The first use fixed the\ntype; this is the second.\n\nMove `h` out to a top-level declaration annotated with its `where`\nclause to use it at two.\n"}]
