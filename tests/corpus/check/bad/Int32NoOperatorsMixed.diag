[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperatorsMixed.beni","start":{"line":19,"col":17},"end":{"line":19,"col":18}},"title":"TYPE MISMATCH","message":"The 2nd argument to `add` is not what I expect:\n\nThis argument is:\n\n    Int\n\nBut `add` needs the 2nd argument to be:\n\n    Int32\n\nHint: beni does not implicitly convert between `Int` and `Int32`. Use\n`Int32.fromInt` to go one way, and `Int32.toInt` or `Int32.toUnsignedInt`\nto go the other.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/Int32NoOperatorsMixed.beni","start":{"line":24,"col":21},"end":{"line":24,"col":22}},"title":"TYPE MISMATCH","message":"The 2nd argument to (+) is not what I expect:\n\nThis argument is:\n\n    Int32\n\nBut (+) needs the 2nd argument to be:\n\n    Int\n\nHint: beni does not implicitly convert between `Int` and `Int32`. Use\n`Int32.fromInt` to go one way, and `Int32.toInt` or `Int32.toUnsignedInt`\nto go the other.\n"}]
