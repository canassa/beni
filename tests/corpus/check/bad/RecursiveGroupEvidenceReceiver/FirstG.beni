-- See FirstF.beni. The same module with `g` written first.
type K
    = K Int


pub mix (K n) b = K n


useMix : a, b → a
    where a.mix : a, b → a
useMix x y = x.mix y


g n =
    if n > 100 then
        K n
    else
        _ = f (n + 1)
        K n


f n =
    r = g n
    q z = useMix r z
    ( q 1, q "s" )
