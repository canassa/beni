[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RecursiveGroupEvidenceReceiver/FirstF.beni","start":{"line":31,"col":14},"end":{"line":31,"col":15}},"title":"TYPE MISMATCH","message":"The 1st argument to `q` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `q` needs the 1st argument to be:\n\n    b\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To join text use `++`.\n\nHint: `r` comes from `g`, which is in a recursive group with `f`, so its type is\nnot known here yet. Annotate `g` and each use can instantiate it.\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/RecursiveGroupEvidenceReceiver/FirstG.beni","start":{"line":35,"col":14},"end":{"line":35,"col":15}},"title":"TYPE MISMATCH","message":"The 1st argument to `q` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `q` needs the 1st argument to be:\n\n    b\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To join text use `++`.\n\nHint: `r` comes from `g`, which is in a recursive group with `f`, so its type is\nnot known here yet. Annotate `g` and each use can instantiate it.\n"}]
