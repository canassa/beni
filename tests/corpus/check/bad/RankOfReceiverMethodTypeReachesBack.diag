[{"code":"unknown_method","severity":"error","span":{"file":"tests/corpus/check/bad/RankOfReceiverMethodTypeReachesBack.beni","start":{"line":16,"col":22},"end":{"line":16,"col":26}},"title":"UNKNOWN METHOD","message":"I cannot tell which type `foo` is being asked of here.\n\nA method is resolved in the module that declares its receiver's type, and\nnothing in this program ever says what that type is:\n\n    a type variable no use of this value determines\n\n`eq` and `compare` I could still answer, because they mean the same thing\nat every type. `foo` I cannot — it is declared for some type, and there\nis no type here to look it up in.\n\nHint: annotate the value at the type you mean.\n"}]
