[{"code":"misplaced_ownership_word","severity":"error","span":{"file":"tests/corpus/check/bad/OwnershipTypeWordOutsidePlatform.beni","start":{"line":8,"col":12},"end":{"line":8,"col":16}},"title":"MISPLACED OWNERSHIP WORD","message":"Only core and a platform package may write the ownership word `cell`.\n\nOwnership words say what a function does with the lists it is handed — read\nthem, keep them, return them, write them — for code the checker cannot see\ninto: a `foreign`, or a function written over `Js`. Everywhere else the checker\nreads that from the function's body, so a word here could only repeat it or\ncontradict it. Remove the word; the signature means the same without it."},{"code":"misplaced_ownership_word","severity":"error","span":{"file":"tests/corpus/check/bad/OwnershipTypeWordOutsidePlatform.beni","start":{"line":14,"col":7},"end":{"line":14,"col":14}},"title":"MISPLACED OWNERSHIP WORD","message":"Only core and a platform package may write the ownership word `failure`.\n\nOwnership words say what a function does with the lists it is handed — read\nthem, keep them, return them, write them — for code the checker cannot see\ninto: a `foreign`, or a function written over `Js`. Everywhere else the checker\nreads that from the function's body, so a word here could only repeat it or\ncontradict it. Remove the word; the signature means the same without it."},{"code":"misplaced_ownership_word","severity":"error","span":{"file":"tests/corpus/check/bad/OwnershipTypeWordOutsidePlatform.beni","start":{"line":17,"col":5},"end":{"line":17,"col":11}},"title":"MISPLACED OWNERSHIP WORD","message":"Only core and a platform package may write the ownership word `sender`.\n\nOwnership words say what a function does with the lists it is handed — read\nthem, keep them, return them, write them — for code the checker cannot see\ninto: a `foreign`, or a function written over `Js`. Everywhere else the checker\nreads that from the function's body, so a word here could only repeat it or\ncontradict it. Remove the word; the signature means the same without it."},{"code":"misplaced_ownership_word","severity":"error","span":{"file":"tests/corpus/check/bad/OwnershipTypeWordOutsidePlatform.beni","start":{"line":21,"col":14},"end":{"line":21,"col":20}},"title":"MISPLACED OWNERSHIP WORD","message":"Only core and a platform package may write the ownership word `stored`.\n\nOwnership words say what a function does with the lists it is handed — read\nthem, keep them, return them, write them — for code the checker cannot see\ninto: a `foreign`, or a function written over `Js`. Everywhere else the checker\nreads that from the function's body, so a word here could only repeat it or\ncontradict it. Remove the word; the signature means the same without it."}]
