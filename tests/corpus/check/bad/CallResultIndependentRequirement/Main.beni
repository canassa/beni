-- check/bad: a call's result mismatch silences only the requirements whose
-- method type reaches the callee's result (checker-v2.md §9 *No cascades*,
-- not every requirement of the call). `f`'s requirement `a.foo` has
-- nothing to do with its `Int` result, so `T`'s missing `foo` is still
-- `unknown_method`, and the author's own `z.foo ()` is not joined onto a
-- failed wanted. Silencing every requirement of a failed call is too wide:
-- it would leave only the `type_mismatch`.
import T exposing (T)


f : a, () -> Int
    where a.foo : a, () -> Int
f x _ =
    x.foo ()


q z =
    ( [ "a", f z () ], z.foo (), [ z, T.T 1 ] )
