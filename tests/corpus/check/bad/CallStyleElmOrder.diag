[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CallStyleElmOrder.beni","start":{"line":6,"col":28},"end":{"line":6,"col":32}},"title":"TYPE MISMATCH","message":"The 1st argument to `join` is not what I expect:\n\nThis argument is:\n\n    String\n\nBut `join` needs the 1st argument to be:\n\n    List String\n\nHint: `String.join` takes its arguments in another order than Elm's — the\nsubject first, a function last:\n\n    String.join names \", \"\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CallStyleElmOrder.beni","start":{"line":10,"col":32},"end":{"line":10,"col":33}},"title":"TYPE MISMATCH","message":"The 1st argument to `withDefault` is not what I expect:\n\nThis argument is:\n\n    number\n\nBut `withDefault` needs the 1st argument to be:\n\n    Maybe Int\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `Maybe.withDefault` takes its arguments in another order than Elm's — the\nsubject first, a function last:\n\n    Maybe.withDefault m 0\n"},{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/CallStyleElmOrder.beni","start":{"line":14,"col":25},"end":{"line":14,"col":26}},"title":"TYPE MISMATCH","message":"The 1st argument to `slice` is not what I expect:\n\nThis argument is:\n\n    number\n\nBut `slice` needs the 1st argument to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `String.slice` takes its arguments in another order than Elm's — the\nsubject first, a function last:\n\n    String.slice s 1 3\n"}]
