-- `g`'s parameter is reachable from the method constraint on the
-- OUTER receiver `x`, so HM(X) does not generalise it (checker-v2.md §8.4):
-- `g 1` fixes it to a number and `g "s"` is a `type_mismatch` at `"s"`.
-- Generalising it would publish `f : a -> ( b, c ) where a.combine : a, d -> e`
-- — free `d`, `e` — and the program would build, printing 6, 5s and NaN.

type T
    = T Int


pub combine : T, Int -> Int
combine (T a) b = a + b


f x =
    g y = x.combine y
    ( g 1, g "s" )


pair : ( Int, Int )
pair = f (T 5)
