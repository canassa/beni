[{"code":"unknown_method","severity":"error","span":{"file":"tests/corpus/check/bad/TypeDispatchUnpinnedResult.beni","start":{"line":24,"col":15},"end":{"line":24,"col":25}},"title":"UNKNOWN METHOD","message":"I cannot tell which type `fromInt` is being asked of here.\n\nA method is resolved in the module that declares its receiver's type, and\nnothing in this program ever says what that type is:\n\n    a type variable no use of this value determines\n\n`eq` and `compare` I could still answer, because they mean the same thing\nat every type. `fromInt` I cannot — it is declared for some type, and there\nis no type here to look it up in.\n\nHint: annotate the value at the type you mean.\n"}]
