[{"code":"let_forward_reference","severity":"error","span":{"file":"tests/corpus/check/bad/LetCycleThroughFunction.beni","start":{"line":12,"col":9},"end":{"line":12,"col":12}},"title":"LET BINDING USED TOO SOON","message":"`n` is defined in terms of itself, through `get`: naming `get` here may call\n`get`, and `get` reads `n`.\n\nA `let` evaluates its value bindings in the order they are written, so `n` has\nno value yet inside its own right-hand side. Only a FUNCTION can be recursive:\ngive `n` a parameter, or compute it without `get`."}]
