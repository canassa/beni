-- The `compare` side of `DerivedContextEquatableFlag`: `W`'s derived `compare`
-- goes through `H.compare`, whose `a` is `equatable`, so `W`'s `compare`
-- context holds `(0, eq)` and `<` on a `W` of a function is refused.
import H


type W a
    = W (H.Holder a)


f : Int -> Int
f n = n


less : Bool
less = W (H.Holder f) < W (H.Holder f)
