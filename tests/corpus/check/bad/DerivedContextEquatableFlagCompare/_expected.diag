[{"code":"no_methods_on_shape","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedContextEquatableFlagCompare/Main.beni","start":{"line":18,"col":20},"end":{"line":18,"col":21}},"title":"NO METHODS HERE","message":"This type has no `compare`:\n\n    W (Int -> Int)\n\nThere is a function inside it, and functions have no ordering — so the\ncompiler cannot write one for the type that holds them either.\n\nHint: order by something you can compare — a name, an id — that sits\nnext to the function.\n"}]
