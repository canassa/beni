[{"code":"invalid_keyed","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupInvalidKeyed.beni","start":{"line":7,"col":29},"end":{"line":7,"col":39}},"title":"INVALID KEYED","message":"`keyed=\"id\"` is not a keying mode of `<For>`.\n\n`keyed` takes a key function, `keyed={.id}`, or a mode: bare `keyed` or\n`keyed={True}` keeps a row by its item's identity, and `keyed={False}` (on\n`<For>`) by its position."},{"code":"invalid_keyed","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupInvalidKeyed.beni","start":{"line":8,"col":29},"end":{"line":8,"col":38}},"title":"INVALID KEYED","message":"`keyed={1}` is not a keying mode of `<For>`.\n\n`keyed` takes a key function, `keyed={.id}`, or a mode: bare `keyed` or\n`keyed={True}` keeps a row by its item's identity, and `keyed={False}` (on\n`<For>`) by its position."},{"code":"invalid_keyed","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupInvalidKeyed.beni","start":{"line":9,"col":30},"end":{"line":9,"col":43}},"title":"INVALID KEYED","message":"`keyed={False}` would make a `<Show>` that never remounts, which is a `case`.\n\nWrite `keyed`, or `keyed={.id}` for a key, or the `case` itself:\n\n    case model.b of\n        Just x ->\n            <p />\n\n        Nothing ->\n            <></>"}]
