[{"code":"duplicate_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupDuplicateAttributeCase.beni","start":{"line":8,"col":22},"end":{"line":8,"col":29}},"title":"DUPLICATE ATTRIBUTE","message":"The attribute `\"TITLE\"` is written twice; the first is on line 8. HTML reads an\nelement's attribute names without regard to case, so `title` and `\"TITLE\"` are\none name.\n\nEach attribute is written once, or the second would silently win. Remove one of\nthe two."},{"code":"duplicate_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupDuplicateAttributeCase.beni","start":{"line":9,"col":25},"end":{"line":9,"col":33}},"title":"DUPLICATE ATTRIBUTE","message":"The attribute `\"DATA-x\"` is written twice; the first is on line 9. HTML reads an\nelement's attribute names without regard to case, so `\"data-X\"` and `\"DATA-x\"`\nare one name.\n\nEach attribute is written once, or the second would silently win. Remove one of\nthe two."}]
