-- CK-115: a call whose argument is already a mistake gets that one message.
-- A requirement of the callee (`a.key`) whose receiver no checked argument
-- determined asks nothing: no UNKNOWN METHOD ("I cannot tell which type `key`
-- is being asked of") beside the TYPE MISMATCH or TOO MANY ARGS
-- (checker.md §8.7; checker-v2.md §7.1). R8a's review saw the extra message;
-- 3ff3ac5 prints the one message for each call below, so this is a guard.
type T
    = T Int


key : T, () -> Int
key t u =
    case t of
        T n ->
            n


same : List a, a -> Bool
    where a.key : a, () -> Int
same xs z =
    List.all xs (\x -> x.key () == z.key ())


wrongFirst : Bool
wrongFirst =
    same "nope" (T 1)


tooMany : Bool
tooMany =
    same [ T 1 1 ] (T 2)
