[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetOfManyBindings.beni","start":{"line":5009,"col":25},"end":{"line":5009,"col":30}},"title":"TYPE MISMATCH","message":"The 1st argument to `length` is not what I expect:\n\nThis argument is:\n\n    number\n\nBut `length` needs the 1st argument to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: want to turn a number into a `String`? Use `String.fromInt` or\n`String.fromFloat`.\n"}]
