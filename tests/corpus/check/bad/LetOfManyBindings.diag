[{"code":"kind_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetOfManyBindings.beni","start":{"line":10010,"col":29},"end":{"line":10010,"col":34}},"title":"TYPE MISMATCH","message":"The 1st argument to `length` is not what I expect:\n\nThis argument is:\n\n    number\n\nBut `length` needs the 1st argument to be:\n\n    String\n\nOne of those has to be a number — an `Int` or a `Float` — and it is not.\n\nHint: `+`, `-`, `*` and `/` work on numbers only. To join text use `++`.\n"}]
