-- check/bad: a tuple ELEMENT of function type has to print parenthesised
-- (checker.md §8.2, language.md §3, Types). A tuple element may not contain a
-- bare `->`, so `( Int -> Int, Int )` is not this type at all — the parser
-- reads that as a 2-ary function — and a type in a diagnostic is text the
-- reader pastes back into their source.
pub apply : ( (Int -> Int), Int ) -> Int
apply _ =
    0


pub wrong : Int
wrong =
    apply "x"
