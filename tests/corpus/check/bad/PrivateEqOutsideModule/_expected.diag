[{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":10,"col":24},"end":{"line":10,"col":26}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    W\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":14,"col":25},"end":{"line":14,"col":27}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    ( T, number )\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":18,"col":27},"end":{"line":18,"col":29}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    { a : T }\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":22,"col":21},"end":{"line":22,"col":23}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    List T\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"}]
