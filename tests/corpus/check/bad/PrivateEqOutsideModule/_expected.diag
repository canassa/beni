[{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":11,"col":15},"end":{"line":11,"col":17}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    W\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":16,"col":18},"end":{"line":16,"col":20}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    ( T, number )\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":21,"col":19},"end":{"line":21,"col":21}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    { a : T }\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"},{"code":"private_method","severity":"error","span":{"file":"tests/corpus/check/bad/PrivateEqOutsideModule/Main.beni","start":{"line":26,"col":15},"end":{"line":26,"col":17}},"title":"PRIVATE METHOD","message":"`M.eq` is not `pub`.\n\nThis needs the `eq` of `T`, declared in `M`, which is inside:\n\n    List T\n\n`M` declares `eq` without `pub`, and it is the `eq` of every type `M`\ndeclares, so it is private to that module: it cannot be used from here,\ndirectly or inside another value.\n\nHint: add `pub` to `eq` in `M`.\n"}]
