-- A private method answers dispatch only inside its own module
-- (the owner's decision, checker-v2.md §11.3). `T`'s `eq` compares modulo 10
-- and is private, so every comparison in `Main` that reaches it — through
-- `Main`'s own derived `W`, a tuple, a record or a list — is
-- `private_method` at its `==`, as the direct `M.T 1 == M.T 11` already is.
-- Deriving structurally without asking whether `eq` is private would make
-- `M.inside (M.T 1) (M.T 11)` `True` while the `W`, tuple and record
-- comparisons build and print `False`: the same two
-- values would compare differently in two places.
pub type T
    = T Int


eq : T, T -> Bool
eq left right =
    case left of
        T x ->
            case right of
                T y ->
                    modBy x 10 == modBy y 10


pub inside : T, T -> Bool
inside a b = a == b
