[{"code":"missing_form_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupMissingFormAttribute.beni","start":{"line":7,"col":10},"end":{"line":7,"col":13}},"title":"MISSING ATTRIBUTE","message":"This `<For>` has no `each`: the list it renders.\n\n    <For each={items} keyed={.id}>{λitem → <li>{item.label}</li>}</For>"},{"code":"missing_form_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupMissingFormAttribute.beni","start":{"line":8,"col":10},"end":{"line":8,"col":14}},"title":"MISSING ATTRIBUTE","message":"This `<Show>` has no `keyed`, so it would not say when to rebuild what it shows.\n\nA `<Show>` remounts its body when its value changes: `keyed` for a new value by\nidentity, `keyed={.id}` for a new key. To patch the body in place instead, write\nthe `case` it would be:\n\n    case model.user of\n        Just u →\n            <p />\n\n        Nothing →\n            <></>"},{"code":"missing_form_attribute","severity":"error","span":{"file":"tests/corpus/check/bad/MarkupMissingFormAttribute.beni","start":{"line":9,"col":10},"end":{"line":9,"col":14}},"title":"MISSING ATTRIBUTE","message":"This `<Show>` has no `when`: the `Maybe` whose value it shows.\n\n    <Show when={model.user} keyed>{λuser → <UserEditor user={user} />}</Show>"}]
