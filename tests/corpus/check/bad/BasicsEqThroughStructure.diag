[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/BasicsEqThroughStructure.beni","start":{"line":12,"col":22},"end":{"line":12,"col":23}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`:\n\n    List a\n\nThe annotation says ANY type can flow through here, and not every type can\nbe compared — a function cannot.\n\nHint: make the annotation concrete, or take an equality function as an\nargument instead of using `Basics.eq`.\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/BasicsEqThroughStructure.beni","start":{"line":19,"col":14},"end":{"line":19,"col":15}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `Basics.eq`, which `same2` requires:\n\n    number -> number\n\nThere is a function in there, and comparing functions is not decidable:\ndeciding whether two functions agree on every input is the halting problem.\n\nHint: compare the values the functions produce, or store something you can\ncompare — a name, an id — next to the function.\n"}]
