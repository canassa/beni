[{"code":"missing_where_constraint","severity":"error","span":{"file":"tests/corpus/check/bad/BasicsEqThroughStructure.beni","start":{"line":12,"col":12},"end":{"line":12,"col":21}},"title":"MISSING CONSTRAINT","message":"I need `a.eq` here, and the annotation does not allow it.\n\nThis call needs `a` to have a method `eq`:\n\n    eq : a, a → Bool\n\nbut `a` is any type at all. `eq` is required by `Basics.eq`.\n\nHint: add it to the annotation:\n\n    where a.eq : a, a → Bool\n"},{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/BasicsEqThroughStructure.beni","start":{"line":19,"col":7},"end":{"line":19,"col":12}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `.eq`, which `same2` requires:\n\n    a → b\n\nThere is a function in there, and comparing functions is not decidable:\ndeciding whether two functions agree on every input is the halting problem.\n\nHint: compare the values the functions produce, or store something you can\ncompare — a name, an id — next to the function.\n"}]
