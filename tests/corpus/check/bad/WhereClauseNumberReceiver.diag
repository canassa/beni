[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/WhereClauseNumberReceiver.beni","start":{"line":37,"col":5},"end":{"line":37,"col":7}},"title":"TYPE MISMATCH","message":"The `where a.eq` clause of `f1` does not match the `eq` of `number`:\n\nWith `a` as `number`, the clause asks for:\n\n    number, number -> String\n\nBut the `eq` of `number` is:\n\n    number, number -> Bool\n\nHint: `eq` means the same thing at every type, `a, a -> Bool`, so a\n`where` clause that names it has to give it that type.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/WhereClauseNumberReceiver.beni","start":{"line":42,"col":5},"end":{"line":42,"col":7}},"title":"TYPE MISMATCH","message":"The `where a.compare` clause of `f2` does not match the `compare` of `number`:\n\nWith `a` as `number`, the clause asks for:\n\n    number, number -> Int\n\nBut the `compare` of `number` is:\n\n    number, number -> Order\n\nHint: `compare` means the same thing at every type, `a, a -> Order`, so a\n`where` clause that names it has to give it that type.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/WhereClauseNumberReceiver.beni","start":{"line":47,"col":5},"end":{"line":47,"col":6}},"title":"TYPE MISMATCH","message":"The `where a.compare` clause of `g` does not match the `compare` of `number`:\n\nWith `a` as `number`, the clause asks for:\n\n    number, number -> Int\n\nBut the `compare` of `number` is:\n\n    number, number -> Order\n\nHint: `compare` means the same thing at every type, `a, a -> Order`, so a\n`where` clause that names it has to give it that type.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/WhereClauseNumberReceiver.beni","start":{"line":52,"col":5},"end":{"line":52,"col":7}},"title":"TYPE MISMATCH","message":"The `where a.compare` clause of `f4` does not match the `compare` of `number`:\n\nWith `a` as `number`, the clause asks for:\n\n    number, number -> Bool\n\nBut the `compare` of `number` is:\n\n    number, number -> Order\n\nHint: `compare` means the same thing at every type, `a, a -> Order`, so a\n`where` clause that names it has to give it that type.\n"}]
