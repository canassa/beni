[{"code":"infinite_type","severity":"error","span":{"file":"tests/corpus/check/bad/InfiniteTypeKeepsUsefulness.beni","start":{"line":7,"col":9},"end":{"line":7,"col":10}},"title":"INFINITE TYPE","message":"I am inferring a weird self-referential type for `x`:\n\nHere is my best effort at writing it down, with `a` standing for the whole\ntype wherever it repeats inside itself:\n\n    a = List a\n\nHint: the type would go on forever, so I gave up. This usually means a\ndefinition is missing an argument, or is being used with one argument too\nmany, somewhere inside itself.\n"},{"code":"redundant_pattern","severity":"error","span":{"file":"tests/corpus/check/bad/InfiniteTypeKeepsUsefulness.beni","start":{"line":10,"col":13},"end":{"line":10,"col":14}},"title":"REDUNDANT PATTERN","message":"The 2nd pattern is redundant:\n\nAny value with this shape is matched by a branch above it, so this branch\nnever runs. Remove it, or make it more specific than the one that shadows it.\n"}]
