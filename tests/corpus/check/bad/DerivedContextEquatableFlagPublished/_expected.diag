[{"code":"not_equatable","severity":"error","span":{"file":"tests/corpus/check/bad/DerivedContextEquatableFlagPublished/Main.beni","start":{"line":15,"col":26},"end":{"line":15,"col":28}},"title":"NOT EQUATABLE","message":"I cannot compare these values with `==`:\n\n    Box (Int -> Int)\n\nThat type does not support `==`.\n\nHint: a `type` is comparable exactly when everything it can hold is, so a\nfunction anywhere inside it rules the whole type out. A `foreign type` is\ncomparable only when it is declared `equatable`.\n"}]
