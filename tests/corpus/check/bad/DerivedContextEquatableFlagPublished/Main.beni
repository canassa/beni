-- check/bad: the `equatable` flag `H.eq` puts on `Box`'s
-- parameter is an entry of `Box`'s published context, so another module
-- comparing a `Mid.Box` of a function is refused.
import H
import Mid


f : Int -> Int
f n =
    n


same : Bool
same =
    Mid.Box (H.Holder f) == Mid.Box (H.Holder f)
