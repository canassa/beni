-- The `case` binder `x` has an infinite type, and the `case` is still
-- checked for usefulness: exhaustiveness reads no solved type, so an
-- `infinite_type` does not gate it (checker-v2.md §15.2). Both the cycle
-- and the `redundant_pattern` are reported.
m =
    case List.foldr [] [] List.intersperse of
        x →
            0

        [ [ [] ] ] →
            1

        _ →
            2
