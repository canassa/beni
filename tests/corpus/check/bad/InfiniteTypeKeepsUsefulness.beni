-- CK-04: the `case` binder `x` has an infinite type, and the `case` is still
-- checked for usefulness: exhaustiveness reads no solved type (CK-61), so an
-- `infinite_type` does not gate it (checker-v2.md §15.2, as amended by R4b's
-- review). v1 reports only the `redundant_pattern` (it misses the cycle).
m =
    case List.foldr [] [] List.intersperse of
        x ->
            0

        [ [ [] ] ] ->
            1

        _ ->
            2
