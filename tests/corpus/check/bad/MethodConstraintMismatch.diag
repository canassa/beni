[{"code":"ambiguous_method_receiver","severity":"warning","span":{"file":"tests/corpus/check/bad/MethodConstraintMismatch.beni","start":{"line":14,"col":5},"end":{"line":14,"col":10}},"title":"CONSTRAINT IN AN INFERRED INTERFACE","message":"`widen` is `pub`, has no annotation, and its inferred type carries 1 method\nconstraint(s):\n\n    a -> ( b, c ) where a.render : ?\n\nEditing the body can change this, and changing it re-checks every importer.\n\nHint: an annotation pins it.\n"},{"code":"method_constraint_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/MethodConstraintMismatch.beni","start":{"line":15,"col":20},"end":{"line":15,"col":27}},"title":"CONFLICTING METHOD TYPES","message":"`render` is used at two different types here.\n\nHere it is used at:\n\n    a, b, c -> d\n\nand earlier it was used at:\n\n    a, number -> e\n\nOne variable carries one constraint per method name, so these have to agree.\n\nHint: give the two uses different type variables, or annotate.\n"}]
