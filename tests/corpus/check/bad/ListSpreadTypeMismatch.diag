[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ListSpreadTypeMismatch.beni","start":{"line":9,"col":21},"end":{"line":9,"col":26}},"title":"TYPE MISMATCH","message":"The 2nd argument to `List.cons` is not what I expect — `[ x, ...xs ]` is\n`List.cons x xs`:\n\nThis argument is:\n\n    List String\n\nBut `List.cons` needs the 2nd argument to be:\n\n    List Int\n\nHint: I work out a call's argument types from left to right, and once an\nargument fits I move on. So the mistake may be in one of the earlier\narguments rather than in this one.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ListSpreadTypeMismatch.beni","start":{"line":13,"col":20},"end":{"line":13,"col":23}},"title":"TYPE MISMATCH","message":"The 1st element of this list is not what the list needs:\n\nThe 1st element is:\n\n    String\n\nBut this list needs its elements to be:\n\n    Int\n\nHint: to read a number out of text, use `String.toInt` or `String.toFloat`.\n"},{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/ListSpreadTypeMismatch.beni","start":{"line":20,"col":13},"end":{"line":20,"col":17}},"title":"TYPE MISMATCH","message":"Something is off with the body of this definition:\n\nThe body is:\n\n    List Int\n\nBut the type annotation says it should be:\n\n    List String\n"}]
