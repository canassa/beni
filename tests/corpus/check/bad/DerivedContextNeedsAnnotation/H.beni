-- A PARAMETRIC derived context that depends on a method still in
-- flight cannot be computed, and says so: `W a`'s context depends on `T a`'s
-- `key` (through `H.eq`'s `where a.key`), and `key`'s own body asks for `W`'s
-- `eq`. That is `method_needs_annotation` naming `key`, in either
-- declaration order (the owner's decision as amended, checker-v2.md §11.2),
-- never NOT EQUATABLE `W a`, a refusal for the wrong reason.
pub type Holder a
    = Holder a


pub eq : Holder a, Holder a -> Bool
    where a.key : a, () -> Int
eq left right =
    case left of
        Holder l ->
            case right of
                Holder r ->
                    l.key () == r.key ()
