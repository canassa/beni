-- check/bad: `let` was widened with parameters and by the same analysis (§7,
-- decided 2026-09-18) — `let (Boxed n) = b` is legal because `Boxed`
-- is its type's only constructor, and `let (Just v) = m` is
-- refutable_let_pattern from the CHECKER, at 14:9, naming what is missing. A
-- constructor nested inside an irrefutable tuple counts (23:19): the analysis
-- reads the whole pattern as one row.
type Boxed
    = Boxed Int


pub refutable : Maybe Int → Int
refutable m =
    Just v = m
    v


pub insideTuple : Maybe Int × Int → Int
insideTuple pair =
    ( Just v, n ) = pair
    v + n


pub fine : Boxed → Int
fine b =
    (Boxed n) = b
    n
