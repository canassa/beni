[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/bad/LetValueConstrainedTwice.beni","start":{"line":15,"col":26},"end":{"line":15,"col":29}},"title":"TYPE MISMATCH","message":"The 1st argument to `same` is not what I expect:\n\nThis argument is:\n\n    Char\n\nBut `same` needs the 1st argument to be:\n\n    String\n\nHint: `same` is a value of a block, with no parameters, whose type needs an\n`eq` method. A value is computed once, where it is written, so it has ONE\ntype inside the definition that holds it (`docs/design/checker-v2.md`\n§8.4). The first use fixed the type; this is the second.\n\nGive `same` a parameter, or move it out to a top-level declaration\nannotated with `where … .eq : …`, to use it at two.\n"}]
