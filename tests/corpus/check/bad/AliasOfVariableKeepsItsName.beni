-- A message prints an alias of a type variable by the name the
-- annotation wrote. `Id b` is `b`, and `bad`'s annotation says `Id b`; `f5`'s
-- parameter is `Id a`. Neither `Id b`/`Id a` nor the bare `b`/`a` may take
-- the other's place: a flex meeting an alias whose expansion is a variable
-- must keep the alias (`Unify.throughAlias`), or the declaration's result
-- and parameter variables lose the name the annotation wrote.
-- Expected: the names, and the rigid hint naming
-- the annotation's variable (`b`, then `a`) looked for through the alias.
type alias Id a =
    a


type alias Name =
    String


bad : a → Id b
bad x = x


f5 : Id a → Name
f5 x = x
