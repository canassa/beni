[{"code":"wrong_type_arity","severity":"error","span":{"file":"tests/corpus/check/bad/WrongSchemaTypeArity.beni","start":{"line":5,"col":7},"end":{"line":5,"col":16}},"title":"WRONG TYPE ARITY","message":"`Page` takes 1 type argument, but here it has 0.\n\nEvery type constructor is fully applied — beni has no higher-kinded types — so\nthe number has to match the declaration exactly."}]
