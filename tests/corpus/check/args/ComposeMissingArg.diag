[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/ComposeMissingArg.beni","start":{"line":6,"col":5},"end":{"line":6,"col":20}},"title":"TOO FEW ARGS","message":"The `composeR` function expects 3 arguments, but it got only 2.\n\nThe missing argument is:\n\n    a\n\nSo this call produces a function:\n\n    a -> c\n\nBut I needed a value of type:\n\n    String\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
