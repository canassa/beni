[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/DictInsertMissingDict.beni","start":{"line":8,"col":5},"end":{"line":8,"col":16}},"title":"TOO FEW ARGS","message":"The `insert` function expects 3 arguments, but it got only 2.\n\nThe missing argument is:\n\n    Dict k v\n\nSo this call produces a function:\n\n    Dict k v -> Dict k v\n\nBut I needed a value of type:\n\n    Dict Int String\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
