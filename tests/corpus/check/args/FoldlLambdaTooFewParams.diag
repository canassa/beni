[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/args/FoldlLambdaTooFewParams.beni","start":{"line":5,"col":22},"end":{"line":5,"col":23}},"title":"TYPE MISMATCH","message":"The 3rd argument to `foldl` is not what I expect:\n\nThis argument is:\n\n    a -> b\n\nBut `foldl` needs the 3rd argument to be:\n\n    Int, Int -> Int\n\nHint: I need a function of 2 arguments, and this one takes 1 argument.\n\nHint: I work out a call's argument types from left to right, and once an\nargument fits I move on. So the mistake may be in one of the earlier\narguments rather than in this one.\n"}]
