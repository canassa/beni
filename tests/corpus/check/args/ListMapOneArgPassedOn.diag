[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/ListMapOneArgPassedOn.beni","start":{"line":5,"col":18},"end":{"line":5,"col":26}},"title":"TOO FEW ARGS","message":"The `map` function expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    List a\n\nSo this call produces a function:\n\n    List a -> List b\n\nBut I needed a value of type:\n\n    List a2\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
