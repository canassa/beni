[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/FilterPredicateMissingArg.beni","start":{"line":5,"col":24},"end":{"line":5,"col":27}},"title":"TOO FEW ARGS","message":"The `max` function expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    number\n\nSo this call produces a function:\n\n    number -> number\n\nBut I needed a value of type:\n\n    Bool\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
