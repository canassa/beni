[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/ResultMapMissingResult.beni","start":{"line":5,"col":5},"end":{"line":5,"col":15}},"title":"TOO FEW ARGS","message":"The `map` function expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    Result x a\n\nSo this call produces a function:\n\n    Result x a -> Result x value\n\nBut I needed a value of type:\n\n    Result String Int\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
