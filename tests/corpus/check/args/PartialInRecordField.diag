[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/PartialInRecordField.beni","start":{"line":8,"col":15},"end":{"line":8,"col":18}},"title":"TOO FEW ARGS","message":"The `max` function expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    number\n\nSo this call produces a function:\n\n    number -> number\n\nBut I needed a value of type:\n\n    Int\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
