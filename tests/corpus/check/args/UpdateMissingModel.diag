[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/UpdateMissingModel.beni","start":{"line":25,"col":5},"end":{"line":25,"col":11}},"title":"TOO FEW ARGS","message":"The `update` function expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    Model\n\nSo this call produces a function:\n\n    Model -> Model\n\nBut I needed a value of type:\n\n    Model\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
