[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/PartialConstructor.beni","start":{"line":10,"col":5},"end":{"line":10,"col":11}},"title":"TOO FEW ARGS","message":"The `Person` constructor expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    Int\n\nSo this call produces a function:\n\n    Int -> Person\n\nBut I needed a value of type:\n\n    Person\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
