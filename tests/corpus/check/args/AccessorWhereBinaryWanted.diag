[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/args/AccessorWhereBinaryWanted.beni","start":{"line":10,"col":25},"end":{"line":10,"col":31}},"title":"TYPE MISMATCH","message":"The 3rd argument to `foldl` is not what I expect:\n\nThis argument is:\n\n    List Person\n\nBut `foldl` needs the 3rd argument to be:\n\n    List { name : String -> String }\n\nHint: the 1st argument is a function of 1 argument, and this call needs one of\n2 arguments there. That is the likelier mistake: I work out a call's argument\ntypes from left to right, so a function that is too small in an earlier\nposition shows up as a mismatch in a later one.\n"}]
