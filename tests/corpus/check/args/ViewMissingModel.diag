[{"code":"too_few_args","severity":"error","span":{"file":"tests/corpus/check/args/ViewMissingModel.beni","start":{"line":18,"col":5},"end":{"line":18,"col":9}},"title":"TOO FEW ARGS","message":"The `view` function expects 2 arguments, but it got only 1.\n\nThe missing argument is:\n\n    Model\n\nSo this call produces a function:\n\n    Model -> String\n\nBut I needed a value of type:\n\n    String\n\nHint: a call with too few arguments is a function, not a value. Give it the\nremaining ones, or check whether an argument was dropped by mistake.\n"}]
