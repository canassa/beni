[{"code":"type_mismatch","severity":"error","span":{"file":"tests/corpus/check/args/ArgumentOrderSwap.beni","start":{"line":7,"col":31},"end":{"line":7,"col":33}},"title":"TYPE MISMATCH","message":"The 1st argument to `foldl` is not what I expect:\n\nThis argument is:\n\n    a, b -> c\n\nBut `foldl` needs the 1st argument to be:\n\n    List a2\n\nHint: this function looks like it belongs in the 3rd argument, which takes\none. beni's functions take their subject first — `List.map list f`, where\nElm writes `List.map f list` — so the arguments may be the wrong way round.\n"}]
