module SchemaRecordViaWrapped
  schema Rec
    type Type : { f : Mine }
    type Encoded : { f : Int }
    value schema : () -> Schema Rec.Encoded Rec.Type
    value parse : String -> Result (List Issue) Rec.Type
    value print : Rec.Type -> Result (List Issue) String
    value parseWith : Options, String -> Result (List Issue) Rec.Type
    value printWith : Options, Rec.Type -> Result (List Issue) String
