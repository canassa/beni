module SchemaTypeConstructorArgument
  alias Items
  type Wrap
    Wrap/1
    WrapAll/1
  schema Item
    type Type : { name : String }
    type Encoded : { name : String }
    value schema : ⊤ → Schema Item.Encoded Item.Type
    value parse : String → Result (List Issue) Item.Type
    value print : Item.Type → Result (List Issue) String
    value parseWith : Options, String → Result (List Issue) Item.Type
    value printWith : Options, Item.Type → Result (List Issue) String
  value names : Wrap → List String
  value wrap : List Item.Type → Wrap
  value wrapAll : Items → Wrap
