-- (the interface form) two mutually recursive members whose
-- parameters are used in different positions. Each member's locals are its
-- own (checker-v2.md §6.2), so `u : a, b -> c` and
-- `v : number, b, a -> c` — which the interface prints with its own letters,
-- `v : number, a, b -> c` — never `u : number, a -> b` and
-- `v : number, a, number -> b`, which reading `u`'s locals from `v`'s slice gives.


pub u x y =
    v 1 y x


pub v p q r =
    u r q
