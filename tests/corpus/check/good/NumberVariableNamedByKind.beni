-- A variable of kind `number` prints as `number`, even when
-- unification gave it another variable's name — `cons`'s `a`, met by the
-- literal's unnamed `number` (checker.md §8.7). The interface never reads
-- `g : List a`, `h : List a` or `f : a -> List a2`: the kind is kept
-- (`String.toUpper (List.head g …)` is refused) and so is its name.
--
pub g =
    1 :: []


pub h =
    List.singleton 2


pub f u =
    let
        p1 =
            []
    in
    1 :: p1
