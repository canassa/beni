-- check/good: the closed twin of `check/bad/SchemaEndpointInFlight`
-- (checker-v2.md §11.5). `h` compares `Loop.Type`s, `conv` calls `h`, and `Loop`'s `via`
-- is `conv`, so `h`, `conv` and `Loop` end up one group: the endpoint's
-- payload is inferred together with the comparison. `Loop.Type` has no
-- parameter, so the comparison is deferred and checked once the group is
-- done — `conv`'s target is `Int`, so it compares. Refusing it with
-- `method_needs_annotation` would be a restriction
-- no guarantee needs (rule 7).
import Schema exposing (Conversion)


mk : Int -> Conversion Int Int
mk n =
    Debug.todo "checker-only conversion"


mkLoop : Int -> Loop.Type
mkLoop n =
    Debug.todo "l"


h n =
    if mkLoop n == mkLoop 2 then
        n

    else
        n


conv =
    mk (h 1)


pub schema Loop tagged "kind" of
    Step as "step"
        payload : Int via conv
