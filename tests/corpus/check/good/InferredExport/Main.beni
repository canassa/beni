-- check/good (project): the importer uses one inferred scheme at two
-- different types in one module, which only works if instantiation from the
-- interface really copies the scheme (checker.md §7).
import Helpers exposing (firstOf, pair, swap)


pub numbers : ( Int, String )
numbers = pair 1 "one"


pub words : ( String, Int )
words = pair "two" 2


pub flipped : ( Int, String )
flipped = swap { first = "three", second = 3 }


pub head : Int
head = firstOf [ 1, 2, 3 ] 0
