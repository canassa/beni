-- check/good (project): `pub` values with NO annotation. What the importer
-- instantiates is the scheme the checker inferred, which the golden states —
-- so a change in what inference generalises shows up here as a number to
-- look at rather than as silence.
pub pair a b =
    ( a, b )


pub swap p =
    ( p.second, p.first )


pub firstOf xs ifEmpty =
    case xs of
        [] ->
            ifEmpty

        [ x, ...rest ] ->
            x
