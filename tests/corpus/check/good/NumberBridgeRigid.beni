-- The `number` bridge on a RIGID (checker-v2.md §9.2's `rigid` row, D9 as
-- amended): a `number` is `Int` or `Float`, so `<`, `==` and `number.eq`
-- need no `where` clause and no evidence — `core`'s `abs`, `max` and
-- `run/DecodeInto`'s `sameNum`. Each answers with the method type checked
-- against the well-known one first.
pub absolute : number -> number
absolute n =
    if n < 0 then
        negate n

    else
        n


pub larger : number, number -> number
larger a b =
    if a < b then
        b

    else
        a


pub sameNum : number, number -> Bool
sameNum x y =
    number.eq x y && x == y
