-- check/good: CK-122 across modules. `Models` exports aliases of its schemas'
-- endpoints; reading one here expands its body in `Models`, whose schema
-- endpoints come from `Models`' interface (a private tagged schema's from its
-- nominal type). Before the fix every comparison below was an `internal`
-- under both checkers, and `Models.H` a false NOT EQUATABLE.
import Models


type alias Local =
    Models.R.Type


type L =
    L Local


same : Models.RW, Models.RW -> Bool
same p q =
    p == q


less : Models.RE, Models.RE -> Bool
less p q =
    p < q


records : Models.RecW, Models.RecW -> Bool
records p q =
    p == q


sorted : Models.RL -> Models.RL
sorted xs =
    List.sort xs


fields : Models.Both, Models.Both -> Bool
fields p q =
    p == q


pages : Models.PageW Int, Models.PageW Int -> Bool
pages p q =
    p == q


wrapped : Models.H, Models.H -> Bool
wrapped p q =
    p == q


local : L, L -> Bool
local p q =
    p < q


private : Models.PrivW, Models.PrivW -> Bool
private p q =
    p == q


usePrivate : Int -> Bool
usePrivate n =
    private (Models.mkPriv n) (Models.mkPriv 2)


field : Models.RecW -> Int
field r =
    r.x


pub back : Local -> Models.RW
back r =
    r
