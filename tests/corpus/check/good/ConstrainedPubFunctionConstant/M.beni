-- check/good (static-dispatch-spike.md §10.10 as amended; rule 7): an
-- UNANNOTATED `pub` value of no parameters whose inferred scheme keeps a
-- constraint is refused as `constrained_constant` only when its type is not
-- a function. `equals = (==)`, `eqs = \a b -> …` and `bigger = maxOf` are
-- functions, defined and called as such by `Convention` (checker-v2.md
-- §12.5), so they are accepted, with the informational warning every
-- unannotated constrained `pub` gets. `build_test.zig`'s "an unannotated
-- pub function constant with a constraint builds and runs" runs this program
-- (`f`, `t`, `t`, `2`, `9`, `b`, `2`); a `run/` fixture must be warning-free.
--
-- None of the three is CONSTRAINED CONSTANT.
maxOf : a, a -> a
    where a.compare : a, a -> Order
maxOf a b =
    if a < b then
        b
    else
        a


pub equals = (==)


pub eqs = λa b -> a == b


pub bigger = maxOf
