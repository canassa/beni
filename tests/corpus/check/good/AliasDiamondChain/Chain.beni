-- See Main.beni. Three diamonds of aliases, each 64 deep: `A{i} a` is
-- `A{i-1} (A{i-1} a)`, so `A64 Int` names 2^64 applications and is `Int`;
-- `K64 a` is the same diamond over an alias that drops its argument, and is
-- `String`; `P64 a b` hands `a` to the record at the bottom and `b` to the
-- next level only, and is `{ value : a }`. `Unused` is #1475's form: a
-- private constructor nothing calls.
type alias A0 a =
    a


type alias A1 a =
    A0 (A0 a)


type alias A2 a =
    A1 (A1 a)


type alias A3 a =
    A2 (A2 a)


