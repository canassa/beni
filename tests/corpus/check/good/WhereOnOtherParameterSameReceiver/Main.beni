-- check/good: a `where` clause may constrain a quantifier of ANOTHER
-- parameter, so a method's requirement can ask the same method of the
-- receiver itself, or of a type that holds it, with finite evidence:
-- `bx.describe bx` is `describe_Box(describe_Box(describe_K))`, which builds
-- and runs (`box of box of 1`). A repeated receiver is not a cycle
-- (checker-v2.md §9.5): a lineage rule that called it one would report a
-- false `infinite_type` on `viaParam` and `wrapped2`, and not on `wrapped`,
-- which differs only in let-binding the argument.
import Box exposing (Box)


pub viaParam : Box Int → String
viaParam bx = bx.describe bx


pub wrapped : Box Int → String
wrapped bx = bx.describe (Box.Box bx)


pub wrapped2 : Box Int → String
wrapped2 bx =
    w = Box.Box bx
    bx.describe w
