-- check/good (core): `sync` in an ordinary declaration's signature
-- (transparent-effects-proposal.md §15.2 item 1, amended 2026-10-02). The
-- mark is published whatever the body does: `program` never calls `view`,
-- and `hosted` calls `update` only through a `let` function, yet both
-- print `!sync` in the interface; `sandbox`, which hands its parameters on,
-- says it with nothing written. A pure or `impure` function at a marked
-- parameter is accepted (`page`).
pub foreign impure log : String -> ()


pub program : { init : Int, view : sync (Int -> String) } -> Int
program p =
    p.init


pub hosted : sync (Int, Int -> Int), Int -> Int
hosted update model =
    let
        step m =
            update m 1
    in
    step model


pub sandbox : Int, (Int -> String) -> Int
sandbox init view =
    program { init = init, view = view }


pub page : Int
page =
    sandbox
        0
        (\n ->
            let
                () = log "view"
            in
            String.fromInt n
        )
