-- check/good: a record that doubles at each level (#1238). With an
-- annotation, each value's type prints as its alias's name, and the type is
-- a DAG of one alias per level. With none, `1` is a `number`, `v0` is
-- generalised, and each use of a let-bound value takes fresh variables: the
-- principal type of `v3` has 2^3 distinct ones, as in Elm, so its size
-- doubles with each level.
pub type alias W0 =
    items : List Int


pub type alias W1 =
    a : W0
    b : W0


pub type alias W2 =
    a : W1
    b : W1


pub type alias W3 =
    a : W2
    b : W2


pub w0 : W0
w0 = { items = [ 1 ] }


pub w1 : W1
w1 = { a = w0, b = w0 }


pub w2 : W2
w2 = { a = w1, b = w1 }


pub w3 : W3
w3 = { a = w2, b = w2 }


pub v0 = { items = [ 1 ] }


pub v1 = { a = v0, b = v0 }


pub v2 = { a = v1, b = v1 }


pub v3 = { a = v2, b = v2 }
