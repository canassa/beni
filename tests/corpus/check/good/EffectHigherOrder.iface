module EffectHigherOrder
  value apply : (a -> b !e1), a -> b !e1
  value compose : (a -> b !e1), (c -> a !e2), c -> b !(e1 | e2)
  value hand : a -> a2 -> a2 !impure
  value loud : List a -> List a !impure
  value shared : a -> ( a, String ) !impure
  value sizes : List String -> List Int
  value withLog : (a -> b !e1), a -> b !(impure | e1)
