-- A component module (language.md §11.8): `view` is what `<Card>` calls,
-- `header` what `<Card.header>` calls, and `defaults` the record a spread
-- starts from. Each is an ordinary function of one record, published with
-- its scheme like any other.
import Html exposing (Html)


type alias Props msg =
    title : String
    open : Bool
    children : Html msg


pub defaults : Props msg
defaults = { title = "Untitled", open = False, children = <></> }


pub view : Props msg -> Html msg
view props =
    <section class={[ ( "card", True ), ( "open", props.open ) ]}>
        <h2>{props.title}</h2>
        {props.children}
    </section>


pub header : { title : String } -> Html msg
header props = <header>{props.title}</header>


pub counter : { count : Int } -> Html Int
counter props = <button onClick={props.count + 1}>{props.count}</button>
