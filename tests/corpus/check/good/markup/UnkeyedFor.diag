[{"code":"unkeyed_for","severity":"warning","span":{"file":"tests/corpus/check/good/markup/UnkeyedFor.beni","start":{"line":18,"col":10},"end":{"line":18,"col":13}},"title":"UNKEYED FOR","message":"This `<For>` says nothing about how its rows are keyed, and its items are:\n\n    { id : Int, label : String }\n\nso each row is kept by the item's identity. An item that is edited is a new\nvalue, so its row is rebuilt, and focus and input inside it are lost.\n\nHint: key the rows, `keyed={.id}`, or say that identity is meant,\n`keyed={True}`."}]
