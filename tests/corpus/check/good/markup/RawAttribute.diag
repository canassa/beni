[{"code":"raw_markup_attribute","severity":"warning","span":{"file":"tests/corpus/check/good/markup/RawAttribute.beni","start":{"line":9,"col":21},"end":{"line":9,"col":30}},"title":"RAW MARKUP ATTRIBUTE","message":"`innerHTML` writes its value into the page as markup, unescaped.\n\nWhatever the value holds becomes part of the page, script included, so only\nmarkup this program built itself is safe to give it."}]
