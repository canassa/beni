-- (the merge variant without the recursive-group refusal; `Sooner` is its
-- twin) `h`'s body calls `(K 0).f ()` and `f` is a method, so `f` and `h`
-- are recursive THROUGH DISPATCH and merge. `g`, called at `Box Int`
-- and at `Box String` in `f`'s scrutinee, is in no cycle and must NOT be
-- merged, so both `g` calls check and `g` stays generic. `Later` writes the
-- methods after `f`; `Sooner` writes them first. Both check, and publish
-- the same schemes. With a `let q` helper added the program is the
-- recursive-group refusal, `check/bad/ScrutineeMethodMergeD14/`.
--
-- The interface golden is written by reasoning, since no build shows it:
-- inside the merged group `f` and `h` are monomorphic, so each takes `()`
-- for `u` from the other's call; `f` returns the pair `( 1, 2 )`, two
-- independent `number`s; `g : Box a, b -> number` stays generic.
--
--
-- Never METHOD NEEDS AN ANNOTATION: not at `y.h`, at the `g`
-- calls, or at `(K 0).f`, in `h`, above
-- `f`.
type K
    = K Int


type Box a
    = Box a


pub f (K n) u =
    case ( (λy -> y.h ()) (K n), (Box 1).g (), (Box "s").g () ) of
        ( _, _, _ ) ->
            ( 1, 2 )


pub g (Box a) u = 0


pub h (K m) u =
    _ = λw -> (K 0).f ()
    Box m


pub combine (Box a) z = a
