module SchemaViaMutualOwnType
  schema Loop
    type Type : Loop.Type
    type Encoded : Loop.Encoded
    value schema : () -> Schema Loop.Encoded Loop.Type
    value parse : String -> Result (List Issue) Loop.Type
    value print : Loop.Type -> Result (List Issue) String
    value parseWith : Options, String -> Result (List Issue) Loop.Type
    value printWith : Options, Loop.Type -> Result (List Issue) String
    ctor type.Step/1 : { payload : Mine } -> Loop.Type
    ctor type.Next/1 : { rest : Loop.Type } -> Loop.Type
    ctor encoded.Step/1 : { payload : Int } -> Loop.Encoded
    ctor encoded.Next/1 : { rest : Loop.Encoded } -> Loop.Encoded
  schema Rec
    type Type : { f : Mine }
    type Encoded : { f : Int }
    value schema : () -> Schema Rec.Encoded Rec.Type
    value parse : String -> Result (List Issue) Rec.Type
    value print : Rec.Type -> Result (List Issue) String
    value parseWith : Options, String -> Result (List Issue) Rec.Type
    value printWith : Options, Rec.Type -> Result (List Issue) String
