[{"code":"suspicious_argument_order","severity":"warning","span":{"file":"tests/corpus/check/good/SuspiciousArgumentOrder.beni","start":{"line":9,"col":15},"end":{"line":9,"col":27}},"title":"SUSPICIOUS ARGUMENT ORDER","message":"This call's first argument is a literal and its last is not:\n\n    String.split \",\" line\n\nThat is the shape of a call in Elm's order, which puts the subject last. beni's\n`String.split` takes the subject first, so if you meant Elm's call, write:\n\n    String.split line \",\"\n\nIf the literal really is the subject, give it a name or write the call as a\nmethod, `\",\".split line`, and this warning goes.\n"},{"code":"suspicious_argument_order","severity":"warning","span":{"file":"tests/corpus/check/good/SuspiciousArgumentOrder.beni","start":{"line":13,"col":11},"end":{"line":13,"col":28}},"title":"SUSPICIOUS ARGUMENT ORDER","message":"This call's first argument is a literal and its last is not:\n\n    String.startsWith \"http\" s\n\nThat is the shape of a call in Elm's order, which puts the subject last. beni's\n`String.startsWith` takes the subject first, so if you meant Elm's call, write:\n\n    String.startsWith s \"http\"\n\nIf the literal really is the subject, give it a name or write the call as a\nmethod, `\"http\".startsWith s`, and this warning goes.\n"},{"code":"suspicious_argument_order","severity":"warning","span":{"file":"tests/corpus/check/good/SuspiciousArgumentOrder.beni","start":{"line":17,"col":12},"end":{"line":17,"col":26}},"title":"SUSPICIOUS ARGUMENT ORDER","message":"This call's first argument is a literal and its last is not:\n\n    String.replace \" \" \"-\" s\n\nThat is the shape of a call in Elm's order, which puts the subject last. beni's\n`String.replace` takes the subject first, so if you meant Elm's call, write:\n\n    String.replace s \" \" \"-\"\n\nIf the literal really is the subject, give it a name or write the call as a\nmethod, `\" \".replace \"-\" s`, and this warning goes.\n"},{"code":"suspicious_argument_order","severity":"warning","span":{"file":"tests/corpus/check/good/SuspiciousArgumentOrder.beni","start":{"line":21,"col":13},"end":{"line":21,"col":18}},"title":"SUSPICIOUS ARGUMENT ORDER","message":"This call's first argument is a literal and its last is not:\n\n    clamp 0 100 n\n\nThat is the shape of a call in Elm's order, which puts the subject last. beni's\n`clamp` takes the subject first, so if you meant Elm's call, write:\n\n    clamp n 0 100\n\nIf the literal really is the subject, give it a name, and this warning goes.\n"}]
