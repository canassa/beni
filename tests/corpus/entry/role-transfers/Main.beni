import Start
import Worker


first : Int, Int → Int
first _ value = value


second : Int, Int → Int
second _ value = value + 1


callbacks init =
    { init = init
    , start = first
    , handle = λ_ _ value → value
    , stream = λ_ _ _ value → value
    }


make init = Worker.make (callbacks init)


foo = make (relay first)


bar = make (relay second)


alias1 = foo


alias2 = alias1


choose flag = if flag then alias2 else bar


begin context value =
    Worker.open (choose True) ⊤
    value


main : Start.Program
main = Start.make (callbacks begin)


wrap f =
    captured = { payload = f }
    λ_ value →
        _ = captured
        value


relay f = wrap f
