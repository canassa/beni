-- fmt: until the enforce step the formatter prints each token in the spelling
-- it read (language.md §12.9), so a file may mix `->` and `→`, `( a, b )` and
-- `a × b`, and `beni fmt` moves it from neither; it spaces every symbol as
-- it spaced the ASCII, `…` against its operand. A product stays on one line
-- when it fits and was written on one; one the author broke, or one past
-- 100 columns, breaks before each `×`, indented 4, the `×` leading.
mixed : ( Int,String ) -> Int×String→Bool
mixed p q = p/=p||q≠q


spreads x xs = case [x,…xs] of
    [a,...rest] -> a
    _→0


broken : Int
    × String
    × Bool
broken = ( 1, "a", True )


long : SomeRatherLongTypeName × AnotherRatherLongTypeName × YetAnotherRatherLongTypeName × Int × String × Bool × Float
long = long


piped xs = xs ▷ List.reverse |> List.length
