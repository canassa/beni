-- Formatter: preserve schema docs, field/variant order and string contents;
-- print continuation commas and bars with four spaces and one space between
-- modifiers (schema.md §2).
--| user docs
pub schema User={--| id docs
 userId:Models.Id   via   Conversions.userId as "user-id",--| nickname docs
 nickname:String optional nullable,-- keep alias order
 aliases:List(Maybe String)}-- after User
schema Page item={items:List item}
pub schema Message tagged "Kind-\${stays literal}" of Text{value:String}as "text"|Count{value:Int}as "count"|Empty
