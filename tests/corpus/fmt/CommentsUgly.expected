-- Formatter: comments in every position at odd indentation — before/after
-- imports, between constructors, inside lists, after `=`, before a block's
-- value, before `else`, between branches, trailing everywhere; expected:
-- every comment kept, in order, own-line comments re-indented to their
-- block, trailing comments kept at the end of their line.
-- indented comment before imports
-- comment after imports
import Dict
import Set


--| doc for T
type T
    = A -- after A
    -- between ctors
    | B


f x = -- after equals
    -- before binding
    y = 1 -- after body
    -- before the value
    -- before the value expression
    if x then -- after then
        y
        -- before else
    else
        -- in else
        case x of
            -- before branch
            True →
                1 -- after branch
            -- between branches
            False →
                [ 1 -- in list
                , 2
                -- before close
                ]
