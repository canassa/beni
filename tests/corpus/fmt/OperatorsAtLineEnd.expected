-- Formatter: pipelines and sums with the operator at the END of the line;
-- expected: break before the operator, one per line, operands indented 4.
process xs =
    xs
        |> List.map (\x -> x * 2)
        |> List.filter (\x -> x > 10)
        |> List.sum


longSum a b c d =
    a
        + b
        + c
        + d
