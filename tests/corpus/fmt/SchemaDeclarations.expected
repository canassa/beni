-- Formatter: preserve schema docs, field/variant order and string contents;
-- print continuation commas and bars with four spaces and one space between
-- modifiers (schema.md §2).
--| user docs
pub schema User =
    --| id docs
    userId : Models.Id via Conversions.userId as "user-id"
    -- nickname field
    --| nickname docs
    --| second nickname doc
    nickname : String optional nullable
    -- keep alias order
    aliases : List (Maybe String) -- after User


schema Page item =
    items : List item


pub schema Message tagged "Kind-\${stays literal}" of
    Text as "text"
        value : String
    Count as "count"
        value : Int
    Empty
