-- Formatter: astral characters. A column counts code points (language.md
-- §12.7 *columns*, §12.9 *width*), so `fits` measures a literal in code
-- points, not in bytes or display cells: the fourteen-emoji line below is
-- 121 bytes and 79 code points, and fits; the twenty-emoji one is 110 code
-- points, and goes vertical. A comment and a string may hold any UTF-8,
-- including combining marks and a ZWJ sequence — 😀 👨‍👩‍👧 café — and a
-- string literal longer than the limit is printed on one line, never broken.
emoji = "😀 👨‍👩‍👧 café"
narrow = [ "😀", "😁", "😂", "😃", "😄", "😅" ]
wide = [ "😀", "😁", "😂", "😃", "😄", "😅", "😆", "😇", "😈", "😉", "😊", "😋", "😌", "😍" ]
wider = [ "😀", "😁", "😂", "😃", "😄", "😅", "😆", "😇", "😈", "😉", "😊", "😋", "😌", "😍", "😎", "😏", "😐", "😑", "😒", "😓" ]
long = "a string literal far longer than the hundred column limit, which the formatter must print on one line"
