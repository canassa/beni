-- fmt: a lambda written without parentheses as the last argument (language.md
-- §12.3, §12.5). Its body stays on the `->` line when it fits there and goes
-- below as a block otherwise, the callee and the other arguments hanging it
-- on one line whatever breaks the source had, which joins the `=` line when
-- that fits. One that is the first operand of a broken chain, where the next
-- operator would continue its body, is printed in parentheses.
short xs = List.map xs λx ->
    x + 1


long xs = List.map xs λx -> someVeryLongFunctionName x anotherArgument yetAnotherArgument andOneMoreOfThem


head xs =
    List.foldl
        xs
        0
        λx acc -> x + acc


first xs =
    List.map xs λt -> t
    |> List.length
