-- Brace declaration bodies become layout. Inline record types, extensible
-- record types and record values keep their braces.
type alias Point={--| horizontal coordinate
    x:Float,--| vertical coordinate
    y:Float}
schema User={--| public name
    name:String,fallback:{code:Int}optional}
schema Event tagged "kind" of Text{value:String}as "text"|Empty{}as "empty"|Payloadless
type Wrapped = Wrapped { item : Int }
inline : { a : Int } -> { r | x : Int } -> Int
inline value = value.a
point = { x = 1, y = 2 }
pick value =
    x = value
    case x of
        Wrapped row ->
            row.item
