-- Formatter: when a function type breaks, its first parameter is indented 6
-- rather than 4, so that every parameter starts in the column after the
-- leading `, ` of the others (language.md §12.5, §9 function types). The
-- rule holds for a top-level annotation, a `let` annotation, a record type
-- field and a function type with one parameter; a type that fits on one line
-- and was written so is unchanged.
update : Msg,
    Model -> Model
update msg model = model


configure : { host : String, port : Int, retries : Int, timeout : Int }, List String -> Result String Config
configure config args = Err "todo"


single : { host : String, port : Int, retries : Int, timeout : Int, verbose : Bool, depth : Int } -> String
single config = config.host


short : Int, Int -> Int
short a b = a + b


type alias Handlers =
    onEvent : { name : String, payload : String, timestamp : Int }, { previous : Model, next : Model } -> Model


local x =
    let
        go : Int,
            Int -> Int
        go a b = a + b
    in
    go x x
