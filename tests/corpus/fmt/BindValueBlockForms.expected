-- §9: a block and `case` have no single-line form, nor has an `if` written
-- across lines (§12.5), so a `<-` binding whose value contains one must not
-- be printed as though it fit: the block breaks anyway and every enclosing
-- decision — keyword alignment, body indentation — has to be made on the
-- real widths.
withIf a =
    x <- Result.andThen
        (if a then
            someLongFunctionName a
         else
            otherLongFunctionName a
        )
        extra
    x


withBlock a =
    x <- Result.andThen
        (
            y = someLongFunctionName a
            y
        )
        extra
    x


withCase a =
    x <- Result.andThen
        (case a of
            Ok v ->
                v
            Err e ->
                e
        )
        extra
    x


-- No block keyword: the author's line breaks still collapse.
noBlock a =
    x <- Result.andThen (readTheHeader a) extra
    x
