-- Already canonical (§9): lambdas with `\x -> body` spacing, a lambda whose
-- body is a block, an application that fits on one line, one that does not
-- with its head on one line and its last argument, a list, hanging below it
-- indented 4 (§12.5), and nested parenthesised arguments.
inc = λn → n + 1


swap = λ( a, b ) → ( b, a )


describe =
    λx →
        case x of
            0 →
                "zero"

            _ →
                "other"


short f x = f x 1


long =
    List.foldl (λitem acc → acc + String.length item * 2) 0
        [ "some", "long", "list", "of", "strings", "here", "and", "more", "and", "more" ]


nested f g x = f (g (x + 1)) (g x)
