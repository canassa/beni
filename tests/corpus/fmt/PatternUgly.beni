-- Formatter: patterns without spaces — tuple, cons, list, record, `as`,
-- constructor with parenthesised argument — in `case`, a block and lambda
-- parameters; expected: canonical spacing, structure unchanged.
f v = case v of
  [ (a,b), ...rest ] -> a
  [x,y] -> x
  [ ({c} as r), ..._ ] -> c
  [ Just(Just(z)) ] -> z
  _ -> 0
g p =
    (a,b)=p
    a
h = λ(a,b)->a
