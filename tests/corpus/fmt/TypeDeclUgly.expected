-- Formatter: a long record alias on one line, an alias with odd indentation,
-- constructors with argument lists spread over lines, a record type nested
-- in a constructor; expected: canonical vertical record type and `= A` /
-- `| B` layout.
type alias Config =
    host : String
    port : Int
    user : String
    password : String
    timeout : Int
    verbose : Bool


type alias Pair a b =
    a × b


type Event
    = Click Int
        Int
    | Key
        String
    | Resize
        { width : Int
        , height : Int
        }
