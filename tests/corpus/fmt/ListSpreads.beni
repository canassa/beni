-- A spread is one item of its list (language.md §6.8, §9): `...` directly
-- against its operand, elm-format's inner spaces around the items, one line
-- when the author wrote one and it fits, and the vertical form with the
-- comma leading each line when the author broke it — in expressions and in
-- patterns alike.
cons x xs = [x,…xs]


snoc xs x =
    [ …  xs , x ]


rows header body footer = [ header
    , …body
  , footer ]


ends xs =
    case xs of
        [first,…middle,last] → middle
        [x,…_] → [x]
        […rest] → rest
