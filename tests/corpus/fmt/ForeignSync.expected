-- Formatter: the `sync` mark (transparent-effects-proposal.md §15.2) with
-- odd spacing and a signature the author broke over lines; expected: `sync`
-- and one space before its parentheses, the broken signature one parameter
-- per line, and a record parameter laid out as it would be unmarked.
pub foreign pure onInput :
      sync (String -> msg)
    -> Attribute msg


pub foreign pure program :
      { init : model, update : sync (msg, model -> model), view : sync (model -> Html msg) }
    -> Program
