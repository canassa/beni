-- Formatting `_` and `<-` (§9): `_` is an ordinary argument and takes
-- ordinary application spacing; a `<-` binding prints on one line with
-- single spaces around the operator, is never broken, and is never aligned
-- with its neighbours, `=` bindings included.
partial xs = List.map xs (add 1 _)


pipeline r =
    scope ← Task.scope
    conn ← Task.bracket (λ() → Db.open r.url) Db.close
    count = 1
    h ← Result.andThen (readHeader r)
    render scope conn count h
