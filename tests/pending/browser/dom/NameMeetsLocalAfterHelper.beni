-- CK-232: a compiler-made name of the `dom` lowering is not a local's.
-- From the review of PR #129 (emit-cache), finding 1, the form per-declaration
-- numbers add: `helper` makes one compiler name before `view`, so on
-- master `view`'s numbers start at 2 and miss the user's `x$4`, and with
-- one count per top-level declaration they start at 1 again and meet it.
-- The page throws a ReferenceError when it renders. See
-- `NameMeetsLocal.beni` for the form master has too; the owner decides
-- the fix (dashboard question `emit-cache-q4`).
import Browser
import Html exposing (Html)


helper : Int × Int → Int
helper ( a, b ) = a + b


view : Int, Int, Maybe Int → Html msg
view a1 a2 m =
    <p>
        {case m of
            x →
                String.fromInt (Maybe.withDefault x 0)
        }
    </p>


update : ⊤, Int → Int
update msg model = model


main : Browser.Program
main =
    Browser.program
        { init = λ⊤ → helper ( 3, 4 )
        , update = update
        , view = λmodel → view 0 0 (Just model)
        }
