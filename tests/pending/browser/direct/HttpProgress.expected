-- load
<body>
  <main>
    <button id="sized">"sized"</button>
    <button id="unsized">"unsized"</button>
    <button id="short">"short"</button>
    <button id="head">"head"</button>
    <ol></ol>
  </main>
</body>
-- click #sized
(fetch 1: POST /sized {"content-type":"text/plain"} "héllo")
<body>
  <main>
    <button id="sized">"sized"</button>
    <button id="unsized">"unsized"</button>
    <button id="short">"short"</button>
    <button id="head">"head"</button>
    <ol>
      <li>"Sending 0/6 = 0.0"</li>
    </ol>
  </main>
</body>
-- respond 1 200 chunks "one " "two " "three" Content-Length: "13"
<body>
