-- CK-224: the subscription driver's unchanged want step is rejected
-- by direct-platform ownership checking. The old entry's taps are read
-- once and replaced under the same key; no retained dictionary is used.
-- The browser-tea twin produces the golden with persistent lists.
import Dict exposing (Dict)
import Html exposing (Html)
import Tea


want : Int, Int, Dict Int (Int × List Int) → Dict Int (Int × List Int)
want k t d =
    ( first, taps ) = Maybe.withDefault (Dict.get d k) ( 0, [] )
    Dict.insert d k ( first, List.append taps [ t ] )


main : Tea.Program
main =
    Tea.sandbox
        { init = λ⊤ → want 1 2 (Dict.insert Dict.empty 1 ( 0, [ 1 ] ))
        , update = λ_ model → model
        , view = view
        }


view : Dict Int (Int × List Int) → Html {}
view model =
    ( _, taps ) = Maybe.withDefault (Dict.get model 1) ( 0, [] )
    <p>{List.length taps}</p>
