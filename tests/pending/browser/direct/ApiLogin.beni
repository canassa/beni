-- CK-223: direct effects reject a safe browser-tea program with a coarse ownership summary.
-- The milestone's acceptance page (plans/http-and-routing.md, *Order*),
-- its sign-in half: a program that talks to an API through schemas
-- (boundary.md §9.8.12). The button posts the credentials as JSON
-- (`jsonBody`) and reads a bearer token back (`expectJson`, the key
-- renamed); the token is sent back as a bearer `Authorization` header.
-- Pressed again, the answer is a 401, which is `BadStatus`, shown and
-- not a crash. Reading a JSON list is `ApiItems` and routing `Routes`.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Http
import Schema
import Sub
import Tea


schema Credentials =
    user : String
    password : String


schema Session =
    token : String as "access_token"


type Msg
    = SignIn
    | GotToken (Result Http.Error String)
    | GotName (Result Http.Error String)


type alias Model =
    log : List String


-- With the token, the one request that needs headers of its own, so it is
-- a `request` and not a `get`.
whoAmI : String → Cmd Msg
whoAmI token =
    Cmd.task
        (λ⊤ →
            Http.request
                { method = "GET"
                , headers = [ Http.header "Authorization" "Bearer ${token}" ]
                , url = "/api/me"
                , body = Http.emptyBody
                , expect = Http.expectString
                , timeout = Nothing
                , tracker = Nothing
                }
        )
        GotName


failure : Http.Error → String
failure problem =
    case problem of
        Http.BadStatus code →
            "BadStatus ${String.fromInt code}"

        Http.BadBody _ →
            "BadBody"

        _ →
            "another error"


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        SignIn →
            ( model
            , Cmd.task
                (λ⊤ →
                    Result.map
                        (Http.post
                            { url = "/api/login"
                            , body =
                                Http.jsonBody (Credentials.schema ⊤)
                                    { user = "ada", password = "lovelace" }
                            , expect = Http.expectJson (Session.schema ⊤)
                            }
                        )
                        .token
                )
                GotToken
            )

        GotToken (Ok token) →
            ( { model | log = model.log ++ [ "token ${token}" ] }, whoAmI token )

        GotToken (Err problem) →
            ( { model | log = model.log ++ [ "sign in: " ++ failure problem ] }, Cmd.none )

        GotName (Ok name) →
            ( { model | log = model.log ++ [ "hello ${name}" ] }, Cmd.none )

        GotName (Err problem) →
            ( { model | log = model.log ++ [ "me: " ++ failure problem ] }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <button id="signin" onClick={SignIn}>sign in</button>
        <ol><For each={model.log} keyed={False}>{λline → <li>{line}</li>}</For></ol>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { log = [] }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
