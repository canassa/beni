-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="dashboard">
      <section data-key="w1" data-role="widget">
        <h2>"Depot notebook 6vm4"</h2>
        <button data-role="growBeds">"5 more"</button>
        <div>
          <button data-role="setBedsTo8">"Set to 8"</button>
          <button data-role="cutBeds">"Remove 5"</button>
        </div>
        <div>
          <span>"13 beds"</span>
          <small>"Desk 6vm4"</small>
        </div>
        <button data-role="switchMuted">"Switch muted"</button>
        ""
        <button data-role="restoreCoins">"Restore"</button>
        <button data-role="setCoinsToMinus5">"Set to -5"</button>
        <button data-role="commitMutedAndBeds">"Apply"</button>
        <span>"changed"</span>
        <fieldset>
          <p>"Use the blue form for refunds."</p>
          <select data-role="pickPhase" .value="Standard">
            <option value="Basic">"Basic"</option>
            <option value="Standard">"Standard"</option>
            <option value="Premium">"Premium"</option>
            <option value="Custom">"Custom"</option>
          </select>
          ""
        </fieldset>
      </section>
    </div>
  </div>
</body>
