-- CK-254: unique-components n1-s2 runs on browser-inline.
-- `emit/release/inline/ResearchS2`'s page: the number input refuses a
-- value out of range and keeps showing it, the host's pushes for this
-- widget and for another, a tick, a snapshot and a state that does not
-- decode (docs/design/browser-inline.md §8).
--! The dashboard: 1 widget, each written by its own module (`Widget.W*`), in The Elm
--! Architecture: one model holding every widget's state, one update that hands each
--! widget its own messages, and one view.

import Browser
import Cmd exposing (Cmd)
import Html exposing (Html)
import Push
import Schema exposing (Value)
import Sub exposing (Sub)
import Tea
import W1


main : Tea.Program
main =
    Browser.mountAt
        (Tea.element { init = init, update = update, view = view, subscriptions = subscriptions })
        "root"


-- ---- Model ---------------------------------------------------------------------

type alias Model =
    w1 : W1.Model


init : ⊤ → Model × Cmd Msg
init ⊤ =
    ( { w1 = W1.init ⊤ }
    , Cmd.none
    )


-- ---- Update --------------------------------------------------------------------

type Msg
    = W1Msg W1.Msg
    | Pushed Value


update : Msg, Model → Model × Cmd Msg
update msg model = ( step msg model, Cmd.none )


step : Msg, Model → Model
step msg model =
    case msg of
        W1Msg widgetMsg →
            { model | w1 = W1.update widgetMsg model.w1 }

        Pushed value →
            pushed value model


-- ---- External events -----------------------------------------------------------

subscriptions : Model → Sub Msg
subscriptions _ = Push.onPush Pushed


--| What the host pushes: a widget's new state, a tick of the clocks, an item
--| for a feed, or a new state for every widget at once.
schema Event tagged "type" of
    ServerSet as "serverSet"
        widget : String
        state : Value
    Tick as "tick"
    Notify as "notify"
        widget : String
        item : Value
    Snapshot as "snapshot"
        state : Snapshot


schema Snapshot =
    widgets : Widgets


schema Widgets =
    w1 : Value as "w1"


pushed : Value, Model → Model
pushed value model =
    case Schema.read (Event.schema ⊤) value of
        Ok (Event.ServerSet event) →
            replaced event.widget event.state model

        Ok Event.Tick →
            model

        Ok (Event.Notify event) →
            model

        Ok (Event.Snapshot event) →
            widgets = event.state.widgets
            { w1 = W1.replace widgets.w1 model.w1
            }

        Err _ →
            model


replaced : String, Value, Model → Model
replaced widget state model =
    case widget of
        "w1" →
            { model | w1 = W1.replace state model.w1 }

        _ →
            model


-- ---- View ----------------------------------------------------------------------

view : Model → Html Msg
view model =
    <div data-role="dashboard">
        {Html.map (W1.view model.w1) W1Msg}
    </div>
