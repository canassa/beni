-- element "root"
-- load
<body>
  <div id="root">
    <div data-role="dashboard">
      <section data-key="w1" data-role="widget">
        <h2>"Personal log 442o"</h2>
        <footer>
          <output>"18"</output>
          <button data-role="addBeds">"Up 3"</button>
        </footer>
        <strong>"Pages = -3"</strong>
        <input type="number" data-role="setPages" .value="-3">
        <button data-role="resetPages">"Restore"</button>
        <header>
          <small>"Tag 442o"</small>
          <small>"Many"</small>
        </header>
      </section>
    </div>
  </div>
</body>
