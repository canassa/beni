-- CK-161: an unannotated function may dot-call a derived `compare`.
-- `Colour` has no `pub compare`, so `compare` is derived — `Red < Blue`
-- works, and `before` works with `where a.compare : a, a -> Order` added.
-- At 8b98464, unannotated, the call `before Red Blue` is "`Colour` has no
-- method called `compare`" (checker-v2.md's "kind decides derivation": a
-- dot-call never derives). That is a refusal with no guarantee behind it
-- (rule 7: the annotated twin is accepted and runs), and its text is false.
-- Expected, taking rule 7's side: it builds and prints `T`. Oracle twin:
-- the annotated `before` prints `T`.
import Node exposing (Program)


type Colour
    = Red
    | Blue


before x y =
    x.compare y == LT


main : Program
main =
    Node.printLines [ if before Red Blue then "T" else "F" ]
