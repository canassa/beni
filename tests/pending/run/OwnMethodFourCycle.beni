-- CK-65: four own methods mutually recursive THROUGH DISPATCH (`ma` → `mb` →
-- `mc` → `md` → `ma`), none annotated, merged into one group whatever the
-- declaration order (D11, checker-v2.md §10.4; §23 item 1 asks for at least
-- four). `(K 5).ma ()` is `1112` and `(K 7).mc ()` is `2212`.
--
-- Oracle twin, run on 8016030 under v1: this file with the four methods
-- annotated `K, () -> Int` prints exactly the expected lines. As written, v1
-- refuses it with METHOD NEEDS AN ANNOTATION.
import Node exposing (Program)


type K
    = K Int


pub ma (K n) u =
    if n <= 0 then
        0

    else
        (K (n - 1)).mb () + 1


pub mb (K n) u =
    if n <= 0 then
        0

    else
        (K (n - 1)).mc () + 10


pub mc (K n) u =
    if n <= 0 then
        0

    else
        (K (n - 1)).md () + 100


pub md (K n) u =
    if n <= 0 then
        0

    else
        (K (n - 1)).ma () + 1000


main : Program
main =
    Node.printLines [ String.fromInt ((K 5).ma ()), String.fromInt ((K 7).mc ()) ]
