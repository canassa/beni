-- CK-255: a writer's handlers call another module's reader statically.
-- `W2.view` reads `W1.Model` (docs/design/browser-inline.md §8, D-c): each
-- key of `W1` whose writes conflict with what `W2`'s binding reads calls
-- that binding piece from its handler, once, after `W1`'s own: no
-- registration at mount, and no key of `W2` calls it.
import Browser
import Html exposing (Html)
import Tea
import W1
import W2


type alias Model =
    w1 : W1.Model
    w2 : W2.Model


type Msg
    = W1Msg W1.Msg
    | W2Msg W2.Msg


update : Msg, Model → Model
update msg model =
    case msg of
        W1Msg sub →
            { model | w1 = W1.update sub model.w1 }

        W2Msg sub →
            { model | w2 = W2.update sub model.w2 }


view : Model → Html Msg
view model =
    <div data-role="app">
        {Html.map (W1.view model.w1) W1Msg}
        {Html.map (W2.view model.w2 model.w1) W2Msg}
    </div>


main : Tea.Program
main =
    Browser.mountAt
        (Tea.sandbox
            { init = λ⊤ → { w1 = W1.init ⊤, w2 = W2.init ⊤ }
            , update = update
            , view = view
            }
        )
        "root"
