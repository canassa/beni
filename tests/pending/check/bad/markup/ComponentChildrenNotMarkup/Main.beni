-- CK-218: markup written between a component's tags is its `children`,
-- and a component whose `children` is not markup is told so, naming the
-- prop and its type (language.md §11.8): `Label.view` takes a `String`, so
-- `<Label><b>x</b></Label>` is a type_mismatch at the tag (14:10). On the
-- base it said the markup "does not produce the same messages as the
-- markup around it", which is not the mistake.
import Html exposing (Html)
import Ui.Label as Label


pub view : Html msg
view =
    <div>
        <Label>
            <b>x</b>
        </Label>
    </div>
