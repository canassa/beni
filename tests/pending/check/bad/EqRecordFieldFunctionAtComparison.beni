-- CK-16: a record compared with `Basics.eq` whose field is later used as a
-- function is `not_equatable` AT THE COMPARISON (checker-v2.md §11.4 *As
-- built by R5*; R5's adversarial review, F7): the question is asked where
-- `r` meets the comparison's argument, not where `r` later becomes a record
-- (`r.x`). On checker v1 at 2bc9e22 the program checks clean: the flag on
-- `r` is dropped once `r` becomes a record whose field is still a variable.
g r =
    let
        b =
            Basics.eq r r

        n =
            r.x + 1

        fn =
            r.f
    in
    ( b, fn n )


use =
    g { x = 1, f = \n -> n + 1 }
