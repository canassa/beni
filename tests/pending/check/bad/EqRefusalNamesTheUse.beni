-- CK-214: a refused comparison names what the program wrote. `F` holds a
-- function, so it has no `eq`. `viaWhere` passes one to `h`, whose `where`
-- clause requires `.eq`, and `viaBasics` and `viaBasicsNeq` call `Basics.eq`
-- and `Basics.neq` by name: each NOT EQUATABLE names that requirement or
-- that function, never `==`, which none of them wrote. Unfixed, all three
-- said "I cannot compare these values with `==`". `both` and `bothSwapped`
-- use `x.eq x` and `x == x` in one body: the requirement they promote is the
-- first use in source order, so `viaBoth` names `.eq` and `viaBothSwapped`
-- names `==`, whatever else the body holds.
type F
    = F (Int -> Int)


h : a -> Bool where a.eq : a, a -> Bool
h x =
    x.eq x


viaWhere : Bool
viaWhere =
    h (F (\y -> y))


viaBasics : Bool
viaBasics =
    Basics.eq (F (\y -> y)) (F (\y -> y))


viaBasicsNeq : Bool
viaBasicsNeq =
    Basics.neq (F (\y -> y)) (F (\y -> y))


both x =
    x.eq x && x == x


viaBoth : Bool
viaBoth =
    both (F (\y -> y))


bothSwapped x =
    x == x && x.eq x


viaBothSwapped : Bool
viaBothSwapped =
    bothSwapped (F (\y -> y))
