-- CK-49: when a list's element type comes from its CONTEXT, a mismatch in
-- its first element says so ("This list needs `String` elements …, and its
-- 1st element is a `number`") and not that the element "does not match all
-- the previous elements" — there are none (checker-v2.md §15.3, R13 writes
-- the text). On 7427828 both lists below get "The 1st element of this list
-- does not match all the previous elements … previous elements are String".


xs : List String
xs =
    [ 1, 2 ]


shout : List String -> String
shout words =
    String.concat words


said : String
said =
    shout [ 1 ]
