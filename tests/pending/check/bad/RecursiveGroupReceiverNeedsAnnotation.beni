-- CK-72: a method call on a receiver produced by ANOTHER member of the same
-- recursive group cannot be generalised through: `r = g n` is monomorphic
-- inside the group `f`/`g`, so `q`'s `r.combine z` is one method type, and
-- `q "s"` after `q 1` is one `type_mismatch` with the hint to annotate `g`
-- (D14, checker-v2.md §10.7). The same in the other order is the twin,
-- `RecursiveGroupReceiverNeedsAnnotationB.beni`. On 7427828 `check` exits 0,
-- and `build` stops with INTERNAL ERROR "I cannot tell what this call
-- dispatches to". With `g : Int -> Box Int`, both orders build: that is the
-- corpus guard `run/RecursiveGroupAnnotatedReceiver.beni`.
--
-- The column is left open (`31:*`): the call `q "s"` or its argument, R7's
-- to bless.


type Box a
    = Box a


pub combine (Box a) z =
    Box a


f n =
    let
        r =
            g n

        q z =
            r.combine z
    in
    ( q 1, q "s" )


g n =
    if n > 100 then
        Box n

    else
        let
            _ =
                f (n + 1)
        in
        Box n
