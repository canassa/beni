-- CK-74: see H.beni.
import H


pub type T
    = T Int


pub type W
    = W (H.Holder T)


pub key (T x) u =
    if x == 0 then
        0

    else if W (H.Holder (T 0)) == W (H.Holder (T 0)) then
        x

    else
        0


same a b =
    W (H.Holder (T a)) == W (H.Holder (T b))


other =
    (T 1).key "s"
