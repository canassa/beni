-- CK-267: two fresh Dict values retain separate ownership (#663).
-- The owner deferred this folded-tree false refusal to #294. Expect the
-- callback write accepted; promote when #294 recovers the two-key case.
import Dict exposing (Dict)


grow : ⊤ → Dict Int (List Int)
grow ⊤ =
    d = Dict.insert (Dict.insert Dict.empty 1 [ 1 ]) 2 [ 2 ]
    Dict.update d 1 λm → Maybe.map m λv → List.push v 9
