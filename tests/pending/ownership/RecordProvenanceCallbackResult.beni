-- CK-291: R-4.8.14, #870 (`repkeys/HostParam`'s `c`). `pick` answers its
-- callback's answer, and each callback answers the record it is handed
-- owned, so `b` is the fresh literal's object: the second `pick`'s write
-- of it is accepted. Red: master prints "pending: no provenance names where
-- its base's object comes from" for `b`.
type alias Model =
    count : Int


pick : (Model → Model), Model → Model
pick f m = f (f m)


pub run : ⊤ → Model
run ⊤ =
    b = pick (λm → { m | count = m.count * 2 }) { count = 1 }
    pick (λm → { m | count = m.count + 3 }) b
