-- CK-291: R-4.8.14, #870 (`writes/A1Fallthrough`). Every record base gets a
-- verdict with a cause. `update` writes the page's record at
-- `model.page#Home.0`, which `init` never makes and every arm keeps owned
-- (`Home (homeUpdate sub home)` rebuilds it from the matched record), so the
-- entry line is accepted `entry` (R-5.8.4). Red: master prints "pending: no
-- provenance names where its base's object comes from" for that path.
import Browser
import Html exposing (Html)
import Tea


type HomeMsg
    = Clicked
    | Typed String


type alias HomeModel =
    clicks : Int
    text : String


type Page
    = Home HomeModel
    | Other


type Msg
    = GotHomeMsg HomeMsg
    | Leave


type alias Model =
    page : Page
    warning : String


homeUpdate : HomeMsg, HomeModel → HomeModel
homeUpdate msg home =
    case msg of
        Clicked →
            { home | clicks = home.clicks + 1 }

        Typed s →
            { home | text = s }


update : Msg, Model → Model
update msg model =
    case ( msg, model.page ) of
        ( GotHomeMsg sub, Home home ) →
            { model | page = Home (homeUpdate sub home) }

        ( _, _ ) →
            { model | warning = "stale" }


view : Model → Html Msg
view model = <p>{model.warning}</p>


main : Browser.Program
main = Tea.sandbox { init = λ⊤ → { page = Other, warning = "" }, update = update, view = view }
