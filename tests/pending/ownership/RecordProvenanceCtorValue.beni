-- CK-291: R-4.8.14, #870 (`writes/ConstructorAsValue`). `Pair`'s counter at
-- `model#Pair.1` is only ever the record a previous model held there or the
-- one `bump` answers for it, so the entry write is accepted `entry`
-- (R-5.8.4). Red: master prints "pending: no provenance names where its
-- base's object comes from" for that path.
import Browser
import Html exposing (Html)
import Tea


type alias Counter =
    n : Int
    label : String


type Model
    = Page Counter
    | Pair String Counter


type Msg
    = Inc
    | Rename String


updateWith : (Counter → Model), Counter → Model
updateWith toModel counter = toModel counter


bump : Counter → Counter
bump counter = { counter | n = counter.n + 1 }


update : Msg, Model → Model
update msg model =
    case ( msg, model ) of
        ( Inc, Page counter ) →
            updateWith Page (bump counter)

        ( Inc, Pair tag counter ) →
            updateWith (Pair tag _) (bump counter)

        ( Rename name, Pair _ counter ) →
            Pair name counter

        ( Rename _, Page _ ) →
            model


view : Model → Html Msg
view model =
    case model of
        Page counter →
            <p>{counter.label}</p>

        Pair tag _ →
            <p>{tag}</p>


main : Browser.Program
main = Tea.sandbox { init = λ⊤ → Page { n = 0, label = "a" }, update = update, view = view }
