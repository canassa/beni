-- CK-256: a level reached through a fold is taken for the root's level
-- (issue #379, found while designing ownership-checker.md §16.7's (d)).
-- Folding makes `#Node.0#Node.1` the path `#Node.1`, so the symbolic cell of
-- level 1's list, reached from `t` through `l`, is `param(t, #Node.1)`: the
-- same cell as the root's own list. `inner` pushes level 1's list and returns
-- `l`, which holds it, with no sharing in the input at all; `hole` in
-- `ParamHole` prints the same summary. `pick` hands the pair back through a
-- call, and `outer` pushes the list while it holds `l`. All are accepted
-- `param` on master. The golden is written by reasoning, before a fix: each
-- push is rejected `element`, because `l` may hold the list, as the inline
-- twin in `FoldLevels` is.
type Tree
    = Leaf
    | Node Tree (List Int) Tree


pub inner : Tree → List Int × Tree
inner t =
    case t of
        Node l _ _ →
            case l of
                Node _ zs _ →
                    ( List.push zs 1, l )

                Leaf →
                    ( [], Leaf )

        Leaf →
            ( [], Leaf )


pick : Tree → List Int × Tree
pick t =
    case t of
        Node l _ _ →
            case l of
                Node _ zs _ →
                    ( zs, l )

                Leaf →
                    ( [], Leaf )

        Leaf →
            ( [], Leaf )


pub outer : Tree → List Int × Tree
outer s =
    case pick s of
        ( zs, l ) →
            ( List.push zs 1, l )
