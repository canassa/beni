-- CK-234: a function parameter handed on inside a lambda drops the need of the callee it reaches.
-- ownership (§30.9, issue #212): a declaration that hands its own function
-- parameter on inside a lambda takes the callee's facts, `need` among them.
-- `load` hands `tag` to `Cmd.task` inside a lambda it calls at once, so
-- `Cmd.task` sends what `tag` returns and `load` needs `tag` to return what
-- it owns. Before, the pass inside the lambda only lost sight of `tag`, its
-- `need` was dropped, and a tagger answering the top-level `shared` was
-- accepted while `update` pushes onto the payload in place. `fresh` hands
-- `load` a tagger that answers a new list, and is accepted.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea


type Msg
    = Go
    | Fresh
    | Got (List Int)


shared : List Int
shared = [ 1, 2 ]


load : (List Int → Msg) → Cmd Msg
load tag = (λ⊤ → Cmd.task (λ⊤ → [ 3 ]) tag) ⊤


update : Msg, List Int → List Int × Cmd Msg
update msg model =
    case msg of
        Go →
            ( model, load λ_ → Got shared )

        Fresh →
            ( model, load λ_ → Got [ 5 ] )

        Got xs →
            ( List.push xs 4, Cmd.none )


view : List Int → Html Msg
view model = <button onClick={Go}>{String.fromInt (List.length model)}</button>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( [], Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → Sub.none
        }
