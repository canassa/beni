[{"code":"program_shape","severity":"error","span":{"file":"Main.beni","start":{"line":42,"col":72},"end":{"line":42,"col":78}},"title":"PROGRAM SHAPE","message":"Key `Restore` replaces the whole model with a value the compiler cannot see\ninto, so no binding of the page can be chosen for it: `browser-inline` writes\nonly the bindings a key's writes reach, and never checks the whole page again\n(`docs/design/browser-inline.md` §8.7; §5, class 3). Write the fields the arm\nchanges — `{ model | count = saved.count }` — so that its writes name them."}]
