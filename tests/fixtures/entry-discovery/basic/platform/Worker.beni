pub type Program
    = Program
        { init : (Int, Int → Int)
        , start : (Int, Int → Int)
        , handle : (Int, Int, Int → Int)
        , stream : (Int, Int, Int, Int → Int)
        }


pub make :
      { init : (Int, Int → Int)
      , start : (Int, Int → Int)
      , handle : (Int, Int, Int → Int)
      , stream : (Int, Int, Int, Int → Int)
      }
    → Program
make callbacks = Program callbacks


pub open : Program, ⊤ → ⊤
open _ _ = ⊤
