type NColor
    = Red
    | Black


type TreeF
    = NodeF NColor Int (List Int) (List Int) (List Int) (List Int) TreeF TreeF
    | LeafF


balanceF : NColor, Int, List Int, List Int, List Int, List Int, TreeF, TreeF → TreeF
balanceF color key v0 v1 v2 v3 left right =
    case right of
        NodeF Red rK rV0 rV1 rV2 rV3 rLeft rRight →
            case left of
                NodeF Red lK lV0 lV1 lV2 lV3 lLeft lRight →
                    NodeF Red key v0 v1 v2 v3 (NodeF Black lK lV0 lV1 lV2 lV3 lLeft lRight) (NodeF Black rK rV0 rV1 rV2 rV3 rLeft rRight)

                _ →
                    NodeF color rK rV0 rV1 rV2 rV3 (NodeF Red key v0 v1 v2 v3 left rLeft) rRight

        _ →
            case left of
                NodeF Red lK lV0 lV1 lV2 lV3 (NodeF Red llK llV0 llV1 llV2 llV3 llLeft llRight) lRight →
                    NodeF Red lK lV0 lV1 lV2 lV3 (NodeF Black llK llV0 llV1 llV2 llV3 llLeft llRight) (NodeF Black key v0 v1 v2 v3 lRight right)

                _ →
                    NodeF color key v0 v1 v2 v3 left right


removeMinF : TreeF → TreeF
removeMinF tree =
    case tree of
        NodeF color key v0 v1 v2 v3 ((NodeF lColor _ _ _ _ _ lLeft _) as left) right →
            case lColor of
                Black →
                    case lLeft of
                        NodeF Red _ _ _ _ _ _ _ →
                            NodeF color key v0 v1 v2 v3 (removeMinF left) right

                        _ →
                            case moveRedLeftF tree of
                                NodeF nColor nKey nV0 nV1 nV2 nV3 nLeft nRight →
                                    balanceF nColor nKey nV0 nV1 nV2 nV3 (removeMinF nLeft) nRight

                                LeafF →
                                    LeafF

                _ →
                    NodeF color key v0 v1 v2 v3 (removeMinF left) right

        _ →
            LeafF


moveRedLeftF : TreeF → TreeF
moveRedLeftF tree =
    case tree of
        NodeF _ k v0 v1 v2 v3 (NodeF _ lK lV0 lV1 lV2 lV3 lLeft lRight) (NodeF _ rK rV0 rV1 rV2 rV3 rLeft rRight) →
            case rLeft of
                NodeF Red rlK rlV0 rlV1 rlV2 rlV3 rlL rlR →
                    NodeF Red rlK rlV0 rlV1 rlV2 rlV3 (NodeF Black k v0 v1 v2 v3 (NodeF Red lK lV0 lV1 lV2 lV3 lLeft lRight) rlL) (NodeF Black rK rV0 rV1 rV2 rV3 rlR rRight)

                _ →
                    NodeF Black k v0 v1 v2 v3 (NodeF Red lK lV0 lV1 lV2 lV3 lLeft lRight) (NodeF Red rK rV0 rV1 rV2 rV3 rLeft rRight)

        _ →
            tree


rebuildF : TreeF → TreeF
rebuildF t =
    case removeMinF t of
        NodeF c k v0 v1 v2 v3 l r →
            NodeF c k (List.push v0 9) (List.push v1 9) (List.push v2 9) (List.push v3 9) l r

        LeafF →
            LeafF
