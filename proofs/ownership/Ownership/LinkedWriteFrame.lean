import Ownership.HeapProof

/-! Successful linked writes preserve complete observations outside their
initial undirected link component. These proofs use the real runtime operations.
They establish no caller permission, write success, or link-validity contract. -/

namespace Ownership.LinkedWriteFrame

open InPlaceSemantics HeapProof

abbrev Links := List (Nat × Nat × Bool)

/-- The undirected component generated by the actual stored links. -/
inductive LinkConnected (links : Links) : Nat → Nat → Prop where
  | refl (a : Nat) : LinkConnected links a a
  | edge {a b : Nat} {front : Bool} :
      (a, b, front) ∈ links → LinkConnected links a b
  | symm {a b : Nat} : LinkConnected links a b → LinkConnected links b a
  | trans {a b c : Nat} :
      LinkConnected links a b → LinkConnected links b c → LinkConnected links a c

/-- The links stay fixed. The heap outside the initial component stays equal.
Permanent observer registrations also stay equal. -/
structure Frame (links : Links) (root : Nat) (pre post : State) : Prop where
  links_eq : post.links = links
  heap : ∀ c, ¬ LinkConnected links root c → post.heap[c]? = pre.heap[c]?
  kept : post.kept = pre.kept

theorem Frame.refl (same : s.links = links) : Frame links root s s :=
  ⟨same, by intro _ _; rfl, rfl⟩

theorem Frame.trans (first : Frame links root a b) (second : Frame links root b c) :
    Frame links root a c :=
  ⟨second.links_eq, fun d outside => (second.heap d outside).trans (first.heap d outside),
    second.kept.trans first.kept⟩

def Preserves (links : Links) (root : Nat) (action : M α) : Prop :=
  ∀ pre post value, pre.links = links → action.run pre = .ok (value, post) →
    Frame links root pre post

theorem bind_success {action : M α} {next : α → M β}
    (run : (action >>= next).run pre = .ok (value, post)) :
    ∃ intermediate middle, action.run pre = .ok (intermediate, middle) ∧
      (next intermediate).run middle = .ok (value, post) := by
  change (action pre >>= fun (a, s) => next a s) = .ok (value, post) at run
  cases first : action pre with
  | error problem =>
    rw [first] at run
    change Except.error problem = Except.ok (value, post) at run
    contradiction
  | ok pair =>
    rcases pair with ⟨intermediate, middle⟩
    exact ⟨intermediate, middle, first, by simpa [first] using run⟩

theorem preserves_pure (value : α) : Preserves links root (pure value : M α) := by
  intro pre post result same run
  change Except.ok (value, pre) = Except.ok (result, post) at run
  cases run
  exact Frame.refl same

theorem preserves_bind {action : M α} {next : α → M β}
    (first : Preserves links root action)
    (rest : ∀ value, Preserves links root (next value)) :
    Preserves links root (action >>= next) := by
  intro pre post value same run
  obtain ⟨intermediate, middle, before, after⟩ := bind_success run
  have a := first pre middle intermediate same before
  have b := rest intermediate middle post value a.links_eq after
  exact a.trans b

theorem forIn_preserves {α β : Type} (items : List α) (initial : β)
    (step : α → β → M (ForInStep β))
    (safe : ∀ item ∈ items, ∀ accumulator, Preserves links root (step item accumulator)) :
    Preserves links root (forIn items initial step) := by
  revert safe
  induction items generalizing initial with
  | nil =>
    intro _
    simpa using (preserves_pure (links := links) (root := root) initial)
  | cons item items ih =>
    intro safe
    rw [List.forIn_cons]
    apply preserves_bind (safe item (by simp) initial)
    intro next
    cases next with
    | done accumulator => exact preserves_pure accumulator
    | yield accumulator =>
      exact ih accumulator (fun item member acc => safe item (by simp [member]) acc)

theorem array_run (s : State) (c : Nat) :
    (array c).run s =
      match s.heap[c]? with
      | none => .error "dangling array reference"
      | some xs => .ok (xs, s) := by
  change (s.heap[c]?.toExcept "dangling array reference" >>= fun xs =>
    Except.ok (xs, s)) = _
  cases lookup : s.heap[c]? <;> rfl

theorem array_success (run : (array c).run pre = .ok (xs, post)) :
    post = pre ∧ pre.heap[c]? = some xs := by
  rw [array_run] at run
  cases lookup : pre.heap[c]? with
  | none => simp [lookup] at run
  | some values =>
    simp only [lookup] at run
    cases run
    exact ⟨rfl, rfl⟩

theorem array_preserves (c : Nat) : Preserves links root (array c) := by
  intro pre post values same run
  obtain ⟨rfl, _⟩ := array_success run
  exact Frame.refl same

theorem write_run (s : State) (c : Nat) (xs : List Value) :
    (write c xs).run s =
      if c ≥ s.heap.size then .error "dangling write"
      else .ok (.ref c, {s with heap := s.heap.set! c xs}) := by
  dsimp [write, StateT.run, StateT.bind, StateT.map, StateT.get, StateT.set,
    StateT.modifyGet]
  simp only [pure_bind]
  split <;> rfl

theorem write_preserves (connected : LinkConnected links root c) (xs : List Value) :
    Preserves links root (write c xs) := by
  intro pre post result same run
  rw [write_run] at run
  split at run
  · contradiction
  · cases run
    refine ⟨same, ?_, rfl⟩
    intro address outside
    apply lookup_set_other
    intro equal
    exact outside (by simpa [equal] using connected)

theorem spliceUp_preserves (depth : Nat) :
    ∀ {c : Nat} {pre post : State} {ancestor : Nat},
      LinkConnected links root c → pre.links = links →
      (spliceUp depth c).run pre = .ok (ancestor, post) →
      Frame links root pre post ∧ LinkConnected links root ancestor := by
  induction depth with
  | zero =>
    intro c pre post ancestor _ _ run
    change Except.error "view chain exhausted fuel" = Except.ok (ancestor, post) at run
    contradiction
  | succ depth ih =>
    intro c pre post ancestor connected same run
    change ((match pre.links.find? (·.1 == c) with
      | none => pure c
      | some (_, source, front) => do
        let base ← array source
        let xs ← array c
        let _ ← write source
          (if front then base.take 1 ++ xs else xs ++ base.drop (base.length - 1))
        spliceUp depth source) : M Nat).run pre = .ok (ancestor, post) at run
    rw [same] at run
    cases found : links.find? (·.1 == c) with
    | none =>
      simp only [found] at run
      change Except.ok (c, pre) = Except.ok (ancestor, post) at run
      cases run
      exact ⟨Frame.refl same, connected⟩
    | some edge =>
      rcases edge with ⟨view, source, front⟩
      have view_eq : view = c := by
        have test := List.find?_some found
        simpa using test
      have member : (c, source, front) ∈ links := by
        simpa [view_eq] using List.mem_of_find?_eq_some found
      have source_connected : LinkConnected links root source :=
        connected.trans (LinkConnected.edge member)
      simp only [found] at run
      obtain ⟨base, afterBase, readBase, restBase⟩ := bind_success run
      have baseState := (array_success readBase).1
      subst afterBase
      obtain ⟨xs, afterXs, readXs, restXs⟩ := bind_success restBase
      have xsState := (array_success readXs).1
      subst afterXs
      obtain ⟨written, middle, writeRun, rest⟩ := bind_success restXs
      have before := write_preserves source_connected
        (if front then base.take 1 ++ xs else xs ++ base.drop (base.length - 1))
        pre middle written same writeRun
      obtain ⟨after, ancestor_connected⟩ := ih source_connected before.links_eq rest
      exact ⟨before.trans after, ancestor_connected⟩

/-- The actual descendant-loop body, exposed only for the frame induction. -/
def refreshStep (depth c : Nat) (edge : Nat × Nat × Bool) (_ : Unit) :
    M (ForInStep Unit) := do
  let (view, source, front) := edge
  if source == c then
    let _ ← write view (viewOf front (← array c))
    refreshDown depth view
  pure (.yield ())

theorem refreshDown_preserves (depth : Nat) :
    ∀ {c : Nat}, LinkConnected links root c →
      Preserves links root (refreshDown depth c) := by
  induction depth with
  | zero =>
    intro c _ pre post value _ run
    change Except.error "view chain exhausted fuel" = Except.ok (value, post) at run
    contradiction
  | succ depth ih =>
    intro c connected pre post value same run
    change ((forIn pre.links () (refreshStep depth c) >>= fun _ => pure ()) :
      M Unit).run pre = .ok (value, post) at run
    have safe : ∀ edge ∈ pre.links, ∀ accumulator,
        Preserves links root (refreshStep depth c edge accumulator) := by
      intro edge member accumulator
      rcases edge with ⟨view, source, front⟩
      have stored : (view, source, front) ∈ links := by simpa [same] using member
      by_cases source_eq : source = c
      · have view_connected : LinkConnected links root view :=
          connected.trans (LinkConnected.symm (by simpa [source_eq] using
            (LinkConnected.edge stored : LinkConnected links view source)))
        simp only [refreshStep, source_eq, beq_self_eq_true, if_true]
        apply preserves_bind (array_preserves c)
        intro xs
        apply preserves_bind (write_preserves view_connected (viewOf front xs))
        intro _
        apply preserves_bind (ih view_connected)
        intro _
        exact preserves_pure (ForInStep.yield ())
      · have source_ne : (source == c) = false := by simp [source_eq]
        simpa only [refreshStep, source_ne, Bool.false_eq_true, if_false, pure_bind] using
          (preserves_pure (links := links) (root := root) (ForInStep.yield ()))
    exact preserves_bind (forIn_preserves pre.links () (refreshStep depth c) safe)
      (fun _ => preserves_pure ()) pre post value same run

theorem writeLinked_preserves
    (run : (writeLinked c xs).run pre = .ok (result, post)) :
    Frame pre.links c pre post := by
  change ((write c xs) >>= fun r => do
    let s ← get
    if s.links.isEmpty then return r
    let ancestor ← spliceUp (s.heap.size + 1) c
    refreshDown (s.heap.size + 1) ancestor
    pure r).run pre = .ok (result, post) at run
  obtain ⟨written, afterWrite, writeRun, rest⟩ := bind_success run
  have first := write_preserves (LinkConnected.refl c) xs
    pre afterWrite written rfl writeRun
  change ((if afterWrite.links.isEmpty then pure written else do
    let ancestor ← spliceUp (afterWrite.heap.size + 1) c
    refreshDown (afterWrite.heap.size + 1) ancestor
    pure written) : M Value).run afterWrite = .ok (result, post) at rest
  split at rest
  · change Except.ok (written, afterWrite) = Except.ok (result, post) at rest
    cases rest
    exact first
  · obtain ⟨ancestor, afterSplice, spliceRun, restSplice⟩ := bind_success rest
    obtain ⟨second, ancestor_connected⟩ :=
      spliceUp_preserves (afterWrite.heap.size + 1) (LinkConnected.refl c)
        first.links_eq spliceRun
    obtain ⟨finished, afterRefresh, refreshRun, finishRun⟩ := bind_success restSplice
    have third := refreshDown_preserves (afterWrite.heap.size + 1) ancestor_connected
      afterSplice afterRefresh finished second.links_eq refreshRun
    change Except.ok (written, afterRefresh) = Except.ok (result, post) at finishRun
    cases finishRun
    exact (first.trans second).trans third

theorem writeLinked_changed_address
    (run : (writeLinked root xs).run pre = .ok (result, post))
    (changed : post.heap[address]? ≠ pre.heap[address]?) :
    LinkConnected pre.links root address := by
  apply Classical.byContradiction
  intro outside
  exact changed ((writeLinked_preserves run).heap address outside)

theorem writeLinked_preserves_represents
    (run : (writeLinked root xs).run pre = .ok (result, post))
    (rep : Represents pre.heap n value observation footprint)
    (apart : ∀ c ∈ footprint, ¬ LinkConnected pre.links root c) :
    Represents post.heap n value observation footprint :=
  represents_frame rep fun c member => (writeLinked_preserves run).heap c (apart c member)

theorem writeLinked_preserves_representsMany
    (run : (writeLinked root xs).run pre = .ok (result, post))
    (rep : RepresentsMany pre.heap n values observations footprint)
    (apart : ∀ c ∈ footprint, ¬ LinkConnected pre.links root c) :
    RepresentsMany post.heap n values observations footprint :=
  representsMany_frame rep fun c member => (writeLinked_preserves run).heap c (apart c member)

theorem writeLinked_preserves_snapshot
    (run : (writeLinked root xs).run pre = .ok (result, post))
    (rep : Represents pre.heap n value observation footprint)
    (apart : ∀ c ∈ footprint, ¬ LinkConnected pre.links root c) :
    snapshot post.heap n value = .ok observation :=
  snapshot_of_represents (writeLinked_preserves_represents run rep apart)

theorem writeLinked_preserves_observers
    (run : (writeLinked root xs).run pre = .ok (result, post))
    (rep : RepresentsMany pre.heap n pre.kept.toList observations footprint)
    (apart : ∀ c ∈ footprint, ¬ LinkConnected pre.links root c) :
    post.kept.toList.mapM (snapshot post.heap n) = .ok observations := by
  rw [(writeLinked_preserves run).kept]
  exact snapshots_of_represents (writeLinked_preserves_representsMany run rep apart)

theorem writeLinked_preserves_action (connected : LinkConnected links root c)
    (xs : List Value) : Preserves links root (writeLinked c xs) := by
  intro pre post value same run
  have frame := writeLinked_preserves run
  refine ⟨frame.links_eq.trans same, ?_, frame.kept⟩
  intro address outside
  apply frame.heap address
  intro linked
  exact outside (connected.trans (by simpa [same] using linked))

theorem countWrite_preserves : Preserves links root countWrite := by
  intro pre post value same run
  change Except.ok ((), {pre with writes := pre.writes + 1}) =
    Except.ok (value, post) at run
  cases run
  exact ⟨same, by intro _ _; rfl, rfl⟩

theorem writeCounted_preserves
    (run : (writeCounted c xs).run pre = .ok (result, post)) :
    Frame pre.links c pre post := by
  have safe : Preserves pre.links c (writeCounted c xs) := by
    unfold writeCounted
    apply preserves_bind (array_preserves c)
    intro old
    dsimp only
    split
    · apply preserves_bind countWrite_preserves
      intro _
      exact writeLinked_preserves_action (LinkConnected.refl c) xs
    · apply preserves_bind (preserves_pure ())
      intro _
      exact writeLinked_preserves_action (LinkConnected.refl c) xs
  exact safe pre post result rfl run

theorem writeCounted_preserves_represents
    (run : (writeCounted root xs).run pre = .ok (result, post))
    (rep : Represents pre.heap n value observation footprint)
    (apart : ∀ c ∈ footprint, ¬ LinkConnected pre.links root c) :
    Represents post.heap n value observation footprint :=
  represents_frame rep fun c member => (writeCounted_preserves run).heap c (apart c member)

/-- Every edge-respecting address label is constant on a link component. -/
theorem LinkConnected.respects (tag : Nat → α)
    (edge_eq : ∀ {a b : Nat} {front : Bool},
      (a, b, front) ∈ links → tag a = tag b)
    (connected : LinkConnected links a b) : tag a = tag b := by
  induction connected with
  | refl => rfl
  | edge member => exact edge_eq member
  | symm _ ih => exact ih.symm
  | trans _ _ first second => exact first.trans second

def examplePre : State :=
  { fuel := 100
    heap := #[[.int 10, .int 20], [.int 20], [.int 7]]
    kept := #[.ref 2]
    links := [(1, 0, true)] }

def examplePost : State :=
  {examplePre with heap := #[[.int 10, .int 20, .int 99], [.int 20, .int 99], [.int 7]]}

/-- A successful write changes both the source and its view. -/
theorem example_run :
    (writeLinked 1 [.int 20, .int 99]).run examplePre = .ok (.ref 1, examplePost) := by
  rfl

theorem example_component_apart : ¬ LinkConnected examplePre.links 1 2 := by
  intro connected
  have edges : ∀ {a b : Nat} {front : Bool},
      (a, b, front) ∈ examplePre.links → (a == 2) = (b == 2) := by
    intro a b front member
    have fields : a = 1 ∧ b = 0 ∧ front = true := by simpa [examplePre] using member
    rcases fields with ⟨rfl, rfl, rfl⟩
    rfl
  have bad := LinkConnected.respects (fun c => c == 2) edges connected
  change false = true at bad
  contradiction

/-- The generic theorem protects the permanent observer of independent cell 2. -/
theorem example_observer_frame :
    Represents examplePost.heap 2 (.ref 2) (.list [.int 7]) [2] := by
  apply writeLinked_preserves_represents example_run
  · exact .ref rfl (.cons .int .nil)
  · intro c member
    have same : c = 2 := by simpa using member
    subst c
    exact example_component_apart


/-- The generic all-observer theorem covers the nonempty registration list. -/
theorem example_all_observers_frame :
    examplePost.kept.toList.mapM (snapshot examplePost.heap 2) =
      .ok [.list [.int 7]] := by
  apply writeLinked_preserves_observers example_run
  · exact .cons (.ref rfl (.cons .int .nil)) .nil
  · intro c member
    have same : c = 2 := by simpa using member
    subst c
    exact example_component_apart

/-- Throwaway: a new `sorry` in an audited module. CI must fail (#254). -/
theorem ciProbe : False := sorry

end Ownership.LinkedWriteFrame
