-- A counter: one button adds one, the other takes one away.
import Html exposing (Html)
import Tea


type Msg
    = Increment
    | Decrement


update : Msg, Int → Int
update msg count =
    case msg of
        Increment →
            count + 1

        Decrement →
            count - 1


view : Int → Html Msg
view count =
    <main>
        <button onClick={Decrement}>-</button>
        <span>{count}</span>
        <button onClick={Increment}>+</button>
    </main>


main : Tea.Program
main = Tea.sandbox { init = λ⊤ → 0, update = update, view = view }
