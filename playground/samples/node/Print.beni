-- A program that prints: the first Fibonacci numbers.
import Node exposing (Program)


fib : Int → Int
fib n =
    if n < 2 then
        n
    else
        fib (n - 1) + fib (n - 2)


line : Int → String
line n = "fib ${n} = ${fib n}"


main : Program
main = Node.printLines (List.map (List.range 0 10) line)
