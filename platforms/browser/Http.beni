--! HTTP requests from a page (`docs/design/boundary.md` §9.8.12): elm/http
--! 2.0, its pieces under their names, as direct forms. A request waits in
--! the calling fiber and returns its answer as a `Result`, and every way a
--! request can fail is a value: each failure the URL and Fetch standards
--! document is one constructor, found by a test of the value where it can
--! be and by the error's class where it cannot, and anything else stops the
--! page (CLAUDE.md rule 9). Cancelling the fiber that waits aborts the
--! request — its connection, its body and its timer — so a keyed
--! `Restart` releases the old request at once. The command form is
--! `Cmd.task` over a request:
--!
--!     Search q →
--!         ( model, Cmd.keyed SearchKey Cmd.Restart λsend →
--!             send (Found (Http.get { url = "/api/search?q=" ++ q, expect = Http.expectString })) )
--!
--! or `send` and `riskySend`, elm/http's commands, whose progress a
--! `track` subscription hears (§9.8.19).

import Browser
import Browser.Host.AbortController as AbortController
import Browser.Host.AbortSignal as AbortSignal
import Browser.Host.DOMException as DOMException
import Browser.Host.Document as HostDocument
import Browser.Host.Fetch as Fetch
import Browser.Host.FormData as FormData
import Browser.Host.Headers as Headers
import Browser.Host.Promise as Promise
import Browser.Host.ReadResult as ReadResult
import Browser.Host.ReadableStreamDefaultReader as Reader
import Browser.Host.RegExp as HostRegExp
import Browser.Host.Rejection as Rejection
import Browser.Host.Response as HostResponse
import Browser.Host.TextDecoder as TextDecoder
import Browser.Host.TextEncoder as TextEncoder
import Browser.Host.Timers as Timers
import Browser.Host.URL as HostURL
import Browser.Host.Uint8Array as Uint8Array
import Cmd exposing (Cmd)
import Dict exposing (Dict)
import Js
import Js.Chain as Chain
import Js.Protocol as Protocol
import Schema exposing (Schema)
import Sub exposing (Sub)
import Task exposing (Resume)
import Time exposing (Duration)


--| How a request failed: an address that does not parse (or holds a user
--| name or password), a request the host would refuse, found before
--| anything is sent, the request's own timeout, no answer at all (the
--| network, DNS, a refused connection, CORS, a body cut off), or an answer
--| whose status is not 2xx, or a 2xx body the schema of `expectJson` does
--| not parse, with its issues.
pub type Error
    = BadUrl String
    | BadRequest Problem
    | Timeout
    | NetworkError
    | BadStatus Int
    | BadBody (List Schema.Issue)


--| Why a request was refused before it was sent.
pub type Problem
    = InvalidMethod String
    | ForbiddenMethod String
    | InvalidHeader String
    | ForbiddenHeader String
    | BodyNotAllowed String
    | MultipartContentType
    | UnprintableBody (List Schema.Issue)


--| A request header: its name and its value.
pub opaque type Header
    = Header String String


--| A header, sent as given; a name given twice is sent once with both
--| values, joined.
--|
--|     Http.header "Authorization" ("Bearer " ++ token)
pub header : String, String → Header
header name value = Header name value


--| What a request sends.
pub opaque type Body
    = Empty
    | Text String String
    | Multipart (List Part)
    | Unprintable (List Schema.Issue)


--| A part of a `multipartBody`.
pub opaque type Part
    = StringPart String String


--| No body.
pub emptyBody : Body
emptyBody = Empty


--| Text, sent with its MIME type as the `Content-Type` unless a header
--| names one.
--|
--|     Http.stringBody "text/plain" "hello"
pub stringBody : String, String → Body
stringBody mime text = Text mime text


--| Parts, sent as `multipart/form-data` — what a `<form>` with
--| `enctype="multipart/form-data"` sends — with the host's `Content-Type`
--| and boundary. A `Content-Type` header of the program's beside it is
--| refused, `BadRequest MultipartContentType`: the boundary in it would
--| not be the body's.
--|
--|     Http.multipartBody [ Http.stringPart "title" "Notes", Http.stringPart "tag" "work" ]
pub multipartBody : List Part → Body
multipartBody parts = Multipart parts


--| A text field of a multipart body: its name, then its value.
pub stringPart : String, String → Part
stringPart name value = StringPart name value


--| A value printed as JSON by its schema (`Schema.print`), sent as
--| `application/json` unless a header names another type. A value the
--| schema does not print — a `Float` that is not finite, a refinement it
--| breaks — is refused before anything is sent: `BadRequest
--| (UnprintableBody issues)`.
--|
--|     Http.post { url = "/api/notes", body = Http.jsonBody noteSchema note, expect = Http.expectWhatever }
pub jsonBody : Schema e a, a → Body
jsonBody schema value =
    case Schema.print schema value of
        Ok text →
            Text "application/json" text

        Err issues →
            Unprintable issues


--| How the answer is read: what it is turned into, with which errors.
pub opaque type Expect x a
    = Expect String (Response String → Result x a)


--| The body as text; a status that is not 2xx is `BadStatus`.
pub expectString : Expect Error String
expectString = Expect "" λresponse → answered response


--| The body parsed as JSON into the type the request's answer is used at,
--| whose schema the compiler derives from that type, as `Json.decode`'s
--| (`schema.md` §12): `Accept: application/json` is sent unless a header
--| names another type. A 2xx body that does not parse — text that is not
--| JSON, a field missing — is `BadBody` with the issues, each with its
--| path; a status that is not 2xx is `BadStatus`, whatever its body.
--|
--|     Http.get { url = "/api/notes", expect = Http.expectJson }
pub expectJson : Expect Error a
    where a.codec : ⊤ → Schema.Codec a
expectJson = Expect "application/json" λresponse →
    Result.andThen (answered response) λtext →
        Result.mapError (Schema.parse (a.codec ⊤) text) BadBody


--| The body parsed as JSON by the schema given (`Schema.parse`): what
--| `expectJson` does with a derived schema, with a declared one, which
--| reads what the type alone cannot say — a renamed key, a default, a
--| conversion.
--|
--|     Http.get { url = "/api/notes", expect = Http.expectSchema (Schema.list (Note.schema ⊤)) }
pub expectSchema : Schema e a → Expect Error a
expectSchema schema = Expect "application/json" λresponse →
    Result.andThen (answered response) λtext → Result.mapError (Schema.parse schema text) BadBody


--| Nothing of the body; a status that is not 2xx is `BadStatus`.
pub expectWhatever : Expect Error ⊤
expectWhatever = Expect "" λresponse → Result.map (answered response) λ_ → ⊤


--| The whole answer, as `f` reads it: every failure, and the status, the
--| headers and the body of an answer whatever its status.
pub expectStringResponse : (Response String → Result x a) → Expect x a
expectStringResponse f = Expect "" f


--| An answer, or why there is none.
pub type Response body
    = BadUrl_ String
    | BadRequest_ Problem
    | Timeout_
    | NetworkError_
    | BadStatus_ Metadata body
    | GoodStatus_ Metadata body


--| What came with an answer: the address that answered, after redirects;
--| the status and its text (`""` over HTTP/2 and HTTP/3, which carry
--| none); and the headers, names lower-cased and a repeated header's
--| values joined with `", "`. A cross-origin answer shows only the headers
--| its server exposes, and `Set-Cookie` never: that is the host's rule.
pub type alias Metadata =
    url : String
    statusCode : Int
    statusText : String
    headers : Dict String String


--| How far a request has got, as its tracker is told (§9.8.12 (e)). `fetch`
--| reports no upload progress, so a body is `Sending` twice: nothing sent
--| before the request goes, all of it once the answer's headers arrive.
--| Then `Receiving`, with the answer's `Content-Length` as its size when
--| it has one, after each chunk of the body. The bytes counted are those
--| the host hands over, after it has undone any compression, so `received`
--| may pass `size`.
pub type Progress
    = Sending { sent : Int, size : Int }
    | Receiving { received : Int, size : Maybe Int }


--| How much of the body has been sent, from 0 to 1; a body of no bytes
--| is all sent.
pub fractionSent : { sent : Int, size : Int } → Float
fractionSent p =
    if p.size == 0 then
        1
    else
        clamp (toFloat p.sent / toFloat p.size) 0 1


--| How much of the answer has arrived, from 0 to 1: 0 while its size is
--| not known, and never more than 1.
pub fractionReceived : { received : Int, size : Maybe Int } → Float
fractionReceived p =
    case p.size of
        Nothing →
            0

        Just n →
            if n == 0 then
                1
            else
                clamp (toFloat p.received / toFloat n) 0 1


--| A request. It is checked before it is sent: the URL (relative to the
--| page), the method, each header and the body, each failure a
--| `BadRequest` or `BadUrl`. `credentials` is `same-origin`. The timeout,
--| when there is one, runs from the moment the request is sent until its
--| body has been read; zero or less times out at once.
--|
--|     Http.request
--|         { method = "DELETE"
--|         , headers = [ Http.header "Authorization" token ]
--|         , url = "/api/items/7"
--|         , body = Http.emptyBody
--|         , expect = Http.expectWhatever
--|         , timeout = Just (Time.seconds 10)
--|         , tracker = Nothing
--|         }
pub request :
      { method : String
      , headers : List Header
      , url : String
      , body : Body
      , expect : Expect x a
      , timeout : Maybe Duration
      , tracker : Maybe (Progress → ⊤)
      }
    → Result x a
request r =
    transfer
        problemOf
        "same-origin"
        r.method
        r.headers
        r.url
        r.body
        r.expect
        (timerOf r.timeout)
        (readingOf r.tracker)


--| `request` with the browser's credentials — cookies, authorization —
--| sent to any origin: `credentials` is `include`.
pub riskyRequest :
      { method : String
      , headers : List Header
      , url : String
      , body : Body
      , expect : Expect x a
      , timeout : Maybe Duration
      , tracker : Maybe (Progress → ⊤)
      }
    → Result x a
riskyRequest r =
    transfer
        problemOf
        "include"
        r.method
        r.headers
        r.url
        r.body
        r.expect
        (timerOf r.timeout)
        (readingOf r.tracker)


--| `GET` the URL.
--|
--|     Http.get { url = "/api/items", expect = Http.expectString }
pub get : { url : String, expect : Expect x a } → Result x a
get r = transfer unchecked "same-origin" "GET" [] r.url Empty r.expect NoTimer Plain


--| `POST` the body to the URL.
pub post : { url : String, body : Body, expect : Expect x a } → Result x a
post r = transfer bodyChecks "same-origin" "POST" [] r.url r.body r.expect NoTimer Plain


--| The command form of `request`, as elm/http 2.0's `request` was: the
--| request is a value, built and encoded when the command is made — its
--| body `jsonBody`'s text, never a function that reads the model when the
--| request runs (`docs/design/boundary.md` §9.8.16) — and its answer is
--| sent through `tag`. With `tracker = Just name`, every `track name`
--| subscription of the page hears its progress, each value before the
--| answer (§9.8.19).
--|
--|     Save →
--|         ( model
--|         , Http.send
--|             { method = "PUT"
--|             , headers = []
--|             , url = "/api/notes/7"
--|             , body = Http.jsonBody noteSchema model.note
--|             , expect = Http.expectWhatever
--|             , timeout = Nothing
--|             , tracker = Just "save"
--|             }
--|             Saved
--|         )
pub send :
      { method : String
      , headers : List Header
      , url : String
      , body : Body
      , expect : Expect x a
      , timeout : Maybe Duration
      , tracker : Maybe String
      }
    , (Result x a → msg)
    → Cmd msg
send r tag = Cmd.task (λ⊤ → commanded "same-origin" r) tag


--| `send` with the browser's credentials — cookies, authorization — sent
--| to any origin: `credentials` is `include`, as `riskyRequest`'s.
pub riskySend :
      { method : String
      , headers : List Header
      , url : String
      , body : Body
      , expect : Expect x a
      , timeout : Maybe Duration
      , tracker : Maybe String
      }
    , (Result x a → msg)
    → Cmd msg
riskySend r tag = Cmd.task (λ⊤ → commanded "include" r) tag


--| The progress of every `send` and `riskySend` whose `tracker` is `Just
--| name`, each value through `tag` (§9.8.19). A request reports a value to
--| the subscriptions live when it has one, and every value reaches
--| `update` before the request's answer. A `track` declared by the
--| `update` that made the command hears the first value. The names are
--| the page's: two programs on one page that track one name hear each
--| other's requests.
--|
--|     subscriptions model =
--|         Http.track "upload" GotProgress
pub track : String, (Progress → msg) → Sub msg
track name tag = Sub.on (Track name) (listening name _) tag


-- ---- Tracked commands (§9.8.19) ---------------------------------------------

-- A `track` subscription's key: its name.
type Key
    = Track String


-- Live tracker listeners keep their real Progress callback type. The table
-- is allocated with its first listener, and an empty group leaves it.
type alias TrackerListener =
    id : Int
    emit : Progress → ⊤


type alias TrackerGroup =
    listeners : Chain.Chain TrackerListener
    next : Js.Ref Int


trackers : Js.Ref (Dict String TrackerGroup)
trackers = Js.ref Dict.empty


listening : String, (Progress → ⊤) → (⊤ → ⊤)
listening name emit =
    group =
        case Dict.get (Js.read trackers) name of
            Just found →
                found
            Nothing →
                made = { listeners = Chain.make ⊤, next = Js.ref 0 }
                Js.write trackers (Dict.insert (Js.read trackers) name made)
                made
    id = Js.read group.next
    Js.write group.next (id + 1)
    link = Chain.append group.listeners { id = id, emit = emit }
    λ⊤ →
        _ = Chain.remove group.listeners link
        if Chain.size group.listeners == 0 then
            case Dict.get (Js.read trackers) name of
                Just current →
                    if Js.same current.listeners group.listeners then
                        Js.write trackers (Dict.remove (Js.read trackers) name)
                Nothing →
                    ⊤


publish : String, Progress → ⊤
publish name value =
    case Dict.get (Js.read trackers) name of
        Nothing →
            ⊤
        Just group →
            publishFrom group (-1) value


-- Re-read live links after each callback: removal skips a listener, and a
-- listener appended during publication is visited in registration order.
publishFrom : TrackerGroup, Int, Progress → ⊤
publishFrom group previous value =
    case nextTracker (Chain.toList group.listeners) previous of
        Nothing →
            ⊤
        Just listener →
            Protocol.call listener.emit value
            publishFrom group listener.id value


nextTracker : List TrackerListener, Int → Maybe TrackerListener
nextTracker listeners previous =
    case listeners of
        [] →
            Nothing
        [ listener, …rest ] →
            if listener.id > previous then Just listener else nextTracker rest previous


-- What a command sends: `request`'s record with a tracker name.
type alias Sent x a =
    method : String
    headers : List Header
    url : String
    body : Body
    expect : Expect x a
    timeout : Maybe Duration
    tracker : Maybe String


-- The request of `send` and `riskySend`. Untracked, the direct form's.
-- Tracked (§9.8.19 (c)): once the subscriptions of the update that made
-- the command are live, with its progress handed to its name's listeners,
-- and behind their last delivery.
commanded : String, Sent x a → Result x a
commanded credentials r =
    case r.tracker of
        Nothing →
            transfer
                problemOf
                credentials
                r.method
                r.headers
                r.url
                r.body
                r.expect
                (timerOf r.timeout)
                Plain

        Just name →
            ready ⊤
            result =
                transfer
                    problemOf
                    credentials
                    r.method
                    r.headers
                    r.url
                    r.body
                    r.expect
                    (timerOf r.timeout)
                    (Tracked (publish name _))
            Task.yieldNow ⊤
            result


-- Wait for the after-render phase of the flush the page has queued, which
-- settles the subscriptions of the update that made the command, then let
-- the work that adds their listeners, queued by that flush, run first.
ready : ⊤ → ⊤
ready ⊤ =
    Task.callback λresume → Browser.onRendered resume
    Task.yieldNow ⊤


-- ---- What a request does (§9.8.12 (b)) ------------------------------------

-- The request's own timeout. Only `request` and `riskyRequest` make an
-- `After`, so a program that only gets and posts ships no timer.
type Timer
    = NoTimer
    | After Int


-- How the body is read: as text at once, or chunk by chunk with the
-- tracker told of each. `request`, `riskyRequest` and `send`'s tracked arm
-- make a `Tracked`: a program that only gets and posts ships no chunked
-- read, nor, under `--release`, one whose commands have no tracker name.
type Reading
    = Plain
    | Tracked (Progress → ⊤)


readingOf : Maybe (Progress → ⊤) → Reading
readingOf tracker =
    case tracker of
        Just f →
            Tracked f

        Nothing →
            Plain


timerOf : Maybe Duration → Timer
timerOf timeout =
    case timeout of
        Just d →
            After (Time.inMillis d)

        Nothing →
            NoTimer


-- Steps 2–4, as a function: `get` and `post` have a standard method and no
-- header, so `get`, with no body, checks nothing and `post` only its body,
-- and a program that only gets and posts ships no method or header check.
type alias Checks =
    String, List Header, Body → Maybe Problem


unchecked : String, List Header, Body → Maybe Problem
unchecked _ _ _ = Nothing


bodyChecks : String, List Header, Body → Maybe Problem
bodyChecks method _ body = bodyProblem method [] body


transfer :
      Checks
    , String
    , String
    , List Header
    , String
    , Body
    , Expect x a
    , Timer
    , Reading
    → Result x a
transfer checks credentials method headers url body (Expect accept read) timer reading =
    read (exchange checks credentials method headers url body accept timer reading)


-- Steps 1–7: the checks, in order, each a test of the value; then the
-- request, sent, and its answer.
exchange :
      Checks
    , String
    , String
    , List Header
    , String
    , Body
    , String
    , Timer
    , Reading
    → Response String
exchange checks credentials method headers url body accept timer reading =
    case resolve url of
        Nothing →
            BadUrl_ url
        Just target →
            if HostURL.username target ≠ "" || HostURL.password target ≠ "" then
                BadUrl_ url
            else
                case checks method headers body of
                    Just problem →
                        BadRequest_ problem
                    Nothing →
                        sent credentials method headers target body accept timer reading


resolve : String → Maybe HostURL.URL
resolve url = HostURL.tryCreate url (HostDocument.baseURI ⊤)


-- Steps 2–4: the first problem of the method, the headers in order, then
-- the body.
problemOf : String, List Header, Body → Maybe Problem
problemOf method headers body =
    upper = String.toUpper method
    if not (isToken method) then
        Just (InvalidMethod method)
    else if isForbiddenMethod upper then
        Just (ForbiddenMethod method)
    else
        case List.filterMap headers headerProblem of
            [ problem, …_ ] →
                Just problem

            [] →
                bodyProblem upper headers body


-- RFC 9110's `token`: one or more `tchar`.
isToken : String → Bool
isToken text = HostRegExp.test (httpPattern "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$") text


isForbiddenMethod : String → Bool
isForbiddenMethod upper = upper == "CONNECT" || upper == "TRACE" || upper == "TRACK"


-- A name that is not a token, or a value that after trimming HTTP
-- whitespace holds NUL, CR or LF or a character `Headers` cannot hold (one
-- above U+00FF), is invalid: `Headers` would throw a `TypeError`. A
-- forbidden request-header name the host would drop.
headerProblem : Header → Maybe Problem
headerProblem (Header name value) =
    if not (isToken name) || not (isHeaderValue value) then
        Just (InvalidHeader name)
    else if isForbiddenHeader (String.toLower name) value then
        Just (ForbiddenHeader name)
    else
        Nothing


isHeaderValue : String → Bool
isHeaderValue value =
    front = HostRegExp.replace (httpPattern "^[\\t\\n\\r ]+") value ""
    trimmed = HostRegExp.replace (httpPattern "[\\t\\n\\r ]+$") front ""
    not (HostRegExp.test (httpPattern "[\\0\\r\\n\\u0100-\\uffff]") trimmed)


httpPattern : String → HostRegExp.RegExp
httpPattern source =
    case HostRegExp.create source "" of
        Ok pattern →
            pattern
        Err _ →
            Protocol.defect "an HTTP validation pattern is invalid"


-- The Fetch standard's forbidden request-header names, compared without
-- case.
isForbiddenHeader : String, String → Bool
isForbiddenHeader lower value =
    List.member forbiddenHeaders lower
        || String.startsWith lower "proxy-"
        || String.startsWith lower "sec-"
        || List.member overrides lower
            && List.any (String.split value ",") λm →
                isForbiddenMethod (String.toUpper (String.trim m))


forbiddenHeaders : List String
forbiddenHeaders =
    [ "accept-charset"
    , "accept-encoding"
    , "access-control-request-headers"
    , "access-control-request-method"
    , "connection"
    , "content-length"
    , "cookie"
    , "cookie2"
    , "date"
    , "dnt"
    , "expect"
    , "host"
    , "keep-alive"
    , "origin"
    , "referer"
    , "set-cookie"
    , "te"
    , "trailer"
    , "transfer-encoding"
    , "upgrade"
    , "via"
    ]


overrides : List String
overrides = [ "x-http-method", "x-http-method-override", "x-method-override" ]


bodyProblem : String, List Header, Body → Maybe Problem
bodyProblem upper headers body =
    case body of
        Empty →
            Nothing

        _ →
            if upper == "GET" || upper == "HEAD" then
                Just (BodyNotAllowed upper)
            else
                case body of
                    Multipart _ →
                        if
                            List.any headers λ(Header name _) →
                                String.toLower name == "content-type"
                        then
                            Just MultipartContentType
                        else
                            Nothing

                    Unprintable issues →
                        Just (UnprintableBody issues)

                    _ →
                        Nothing


-- Native resources never cross Js.Value. Their callbacks keep the request's
-- exact result type all the way through the fiber's resume capability.
type alias Flight =
    controller : AbortController.AbortController
    timer : Js.Ref (Maybe Timers.Timer)
    reason : Js.Ref (Maybe DOMException.DOMException)


sent : String, String, List Header, HostURL.URL, Body, String, Timer, Reading → Response String
sent credentials method headers target body accept timer reading =
    flight =
        { controller = AbortController.create ⊤, timer = Js.ref Nothing, reason = Js.ref Nothing }
    init =
        Fetch.init method (headersOf headers body accept) (payload body)
            (AbortController.signal flight.controller)
            credentials
    case timer of
        After ms →
            if ms ≤ 0 then
                Timeout_
            else
                start flight ms
                answer flight (HostURL.href target) init body reading
        NoTimer →
            answer flight (HostURL.href target) init body reading


headersOf : List Header, Body, String → Headers.Headers
headersOf headers body accept =
    all = Headers.create ⊤
    List.foldl headers ⊤ λ(Header name value) _ → Headers.append all name value
    case body of
        Text mime _ →
            defaultHeader all "content-type" mime
        _ →
            ⊤
    if accept ≠ "" then defaultHeader all "accept" accept
    all


defaultHeader : Headers.Headers, String, String → ⊤
defaultHeader all name value = if not (Headers.has all name) then Headers.set all name value


payload : Body → Maybe Fetch.Body
payload body =
    case body of
        Empty →
            Nothing
        Text _ text →
            Just (Fetch.textBody text)
        Multipart parts →
            form = FormData.create ⊤
            List.foldl parts ⊤ λ(StringPart name value) _ → FormData.append form name value
            Just (Fetch.formBody form)
        Unprintable _ →
            Nothing


size : Body → Int
size body =
    case body of
        Empty →
            0
        Text _ text →
            utf8 text
        Multipart parts →
            List.foldl parts 0 λ(StringPart name value) n → n + utf8 name + utf8 value
        Unprintable _ →
            0


utf8 : String → Int
utf8 text = Uint8Array.byteLength (TextEncoder.encode (TextEncoder.create ⊤) text)


start : Flight, Int → ⊤
start flight ms =
    reason = DOMException.create "The request timed out." "TimeoutError"
    Js.write flight.reason (Just reason)
    timer = Timers.start (λ⊤ → AbortController.abortWith flight.controller reason) ms
    Js.write flight.timer (Just timer)


settled : Flight → ⊤
settled flight =
    case Js.read flight.timer of
        Nothing →
            ⊤
        Just timer →
            Timers.clear timer


type Step a
    = Got a
    | Failed Failure
    | Defect Rejection.Rejection


type Failure
    = TimedOut
    | Unreachable


failed : Failure → Response String
failed failure =
    case failure of
        TimedOut →
            Timeout_
        Unreachable →
            NetworkError_


answer : Flight, String, Fetch.Init, Body, Reading → Response String
answer flight href init body reading =
    case reading of
        Tracked f →
            f (Sending { sent = 0, size = size body })
        Plain →
            ⊤
    case wait flight λ⊤ → Fetch.fetch href init of
        Got response →
            case reading of
                Plain →
                    case wait flight λ⊤ → HostResponse.text response of
                        Got text →
                            settled flight
                            received response text
                        Failed failure →
                            failed failure
                        Defect error →
                            Rejection.raise error
                Tracked f →
                    tracked flight response (size body) f
        Failed failure →
            failed failure
        Defect error →
            Rejection.raise error


tracked : Flight, HostResponse.Response, Int, (Progress → ⊤) → Response String
tracked flight response bytes f =
    f (Sending { sent = bytes, size = bytes })
    length =
        String.toInt
            (Maybe.withDefault (Headers.get (HostResponse.headers response) "content-length") "")
    f (Receiving { received = 0, size = length })
    case HostResponse.reader response of
        Nothing →
            settled flight
            received response ""
        Just reader →
            decoder = TextDecoder.create ⊤
            case chunks flight reader decoder f length 0 "" of
                Ok text →
                    settled flight
                    received response text
                Err failure →
                    failed failure


chunks :
      Flight
    , Reader.ReadableStreamDefaultReader
    , TextDecoder.TextDecoder
    , (Progress → ⊤)
    , Maybe Int
    , Int
    , String
    → Result Failure String
chunks flight reader decoder f length count text =
    case wait flight λ⊤ → Reader.read reader of
        Got chunk →
            if ReadResult.done chunk then
                Ok (text ++ TextDecoder.finish decoder)
            else
                case ReadResult.value chunk of
                    Nothing →
                        Protocol.defect "a response stream returned no byte chunk"
                    Just value →
                        n = count + Uint8Array.byteLength value
                        more = text ++ TextDecoder.decodeMore decoder value
                        f (Receiving { received = n, size = length })
                        chunks flight reader decoder f length n more
        Failed failure →
            Err failure
        Defect error →
            Rejection.raise error


wait : Flight, sync (⊤ → Promise.Promise a) → Step a
wait flight promise = Task.callback λresume →
    Promise.observe (promise ⊤) (λvalue → Task.resume resume (Got value)) λerror →
        rejected flight resume error
    λ⊤ →
        settled flight
        AbortController.abort flight.controller


-- A request's own abort takes precedence over the rejection's class. Its
-- timeout wakes the waiter; fiber cancellation wakes nobody. Only an exact
-- TypeError outside that abort is a documented network failure.
rejected : Flight, Resume (Step a), Rejection.Rejection → ⊤
rejected flight resume error =
    signal = AbortController.signal flight.controller
    if AbortSignal.aborted signal then
        case Js.read flight.reason of
            Just reason →
                if AbortSignal.reasonIs signal reason then Task.resume resume (Failed TimedOut)
            Nothing →
                ⊤
    else
        settled flight
        if Rejection.isTypeError error then
            Task.resume resume (Failed Unreachable)
        else
            Task.resume resume (Defect error)


received : HostResponse.Response, String → Response String
received response text =
    metadata =
        { url = HostResponse.url response
        , statusCode = HostResponse.status response
        , statusText = HostResponse.statusText response
        , headers = headersFrom (HostResponse.headers response)
        }
    if HostResponse.ok response then GoodStatus_ metadata text else BadStatus_ metadata text


headersFrom : Headers.Headers → Dict String String
headersFrom headers = List.foldl (Headers.entries headers) Dict.empty λ( name, value ) all →
    Dict.update all (String.toLower name) λold → Just (joined old value)


joined : Maybe String, String → String
joined old value =
    case old of
        Just before →
            "${before}, ${value}"
        Nothing →
            value


-- Each failure is its `Error`; a 2xx answer is its body.
answered : Response String → Result Error String
answered response =
    case response of
        BadUrl_ url →
            Err (BadUrl url)

        BadRequest_ problem →
            Err (BadRequest problem)

        Timeout_ →
            Err Timeout

        NetworkError_ →
            Err NetworkError

        BadStatus_ metadata _ →
            Err (BadStatus metadata.statusCode)

        GoodStatus_ _ body →
            Ok body
