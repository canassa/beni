--! The slot and mount half of the browser platform's runtime, the holes,
--! attribute writes and markup primitives of a template, its events, and its
--! keyed and positional lists and its class and style lists, written in beni
--! over core's `Js` (research 47; `plans/runtime-in-beni.md`, steps 1–6).
--! Each declaration is the hand-written JavaScript function of the same
--! name it replaced, statement for statement where beni allows it. It is
--! this platform's runtime module (`boundary.md` §9.2, *A runtime module*):
--! its `pub` values stand in for the markup runtime's exports of their
--! names (`runtime.js` holds nothing since `safeUrl` moved, step 6), and
--! the module is compiled with the program — so a release build specialises
--! these functions to the page (`backend.md` §9), which copied JavaScript
--! never allowed.
--!
--! Where beni has no counterpart the port says so: a `for` loop is a tail
--! call. A `let` the JavaScript assigns is a `Js.Ref`, which the compiler
--! writes as that `let` (`backend.md` §4, *A `Js.Ref` that does not escape
--! is a `let`*); which is why `mount`'s closures hold what `send` and
--! `queue` were: a cell passed to a helper would escape. A loop whose locals
--! the JavaScript goes on using after it is a loop called once whose value
--! is bound — a name, or a tuple of names when it leaves several — which a
--! release build writes where the call is (`backend.md` §9, *A function
--! called once is written where it is called*).

import Browser.Host.Document as HostDocument
import Browser.Host.Element as HostElement
import Browser.Host.Event as HostEvent
import Browser.Host.EventTarget as HostEventTarget
import Browser.Host.Events as HostEvents
import Browser.Host.Node as HostNode
import Browser.Host.Rejection as HostRejection
import Browser.Host.Timers as Timers
import Html.Runtime as Runtime
import Js
import Js.Any as Any
import Js.Chain as Chain
import Js.Protocol as Protocol
import Rt.Rows as Rows
import Rt.Slots as Slots
import Task


type alias V =
    Js.Value


-- ---- The supplied protocol (`boundary.md` §9.4.6, interface 1.30) ---------
--
-- The lowering supplies these three values, once per build, in this
-- module's own unit: the private record that opens a block's kind and
-- payload, and the two markup primitives, whose kinds are hoisted beside
-- them. Slots, rows and scheduling are this module's own (`Rt.Slots`,
-- `Rt.Rows`), handed the record.

pub foreign pure protocol :
    { none : Runtime.Context
    , unit :
        (aliased escaped Runtime.Block, aliased escaped Runtime.Context → fresh Runtime.Instance)
    , patch :
        (aliased Runtime.Instance
         , aliased escaped Runtime.Block
         , aliased escaped Runtime.Context
         → unknown Runtime.Instance
        )
    , again : (borrowed Runtime.Instance → ⊤)
    , live : (borrowed Runtime.Instance → Bool)
    , eventPayload :
        (borrowed HostNode.Node, escaped HostEvent.Event, String, String → unknown Runtime.Payload)
    , nodeContext : (aliased HostNode.Node → Runtime.Context)
    , contextPresent : (unused Runtime.Context → Bool)
    , contextParent : (aliased Runtime.Context → Runtime.Context)
    , contextApply : (borrowed Runtime.Context, escaped Runtime.Payload → unknown Runtime.Payload)
    , sendRoot : (borrowed HostNode.Node, escaped Runtime.Payload → ⊤)
    , controls : (aliased HostNode.Node → Js.Opt Runtime.Control)
    , setControls : (borrowed HostNode.Node, escaped Runtime.Control → ⊤)
    , hasRoot : (borrowed HostNode.Node → Bool)
    , hasHandler : (borrowed HostNode.Node, String → Bool)
    , handlerFlags : (borrowed HostNode.Node, String → Int)
    , first : (aliased Runtime.Instance → HostNode.Node)
    , last : (aliased Runtime.Instance → HostNode.Node)
    , put : (borrowed HostNode.Node, borrowed Runtime.Instance, borrowed Js.Opt HostNode.Node → ⊤)
    , drop : (borrowed Runtime.Instance → ⊤)
    , swap : (borrowed Runtime.Instance, borrowed Runtime.Instance → ⊤)
    , parentOf : (aliased Runtime.Slot → HostNode.Node)
    , childMaybe : (borrowed Runtime.Slot, escaped Js.Opt Runtime.Block → ⊤)
    , restate : (borrowed Runtime.Slot → ⊤)
    , turn : (Bool, once (⊤ → ⊤) → ⊤)
    , dead : (unused ⊤ → Bool)
    , stop : (unused ⊤ → ⊤)
    , makeSite :
        (aliased Runtime.SiteProtocol
         , aliased Runtime.Payload
         , aliased Any.Any
         → fresh Runtime.RowSite
        )
    , siteScope : (aliased Runtime.RowSite → Runtime.Payload)
    , setSiteScope :
        (borrowed Runtime.RowSite, escaped Runtime.SiteProtocol, escaped Runtime.Payload → ⊤)
    , siteData : (aliased Runtime.RowSite → Any.Any)
    , siteHead : (aliased Runtime.RowSite, aliased Runtime.Slot → Js.Opt HostNode.Node)
    , siteTail : (aliased Runtime.RowSite, aliased Runtime.Slot → Js.Opt HostNode.Node)
    , siteRestate : (borrowed Runtime.RowSite, borrowed Runtime.Slot, Int → ⊤)
    , siteDispose : (borrowed Runtime.RowSite, borrowed Runtime.Slot → ⊤)
    }


--| `Html.text`: the text, as a text hole shows it.
pub foreign pure text : String → Runtime.Block


--| `Html.map`: the same markup, its messages passed through the mapper.
pub foreign pure map : Runtime.Block, Runtime.Payload → Runtime.Block


--| The empty node, block or row link, as emitted code writes it.
pub empty : Js.Opt a
empty = Js.none ⊤


-- What the record's own helpers call back into.
pub protocolTextNode : String → HostNode.Node
protocolTextNode value = HostDocument.rendererText value


pub protocolSlot : Js.Opt HostNode.Node, Js.Opt HostNode.Node, Runtime.Context → Runtime.Slot
protocolSlot parent marker context = Slots.slot parent marker context


pub protocolFirst : Runtime.Instance → HostNode.Node
protocolFirst value = Slots.first protocol value


pub protocolLast : Runtime.Instance → HostNode.Node
protocolLast value = Slots.last protocol value


pub protocolPut : HostNode.Node, Runtime.Instance, Js.Opt HostNode.Node → ⊤
protocolPut parent value before = Slots.put protocol parent value before


pub protocolDrop : Runtime.Instance → ⊤
protocolDrop value = Slots.drop protocol value


pub protocolSwap : Runtime.Instance, Runtime.Instance → ⊤
protocolSwap old value = Slots.swap protocol old value


pub protocolParentOf : Runtime.Slot → HostNode.Node
protocolParentOf location = Slots.parentOf location


pub protocolChildMaybe : Runtime.Slot, Js.Opt Runtime.Block → ⊤
protocolChildMaybe location block = Slots.childMaybe protocol location block


pub protocolRestate : Runtime.Slot → ⊤
protocolRestate location = Slots.restate protocol location


pub protocolTurn : Bool, sync (⊤ → ⊤) → ⊤
protocolTurn trusted f = turn trusted f


pub protocolDead : ⊤ → Bool
protocolDead ⊤ = Js.read dead


pub protocolStop : ⊤ → ⊤
protocolStop ⊤ = stop ⊤


-- ---- Templates and slots (backend.md §15.3–§15.4) ------------------------

-- `(html)`: a cloner that parses `html` on its first call and clones the
-- result after that (`Rt.Slots.template`); `(html, flags)` for a template
-- with a flag (backend.md §15.3, *Amended 2026-10-15*).
pub template : String → (⊤ → HostNode.Node)
template html = Slots.template html


pub templateOf : String, Int → (⊤ → HostNode.Node)
templateOf html flags = Slots.templateOf html flags


-- `(parent, marker, cx)`: a slot, and the mount context what it holds is
-- mounted with.
pub slot : Js.Opt HostNode.Node, Js.Opt HostNode.Node, Runtime.Context → Runtime.Slot
slot parent marker context = Slots.slot parent marker context


-- `(slot, block)`: an `Html` hole.
pub childHtml : Runtime.Slot, Runtime.Block → ⊤
childHtml location block = Slots.childHtml protocol location block


-- `(slot, block or empty)`: a `Maybe Html` hole; empty empties the slot.
pub childMaybe : Runtime.Slot, Js.Opt Runtime.Block → ⊤
childMaybe location block = Slots.childMaybe protocol location block


-- `(slot, list)`: a `List Html` hole, its blocks matched by position.
pub childList : Runtime.Slot, List Runtime.Block → ⊤
childList location blocks = Slots.childList protocol location blocks


-- `(parent, marker, value)`: a text hole's node, inserted before the marker
-- (or last, for none). The producer hands it a `String`.
pub insertText : HostNode.Node, Js.Opt HostNode.Node, String → HostNode.Node
insertText parent marker value = Slots.insertText parent marker value


-- `(slot)`: what the slot shows patched again where it must be, though a
-- render skipped it (`Rt.Slots.restate`).
pub restate : Runtime.Slot → ⊤
restate location = Slots.restate protocol location


-- ---- Lists and conditionals (backend.md §15.5; `Rt.Rows`) ------------------

pub forKeyed :
      Runtime.Slot
    , List item
    , (item → key)
    , Runtime.RowRecipe item key
    , Js.Opt Any.Any
    , Runtime.SiteProtocol
    , Runtime.Payload
    → ⊤
forKeyed location items keyOf recipe inputs callbacks scope =
    Rows.forKeyed protocol location items keyOf recipe inputs callbacks scope


pub forPosition :
      Runtime.Slot
    , List item
    , Runtime.RowRecipe item ⊤
    , Js.Opt Any.Any
    , Runtime.SiteProtocol
    , Runtime.Payload
    → ⊤
forPosition location items recipe inputs callbacks scope =
    Rows.forPosition protocol location items recipe inputs callbacks scope


pub show :
      Runtime.Slot
    , key
    , Runtime.Block
    , Js.Opt String
    , Runtime.SiteProtocol
    , Runtime.Payload
    → ⊤
show location key block identityTag callbacks scope =
    Rows.show protocol location key block identityTag callbacks scope


pub hide : Runtime.Slot, Js.Opt Runtime.Block → ⊤
hide location fallback = Rows.hide protocol location fallback


-- A site's callbacks (`Runtime.SiteProtocol`), each called with the site's
-- current recipe as its scope. `rows…` take the key's identity; a list by
-- position has the key `⊤`, so `position…` need none.
pub rowsHead : Runtime.RowRecipe item key, Any.Any, Runtime.Slot → Js.Opt HostNode.Node
rowsHead recipe data location = Rows.head protocol recipe data location


pub rowsTail : Runtime.RowRecipe item key, Any.Any, Runtime.Slot → Js.Opt HostNode.Node
rowsTail recipe data location = Rows.tail protocol recipe data location


pub rowsRestate : Runtime.RowRecipe item key, Any.Any, Runtime.Slot, Int → ⊤
rowsRestate recipe data location stamp = Rows.restate protocol recipe data location stamp


pub rowsDispose : Runtime.RowRecipe item key, Any.Any, Runtime.Slot → ⊤
rowsDispose recipe data location = Rows.dispose protocol recipe data location


pub positionHead : Runtime.RowRecipe item ⊤, Any.Any, Runtime.Slot → Js.Opt HostNode.Node
positionHead recipe data location = Rows.head protocol recipe data location


pub positionTail : Runtime.RowRecipe item ⊤, Any.Any, Runtime.Slot → Js.Opt HostNode.Node
positionTail recipe data location = Rows.tail protocol recipe data location


pub positionRestate : Runtime.RowRecipe item ⊤, Any.Any, Runtime.Slot, Int → ⊤
positionRestate recipe data location stamp = Rows.restate protocol recipe data location stamp


pub positionDispose : Runtime.RowRecipe item ⊤, Any.Any, Runtime.Slot → ⊤
positionDispose recipe data location = Rows.dispose protocol recipe data location


-- ---- The program and its render loop -------------------------------------

-- The module's `let`s: the programs with a render queued, whether a flush
-- is, and the after-render phase a hosted program sets.
queued : Js.Ref (Chain.Chain (⊤ → ⊤))
queued = Js.ref (Chain.make ⊤)


scheduled : Js.Ref Bool
scheduled = Js.ref False


phase : Js.Ref (Maybe (⊤ → ⊤))
phase = Js.ref Nothing


-- A turn runs (`backend.md` §15.11, *A render at the end of a turn*): an
-- event the browser dispatched, or a drain of core's scheduler, is being
-- handled with no flush and no other turn beneath it. A flush a message
-- queues meanwhile runs when the turn ends, not on a microtask of its own.
turning : Js.Ref Bool
turning = Js.ref False


-- A flush runs: an event the browser dispatches inside one — the `focus`
-- after-render work causes — is no turn of its own.
flushing : Js.Ref Bool
flushing = Js.ref False


-- Run `f` as a turn when `trusted` holds and nothing beneath it is a turn
-- or a flush; otherwise just run it. A turn's flush runs when `f` returns,
-- where the microtask it replaces would have run. A turn is a guard like
-- `run`'s: however `f` ends the turn is over, and a throw no guard inside
-- it saw — one out of this runtime itself — stops the page rather than
-- leave it never rendering again.
turn : Bool, sync (⊤ → ⊤) → ⊤
turn trusted f =
    if trusted && not (Js.read turning || Js.read flushing) then
        ok = Js.ref False
        Js.write turning True
        Js.finally
            (λ⊤ →
                f ⊤
                Js.write ok True
            )
            λ⊤ →
                Js.write turning False
                if Js.read ok then ⊤ else stop ⊤
        if Js.read scheduled then flush ⊤
    else
        f ⊤


-- ---- A defect stops the page (`boundary.md` §9.8.10 (c)) -----------------
--
-- A throw out of a program's own code — a handler, `update`, a render,
-- after-render work, `init` — stops every program of the page: `dead` is
-- set, and from then on no listener calls a handler, no message is applied
-- and nothing renders. Each entry point is guarded by a `Js.finally` whose
-- body notes that it completed and whose cleanup calls `stop` when it did
-- not; the throw goes on to the host, which reports it. A development
-- build also shows a crash screen; a release build has no code for one.
dead : Js.Ref Bool
dead = Js.ref False


-- How long cleanup that waits may take once the page has stopped, in
-- milliseconds (`boundary.md` §9.8.14 (f), choice 3): what is still waiting
-- then is cut short.
deadline : Int
deadline = 1000


stop : ⊤ → ⊤
stop ⊤ =
    -- Once: two guards may see one throw, an inner one and the one
    -- around it. Every fiber of every program is cancelled and its cleanup
    -- run (`boundary.md` §9.8.14): core closes every root scope, whoever
    -- opened it, giving cleanup that waits `deadline` ms, and tells
    -- `stopped` how many it cut short; a second call does nothing.
    -- `shutdown` only stops the runtime here and runs nothing, so the throw
    -- in flight stays the one the host reports. In a build that makes no
    -- fiber and queues no `soon` work it is nothing at all, so a release
    -- build's `stop` is only the write, as it was before the teardown.
    if Js.development ⊤ then
        if Js.read dead then ⊤ else crashScreen ⊤
    -- Only a hosted mount runs fibers, and one sets the after-render
    -- `phase` when it mounts: a page of `Browser.program`s never calls
    -- `shutdown`, and its release build knows it.
    case Js.read phase of
        Nothing →
            ⊤
        Just _ →
            Task.shutdown deadline stopped
    Js.write dead True


-- Every fiber has ended. Cleanups the deadline cut short are a line of the
-- log in both builds and of the crash screen in development; the screen
-- stops listening for throws.
stopped : Int → ⊤
stopped cut =
    line = "Cleanups cut short while stopping:"

    if cut == 0 then
        ⊤
    else
        Js.to (Js.call (Js.global "console") "warn" [ Js.from line, Js.from cut ])

    if Js.development ⊤ then
        if cut == 0 then
            ⊤
        else
            case Js.read screenLine of
                Nothing →
                    ⊤
                Just append →
                    Protocol.call append ("\n\n" ++ line ++ " " ++ String.fromInt cut)

        case Js.read screenReport of
            Nothing →
                ⊤
            Just cancel →
                Protocol.call cancel ⊤
                Js.write screenReport Nothing


-- The crash screen retains typed closed jobs and a native listener remover.
screenLine : Js.Ref (Maybe (String → ⊤))
screenLine = Js.ref Nothing


screenReport : Js.Ref (Maybe (⊤ → ⊤))
screenReport = Js.ref Nothing


crashScreen : ⊤ → ⊤
crashScreen ⊤ =
    screen = HostDocument.div ⊤
    native = HostElement.toNode screen
    HostElement.styleText screen
        "position:fixed;inset:0;z-index:2147483647;overflow:auto;margin:0;padding:24px;background:#fff;color:#a00;font:14px/1.5 monospace;white-space:pre-wrap"
    HostNode.setTextContent native
        "This program has stopped.\n\nSomething it ran threw an exception, so its state can no longer be trusted and nothing more of it runs. The exception is below, and in the console with its stack.\n\n"
    case HostDocument.body ⊤ of
        Nothing →
            Protocol.defect "the page has no body for its crash screen"
        Just body →
            case HostNode.append (HostElement.toNode body) native of
                Ok ⊤ →
                    ⊤
                Err _ →
                    Protocol.defect "cannot append the crash screen to the page"

    add =
        λmore →
            shown = Maybe.withDefault (HostNode.textContent native) ""
            HostNode.setTextContent native (shown ++ more)
    seen = Js.ref 0
    cleanup = Task.cleansUp ⊤
    remove = Js.ref λ⊤ → ⊤
    report =
        λevent →
            if cleanup then ⊤ else Protocol.call (Js.read remove) ⊤
            message =
                case HostEvent.error event of
                    Nothing →
                        HostEvent.message event
                    Just reason →
                        HostRejection.display reason
            n = Js.read seen
            Js.write seen (n + 1)
            add
                (if n == 0 then
                    message
                 else if n == 1 then
                    "\n\nWhile stopping, cleanup also threw:\n" ++ message
                 else
                    "\n" ++ message
                )
    cancel = HostEvents.listen (HostEventTarget.current ⊤) "error" report
    Js.write remove cancel
    Js.write screenLine (Just add)
    Js.write screenReport (Just cancel)


-- Render every program a message is waiting on, then run the after-render
-- phase. Nothing, once the page has stopped.
pub flush : ⊤ → ⊤
flush ⊤ =
    if Js.read dead then
        ⊤
    else
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                Js.write scheduled False
                Js.write flushing True
                renders = Js.read queued
                Js.write queued (Chain.make ⊤)
                renderJobs renders

                case Js.read phase of
                    Nothing →
                        ⊤
                    Just after →
                        Protocol.call after ⊤
                Js.write ok True
            )
            λ⊤ →
                Js.write flushing False
                if Js.read ok then ⊤ else stop ⊤


-- `(program)`: start every program the array holds, in order.
pub run : V → ⊤
run program =
    ok = Js.ref False
    Js.finally
        (λ⊤ →
            Js.each program λm → startOne m
            Js.write ok True
        )
        λ⊤ → if Js.read ok then ⊤ else stop ⊤


startOne : V → ⊤
startOne m =
    document = Js.global "document"

    root =
        if Js.isNull (Js.get m "n") then
            Js.get document "body"
        else
            Js.call document "getElementById" [ Js.get m "n" ]

    -- A mount node that is missing, or that holds a program already, is
    -- a fault of the page, thrown before that program renders anything.
    if Js.isNull root || not (Js.isUndefined (Js.get root "$$root")) then
        id : String
        id = Js.to (Js.get m "n")
        Js.throw
            (Js.construct (Js.global "Error")
                [ Js.from
                    (if Js.isNull root then
                        "no element has the id \"${id}\" to mount a program at"
                     else if Js.isNull (Js.get m "n") then
                        "the page's body already holds a program"
                     else
                        "the element \"${id}\" already holds a program"
                    )
                ]
            )
    -- The same node, typed, for its slot (a lookup the check above has
    -- just shown to succeed).
    node =
        if Js.isNull (Js.get m "n") then
            HostDocument.rendererBody ⊤
        else
            case HostDocument.byId (Js.to (Js.get m "n")) of
                Just element →
                    HostElement.toNode element

                Nothing →
                    Protocol.defect "the mount node is gone"
    if Js.isUndefined (Js.get m "h") then
        mount (Js.get m "a") root node
    else
        -- Only a hosted program runs fibers: each drain of core's
        -- scheduler is a turn, so what its fibers send renders when it
        -- ends.
        Task.onTurn λf → turn True f
        mount
            (Js.apply (Js.get m "h")
                [ root
                , Js.from flush
                , Js.from λf → setPhase f
                , Js.from stop
                ]
            )
            root
            node


setPhase : (⊤ → ⊤) → Bool
setPhase f =
    Js.write phase (Just f)
    Js.read scheduled


-- Render `view (init ⊤)` after the children of `root`, and mark `root` with
-- the program's `send`. `init` is called here, once per mount
-- (`boundary.md` §9.8.16).
mount : V, V, HostNode.Node → ⊤
mount program root node =
    s = Slots.slot (Js.some node) (Js.none ⊤) protocol.none
    model = Js.ref (Js.call program "init" [])
    waiting = Js.ref False

    render =
        λ⊤ →
            Js.write waiting False
            childHtml s (Js.to (Js.call program "view" [ Js.read model ]))
            renderEnded root

    Js.set
        root
        "$$root"
        (Js.from λmsg →
            -- A stopped page applies no message, from a
            -- handler, a fiber or after-render work alike.
            if Js.read dead then
                ⊤
            else
                if Js.read waiting then
                    ⊤
                else
                    Js.write waiting True
                    _ = Chain.append (Js.read queued) render
                    if Js.read scheduled then
                        ⊤
                    else
                        Js.write scheduled True
                        -- A turn flushes when it ends.
                        if Js.read turning then
                            ⊤
                        else
                            Timers.queueMicrotask microtask
                -- `update` has the program's log context, whoever sends
                -- the message (`boundary.md` §9.8.16 (b), amended
                -- 2026-10-23). The call is written twice, so that a build
                -- in which nothing sets a slot keeps only the second.
                if Task.hasLogContext ⊤ then
                    Js.write
                        model
                        (Task.withoutLogContext λ⊤ → Js.call program "update" [ msg, Js.read model ]
                        )
                else
                    Js.write model (Js.call program "update" [ msg, Js.read model ])
        )
    childHtml s (Js.to (Js.call program "view" [ Js.read model ]))
    renderEnded root


microtask : ⊤ → ⊤
microtask ⊤ =
    if Js.read scheduled then
        flush ⊤


-- ---- Class and style lists ----------------------------------------------

-- A list's elements, by backend.md §4's protocol: the array itself, or a
-- view's or a trie's plain copy (made once per list and cached). Read,
-- never written. `pub` for `runtime.js`'s class and style lists.
pub elements : V → V
elements list =
    if Js.to (Js.call (Js.global "Array") "isArray" [ list ]) then
        list
    else if Js.isUndefined (Js.get list "$plain") then
        Js.call (Js.get list "b") "slice" [ Js.get list "o" ]
    else
        Js.call list "$plain" []


-- ---- Controlled inputs (backend.md §15.3, *Controlled inputs*) ----------
--
-- A control keeps its current model value and checked identity permission
-- in `$$s[prop]`. User events mark controls in the program's `$$e` set;
-- runtime DOM writes mark `touched`. Those marks reconcile at render end.

-- A control's property written with the model's value. A text control the
-- user is editing keeps its selection across a write that changes its
-- value (the owner, 2026-10-25): the offsets and direction read before,
-- set again after, each clamped to the new value's length. A control with
-- no selection (its `selectionStart` is null, or undefined on a `select`)
-- and one without the focus are written and left alone. A `value` the
-- control already shows is not written, and its selection is not touched.
writeProp : V, String, V → ⊤
writeProp el prop v =
    caret = if prop == "value" then Js.get el "selectionStart" else Js.undefined
    if prop == "value" && Js.same (Js.get el prop) v then
        ⊤
    else if
        Js.isNullish caret || not (Js.same (Js.get (Js.global "document") "activeElement") el)
    then
        Js.set el prop v
    else
        caretEnd = Js.get el "selectionEnd"
        direction = Js.get el "selectionDirection"
        Js.set el prop v
        length = Js.get (Js.get el "value") "length"
        math = Js.global "Math"
        _ =
            Js.call el "setSelectionRange"
                [ Js.call math "min" [ caret, length ]
                , Js.call math "min" [ caretEnd, length ]
                , direction
                ]
        ⊤


-- `(el, prop, v, immutable)`: aggregates are always assigned. Only a proven
-- immutable value may compare with the previous value or the live DOM.
-- An unchanged scalar leaves unmarked external edits alone, including
-- when a record row is visited. The first call installs the edit watcher.
pub control : V, String, V, Bool → ⊤
control el prop v immutable =
    previous =
        if Js.isUndefined (Js.get el "$$s") then
            Js.undefined
        else
            Js.get (Js.get el "$$s") prop
    changed = not immutable || Js.isUndefined previous || not (Js.same (Js.get previous "v") v)
    if Js.isUndefined (Js.get el "$$s") then
        Js.set el "$$s" (Js.object [])
        if Js.read watching then ⊤ else watchEdits ⊤
    Js.set (Js.get el "$$s") prop (Js.from { v = v, immutable = immutable })
    if not immutable then
        writeProp el prop v
    else if changed && not (Js.same (Js.get el prop) v) then
        writeProp el prop v


-- The controls a write of the render under way may have changed.
touched : V
touched = Js.array []


-- `(el)`: a controlled element a write of this render's may have changed
-- — another of its attributes, or something inside it.
pub edited : V → ⊤
edited el = Js.to (Js.call touched "push" [ el ])


-- A render of the program mounted at `root` has ended. What runs then is
-- set by the first `control` (`putBackMarked`), so a page with no
-- controlled element ships none of it, as a page with no hosted program
-- ships no after-render phase.
afterRender : Js.Ref V
afterRender = Js.ref Js.null


renderEnded : V → ⊤
renderEnded root =
    if Js.isNullish (Js.read afterRender) then
        ⊤
    else
        Js.to (Js.apply (Js.read afterRender) [ root ])


-- What it and the user marked put back to the model, and the marks
-- cleared.
putBackMarked : V → ⊤
putBackMarked root =
    if Js.to (Js.get touched "length") ≠ 0 then
        Js.each touched λel → putBack el
        Js.set touched "length" (Js.from 0)
    marked = Js.get root "$$e"
    if Js.isUndefined marked then
        ⊤
    else if Js.to (Js.get marked "size") ≠ 0 then
        Js.each marked λel → putBack el
        Js.to (Js.call marked "clear" [])


-- Each property a control keeps written back where the page's differs.
putBack : V → ⊤
putBack el =
    s = Js.get el "$$s"
    if Js.isUndefined s then
        ⊤
    else
        Js.each (Js.call (Js.global "Object") "keys" [ s ]) λk →
            key : String
            key = Js.to k
            entry = Js.get s key
            v = Js.get entry "v"
            if not (Js.to (Js.get entry "immutable")) then
                writeProp el key v
            else if not (Js.same (Js.get el key) v) then
                writeProp el key v


-- `el` and what changes with it with no event of its own, each handed to
-- `f`: every radio named as it is — a superset of its group — and every
-- option of a select.
affected : V, (V → ⊤) → ⊤
affected el f =
    f el
    tag : String
    tag = Js.to (Js.get el "localName")
    if tag == "select" then
        Js.each (Js.get el "options") f
    else if
        tag == "input" && Js.to (Js.get el "type") == "radio" && Js.to (Js.get el "name") ≠ ""
    then
        Js.each (Js.call (Js.global "document") "getElementsByName" [ Js.get el "name" ]) f


-- A control the user may have changed, marked for the program whose mount
-- node is nearest above it.
markEdit : V → ⊤
markEdit el =
    if Js.isUndefined (Js.get el "$$s") then
        ⊤
    else
        root = mountAbove (Js.get el "parentNode")
        if Js.isNull root then
            ⊤
        else if Js.isUndefined (Js.get root "$$e") then
            Js.set root "$$e" (Js.construct (Js.global "Set") [ Js.array [ el ] ])
        else
            Js.to (Js.call (Js.get root "$$e") "add" [ el ])


-- Controls changed after the dispatch of the event that marked them — a
-- `reset` resets them then, a click whose default was prevented puts a
-- box back then — put back in a task after it.
heldBack : V
heldBack = Js.array []


holdEdit : V → ⊤
holdEdit el =
    if Js.to (Js.get heldBack "length") == 0 then
        Js.to (Js.apply (Js.global "setTimeout") [ Js.from λ⊤ → putBackHeld ⊤, Js.from 0 ])
    Js.to (Js.call heldBack "push" [ el ])


putBackHeld : ⊤ → ⊤
putBackHeld ⊤ =
    held_ = Js.call heldBack "splice" [ Js.from 0 ]
    if Js.read dead then ⊤ else Js.each held_ λel → putBack el


watching : Js.Ref Bool
watching = Js.ref False


-- The listeners, in the capture phase so that a control is marked before
-- any handler's message renders, and whether or not it has a handler.
watchEdits : ⊤ → ⊤
watchEdits ⊤ =
    Js.write watching True
    Js.write afterRender (Js.from putBackMarked)
    document = Js.global "document"
    Js.each (Js.array [ Js.from "input", Js.from "change", Js.from "click", Js.from "reset" ]) λname →
        Js.to (Js.call document "addEventListener" [ name, Js.from edits, Js.from True ])
    Js.to
        (Js.call (Js.global "window") "addEventListener"
            [ Js.from "pageshow", Js.from λ_ → pageShown ⊤ ]
        )


-- What an event says may have changed without the model: its control,
-- for `input` and `change`; a checkbox or radio, for `click`, which
-- changed before the click was dispatched and may be put back after it;
-- every control of the form, for `reset`, which resets them after it.
edits : V → ⊤
edits event =
    target = Js.get event "target"
    type_ : String
    type_ = Js.to (Js.get event "type")
    -- (Only an `input` has the `type` `checkbox` or `radio`, and only a
    -- controlled element is marked or put back. The target may be any
    -- element, the document or the window, since any script can dispatch
    -- these names: each branch reads only what is `undefined`, not a
    -- throw, where it is missing — but for `reset`, only a form has the
    -- `elements` iterated.)
    kind : String
    kind = Js.to (Js.get target "type")
    if type_ == "reset" then
        if Js.to (Js.get target "localName") == "form" then
            Js.each (Js.get target "elements") λel → affected el markAndHold
    else if type_ ≠ "click" then
        affected target markEdit
    else if kind == "checkbox" || kind == "radio" then
        affected target markAndHold


markAndHold : V → ⊤
markAndHold el =
    markEdit el
    holdEdit el


-- The page is shown, after the browser restored what its form controls
-- held on a reload or a history step: every control put back.
pageShown : ⊤ → ⊤
pageShown ⊤ =
    if Js.read dead then
        ⊤
    else
        Js.each
            (Js.call (Js.global "document") "querySelectorAll"
                [ Js.from "input,select,textarea,option" ]
            )
            λel → putBack el


-- ---- Attributes (backend.md §15.3, §15.6) --------------------------------

-- `(el, name, value)`: the attribute, or none when `value` is null.
pub attr : V, V, V → ⊤
attr el name value =
    if Js.isNull value then
        Js.to (Js.call el "removeAttribute" [ name ])
    else
        Js.to (Js.call el "setAttribute" [ name, value ])


-- `(el, namespace, name, value)`: an attribute of a namespace (`xlink:href`).
pub attrNS : V, V, V, V → ⊤
attrNS el namespace name value =
    if Js.isNull value then
        Js.to
            (Js.call el "removeAttributeNS"
                [ namespace
                , Js.call name "slice"
                    [ Js.from (Js.to (Js.call name "indexOf" [ Js.from ":" ]) + 1) ]
                ]
            )
    else
        Js.to (Js.call el "setAttributeNS" [ namespace, name, value ])


-- Elm's rule: a URL whose scheme is `javascript:`, or `data:text/html`,
-- with any whitespace or control character where a browser ignores one,
-- runs script, so it is written as nothing. A test of one pattern, which
-- throws nothing: nothing to catch.
pub safeUrl : V → V
safeUrl url =
    if Js.to (Js.call scriptUrl "test" [ url ]) then
        Js.from ""
    else
        url


-- The pattern `safeUrl` refuses, made once.
scriptUrl : V
scriptUrl =
    Js.regExp
        "^[\\s\\x00-\\x20]*(j\\s*a\\s*v\\s*a\\s*s\\s*c\\s*r\\s*i\\s*p\\s*t\\s*:|d\\s*a\\s*t\\s*a\\s*:\\s*t\\s*e\\s*x\\s*t\\s*/\\s*h\\s*t\\s*m\\s*l\\s*[,;])"
        "i"


-- `(el, markup)`: the `raw` escape hatch, markup text written unescaped.
pub rawHtml : V, V → ⊤
rawHtml el markup = Js.set el "innerHTML" markup


-- `(el, list, previous)`: the element has exactly the classes the list
-- names; what only the previous Set of written names held is removed.
pub classes : V, V, V → V
classes el list previous =
    next = classSet list

    old = previous

    if Js.isNull old then
        ⊤
    else
        Js.each old λname →
            if Js.to (Js.call next "has" [ name ]) then
                ⊤
            else
                Js.to (Js.call (Js.get el "classList") "remove" [ name ])
    Js.each next λname →
        if Js.isNull old || not (Js.to (Js.call old "has" [ name ])) then
            Js.to (Js.call (Js.get el "classList") "add" [ name ])
    next


-- The names whose flag is `True`, a name holding whitespace being several.
classSet : V → V
classSet list =
    names = Js.construct (Js.global "Set") []

    Js.each (elements list) λentry →
        if Js.to (Js.get entry "b") then
            Js.each (Js.call (Js.get entry "a") "split" [ spaces ]) λname →
                if Js.same name (Js.from "") then
                    ⊤
                else
                    Js.to (Js.call names "add" [ name ])
    names


-- HTML's whitespace, which separates class names.
spaces : V
spaces = Js.construct (Js.global "RegExp") [ Js.from "[\t\n\u{000C}\r ]+" ]


-- `(el, list, previous)`: each property set to its last value in the list,
-- an empty value removing it; a property only the previous Map of written
-- properties held is removed.
pub styles : V, V, V → V
styles el list previous =
    next = styleMap list

    old = previous

    style = Js.get el "style"

    if Js.isNull old then
        ⊤
    else
        Js.each (Js.call old "keys" []) λname →
            if Js.to (Js.call next "has" [ name ]) then
                ⊤
            else
                Js.to (Js.call style "removeProperty" [ name ])
    Js.each next λentry →
        if Js.isNull old || not (Js.same (Js.call old "get" [ Js.at entry 0 ]) (Js.at entry 1)) then
            Js.to (Js.call style "setProperty" [ Js.at entry 0, Js.at entry 1 ])
    next


-- Each property's last value.
styleMap : V → V
styleMap list =
    values = Js.construct (Js.global "Map") []

    Js.each (elements list) λentry →
        Js.to (Js.call values "set" [ Js.get entry "a", Js.get entry "b" ])
    values


-- ---- Events (backend.md §15.3) --------------------------------------------

-- An event node holds its handler as `$$<name>`, a payload extractor as
-- `$$<name>X` when the handler takes a payload, its declaration's
-- `preventDefault` (1) and `stopPropagation` (2) as `$$<name>F`, and the
-- mount context of the `Html.map`s it is inside as `$$cx`. A program's
-- mount node holds its `send` as `$$root`.

-- The payload of an event whose handler takes the event itself.
pub identity : V → V
identity event = event


-- Send the message `node`'s handler makes of `event` to the program whose
-- mount node is nearest above it, through every `Html.map` it is inside,
-- innermost first. The search starts at the node's parent: a program
-- renders only inside its mount node, so a mount node's own handler is
-- the program's around it. `flags` may be `undefined`, a node that
-- declared neither: its bits are then 0. A stopped page calls no handler,
-- and a handler or an `update` that throws stops it.
fire : V, V, String, String, Int → ⊤
fire node event key payload flags =
    if Js.read dead then
        ⊤
    else
        if Js.bitAnd flags 1 ≠ 0 then
            Js.to (Js.call event "preventDefault" [])

        ok = Js.ref False

        Js.finally
            (λ⊤ →
                x = Js.get node payload

                msg =
                    through
                        (Js.get node "$$cx")
                        (if Js.isUndefined x then
                            Js.get node key
                         else
                            Js.call node key [ Js.apply x [ event ] ]
                        )

                root = mountAbove (Js.get node "parentNode")

                if Js.isNull root then
                    ⊤
                else
                    Js.to (Js.call root "$$root" [ msg ])
                Js.write ok True
            )
            λ⊤ → if Js.read ok then ⊤ else stop ⊤
        if Js.bitAnd flags 2 ≠ 0 then
            Js.to (Js.call event "stopPropagation" [])


-- `msg` through each context from `c` out. (`isNullish`: a node outside
-- every `Html.map` has no `$$cx`, and the outermost context's `up` is null.)
through : V, V → V
through c msg =
    if Js.isNullish c then
        msg
    else
        through (Js.get c "up") (Js.call c "f" [ msg ])


-- The nearest mount node from `n` up, or null.
mountAbove : V → V
mountAbove n =
    if Js.isNull n || not (Js.isUndefined (Js.get n "$$root")) then
        n
    else
        mountAbove (Js.get n "parentNode")


-- The one listener per delegated event name: from the target up, every
-- node with a handler for the event, until one stops it. An event inside
-- a program mounted in another's markup goes on into the outer one, as
-- the DOM's own bubbling does, and each handler's message goes to the
-- program that rendered it. An event the browser dispatched is a turn:
-- every handler of the walk is one render, when the walk ends. While a
-- handler and its extractor run, the event's `currentTarget` is the
-- handler's node, as a listener of the node's own would see it: a pointer
-- event's extractor reads that node's box (`boundary.md` §9.8.20 (d)). The
-- walk's first handler defines it, once, as a getter over `at`, the node
-- whose handler runs, as Solid's walk does. The walk removes it when it
-- ends, however it ends, so a listener after it reads the host's
-- `currentTarget`; a walk that met no handler defined nothing and removes
-- nothing.
--
-- The three property names an event's handler is read by are built once
-- per name, when its listener is registered, and handed to the listener:
-- a name concatenated per event is a new string, which a property lookup
-- must first find in V8's string table.
delegated : String, String, String, V → ⊤
delegated key flagged payload event = turn (Js.to (Js.get event "isTrusted")) λ⊤ →
    at = Js.ref Js.null
    Js.finally (λ⊤ → bubble event key flagged payload at (Js.get event "target")) λ⊤ →
        if Js.isNull (Js.read at) then
            ⊤
        else
            Js.to
                (Js.call (Js.global "Reflect") "deleteProperty" [ event, Js.from "currentTarget" ])


bubble : V, String, String, String, Js.Ref V, V → ⊤
bubble event key flagged payload at node =
    if Js.isNull node then
        ⊤
    else if not (Js.isUndefined (Js.get node key)) && not (Js.to (Js.get node "disabled")) then
        flags = Js.to (Js.get node flagged)
        if Js.isNull (Js.read at) then
            Js.to
                (Js.call (Js.global "Object") "defineProperty"
                    [ event
                    , Js.from "currentTarget"
                    , Js.object [ ( "configurable", True ), ( "get", Js.from λ⊤ → Js.read at ) ]
                    ]
                )
        Js.write at node
        fire node event key payload flags
        if Js.bitAnd flags 2 ≠ 0 then
            ⊤
        else
            bubble event key flagged payload at (Js.get node "parentNode")
    else
        bubble event key flagged payload at (Js.get node "parentNode")


-- The delegated names listened for so far.
registered : V
registered = Js.construct (Js.global "Set") []


-- `(names)`: listen for each delegated event name once.
pub delegate : V → ⊤
delegate names = Js.each names λname →
    if Js.to (Js.call registered "has" [ name ]) then
        ⊤
    else
        _ = Js.call registered "add" [ name ]
        typed : String
        typed = Js.to name
        key = "$$${typed}"
        flagged = "${key}F"
        payload = "${key}X"
        Js.to
            (Js.call (Js.global "document") "addEventListener"
                [ name, Js.from λevent → delegated key flagged payload event ]
            )


-- `(data)`: the program's start data — the delegated names of every
-- module the build wrote.
pub start : V → ⊤
start data =
    if Js.isUndefined (Js.get data "delegate") then
        ⊤
    else
        delegate (Js.get data "delegate")


-- `(el, name, flags)`: a listener of the element's own for an event that
-- is not delegated; it reads the handler the node holds when it fires.
pub listen : V, String, Int → ⊤
listen el name flags =
    key = "$$${name}"
    payload = "${key}X"
    Js.to
        (Js.call el "addEventListener"
            [ Js.from name
            , Js.from λevent →
                if Js.isUndefined (Js.get el key) then
                    ⊤
                else
                    turn (Js.to (Js.get event "isTrusted")) λ⊤ → fire el event key payload flags
            ]
        )


-- ---- `--fuzz` (browser-direct.md §8.3) ----------------------------------

--| `(x)`: `x`, having made sure the page has `globalThis.__beniFuzzSend`,
--| the page fuzzer's way to send a message value to a mount node: through
--| the same guard an event's handler is called inside (`fire`), so a throw
--| in `update` stops the page as one from a click does, never a bare
--| `$$root` call. Only a `--fuzz` build's markup calls it, where a root is
--| evaluated; every other build ships none of it.
pub fuzzInstall : V → V
fuzzInstall x =
    if Js.isUndefined (Js.get (Js.global "globalThis") "__beniFuzzSend") then
        Js.set (Js.global "globalThis") "__beniFuzzSend" (Js.from λnode msg → fuzzSend node msg)
    x


-- A message value sent to the program mounted at `node`, as an untrusted
-- event's handler sends one: guarded, rendered as such a send renders.
fuzzSend : V, V → ⊤
fuzzSend node msg = turn False λ⊤ →
    if Js.read dead then
        ⊤
    else
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                _ = Js.call node "$$root" [ msg ]
                Js.write ok True
            )
            λ⊤ → if Js.read ok then ⊤ else stop ⊤


-- A flush drains the snapshot it took; renders queued while it runs belong
-- to the next flush. Invocation retains the actual callback summary.
renderJobs : Chain.Chain (⊤ → ⊤) → ⊤
renderJobs jobs =
    case Chain.shift jobs of
        Nothing →
            ⊤
        Just render →
            Protocol.call render ⊤
            renderJobs jobs
