--! The browser platform (`docs/design/boundary.md` §9.1; `backend.md`
--! §15.11): a page program, and the `dom` markup lowering that compiles a
--! view into templates the page clones and patches.
--!
--! `Program` is data: the programs a page runs and where each mounts, read
--! only by the platform's runtime. Each renders `view (init ⊤)` into its mount
--! node — `document.body` unless it was given another — and every message
--! a handler sends goes through its own `update`; the page renders the new
--! model once, on one microtask after the messages of a task, writing only
--! the holes whose values changed.

import Browser.Bridge as Bridge
import Browser.Host.Document as Document
import Browser.Host.Element as Element
import Browser.Host.Node as Node
import Html exposing (Html)
import Html.Runtime as Runtime
import Js
import Js.Chain as Chain
import Js.Host as TypedHost
import Js.Protocol as Protocol
import Js.TaskHooks as TaskHooks
import Task
import Url exposing (Url)


--| What `main` is: the programs of a page, and where each mounts.
pub opaque type Program
    = Program (List Mount)


pub type alias Boot =
    hasRoot : Node.Node → Bool
    render : Node.Node → (Runtime.Block → ⊤)
    schedule : (⊤ → ⊤) → ⊤
    dead : ⊤ → Bool
    hosted : ⊤ → ⊤
    flush : ⊤ → ⊤
    phase : (⊤ → ⊤) → Bool
    stop : ⊤ → ⊤


type alias Mount =
    id : Maybe String
    start : Boot, Node.Node → ⊤


type Control
    = RenderOnly


--| A click on a link the page should handle itself (`boundary.md` §9.8.13
--| (c)): `Internal` for one on the page's own protocol, host and port,
--| `External` for any other, with its `href`. What
--| `Browser.Navigation.onUrlRequest` sends.
pub type UrlRequest
    = Internal Url
    | External String


--| A page with a model: `init ⊤` is called when the program mounts and
--| rendered first, and every message a handler sends goes through `update`
--| before the next render. It mounts at `document.body` unless `mountAt`
--| gives it another node. `init` is a function so that each mount starts
--| from a model of its own (`boundary.md` §9.8.16). All three are `sync`:
--| the page calls them while it mounts, handles an event or renders, so
--| none may suspend.
pub program :
      entry { init : sync (⊤ → model)
            , update : sync (msg, model → model)
            , view : sync (model → Html msg)
            }
    → Program
program p = Program [ { id = Nothing, start = λboot node → mount p boot node λ_ _ → ⊤ } ]


--| The same program, mounted at the element whose `id` is the string
--| instead: its view goes after that element's children. The element must
--| be in the page when the program starts, and no other program may mount
--| there.
--|
--|     main : Program
--|     main =
--|         Browser.mountAt (Browser.program app) "cart"
pub mountAt : Program, String → Program
mountAt (Program mounts) id = Program (List.map mounts λm → { m | id = Just id })


--| The same program. Under `browser-inline` this asks the build to write
--| a prerendered page for each route of the list
--| (`docs/design/prerender.md` §7.2); this platform renders every page in
--| the browser, so the program is returned as it is and the list is not
--| read. One source then builds on both platforms.
--|
--|     main : Program
--|     main =
--|         Browser.prerender (Browser.program app) [ "/", "/about" ]
pub prerender : Program, List String → Program
prerender page _ = page


--| Several programs on one page, started in the order of the list, so a
--| program may mount at an element an earlier one rendered. Each receives
--| only the messages of the markup it rendered.
--|
--|     main : Program
--|     main =
--|         Browser.programs [ page, Browser.mountAt cart "cart" ]
pub programs : List Program → Program
programs list = Program (List.concatMap list λ(Program mounts) → mounts)


--| A function that sends a message to a running program: what a command's
--| or a subscription's body is handed. Calling it runs `update` and never
--| waits. `update` has the program's log context, not the caller's.
pub type alias Send msg =
    msg → ⊤


--| A running program, as a `hosted` program's `init`, `update` and
--| `settle` are handed it: where its messages go, and its after-render
--| queue. What an architecture layered on `browser` is built from, with
--| the `Hosted` module; a program never meets one.
pub type alias Host msg =
    TypedHost.Host (Send msg) ((⊤ → ⊤) → ⊤)


--| A program that is handed its `Host`: `init` makes the first model once
--| it is mounted, `update` handles each message, and `settle` runs once
--| per render, just before `view`, on the model about to be rendered, and
--| returns the model that is. All four are `sync`: the page calls them
--| while it handles an event or renders.
pub hosted :
      entry { init : sync (Host msg → model)
            , update : sync (Host msg, msg, model → model)
            , settle : sync (Host msg, model → model)
            , view : sync (model → Html msg)
            }
    → Program
hosted p =
    Program
        [ { id = Nothing
          , start =
              λboot node →
                  boot.hosted ⊤
                  sender = Js.ref Nothing
                  request = Js.ref Nothing
                  app =
                      host
                          p
                          (λmsg → (stored sender) msg)
                          (λcontrol → (stored request) control)
                          boot.flush
                          boot.phase
                          boot.stop
                  mount app boot node λsend render →
                      Js.write sender (Just send)
                      Js.write request (Just render)
          }
        ]


--| Render every program with a message waiting, now, rather than on the
--| flush the page has queued, and run the after-render work of those
--| messages. During a message's `update` or a render it does nothing more
--| than the flush already queued, so no render ever sees a half-handled
--| message.
pub flush : ⊤ → ⊤
flush ⊤ =
    if not (Js.read busy || Js.read dispatching) then
        case Js.read loop of
            Nothing →
                ⊤
            Just flushing →
                Protocol.call flushing ⊤


--| Resume at the start of the next after-render phase, or immediately when
--| no work is queued. The returned job cancels only this wait.
pub onRendered : Task.Resume ⊤ → (⊤ → ⊤)
onRendered resume =
    case Js.read directRendered of
        Nothing →
            loopRendered resume
        Just installed →
            Protocol.call installed resume


loopRendered : Task.Resume ⊤ → (⊤ → ⊤)
loopRendered resume =
    active =
        case Js.read loop of
            Nothing →
                False
            Just _ →
                queued =
                    case Js.read setPhase of
                        Nothing →
                            False
                        Just install →
                            Protocol.call install afterRender
                queued || Chain.size (Js.read later) > 0
    if active then
        pending = Js.read waiters
        link = Chain.append pending resume
        Protocol.call (Js.read nudge) ⊤
        λ⊤ →
            _ = Chain.remove pending link
            ⊤
    else
        Task.resume resume ⊤
        λ⊤ → ⊤


-- ---- The hosted loop (`boundary.md` §9.8; `backend.md` §15.11) -----------
--
-- Everything a hosted program adds to the render loop is here, so a page
-- that mounts none ships none of it (research 40 §8, rule 2): the
-- dispatcher, the after-render phase, `flush`'s guards and the waits of
-- `Dom.rendered`. The runtime hands a hosted mount what it needs by value —
-- its `flush`, and a function that sets the after-render phase and answers
-- whether a flush is queued — and a flush is queued through the mount
-- node's `send`, with `skip`, which renders nothing. Each latch is released
-- in a `Js.finally`, however its work ends; a throw that ends it stops the
-- page, which is the runtime's guard (`boundary.md` §9.8.10 (c)).
-- The runtime's loop, once a hosted program has mounted (null before),
-- what sets its after-render phase, and what queues a flush: the last
-- hosted mount node's `send`, with `skip`.
loop : Js.Ref (Maybe (⊤ → ⊤))
loop = Js.ref Nothing


setPhase : Js.Ref (Maybe ((⊤ → ⊤) → Bool))
setPhase = Js.ref Nothing


nudge : Js.Ref (⊤ → ⊤)
nudge = Js.ref λ⊤ → ⊤


-- A renderer-private message queues a flush without applying update.
skip : Control
skip = RenderOnly


later : Js.Ref (Chain.Chain (⊤ → ⊤))
later = Js.ref (Chain.make ⊤)


waiters : Js.Ref (Chain.Chain (Task.Resume ⊤))
waiters = Js.ref (Chain.make ⊤)


busy : Js.Ref Bool
busy = Js.ref False


dispatching : Js.Ref Bool
dispatching = Js.ref False


-- A nested update retains one closed job with the real message type.
inbox : Chain.Chain (⊤ → ⊤)
inbox = Chain.make ⊤


afterRender : ⊤ → ⊤
afterRender ⊤ =
    resumes = Js.read waiters
    work = Js.read later
    Js.write waiters (Chain.make ⊤)
    Js.write later (Chain.make ⊤)
    Js.write busy True
    Js.finally
        (λ⊤ →
            resumeAll resumes
            runJobs work
        )
        λ⊤ → Js.write busy False


resumeAll : Chain.Chain (Task.Resume ⊤) → ⊤
resumeAll resumes =
    case Chain.shift resumes of
        Nothing →
            ⊤
        Just resume →
            Task.resume resume ⊤
            resumeAll resumes


runJobs : Chain.Chain (⊤ → ⊤) → ⊤
runJobs jobs =
    case Chain.shift jobs of
        Nothing →
            ⊤
        Just work →
            Protocol.call work ⊤
            runJobs jobs


drain : ⊤ → ⊤
drain ⊤ = runJobs inbox


-- A hosted mount, as the runtime reads one: `{ init, update, view }` whose
-- `update` dispatches and whose `view` settles first, the model held here.
-- `send` is the mount node's, which queues the render and its flush before
-- it calls `update` (`backend.md` §15.11). The first `view`, at mount, is of
-- `settle host (init host)`; every later one is in a flush, and settles and
-- renders only when a message was applied since the last — a render `skip`
-- queued shows again what was shown.
host :
      { init : sync (Host msg → model)
      , update : sync (Host msg, msg, model → model)
      , settle : sync (Host msg, model → model)
      , view : sync (model → Html msg)
      }
    , Send msg
    , (Control → ⊤)
    , sync (⊤ → ⊤)
    , sync ((⊤ → ⊤) → Bool)
    , sync (⊤ → ⊤)
    → { init : ⊤ → ⊤, update : msg, ⊤ → ⊤, view : ⊤ → Html msg }
host p send request flushing phase stop =
    Js.write loop (Just flushing)
    TaskHooks.onDefect stop
    Js.write setPhase (Just phase)
    _ = phase afterRender
    Js.write nudge λ⊤ → request skip
    model = Js.ref Nothing
    started = Js.ref False
    dirty = Js.ref False
    shown = Js.ref Nothing
    self = TypedHost.make send λwork →
        _ = Chain.append (Js.read later) work
        request skip
    apply =
        λmsg →
            Js.write dirty True
            Js.write model (Just (p.update self msg (stored model)))
    { init = λ⊤ → ⊤
    , update =
        λmsg _ →
            if Js.read dispatching then
                _ = Chain.append inbox λ⊤ → apply msg
                ⊤
            else
                Js.write dispatching True
                Js.finally
                    (λ⊤ →
                        apply msg
                        drain ⊤
                    )
                    λ⊤ →
                        Chain.clear inbox
                        Js.write dispatching False
    , view =
        λ⊤ →
            if not (Js.read started) then
                Js.write started True
                Js.write model (Just (p.settle self (p.init self)))
                Js.write shown (Just (p.view (stored model)))
                stored shown
            else if not (Js.read dirty) then
                stored shown
            else
                Js.write dirty False
                Js.write busy True
                Js.finally
                    (λ⊤ →
                        Js.write model (Just (p.settle self (stored model)))
                        Js.write shown (Just (p.view (stored model)))
                        stored shown
                    )
                    λ⊤ → Js.write busy False
    }


-- The compiled platform supplies its synchronous after-render point.
directRendered : Js.Ref (Maybe (Task.Resume ⊤ → (⊤ → ⊤)))
directRendered = Js.ref Nothing


pub installRendered : sync (Task.Resume ⊤ → (⊤ → ⊤)) → ⊤
installRendered callback = Js.write directRendered (Just callback)


stored : Js.Ref (Maybe a) → a
stored cell =
    case Js.read cell of
        Just value →
            value
        Nothing →
            Protocol.defect "a browser model was read before initialization"


-- Runtime entry; each lookup happens after the preceding mount has rendered.
pub runMounts : Program, Boot → ⊤
runMounts (Program mounts) boot = List.foldl mounts ⊤ λm _ →
    root =
        case m.id of
            Nothing →
                case Document.body ⊤ of
                    Just element →
                        Element.toNode element
                    Nothing →
                        Protocol.defect "the page has no body to mount a program at"
            Just id →
                case Document.byId id of
                    Just element →
                        Element.toNode element
                    Nothing →
                        Protocol.defect "no element has the id \"${id}\" to mount a program at"
    if boot.hasRoot root then
        case m.id of
            Nothing →
                Protocol.defect "the page's body already holds a program"
            Just id →
                Protocol.defect "the element \"${id}\" already holds a program"
    m.start boot root


mount :
      { init : ⊤ → model, update : msg, model → model, view : model → Html msg }
    , Boot
    , Node.Node
    , (Send msg, (Control → ⊤) → ⊤)
    → ⊤
mount p boot node connect =
    paint = boot.render node
    model = Js.ref (p.init ⊤)
    waiting = Js.ref False
    render =
        λ⊤ →
            Js.write waiting False
            paint (Bridge.block (p.view (Js.read model)))
    request =
        λRenderOnly →
            if not (boot.dead ⊤) && not (Js.read waiting) then
                Js.write waiting True
                boot.schedule render
    send =
        λmsg →
            if not (boot.dead ⊤) then
                request skip
                if TaskHooks.hasLogContext ⊤ then
                    Js.write model (TaskHooks.withoutLogContext λ⊤ → p.update msg (Js.read model))
                else
                    Js.write model (p.update msg (Js.read model))
    connect send request
    Bridge.installRoot node send
    paint (Bridge.block (p.view (Js.read model)))
