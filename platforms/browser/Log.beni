--! A log a shipped program keeps (`docs/design/boundary.md` §9.8.10 (d)):
--! a line on the browser's console at one of three levels. `Debug.log` is
--! for development and a `--release` build refuses it; these are kept by
--! every build, and a call is never dropped, since writing is what it is
--! for.
--!
--! A line is text: a program that logs a value formats it, because
--! `Debug.toString`'s text is not a promise.
--!
--!     _ = Log.warn "saving took ${String.fromInt ms} ms"

import Cmd exposing (Cmd)
import Js


--| `console.info` of the line.
pub info : String → ⊤
info line = Js.to (Js.call (Js.global "console") "info" [ Js.from line ])


--| `console.warn` of the line.
pub warn : String → ⊤
warn line = Js.to (Js.call (Js.global "console") "warn" [ Js.from line ])


--| `console.error` of the line.
pub error : String → ⊤
error line = Js.to (Js.call (Js.global "console") "error" [ Js.from line ])


--| A level of the log: `console.info`, `warn` or `error`.
pub type Level
    = Info
    | Warn
    | Error


--| The command form of the three: the line, written at the level when the
--| command runs. The line is a value, formatted when the command is made,
--| never a function that reads the model later (`docs/design/boundary.md`
--| §9.8.16).
--|
--|     Saved ms →
--|         ( model, Log.write Log.Info "saving took ${String.fromInt ms} ms" )
pub write : Level, String → Cmd msg
write level line = Cmd.perform λ_ →
    case level of
        Info →
            info line

        Warn →
            warn line

        Error →
            error line
