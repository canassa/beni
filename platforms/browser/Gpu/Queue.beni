--! A device's queue (`docs/design/webgpu.md` §6.2, §8.3): writes into
--! buffers and submissions of command buffers. `Gpu.Device.queue` gives it.
--!
--! Each `submit` gives the receipt of the one native submit it issued, a
--! `Submission`; `Gpu.Submission.done` waits for that submission's work.
--! Nothing waits unless asked to.

import Binary
import Gpu.Engine as Engine
import Gpu.Error as Error
import Gpu.Handle as Handle
import Gpu.Make as Make
import Gpu.Memory as Memory
import Gpu.Types as Types
import Js


type alias V =
    Js.Value


--| One `writeBuffer`: the destination offset in bytes, the data, and the
--| part of it to write. As in the native API, `dataOffset` and `size`
--| count the data's elements — bytes for an `ArrayBuffer` or a
--| `DataView`, elements for a typed array — and `Nothing` as the size
--| writes the rest of the data. The bytes written are a multiple of 4.
pub type alias WriteBufferSource =
    Memory.WriteBufferSource


--| All of `data`, at `bufferOffset`.
pub bufferWrite : Int, Binary.Source → WriteBufferSource
bufferWrite bufferOffset data =
    { bufferOffset = bufferOffset, data = data, dataOffset = 0, size = Nothing }


--| The queue's label.
pub label : Handle.Queue → String
label queue = Js.to (Js.get (Js.from queue) "label")


--| Set the queue's label.
pub setLabel : Handle.Queue, String → ⊤
setLabel queue text = Js.set (Js.from queue) "label" (Js.from text)


-- The native device of a queue.
deviceOf : Handle.Queue → V
deviceOf queue = Js.get (Engine.recordOf (Js.from queue)) "native"


--| Write `source` into `buffer`, checked (§6.1; ledger §5). Refused before
--| any native call: a buffer that was destroyed or belongs to another
--| device, data whose storage is detached (`DetachedSource`) or resizable
--| (`ResizableBacking`, #1268), a part that leaves the data (`OutOfRange`)
--| or is not a multiple of 4 bytes (`Misaligned`), an offset outside
--| `GPUSize64`. Then `Validation` for what the device refuses (the
--| buffer's usage, the offset's alignment, the bounds), and
--| `HostOperationRejected BufferWriteSourceRejected` for the source range
--| the host refuses anyway. May suspend.
pub writeBuffer : Handle.Queue, Handle.Buffer, WriteBufferSource → Result Error.Error ⊤
writeBuffer queue buffer write =
    Result.map (Make.checked (Make.writeBuffer (Js.from queue) Js.null buffer write)) λ_ → ⊤


--| Submit `commands`, checked (§6.1, §8.3): one native submit, whose
--| receipt is returned once no scope reported a failure. Right after the
--| submit, in the same host turn, the receipt captures the queue's
--| completion promise, so it covers this submission and the work before
--| it, never a later one. An empty list is a native submit too, with its
--| receipt. Refused before any native call: a command buffer of another
--| device, one not accepted, one submitted before
--| (`CommandBufferSubmitted`) or one named twice
--| (`DuplicateCommandBuffer`). May suspend.
pub submit : Handle.Queue, List Handle.CommandBuffer → Result Error.Error Handle.Submission
submit queue commands =
    Result.map (Make.checked (Make.submit (Js.from queue) Js.null commands)) λreceipt →
        Js.to receipt


--| Wait until every piece of work submitted to the queue so far is done:
--| the native `onSubmittedWorkDone`, captured now, so it also covers work
--| other code submitted before. To wait for one submission, use its
--| receipt (`Gpu.Submission.done`). `DeviceLost` when the device is lost
--| first. May suspend.
pub onSubmittedWorkDone : Handle.Queue → Result Error.Error ⊤
onSubmittedWorkDone queue =
    device = deviceOf queue
    case Engine.loss device of
        Just l →
            Err
                (Error.DeviceLost
                    { loss = l, operation = { operation = "onSubmittedWorkDone", observed = [] } }
                )

        Nothing →
            Engine.awaitPending
                (Engine.pendingOutcome
                    device
                    "onSubmittedWorkDone"
                    (Js.call (Js.from queue) "onSubmittedWorkDone" [])
                    λfulfilled value →
                        if fulfilled then Engine.Expected ⊤ else Engine.Unexpected value
                )


--| Write `data` into a texture, checked (§6.1; ledger §5): the texture
--| must be accepted, alive and of this device, and the data's storage
--| fixed and attached (`ResizableBacking`, `DetachedSource`); the layout,
--| extent and texel blocks are the device's to check (`Validation`). Queue
--| writes need no 256-byte row alignment. May suspend.
pub writeTexture :
      Handle.Queue
    , Types.TexelCopyTextureInfo
    , Binary.Source
    , Types.TexelCopyBufferLayout
    , Types.Extent3D
    → Result Error.Error ⊤
writeTexture queue destination data layout extent =
    Result.map
        (Make.checked
            (Make.writeTexture (Js.from queue) Js.null destination data layout extent)
        )
        λ_ → ⊤


--| Copy an image, a video's current frame or a canvas into a texture,
--| checked (§6.1, §8; ledger §6), converting its colours as `destination`
--| asks (`colorSpace`, `premultipliedAlpha`), with no flip unless `source`
--| asks (`flipY`). Refused before any native call: a destination texture
--| that is not usable on this device, and a source the host's usability
--| check would refuse — `SourceClosed`, `SourceDetached`, `SourceEmpty`,
--| `SourceBroken`, `SourceNotReady` (`Gpu.Error.SourceError`). Then the host
--| decides `SourceNotOriginClean` (a source tainted by another origin),
--| `ExternalImageCopyRangeRejected` (a copy outside the source) and
--| `SourceUnusable`; the destination's usage (`RenderAttachment` and
--| `CopyDst`), format and bounds are the device's to check (`Validation`).
--| May suspend: a video element's frame is the one current when the copy is
--| issued, not when it is checked.
pub copyExternalImageToTexture :
      Handle.Queue
    , Types.CopyExternalImageSourceInfo
    , Types.CopyExternalImageDestInfo
    , Types.Extent3D
    → Result Error.Error ⊤
copyExternalImageToTexture queue source destination extent =
    Result.map
        (Make.checked (Make.copyExternalImage (Js.from queue) Js.null source destination extent))
        λ_ → ⊤
