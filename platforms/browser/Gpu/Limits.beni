--| The class of a limit: the two `min…Alignment` limits are alignments.
pub limitClass : LimitName → LimitClass
limitClass name =
    case name of
        MinUniformBufferOffsetAlignment →
            Alignment

        MinStorageBufferOffsetAlignment →
            Alignment

        _ →
            Maximum


