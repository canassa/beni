--! What a WebGPU operation can fail with (`docs/design/webgpu.md` §5, and
--! the failure ledger `docs/design/research/webgpu-errors.md`). Every
--! failure the standard documents for an operation is a value of these
--! types; anything else — an exception or rejection the ledger does not
--! list, a spoofed error, a returned value outside the pin — is a defect
--! and stops the program, never a value here.
--!
--! What the standard cannot report is not reported: an error scope keeps one
--! representative per scope, a lost device stops reporting ordinary errors,
--! and a fault inside a running shader may go unseen. A success means the
--! checks an operation awaited reported no failure, not that the device
--! stays healthy or that the work has run.

import Binary
import Gpu.Flags as Flags
import Gpu.Limits as Limits
import Gpu.Scalar as Scalar
import Gpu.Types as Types


--| Why getting an adapter or a device failed.
pub type InitError
    = InsecureContext
    | ApiUnavailable
    | AdapterUnavailable
    | AdapterConsumed
    | UnsupportedFeatures (List Types.FeatureName)
    | UnsupportedLimits (List LimitMismatch)
    | FeatureRequestRejected RequestDetail
    | DeviceRequestRejected HostMessage
    | InitializationInput InputError
    | InitializationLost DeviceLoss


--| The message the host gave, as it gave it: for diagnostics, never to
--| match on.
pub type alias HostMessage =
    message : String


--| A device request the host refused for its features.
pub type alias RequestDetail =
    requested : List Types.FeatureName
    message : String


--| One required limit the adapter does not support.
pub type alias LimitMismatch =
    limit : Limits.LimitName
    requested : Scalar.Size64
    supported : Int
    problem : LimitProblem


--| How a required limit misses: above a maximum the adapter supports, below
--| an alignment it supports, or an alignment that is not a power of two.
pub type LimitProblem
    = AboveMaximum
    | BelowAlignment
    | NotPowerOfTwo


--| A failed GPU operation. `ShaderRejected` is invalid WGSL, with the
--| compiler's messages; `BatchFailed` a `Gpu.Batch.run` that failed, with
--| its failure and which of its operations were issued and which were
--| refused (§6.3: a batch is not a transaction).
pub type Error
    = InvalidInput InputError
    | UnsupportedCapability Capability
    | Validation FailureDetail
    | OutOfMemory FailureDetail
    | Internal FailureDetail
    | PipelineValidation PipelineFailure
    | PipelineInternal PipelineFailure
    | DeviceLost DeviceLossReport
    | MapFailed MapError
    | SourceFailed SourceError
    | CanvasFailed CanvasError
    | FormatFeatureRejected FormatFailure
    | HostOperationRejected OperationFailure
    | RelatedFailures FailureSet
    | ShaderRejected ShaderFailure
    | BatchFailed { batch : String, failure : Error, issued : List String, unissued : List String }


--| An input refused before any native call: each names the descriptor
--| member or argument (`path`) it is about. Ranges are in bytes: an
--| `OutOfRange` gives the offset, the size and the bytes available; a
--| `Misaligned` value must be a multiple of `alignment`. `DetachedSource`
--| is a binary source whose storage was detached. `MappingState` is a
--| buffer whose map state forbids the call (a second `map` while one is
--| pending or live, a range of an unmapped buffer); `RangeOverlap` a mapped
--| range that overlaps one taken before; `ReadOnlyMapping` a write to a
--| mapping made for reading; `ResourceExpired` a mapping or a range of an
--| earlier mapping generation. `EncoderLocked` is an encoder command while a
--| pass of it is open; `EncoderFinished` and `PassEnded` a command after
--| `finish` or `end`; `DebugStackEmpty` a pop with no debug group pushed;
--| `CommandBufferSubmitted` and `DuplicateCommandBuffer` a command buffer
--| submitted before or twice in one submit; `ViewKindRequired` a binary view
--| of another kind than the one the call takes. `QueryActive` is an
--| occlusion query begun while one is open, `QueryInactive` one ended while
--| none is or a pass ended while one is open, `QuerySetMissing` one begun in
--| a pass with no occlusion query set, and `QueryReused` a query index begun
--| twice in one pass.
pub type InputError
    = NumericDomain { path : String, domain : Scalar.DomainError }
    | WrongDevice { path : String }
    | ResourceDestroyed { path : String }
    | ResourceExpired { path : String }
    | ResourceRejected { path : String }
    | ResourcePending { path : String }
    | MappedSizeUnaligned { path : String, size : Int }
    | ResizableBacking { path : String }
    | DetachedSource { path : String }
    | Misaligned { path : String, value : Int, alignment : Int }
    | OutOfRange { path : String, offset : Int, size : Int, available : Int }
    | InvalidValue { path : String, value : Float, minimum : Float, maximum : Float }
    | InvalidMapMode { path : String, bits : Int }
    | MissingBufferUsage { path : String, usage : Flags.BufferUsage }
    | MappingState { path : String, state : Types.BufferMapState }
    | RangeOverlap { path : String, offset : Int, size : Int }
    | ReadOnlyMapping { path : String }
    | EncoderLocked { path : String }
    | EncoderFinished { path : String }
    | PassEnded { path : String }
    | DebugStackEmpty { path : String }
    | CommandBufferSubmitted { path : String }
    | DuplicateCommandBuffer { path : String }
    | ViewKindRequired { path : String, kind : Binary.ViewKind }
    | QueryActive { path : String }
    | QueryInactive { path : String }
    | QuerySetMissing { path : String }
    | QueryReused { path : String, index : Int }
    | SessionState SessionState
    | SessionStopped


--| Why a device refuses a call for its diagnostic session (§6.4).
--| `DeviceLeased`: a diagnostic session holds the device's lease, and the
--| call does not present it — an ordinary call, `Gpu.Diagnostics.run` on
--| a leased device, or a session whose nested session is open.
--| `SessionEnded`: the session's lease ended.
pub type SessionState
    = DeviceLeased
    | SessionEnded


--| An error a native error scope or the device's uncaptured-error event
--| reported: its class, and the host's message, for diagnostics only.
pub type GpuError
    = ValidationError HostMessage
    | OutOfMemoryError HostMessage
    | InternalError HostMessage


--| Why `Gpu.Diagnostics.popErrorScope` popped nothing: the session pushed
--| no scope that is still open (`ScopeUnderflow`), or the session cannot
--| be used (`SessionRefused`).
pub type DiagnosticError
    = ScopeUnderflow
    | SessionRefused InputError


--| What a device reports beside its operations' results (§8): an error
--| that escaped every error scope (`Uncaptured`), which is a defect of
--| the engine and stops the program that made the device once listeners
--| saw it, and the device's loss (`Lost`), sent once, and to a listener
--| that starts after the loss at once.
pub type DeviceEvent
    = Uncaptured GpuError
    | Lost DeviceLoss


--| A capability the device or the host does not have.
pub type Capability
    = MissingFeature Types.FeatureName
    | MissingHostMember String


--| Where a failure was observed.
pub type Stage
    = Content
    | DeviceValidation
    | Submission
    | Mapping
    | PipelineCreation


--| A failure an error scope reported: the device's runtime identity (not
--| the native object), the checked operation or segment, the stage, the
--| labels of the resources involved, and the host's message. A scope
--| names its operation, not the first command that failed.
pub type alias FailureDetail =
    device : Int
    operation : String
    stage : Stage
    labels : List String
    message : String


--| A pipeline the host refused when it created it asynchronously, with the
--| entry points it was asked for (none when the descriptor left them to the
--| host).
pub type alias PipelineFailure =
    operation : String
    message : String
    entryPoints : List String


--| A shader module the device refused: the scope's failure, and every
--| message the compiler gave for it.
pub type alias ShaderFailure =
    failure : FailureDetail
    messages : List CompilationMessage


--| One message of the WGSL compiler, with every native field: its kind,
--| text, line and position (from 1, 0 when it has none), and its offset
--| and length in the source, in UTF-16 code units.
pub type alias CompilationMessage =
    message : String
    type_ : Types.CompilationMessageType
    lineNum : Int
    linePos : Int
    offset : Int
    length : Int


--| What the compiler said of a module.
pub type alias CompilationInfo =
    messages : List CompilationMessage


--| A device's loss: its reason and the host's message.
pub type alias DeviceLoss =
    reason : LossReason
    message : String


--| Why a device was lost: `Destroyed` by `destroy`, or `UnknownLoss`, the
--| standard's reason `"unknown"`.
pub type LossReason
    = UnknownLoss
    | Destroyed


--| A loss observed while an operation was checked, with what else that
--| operation observed.
pub type alias DeviceLossReport =
    loss : DeviceLoss
    operation : OperationReport


--| What a checked operation observed: one representative per scope that
--| reported, never a complete list of every error.
pub type alias OperationReport =
    operation : String
    observed : List Observation


--| One observed failure.
pub type Observation
    = ObservedValidation FailureDetail
    | ObservedOutOfMemory FailureDetail
    | ObservedInternal FailureDetail
    | ObservedPipelineValidation PipelineFailure
    | ObservedPipelineInternal PipelineFailure
    | ObservedMapFailed MapError
    | ObservedHostRejection OperationFailure
    | ObservedRefusal InputError
    | ObservedUnsupported Capability


--| Several failures of one operation: never empty, and each a leaf.
pub type alias FailureSet =
    first : Observation
    rest : List Observation


--| Why mapping a buffer failed.
pub type MapError
    = MapRejected HostMessage
    | MapAborted
    | MappedAllocationFailed { bytes : Int, message : String }
    | MappedRangeRejected HostMessage


--| Why an image or video source could not be used (ledger §6). The host
--| decides `SourceNotOriginClean` (its `SecurityError`), `SourceUnusable`
--| (its `InvalidStateError`) and `ExternalImageCopyRangeRejected` (a copy
--| outside the source, its `OperationError`). The others are refused before
--| the native call, from the state the host's own usability check reads
--| (HTML, *check the usability of the image argument*): `SourceClosed` a
--| closed bitmap or video frame, `SourceDetached` image data whose pixels
--| were detached, `SourceEmpty` a canvas with no pixels (a width or a height
--| of 0) or an image element with no source, `SourceBroken` an image element
--| whose image failed to load or decode, and `SourceNotReady` an image
--| element still loading or a video element with no current frame.
pub type SourceError
    = SourceNotOriginClean
    | SourceUnusable HostMessage
    | ExternalImageCopyRangeRejected HostMessage
    | SourceClosed
    | SourceDetached
    | SourceEmpty
    | SourceBroken
    | SourceNotReady


--| Why a canvas could not be used.
pub type CanvasError
    = CanvasNotFound String
    | WrongElementKind String
    | CanvasContextUnavailable
    | CanvasUnconfigured
    | CanvasConfigurationRejected HostMessage


--| A texture format a feature gates, refused by the host. The host does not
--| say which format it refused: `format` and `required` are the first
--| feature-gated format the call named, and `candidates` every one of them,
--| that one first.
pub type alias FormatFailure =
    format : Types.TextureFormat
    required : Types.FeatureName
    candidates : List (Types.TextureFormat × Types.FeatureName)
    message : String


--| A documented host rejection of one operation.
pub type OperationFailure
    = BufferWriteSourceRejected HostMessage
    | ImmediateWriteRejected HostMessage


--| A scalar's domain error, at the descriptor member or argument `path`:
--| what a `Gpu.Scalar` constructor's `Err` becomes in an operation's input
--| error.
--|
--|     Result.mapError (Gpu.Scalar.u32 n) (Gpu.Error.atPath "size.width" _)
pub atPath : String, Scalar.DomainError → InputError
atPath path domain = NumericDomain { path = path, domain = domain }
