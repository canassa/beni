--! Checked WebGPU host boundary. No raw conversion/adoption function is public.
--! Promise reactions only publish data; decoding runs in an owning supervisor
--! fiber so an unknown rejection still defects after its caller cancels.

import Binary
import Browser.Source as Source
import Gpu.Error as Error
import Gpu.Flags as Flags
import Gpu.Handle as Handle
import Gpu.Scalar as Scalar
import Gpu.Types as Types
import Js
import List
import Task


type alias V =
    Js.Value


type HostOutcome
    = Resolved V
    | Rejected V


type alias Ticket =
    outcome : Js.Ref (Maybe HostOutcome)
    waiter : Js.Ref (Maybe (Task.Resume HostOutcome))


adapters : V
adapters = Js.construct (Js.global "WeakMap") []


broken : String → a
broken detail =
    Js.throw (Js.construct (Js.global "Error") [ Js.from ("WebGPU binding invariant: " ++ detail) ])


unexpected : String, V → a
unexpected operation cause =
    Js.throw
        (Js.construct (Js.global "Error")
            [ Js.from ("Unexpected WebGPU failure in " ++ operation)
            , Js.object [ ( "cause", cause ) ]
            ]
        )


ticket : V → Ticket
ticket promise =
    observation = { outcome = Js.ref Nothing, waiter = Js.ref Nothing }
    _ =
        Js.call promise "then"
            [ Js.from λvalue → completeTicket observation (Resolved value)
            , Js.from λcause → completeTicket observation (Rejected cause)
            ]
    observation


completeTicket : Ticket, HostOutcome → ⊤
completeTicket observation outcome =
    Js.write observation.outcome (Just outcome)
    case Js.read observation.waiter of
        Nothing →
            ⊤
        Just resume →
            Task.resume resume outcome


waitTicket : Ticket → HostOutcome
waitTicket observation =
    case Js.read observation.outcome of
        Just outcome →
            outcome
        Nothing →
            Task.callback λresume →
                Js.write observation.waiter (Just resume)
                λ⊤ → Js.write observation.waiter Nothing


-- Detached only from the individual waiter, still owned by its program and
-- scheduler. Every rejection is decoded even when a joining caller cancels.
follow : Ticket, sync (HostOutcome → a) → Task.Fiber a
follow observation decode = Task.spawnDetached λ⊤ → decode (waitTicket observation)


pub type AvailabilityFailure
    = Insecure
    | Missing


pub availability : ⊤ → Result AvailabilityFailure ⊤
availability ⊤ =
    if Js.same (Js.global "isSecureContext") (Js.from False) then
        Err Insecure
    else
        navigator = Js.global "navigator"
        if Js.isNullish navigator || Js.isNullish (Js.get navigator "gpu") then
            Err Missing
        else
            Ok ⊤


initializationAvailability : AvailabilityFailure → Error.InitError
initializationAvailability problem =
    case problem of
        Insecure →
            Error.InsecureContext
        Missing →
            Error.ApiUnavailable


pub requestAdapter : Types.RequestAdapterOptions → Result Error.InitError Handle.Adapter
requestAdapter options =
    case availability ⊤ of
        Err problem →
            Err (initializationAvailability problem)
        Ok _ →
            observation =
                ticket
                    (Js.call (Js.get (Js.global "navigator") "gpu") "requestAdapter"
                        [ encodeRequestAdapterOptions options ]
                    )
            supervisor = follow observation λoutcome →
                case outcome of
                    Rejected cause →
                        unexpected "GPU.requestAdapter" cause
                    Resolved value →
                        if Js.isNull value then
                            Err Error.AdapterUnavailable
                        else if Js.instanceOf value (Js.global "GPUAdapter") then
                            _ =
                                Js.call adapters "set"
                                    [ value, Js.from { consumed = False, reserved = False } ]
                            Ok (Js.to value)
                        else
                            broken "GPU.requestAdapter returned a non-adapter"
            Task.join supervisor


pub preferredCanvasFormat : ⊤ → Result Error.InitError Types.TextureFormat
preferredCanvasFormat ⊤ =
    case availability ⊤ of
        Err problem →
            Err (initializationAvailability problem)
        Ok _ →
            Ok
                (decodeTextureFormat
                    (Js.call (Js.get (Js.global "navigator") "gpu") "getPreferredCanvasFormat" [])
                )


pub wgslLanguageFeatures : ⊤ → Result Error.InitError (List String)
wgslLanguageFeatures ⊤ =
    case availability ⊤ of
        Err problem →
            Err (initializationAvailability problem)
        Ok _ →
            Ok (stringSet (Js.get (Js.get (Js.global "navigator") "gpu") "wgslLanguageFeatures"))


stringSet : V → List String
stringSet native =
    values = Js.ref []
    Js.each native λvalue →
        if Js.typeIs value "string" then
            Js.write values [ …Js.read values, Js.to value ]
        else
            broken "feature set contains a non-string"
    Js.read values


nullable : sync (a → V), Maybe a → V
nullable encode value =
    case value of
        Nothing →
            Js.null
        Just item →
            encode item


putOption : V, String, Types.Option a, sync (a → V) → ⊤
putOption object field value encode =
    case value of
        Types.Default →
            ⊤
        Types.Value item →
            Js.set object field (encode item)


encodeLimits : List (String × Types.Option Scalar.Size64) → V
encodeLimits entries =
    object = Js.call (Js.global "Object") "create" [ Js.null ]
    List.foldl entries ⊤ λ( key, value ) _ →
        case value of
            Types.Default →
                Js.set object key Js.undefined
            Types.Value n →
                Js.set object key (Js.from (Scalar.size64Value n))
    object


encodeConstants : List (String × Scalar.FiniteF64) → V
encodeConstants entries =
    object = Js.call (Js.global "Object") "create" [ Js.null ]
    List.foldl entries ⊤ λ( key, value ) _ → Js.set object key (Js.from (Scalar.f64Value value))
    object


encodeColorSpace : Types.ColorSpace → V
encodeColorSpace value =
    case value of
        Types.Srgb →
            Js.from "srgb"
        Types.DisplayP3 →
            Js.from "display-p3"


encodeExternalTextureSource : Types.ExternalTextureSource → V
encodeExternalTextureSource value =
    case value of
        Types.ExternalVideo source →
            Js.from source
        Types.ExternalFrame source →
            Js.from source


encodeImageSource : Source.Input → V
encodeImageSource value =
    case value of
        Source.FromImage source →
            Js.from source
        Source.FromBitmap source →
            Js.from source
        Source.FromPixels source →
            Js.from source
        Source.FromVideo source →
            Js.from source
        Source.FromFrame source →
            Js.from source
        Source.FromCanvas source →
            Js.from source
        Source.FromOffscreen source →
            Js.from source


encodePipelineLayoutMode : Types.PipelineLayoutMode → V
encodePipelineLayoutMode value =
    case value of
        Types.ExplicitLayout layout →
            Js.from layout
        Types.AutomaticLayout mode →
            encodeAutoLayoutMode mode


encodeTextureOrView : Types.TextureOrView → V
encodeTextureOrView value =
    case value of
        Types.WholeTexture texture →
            Js.from texture
        Types.TextureView view →
            Js.from view


encodeBindingResource : Types.BindingResource → V
encodeBindingResource value =
    case value of
        Types.BindingSampler sampler →
            Js.from sampler
        Types.BindingTexture texture →
            Js.from texture
        Types.BindingView view →
            Js.from view
        Types.BindingBuffer buffer →
            Js.from buffer
        Types.BindingRange binding →
            encodeBufferBinding binding
        Types.BindingExternal external →
            Js.from external


encodeColor : Types.Color → V
encodeColor value =
    case value of
        Types.ColorRecord record →
            encodeColorDict record
        Types.ColorSequence values →
            nativeArray values λv → Js.from (Scalar.f64Value v)


encodeOrigin2D : Types.Origin2D → V
encodeOrigin2D value =
    case value of
        Types.Origin2DRecord record →
            encodeOrigin2DDict record
        Types.Origin2DSequence values →
            nativeArray values λv → Js.from (Scalar.u32Value v)


encodeOrigin3D : Types.Origin3D → V
encodeOrigin3D value =
    case value of
        Types.Origin3DRecord record →
            encodeOrigin3DDict record
        Types.Origin3DSequence values →
            nativeArray values λv → Js.from (Scalar.u32Value v)


encodeExtent3D : Types.Extent3D → V
encodeExtent3D value =
    case value of
        Types.Extent3DRecord record →
            encodeExtent3DDict record
        Types.Extent3DSequence values →
            nativeArray values λv → Js.from (Scalar.u32Value v)


encodeGpuError : Types.GpuError → V
encodeGpuError value =
    case value of
        Types.ValidationError message →
            Js.construct (Js.global "GPUValidationError") [ Js.from message ]
        Types.OutOfMemoryError message →
            Js.construct (Js.global "GPUOutOfMemoryError") [ Js.from message ]
        Types.InternalError message →
            Js.construct (Js.global "GPUInternalError") [ Js.from message ]


-- Initialization state is shared by native identity, including callers whose
-- request waiter was cancelled before its native promise settled.
devices : V
devices = Js.construct (Js.global "WeakMap") []


nextDeviceId : Js.Ref Int
nextDeviceId = Js.ref 0


optionOr : Types.Option a, a → a
optionOr value fallback =
    case value of
        Types.Default →
            fallback
        Types.Value supplied →
            supplied


pub adapterFeatures : Handle.Adapter → List String
adapterFeatures adapter = stringSet (Js.get (Js.from adapter) "features")


pub deviceFeatures : Handle.Device → List String
deviceFeatures device = stringSet (Js.get (Js.from device) "features")


pub adapterInfo : Handle.Adapter → Result Error.Error Types.AdapterInfo
adapterInfo adapter = readAdapterInfo (Js.get (Js.from adapter) "info")


pub deviceAdapterInfo : Handle.Device → Result Error.Error Types.AdapterInfo
deviceAdapterInfo device = readAdapterInfo (Js.get (Js.from device) "adapterInfo")


pub adapterLimits : Handle.Adapter → Result Error.Error Types.SupportedLimits
adapterLimits adapter = readLimits (Js.get (Js.from adapter) "limits")


pub deviceLimits : Handle.Device → Result Error.Error Types.SupportedLimits
deviceLimits device = readLimits (Js.get (Js.from device) "limits")


pub deviceQueue : Handle.Device → Handle.Queue
deviceQueue device =
    queue = Js.get (Js.from device) "queue"
    if Js.instanceOf queue (Js.global "GPUQueue") then
        Js.to queue
    else
        broken "GPUDevice.queue returned a non-queue"


pub deviceLoss : Handle.Device → Maybe Error.DeviceLoss
deviceLoss device = Js.to (Js.get (deviceState device) "loss")


pub awaitDeviceLost : Handle.Device → Error.DeviceLoss
awaitDeviceLost device =
    state = deviceState device
    Task.join (Js.to (Js.get state "lossObserver"))


pub destroyDevice : Handle.Device → ⊤
destroyDevice device =
    state = deviceState device
    if not (Js.to (Js.get state "destroyed")) then
        Js.set state "destroyed" (Js.from True)
        Js.to (Js.call (Js.from device) "destroy" [])


deviceState : Handle.Device → V
deviceState device =
    state = Js.call devices "get" [ Js.from device ]
    if Js.isUndefined state then broken "unregistered device identity" else state


pub requestDevice : Handle.Adapter, Types.DeviceDescriptor → Result Error.InitError Handle.Device
requestDevice adapter descriptor =
    native = Js.from adapter
    state = Js.call adapters "get" [ native ]
    if Js.isUndefined state then
        broken "unregistered adapter identity"
    else if Js.to (Js.get state "consumed") || Js.to (Js.get state "reserved") then
        Err Error.AdapterConsumed
    else
        requested = optionOr descriptor.requiredFeatures []
        unsupported = List.filter requested λfeature →
            not (Js.to (Js.call (Js.get native "features") "has" [ encodeFeatureName feature ]))
        if not (List.isEmpty unsupported) then
            Err
                (Error.UnsupportedFeatures
                    (List.map unsupported λfeature → Js.to (encodeFeatureName feature))
                )
        else
            mismatches =
                checkRequiredLimits (Js.get native "limits") (optionOr descriptor.requiredLimits [])
            if not (List.isEmpty mismatches) then
                Err (Error.UnsupportedLimits mismatches)
            else
                Js.set state "reserved" (Js.from True)
                abandoned = Js.ref False
                observation =
                    ticket (Js.call native "requestDevice" [ encodeDeviceDescriptor descriptor ])
                supervisor = follow observation λoutcome →
                    Js.set state "reserved" (Js.from False)
                    case outcome of
                        Rejected cause →
                            if Js.instanceOf cause (Js.global "TypeError") then
                                Err (Error.FeatureRequestRejected (nativeMessage cause))
                            else if domError "OperationError" cause then
                                Err (Error.DeviceRequestRejected (nativeMessage cause))
                            else
                                unexpected "GPUAdapter.requestDevice" cause
                        Resolved value →
                            if not (Js.instanceOf value (Js.global "GPUDevice")) then
                                broken "GPUAdapter.requestDevice returned a non-device"
                            else
                                Js.set state "consumed" (Js.from True)
                                device = registerDevice value
                                if Js.read abandoned then destroyDevice device
                                Ok device
                Task.bracket
                    (λ⊤ → ⊤)
                    (λ_ exit →
                        case exit of
                            Task.Cancelled →
                                Js.write abandoned True
                                case Task.poll supervisor of
                                    Just (Task.Done (Ok device)) →
                                        destroyDevice device
                                    _ →
                                        ⊤
                            Task.Done _ →
                                ⊤
                    )
                    λ_ →
                        case Task.join supervisor of
                            Err problem →
                                Err problem
                            Ok device →
                                -- A resolved lost promise must get its native microtask before
                                -- publication; Task.yieldNow alone need not leave the drain.
                                checkpoint =
                                    ticket
                                        (Js.call (Js.global "Promise") "resolve" [ Js.undefined ])
                                case waitTicket checkpoint of
                                    Resolved _ →
                                        ⊤
                                    Rejected cause →
                                        unexpected "initialization microtask checkpoint" cause
                                case deviceLoss device of
                                    Just loss →
                                        destroyDevice device
                                        Err (Error.InitializationLost loss)
                                    Nothing →
                                        Ok device


nativeMessage : V → String
nativeMessage value =
    message = Js.get value "message"
    if Js.typeIs message "string" then
        Js.to message
    else
        broken "native error has a non-string message"


domError : String, V → Bool
domError expected value =
    constructor = Js.global "DOMException"
    Js.typeIs constructor "function"
        && Js.instanceOf value constructor
        && Js.same (Js.get value "name") (Js.from expected)


registerDevice : V → Handle.Device
registerDevice native =
    id = Js.read nextDeviceId + 1
    Js.write nextDeviceId id
    state = Js.from { destroyed = False, id = id, loss = Nothing, lossObserver = Js.null }
    _ = Js.call devices "set" [ native, state ]
    observation = ticket (Js.get native "lost")
    supervisor = follow observation λoutcome →
        case outcome of
            Rejected cause →
                unexpected "GPUDevice.lost" cause
            Resolved info →
                if not (Js.instanceOf info (Js.global "GPUDeviceLostInfo")) then
                    broken "GPUDevice.lost returned non-loss data"
                reason = Js.get info "reason"
                message = nativeMessage info
                loss =
                    if Js.same reason (Js.from "unknown") then
                        { reason = Error.UnknownLoss, message = message }
                    else if Js.same reason (Js.from "destroyed") then
                        { reason = Error.Destroyed, message = message }
                    else
                        broken "unknown GPUDeviceLostReason"
                Js.set state "loss" (Js.from (Just loss))
                loss
    Js.set state "lossObserver" (Js.from supervisor)
    Js.to native


checkRequiredLimits : V, List (String × Types.Option Scalar.Size64) → List Error.LimitMismatch
checkRequiredLimits supported entries =
    -- Inspect the same record conversion the native call receives: later
    -- duplicate entries replace earlier ones, including explicit undefined.
    requested = encodeLimits entries
    mismatches = Js.ref []
    Js.each (Js.call (Js.global "Object") "keys" [ requested ]) λnativeKey →
        key : String
        key = Js.to nativeKey
        value = Js.get requested key
        if not (Js.isUndefined value) then
            n : Int
            n = Js.to value
            supportedValue =
                if List.member limitNames key then
                    case readUnsigned64 supported key of
                        Ok bound →
                            Just bound
                        Err _ →
                            Nothing
                else
                    Nothing
            alignment =
                key == "minUniformBufferOffsetAlignment" || key == "minStorageBufferOffsetAlignment"
            valid =
                case supportedValue of
                    Nothing →
                        False
                    Just bound →
                        (if alignment then n ≥ bound else n ≤ bound)
                            && (not alignment || n > 0 && n < 4294967296 && Js.bitAnd n (n - 1) == 0
                               )
            if not valid then
                Js.write mismatches
                    [ …Js.read mismatches
                    , { name = key, requested = n, supported = supportedValue }
                    ]
    Js.read mismatches


readAdapterInfo : V → Result Error.Error Types.AdapterInfo
readAdapterInfo native =
    vendor = readString native "vendor"?
    architecture = readString native "architecture"?
    device = readString native "device"?
    description = readString native "description"?
    subgroupMinSize = readUnsigned32 native "subgroupMinSize"?
    subgroupMaxSize = readUnsigned32 native "subgroupMaxSize"?
    isFallbackAdapter = readBoolean native "isFallbackAdapter"?
    Ok
        { vendor = vendor
        , architecture = architecture
        , device = device
        , description = description
        , subgroupMinSize = subgroupMinSize
        , subgroupMaxSize = subgroupMaxSize
        , isFallbackAdapter = isFallbackAdapter
        }


readLimits : V → Result Error.Error Types.SupportedLimits
readLimits native =
    maxTextureDimension1D = readUnsigned32 native "maxTextureDimension1D"?
    maxTextureDimension2D = readUnsigned32 native "maxTextureDimension2D"?
    maxTextureDimension3D = readUnsigned32 native "maxTextureDimension3D"?
    maxTextureArrayLayers = readUnsigned32 native "maxTextureArrayLayers"?
    maxBindGroups = readUnsigned32 native "maxBindGroups"?
    maxBindGroupsPlusVertexBuffers = readUnsigned32 native "maxBindGroupsPlusVertexBuffers"?
    maxImmediateSize = readUnsigned32 native "maxImmediateSize"?
    maxBindingsPerBindGroup = readUnsigned32 native "maxBindingsPerBindGroup"?
    maxDynamicUniformBuffersPerPipelineLayout =
        readUnsigned32 native "maxDynamicUniformBuffersPerPipelineLayout"?
    maxDynamicStorageBuffersPerPipelineLayout =
        readUnsigned32 native "maxDynamicStorageBuffersPerPipelineLayout"?
    maxSampledTexturesPerShaderStage = readUnsigned32 native "maxSampledTexturesPerShaderStage"?
    maxSamplersPerShaderStage = readUnsigned32 native "maxSamplersPerShaderStage"?
    maxStorageBuffersPerShaderStage = readUnsigned32 native "maxStorageBuffersPerShaderStage"?
    maxStorageBuffersInVertexStage = readUnsigned32 native "maxStorageBuffersInVertexStage"?
    maxStorageBuffersInFragmentStage = readUnsigned32 native "maxStorageBuffersInFragmentStage"?
    maxStorageTexturesPerShaderStage = readUnsigned32 native "maxStorageTexturesPerShaderStage"?
    maxStorageTexturesInVertexStage = readUnsigned32 native "maxStorageTexturesInVertexStage"?
    maxStorageTexturesInFragmentStage = readUnsigned32 native "maxStorageTexturesInFragmentStage"?
    maxUniformBuffersPerShaderStage = readUnsigned32 native "maxUniformBuffersPerShaderStage"?
    maxUniformBufferBindingSize = readUnsigned64 native "maxUniformBufferBindingSize"?
    maxStorageBufferBindingSize = readUnsigned64 native "maxStorageBufferBindingSize"?
    minUniformBufferOffsetAlignment = readUnsigned32 native "minUniformBufferOffsetAlignment"?
    minStorageBufferOffsetAlignment = readUnsigned32 native "minStorageBufferOffsetAlignment"?
    maxVertexBuffers = readUnsigned32 native "maxVertexBuffers"?
    maxBufferSize = readUnsigned64 native "maxBufferSize"?
    maxVertexAttributes = readUnsigned32 native "maxVertexAttributes"?
    maxVertexBufferArrayStride = readUnsigned32 native "maxVertexBufferArrayStride"?
    maxInterStageShaderVariables = readUnsigned32 native "maxInterStageShaderVariables"?
    maxColorAttachments = readUnsigned32 native "maxColorAttachments"?
    maxColorAttachmentBytesPerSample = readUnsigned32 native "maxColorAttachmentBytesPerSample"?
    maxComputeWorkgroupStorageSize = readUnsigned32 native "maxComputeWorkgroupStorageSize"?
    maxComputeInvocationsPerWorkgroup = readUnsigned32 native "maxComputeInvocationsPerWorkgroup"?
    maxComputeWorkgroupSizeX = readUnsigned32 native "maxComputeWorkgroupSizeX"?
    maxComputeWorkgroupSizeY = readUnsigned32 native "maxComputeWorkgroupSizeY"?
    maxComputeWorkgroupSizeZ = readUnsigned32 native "maxComputeWorkgroupSizeZ"?
    maxComputeWorkgroupsPerDimension = readUnsigned32 native "maxComputeWorkgroupsPerDimension"?
    Ok
        { maxTextureDimension1D = maxTextureDimension1D
        , maxTextureDimension2D = maxTextureDimension2D
        , maxTextureDimension3D = maxTextureDimension3D
        , maxTextureArrayLayers = maxTextureArrayLayers
        , maxBindGroups = maxBindGroups
        , maxBindGroupsPlusVertexBuffers = maxBindGroupsPlusVertexBuffers
        , maxImmediateSize = maxImmediateSize
        , maxBindingsPerBindGroup = maxBindingsPerBindGroup
        , maxDynamicUniformBuffersPerPipelineLayout = maxDynamicUniformBuffersPerPipelineLayout
        , maxDynamicStorageBuffersPerPipelineLayout = maxDynamicStorageBuffersPerPipelineLayout
        , maxSampledTexturesPerShaderStage = maxSampledTexturesPerShaderStage
        , maxSamplersPerShaderStage = maxSamplersPerShaderStage
        , maxStorageBuffersPerShaderStage = maxStorageBuffersPerShaderStage
        , maxStorageBuffersInVertexStage = maxStorageBuffersInVertexStage
        , maxStorageBuffersInFragmentStage = maxStorageBuffersInFragmentStage
        , maxStorageTexturesPerShaderStage = maxStorageTexturesPerShaderStage
        , maxStorageTexturesInVertexStage = maxStorageTexturesInVertexStage
        , maxStorageTexturesInFragmentStage = maxStorageTexturesInFragmentStage
        , maxUniformBuffersPerShaderStage = maxUniformBuffersPerShaderStage
        , maxUniformBufferBindingSize = maxUniformBufferBindingSize
        , maxStorageBufferBindingSize = maxStorageBufferBindingSize
        , minUniformBufferOffsetAlignment = minUniformBufferOffsetAlignment
        , minStorageBufferOffsetAlignment = minStorageBufferOffsetAlignment
        , maxVertexBuffers = maxVertexBuffers
        , maxBufferSize = maxBufferSize
        , maxVertexAttributes = maxVertexAttributes
        , maxVertexBufferArrayStride = maxVertexBufferArrayStride
        , maxInterStageShaderVariables = maxInterStageShaderVariables
        , maxColorAttachments = maxColorAttachments
        , maxColorAttachmentBytesPerSample = maxColorAttachmentBytesPerSample
        , maxComputeWorkgroupStorageSize = maxComputeWorkgroupStorageSize
        , maxComputeInvocationsPerWorkgroup = maxComputeInvocationsPerWorkgroup
        , maxComputeWorkgroupSizeX = maxComputeWorkgroupSizeX
        , maxComputeWorkgroupSizeY = maxComputeWorkgroupSizeY
        , maxComputeWorkgroupSizeZ = maxComputeWorkgroupSizeZ
        , maxComputeWorkgroupsPerDimension = maxComputeWorkgroupsPerDimension
        }


limitNames : List String
limitNames =
    [ "maxTextureDimension1D"
    , "maxTextureDimension2D"
    , "maxTextureDimension3D"
    , "maxTextureArrayLayers"
    , "maxBindGroups"
    , "maxBindGroupsPlusVertexBuffers"
    , "maxImmediateSize"
    , "maxBindingsPerBindGroup"
    , "maxDynamicUniformBuffersPerPipelineLayout"
    , "maxDynamicStorageBuffersPerPipelineLayout"
    , "maxSampledTexturesPerShaderStage"
    , "maxSamplersPerShaderStage"
    , "maxStorageBuffersPerShaderStage"
    , "maxStorageBuffersInVertexStage"
    , "maxStorageBuffersInFragmentStage"
    , "maxStorageTexturesPerShaderStage"
    , "maxStorageTexturesInVertexStage"
    , "maxStorageTexturesInFragmentStage"
    , "maxUniformBuffersPerShaderStage"
    , "maxUniformBufferBindingSize"
    , "maxStorageBufferBindingSize"
    , "minUniformBufferOffsetAlignment"
    , "minStorageBufferOffsetAlignment"
    , "maxVertexBuffers"
    , "maxBufferSize"
    , "maxVertexAttributes"
    , "maxVertexBufferArrayStride"
    , "maxInterStageShaderVariables"
    , "maxColorAttachments"
    , "maxColorAttachmentBytesPerSample"
    , "maxComputeWorkgroupStorageSize"
    , "maxComputeInvocationsPerWorkgroup"
    , "maxComputeWorkgroupSizeX"
    , "maxComputeWorkgroupSizeY"
    , "maxComputeWorkgroupSizeZ"
    , "maxComputeWorkgroupsPerDimension"
    ]


-- Native Web IDL sequences are fresh plain arrays. Js.array deliberately
-- accepts literals only; this is the data conversion, in beni, for a list.
nativeArray : List a, sync (a → V) → V
nativeArray values encode = List.foldl values (Js.array []) λvalue array →
    _ = Js.call array "push" [ encode value ]
    array


member : V, String → Result Error.Error V
member native field =
    value = Js.get native field
    if Js.isUndefined value then
        Err (Error.UnsupportedCapability (Error.MissingNativeMember field))
    else
        Ok value


readString : V, String → Result Error.Error String
readString native field =
    value = member native field?
    if Js.typeIs value "string" then
        Ok (Js.to value)
    else
        broken ("non-string native member: " ++ field)


readBoolean : V, String → Result Error.Error Bool
readBoolean native field =
    value = member native field?
    if Js.typeIs value "boolean" then
        Ok (Js.to value)
    else
        broken ("non-boolean native member: " ++ field)


readUnsigned32 : V, String → Result Error.Error Int
readUnsigned32 native field =
    value = member native field?
    if Js.typeIs value "number" then
        case Scalar.u32 (Js.to value) of
            Ok n →
                Ok (Scalar.u32Value n)
            Err _ →
                broken ("native member outside unsigned32: " ++ field)
    else
        broken ("non-number native member: " ++ field)


readUnsigned64 : V, String → Result Error.Error Int
readUnsigned64 native field =
    value = member native field?
    if Js.typeIs value "number" then
        case Scalar.size64 (Js.to value) of
            Ok n →
                Ok (Scalar.size64Value n)
            Err _ →
                broken ("native member outside unsigned64: " ++ field)
    else
        broken ("non-number native member: " ++ field)


-- BEGIN GENERATED WEBGPU CONVERSIONS
encodeFeatureName : Types.FeatureName → V
encodeFeatureName value =
    case value of
        Types.FeatureNameCoreFeaturesAndLimits →
            Js.from "core-features-and-limits"
        Types.FeatureNameDepthClipControl →
            Js.from "depth-clip-control"
        Types.FeatureNameDepth32floatStencil8 →
            Js.from "depth32float-stencil8"
        Types.FeatureNameTextureCompressionBc →
            Js.from "texture-compression-bc"
        Types.FeatureNameTextureCompressionBcSliced3d →
            Js.from "texture-compression-bc-sliced-3d"
        Types.FeatureNameTextureCompressionEtc2 →
            Js.from "texture-compression-etc2"
        Types.FeatureNameTextureCompressionAstc →
            Js.from "texture-compression-astc"
        Types.FeatureNameTextureCompressionAstcSliced3d →
            Js.from "texture-compression-astc-sliced-3d"
        Types.FeatureNameTimestampQuery →
