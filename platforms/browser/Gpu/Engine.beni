--! The WebGPU engine (`docs/design/webgpu.md` §2.1, §6, §8): the state
--! table beside every native object, the host's entry point, waits on
--! native promises with exactly the failures the ledger documents, and the
--! loss latch of each device. The operation modules (`Gpu`, `Gpu.Adapter`,
--! `Gpu.Device`) are written over it; an application never needs it, and
--! its signatures name `Js.Value`.
--!
--! Written over `Js`. A native object's state is a record in a `WeakMap`
--! keyed by the object, never a property on it, so every alias of a handle
--! sees one state. A native GPU object with no record was not made by the
--! engine, and meeting one is a defect.
--!
--! No `catch` here turns a failure into a value it does not document
--! (`CLAUDE.md` rule 9): a promise's outcome is handed to the operation's
--! own classifier, which names what the ledger documents and makes
--! everything else a defect. Two `catchIf`s hold of every error, and both
--! end in a defect, never a value: `classified`, around a classifier in a
--! promise's reaction, makes what it throws `Unexpected`, which the waiting
--! fiber throws or the channel's program receives; `guard`, around the rest
--! of a reaction's body (a device's `lost`, an error scope's pop, the
--! abandoning of a late value, which also runs from the wait's `onExit`
--! finaliser), hands what it throws to the channel's program. Without them
--! a throw in a reaction would be an unhandled rejection that the program
--! survives.

import Gpu.Error as Error exposing (DeviceLoss, LossReason, UnknownLoss, Destroyed, Observation)
import Js
import Task


type alias V =
    Js.Value


-- The state table of this realm: native object → its record.
table : V
table = Js.pure λ⊤ → Js.construct (Js.global "WeakMap") []


-- The runtime identities of devices, from 1, in the order they were made.
lastDevice : Js.Ref Int
lastDevice = Js.ref 0


--| Stop the program: a wrapper invariant broke, or the host gave what the
--| ledger does not document. The error keeps the cause when there is one.
pub defect : String → a
defect message = Js.throw (Js.construct (Js.global "Error") [ Js.from ("webgpu: " ++ message) ])


--| The record of a native object the engine made; a defect for any other.
pub recordOf : V → V
recordOf native =
    r = Js.call table "get" [ native ]
    if Js.isUndefined r then
        defect "a GPU object the engine did not make"
    else
        r


--| Whether the engine made this native object.
pub known : V → Bool
known native = Js.to (Js.call table "has" [ native ])


--| The member `name` of a native object, which the standard says it has;
--| a defect naming it when the host gives none.
pub member : V, String → V
member native name =
    value = Js.get native name
    if Js.isNullish value then defect ("the host gave no `" ++ name ++ "`") else value


--| The names of a native setlike member (`features`,
--| `wgslLanguageFeatures`); a defect naming it when the host gives none or a
--| name that is not a string.
pub readNames : V, String → List String
readNames native name =
    names = Js.call (Js.global "Array") "from" [ member native name ]
    if Js.to (Js.call names "every" [ Js.from λn → Js.typeIs n "string" ]) then
        Js.to names
    else
        defect ("the host's `" ++ name ++ "` holds a name that is not a string")


-- ---- The host's entry point (ledger §2) ------------------------------------

--| Why the API is not there: not a secure context, or no `navigator.gpu`.
pub type Missing
    = NotSecure
    | NoApi


--| The realm's `GPU` object, or why there is none. A missing global is
--| read as `undefined`, never named.
pub entry : ⊤ → Result Missing V
entry ⊤ =
    if not (Js.same (Js.global "isSecureContext") (Js.from True)) then
        Err NotSecure
    else
        navigator = Js.global "navigator"
        if Js.isNullish navigator then
            Err NoApi
        else
            gpu = Js.get navigator "gpu"
            if Js.isNullish gpu then Err NoApi else Ok gpu


-- ---- Channels to the requesting program (§6.4, *Outcomes that outlive
-- their caller*) ---------------------------------------------------------------

-- How many channels are open: what a fixture reads to see sentinels end.
openChannels : Js.Ref Int
openChannels = Js.ref 0


--| A channel to the defect boundary of the program that calls this: a
--| fiber of that program, detached so that it outlives the call, waits on
--| it and throws what it is handed. It holds once for the caller; `hold`
--| adds a holder — a device the request made — and the fiber ends when the
--| last holder releases it. Made before the request suspends, so an
--| outcome that arrives after its fiber was cancelled still reaches its
--| program. It keeps the caller's clock and log context too.
pub channel : ⊤ → V
channel ⊤ =
    ch =
        Js.object
            [ ( "sentinel", Js.null )
            , ( "pending", Js.null )
            , ( "holds", Js.from 1 )
            , ( "closed", Js.from False )
            , ( "defected", Js.from False )
            , ( "clock", Task.currentClock ⊤ )
            , ( "log", Task.currentLogContext ⊤ )
            ]
    Js.write openChannels (Js.read openChannels + 1)
    _ = Task.spawnDetached λ⊤ → sentinel ch
    ch


-- The channel's fiber: it waits for a message, ends on `{ end }` and throws
-- the error of `{ error }`.
sentinel : V → ⊤
sentinel ch =
    pending = Js.get ch "pending"

    message =
        if Js.isNull pending then
            Task.callback λresume →
                Js.set ch "sentinel" (Js.from resume)
                λ⊤ → Js.set ch "sentinel" Js.null
        else
            pending
    if Js.to (Js.get message "end") then ⊤ else Js.throw (Js.get message "error")


deliver : V, V → ⊤
deliver ch message =
    s = Js.get ch "sentinel"
    if Js.isNull s then
        if Js.isNull (Js.get ch "pending") then Js.set ch "pending" message
    else
        Js.set ch "sentinel" Js.null
        Task.resume (Js.to s) message


close : V → ⊤
close ch =
    Js.set ch "closed" (Js.from True)
    Js.write openChannels (Js.read openChannels - 1)


--| One more holder of the channel.
pub hold : V → ⊤
hold ch = Js.set ch "holds" (Js.from (int (Js.get ch "holds") + 1))


--| A holder is done with the channel; the last one ends its fiber.
pub release : V → ⊤
release ch =
    if Js.to (Js.get ch "closed") then
        ⊤
    else
        holds = int (Js.get ch "holds") - 1
        Js.set ch "holds" (Js.from holds)
        if holds ≤ 0 then
            close ch
            deliver ch (Js.object [ ( "end", Js.from True ), ( "error", Js.null ) ])
        else
            ⊤


--| Stop the channel's program with `error`. Its first defect is its
--| program's stop, so a later one has nobody left to stop and is dropped.
--| A channel whose fiber already ended — which no outcome of its holders
--| can reach, since each holds it while one may come — still stops a
--| program: a new detached fiber throws it, with the caller's clock and log
--| context. Core gives no way to carry the caller's scheduler there
--| (#2257).
pub channelDefect : V, V → ⊤
channelDefect ch error =
    if Js.to (Js.get ch "defected") then
        ⊤
    else
        Js.set ch "defected" (Js.from True)
        if Js.to (Js.get ch "closed") then
            clock = Js.get ch "clock"
            log = Js.get ch "log"
            _ = Task.spawnDetached λ⊤ →
                Task.withClock clock λ⊤ → Task.withLogContext log λ⊤ → Js.throw error
            ⊤
        else
            close ch
            deliver ch (Js.object [ ( "end", Js.from False ), ( "error", error ) ])


--| How many channels are open.
pub openChannelCount : ⊤ → Int
openChannelCount ⊤ = Js.read openChannels


--| An unexpected outcome as a defect with its context (§6.1, §8.1): an
--| `Error` whose message names the operation, and the device when there is
--| one, with the original as its `cause`.
pub contextual : String, V → V
contextual context cause =
    Js.construct (Js.global "Error")
        [ Js.from ("webgpu: " ++ context ++ ": " ++ Js.to (Js.apply (Js.global "String") [ cause ]))
        , Js.object [ ( "cause", cause ) ]
        ]


--| Run the body of a promise reaction; what it throws goes to the channel's
--| program as a defect, with its context, instead of on as an unhandled
--| rejection.
pub guard : V, String, sync (⊤ → ⊤) → ⊤
guard ch context body = Js.catchIf (λ⊤ → body ⊤) (λ_ → True) λerror →
    channelDefect ch (contextual context error)


int : V → Int
int v = Js.to v


-- ---- Waiting for a native promise ------------------------------------------

--| What a promise's outcome is, as its reaction classified it: a value the
--| operation documents, or what it does not.
pub type Outcome a
    = Expected a
    | Unexpected V


--| Wait for the promise `start` returns, for the holder of `ch` that is
--| the caller; `operation` names it in a defect. `classify` runs in the
--| promise's reaction, `True` for a fulfilled one: it makes the outcome —
--| recording a native object, giving back a reservation — whether or not
--| anyone still waits, and what it throws is `Unexpected`. The fiber is
--| resumed one microtask after it, so a reaction the outcome set off (a
--| device's `lost`) runs first. An `Unexpected` outcome is thrown in the
--| fiber, a defect. Once the fiber is gone — cancelled, or interrupted
--| before it waited — an `Expected` value that arrives is handed to
--| `abandon`, and an `Unexpected` one to the channel's program; the
--| caller's hold is released then, never before. `start` runs only when
--| the fiber really waits, so what it takes (an adapter's reservation) is
--| taken only then; a `start` that throws, or gives no promise, is a
--| defect, and the wait never started.
pub awaitHost : V, String, sync (⊤ → V), sync (Bool, V → Outcome a), sync (a → ⊤) → a
awaitHost ch operation start classify abandon =
    st =
        Js.object
            [ ( "waiting", Js.from True )
            , ( "started", Js.from False )
            , ( "settled", Js.from False )
            , ( "taken", Js.from False )
            , ( "outcome", Js.null )
            , ( "resume", Js.null )
            ]

    outcome =
        Task.onExit
            (λ⊤ →
                got = Task.callback λresume →
                    Js.set st "resume" (Js.from resume)
                    _ =
                        Js.call (start ⊤) "then"
                            [ Js.from λvalue →
                                arrive ch operation st (classified classify True value) abandon
                            , Js.from λerror →
                                arrive ch operation st (classified classify False error) abandon
                            ]
                    Js.set st "started" (Js.from True)
                    λ⊤ → ⊤
                Js.set st "taken" (Js.from True)
                got
            )
            λ_ → leave ch operation st abandon
    case outcome of
        Expected value →
            value

        Unexpected error →
            Js.throw (contextual operation error)


-- The classifier, in the promise's reaction. The second catch that holds
-- of every error: what the classifier throws becomes `Unexpected`, which
-- ends in a defect, in the fiber or in the channel's program.
classified : sync (Bool, V → Outcome a), Bool, V → Outcome a
classified classify fulfilled value =
    Js.catchIf (λ⊤ → classify fulfilled value) (λ_ → True) λerror → Unexpected error


arrive : V, String, V, Outcome a, sync (a → ⊤) → ⊤
arrive ch operation st outcome abandon =
    Js.set st "settled" (Js.from True)
    if Js.to (Js.get st "waiting") then
        Js.set st "outcome" (Js.from outcome)
        resume = Js.get st "resume"
        _ =
            Js.call (Js.call (Js.global "Promise") "resolve" []) "then"
                [ Js.from λ_ → Task.resume (Js.to resume) outcome ]
        ⊤
    else
        late ch operation outcome abandon


-- The fiber left the wait, however: its outcome taken, or not.
leave : V, String, V, sync (a → ⊤) → ⊤
leave ch operation st abandon =
    Js.set st "waiting" (Js.from False)
    if Js.to (Js.get st "taken") || not (Js.to (Js.get st "started")) then
        release ch
    else if Js.to (Js.get st "settled") then
        late ch operation (Js.to (Js.get st "outcome")) abandon
    else
        ⊤


-- An outcome nobody takes: a value is abandoned, an unexpected one stops
-- the program.
late : V, String, Outcome a, sync (a → ⊤) → ⊤
late ch operation outcome abandon =
    case outcome of
        Expected value →
            guard ch (operation ++ ", abandoned") λ⊤ → abandon value
            release ch

        Unexpected error →
            channelDefect ch (contextual (operation ++ ", after its caller left") error)


--| Whether `error` is a native `DOMException` named `name`: a plain object
--| with a matching `name` is not one (ledger §1).
pub isDomException : V, String → Bool
isDomException error name =
    constructor = Js.global "DOMException"
    not (Js.isUndefined constructor)
        && Js.instanceOf error constructor
        && Js.same (Js.get error "name") (Js.from name)


--| Whether `error` is a native `TypeError`.
pub isTypeError : V → Bool
isTypeError error = Js.instanceOf error (Js.global "TypeError")


--| Whether `error` is a native `RangeError`.
pub isRangeError : V → Bool
isRangeError error = Js.instanceOf error (Js.global "RangeError")


--| The `message` of a native error.
pub messageOf : V → String
messageOf error = Js.to (Js.get error "message")


-- ---- Adapters ------------------------------------------------------------------

--| Record a new adapter: neither consumed nor reserved.
pub adoptAdapter : V → ⊤
adoptAdapter adapter =
    _ =
        Js.call table "set"
            [ adapter, Js.from { consumed = False, reserved = False } ]
    ⊤


--| Whether a device request on the adapter may start: none has succeeded
--| and none is in flight.
pub adapterFree : V → Bool
adapterFree adapter =
    r = recordOf adapter
    not (Js.to (Js.get r "consumed")) && not (Js.to (Js.get r "reserved"))


--| Reserve the adapter for one device request, or release it.
pub reserveAdapter : V, Bool → ⊤
reserveAdapter adapter reserved = Js.set (recordOf adapter) "reserved" (Js.from reserved)


--| The adapter gave its device: it is consumed for good.
pub consumeAdapter : V → ⊤
consumeAdapter adapter =
    r = recordOf adapter
    Js.set r "reserved" (Js.from False)
    Js.set r "consumed" (Js.from True)


-- ---- Devices and the loss latch (§8) -------------------------------------------

--| Record a device the host gave on channel `ch`, with its loss watched
--| before anyone sees it (ledger §2: `device.lost` is observed from
--| creation). The device holds the channel until its loss is reported. Its
--| record also keeps its lease (§6.4): whether it is held and its
--| generation; whether a scope section is open on it; the checked
--| operations waiting on it, each woken by a loss; and how many of its
--| error-scope pops are still to settle.
pub adoptDevice : V, V → ⊤
adoptDevice device ch =
    id = Js.read lastDevice + 1
    Js.write lastDevice id

    r =
        Js.object
            [ ( "id", Js.from id )
            , ( "self", device )
            , ( "loss", Js.null )
            , ( "final", Js.from False )
            , ( "destroyed", Js.from False )
            , ( "waiters", Js.array [] )
            , ( "channel", ch )
            , ( "released", Js.from False )
            , ( "pops", Js.from 0 )
            , ( "leased", Js.from False )
            , ( "generation", Js.from 0 )
            , ( "section", Js.from False )
            , ( "ops", Js.array [] )
            , ( "mapped", Js.construct (Js.global "Set") [] )
            ]
    _ = Js.call table "set" [ device, r ]
    hold ch
    _ =
        Js.call (Js.get device "lost") "then"
            [ Js.from λinfo → guard ch (deviceContext r "lost") λ⊤ → lost r info
            , Js.from λerror → reportDefect r (contextual (deviceContext r "lost") error)
            ]
    -- The queue belongs to the device: its record names the device, and
    -- the native device its checked operations run on.
    _ =
        Js.call table "set"
            [ member device "queue", Js.object [ ( "device", r ), ( "native", device ) ] ]
    ⊤


--| The runtime identity of a device: a number, never the native object.
pub deviceId : V → Int
deviceId device = Js.to (Js.get (recordOf device) "id")


--| The loss a device has latched, if any.
pub loss : V → Maybe DeviceLoss
loss device =
    l = Js.get (recordOf device) "loss"
    if Js.isNull l then Nothing else Just (Js.to l)


--| Wait for the device's loss; at once when it is latched already. A
--| cancelled wait leaves the device's waiters.
pub awaitLost : V → DeviceLoss
awaitLost device =
    r = recordOf device
    l = Js.get r "loss"
    if Js.isNull l then
        Task.callback λresume →
            waiters = Js.get r "waiters"
            waiter = Js.from resume
            _ = Js.call waiters "push" [ waiter ]
            λ⊤ →
                at = Js.call waiters "indexOf" [ waiter ]
                if Js.to (Js.ge at (Js.from 0)) then
                    _ = Js.call waiters "splice" [ at, Js.from 1 ]
                    ⊤
                else
                    ⊤
    else
        Js.to l


--| Destroy the device: its state is latched at once — later work on it
--| fails, and waiters for its loss wake — and the host's later report of
--| the loss replaces the message. Destroying twice does nothing more.
pub destroy : V → ⊤
destroy device =
    r = recordOf device
    if Js.to (Js.get r "destroyed") then
        ⊤
    else
        Js.set r "destroyed" (Js.from True)
        expireMappings r
        if Js.isNull (Js.get r "loss") then latch r { reason = Destroyed, message = "" }
        Js.to (Js.call device "destroy" [])


-- Destroying a device unmaps every buffer of it (the specification's
-- device destruction): each mapped or pending buffer's mapping expires
-- first, for every alias, as `unmap` makes it expire.
expireMappings : V → ⊤
expireMappings r =
    buffers = Js.call (Js.global "Array") "from" [ Js.get r "mapped" ]
    Js.call (Js.get r "mapped") "clear" [] ▷ ignore
    Js.each buffers λbuffer →
        b = recordOf buffer
        Js.set b "generation" (Js.from (int (Js.get b "generation") + 1))
        Js.set b "state" (Js.from "unmapped")
        Js.set b "mapping" Js.null


--| Track a buffer of the device of record `r` while it is mapped or its map
--| is pending (`True`), or no longer (`False`): what `destroy` expires.
pub trackMapped : V, V, Bool → ⊤
trackMapped r buffer mapped =
    set = Js.get r "mapped"
    if mapped then
        Js.call set "add" [ buffer ] ▷ ignore
    else
        Js.call set "delete" [ buffer ] ▷ ignore


--| Whether `destroy` was called on the device.
pub destroyed : V → Bool
destroyed device = Js.to (Js.get (recordOf device) "destroyed")


-- The host's `lost` settled with `info`: a reason of the pin is latched,
-- any other is a defect (ledger §7). The host's report is final: the
-- device holds its channel no longer once nothing of it is pending.
lost : V, V → ⊤
lost r info =
    reason = Js.get info "reason"
    if Js.same reason (Js.from "destroyed") then
        latch r { reason = Destroyed, message = Js.to (Js.get info "message") }
        Js.set r "final" (Js.from True)
        settleDevice r
    else if Js.same reason (Js.from "unknown") then
        latch r { reason = UnknownLoss, message = Js.to (Js.get info "message") }
        Js.set r "final" (Js.from True)
        settleDevice r
    else
        reportDefect r (contextual (deviceContext r "lost for a reason outside the pin") reason)


-- Latch the loss and wake every waiter. A later report replaces an earlier
-- one (the host's message after `destroy`'s), and wakes nobody twice.
latch : V, DeviceLoss → ⊤
latch r value =
    Js.set r "loss" (Js.from value)
    waiters = Js.get r "waiters"
    Js.set r "waiters" (Js.array [])
    Js.each waiters λw → Task.resume (Js.to w) value
    ops = Js.get r "ops"
    Js.set r "ops" (Js.array [])
    Js.each ops λop → Js.to (Js.apply op [ Js.from value ])


--| The device's hold on its channel ends once the host has reported its
--| loss and no outcome of it is pending (`pops`, the error scopes still to
--| settle): nothing more of it can need the program's defect boundary.
pub settleDevice : V → ⊤
settleDevice r =
    if
        Js.to (Js.get r "final") && int (Js.get r "pops") == 0 && not (Js.to (Js.get r "released"))
    then
        Js.set r "released" (Js.from True)
        release (Js.get r "channel")
    else
        ⊤


--| How a defect names a device and what it did: `device 2, lost`.
pub deviceContext : V, String → String
deviceContext r what = "device " ++ String.fromInt (int (Js.get r "id")) ++ ", " ++ what


--| Hand an unexpected outcome of the device to its program.
pub reportDefect : V, V → ⊤
reportDefect r error = channelDefect (Js.get r "channel") error


-- ---- The lease (§6.4) ---------------------------------------------------------

--| Take the device's diagnostic lease if it is free, never waiting: `True`
--| when it was taken, and then the lease's generation is a new one. While
--| it is held every checked operation on the device refuses at once.
--| What a diagnostic session takes first; the session itself comes later.
pub tryLease : V → Bool
tryLease device =
    r = recordOf device
    if Js.to (Js.get r "leased") then
        False
    else
        Js.set r "leased" (Js.from True)
        Js.set r "generation" (Js.from (int (Js.get r "generation") + 1))
        True


--| Give the device's lease back.
pub releaseLease : V → ⊤
releaseLease device = Js.set (recordOf device) "leased" (Js.from False)


-- ---- One checked host operation (§6.1) ------------------------------------------

--| Whether a checked operation may start on the device, never waiting: a
--| latched loss — `destroy`'s included — is `DeviceLost`, and a held lease
--| `SessionState DeviceLeased`.
pub admit : V, String → Result Error.Error ⊤
admit device operation =
    r = recordOf device
    l = Js.get r "loss"
    if not (Js.isNull l) then
        Err
            (Error.DeviceLost
                { loss = Js.to l, operation = { operation = operation, observed = [] } }
            )
    else if Js.to (Js.get r "leased") then
        Err (Error.InvalidInput (Error.SessionState Error.DeviceLeased))
    else
        Ok ⊤


-- The three filters, pushed in this order and popped in the reverse.
filterName : Int → V
filterName i =
    if i == 0 then
        Js.from "validation"
    else if i == 1 then
        Js.from "out-of-memory"
    else
        Js.from "internal"


-- What one operation's scopes have given so far: per filter the
-- observation (null for none, until it settles), how many pops are owed
-- and settled, the first unexpected outcome, and the fiber's `Resume`
-- once it waits; `done` once the fiber has gone on, `taken` once it took
-- what its wait gave.
newScopes : ⊤ → V
newScopes ⊤ =
    Js.object
        [ ( "results", Js.array [] )
        , ( "pushed", Js.from 0 )
        , ( "current", Js.from 0 )
        , ( "base", Js.from 0 )
        , ( "owed", Js.from 0 )
        , ( "settled", Js.from 0 )
        , ( "unexpected", Js.null )
        , ( "resume", Js.null )
        , ( "done", Js.from False )
        , ( "taken", Js.from False )
        , ( "onLoss", Js.null )
        , ( "made", Js.null )
        , ( "host", Js.null )
        , ( "discard", Js.null )
        ]


--| How a checked operation's wait ended: its scopes all settled, or its
--| device was lost first.
type Waited
    = Scoped
    | LostWhile DeviceLoss


--| One checked host operation (§6.1): `call` makes the one native call,
--| with its own synchronous classifier — `Ok` for what the call made, or
--| the precise `Error` of a host failure the ledger documents for it at
--| that call — between the device's three error scopes, in a section no
--| fiber can interleave; every pop is invoked before anything can suspend,
--| however the call ends; then the operation waits for the pops, or for
--| the device's loss, whichever comes first. A host object the call made
--| is recorded provisional and published only when no scope reported a
--| failure and no loss was observed; otherwise it is recorded rejected and
--| never returned. An unexpected outcome — a pop that rejects, an error of
--| a class its filter does not report — is a defect, even beside an
--| expected failure; one that arrives after the operation went on, or that
--| a cancelled operation leaves, goes to the device's program. `labels`
--| name the resources, for diagnostics.
pub checked : V, String, List String, sync (⊤ → Result Error.Error V) → Result Error.Error V
checked device operation labels call = checkedMaking device operation labels call ignore ignore


--| `checked` for an object that keeps more state than its status: `adopt`
--| fills the made object's record while it is provisional, before anyone
--| can use it, and `discard` releases an object that is rejected (a
--| buffer's memory), whether a scope, a loss or a cancellation rejected it.
pub checkedMaking :
      V
    , String
    , List String
    , sync (⊤ → Result Error.Error V)
    , sync (V → ⊤)
    , sync (V → ⊤)
    → Result Error.Error V
checkedMaking device operation labels call adopt discard =
    case admit device operation of
        Err problem →
            Err problem

        Ok _ →
            r = recordOf device
            scopes = newScopes ⊤
            Js.set scopes "discard" (Js.from discard)
            outcome = section device r scopes operation labels call
            case outcome of
                Ok made →
                    Js.call table "set"
                        [ made
                        , Js.object
                            [ ( "device", r )
                            , ( "native", device )
                            , ( "status", Js.from "provisional" )
                            ]
                        ]
                        ▷ ignore
                    adopt made
                    Js.set scopes "made" made

                Err _ →
                    ⊤
            case settle r scopes operation of
                Err problem →
                    reject scopes
                    Err problem

                Ok observed →
                    case failureOf (ownFailure outcome) observed of
                        Just problem →
                            reject scopes
                            Err problem

                        Nothing →
                            -- `outcome` is `Ok made` here: a failed call is
                            -- its own failure.
                            made = Js.get scopes "made"
                            Js.set (recordOf made) "status" (Js.from "accepted")
                            Ok made


--| A checked operation whose native call answers with a promise
--| (`mapAsync`): `call` makes the call between the scopes, as for
--| `checked`, and gives the promise; `classify` runs in its reaction —
--| whether or not anyone still waits — and names what the ledger documents
--| for it, as `Expected (Ok value)` or `Expected (Err failure)`, and what
--| it does not as `Unexpected`. The operation waits for the pops and the
--| promise, or for the device's loss; the promise's failure joins the
--| scopes' observations, and a loss wins over both.
pub checkedAwait :
      V
    , String
    , List String
    , sync (⊤ → Result Error.Error V)
    , sync (Bool, V → Outcome (Result Error.Error V))
    → Result Error.Error V
checkedAwait device operation labels call classify =
    case admit device operation of
        Err problem →
            Err problem

        Ok _ →
            r = recordOf device
            scopes = newScopes ⊤
            outcome = section device r scopes operation labels call
            case outcome of
                Ok promise →
                    Js.set scopes "owed" (Js.from (int (Js.get scopes "owed") + 1))
                    Js.set r "pops" (Js.from (int (Js.get r "pops") + 1))
                    ch = Js.get r "channel"
                    context = deviceContext r operation
                    Js.call promise "then"
                        [ Js.from λvalue →
                            guard ch context λ⊤ →
                                hostSettled r scopes operation (classified classify True value)
                            popped r
                        , Js.from λerror →
                            guard ch context λ⊤ →
                                hostSettled r scopes operation (classified classify False error)
                            popped r
                        ]
                        ▷ ignore

                Err _ →
                    ⊤
            case settle r scopes operation of
                Err problem →
                    Err problem

                Ok observed →
                    host = Js.get scopes "host"

                    own =
                        case outcome of
                            Err failed →
                                Just failed

                            Ok _ →
                                if Js.isNull host then
                                    defect "a checked promise settled without an outcome"
                                else
                                    case asResult host of
                                        Err failed →
                                            Just failed

                                        Ok _ →
                                            Nothing
                    case failureOf own observed of
                        Just problem →
                            Err problem

                        Nothing →
                            Js.to host


-- The promise of `checkedAwait` settled: its outcome is kept for the
-- operation, or, when unexpected, handled as a pop's.
hostSettled : V, V, String, Outcome (Result Error.Error V) → ⊤
hostSettled r scopes operation outcome =
    case outcome of
        Expected result →
            Js.set scopes "host" (Js.from result)
            counted r scopes

        Unexpected error →
            unexpectedScope r scopes (contextual (deviceContext r operation) error)


-- Steps 5 and 6 up to the combination: wait, throw what was unexpected,
-- and give what the scopes observed, or the loss that wins.
settle : V, V, String → Result Error.Error (List Observation)
settle r scopes operation =
    waited = waitScopes r scopes
    unexpected = Js.get scopes "unexpected"
    if not (Js.isNull unexpected) then
        Js.throw unexpected
    else
        observed = observations scopes

        observedLoss =
            case waited of
                LostWhile l →
                    Just l

                Scoped →
                    l = Js.get r "loss"
                    if Js.isNull l then Nothing else Just (Js.to l)
        case observedLoss of
            Just l →
                Err
                    (Error.DeviceLost
                        { loss = l, operation = { operation = operation, observed = observed } }
                    )

            Nothing →
                Ok observed


ownFailure : Result Error.Error V → Maybe Error.Error
ownFailure outcome =
    case outcome of
        Err failed →
            Just failed

        Ok _ →
            Nothing


-- Step 6 without a loss: the operation's own failure and the scopes'
-- observations together, or none.
failureOf : Maybe Error.Error, List Observation → Maybe Error.Error
failureOf own observed =
    case own of
        Just failed →
            case ( observationOf failed, observed ) of
                ( _, [] ) →
                    Just failed

                ( Just first, _ ) →
                    Just (Error.RelatedFailures { first = first, rest = observed })

                ( Nothing, _ ) →
                    Just failed

        Nothing →
            case observed of
                [] →
                    Nothing

                [ one ] →
                    Just (failure one)

                [ first, …rest ] →
                    Just (Error.RelatedFailures { first = first, rest = rest })


ignore : V → ⊤
ignore _ = ⊤


asResult : V → Result Error.Error V
asResult v = Js.to v


-- What a rejected operation made is rejected and released.
reject : V → ⊤
reject scopes =
    made = Js.get scopes "made"
    if Js.isNull made then
        ⊤
    else
        Js.set (recordOf made) "status" (Js.from "rejected")
        Js.to (Js.apply (Js.get scopes "discard") [ made ])


-- Steps 2–4: enter the section, push the three scopes, make the call, and
-- in a finaliser pop every scope that was pushed, in reverse, with both
-- reactions attached at once, then leave the section. A push or a call
-- that throws goes on after the pops: a defect.
section : V, V, V, String, List String, sync (⊤ → Result Error.Error V) → Result Error.Error V
section device r scopes operation labels call =
    if Js.to (Js.get r "section") then
        defect "a GPU call entered a device's scope section from inside it"
    else
        Js.set r "section" (Js.from True)
        Js.set r "sectionScopes" scopes
        Js.set scopes "native" device
        Js.set scopes "name" (Js.from operation)
        Js.set scopes "labels" (Js.from labels)
        Js.finally
            (λ⊤ →
                pushSegment device scopes
                call ⊤
            )
            λ⊤ →
                Js.set scopes "owed" (Js.get scopes "pushed")
                popSegment device r scopes
                Js.set r "sectionScopes" Js.null
                Js.set r "section" (Js.from False)


-- Push the three scopes of a new segment, counting each once it is pushed.
pushSegment : V, V → ⊤
pushSegment device scopes =
    pushScope device 0
    pushedOne scopes
    pushScope device 1
    pushedOne scopes
    pushScope device 2
    pushedOne scopes


pushedOne : V → ⊤
pushedOne scopes =
    Js.set scopes "pushed" (Js.from (int (Js.get scopes "pushed") + 1))
    Js.set scopes "current" (Js.from (int (Js.get scopes "current") + 1))


-- Pop every scope of the current segment, in reverse, under its name.
popSegment : V, V, V → ⊤
popSegment device r scopes =
    base = int (Js.get scopes "base")
    name = Js.to (Js.get scopes "name")
    labels = Js.to (Js.get scopes "labels")
    popScopes device r scopes name labels base (base + int (Js.get scopes "current") - 1)
    Js.set scopes "base" (Js.from (base + int (Js.get scopes "current")))
    Js.set scopes "current" (Js.from 0)


--| Close the current scope segment of the section open on `device` and
--| start one named `name` (§6.3): its three scopes are popped under the
--| old name, and three new ones pushed. Only inside a section: anywhere
--| else, a wrapper invariant broke.
pub segment : V, String → ⊤
segment device name =
    r = recordOf device
    scopes = Js.get r "sectionScopes"
    if Js.isNullish scopes then
        defect "a scope segment outside a scope section"
    else
        popSegment device r scopes
        Js.set scopes "name" (Js.from name)
        pushSegment device scopes


pushScope : V, Int → ⊤
pushScope device i = Js.to (Js.call device "pushErrorScope" [ filterName i ])


-- Each pop counts as pending on the device until its reaction ran, so the
-- device keeps its channel to the program while one is pending; what a
-- reaction throws goes to that program as a defect. Scope `i` reports the
-- filter `i` modulo 3.
popScopes : V, V, V, String, List String, Int, Int → ⊤
popScopes device r scopes operation labels base i =
    if i < base then
        ⊤
    else
        Js.set r "pops" (Js.from (int (Js.get r "pops") + 1))
        ch = Js.get r "channel"
        context = deviceContext r operation
        Js.call (Js.call device "popErrorScope" []) "then"
            [ Js.from λerror →
                guard ch context λ⊤ → scoped r scopes operation labels i error
                popped r
            , Js.from λerror →
                guard ch context λ⊤ → unexpectedScope r scopes (contextual context error)
                popped r
            ]
            ▷ ignore
        popScopes device r scopes operation labels base (i - 1)


popped : V → ⊤
popped r =
    Js.set r "pops" (Js.from (int (Js.get r "pops") - 1))
    settleDevice r


-- The class each filter reports, by its global's name.
filterClass : Int → String
filterClass i =
    if i == 0 then
        "GPUValidationError"
    else if i == 1 then
        "GPUOutOfMemoryError"
    else
        "GPUInternalError"


isInstance : V, String → Bool
isInstance value name =
    constructor = Js.global name
    not (Js.isUndefined constructor) && Js.instanceOf value constructor


-- A pop settled with `error`: `null` is no error; an error of the class
-- the filter reports is an observation; anything else is unexpected.
scoped : V, V, String, List String, Int, V → ⊤
scoped r scopes operation labels i error =
    if Js.isNull error then
        counted r scopes
    else if not (isInstance error (filterClass (Int.rem i 3))) then
        unexpectedScope
            r
            scopes
            (contextual
                (deviceContext
                    r
                    (operation ++ ", an error scope reporting what its filter does not")
                )
                error
            )
    else
        detail =
            { device = Js.to (Js.get r "id")
            , operation = operation
            , stage = Error.DeviceValidation
            , labels = labels
            , message = messageOf error
            }

        observation =
            if Int.rem i 3 == 0 then
                Error.ObservedValidation detail
            else if Int.rem i 3 == 1 then
                Error.ObservedOutOfMemory detail
            else
                Error.ObservedInternal detail
        Js.setAt (Js.get scopes "results") i (Js.from observation)
        counted r scopes


-- A pop rejected, or reported the wrong class: the first one is kept for
-- the operation, or handed to the program once the operation went on.
unexpectedScope : V, V, V → ⊤
unexpectedScope r scopes error =
    if Js.to (Js.get scopes "done") then
        reportDefect r error
    else
        if Js.isNull (Js.get scopes "unexpected") then Js.set scopes "unexpected" error
        counted r scopes


-- One more pop settled; the fiber waiting goes on when the last one does.
counted : V, V → ⊤
counted r scopes =
    settled = int (Js.get scopes "settled") + 1
    Js.set scopes "settled" (Js.from settled)
    resume = Js.get scopes "resume"
    if
        settled == int (Js.get scopes "owed")
            && not (Js.isNull resume)
            && not (Js.to (Js.get scopes "done"))
    then
        Js.set scopes "done" (Js.from True)
        Task.resume (Js.to resume) Scoped
    else
        ⊤


-- Step 5: wait for the pops, or for the device's loss. However the fiber
-- leaves the wait — taking its outcome, cancelled, or interrupted before
-- it waited — the operation is done: later pops are drained, and an
-- unexpected outcome nobody took goes to the device's program.
waitScopes : V, V → Waited
waitScopes r scopes =
    if int (Js.get scopes "settled") == int (Js.get scopes "owed") then
        Js.set scopes "done" (Js.from True)
        Js.set scopes "taken" (Js.from True)
        Scoped
    else
        Task.onExit
            (λ⊤ →
                waited = Task.callback λresume →
                    Js.set scopes "resume" (Js.from resume)

                    onLoss = Js.from λlatched →
                        if Js.to (Js.get scopes "done") then
                            ⊤
                        else
                            Js.set scopes "done" (Js.from True)
                            Task.resume resume (LostWhile latched)
                    Js.set scopes "onLoss" onLoss
                    Js.call (Js.get r "ops") "push" [ onLoss ] ▷ ignore
                    λ⊤ → ⊤
                Js.set scopes "taken" (Js.from True)
                waited
            )
            λ_ → leaveScopes r scopes


leaveScopes : V, V → ⊤
leaveScopes r scopes =
    Js.set scopes "done" (Js.from True)
    unwatch r scopes
    -- A cancelled operation publishes nothing: what its call made is rejected.
    if not (Js.to (Js.get scopes "taken")) then reject scopes
    unexpected = Js.get scopes "unexpected"
    if not (Js.to (Js.get scopes "taken")) && not (Js.isNull unexpected) then
        Js.set scopes "unexpected" Js.null
        reportDefect r unexpected
    else
        ⊤


-- The operation no longer waits for the device's loss.
unwatch : V, V → ⊤
unwatch r scopes =
    ops = Js.get r "ops"
    at = Js.call ops "indexOf" [ Js.get scopes "onLoss" ]
    if Js.to (Js.ge at (Js.from 0)) then Js.call ops "splice" [ at, Js.from 1 ] ▷ ignore


-- Every observation, in the order of the filters.
observations : V → List Observation
observations scopes =
    results = Js.get scopes "results"
    total : Int
    total = Js.to (Js.get results "length")
    List.filterMap (List.range 0 (total - 1)) λi →
        o = Js.at results i
        if Js.isNullish o then Nothing else Just (Js.to o)


failure : Observation → Error.Error
failure observation =
    case observation of
        Error.ObservedValidation d →
            Error.Validation d

        Error.ObservedOutOfMemory d →
            Error.OutOfMemory d

        Error.ObservedInternal d →
            Error.Internal d

        Error.ObservedPipelineValidation p →
            Error.PipelineValidation p

        Error.ObservedPipelineInternal p →
            Error.PipelineInternal p

        Error.ObservedMapFailed m →
            Error.MapFailed m

        Error.ObservedHostRejection o →
            Error.HostOperationRejected o

        Error.ObservedRefusal i →
            Error.InvalidInput i

        Error.ObservedUnsupported c →
            Error.UnsupportedCapability c


-- The observation a call's own failure is, when it is a leaf a failure
-- set can hold.
observationOf : Error.Error → Maybe Observation
observationOf problem =
    case problem of
        Error.Validation d →
            Just (Error.ObservedValidation d)

        Error.OutOfMemory d →
            Just (Error.ObservedOutOfMemory d)

        Error.Internal d →
            Just (Error.ObservedInternal d)

        Error.PipelineValidation p →
            Just (Error.ObservedPipelineValidation p)

        Error.PipelineInternal p →
            Just (Error.ObservedPipelineInternal p)

        Error.MapFailed m →
            Just (Error.ObservedMapFailed m)

        Error.HostOperationRejected o →
            Just (Error.ObservedHostRejection o)

        Error.InvalidInput i →
            Just (Error.ObservedRefusal i)

        Error.UnsupportedCapability c →
            Just (Error.ObservedUnsupported c)

        _ →
            Nothing


-- ---- Waits on work issued earlier (§6.4, §8.3) ----------------------------------

--| The outcome of one native promise of a device, for any number of
--| later waits: a submission's completion, captured when it was issued.
--| Its reactions are attached at once and always drain it; while it is
--| pending the device keeps its channel to the program (§6.4, *Outcomes
--| that outlive their caller*). `classify` names what the ledger documents
--| for the promise; what it does not is unexpected: thrown in a fiber that
--| waits for it, or, when none does, handed to the device's program.
pub pendingOutcome : V, String, V, sync (Bool, V → Outcome ⊤) → V
pendingOutcome device operation promise classify =
    r = recordOf device
    c =
        Js.object
            [ ( "device", r )
            , ( "operation", Js.from operation )
            , ( "state", Js.from "pending" )
            , ( "error", Js.null )
            , ( "waiters", Js.array [] )
            ]
    Js.set r "pops" (Js.from (int (Js.get r "pops") + 1))
    ch = Js.get r "channel"
    context = deviceContext r operation
    Js.call promise "then"
        [ Js.from λvalue →
            guard ch context λ⊤ → arrived c (classified classify True value)
            popped r
        , Js.from λerror →
            guard ch context λ⊤ → arrived c (classified classify False error)
            popped r
        ]
        ▷ ignore
    c


-- A pending outcome arrived: every waiter wakes with it; an unexpected one
-- nobody waits for goes to the device's program.
arrived : V, Outcome ⊤ → ⊤
arrived c outcome =
    r = Js.get c "device"
    waiters = Js.get c "waiters"
    Js.set c "waiters" (Js.array [])
    case outcome of
        Expected _ →
            Js.set c "state" (Js.from "done")

        Unexpected error →
            Js.set c "state" (Js.from "failed")
            Js.set c "error" error
            if Js.to (Js.get waiters "length") == 0 then
                reportDefect
                    r
                    (contextual (deviceContext r (Js.to (Js.get c "operation"))) error)
            else
                ⊤
    Js.each waiters λw → Js.to (Js.apply w [ Js.from outcome ])


--| Wait for a pending outcome. A loss the device has latched wins, before
--| or while this waits: `DeviceLost`, even for work already done (§8.3);
--| otherwise an outcome that arrived already is answered at once. An unexpected outcome is a defect. A
--| cancelled wait leaves the outcome pending, still drained.
pub awaitPending : V → Result Error.Error ⊤
awaitPending c =
    r = Js.get c "device"
    operation = Js.to (Js.get c "operation")
    state = Js.get c "state"
    l = Js.get r "loss"
    if Js.same state (Js.from "failed") then
        Js.throw (contextual (deviceContext r operation) (Js.get c "error"))
    else if not (Js.isNull l) then
        -- Observed loss wins (§8.3), whether or not the work was done.
        Err
            (Error.DeviceLost
                { loss = Js.to l, operation = { operation = operation, observed = [] } }
            )
    else if Js.same state (Js.from "done") then
        Ok ⊤
    else
        waitPending c r operation


-- Wait for the outcome, or for the device's loss.
waitPending : V, V, String → Result Error.Error ⊤
waitPending c r operation =
    fired = Js.ref False

    got = Task.callback λresume →
        onOutcome = Js.from λo →
            if Js.read fired then
                ⊤
            else
                Js.write fired True
                Task.resume resume (Ok o)
        onLoss = Js.from λlatched →
            if Js.read fired then
                ⊤
            else
                Js.write fired True
                Task.resume resume (Err latched)
        Js.call (Js.get c "waiters") "push" [ onOutcome ] ▷ ignore
        Js.call (Js.get r "ops") "push" [ onLoss ] ▷ ignore
        λ⊤ →
            Js.write fired True
            without (Js.get c "waiters") onOutcome
            without (Js.get r "ops") onLoss
    case got of
        Ok outcome →
            case outcome of
                Expected _ →
                    Ok ⊤

                Unexpected error →
                    Js.throw (contextual (deviceContext r operation) error)

        Err latched →
            Err
                (Error.DeviceLost
                    { loss = latched, operation = { operation = operation, observed = [] } }
                )


-- Drop `item` from the array `list`, if it is there.
without : V, V → ⊤
without list item =
    at = Js.call list "indexOf" [ item ]
    if Js.to (Js.ge at (Js.from 0)) then Js.call list "splice" [ at, Js.from 1 ] ▷ ignore


-- ---- Resource arguments ------------------------------------------------------------

--| A resource argument at `path` (§6.3, §7): an object the engine made on
--| the device of record `onDevice`, accepted — or provisional in `batch`,
--| the live batch the call runs in (null outside one) — and not destroyed,
--| nor, for a texture view, its texture.
--| A provisional object is usable while the batch that made it runs: the
--| batch is synchronous, so whatever code runs then is that batch's.
--| An object the engine did not make is a defect.
pub usable : V, V, V, String → Result Error.InputError ⊤
usable native onDevice batch path =
    o = recordOf native
    status = Js.get o "status"
    if Js.same status (Js.from "rejected") then
        Err (Error.ResourceRejected { path = path })
    else if Js.same status (Js.from "provisional") && not (inLiveBatch o batch) then
        Err (Error.ResourcePending { path = path })
    else if Js.same (Js.get o "destroyed") (Js.from True) || viewOfDestroyed o then
        Err (Error.ResourceDestroyed { path = path })
    else if not (Js.same (Js.get o "device") onDevice) then
        Err (Error.WrongDevice { path = path })
    else
        Ok ⊤


--| Record an object made inside `batch` on the device of record `r`:
--| provisional until the batch settles.
pub adoptInBatch : V, V, V → ⊤
adoptInBatch made r batch =
    Js.call table "set"
        [ made
        , Js.object
            [ ( "device", r )
            , ( "native", Js.get r "self" )
            , ( "status", Js.from "provisional" )
            , ( "batch", batch )
            ]
        ]
        ▷ ignore


--| Set the status of an object the engine made.
pub setStatus : V, String → ⊤
setStatus native status = Js.set (recordOf native) "status" (Js.from status)


--| Whether `value` is an instance of the realm's global `name`, when the
--| realm has one.
pub isInstanceOf : V, String → Bool
isInstanceOf value name = isInstance value name


-- A provisional object of a batch that still runs.
inLiveBatch : V, V → Bool
inLiveBatch o batch =
    made = Js.get o "batch"
    if Js.isNullish made then
        False
    else
        Js.same (Js.get made "live") (Js.from True)


-- A texture view whose texture was destroyed: its record keeps the
-- texture (`Gpu.Make.textureView`).
viewOfDestroyed : V → Bool
viewOfDestroyed o =
    texture = Js.get o "texture"
    if Js.isNullish texture then
        False
    else
        Js.same (Js.get (recordOf texture) "destroyed") (Js.from True)
