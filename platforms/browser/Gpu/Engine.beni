    else if Js.same value (Js.from "snorm16") then
        Types.VertexFormatSnorm16
    else if Js.same value (Js.from "snorm16x2") then
        Types.VertexFormatSnorm16x2
    else if Js.same value (Js.from "snorm16x4") then
        Types.VertexFormatSnorm16x4
    else if Js.same value (Js.from "float16") then
        Types.VertexFormatFloat16
    else if Js.same value (Js.from "float16x2") then
        Types.VertexFormatFloat16x2
    else if Js.same value (Js.from "float16x4") then
        Types.VertexFormatFloat16x4
    else if Js.same value (Js.from "float32") then
        Types.VertexFormatFloat32
    else if Js.same value (Js.from "float32x2") then
        Types.VertexFormatFloat32x2
    else if Js.same value (Js.from "float32x3") then
        Types.VertexFormatFloat32x3
    else if Js.same value (Js.from "float32x4") then
        Types.VertexFormatFloat32x4
    else if Js.same value (Js.from "uint32") then
        Types.VertexFormatUint32
    else if Js.same value (Js.from "uint32x2") then
        Types.VertexFormatUint32x2
    else if Js.same value (Js.from "uint32x3") then
        Types.VertexFormatUint32x3
    else if Js.same value (Js.from "uint32x4") then
        Types.VertexFormatUint32x4
    else if Js.same value (Js.from "sint32") then
        Types.VertexFormatSint32
    else if Js.same value (Js.from "sint32x2") then
        Types.VertexFormatSint32x2
    else if Js.same value (Js.from "sint32x3") then
        Types.VertexFormatSint32x3
    else if Js.same value (Js.from "sint32x4") then
        Types.VertexFormatSint32x4
    else if Js.same value (Js.from "unorm10-10-10-2") then
        Types.VertexFormatUnorm1010102
    else if Js.same value (Js.from "unorm8x4-bgra") then
        Types.VertexFormatUnorm8x4Bgra
    else if Js.same value (Js.from "snorm10-10-10-2") then
        Types.VertexFormatSnorm1010102
    else
        broken "Unexpected VertexFormat value"


