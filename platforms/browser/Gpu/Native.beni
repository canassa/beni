--| Read a native `GPUAdapterInfo` once.
pub readAdapterInfo : Js.Value → Types.AdapterInfo
readAdapterInfo native =
    { vendor = readString native "vendor"
    , architecture = readString native "architecture"
    , device = readString native "device"
    , description = readString native "description"
    , subgroupMinSize = readOptionalInt native "subgroupMinSize"
    , subgroupMaxSize = readOptionalInt native "subgroupMaxSize"
    , isFallbackAdapter = readBool native "isFallbackAdapter"
    }


