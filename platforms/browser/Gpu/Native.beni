    , maxStorageTexturesInFragmentStage = readOptionalInt native "maxStorageTexturesInFragmentStage"
    , maxUniformBuffersPerShaderStage = readInt native "maxUniformBuffersPerShaderStage"
    , maxUniformBufferBindingSize = readInt native "maxUniformBufferBindingSize"
    , maxStorageBufferBindingSize = readInt native "maxStorageBufferBindingSize"
    , minUniformBufferOffsetAlignment = readInt native "minUniformBufferOffsetAlignment"
    , minStorageBufferOffsetAlignment = readInt native "minStorageBufferOffsetAlignment"
    , maxVertexBuffers = readInt native "maxVertexBuffers"
    , maxBufferSize = readInt native "maxBufferSize"
    , maxVertexAttributes = readInt native "maxVertexAttributes"
    , maxVertexBufferArrayStride = readInt native "maxVertexBufferArrayStride"
