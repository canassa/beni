--! The resource creations and queue operations of a device
--! (`docs/design/webgpu.md` §4, §6.1, §6.3), each prepared once and run two
--! ways: as a checked operation of its own (`Gpu.Device`, `Gpu.Queue`) or
--! inside a batch (`Gpu.Batch`). An application never needs it, and its
--! signatures name `Js.Value` (#2256).
--!
--! Preparing checks the inputs — the handles a descriptor names and the
--! device they belong to, the features a format or a query type needs —
--! before any native call. What remains is an `Op`: data, and a tag that
--! `perform` switches on to make the one native call with its own
--! synchronous classifier: what the ledger documents at that call is a
--! precise `Error`, anything else propagates and is a defect. `perform`,
--! `adopt` and `discard` are ordinary `sync` functions, so the checker
--! proves that nothing in the scope section suspends. (A record of `sync`
--! functions would say it more directly, but a record field cannot have a
--! `sync` function type: #2271.)

import Binary
import Browser.Video as Video
import Dict
import Gpu.Engine as Engine
import Gpu.Error as Error
import Gpu.Feature as Feature
import Gpu.Flags as Flags
import Gpu.Formats as Formats
import Gpu.Handle as Handle
import Gpu.Limits as Limits
import Gpu.Memory as Memory
import Gpu.Native as Native
import Gpu.Scalar as Scalar
import Gpu.Session as Session
import Gpu.Types as Types
import Js


type alias V =
    Js.Value


ignore : V → ⊤
ignore _ = ⊤


--| What a prepared operation does, with the data it needs.
pub type Action
    = Create String V
    | CreateBuffer V Int Int Bool
    | CreateTexture V (List Types.TextureFormat)
    | CreateView V (List Types.TextureFormat)
    | CreateRenderPipeline V (List Types.TextureFormat)
    | CreateShader V String
    | CreateQuerySet V
    | CreateBindGroup V V
    | GetBindGroupLayout Int
    | WriteBuffer (List V)
    | WriteTexture (List V)
    | Submit (List Handle.CommandBuffer)
    | CopyExternalImage (List V)
    | ImportExternalTexture V V


--| One prepared operation: its name, the labels of what it touches, the
--| native object it calls (a device, a pipeline or a queue), the device it
--| runs on, and what it does.
pub type alias Op =
    name : String
    labels : List String
    target : V
    device : V
    action : Action


--| Make the native call of a prepared operation, with its classifier: what
--| it made, or a documented failure.
pub perform : Op → Result Error.Error V
perform op =
    target = op.target
    case op.action of
        Create method converted →
            Ok (callNamed target method converted)

        CreateBuffer converted bytes _ mapped →
            if mapped then
                -- The ledger's one synchronous failure (§3): the CPU memory
                -- of the mapping, once the size passed.
                Js.catchIf
                    (λ⊤ → Ok (Js.call target "createBuffer" [ converted ]))
                    Engine.isRangeError
                    λerror →
                        Err
                            (Error.MapFailed
                                (Error.MappedAllocationFailed
                                    { bytes = bytes, message = Engine.messageOf error }
                                )
                            )
            else
                Ok (Js.call target "createBuffer" [ converted ])

        CreateTexture converted formats →
            Formats.formatChecked formats λ⊤ → Js.call target "createTexture" [ converted ]

        CreateView converted formats →
            Formats.formatChecked formats λ⊤ → Js.call target "createView" [ converted ]

        CreateRenderPipeline converted formats →
            Formats.formatChecked formats λ⊤ → Js.call target "createRenderPipeline" [ converted ]

        CreateShader converted _ →
            Ok (Js.call target "createShaderModule" [ converted ])

        CreateQuerySet converted →
            Ok (Js.call target "createQuerySet" [ converted ])

        CreateBindGroup converted _ →
            Ok (Js.call target "createBindGroup" [ converted ])

        GetBindGroupLayout index →
            Ok (Js.call target "getBindGroupLayout" [ Js.from index ])

        WriteBuffer args →
            case args of
                [ a1, a2, a3, a4, a5 ] →
                    Js.catchIf
                        (λ⊤ →
                            Js.call target "writeBuffer" [ a1, a2, a3, a4, a5 ] ▷ ignore
                            -- What the call made: nothing but its outcome.
                            Ok (Js.object [])
                        )
                        (λerror → Engine.isDomException error "OperationError")
                        λerror →
                            Err
                                (Error.HostOperationRejected
                                    (Error.BufferWriteSourceRejected
                                        { message = Engine.messageOf error }
                                    )
                                )

                _ →
                    Engine.defect "a writeBuffer prepared without its five arguments"

        WriteTexture args →
            case args of
                [ a1, a2, a3, a4 ] →
                    Js.call target "writeTexture" [ a1, a2, a3, a4 ] ▷ ignore
                    Ok (Js.object [])

                _ →
                    Engine.defect "a writeTexture prepared without its four arguments"

        CopyExternalImage args →
            case args of
                [ a1, a2, a3 ] →
                    -- The ledger's three content-timeline failures (§6).
                    Js.catchIf
                        (λ⊤ →
                            Js.call target "copyExternalImageToTexture" [ a1, a2, a3 ] ▷ ignore
                            Ok (Js.object [])
                        )
                        (λerror →
                            Engine.isDomException error "SecurityError"
                                || Engine.isDomException error "OperationError"
                                || Engine.isDomException error "InvalidStateError"
                        )
                        λerror → Err (Error.SourceFailed (sourceFailure error))

                _ →
                    Engine.defect
                        "a copyExternalImageToTexture prepared without its three arguments"

        ImportExternalTexture converted _ →
            -- The ledger's two content-timeline failures (§6); a source the
            -- host finds bad without throwing is the device's validation error.
            Js.catchIf
                (λ⊤ → Ok (Js.call target "importExternalTexture" [ converted ]))
                (λerror →
                    Engine.isDomException error "SecurityError"
                        || Engine.isDomException error "InvalidStateError"
                )
                λerror → Err (Error.SourceFailed (sourceFailure error))

        Submit commands →
            List.foldl commands ⊤ λc _ →
                Js.set (Engine.recordOf (Js.from c)) "submitted" (Js.from True)
            Js.call target "submit" [ Native.array commands λc → Js.from c ] ▷ ignore
            Ok
                (Engine.pendingOutcome
                    op.device
                    "onSubmittedWorkDone"
                    (Js.call target "onSubmittedWorkDone" [])
                    workDone
                )


-- A source failure the host threw, already known to be one of the
-- ledger's: `SecurityError`, `OperationError` or `InvalidStateError`.
sourceFailure : V → Error.SourceError
sourceFailure error =
    if Engine.isDomException error "SecurityError" then
        Error.SourceNotOriginClean
    else if Engine.isDomException error "OperationError" then
        Error.ExternalImageCopyRangeRejected { message = Engine.messageOf error }
    else
        Error.SourceUnusable { message = Engine.messageOf error }


-- The creations with no failure of their own, by the method's name.
callNamed : V, String, V → V
callNamed target method converted =
    if method == "createSampler" then
        Js.call target "createSampler" [ converted ]
    else if method == "createBindGroupLayout" then
        Js.call target "createBindGroupLayout" [ converted ]
    else if method == "createPipelineLayout" then
        Js.call target "createPipelineLayout" [ converted ]
    else if method == "createComputePipeline" then
        Js.call target "createComputePipeline" [ converted ]
    else
        Engine.defect ("no prepared creation " ++ method)


--| Fill the record of what an operation made, while it is provisional.
pub adopt : Op, V → ⊤
adopt op made =
    case op.action of
        CreateBuffer _ bytes usage mapped →
            Memory.adoptBuffer op.device made bytes usage mapped

        CreateTexture _ _ →
            Js.set (Engine.recordOf made) "destroyed" (Js.from False)

        CreateQuerySet _ →
            Js.set (Engine.recordOf made) "destroyed" (Js.from False)

        CreateShader _ code →
            Js.set (Engine.recordOf made) "code" (Js.from code)

        CreateView _ _ →
            -- A view keeps its texture, so a check of the view sees it, and
            -- the frame mark of a frame's texture (§8.2).
            Js.set (Engine.recordOf made) "texture" op.target
            Engine.markView made op.target

        CreateBindGroup _ uses →
            Js.set (Engine.recordOf made) "uses" uses

        ImportExternalTexture _ frame →
            Engine.expiresExternal made (Js.get (Engine.recordOf made) "batch") frame

        _ →
            ⊤


--| Release what an operation made, rejected: a buffer, a texture or a
--| query set is destroyed.
pub discard : Op, V → ⊤
discard op made =
    case op.action of
        CreateBuffer _ _ _ _ →
            Memory.destroy made

        CreateTexture _ _ →
            Js.call made "destroy" [] ▷ ignore

        CreateQuerySet _ →
            Js.call made "destroy" [] ▷ ignore

        _ →
            ⊤


--| Run a prepared operation as a checked operation of its own (§6.1).
pub checked : Result Error.Error Op → Result Error.Error V
checked prepared = checkedIn Js.null prepared


--| Run a prepared operation as a checked operation of its own, or, when
--| `session` is not null, as a forwarding call of that diagnostic session
--| (§6.4): under the session's scopes, provisional until it settles.
pub checkedIn : V, Result Error.Error Op → Result Error.Error V
checkedIn session prepared =
    op = prepared?
    Engine.checkedIn session op.device op.name op.labels (λ⊤ → perform op) (λm → adopt op m) λm →
        discard op m


--| The labels of an optional label.
pub labelsOf : Types.Option String → List String
labelsOf l =
    case l of
        Types.Value text →
            [ text ]

        Types.Default →
            []


-- A handle argument, as the engine checks it.
handle : V, V, V, String → Result Error.Error ⊤
handle native r batch path = Result.mapError (Engine.usable native r batch path) Error.InvalidInput


-- In a batch, an object the call is made on (a pipeline, a queue) must be
-- of the batch's device (§6.3).
ofBatch : V, V, String → Result Error.Error ⊤
ofBatch native batch path =
    if
        Js.isNull batch
            || Js.same (Js.get (Engine.recordOf native) "device") (Js.get batch "device")
    then
        Ok ⊤
    else
        Err (Error.InvalidInput (Error.WrongDevice { path = path }))


creation : V, String, Types.Option String, V → Op
creation device method label converted =
    { name = method
    , labels = labelsOf label
    , target = device
    , device = device
    , action = Create method converted
    }


--| A sampler.
pub sampler : V, Types.SamplerDescriptor → Result Error.Error Op
sampler device descriptor =
    -- The ledger documents no synchronous failure of `createSampler` (§3).
    Ok (creation device "createSampler" descriptor.label (Native.samplerDescriptor descriptor))


--| A buffer (§7.1): a mapped-at-creation size that is not a multiple of 4
--| is refused first; then the CPU memory of the mapping is the call's one
--| documented failure. A rejected buffer is destroyed.
pub buffer : V, Types.BufferDescriptor → Result Error.Error Op
buffer device descriptor =
    bytes = Scalar.size64ToInt descriptor.size

    mapped =
        case descriptor.mappedAtCreation of
            Types.Value True →
                True

            _ →
                False
    if mapped && Int.rem bytes 4 ≠ 0 then
        Err (Error.InvalidInput (Error.MappedSizeUnaligned { path = "size", size = bytes }))
    else
        Ok
            { name = "createBuffer"
            , labels = labelsOf descriptor.label
            , target = device
            , device = device
            , action =
                CreateBuffer
                    (Native.bufferDescriptor descriptor)
                    bytes
                    (Flags.bufferUsagesBits descriptor.usage)
                    mapped
            }


--| A texture: a format or view format whose feature the device lacks is
--| refused before the native call (`UnsupportedCapability`); a `TypeError`
--| of the native format check is `FormatFeatureRejected` only when a format
--| it names needs a feature (ledger §3), and a defect otherwise. A rejected
--| texture is destroyed.
pub texture : V, Types.TextureDescriptor → Result Error.Error Op
texture device descriptor =
    formats = [ descriptor.format, …(viewFormats descriptor) ]
    Formats.formatsAvailable device formats?
    Ok
        { name = "createTexture"
        , labels = labelsOf descriptor.label
        , target = device
        , device = device
        , action = CreateTexture (Native.textureDescriptor descriptor) formats
        }


viewFormats : Types.TextureDescriptor → List Types.TextureFormat
viewFormats descriptor =
    case descriptor.viewFormats of
        Types.Value formats →
            formats

        Types.Default →
            []


--| A bind group layout.
pub bindGroupLayout : V, Types.BindGroupLayoutDescriptor → Result Error.Error Op
bindGroupLayout device descriptor =
    Ok
        (creation
            device
            "createBindGroupLayout"
            descriptor.label
            (Native.bindGroupLayoutDescriptor descriptor)
        )


--| A bind group: its layout and every resource it binds must be usable on
--| the device (in `batch`, when it runs in one). The group remembers what
--| it binds, so a submit can refuse a command buffer that would use a
--| destroyed or mapped resource through it.
pub bindGroup : V, V, Types.BindGroupDescriptor → Result Error.Error Op
bindGroup device batch descriptor =
    r = Engine.recordOf device
    handle (Js.from descriptor.layout) r batch "layout"?
    each
        descriptor.entries
        (λentry → handle (resourceObject entry.resource) r batch "entries.resource")?
    uses = Native.array descriptor.entries λentry → resourceObject entry.resource
    Ok
        { name = "createBindGroup"
        , labels = labelsOf descriptor.label
        , target = device
        , device = device
        , action = CreateBindGroup (Native.bindGroupDescriptor descriptor) uses
        }


-- The native object a binding names.
resourceObject : Types.BindingResource → V
resourceObject resource =
    case resource of
        Types.SamplerBinding s →
            Js.from s

        Types.TextureBinding t →
            Js.from t

        Types.TextureViewBinding v →
            Js.from v

        Types.WholeBufferBinding b →
            Js.from b

        Types.BufferRangeBinding b →
            Js.from b.buffer

        Types.ExternalTextureBinding x →
            Js.from x


--| A pipeline layout: every layout it names must be usable.
pub pipelineLayout : V, V, Types.PipelineLayoutDescriptor → Result Error.Error Op
pipelineLayout device batch descriptor =
    r = Engine.recordOf device
    each descriptor.bindGroupLayouts (slotUsable r batch _)?
    Ok
        (creation
            device
            "createPipelineLayout"
            descriptor.label
            (Native.pipelineLayoutDescriptor descriptor)
        )


slotUsable : V, V, Maybe Handle.BindGroupLayout → Result Error.Error ⊤
slotUsable r batch slot =
    case slot of
        Just layout →
            handle (Js.from layout) r batch "bindGroupLayouts"

        Nothing →
            Ok ⊤


--| A shader module. Invalid WGSL is the device's to report (`Validation`),
--| and `Gpu.Device.createShaderModule` carries the compiler's messages with
--| it.
pub shaderModule : V, Types.ShaderModuleDescriptor → Result Error.Error Op
shaderModule device descriptor =
    Ok
        { name = "createShaderModule"
        , labels = labelsOf descriptor.label
        , target = device
        , device = device
        , action = CreateShader (Native.shaderModuleDescriptor descriptor) descriptor.code
        }


--| The handles a compute pipeline names: its layout when explicit, and its
--| module.
pub computeHandles : V, V, Types.ComputePipelineDescriptor → Result Error.Error ⊤
computeHandles device batch descriptor =
    r = Engine.recordOf device
    case descriptor.layout of
        Types.Explicit layout →
            handle (Js.from layout) r batch "layout"?

        Types.Auto →
            ⊤
    handle (Js.from descriptor.compute.module) r batch "compute.module"


--| A compute pipeline, made at once (the synchronous form).
pub computePipeline : V, V, Types.ComputePipelineDescriptor → Result Error.Error Op
computePipeline device batch descriptor =
    computeHandles device batch descriptor?
    Ok
        (creation
            device
            "createComputePipeline"
            descriptor.label
            (Native.computePipelineDescriptor descriptor)
        )


--| A query set: a timestamp query needs the `timestamp-query` feature,
--| refused before the native call, which would throw a `TypeError`. A
--| rejected query set is destroyed.
pub querySet : V, Types.QuerySetDescriptor → Result Error.Error Op
querySet device descriptor =
    features = Feature.fromNames (Engine.readNames device "features")
    if
        descriptor.type_ == Types.Timestamp
            && not (Feature.has features Types.FeatureTimestampQuery)
    then
        Err (Error.UnsupportedCapability (Error.MissingFeature Types.FeatureTimestampQuery))
    else
        Ok
            { name = "createQuerySet"
            , labels = labelsOf descriptor.label
            , target = device
            , device = device
            , action = CreateQuerySet (Native.querySetDescriptor descriptor)
            }


--| The bind group layout of a pipeline at `index`: the pipeline must be
--| usable, of the batch's device in a batch, and the index below the
--| device's `maxBindGroups` (`OutOfRange`), all before the native call.
pub getBindGroupLayout : V, V, Scalar.U32 → Result Error.Error Op
getBindGroupLayout pipeline batch index =
    p = Engine.recordOf pipeline
    ofBatch pipeline batch "pipeline"?
    handle pipeline (Js.get p "device") batch "pipeline"?
    device = Js.get p "native"
    at = Scalar.u32ToInt index

    groups =
        case
            Limits.limit (Native.readLimits (Engine.member device "limits")) Limits.MaxBindGroups
        of
            Just n →
                n

            Nothing →
                Engine.defect "the host gave no maxBindGroups"
    if at ≥ groups then
        Err
            (Error.InvalidInput
                (Error.OutOfRange { path = "index", offset = at, size = 1, available = groups })
            )
    else
        Ok
            { name = "getBindGroupLayout"
            , labels = [ Js.to (Js.get pipeline "label") ]
            , target = pipeline
            , device = device
            , action = GetBindGroupLayout at
            }


--| `check` on every element, stopping at the first `Err`.
pub each : List a, (a → Result e ⊤) → Result e ⊤
each xs check =
    case xs of
        [] →
            Ok ⊤

        [ x, …rest ] →
            check x?
            each rest check


--| A queue write (ledger §5): the queue of the batch's device in a batch,
--| the buffer usable there, the data fixed and attached, the part inside it
--| and a multiple of 4 bytes. The host's `OperationError` at the call is
--| `BufferWriteSourceRejected`. The call makes nothing of its own.
pub writeBuffer : V, V, Handle.Buffer, Memory.WriteBufferSource → Result Error.Error Op
writeBuffer queue batch target write =
    ofBatch queue batch "queue"?
    q = Engine.recordOf queue
    Result.mapError (writePreflight q batch target write) Error.InvalidInput?

    sizeArg =
        case write.size of
            Just s →
                Js.from s

            Nothing →
                Js.undefined
    Ok
        { name = "writeBuffer"
        , labels = [ Js.to (Js.get (Js.from target) "label") ]
        , target = queue
        , device = Js.get q "native"
        , action =
            WriteBuffer
                [ Js.from target
                , Js.from write.bufferOffset
                , Memory.sourceObject write.data
                , Js.from write.dataOffset
                , sizeArg
                ]
        }


writePreflight : V, V, Handle.Buffer, Memory.WriteBufferSource → Result Error.InputError ⊤
writePreflight q batch target write =
    Engine.usable (Js.from target) (Js.get q "device") batch "buffer"?
    _ = Memory.size64 write.bufferOffset "bufferOffset"?
    info = Memory.sourceInfo write.data "data"?
    -- The content timeline's checks of `writeBuffer`, in the data's units.
    dataSize = info.elementLength
    dataOffset = Memory.size64 write.dataOffset "dataOffset"?
    if dataOffset > dataSize then
        Err
            (Error.OutOfRange
                { path = "dataOffset", offset = dataOffset, size = 0, available = dataSize }
            )
    else
        contents =
            case write.size of
                Just s →
                    Memory.size64 s "size"?

                Nothing →
                    dataSize - dataOffset
        if contents > dataSize - dataOffset then
            Err
                (Error.OutOfRange
                    { path = "size"
                    , offset = dataOffset * info.bytesPerElement
                    , size = contents * info.bytesPerElement
                    , available = info.byteLength
                    }
                )
        else
            Memory.aligned (contents * info.bytesPerElement) 4 "size"


--| A submit (§8.3; ledger §5): the queue of the batch's device in a batch,
--| every command buffer usable there, not submitted before, named once,
--| and none using a resource that was destroyed since it was encoded
--| (`ResourceDestroyed`) or is mapped or being mapped (`MappingState`). The
--| call marks them submitted, makes the one native submit and captures the
--| queue's completion in the receipt, which it makes.
pub submit : V, V, List Handle.CommandBuffer → Result Error.Error Op
submit queue batch commands =
    ofBatch queue batch "queue"?
    q = Engine.recordOf queue
    Result.mapError (submitPreflight q batch commands) Error.InvalidInput?
    Ok
        { name = "submit"
        , labels = []
        , target = queue
        , device = Js.get q "native"
        , action = Submit commands
        }


-- `onSubmittedWorkDone` documents no rejection (ledger §5).
workDone : Bool, V → Engine.Outcome ⊤
workDone fulfilled value = if fulfilled then Engine.Expected ⊤ else Engine.Unexpected value


submitPreflight : V, V, List Handle.CommandBuffer → Result Error.InputError ⊤
submitPreflight q batch commands =
    seen = Js.construct (Js.global "Set") []
    each commands (submittable q batch seen _)


submittable : V, V, V, Handle.CommandBuffer → Result Error.InputError ⊤
submittable q batch seen command =
    native = Js.from command
    Engine.usable native (Js.get q "device") batch "commands"?
    if Js.same (Js.get (Engine.recordOf native) "submitted") (Js.from True) then
        Err (Error.CommandBufferSubmitted { path = "commands" })
    else if Js.to (Js.call seen "has" [ native ]) then
        Err (Error.DuplicateCommandBuffer { path = "commands" })
    else
        Js.call seen "add" [ native ] ▷ ignore
        each (Js.to (Js.call (Js.global "Array") "from" [ Session.usesOf native ])) resourceReady


-- A resource a command buffer uses, at submit: not destroyed, not mapped.
resourceReady : V → Result Error.InputError ⊤
resourceReady native =
    r = Engine.recordOf native
    if Js.same (Js.get r "destroyed") (Js.from True) then
        Err (Error.ResourceDestroyed { path = "commands" })
    else
        state = Js.get r "state"
        if Js.same state (Js.from "mapped") then
            Err (Error.MappingState { path = "commands", state = Types.Mapped })
        else if Js.same state (Js.from "pending") then
            Err (Error.MappingState { path = "commands", state = Types.Pending })
        else
            Ok ⊤


--| A queue write into a texture (ledger §5): the queue of the batch's
--| device in a batch, the texture usable there and the data fixed and
--| attached; copy layouts, extents and texel blocks are the device's to
--| validate, and the call documents no host failure of its own. The call
--| makes nothing of its own.
pub writeTexture :
      V
    , V
    , Types.TexelCopyTextureInfo
    , Binary.Source
    , Types.TexelCopyBufferLayout
    , Types.Extent3D
    → Result Error.Error Op
writeTexture queue batch destination data layout extent =
    ofBatch queue batch "queue"?
    q = Engine.recordOf queue
    Result.mapError
        (Engine.usable (Js.from destination.texture) (Js.get q "device") batch "destination.texture"
        )
        Error.InvalidInput?
    _ = Result.mapError (Memory.sourceInfo data "data") Error.InvalidInput?
    Ok
        { name = "writeTexture"
        , labels = [ Js.to (Js.get (Js.from destination.texture) "label") ]
        , target = queue
        , device = Js.get q "native"
        , action =
            WriteTexture
                [ Native.texelCopyTextureInfo destination
                , Memory.sourceObject data
                , Native.texelCopyBufferLayout layout
                , Native.extent3D extent
                ]
        }


-- ---- Compilation messages ------------------------------------------------------

--| Every message the compiler gave for a module, read from the host: a
--| message kind outside the pin, or a position that is not a non-negative
--| integer, is a defect, as for every snapshot (§2.2). The host documents
--| no rejection (ledger §3): one is a defect too. `DeviceLost` when the
--| device is lost first. May suspend.
pub compilationInfo : V → Result Error.Error Error.CompilationInfo
compilationInfo shader =
    record = Engine.recordOf shader
    info = Js.ref Nothing

    pending =
        Engine.pendingOutcome
            (Js.get record "native")
            "getCompilationInfo"
            (Js.call shader "getCompilationInfo" [])
            λfulfilled value →
                if fulfilled then
                    Js.write info (Just (readInfo value))
                    Engine.Expected ⊤
                else
                    Engine.Unexpected value
    Engine.awaitPending pending?
    case Js.read info of
        Just i →
            Ok i

        Nothing →
            Engine.defect "getCompilationInfo settled without its messages"


readInfo : V → Error.CompilationInfo
readInfo value =
    messages = Js.call (Js.global "Array") "from" [ Engine.member value "messages" ]
    total : Int
    total = Js.to (Js.get messages "length")
    { messages = List.map (List.range 0 (total - 1)) λi → readMessage (Js.at messages i) }


readMessage : V → Error.CompilationMessage
readMessage m =
    kind =
        case Types.compilationMessageTypeFromString (Js.to (Js.get m "type")) of
            Just k →
                k

            Nothing →
                Engine.defect "a compilation message of a type outside the pin"

    text = Js.get m "message"
    { message =
        if Js.typeIs text "string" then
            Js.to text
        else
            Engine.defect "a compilation message without its text"
    , type_ = kind
    , lineNum = count m "lineNum"
    , linePos = count m "linePos"
    , offset = count m "offset"
    , length = count m "length"
    }


-- A member that is a non-negative integer, or a defect naming it.
count : V, String → Int
count m name =
    value = Js.get m name
    if
        Js.typeIs value "number"
            && Js.to (Js.call (Js.global "Number") "isInteger" [ value ])
            && Js.to (Js.ge value (Js.from 0))
    then
        Js.to value
    else
        Engine.defect ("a compilation message whose `" ++ name ++ "` is not a non-negative integer")


-- ---- Formats, views and render pipelines (S3) -------------------------------

--| A view of `texture` (a native texture of `device`, in `batch` or null):
--| the texture must be usable, and a view format whose feature the device
--| lacks is refused before the native call. The view keeps its texture in
--| its record, so a check of the view can see the texture's state.
pub textureView : V, V, V, Types.TextureViewDescriptor → Result Error.Error Op
textureView device batch target descriptor =
    ofBatch target batch "texture"?
    handle target (Engine.recordOf device) batch "texture"?

    formats =
        case descriptor.format of
            Types.Value f →
                [ f ]

            Types.Default →
                []
    Formats.formatsAvailable device formats?
    Ok
        { name = "createView"
        , labels = labelsOf descriptor.label
        , target = target
        , device = device
        , action = CreateView (Native.textureViewDescriptor descriptor) formats
        }


--| The formats a render pipeline names: its color targets' and its depth
--| and stencil format.
pub renderFormats : Types.RenderPipelineDescriptor → List Types.TextureFormat
renderFormats descriptor =
    targets =
        case descriptor.fragment of
            Types.Value fragment →
                List.filterMap fragment.targets λt → Maybe.map t λc → c.format

            Types.Default →
                []
    case descriptor.depthStencil of
        Types.Value d →
            [ …targets, d.format ]

        Types.Default →
            targets


--| The handles a render pipeline names — its layout when explicit, its
--| vertex and fragment modules — and the features of its formats.
pub renderHandles : V, V, Types.RenderPipelineDescriptor → Result Error.Error ⊤
renderHandles device batch descriptor =
    r = Engine.recordOf device
    case descriptor.layout of
        Types.Explicit layout →
            handle (Js.from layout) r batch "layout"?

        Types.Auto →
            ⊤
    handle (Js.from descriptor.vertex.module) r batch "vertex.module"?
    case descriptor.fragment of
        Types.Value fragment →
            handle (Js.from fragment.module) r batch "fragment.module"?

        Types.Default →
            ⊤
    Formats.formatsAvailable device (renderFormats descriptor)


--| A render pipeline, made at once (the synchronous form).
pub renderPipeline : V, V, Types.RenderPipelineDescriptor → Result Error.Error Op
renderPipeline device batch descriptor =
    renderHandles device batch descriptor?
    Ok
        { name = "createRenderPipeline"
        , labels = labelsOf descriptor.label
        , target = device
        , device = device
        , action =
            CreateRenderPipeline
                (Native.renderPipelineDescriptor descriptor)
                (renderFormats descriptor)
        }


-- ---- Runs that a diagnostic session forwards (§6.4) ---------------------------
--
-- Each is the body of a public operation, with the session that forwards
-- it, or null for the ordinary call: `Gpu.Device`, `Gpu.Surface`,
-- `Gpu.Encode`, `Gpu.Batch` and `Gpu.Frame` call them with null, and the
-- `Gpu.Diagnostics` modules with the session.

--| A shader module (`Gpu.Device.createShaderModule`): invalid WGSL that a
--| scope of the operation reports is `ShaderRejected`, with the compiler's
--| messages read before the failure is returned.
pub shaderModuleIn : V, V, Types.ShaderModuleDescriptor → Result Error.Error V
shaderModuleIn session device descriptor =
    op = shaderModule device descriptor?
    shader = Js.ref Js.null

    result =
        Engine.checkedIn
            session
            op.device
            op.name
            op.labels
            (λ⊤ → perform op)
            (λm →
                Js.write shader m
                adopt op m
            )
            λm → discard op m
    case result of
        Ok m →
            Ok m

        Err (Error.Validation detail) →
            if Js.isNull (Js.read shader) then
                Err (Error.Validation detail)
            else
                info = compilationInfo (Js.read shader)?
                Err (Error.ShaderRejected { failure = detail, messages = info.messages })

        Err problem →
            Err problem


--| A compute pipeline by the native asynchronous call
--| (`Gpu.Device.createComputePipelineAsync`).
pub computePipelineAsyncIn : V, V, Types.ComputePipelineDescriptor → Result Error.Error V
computePipelineAsyncIn session native descriptor =
    computeHandles native Js.null descriptor?
    converted = Native.computePipelineDescriptor descriptor
    r = Engine.recordOf native

    result =
        Engine.checkedAwaitIn
            session
            native
            "createComputePipelineAsync"
            (labelsOf descriptor.label)
            (λ⊤ → Ok (Js.call native "createComputePipelineAsync" [ converted ]))
            λfulfilled value →
                if fulfilled then
                    Engine.adoptInBatch value r Js.null
                    Engine.Expected (Ok value)
                else
                    pipelineFailure "createComputePipelineAsync" (entryPoints descriptor) value
    case result of
        Ok pipeline →
            Engine.publish session pipeline ignore?
            Ok pipeline

        Err problem →
            Err problem


--| A rejected asynchronous pipeline: a native `GPUPipelineError` of a reason
--| in the pin, or unexpected.
pub pipelineFailure : String, List String, V → Engine.Outcome (Result Error.Error V)
pipelineFailure operation entries error =
    if not (Engine.isInstanceOf error "GPUPipelineError") then
        Engine.Unexpected error
    else
        reason = Js.get error "reason"
        failure = { operation = operation, message = Engine.messageOf error, entryPoints = entries }
        if Js.same reason (Js.from "validation") then
            Engine.Expected (Err (Error.PipelineValidation failure))
        else if Js.same reason (Js.from "internal") then
            Engine.Expected (Err (Error.PipelineInternal failure))
        else
            Engine.Unexpected error


-- The entry points a compute pipeline descriptor asks for.
entryPoints : Types.ComputePipelineDescriptor → List String
entryPoints descriptor =
    case descriptor.compute.entryPoint of
        Types.Value name →
            [ name ]

        Types.Default →
            []


--| A render pipeline by the native asynchronous call
--| (`Gpu.Device.createRenderPipelineAsync`).
pub renderPipelineAsyncIn : V, V, Types.RenderPipelineDescriptor → Result Error.Error V
renderPipelineAsyncIn session native descriptor =
    renderHandles native Js.null descriptor?
    formats = renderFormats descriptor
    converted = Native.renderPipelineDescriptor descriptor
    r = Engine.recordOf native

    result =
        Engine.checkedAwaitIn
            session
            native
            "createRenderPipelineAsync"
            (labelsOf descriptor.label)
            (λ⊤ → Ok (Js.call native "createRenderPipelineAsync" [ converted ]))
            λfulfilled value →
                if fulfilled then
                    Engine.adoptInBatch value r Js.null
                    Engine.Expected (Ok value)
                else
                    candidates = Formats.gated formats
                    if candidates ≠ [] && Engine.isTypeError value then
                        Engine.Expected (Err (Formats.formatFailure candidates value))
                    else
                        pipelineFailure
                            "createRenderPipelineAsync"
                            (renderEntryPoints descriptor)
                            value
    case result of
        Ok pipeline →
            Engine.publish session pipeline ignore?
            Ok pipeline

        Err problem →
            Err problem


-- The entry points a render pipeline descriptor asks for: its vertex
-- stage's, then its fragment stage's.
renderEntryPoints : Types.RenderPipelineDescriptor → List String
renderEntryPoints descriptor =
    vertex =
        case descriptor.vertex.entryPoint of
            Types.Value name →
                [ name ]

            Types.Default →
                []

    fragment =
        case descriptor.fragment of
            Types.Value f →
                case f.entryPoint of
                    Types.Value name →
                        [ name ]

                    Types.Default →
                        []

            Types.Default →
                []
    [ …vertex, …fragment ]


--| Configure a surface (`Gpu.Surface.configure`) on the configuration's
--| device. Under a session the surface is configured at once, and a
--| session that rejects what it made unconfigures it for frames again.
pub configureIn : V, V, Types.CanvasConfiguration → Result Error.Error ⊤
configureIn session native configuration =
    s = Engine.recordOf native
    device = Js.from configuration.device

    views =
        case configuration.viewFormats of
            Types.Value formats →
                formats

            Types.Default →
                []
    -- A refusal before the native call changes nothing of the surface.
    if Js.isNull session then
        Engine.admit device "configure"?
    else
        Engine.sessionAdmit session device "configure"?
    Formats.formatsAvailable device [ configuration.format, …views ]?
    converted = Native.canvasConfiguration configuration
    Engine.nextGeneration s
    Js.set s "device" Js.null
    generation = Js.get s "generation"

    result =
        Engine.checkedIn
            session
            device
            "configure"
            []
            (λ⊤ →
                Js.catchIf
                    (λ⊤ →
                        Js.call native "configure" [ converted ] ▷ ignore
                        Ok (Js.object [])
                    )
                    Engine.isTypeError
                    λerror →
                        Err
                            (Error.CanvasFailed
                                (Error.CanvasConfigurationRejected
                                    { message = Engine.messageOf error }
                                )
                            )
            )
            ignore
            ignore
    case result of
        Ok _ →
            -- Unless the surface was configured or unconfigured again while
            -- this configuration was checked.
            if Js.same (Js.get s "generation") generation then Js.set s "device" device else ⊤
            if Js.isNull session then
                ⊤
            else
                Engine.afterSession session λstatus →
                    if status == "rejected" && Js.same (Js.get s "generation") generation then
                        Js.set s "device" Js.null
                    else
                        ⊤
            Ok ⊤

        Err problem →
            Err problem


--| Encode with a new command encoder of `device` (`Gpu.Encode.run`).
pub encodeIn :
      V
    , V
    , Types.CommandEncoderDescriptor
    , sync (Handle.CommandEncoder → Result Error.InputError a)
    → Result Error.Error { value : a, commands : Handle.CommandBuffer }
encodeIn session native descriptor body =
    value = Js.ref Nothing

    made =
        Engine.checkedIn
            session
            native
            "encode"
            (labelsOf descriptor.label)
            (λ⊤ → Session.encode native Js.null descriptor (λenc → body (Js.to enc)) value)
            ignore
            ignore
    case ( made, Js.read value ) of
        ( Ok commands, Just v ) →
            Ok { value = v, commands = Js.to commands }

        ( Ok _, Nothing ) →
            Engine.defect "an encoding run published commands without a value"

        ( Err problem, _ ) →
            Err problem


--| Encode a render bundle with a new bundle encoder of `device`
--| (`Gpu.Encode.bundle`).
pub bundleIn :
      V
    , V
    , Types.RenderBundleEncoderDescriptor
    , sync (Handle.RenderBundleEncoder → Result Error.InputError a)
    → Result Error.Error { value : a, bundle : Handle.RenderBundle }
bundleIn session native descriptor body =
    Formats.formatsAvailable native (Formats.bundleFormats descriptor)?
    value = Js.ref Nothing

    made =
        Engine.checkedIn
            session
            native
            "encodeBundle"
            (labelsOf descriptor.label)
            (λ⊤ → Session.bundle native Js.null descriptor (λenc → body (Js.to enc)) value)
            ignore
            ignore
    case ( made, Js.read value ) of
        ( Ok rendered, Just v ) →
            Ok { value = v, bundle = Js.to rendered }

        ( Ok _, Nothing ) →
            Engine.defect "a bundle run published a bundle without a value"

        ( Err problem, _ ) →
            Err problem


--| Run a batch of `device` (`Gpu.Batch.run`). Under a session, what the
--| batch made is handed to the session when the batch's run succeeds, and
--| the batch settles when the session does.
pub batchIn :
      V
    , Handle.Device
    , String
    , sync (Handle.Batch → Result Error.Error a)
    → Result Error.Error a
batchIn session device name body =
    native = Js.from device
    r = Engine.recordOf native

    batch =
        Js.object
            [ ( "device", r )
            , ( "native", native )
            , ( "name", Js.from name )
            , ( "live", Js.from False )
            , ( "failure", Js.null )
            , ( "made", Js.array [] )
            , ( "issued", Js.array [] )
            , ( "refused", Js.array [] )
            , ( "settled", Js.null )
            , ( "waiters", Js.array [] )
            , ( "handedOver", Js.from False )
            ]
    value = Js.ref Nothing

    ran =
        Engine.checkedIn
            session
            native
            ("batch " ++ name)
            [ name ]
            (λ⊤ →
                Js.set batch "live" (Js.from True)
                outcome = Js.finally (λ⊤ → body (Js.to batch)) λ⊤ →
                    Js.set batch "live" (Js.from False)
                case outcome of
                    Ok v →
                        Js.write value (Just v)

                    Err problem →
                        Session.latch batch problem
                failure = Js.get batch "failure"
                if Js.isNull failure then Ok (Js.object []) else Err (Js.to failure)
            )
            ignore
            -- A run rejected after its call — by a scope, a loss or a
            -- cancellation — rejects what the batch made.
            λ_ → settleBatch batch "rejected"
    case ( ran, Js.read value ) of
        ( Ok _, Just v ) →
            if Js.isNull session then
                settleBatch batch "accepted"
            else
                -- What the batch made is the session's from now on: the
                -- session settles and releases it, once, and the batch only
                -- takes the session's verdict.
                Js.set batch "handedOver" (Js.from True)
                Js.each (Js.get batch "made") λentry →
                    op = Js.get entry "op"
                    Engine.handOver session (Js.get entry "made") λm →
                        if Js.isNull op then ⊤ else discard (Js.to op) m
                Engine.afterSession session (settleBatch batch _)
            Ok v

        ( Ok _, Nothing ) →
            Engine.defect "a batch was accepted without a value"

        ( Err problem, _ ) →
            settleBatch batch "rejected"
            Err
                (Error.BatchFailed
                    { batch = name
                    , failure = problem
                    , issued = Js.to (Js.get batch "issued")
                    , unissued = Js.to (Js.get batch "refused")
                    }
                )


--| Every resource the batch made takes its status, once; a rejected one is
--| released. Whoever waits for the batch wakes. The batch is settled
--| before anything else, so a discard that runs code of the engine sees
--| it settled. A batch handed to a diagnostic session only takes its
--| status: the session settled and released what it made.
pub settleBatch : V, String → ⊤
settleBatch batch status =
    if not (Js.isNull (Js.get batch "settled")) then
        ⊤
    else
        Js.set batch "settled" (Js.from status)
        if Js.to (Js.get batch "handedOver") then
            ⊤
        else
            Js.each (Js.get batch "made") λentry →
                made = Js.get entry "made"
                Engine.setStatus made status
                op = Js.get entry "op"
                if status == "rejected" && not (Js.isNull op) then discard (Js.to op) made else ⊤
        waiters = Js.get batch "waiters"
        Js.set batch "waiters" (Js.array [])
        Js.each waiters λw → Js.to (Js.apply w [ Js.from status ])


--| Run a frame of `surface` (`Gpu.Frame.submit`): a batch on the device the
--| surface is configured with, which is the frame, keeping its receipts.
pub frameIn :
      V
    , V
    , String
    , sync (Handle.Frame → Result Error.Error a)
    → Result Error.Error { value : a, submissions : List Handle.Submission }
frameIn session native name body =
    s = Engine.recordOf native
    device = Js.get s "device"
    if Js.isNull device then
        Err (Error.CanvasFailed Error.CanvasUnconfigured)
    else
        receipts = Js.array []
        result = batchIn session (Js.to device) ("frame " ++ name) (inFrame native receipts body _)
        Result.map result λv → { value = v, submissions = Js.to receipts }


-- The batch is the frame: it knows its surface, and keeps its receipts.
inFrame : V, V, sync (Handle.Frame → Result Error.Error a), Handle.Batch → Result Error.Error a
inFrame surface receipts body b =
    frame = Js.from b
    Js.set frame "surface" surface
    Js.set frame "submissions" receipts
    body (Js.to frame)


-- ---- External images (§8; ledger §6) -------------------------------------------

--| A copy of an external image into a texture (ledger §6): the queue of the
--| batch's device in a batch, the destination texture usable there, and a
--| source the host's usability check accepts (`sourceState`). Then the
--| host's `SecurityError` is `SourceNotOriginClean`, its `OperationError`
--| (a copy outside the source) `ExternalImageCopyRangeRejected` and its
--| `InvalidStateError` `SourceUnusable`; the destination's usage, format and
--| bounds are the device's to validate. The call makes nothing of its own.
pub copyExternalImage :
      V
    , V
    , Types.CopyExternalImageSourceInfo
    , Types.CopyExternalImageDestInfo
    , Types.Extent3D
    → Result Error.Error Op
copyExternalImage queue batch source destination extent =
    ofBatch queue batch "queue"?
    q = Engine.recordOf queue
    Result.mapError
        (Engine.usable (Js.from destination.texture) (Js.get q "device") batch "destination.texture"
        )
        Error.InvalidInput?
    sourceState (copySource source.source)?
    Ok
        { name = "copyExternalImageToTexture"
        , labels = [ Js.to (Js.get (Js.from destination.texture) "label") ]
        , target = queue
        , device = Js.get q "native"
        , action =
            CopyExternalImage
                [ Native.copyExternalImageSourceInfo source
                , Native.copyExternalImageDestInfo destination
                , Native.extent3D extent
                ]
        }


--| An external texture imported in `batch` (§8.2; ledger §6): a source the
--| host's usability check accepts (`sourceState`), then the host's
--| `SecurityError` is `SourceNotOriginClean` and its `InvalidStateError`
--| `SourceUnusable`. The texture expires when the batch's run ends, for a
--| video element, or when its video frame is closed (`ResourceExpired`).
pub externalTexture : V, Types.ExternalTextureDescriptor → Result Error.Error Op
externalTexture device descriptor =
    frame =
        case descriptor.source of
            Types.ExternalVideoElement video →
                sourceState (VideoElementSource (Js.from video))?
                Js.null

            Types.ExternalVideoFrame f →
                sourceState (VideoFrameSource (Js.from f))?
                Js.from f
    Ok
        { name = "importExternalTexture"
        , labels = labelsOf descriptor.label
        , target = device
        , device = device
        , action = ImportExternalTexture (Native.externalTextureDescriptor descriptor) frame
        }


-- The kinds of external source, by the state the host's usability check
-- reads of each.
type Source
    = BitmapSource V
    | DataSource V
    | ImageSource V
    | VideoElementSource V
    | VideoFrameSource V
    | CanvasSource V


copySource : Types.CopyExternalImageSource → Source
copySource source =
    case source of
        Types.Bitmap b →
            BitmapSource (Js.from b)

        Types.ImageData d →
            DataSource (Js.from d)

        Types.ImageElement i →
            ImageSource (Js.from i)

        Types.VideoElement v →
            VideoElementSource (Js.from v)

        Types.VideoFrame f →
            VideoFrameSource (Js.from f)

        Types.CanvasElement c →
            CanvasSource (Js.from c)

        Types.OffscreenCanvas c →
            CanvasSource (Js.from c)


--| A source the host's usability check accepts (HTML, *check the usability
--| of the image argument*), read from the state that check reads, before the
--| native call: a closed bitmap or video frame is `SourceClosed`, image data
--| whose pixels were detached `SourceDetached`, a canvas with a width or a
--| height of 0 or an image element with no source `SourceEmpty`, an image
--| element whose image failed or has no natural size `SourceBroken`, and an
--| image element still loading or a video element with no current frame
--| (`readyState` below `HAVE_CURRENT_DATA`) `SourceNotReady`. The state is
--| read in the host turn of the call, so it is the state the host sees.
sourceState : Source → Result Error.Error ⊤
sourceState source =
    problem =
        case source of
            BitmapSource b →
                if number b "width" == 0 || number b "height" == 0 then
                    Just Error.SourceClosed
                else
                    Nothing

            DataSource d →
                if Binary.detached (Js.to (Js.get (Js.get d "data") "buffer")) then
                    Just Error.SourceDetached
                else
                    Nothing

            ImageSource i →
                if not (Js.to (Js.get i "complete")) then
                    Just Error.SourceNotReady
                else if Js.same (Js.get i "currentSrc") (Js.from "") then
                    Just Error.SourceEmpty
                else if number i "naturalWidth" == 0 || number i "naturalHeight" == 0 then
                    Just Error.SourceBroken
                else
                    Nothing

            VideoElementSource v →
                if number v "readyState" < 2 then Just Error.SourceNotReady else Nothing

            VideoFrameSource f →
                if Video.closed (Js.to f) then Just Error.SourceClosed else Nothing

            CanvasSource c →
                if number c "width" == 0 || number c "height" == 0 then
                    Just Error.SourceEmpty
                else
                    Nothing
    case problem of
        Just p →
            Err (Error.SourceFailed p)

        Nothing →
            Ok ⊤


number : V, String → Int
number value field = Js.to (Js.get value field)
