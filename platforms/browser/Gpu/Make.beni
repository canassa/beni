--! The resource creations of a device (`docs/design/webgpu.md` §4, §6.1,
--! §6.3), each prepared once and run two ways: as a checked operation of
--! its own (`Gpu.Device`) or inside a batch (`Gpu.Batch`). An application
--! never needs it, and its signatures name `Js.Value`.
--!
--! Preparing checks the inputs — the handles a descriptor names, the
--! features a format or a query type needs — before any native call, and
--! gives the one native call with its own synchronous classifier: what the
--! ledger documents at that call is a precise `Error`, anything else
--! propagates and is a defect.

import Binary
import Dict
import Gpu.Engine as Engine
import Gpu.Error as Error
import Gpu.Feature as Feature
import Gpu.Flags as Flags
import Gpu.Handle as Handle
import Gpu.Memory as Memory
import Gpu.Native as Native
import Gpu.Scalar as Scalar
import Gpu.Types as Types
import Js


type alias V =
    Js.Value


ignore : V → ⊤
ignore _ = ⊤


--| One prepared creation: its operation's name, the labels of what it
--| makes, the native call, what fills the made object's record while it is
--| provisional, and what releases it when it is rejected: each a beni
--| function held as a value (`sync (⊤ → Result Error V)`, `sync (V → ⊤)`),
--| run by `call`, `adopt` and `discard`.
pub type alias Op =
    name : String
    labels : List String
    call : V
    adopt : V
    discard : V


plain : String, Types.Option String, sync (⊤ → Result Error.Error V) → Op
plain name label call =
    { name = name
    , labels = labelsOf label
    , call = Js.from call
    , adopt = Js.from ignore
    , discard = Js.from ignore
    }


--| Make the native call of a prepared creation.
pub runCall : Op → Result Error.Error V
runCall op = Js.to (Js.apply op.call [ Js.from ⊤ ])


--| Fill the record of what it made.
pub runAdopt : Op, V → ⊤
runAdopt op made = Js.to (Js.apply op.adopt [ made ])


--| Release what it made, rejected.
pub runDiscard : Op, V → ⊤
runDiscard op made = Js.to (Js.apply op.discard [ made ])


--| The labels of an optional label.
pub labelsOf : Types.Option String → List String
labelsOf l =
    case l of
        Types.Value text →
            [ text ]

        Types.Default →
            []


-- A handle argument, as the engine checks it.
handle : V, V, V, String → Result Error.Error ⊤
handle native r batch path = Result.mapError (Engine.usable native r batch path) Error.InvalidInput


--| A sampler.
pub sampler : V, Types.SamplerDescriptor → Result Error.Error Op
sampler device descriptor =
    converted = Native.samplerDescriptor descriptor
    -- The ledger documents no synchronous failure of `createSampler` (§3).
    Ok
        (plain "createSampler" descriptor.label λ⊤ →
            Ok (Js.call device "createSampler" [ converted ])
        )


--| A buffer (§7.1): a mapped-at-creation size that is not a multiple of 4
--| is refused first; then the CPU memory of the mapping is the call's one
--| documented failure. A rejected buffer is destroyed.
pub buffer : V, Types.BufferDescriptor → Result Error.Error Op
buffer device descriptor =
    bytes = Scalar.size64ToInt descriptor.size

    mapped =
        case descriptor.mappedAtCreation of
            Types.Value True →
                True

            _ →
                False
    if mapped && Int.rem bytes 4 ≠ 0 then
        Err (Error.InvalidInput (Error.MappedSizeUnaligned { path = "size", size = bytes }))
    else
        converted = Native.bufferDescriptor descriptor
        usage = Flags.bufferUsagesBits descriptor.usage
        Ok
            { name = "createBuffer"
            , labels = labelsOf descriptor.label
            , call =
                Js.from λ⊤ →
                    if mapped then
                        Js.catchIf
                            (λ⊤ → Ok (Js.call device "createBuffer" [ converted ]))
                            Engine.isRangeError
                            λerror →
                                Err
                                    (Error.MapFailed
                                        (Error.MappedAllocationFailed
                                            { bytes = bytes, message = Engine.messageOf error }
                                        )
                                    )
                    else
                        Ok (Js.call device "createBuffer" [ converted ])
            , adopt = Js.from λmade → Memory.adoptBuffer device made bytes usage mapped
            , discard = Js.from λmade → Memory.destroy made
            }


--| The feature a texture format needs, if any (the specification's
--| texture format capability tables).
pub formatFeature : Types.TextureFormat → Maybe Types.FeatureName
formatFeature format =
    name = Types.textureFormatToString format
    if String.startsWith name "bc" then
        Just Types.FeatureTextureCompressionBc
    else if String.startsWith name "etc2" || String.startsWith name "eac" then
        Just Types.FeatureTextureCompressionEtc2
    else if String.startsWith name "astc" then
        Just Types.FeatureTextureCompressionAstc
    else if name == "depth32float-stencil8" then
        Just Types.FeatureDepth32floatStencil8
    else if
        List.member
            [ "r16unorm", "r16snorm", "rg16unorm", "rg16snorm", "rgba16unorm", "rgba16snorm" ]
            name
    then
        Just Types.FeatureTextureFormatsTier1
    else
        Nothing


--| A texture: a format or view format whose feature the device lacks is
--| refused before the native call (`UnsupportedCapability`); a `TypeError`
--| of the native format check is `FormatFeatureRejected` only when a format
--| it names needs a feature (ledger §3), and a defect otherwise. A rejected
--| texture is destroyed.
pub texture : V, Types.TextureDescriptor → Result Error.Error Op
texture device descriptor =
    formats = [ descriptor.format, …(viewFormats descriptor) ]
    formatsAvailable device formats?
    converted = Native.textureDescriptor descriptor
    Ok
        { name = "createTexture"
        , labels = labelsOf descriptor.label
        , call =
            Js.from λ⊤ → formatChecked formats λ⊤ → Js.call device "createTexture" [ converted ]
        , adopt = Js.from λmade → Js.set (Engine.recordOf made) "destroyed" (Js.from False)
        , discard = Js.from λmade → Js.call made "destroy" [] ▷ ignore
        }


viewFormats : Types.TextureDescriptor → List Types.TextureFormat
viewFormats descriptor =
    case descriptor.viewFormats of
        Types.Value formats →
            formats

        Types.Default →
            []


--| A bind group layout.
pub bindGroupLayout : V, Types.BindGroupLayoutDescriptor → Result Error.Error Op
bindGroupLayout device descriptor =
    converted = Native.bindGroupLayoutDescriptor descriptor
    Ok
        (plain "createBindGroupLayout" descriptor.label λ⊤ →
            Ok (Js.call device "createBindGroupLayout" [ converted ])
        )


--| A bind group: its layout and every resource it binds must be usable on
--| the device (in `batch`, when it runs in one).
pub bindGroup : V, V, Types.BindGroupDescriptor → Result Error.Error Op
bindGroup device batch descriptor =
    r = Engine.recordOf device
    handle (Js.from descriptor.layout) r batch "layout"?
    each
        descriptor.entries
        (λentry → handle (resourceObject entry.resource) r batch "entries.resource")?
    converted = Native.bindGroupDescriptor descriptor
    -- A bind group of a frame's texture expires with it (§8.2).
    bound =
        Native.array
            (List.filter
                (List.map descriptor.entries λentry → resourceObject entry.resource)
                Engine.frameBound
            )
            λx → x
    Ok
        { name = "createBindGroup"
        , labels = labelsOf descriptor.label
        , call = Js.from λ⊤ → Ok (Js.call device "createBindGroup" [ converted ])
        , adopt = Js.from λmade → Engine.dependsOn made bound
        , discard = Js.from ignore
        }


-- The native object a binding names.
resourceObject : Types.BindingResource → V
resourceObject resource =
    case resource of
        Types.SamplerBinding s →
            Js.from s

        Types.TextureBinding t →
            Js.from t

        Types.TextureViewBinding v →
            Js.from v

        Types.WholeBufferBinding b →
            Js.from b

        Types.BufferRangeBinding b →
            Js.from b.buffer

        Types.ExternalTextureBinding x →
            Js.from x


--| A pipeline layout: every layout it names must be usable.
pub pipelineLayout : V, V, Types.PipelineLayoutDescriptor → Result Error.Error Op
pipelineLayout device batch descriptor =
    r = Engine.recordOf device
    each
        descriptor.bindGroupLayouts
        (λslot →
            case slot of
                Just layout →
                    handle (Js.from layout) r batch "bindGroupLayouts"

                Nothing →
                    Ok ⊤
        )?
    converted = Native.pipelineLayoutDescriptor descriptor
    Ok
        (plain "createPipelineLayout" descriptor.label λ⊤ →
            Ok (Js.call device "createPipelineLayout" [ converted ])
        )


--| A shader module. Invalid WGSL is the device's to report (`Validation`,
--| with the host's message).
pub shaderModule : V, Types.ShaderModuleDescriptor → Result Error.Error Op
shaderModule device descriptor =
    converted = Native.shaderModuleDescriptor descriptor
    Ok
        { name = "createShaderModule"
        , labels = labelsOf descriptor.label
        , call = Js.from λ⊤ → Ok (Js.call device "createShaderModule" [ converted ])
        , adopt = Js.from λmade → Js.set (Engine.recordOf made) "code" (Js.from descriptor.code)
        , discard = Js.from ignore
        }


--| The handles a compute pipeline names: its layout when explicit, and its
--| module.
pub computeHandles : V, V, Types.ComputePipelineDescriptor → Result Error.Error ⊤
computeHandles device batch descriptor =
    r = Engine.recordOf device
    case descriptor.layout of
        Types.Explicit layout →
            handle (Js.from layout) r batch "layout"?

        Types.Auto →
            ⊤
    handle (Js.from descriptor.compute.module) r batch "compute.module"


--| A compute pipeline, made at once (the synchronous form).
pub computePipeline : V, V, Types.ComputePipelineDescriptor → Result Error.Error Op
computePipeline device batch descriptor =
    computeHandles device batch descriptor?
    converted = Native.computePipelineDescriptor descriptor
    Ok
        (plain "createComputePipeline" descriptor.label λ⊤ →
            Ok (Js.call device "createComputePipeline" [ converted ])
        )


--| A query set: a timestamp query needs the `timestamp-query` feature,
--| refused before the native call, which would throw a `TypeError`. A
--| rejected query set is destroyed.
pub querySet : V, Types.QuerySetDescriptor → Result Error.Error Op
querySet device descriptor =
    features = Feature.fromNames (Engine.readNames device "features")
    if
        descriptor.type_ == Types.Timestamp
            && not (Feature.has features Types.FeatureTimestampQuery)
    then
        Err (Error.UnsupportedCapability (Error.MissingFeature Types.FeatureTimestampQuery))
    else
        converted = Native.querySetDescriptor descriptor
        Ok
            { name = "createQuerySet"
            , labels = labelsOf descriptor.label
            , call = Js.from λ⊤ → Ok (Js.call device "createQuerySet" [ converted ])
            , adopt = Js.from λmade → Js.set (Engine.recordOf made) "destroyed" (Js.from False)
            , discard = Js.from λmade → Js.call made "destroy" [] ▷ ignore
            }


--| The bind group layout of a pipeline at `index`: the pipeline must be
--| usable on `device` (in `batch`, when it runs in one).
pub getBindGroupLayout : V, V, V, Scalar.U32 → Result Error.Error Op
getBindGroupLayout device pipeline batch index =
    handle pipeline (Engine.recordOf device) batch "pipeline"?
    Ok
        { name = "getBindGroupLayout"
        , labels = [ Js.to (Js.get pipeline "label") ]
        , call =
            Js.from λ⊤ →
                Ok (Js.call pipeline "getBindGroupLayout" [ Js.from (Scalar.u32ToInt index) ])
        , adopt = Js.from ignore
        , discard = Js.from ignore
        }


--| Run a prepared creation as a checked operation of its own (§6.1).
pub checked : V, Result Error.Error Op → Result Error.Error V
checked device prepared =
    op = prepared?
    Engine.checkedMaking device op.name op.labels (λ⊤ → runCall op) (λm → runAdopt op m) λm →
        runDiscard op m


--| `check` on every element, stopping at the first `Err`.
pub each : List a, (a → Result e ⊤) → Result e ⊤
each xs check =
    case xs of
        [] →
            Ok ⊤

        [ x, …rest ] →
            check x?
            each rest check


--| A queue write (ledger §5): the buffer must be usable (in `batch`, when
--| the write runs in one), the data fixed and attached, the part inside it
--| and a multiple of 4 bytes. The host's `OperationError` at the call is
--| `BufferWriteSourceRejected`. The call makes nothing of its own.
pub writeBuffer : V, V, Handle.Buffer, Memory.WriteBufferSource → Result Error.Error Op
writeBuffer queue batch target write =
    q = Engine.recordOf queue
    Result.mapError (writePreflight q batch target write) Error.InvalidInput?
    sizeArg =
        case write.size of
            Just s →
                Js.from s

            Nothing →
                Js.undefined
    Ok
        { name = "writeBuffer"
        , labels = [ Js.to (Js.get (Js.from target) "label") ]
        , call =
            Js.from λ⊤ →
                Js.catchIf
                    (λ⊤ →
                        Js.call queue "writeBuffer"
                            [ Js.from target
                            , Js.from write.bufferOffset
                            , Memory.sourceObject write.data
                            , Js.from write.dataOffset
                            , sizeArg
                            ]
                            ▷ ignore
                        -- What the call made: nothing but its outcome.
                        Ok (Js.object [])
                    )
                    (λerror → Engine.isDomException error "OperationError")
                    λerror →
                        Err
                            (Error.HostOperationRejected
                                (Error.BufferWriteSourceRejected
                                    { message = Engine.messageOf error }
                                )
                            )
        , adopt = Js.from ignore
        , discard = Js.from ignore
        }


writePreflight : V, V, Handle.Buffer, Memory.WriteBufferSource → Result Error.InputError ⊤
writePreflight q batch target write =
    Engine.usable (Js.from target) (Js.get q "device") batch "buffer"?
    _ = Memory.size64 write.bufferOffset "bufferOffset"?
    info = Memory.sourceInfo write.data "data"?
    -- The content timeline's checks of `writeBuffer`, in the data's units.
    dataSize = info.elementLength
    dataOffset = Memory.size64 write.dataOffset "dataOffset"?
    if dataOffset > dataSize then
        Err
            (Error.OutOfRange
                { path = "dataOffset", offset = dataOffset, size = 0, available = dataSize }
            )
    else
        contents =
            case write.size of
                Just s →
                    Memory.size64 s "size"?

                Nothing →
                    dataSize - dataOffset
        if contents > dataSize - dataOffset then
            Err
                (Error.OutOfRange
                    { path = "size"
                    , offset = dataOffset * info.bytesPerElement
                    , size = contents * info.bytesPerElement
                    , available = info.byteLength
                    }
                )
        else
            Memory.aligned (contents * info.bytesPerElement) 4 "size"


--| A submit (§8.3): every command buffer usable (in `batch`, when it runs
--| in one), not submitted before, and named once. The call marks them
--| submitted, makes the one native submit and captures the queue's
--| completion in the receipt, which it makes.
pub submit : V, V, List Handle.CommandBuffer → Result Error.Error Op
submit queue batch commands =
    q = Engine.recordOf queue
    Result.mapError (submitPreflight q batch commands) Error.InvalidInput?
    device = Js.get q "native"
    Ok
        { name = "submit"
        , labels = []
        , call =
            Js.from λ⊤ →
                List.foldl commands ⊤ λc _ →
                    Js.set (Engine.recordOf (Js.from c)) "submitted" (Js.from True)
                Js.call queue "submit" [ Native.array commands λc → Js.from c ] ▷ ignore
                Ok
                    (Engine.pendingOutcome
                        device
                        "onSubmittedWorkDone"
                        (Js.call queue "onSubmittedWorkDone" [])
                        workDone
                    )
        , adopt = Js.from ignore
        , discard = Js.from ignore
        }


-- `onSubmittedWorkDone` documents no rejection (ledger §5).
workDone : Bool, V → Engine.Outcome ⊤
workDone fulfilled value = if fulfilled then Engine.Expected ⊤ else Engine.Unexpected value


submitPreflight : V, V, List Handle.CommandBuffer → Result Error.InputError ⊤
submitPreflight q batch commands =
    seen = Js.construct (Js.global "Set") []
    each commands (submittable q batch seen _)


submittable : V, V, V, Handle.CommandBuffer → Result Error.InputError ⊤
submittable q batch seen command =
    native = Js.from command
    Engine.usable native (Js.get q "device") batch "commands"?
    if Js.same (Js.get (Engine.recordOf native) "submitted") (Js.from True) then
        Err (Error.CommandBufferSubmitted { path = "commands" })
    else if Js.to (Js.call seen "has" [ native ]) then
        Err (Error.DuplicateCommandBuffer { path = "commands" })
    else
        Js.call seen "add" [ native ] ▷ ignore
        Ok ⊤


--| A queue write into a texture (ledger §5): the texture must be usable
--| and the data fixed and attached; copy layouts, extents and texel blocks
--| are the device's to validate, and the call documents no host failure of
--| its own. The call makes nothing of its own.
pub writeTexture :
      V
    , V
    , Types.TexelCopyTextureInfo
    , Binary.Source
    , Types.TexelCopyBufferLayout
    , Types.Extent3D
    → Result Error.Error Op
writeTexture queue batch destination data layout extent =
    q = Engine.recordOf queue
    Result.mapError
        (Engine.usable (Js.from destination.texture) (Js.get q "device") batch "destination.texture"
        )
        Error.InvalidInput?
    _ = Result.mapError (Memory.sourceInfo data "data") Error.InvalidInput?
    Ok
        { name = "writeTexture"
        , labels = [ Js.to (Js.get (Js.from destination.texture) "label") ]
        , call =
            Js.from λ⊤ →
                Js.call queue "writeTexture"
                    [ Native.texelCopyTextureInfo destination
                    , Memory.sourceObject data
                    , Native.texelCopyBufferLayout layout
                    , Native.extent3D extent
                    ]
                    ▷ ignore
                Ok (Js.object [])
        , adopt = Js.from ignore
        , discard = Js.from ignore
        }


-- ---- Formats, views and render pipelines (S3) -------------------------------

--| Every format of `formats` that a feature gates, with the feature, in
--| order and once each.
pub gated : List Types.TextureFormat → List (Types.TextureFormat × Types.FeatureName)
gated formats = List.foldl formats [] λf found →
    case formatFeature f of
        Just n →
            if List.member found ( f, n ) then found else [ …found, ( f, n ) ]

        Nothing →
            found


--| The failure of a host that refused one of `candidates` (not empty).
pub formatFailure : List (Types.TextureFormat × Types.FeatureName), V → Error.Error
formatFailure candidates error =
    case candidates of
        [ ( format, required ), …_ ] →
            Error.FormatFeatureRejected
                { format = format
                , required = required
                , candidates = candidates
                , message = Engine.messageOf error
                }

        [] →
            Engine.defect "a format failure with no feature-gated format"


--| Every format of `formats` must have its feature on `device` (a native
--| device): the first that lacks one is `UnsupportedCapability`, before any
--| native call.
pub formatsAvailable : V, List Types.TextureFormat → Result Error.Error ⊤
formatsAvailable device formats =
    features = Feature.fromNames (Engine.readNames device "features")
    missing = List.filter (List.filterMap formats formatFeature) λf → not (Feature.has features f)
    case missing of
        [ f, …_ ] →
            Err (Error.UnsupportedCapability (Error.MissingFeature f))

        [] →
            Ok ⊤


--| Make the native call `call`, whose content timeline checks the features
--| of `formats` (ledger §3, §5): a `TypeError` it throws is
--| `FormatFeatureRejected` when one of them is feature-gated — the
--| preflight saw the feature, the host refused it anyway — and goes on, a
--| defect, otherwise.
pub formatChecked : List Types.TextureFormat, sync (⊤ → V) → Result Error.Error V
formatChecked formats call =
    candidates = gated formats
    Js.catchIf (λ⊤ → Ok (call ⊤)) (λerror → Engine.isTypeError error && candidates ≠ []) λerror →
        Err (formatFailure candidates error)


--| A view of `texture` (a native texture of `device`, in `batch` or null):
--| the texture must be usable, and a view format whose feature the device
--| lacks is refused before the native call. The view keeps its texture in
--| its record, so a check of the view can see the texture's state.
pub textureView : V, V, V, Types.TextureViewDescriptor → Result Error.Error Op
textureView device batch target descriptor =
    handle target (Engine.recordOf device) batch "texture"?

    formats =
        case descriptor.format of
            Types.Value f →
                [ f ]

            Types.Default →
                []
    formatsAvailable device formats?
    converted = Native.textureViewDescriptor descriptor
    Ok
        { name = "createView"
        , labels = labelsOf descriptor.label
        , call = Js.from λ⊤ → formatChecked formats λ⊤ → Js.call target "createView" [ converted ]
        , adopt =
            Js.from λmade →
                Js.set (Engine.recordOf made) "texture" target
                Engine.markView made target
        , discard = Js.from ignore
        }


--| The formats a render pipeline names: its color targets' and its depth
--| and stencil format.
pub renderFormats : Types.RenderPipelineDescriptor → List Types.TextureFormat
renderFormats descriptor =
    targets =
        case descriptor.fragment of
            Types.Value fragment →
                List.filterMap fragment.targets λt → Maybe.map t λc → c.format

            Types.Default →
                []
    case descriptor.depthStencil of
        Types.Value d →
            [ …targets, d.format ]

        Types.Default →
            targets


--| The handles a render pipeline names — its layout when explicit, its
--| vertex and fragment modules — and the features of its formats.
pub renderHandles : V, V, Types.RenderPipelineDescriptor → Result Error.Error ⊤
renderHandles device batch descriptor =
    r = Engine.recordOf device
    case descriptor.layout of
        Types.Explicit layout →
            handle (Js.from layout) r batch "layout"?

        Types.Auto →
            ⊤
    handle (Js.from descriptor.vertex.module) r batch "vertex.module"?
    case descriptor.fragment of
        Types.Value fragment →
            handle (Js.from fragment.module) r batch "fragment.module"?

        Types.Default →
            ⊤
    formatsAvailable device (renderFormats descriptor)


--| A render pipeline, made at once (the synchronous form).
pub renderPipeline : V, V, Types.RenderPipelineDescriptor → Result Error.Error Op
renderPipeline device batch descriptor =
    renderHandles device batch descriptor?
    formats = renderFormats descriptor
    converted = Native.renderPipelineDescriptor descriptor
    Ok
        (plain "createRenderPipeline" descriptor.label λ⊤ →
            formatChecked formats λ⊤ → Js.call device "createRenderPipeline" [ converted ]
        )


--| The formats a render bundle encoder names.
pub bundleFormats : Types.RenderBundleEncoderDescriptor → List Types.TextureFormat
bundleFormats descriptor =
    colors = List.filterMap descriptor.colorFormats λf → f
    case descriptor.depthStencilFormat of
        Types.Value f →
            [ …colors, f ]

        Types.Default →
            colors
