--! Time in a page: what the clock says, waiting, and a subscription that
--! ticks (`docs/design/boundary.md` §9.8). `sleep` waits in the calling
--! fiber only; every other fiber, and the page, go on. Cancelling a fiber
--! that sleeps clears its timer. The clock and the timer are the page's,
--! read when called, so a test harness that replaces them before the
--! program runs is the clock the program sees.

import Browser
import Js
import Sub exposing (Sub)
import Task exposing (Resume)


--| A length of time, in whole milliseconds.
pub type Duration
    = Duration Int


--| `n` milliseconds.
pub millis : Int → Duration
millis n = Duration n


--| `n` seconds.
pub seconds : Int → Duration
seconds n = Duration (n * 1000)


--| How many milliseconds.
pub inMillis : Duration → Int
inMillis (Duration n) = n


--| A moment, as the milliseconds since the Unix epoch.
pub type Posix
    = Posix Int


--| The milliseconds since the Unix epoch.
pub toMillis : Posix → Int
toMillis (Posix n) = n


--| The moment from the milliseconds since the Unix epoch.
pub fromMillis : Int → Posix
fromMillis n = Posix n


--| What the clock says now.
pub now : () → Posix
now () = Posix (Js.to (Js.call (Js.global "Date") "now" []))


--| Wait for `duration`. Only the calling fiber waits.
pub sleep : Duration → ()
sleep (Duration ms) = Task.callback λresume → startTimer ms resume


-- One timer, which resumes the waiting fiber, and what clears it.
startTimer : Int, Resume () → (() → ())
startTimer ms resume =
    timer =
        Js.apply (Js.global "setTimeout")
            [ Js.from λ() → Js.to (Js.apply (Js.from resume) [ Js.null ]), Js.from ms ]
    λ() → Js.to (Js.apply (Js.global "clearTimeout") [ timer ])


type Key
    = Every Int


--| A message every `interval`, carrying the moment it fired. Every
--| declaration of one interval shares one timer, and each receives each
--| tick through its own tagger.
pub every : Duration, (Posix → msg) → Sub msg
every (Duration ms) tag = Sub.listen (Every ms) (ticks ms _) tag


ticks : Int, Browser.Send Posix → ()
ticks ms emit =
    _ = sleep (Duration ms)
    _ = emit (now ())
    ticks ms emit
