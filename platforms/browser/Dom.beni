--! The rendered page's nodes, by id (`docs/design/boundary.md` §9.8.6):
--! focus, measure, scroll. Each is `impure` and answers at once; a node
--! that is not in the page is `Err (NotFound id)`, never a crash.
--!
--! Where the node was rendered by the message being handled, ask for the
--! work after the render: `Cmd.afterRender` runs it once the page is
--! patched, and a fiber waits for that moment with `rendered`.
--!
--!     Edit id →
--!         ( { model | editing = Just id }, Cmd.afterRender (focusEditor id _) )
--!
--!     focusEditor id send =
--!         case Dom.focus "edit-${id}" of
--!             Ok ⊤ → ⊤
--!             Err why → send (FocusFailed why)
--!
--! Full screen (§9.8.6, *amended 2026-10-23*): `requestFullscreen` shows a
--! node in full screen and `exitFullscreen` leaves it; both wait for the
--! browser's answer. `onFullscreenChange` reports every change, also the
--! ones the user makes with Escape or a browser control. A request needs
--! the user activation of the click that asks for it, so ask from that
--! click's message: a command's body runs well inside the few seconds the
--! activation lasts.
--!
--!     GoFullscreen →
--!         ( model, Cmd.perform λsend → send (Entered (Dom.requestFullscreen "arena")) )

import Browser
import Browser.Host.DOMRect as Rect
import Browser.Host.Document as Document
import Browser.Host.Element as Element
import Browser.Host.Navigator as Navigator
import Browser.Host.Promise as Promise
import Browser.Host.Rejection as Rejection
import Browser.Host.Window as Window
import Listen
import Sub exposing (Sub)
import Task


--| Why a node could not be used.
pub type Error
    = NotFound String


--| Why the browser did not show a node in full screen.
--|
--|   - `NoElement id`: no node in the page has this id.
--|   - `Unsupported`: the browser cannot show a node in full screen, as
--|     Safari on an iPhone cannot, or the page may not (an `iframe`
--|     without `allowfullscreen`).
--|   - `NotActivated`: no user activation is active; ask from the message
--|     of a click or a key.
--|   - `Refused reason`: the browser refused the request, with its reason.
pub type FullscreenError
    = NoElement String
    | Unsupported
    | NotActivated
    | Refused String


--| A node's box in the viewport, in CSS pixels.
pub type alias Box =
    x : Float
    y : Float
    width : Float
    height : Float


--| The viewport: its size, and how far the page is scrolled.
pub type alias Viewport =
    x : Float
    y : Float
    width : Float
    height : Float


-- Written in beni over generated typed native operations:
-- the node is found by id when the call is made, and one that is not in
-- the page is `NotFound`. No call here documents a failure, so none is
-- caught.

--| Focus the element with this id.
pub focus : String → Result Error ⊤
focus id = found id λn → Element.focus n


--| Take the focus away from the element with this id.
pub blur : String → Result Error ⊤
blur id = found id λn → Element.blur n


--| The box of the element with this id (`getBoundingClientRect`).
pub box : String → Result Error Box
box id = found id λn →
    r = Element.box n
    { x = Rect.x r
    , y = Rect.y r
    , width = Rect.width r
    , height = Rect.height r
    }


--| Scroll the element with this id to `x` and `y`.
pub scrollTo : String, Float, Float → Result Error ⊤
scrollTo id x y = found id λn → Element.scrollTo n x y


--| Scroll the page until the element with this id is in view.
pub scrollIntoView : String → Result Error ⊤
scrollIntoView id = found id λn → Element.scrollIntoView n


--| The viewport now.
pub viewport : ⊤ → Viewport
viewport ⊤ =
    { x = Window.scrollX ⊤
    , y = Window.scrollY ⊤
    , width = toFloat (Window.innerWidth ⊤)
    , height = toFloat (Window.innerHeight ⊤)
    }


-- `use` of the element with this id, when the page has one: the sibling's
-- shape, one lookup and one call, so a page that only focuses ships no
-- `Result.map`.
found : String, (Element.Element → a) → Result Error a
found id use =
    case Document.byId id of
        Nothing →
            Err (NotFound id)
        Just node →
            Ok (use node)


--| Show the element with this id in full screen, and wait until the
--| browser has done it or refused. Call it inside the user activation of
--| the click or the key that asks for it.
--|
--|     case Dom.requestFullscreen "arena" of
--|         Ok ⊤ → send Entered
--|         Err why → send (FullscreenFailed why)
pub requestFullscreen : String → Result FullscreenError ⊤
requestFullscreen id =
    case Document.byId id of
        Nothing →
            Err (NoElement id)
        Just node →
            if not (Element.fullscreenSupported node) || not (Document.fullscreenEnabled ⊤) then
                Err Unsupported
            else if not (Navigator.activated ⊤) then
                Err NotActivated
            else
                case settle λ⊤ → Element.requestFullscreen node of
                    Done →
                        Ok ⊤
                    Denied reason →
                        Err (Refused reason)
                    Defect error →
                        Rejection.raise error


--| Leave full screen, and wait until the browser has done it. When no
--| element is in full screen, return at once.
pub exitFullscreen : ⊤ → ⊤
exitFullscreen ⊤ =
    case Document.fullscreenElementId ⊤ of
        Nothing →
            ⊤
        Just _ →
            case settle Document.exitFullscreen of
                Defect error →
                    Rejection.raise error
                _ →
                    ⊤


--| The id of the element in full screen now, `Just ""` for one with no
--| id, or `Nothing` when no element is in full screen.
pub fullscreenElement : ⊤ → Maybe String
fullscreenElement ⊤ = Document.fullscreenElementId ⊤


--| The element in full screen, as `fullscreenElement` gives it, each time
--| that changes: by a request, by `exitFullscreen`, by Escape or by a
--| control of the browser.
--|
--|     subscriptions model = Dom.onFullscreenChange FullscreenChanged
pub onFullscreenChange : (Maybe String → msg) → Sub msg
onFullscreenChange tag = Sub.on FullscreenChange fullscreenChanges tag


--| Call `f` with the element in full screen each time that changes, for
--| as long as the calling fiber runs.
pub eachFullscreenChange : (Maybe String → ⊤) → ⊤
eachFullscreenChange f = Listen.each fullscreenChanges f


type Key
    = FullscreenChange


fullscreenChanges : sync (Maybe String → ⊤) → (⊤ → ⊤)
fullscreenChanges send = Listen.on "document" "fullscreenchange" (λ_ → fullscreenElement ⊤) send


-- How one promise of the Fullscreen API settled.
type Settled
    = Done
    | Denied String
    | Defect Rejection.Rejection


-- Wait for the promise `start` returns. The Fullscreen standard rejects
-- every refusal with a `TypeError`; any other reason is a defect, thrown in
-- the waiting fiber (`CLAUDE.md` rule 9). The request cannot be cancelled,
-- so a cancelled fiber only stops waiting.
settle : sync (⊤ → Promise.Promise ⊤) → Settled
settle start = Task.callback λresume →
    Promise.observe (start ⊤) (λ_ → Task.resume resume Done) λerror →
        Task.resume resume (rejected error)
    λ⊤ → ⊤


rejected : Rejection.Rejection → Settled
rejected error =
    case Rejection.typeErrorMessage error of
        Just message →
            Denied message
        Nothing →
            Defect error


--| Wait until what has been sent is on the page: at once when no render is
--| queued, otherwise until the after-render phase of the flush that is.
--|
--|     _ = send (Opened id)
--|     Dom.rendered ⊤
--|     Dom.focus "edit-${id}"
pub rendered : ⊤ → ⊤
rendered ⊤ = Task.callback λresume → Browser.onRendered resume
