--! Native image elements, ImageData and ImageBitmap construction.
--! docs/design/browser-sources.md records the HTML failure algorithms.

import Binary
import Browser.Source as Source
import Js
import Task


pub type alias Element =
    Source.ImageElement


pub type alias Bitmap =
    Source.Bitmap


pub type alias Data =
    Source.Pixels


pub type ColorSpace
    = Srgb
    | DisplayP3


pub type PixelFormat
    = Rgba8
    | Rgba16Float


pub type CrossOrigin
    = SameOrigin
    | Anonymous
    | Credentials


pub type Orientation
    = FromImage
    | FlipY


pub type Alpha
    = DefaultAlpha
    | Straight
    | Premultiplied


pub type Conversion
    = DefaultConversion
    | NoConversion


pub type Quality
    = Pixelated
    | Low
    | Medium
    | High


pub type Error
    = Unsupported String
    | NotFound String
    | WrongElement String
    | InvalidDimension Int
    | InvalidCrop
    | WrongPixelView
    | InconsistentPixels
    | SharedPixels
    | BinaryError Binary.Error
    | AllocationFailed
    | DecodeFailed
    | InvalidSource


pub type alias Settings =
    colorSpace : ColorSpace
    pixelFormat : PixelFormat


pub type alias BitmapOptions =
    orientation : Orientation
    alpha : Alpha
    conversion : Conversion
    resizeWidth : Maybe Int
    resizeHeight : Maybe Int
    quality : Quality


pub type alias Crop =
    x : Int
    y : Int
    width : Int
    height : Int


pub settings : Settings
settings = { colorSpace = Srgb, pixelFormat = Rgba8 }


pub bitmapOptions : BitmapOptions
bitmapOptions =
    { orientation = FromImage
    , alpha = DefaultAlpha
    , conversion = DefaultConversion
    , resizeWidth = Nothing
    , resizeHeight = Nothing
    , quality = Low
    }


--| Find a native image element; acquisition does not decode or copy it.
pub byId : String → Result Error Element
byId id =
    document = Js.global "document"
    if Js.isUndefined document then
        Err (Unsupported "document")
    else
        value = Js.call document "getElementById" [ Js.from id ]
        if Js.isNull value then
            Err (NotFound id)
        else if not (Js.instanceOf value (Js.global "HTMLImageElement")) then
            Err (WrongElement id)
        else
            Ok (Js.to value)


--| Load and decode a new image. Cancelling releases this request's element URL.
pub load : String, CrossOrigin → Result Error Element
load url crossOrigin =
    constructor = Js.global "Image"
    if not (Js.typeIs constructor "function") then
        Err (Unsupported "Image")
    else
        value = Js.construct constructor []
        case crossOrigin of
            SameOrigin →
                ⊤
            Anonymous →
                Js.set value "crossOrigin" (Js.from "anonymous")
            Credentials →
                Js.set value "crossOrigin" (Js.from "use-credentials")
        Js.set value "src" (Js.from url)
        Task.onExit (λ⊤ → Result.map (decode (Js.to value)) λ_ → Js.to value) λexit →
            case exit of
                Task.Done result →
                    case result of
                        Ok _ →
                            ⊤
                        Err _ →
                            Js.to (Js.call value "removeAttribute" [ Js.from "src" ])
                Task.Cancelled →
                    Js.to (Js.call value "removeAttribute" [ Js.from "src" ])


--| Decode an existing element without taking ownership of its URL.
pub decode : Element → Result Error ⊤
decode image =
    value = Js.from image
    if not (Js.typeIs (Js.get value "decode") "function") then
        Err (Unsupported "HTMLImageElement.decode")
    else
        outcome = wait (λ⊤ → Js.call value "decode" []) (domError "EncodingError" _) λ_ → ⊤
        case outcome of
            Fulfilled _ →
                Ok ⊤
            Rejected _ →
                Err DecodeFailed


--| Allocate native RGBA ImageData in the chosen color space and component format.
pub data : Int, Int, Settings → Result Error Data
data width height config =
    positive width?
    positive height?
    formatSupported config?
    constructor = Js.global "ImageData"
    if not (Js.typeIs constructor "function") then
        Err (Unsupported "ImageData")
    else
        Js.catchIf
            (λ⊤ →
                checkedData
                    (Js.construct constructor
                        [ Js.from width, Js.from height, settingsValue config ]
                    )
                    config
            )
            (λerror → Js.instanceOf error (Js.global "RangeError"))
            λ_ → Err AllocationFailed


--| Use the exact native Uint8ClampedArray or Float16Array as pixel storage.
--| No copy is made, and later writes to the view change the ImageData.
pub dataFromView : Binary.View, Int, Maybe Int, Settings → Result Error Data
dataFromView pixelView width height config =
    positive width?
    source = Result.mapError (Binary.viewSource pixelView) BinaryError?
    info = Result.mapError (Binary.sourceInfo source) BinaryError?
    if info.shared then
        Err SharedPixels
    else
        name = if config.pixelFormat == Rgba8 then "Uint8ClampedArray" else "Float16Array"
        constructor = Js.global name
        if not (Js.typeIs constructor "function") then
            Err (Unsupported name)
        else if not (Js.instanceOf (Js.from pixelView) constructor) then
            Err WrongPixelView
        else
            stride = if config.pixelFormat == Rgba8 then 4 else 8
            if
                info.byteLength == 0
                    || Int.rem info.byteLength stride ≠ 0
                    || Int.rem (info.byteLength // stride) width ≠ 0
            then
                Err InconsistentPixels
            else
                rows = info.byteLength // stride // width
                positive rows?
                case height of
                    Just explicit →
                        positive explicit?
                        if explicit ≠ rows then
                            Err InconsistentPixels
                        else
                            constructData pixelView width rows config
                    Nothing →
                        constructData pixelView width rows config


--| The original native pixel view, with current detachment checks.
pub pixels : Data → Result Error Binary.View
pixels image =
    value = Js.get (Js.from image) "data"
    _ = Result.mapError (Binary.viewSource (Js.to value)) BinaryError?
    Ok (Js.to value)


--| Create a bitmap from any WebGPU image-source arm. Crop coordinates are signed
--| source pixels. Negative crop extents retain HTML's specified semantics.
pub bitmap : Source.Input, Maybe Crop, BitmapOptions → Result Error Bitmap
bitmap source crop options =
    validateResize options.resizeWidth?
    validateResize options.resizeHeight?
    case crop of
        Nothing →
            ⊤
        Just rect →
            signed rect.x?
            signed rect.y?
            signed rect.width?
            signed rect.height?
            (if rect.width == 0 || rect.height == 0 then Err InvalidCrop else Ok ⊤)?
    function = Js.global "createImageBitmap"
    if not (Js.typeIs function "function") then
        Err (Unsupported "createImageBitmap")
    else
        value = sourceValue source
        config = bitmapValue options
        outcome =
            wait
                (λ⊤ →
                    case crop of
                        Nothing →
                            Js.apply function [ value, config ]
                        Just rect →
                            Js.apply function
                                [ value
                                , Js.from rect.x
                                , Js.from rect.y
                                , Js.from rect.width
                                , Js.from rect.height
                                , config
                                ]
                )
                (domError "InvalidStateError" _)
                λlate → Js.to (Js.call late "close" [])
        case outcome of
            Fulfilled result →
                Ok (Js.to result)
            Rejected _ →
                Err InvalidSource


pub close : Bitmap → ⊤
close value = Js.to (Js.call (Js.from value) "close" [])


constructData : Binary.View, Int, Int, Settings → Result Error Data
constructData pixelView width height config =
    formatSupported config?
    constructor = Js.global "ImageData"
    if not (Js.typeIs constructor "function") then
        Err (Unsupported "ImageData")
    else
        checkedData
            (Js.construct constructor
                [ Js.from pixelView, Js.from width, Js.from height, settingsValue config ]
            )
            config


checkedData : Js.Value, Settings → Result Error Data
checkedData value config =
    if
        config.pixelFormat == Rgba16Float
            && not (Js.same (Js.get value "pixelFormat") (Js.from "rgba-float16"))
    then
        Err (Unsupported "ImageData rgba-float16")
    else if
        config.colorSpace == DisplayP3
            && not (Js.same (Js.get value "colorSpace") (Js.from "display-p3"))
    then
        Err (Unsupported "ImageData display-p3")
    else
        Ok (Js.to value)


settingsValue : Settings → Js.Value
settingsValue config =
    Js.object
        [ ( "colorSpace", Js.from (if config.colorSpace == Srgb then "srgb" else "display-p3") )
        , ( "pixelFormat"
          , Js.from (if config.pixelFormat == Rgba8 then "rgba-unorm8" else "rgba-float16")
          )
        ]


bitmapValue : BitmapOptions → Js.Value
bitmapValue options =
    value = Js.object []
    Js.set
        value
        "imageOrientation"
        (Js.from (if options.orientation == FromImage then "from-image" else "flipY"))
    Js.set
        value
        "premultiplyAlpha"
        (Js.from
            (case options.alpha of
                DefaultAlpha →
                    "default"
                Straight →
                    "none"
                Premultiplied →
                    "premultiply"
            )
        )
    Js.set
        value
        "colorSpaceConversion"
        (Js.from (if options.conversion == DefaultConversion then "default" else "none"))
    Js.set
        value
        "resizeQuality"
        (Js.from
            (case options.quality of
                Pixelated →
                    "pixelated"
                Low →
                    "low"
                Medium →
                    "medium"
                High →
                    "high"
            )
        )
    case options.resizeWidth of
        Nothing →
            ⊤
        Just width →
            Js.set value "resizeWidth" (Js.from width)
    case options.resizeHeight of
        Nothing →
            ⊤
        Just height →
            Js.set value "resizeHeight" (Js.from height)
    value


sourceValue : Source.Input → Js.Value
sourceValue source =
    case source of
        Source.FromImage value →
            Js.from value
        Source.FromBitmap value →
            Js.from value
        Source.FromPixels value →
            Js.from value
        Source.FromVideo value →
            Js.from value
        Source.FromFrame value →
            Js.from value
        Source.FromCanvas value →
            Js.from value
        Source.FromOffscreen value →
            Js.from value


positive : Int → Result Error ⊤
positive value =
    if
        value ≤ 0
            || value > 4294967295
            || not (Js.to (Js.call (Js.global "Number") "isInteger" [ Js.from value ]))
    then
        Err (InvalidDimension value)
    else
        Ok ⊤


signed : Int → Result Error ⊤
signed value =
    if
        value < -2147483648
            || value > 2147483647
            || not (Js.to (Js.call (Js.global "Number") "isInteger" [ Js.from value ]))
    then
        Err (InvalidDimension value)
    else
        Ok ⊤


validateResize : Maybe Int → Result Error ⊤
validateResize value =
    case value of
        Nothing →
            Ok ⊤
        Just size →
            positive size


domError : String, Js.Value → Bool
domError name error =
    Js.instanceOf error (Js.global "DOMException") && Js.same (Js.get error "name") (Js.from name)


type Settled
    = Fulfilled Js.Value
    | Rejected Js.Value


wait : sync (⊤ → Js.Value), sync (Js.Value → Bool), sync (Js.Value → ⊤) → Settled
wait start expected release = Task.callback λresume →
    active = Js.ref True
    _ =
        Js.call (start ⊤) "then"
            [ Js.from λvalue →
                if Js.read active then Task.resume resume (Fulfilled value) else release value
            , Js.from λerror →
                if expected error then
                    if Js.read active then Task.resume resume (Rejected error)
                else
                    _ = Task.soon λ⊤ → Js.throw error
                    ⊤
            ]
    λ⊤ → Js.write active False


formatSupported : Settings → Result Error ⊤
formatSupported config =
    constructor = Js.global "ImageData"
    if not (Js.typeIs constructor "function") then
        Err (Unsupported "ImageData")
    else if
        config.pixelFormat == Rgba16Float
            && (not (Js.typeIs (Js.global "Float16Array") "function")
                   || not
                       (Js.to
                           (Js.call (Js.global "Reflect") "has"
                               [ Js.get constructor "prototype", Js.from "pixelFormat" ]
                           )
                       )
               )
    then
        Err (Unsupported "ImageData rgba-float16")
    else
        Ok ⊤
