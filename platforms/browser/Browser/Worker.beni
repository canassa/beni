-- Dedicated workers. Launches remain behind --allow-unchecked-workers.
import Browser.Host.Console as NativeConsole
import Browser.Host.Data as Data
import Browser.Host.Date as NativeDate
import Browser.Host.Event as NativeEvent
import Browser.Host.EventTarget as NativeTarget
import Browser.Host.Events as NativeEvents
import Browser.Host.RegExp as HostRegExp
import Browser.Host.Rejection as Rejection
import Browser.Host.TextEncoder as TextEncoder
import Browser.Host.Timers as NativeTimers
import Browser.Host.Uint8Array as Uint8Array
import Browser.Host.Worker as NativeWorker
import Browser.WorkerStream exposing (Sink, Stream)
import Browser.WorkerWire as Wire
import Duration exposing (Duration)
import Js
import Js.Any as Any
import Js.Chain as Chain
import Js.Protocol as Protocol
import Schema exposing (Issue)
import Task exposing (Scope)


pub opaque type Program config state protocol
    = Entry V
    | DefinitionProgram
        { boot : Peer, Scope → BootControl
        , metadata : V
        }


type alias BootControl =
    interruptRoot : ⊤ → ⊤
    finishRoot : ⊤ → ⊤


pub opaque type Handle protocol
    = Handle Peer Any.Any


pub opaque type Context event
    = Context { scope : Scope, rootScope : Scope, peer : Peer, request : Bool }


pub opaque type ConnectionId
    = ConnectionId Scope


pub foreign type Policy


type Peer
    = Peer (Js.Ref (Js.Cell PeerFields))


type alias PeerFields =
    native : Maybe NativeWorker.Worker
    endpoint : NativeWorker.Endpoint
    entry : V
    fingerprint : V
    wire : V
    generation : V
    phase : String
    options : Options
    nextId : Int
    startup : Maybe (Task.Resume (Result (OpenReason V) ⊤))
    requests : Chain.Chain Slot
    jobs : Chain.Chain Job
    queue : Chain.Chain Job
    terminal : Int
    closedWaiters : Chain.Chain (Task.Resume Cleanup)
    offer : V → Bool
    end : ⊤ → ⊤
    fail : TransportError → ⊤
    listeners : Chain.Chain (⊤ → ⊤)
    failure : Maybe TransportError
    alive : Int
    owned : Bool
    opening : Bool
    ready : Bool
    defected : Bool
    queuedBytes : Int
    greeting : Maybe V
    greetingWake : Maybe (Task.Resume V)
    eventState : Maybe EventState
    next : Maybe (Task.Resume ⊤)


type EventState
    = EventState (Js.Cell { eventCount : Int, eventBytes : Int, byteLimit : Int, eventLimit : Int })


type Slot
    = Slot
        { peer : Peer
        , id : Int
        , bytes : Int
        , result : Js.Ref (Maybe Outcome)
        , wake : Js.Ref (Maybe (Task.Resume Outcome))
        , interrupted : Js.Ref Bool
        }


type Outcome
    = Succeeded V
    | Failed V
    | Interrupted
    | Transported TransportError


type Job
    = Job
        { id : Int
        , request : V
        , cancel : Js.Ref (Maybe (⊤ → ⊤))
        , interrupted : Js.Ref Bool
        , queued : Js.Ref (Maybe (Chain.Link Job))
        }


peerCell : Peer → Js.Cell PeerFields
peerCell (Peer state) = Js.read state


-- These two constructors are private source machinery called by the emitter.
entryDescriptor : V → Program config state protocol
entryDescriptor metadata = Entry metadata


attachMetadata : Program config state protocol, V → Program config state protocol
attachMetadata definition metadata =
    case definition of
        Entry _ →
            Entry metadata
        DefinitionProgram body →
            DefinitionProgram { body | metadata = metadata }


descriptorOf : Program config state protocol → V
descriptorOf definition =
    case definition of
        Entry metadata →
            metadata
        DefinitionProgram _ →
            fatal "A worker definition was used without its generated entry descriptor"


pub type Credentials
    = Omit
    | SameOrigin
    | Include


pub type Cleanup
    = Confirmed
    | Unconfirmed Loss
    | Abandoned


pub type Loss
    = ReadyExpired
    | LeaseExpired
    | ConnectionLost


pub type ConfigError
    = NonPositiveLimit String
    | InvalidDuration String
    | InvalidPoolBounds
    | InvalidUtilization


pub type PolicyError
    = TrustedTypesUnavailable
    | TrustedPolicyDenied
    | NotTrustedScriptUrl
    | PolicyRefused String
    | InvalidPolicyName


pub type CloneFailure
    = DetachedBuffer
    | ViewOutOfBounds
    | ClosedResource
    | StreamLocked
    | CanvasHasContext
    | TargetRealmUnavailable
    | SameAgentClusterRequired
    | SendingPortTransferred
    | PortBusy
    | DataChannelNotTransferable
    | MediaSourceAlreadyAttached
    | TrackDetached
    | TrackHandleNotTransferable
    | NativeCloneRejected


pub type PrepareError
    = InvalidMessage (List Issue)
    | InvalidResource CloneFailure
    | PreparationClosed


pub type SendError
    = WorkerCloneRejected CloneFailure
    | CanvasTransferInvalidState
    | ChannelClosed
    | QueueFull
    | PreparedForAnotherEndpoint


pub type TransportError
    = SendFailed SendError
    | MessageDeserializationFailed
    | ProtocolVersionMismatch
    | ProtocolRejected (List Issue)
    | PeerUnresponsive
    | PeerClosed
    | CleanupAbandoned


pub type OpenReason error
    = UnsupportedWorkerKind
    | InvalidScriptUrl
    | WorkerSecurityDenied
    | ScriptPolicy PolicyError
    | TrustedScriptUrlRejected
    | WorkerLoadFailed
    | ReadyDeadlineExceeded
    | ClosedBeforeReady
    | InvalidOptions ConfigError
    | InitializationFailed error
    | HandshakeFailed TransportError


pub type alias OpenError error =
    reason : OpenReason error
    cleanup : Cleanup


pub type CallError error
    = Application error
    | PreparationFailed PrepareError
    | Transport TransportError


pub type EmitError
    = EventQueueFull
    | EventChannelClosed
    | EventTargetRequired
    | EventCloneRejected CloneFailure
    | EventCanvasTransferInvalidState


pub type alias Options =
    name : String
    credentials : Credentials
    readyWithin : Duration
    cleanupWithin : Duration
    heartbeatEvery : Duration
    leaseWithin : Duration
    queuedRequests : Int
    queuedEvents : Int
    queuedBytes : Int
    policy : Maybe Policy


pub type alias Protocol call reply streamRequest error event chunk =
    call : call
    reply : reply
    stream : streamRequest
    error : error
    event : event
    chunk : chunk


pub type alias Definition config state call reply streamRequest error event chunk =
    init : Context event, config → Result error state
    start : Context event, state → ⊤
    handle : Context event, state, call → Result error reply
    stream : Context event, state, streamRequest, Sink error chunk → Result error ⊤


pub program :
      Definition config state call reply streamRequest error event chunk
    → Program config state (Protocol call reply streamRequest error event chunk)
program definition =
    callbacks = { definition | start = requireSyncStart definition.start }
    DefinitionProgram
        { boot =
            λpeer lifetime →
                root = Task.spawnIn lifetime λ⊤ →
                    Task.scope λowned →
                        cell = peerCell peer
                        hello =
                            case Js.cellRead cell .greeting of
                                Just incoming →
                                    incoming
                                Nothing →
                                    Task.callback λresume →
                                        Js.cellWrite cell (Just resume) .greetingWake
                                        λ⊤ → Js.cellWrite cell Nothing .greetingWake
                        input = Js.get hello "payload"
                        opts = guestOptions (Js.get input "options")
                        if eventsPossible ⊤ then
                            case Js.cellRead cell .eventState of
                                Nothing →
                                    ⊤
                                Just (EventState credit) →
                                    Js.cellWrite credit opts.queuedEvents .eventLimit
                                    Js.cellWrite credit opts.queuedBytes .byteLimit
                        context =
                            Context
                                { scope = owned, rootScope = owned, peer = peer, request = False }
                        case callbacks.init context (guest (Js.get input "config")) of
                            Err error →
                                terminalReply peer 0 "InitializationFailed" (host error)
                                ⊤
                            Ok state →
                                callbacks.start context state
                                Js.cellWrite cell "Ready" .phase
                                _ = sendFrame peer "Ready" 0 Js.null
                                serve peer owned callbacks state opts
                { interruptRoot = λ⊤ → Task.start (λ⊤ → Task.cancel root) λ_ → ⊤
                , finishRoot =
                    λ⊤ →
                        Task.start
                            (λ⊤ →
                                _ = Task.wait root
                                Task.closeRoot lifetime
                                _ = sendFrame peer "Closed" 0 Js.null
                                NativeWorker.closeSelf ⊤
                            )
                            λ_ → ⊤
                }
        , metadata = Js.null
        }


-- The compiler writes this private build constant at each use site.
pub eventsPossible : ⊤ → Bool
eventsPossible ⊤ = True


pub noStream : Context event, state, ⊥, Sink error ⊥ → Result error ⊤
noStream _ _ impossible _ = never impossible


pub options : Options
options =
    { name = ""
    , credentials = SameOrigin
    , readyWithin = Duration.seconds 30
    , cleanupWithin = Duration.seconds 5
    , heartbeatEvery = Duration.seconds 5
    , leaseWithin = Duration.seconds 30
    , queuedRequests = 64
    , queuedEvents = 64
    , queuedBytes = 1048576
    , policy = Nothing
    }


type alias V =
    Js.Value


host : a → V
host value = Js.from value


guest : V → a
guest value = Js.to value


construct : V, Options → Result (OpenReason error) NativeWorker.Worker
construct descriptor opts =
    if not (NativeWorker.supported ⊤) then
        Err UnsupportedWorkerKind
    else
        credentials =
            case opts.credentials of
                Omit →
                    "omit"
                SameOrigin →
                    "same-origin"
                Include →
                    "include"
        case NativeWorker.tryCreate (guest (Js.get descriptor "url")) opts.name credentials of
            Ok native →
                Ok native
            Err NativeWorker.SyntaxError →
                Err InvalidScriptUrl
            Err NativeWorker.SecurityError →
                Err WorkerSecurityDenied
            Err NativeWorker.TypeError →
                Err TrustedScriptUrlRejected


-- The wire envelope is private control. Application values travel only as payloads.
post : NativeWorker.Endpoint, V → Result SendError ⊤
post endpoint outgoing =
    case NativeWorker.post endpoint outgoing of
        Ok ⊤ →
            Ok ⊤
        Err NativeWorker.DataCloneError →
            Err (WorkerCloneRejected NativeCloneRejected)


frame : String, V → V
frame kind payload = Js.from { worker = 1, kind = kind, payload = payload }


pub opaque type Ticket error reply
    = Ticket Slot


pub opaque type Prepared a
    = Prepared { payload : a, live : Js.Ref Bool }


instances : Js.Ref Int
instances = Js.ref 0


-- All native endpoints remain owned, including peers whose cleanup is unconfirmed.
peers : Chain.Chain Peer
peers = Chain.make ⊤


newPeer : NativeWorker.Endpoint, Maybe NativeWorker.Worker, V, V, V, Options → Peer
newPeer endpoint native entry fingerprint wire opts =
    generation =
        case native of
            Nothing →
                Js.null
            Just _ →
                nextGeneration = Js.read instances + 1
                Js.write instances nextGeneration
                host nextGeneration
    Peer
        (Js.ref
            (Js.cell
                { native = native
                , endpoint = endpoint
                , entry = entry
                , fingerprint = fingerprint
                , wire = wire
                , generation = generation
                , phase = "Starting"
                , options = opts
                , nextId = 0
                , startup = Nothing
                , requests = Chain.make ⊤
                , jobs = Chain.make ⊤
                , queue = Chain.make ⊤
                , terminal = 0
                , closedWaiters = Chain.make ⊤
                , offer = λ_ → False
                , end = λ_ → ⊤
                , fail = λ_ → ⊤
                , listeners = Chain.make ⊤
                , failure = Nothing
                , alive = 0
                , owned = False
                , opening = True
                , ready = False
                , defected = False
                , queuedBytes = 0
                , greeting = Nothing
                , greetingWake = Nothing
                , eventState = Nothing
                , next = Nothing
                }
            )
        )


sendFrame : Peer, String, Int, V → Result SendError ⊤
sendFrame peer kind requestId payload =
    cell = peerCell peer
    wire = Js.cellRead cell .wire
    encoded =
        if kind == "Request" then
            Wire.normalize wire 2 "call" payload
        else if kind == "Success" then
            Wire.normalize wire 2 "reply" payload
        else if kind == "Failure" || kind == "InitializationFailed" then
            Wire.normalize wire 2 "error" payload
        else if kind == "Event" then
            Wire.normalize wire 2 "event" payload
        else
            payload
    post (Js.cellRead cell .endpoint)
        (Js.from
            { worker = 1
            , entry = Js.cellRead cell .entry
            , fingerprint = Js.cellRead cell .fingerprint
            , generation = Js.cellRead cell .generation
            , requestId = requestId
            , kind = kind
            , payload = encoded
            }
        )


listen : Peer, String, sync (NativeEvent.Event → ⊤) → ⊤
listen peer name callback =
    guarded =
        λevent →
            done = Js.ref False
            Js.finally
                (λ⊤ →
                    callback event
                    Js.write done True
                )
                λ⊤ → if Js.read done then ⊤ else stopRealm ⊤
    cell = peerCell peer
    remove =
        NativeEvents.listen (NativeWorker.toEventTarget (Js.cellRead cell .endpoint)) name guarded
    Chain.push (Js.cellRead cell .listeners) remove


unlisten : Peer → ⊤
unlisten peer =
    listeners = Js.cellRead (peerCell peer) .listeners
    case Chain.shift listeners of
        Nothing →
            ⊤
        Just remove →
            Protocol.call remove ⊤
            unlisten peer


wakeStartup : Peer, Result (OpenReason V) ⊤ → ⊤
wakeStartup peer result =
    cell = peerCell peer
    case Js.cellRead cell .startup of
        Nothing →
            ⊤
        Just wake →
            Js.cellWrite cell Nothing .startup
            Task.resume wake result


settle : Peer, Slot, Outcome → ⊤
settle peer (Slot slot) result =
    case Js.read slot.result of
        Just _ →
            ⊤
        Nothing →
            Js.write slot.result (Just result)
            cell = peerCell peer
            Js.cellWrite cell (Js.cellRead cell .queuedBytes - slot.bytes) .queuedBytes
            case Js.read slot.wake of
                Nothing →
                    ⊤
                Just wake →
                    Js.write slot.wake Nothing
                    Task.resume wake result


wakeClosed : Peer, Cleanup → ⊤
wakeClosed peer result =
    waiters = Js.cellRead (peerCell peer) .closedWaiters
    saved = Chain.toList waiters
    Chain.clear waiters
    each saved λwake → Task.resume wake result


transportFailed : Peer, TransportError → ⊤
transportFailed peer failure =
    cell = peerCell peer
    Js.cellWrite cell (Just failure) .failure
    Js.cellWrite cell "Lost" .phase
    _ = sendFrame peer "Close" 0 Js.null
    wakeStartup peer (Err (HandshakeFailed failure))
    each (Chain.toList (Js.cellRead cell .requests)) λslot → settle peer slot (Transported failure)
    Protocol.call (Js.cellRead cell .fail) failure
    wakeClosed peer
        (case failure of
            CleanupAbandoned →
                Abandoned
            _ →
                Unconfirmed ConnectionLost
        )


removePeer : Peer → ⊤
removePeer peer =
    generation = Js.cellRead (peerCell peer) .generation
    case Chain.find peers λitem → Js.same (Js.cellRead (peerCell item) .generation) generation of
        Nothing →
            ⊤
        Just link →
            _ = Chain.remove peers link
            ⊤


terminate : Peer → ⊤
terminate peer =
    case Js.cellRead (peerCell peer) .native of
        Nothing →
            ⊤
        Just native →
            NativeWorker.terminate native


fatal : String → a
fatal message =
    cause = Rejection.create message
    stopRealm ⊤
    Rejection.raise cause


received : Peer, NativeEvent.Event → ⊤
received peer event =
    case NativeEvent.dataOnly event of
        Nothing →
            fatal "Invalid managed worker frame"
        Just incoming →
            receivedData peer incoming


receivedData : Peer, V → ⊤
receivedData peer incoming =
    if Js.isNullish incoming || not (Js.typeIs incoming "object") then
        fatal "Invalid managed worker frame"
    else
        cell = peerCell peer
        kind = Js.get incoming "kind"
        if Js.same kind (host "Defect") then
            workerDefect peer (Js.get incoming "payload")
        else if not (Js.same (Js.get incoming "worker") (host 1)) then
            fatal "Invalid managed worker frame"
        else if
            not (Js.same (Js.get incoming "entry") (Js.cellRead cell .entry))
                || not (Js.same (Js.get incoming "fingerprint") (Js.cellRead cell .fingerprint))
        then
            transportFailed peer ProtocolVersionMismatch
        else if not (Js.same (Js.get incoming "generation") (Js.cellRead cell .generation)) then
            ⊤
        else if Js.same kind (host "Ready") then
            if Js.cellRead cell .phase == "Starting" then
                Js.cellWrite cell "Ready" .phase
                Js.cellWrite cell True .ready
                wakeStartup peer (Ok ⊤)
        else if Js.same kind (host "InitializationFailed") then
            wakeStartup peer (Err (InitializationFailed (Js.get incoming "payload")))
        else if Js.same kind (host "Closed") then
            Js.cellWrite cell "Closed" .phase
            wakeStartup peer (Err ClosedBeforeReady)
            each (Chain.toList (Js.cellRead cell .requests)) λslot →
                settle peer slot (Transported PeerClosed)
            Protocol.call (Js.cellRead cell .end) ⊤
            wakeClosed peer Confirmed
            removePeer peer
            unlisten peer
        else if Js.same kind (host "Event") then
            if eventsPossible ⊤ then
                _ = Protocol.call (Js.cellRead cell .offer) (Js.get incoming "payload")
                ⊤
            else
                fatal "Unknown managed worker control frame"
        else if
            Js.same kind (host "Success")
                || Js.same kind (host "Failure")
                || Js.same kind (host "Interrupt")
        then
            requestId = guest (Js.get incoming "requestId")
            requests = Js.cellRead cell .requests
            case Chain.find requests λ(Slot slot) → slot.id == requestId of
                Nothing →
                    if requestId ≤ Js.cellRead cell .terminal then
                        ⊤
                    else
                        fatal "Unknown worker request ID"
                Just link →
                    case Chain.remove requests link of
                        Nothing →
                            fatal "Worker request disappeared"
                        Just slot →
                            result =
                                if Js.same kind (host "Success") then
                                    Succeeded (Js.get incoming "payload")
                                else if Js.same kind (host "Failure") then
                                    Failed (Js.get incoming "payload")
                                else
                                    Interrupted
                            settle peer slot result
                            Js.cellWrite cell (max (Js.cellRead cell .terminal) requestId) .terminal
        else if Js.same kind (host "TransportFailure") then
            transportFailed peer (decodeTransport (Js.get incoming "payload"))
        else if Js.same kind (host "Pong") then
            Js.cellWrite cell (guest (Js.get incoming "payload")) .alive
        else
            fatal "Unknown managed worker control frame"


validOptions : Options → Result ConfigError ⊤
validOptions opts =
    if opts.queuedRequests ≤ 0 || not (finiteNumber opts.queuedRequests) then
        Err (NonPositiveLimit "queuedRequests")
    else if opts.queuedEvents ≤ 0 || not (finiteNumber opts.queuedEvents) then
        Err (NonPositiveLimit "queuedEvents")
    else if opts.queuedBytes ≤ 0 || not (finiteNumber opts.queuedBytes) then
        Err (NonPositiveLimit "queuedBytes")
    else if
        Duration.toMillis opts.readyWithin ≤ 0
            || not (finiteNumber (Duration.toMillis opts.readyWithin))
    then
        Err (InvalidDuration "readyWithin")
    else if
        Duration.toMillis opts.cleanupWithin ≤ 0
            || not (finiteNumber (Duration.toMillis opts.cleanupWithin))
    then
        Err (InvalidDuration "cleanupWithin")
    else if
        Duration.toMillis opts.heartbeatEvery ≤ 0
            || not (finiteNumber (Duration.toMillis opts.heartbeatEvery))
    then
        Err (InvalidDuration "heartbeatEvery")
    else if
        Duration.toMillis opts.leaseWithin < Duration.toMillis opts.heartbeatEvery
            || not (finiteNumber (Duration.toMillis opts.leaseWithin))
    then
        Err (InvalidDuration "leaseWithin")
    else
        Ok ⊤


installed : Js.Ref Bool
installed = Js.ref False


firstDefect : Js.Ref (Maybe Rejection.Rejection)
firstDefect = Js.ref Nothing


fatalStarted : Js.Ref Bool
fatalStarted = Js.ref False


abandoned : V
abandoned = Js.array []


-- Child launch installs this edge; a leaf worker reaches only the empty hook.
childAbandon : Js.Ref (⊤ → ⊤)
childAbandon = Js.ref λ⊤ → ⊤


installFatal : ⊤ → ⊤
installFatal ⊤ =
    if Js.read installed then
        ⊤
    else
        Js.write installed True
        Js.write childAbandon abandonUnfinished
        Task.chainDefect stopRealm
        _ = NativeEvents.listen (NativeTarget.current ⊤) "error" λevent →
            if Js.read fatalStarted then
                case Js.read firstDefect of
                    Just _ →
                        ⊤
                    Nothing →
                        case NativeEvent.error event of
                            Nothing →
                                ⊤
                            Just cause →
                                Js.write firstDefect (Just cause)
                                Rejection.setAbandoned cause abandoned
        Task.onShutdown λ⊤ →
            each (Chain.toList peers) λpeer →
                _ = sendFrame peer "Close" 0 Js.null
                ⊤
            _ = NativeTimers.start abandonUnfinished 1000
            ⊤


abandonUnfinished : ⊤ → ⊤
abandonUnfinished ⊤ =
    each (Chain.toList peers) λpeer →
        terminate peer
        report =
            Js.from
                { entryId = Js.cellRead (peerCell peer) .entry
                , instanceId = Js.cellRead (peerCell peer) .generation
                , kind = "Dedicated"
                , diagnosticName = (Js.cellRead (peerCell peer) .options).name
                , termination = "NativeTerminated"
                }
        _ = Js.call abandoned "push" [ report ]
        transportFailed peer CleanupAbandoned
        Js.cellWrite (peerCell peer) "Abandoned" .phase
        unlisten peer
    Chain.clear peers
    if Js.to (Js.get abandoned "length") == 0 then
        ⊤
    else
        NativeConsole.errorData "abandonedWorkers" abandoned


heartbeat : Peer, Options → ⊤
heartbeat peer opts =
    Task.sleep opts.heartbeatEvery
    cell = peerCell peer
    if Js.cellRead cell .phase == "Ready" then
        now = NativeDate.now ⊤
        if now - Js.cellRead cell .alive > Duration.toMillis opts.leaseWithin then
            transportFailed peer PeerUnresponsive
        else
            _ = sendFrame peer "Ping" 0 (host now)
            heartbeat peer opts


pub open :
      Scope
    , Program config state (Protocol call reply streamRequest error event chunk)
    , config
    , Options
    → Result (OpenError error) (Handle (Protocol call reply streamRequest error event chunk))
open owner definition config opts =
    installFatal ⊤
    case validOptions opts of
        Err problem →
            Err { reason = InvalidOptions problem, cleanup = Confirmed }
        Ok _ →
            if Chain.size peers ≥ 64 then
                Err { reason = HandshakeFailed (SendFailed QueueFull), cleanup = Confirmed }
            else
                descriptor = descriptorOf definition
                case construct descriptor opts of
                    Err reason →
                        Err { reason = reason, cleanup = Confirmed }
                    Ok native →
                        peer =
                            newPeer
                                (NativeWorker.endpoint native)
                                (Just native)
                                (Js.get descriptor "id")
                                (Js.get descriptor "fingerprint")
                                (Js.get descriptor "$wire")
                                opts
                        cell = peerCell peer
                        stream = Browser.WorkerStream.make opts.queuedEvents
                        Js.cellWrite cell (λ⊤ → Browser.WorkerStream.end stream) .end
                        Js.cellWrite cell (Browser.WorkerStream.fail stream _) .fail
                        if eventsPossible ⊤ then
                            Js.cellWrite
                                cell
                                (λvalue → Browser.WorkerStream.offer stream (guest value))
                                .offer
                            Browser.WorkerStream.onTake stream λitem →
                                _ =
                                    sendFrame
                                        peer
                                        "EventAck"
                                        0
                                        (host (wireBytes (host item) opts.queuedBytes))
                                ⊤
                        Chain.push peers peer
                        listen peer "message" (received peer _)
                        listen peer "messageerror" λ_ →
                            transportFailed peer MessageDeserializationFailed
                        listen peer "error" λevent →
                            if Js.cellRead cell .defected then
                                NativeEvent.preventDefault event
                            else
                                case NativeEvent.errorMessage event of
                                    Just message →
                                        NativeEvent.preventDefault event
                                        workerDefect
                                            peer
                                            (Js.from { message = message, stack = Js.null })
                                    Nothing →
                                        if not (Js.cellRead cell .ready) then
                                            if Js.cellRead cell .phase == "Starting" then
                                                wakeStartup peer (Err WorkerLoadFailed)
                                        else
                                            workerDefect
                                                peer
                                                (Js.from
                                                    { message = "Worker native error event"
                                                    , stack = Js.null
                                                    }
                                                )
                        Task.defer owner λ_ →
                            if Js.cellRead cell .owned || Js.cellRead cell .opening then
                                status = closePeer peer
                                case status of
                                    Unconfirmed _ →
                                        fatal "Worker cleanup was not confirmed"
                                    _ →
                                        ⊤
                        if Js.cellRead cell .phase == "Closed" then
                            failedOpen peer ClosedBeforeReady
                        else
                            Task.onExit
                                (λ⊤ →
                                    result = Task.timeout opts.readyWithin λ⊤ →
                                        Task.callback λresume →
                                            Js.cellWrite cell (Just resume) .startup
                                            case
                                                sendFrame
                                                    peer
                                                    "Hello"
                                                    0
                                                    (Js.from
                                                        { config =
                                                            Wire.normalize
                                                                (Js.cellRead cell .wire)
                                                                0
                                                                ""
                                                                (host config)
                                                        , options = wireOptions opts
                                                        }
                                                    )
                                            of
                                                Ok _ →
                                                    ⊤
                                                Err problem →
                                                    wakeStartup
                                                        peer
                                                        (Err (HandshakeFailed (SendFailed problem)))
                                            λ⊤ → Js.cellWrite cell Nothing .startup
                                    case result of
                                        Just (Ok _) →
                                            if Js.cellRead cell .phase == "Ready" then
                                                Js.cellWrite cell False .opening
                                                Js.cellWrite cell True .owned
                                                Js.cellWrite cell (NativeDate.now ⊤) .alive
                                                _ = Task.spawnIn owner λ⊤ → heartbeat peer opts
                                                Ok (makeHandle peer stream)
                                            else
                                                failedOpen peer ClosedBeforeReady
                                        Just (Err reason) →
                                            failedOpen peer (openReason reason)
                                        Nothing →
                                            failedOpen peer ReadyDeadlineExceeded
                                )
                                λexit →
                                    case exit of
                                        Task.Cancelled →
                                            requireCleanup (closePeer peer)
                                        _ →
                                            ⊤


-- A launch policy is local native authority, never part of the Hello frame.
wireOptions : Options → V
wireOptions opts =
    Js.from
        { name = opts.name
        , credentials = opts.credentials
        , readyWithin = opts.readyWithin
        , cleanupWithin = opts.cleanupWithin
        , heartbeatEvery = opts.heartbeatEvery
        , leaseWithin = opts.leaseWithin
        , queuedRequests = opts.queuedRequests
        , queuedEvents = opts.queuedEvents
        , queuedBytes = opts.queuedBytes
        }


guestOptions : V → Options
guestOptions data =
    { name = guest (Js.get data "name")
    , credentials = guest (Js.get data "credentials")
    , readyWithin = guest (Js.get data "readyWithin")
    , cleanupWithin = guest (Js.get data "cleanupWithin")
    , heartbeatEvery = guest (Js.get data "heartbeatEvery")
    , leaseWithin = guest (Js.get data "leaseWithin")
    , queuedRequests = guest (Js.get data "queuedRequests")
    , queuedEvents = guest (Js.get data "queuedEvents")
    , queuedBytes = guest (Js.get data "queuedBytes")
    , policy = Nothing
    }


openReason : OpenReason V → OpenReason error
openReason reason =
    case reason of
        UnsupportedWorkerKind →
            UnsupportedWorkerKind
        InvalidScriptUrl →
            InvalidScriptUrl
        WorkerSecurityDenied →
            WorkerSecurityDenied
        ScriptPolicy problem →
            ScriptPolicy problem
        TrustedScriptUrlRejected →
            TrustedScriptUrlRejected
        WorkerLoadFailed →
            WorkerLoadFailed
        ReadyDeadlineExceeded →
            ReadyDeadlineExceeded
        ClosedBeforeReady →
            ClosedBeforeReady
        InvalidOptions problem →
            InvalidOptions problem
        InitializationFailed payload →
            InitializationFailed (guest payload)
        HandshakeFailed problem →
            HandshakeFailed problem


pub prepare : a → Result PrepareError (Prepared a)
prepare value = Ok (Prepared { payload = value, live = Js.ref True })


pub discard : Prepared a → ⊤
discard (Prepared prepared) = Js.write prepared.live False


pub send :
      Handle (Protocol call reply streamRequest error event chunk)
    , Prepared call
    → Result SendError (Ticket error reply)
send (Handle peer _) (Prepared reservation) =
    cell = peerCell peer
    if not (Js.read reservation.live) then
        Err ChannelClosed
    else
        Js.write reservation.live False
        if Js.cellRead cell .phase ≠ "Ready" then
            Err ChannelClosed
        else
            opts = Js.cellRead cell .options
            bytes = wireBytes (host reservation.payload) opts.queuedBytes
            requests = Js.cellRead cell .requests
            if
                bytes + Js.cellRead cell .queuedBytes > opts.queuedBytes
                    || Chain.size requests ≥ opts.queuedRequests
            then
                Err QueueFull
            else
                requestId = Js.cellRead cell .nextId + 1
                Js.cellWrite cell requestId .nextId
                slot =
                    Slot
                        { peer = peer
                        , id = requestId
                        , result = Js.ref Nothing
                        , wake = Js.ref Nothing
                        , interrupted = Js.ref False
                        , bytes = bytes
                        }
                link = Chain.append requests slot
                Js.cellWrite cell (Js.cellRead cell .queuedBytes + bytes) .queuedBytes
                case sendFrame peer "Request" requestId (host reservation.payload) of
                    Ok _ →
                        Ok (Ticket slot)
                    Err problem →
                        _ = Chain.remove requests link
                        Js.cellWrite cell (Js.cellRead cell .queuedBytes - bytes) .queuedBytes
                        Err problem


awaitSlot : Slot → Outcome
awaitSlot (Slot slot) =
    case Js.read slot.result of
        Just result →
            result
        Nothing →
            Task.callback λresume →
                Js.write slot.wake (Just resume)
                λ⊤ → Js.write slot.wake Nothing


pub await : Ticket error reply → Result (CallError error) reply
await ((Ticket slot) as ticket) =
    Task.onExit
        (λ⊤ →
            case awaitSlot slot of
                Succeeded payload →
                    Ok (guest payload)
                Failed payload →
                    Err (Application (guest payload))
                Transported problem →
                    Err (Transport problem)
                Interrupted →
                    cancelled = Task.spawn λ⊤ → Task.never ⊤
                    Task.cancel cancelled
                    Task.join cancelled
        )
        λexit →
            case exit of
                Task.Cancelled →
                    requireCleanup (cancel ticket)
                _ →
                    ⊤


pub call :
      Handle (Protocol call reply streamRequest error event chunk)
    , call
    → Result (CallError error) reply
call handle request =
    case prepare request of
        Err problem →
            Err (PreparationFailed problem)
        Ok prepared →
            case send handle prepared of
                Err problem →
                    Err (Transport (SendFailed problem))
                Ok ticket →
                    await ticket


pub cancel : Ticket error reply → Cleanup
cancel (Ticket ((Slot slot) as ticketSlot)) = Task.uninterruptible λ⊤ →
    peer = slot.peer
    cell = peerCell peer
    case Js.read slot.result of
        Just _ →
            ⊤
        Nothing →
            if not (Js.read slot.interrupted) then
                Js.write slot.interrupted True
                case sendFrame peer "Interrupt" slot.id Js.null of
                    Ok _ →
                        ⊤
                    Err problem →
                        transportFailed peer (SendFailed problem)
    opts = Js.cellRead cell .options
    observed = Task.timeout opts.leaseWithin λ⊤ → awaitSlot ticketSlot
    case observed of
        Nothing →
            transportFailed peer PeerUnresponsive
            Unconfirmed LeaseExpired
        Just (Transported problem) →
            case problem of
                CleanupAbandoned →
                    Abandoned
                PeerUnresponsive →
                    Unconfirmed LeaseExpired
                PeerClosed →
                    Confirmed
                _ →
                    Unconfirmed ConnectionLost
        Just _ →
            Confirmed


pub events :
      Handle (Protocol call reply streamRequest error event chunk)
    → Stream TransportError event
events (Handle _ storage) =
    case Any.unpack storage of
        Just value →
            value
        Nothing →
            fatal "Worker event stream identity mismatch"


pub close : Handle protocol → Cleanup
close (Handle peer _) = closePeer peer


closePeer : Peer → Cleanup
closePeer peer = Task.uninterruptible λ⊤ →
    cell = peerCell peer
    phase = Js.cellRead cell .phase
    if phase == "Closed" then
        Confirmed
    else if phase == "Abandoned" then
        Abandoned
    else
        if phase ≠ "Closing" then
            Js.cellWrite cell "Closing" .phase
            case sendFrame peer "Close" 0 Js.null of
                Ok _ →
                    ⊤
                Err problem →
                    transportFailed peer (SendFailed problem)
        opts = Js.cellRead cell .options
        result = Task.timeout opts.cleanupWithin λ⊤ →
            Task.callback λresume →
                waiters = Js.cellRead cell .closedWaiters
                link = Chain.append waiters resume
                if Js.cellRead cell .phase == "Closed" then Task.resume resume Confirmed
                λ⊤ →
                    _ = Chain.remove waiters link
                    ⊤
        case result of
            Just cleanup →
                cleanup
            Nothing →
                transportFailed peer PeerUnresponsive
                Unconfirmed ConnectionLost


pub abort : Handle protocol → Cleanup
abort (Handle peer _) =
    cell = peerCell peer
    if Js.cellRead cell .phase == "Closed" then
        Confirmed
    else
        terminate peer
        transportFailed peer CleanupAbandoned
        Js.cellWrite cell "Abandoned" .phase
        removePeer peer
        unlisten peer
        Abandoned


pub scope : Context event → Scope
scope (Context context) = context.scope


pub connection : Context event → Maybe ConnectionId
connection (Context context) =
    if context.request then Just (ConnectionId context.rootScope) else Nothing


pub emit : Context event, event → Result EmitError ⊤
emit (Context context) value =
    if eventsPossible ⊤ then
        peer = context.peer
        cell = peerCell peer
        case Js.cellRead cell .eventState of
            Nothing →
                Err EventChannelClosed
            Just (EventState credit) →
                encoded = Wire.normalize (Js.cellRead cell .wire) 2 "event" (host value)
                bytes = wireBytes encoded (Js.cellRead credit .byteLimit)
                if Js.cellRead cell .phase == "Closed" then
                    Err EventChannelClosed
                else if
                    Js.cellRead credit .eventCount ≥ Js.cellRead credit .eventLimit
                        || Js.cellRead credit .eventBytes + bytes > Js.cellRead credit .byteLimit
                then
                    Err EventQueueFull
                else
                    case sendFrame peer "Event" 0 encoded of
                        Ok _ →
                            Js.cellWrite credit (Js.cellRead credit .eventCount + 1) .eventCount
                            Js.cellWrite credit (Js.cellRead credit .eventBytes + bytes) .eventBytes
                            Ok ⊤
                        Err _ →
                            Err (EventCloneRejected NativeCloneRejected)
    else
        Err EventChannelClosed


-- Entry runtime: install transport before queuing the owned root.
pub run : Program config state protocol → ⊤
run definition =
    case definition of
        Entry _ →
            fatal "A worker entry descriptor cannot run as a definition"
        DefinitionProgram body →
            runDefinition body.boot body.metadata


runDefinition : sync (Peer, Scope → BootControl), V → ⊤
runDefinition boot metadata =
    peer =
        newPeer
            (NativeWorker.self ⊤)
            Nothing
            Js.null
            (Js.global "__beniWorkerFingerprint")
            (Js.get metadata "$wire")
            options
    cell = peerCell peer
    if eventsPossible ⊤ then
        Js.cellWrite
            cell
            (Just
                (EventState
                    (Js.cell
                        { eventCount = 0, eventBytes = 0, byteLimit = 1048576, eventLimit = 64 }
                    )
                )
            )
            .eventState
    lifetime = Task.openRoot ⊤
    control = Protocol.call (λ⊤ → boot peer lifetime) ⊤
    listen peer "message" (guestReceived peer control.interruptRoot _)
    listen peer "messageerror" λ_ →
        _ = sendFrame peer "TransportFailure" 0 (Js.from { code = "MessageDeserializationFailed" })
        Protocol.call control.interruptRoot ⊤
    Protocol.call control.finishRoot ⊤


guestReceived : Peer, (⊤ → ⊤), NativeEvent.Event → ⊤
guestReceived peer interruptRoot event =
    case NativeEvent.dataOnly event of
        Nothing →
            fatal "Invalid managed worker frame"
        Just incoming →
            guestFrame peer interruptRoot incoming


guestFrame : Peer, (⊤ → ⊤), V → ⊤
guestFrame peer interruptRoot incoming =
    if Js.isNullish incoming || not (Js.typeIs incoming "object") then
        fatal "Invalid managed worker frame"
    else
        cell = peerCell peer
        kind = Js.get incoming "kind"
        greeted =
            case Js.cellRead cell .greeting of
                Nothing →
                    False
                Just _ →
                    True
        if Js.same kind (host "Close") && not greeted then
            Js.cellWrite cell (Js.get incoming "entry") .entry
            Js.cellWrite cell (Js.get incoming "generation") .generation
            Js.cellWrite cell "Closing" .phase
            Protocol.call interruptRoot ⊤
        else if Js.same kind (host "Hello") && not greeted then
            Js.cellWrite cell (Js.get incoming "entry") .entry
            Js.cellWrite cell (Js.get incoming "generation") .generation
            if not (Js.same (Js.get incoming "fingerprint") (Js.cellRead cell .fingerprint)) then
                _ =
                    sendFrame
                        peer
                        "TransportFailure"
                        0
                        (Js.from { code = "ProtocolVersionMismatch" })
                Protocol.call interruptRoot ⊤
            else
                Js.cellWrite cell (Just incoming) .greeting
                case Js.cellRead cell .greetingWake of
                    Nothing →
                        ⊤
                    Just resume →
                        Js.cellWrite cell Nothing .greetingWake
                        Task.resume resume incoming
        else if not (Js.same (Js.get incoming "generation") (Js.cellRead cell .generation)) then
            ⊤
        else if Js.same kind (host "Close") then
            Js.cellWrite cell "Closing" .phase
            Protocol.call interruptRoot ⊤
        else if Js.same kind (host "Request") then
            if Js.cellRead cell .phase ≠ "Ready" then
                ⊤
            else
                requestId = guest (Js.get incoming "requestId")
                jobs = Js.cellRead cell .jobs
                duplicate = Chain.find jobs λ(Job job) → job.id == requestId
                if requestId ≤ Js.cellRead cell .terminal then
                    fatal "Duplicate worker request ID"
                else
                    case duplicate of
                        Just _ →
                            fatal "Duplicate worker request ID"
                        Nothing →
                            queued = Js.ref Nothing
                            job =
                                Job
                                    { id = requestId
                                    , request = Js.get incoming "payload"
                                    , cancel = Js.ref Nothing
                                    , interrupted = Js.ref False
                                    , queued = queued
                                    }
                            Chain.push jobs job
                            link = Chain.append (Js.cellRead cell .queue) job
                            Js.write queued (Just link)
                            case Js.cellRead cell .next of
                                Nothing →
                                    ⊤
                                Just wake →
                                    Js.cellWrite cell Nothing .next
                                    Task.resume wake ⊤
        else if Js.same kind (host "Interrupt") then
            requestId = guest (Js.get incoming "requestId")
            jobs = Js.cellRead cell .jobs
            case Chain.find jobs λ(Job job) → job.id == requestId of
                Nothing →
                    if requestId ≤ Js.cellRead cell .terminal then
                        ⊤
                    else
                        fatal "Unknown interrupt request ID"
                Just handle →
                    case Chain.peek handle of
                        Nothing →
                            fatal "Worker job disappeared"
                        Just (Job job) →
                            Js.write job.interrupted True
                            case Js.read job.cancel of
                                Just cancelWork →
                                    Protocol.call cancelWork ⊤
                                Nothing →
                                    case Js.read job.queued of
                                        Nothing →
                                            ⊤
                                        Just link →
                                            _ = Chain.remove (Js.cellRead cell .queue) link
                                            Js.write job.queued Nothing
                                    _ = Chain.remove jobs handle
                                    _ = sendFrame peer "Interrupt" job.id Js.null
                                    Js.cellWrite
                                        cell
                                        (max (Js.cellRead cell .terminal) job.id)
                                        .terminal
        else if Js.same kind (host "EventAck") then
            if eventsPossible ⊤ then
                case Js.cellRead cell .eventState of
                    Nothing →
                        fatal "Unknown managed worker control frame"
                    Just (EventState credit) →
                        Js.cellWrite credit (Js.cellRead credit .eventCount - 1) .eventCount
                        Js.cellWrite
                            credit
                            (Js.cellRead credit .eventBytes - guest (Js.get incoming "payload"))
                            .eventBytes
            else
                fatal "Unknown managed worker control frame"
        else if Js.same kind (host "Ping") then
            _ = sendFrame peer "Pong" 0 (Js.get incoming "payload")
            ⊤
        else
            fatal "Unknown managed worker control frame"


serve :
      Peer
    , Scope
    , Definition config state call reply streamRequest error event chunk
    , state
    , Options
    → ⊤
serve peer owned callbacks state opts =
    cell = peerCell peer
    queue = Js.cellRead cell .queue
    if Chain.size queue == 0 then
        Task.callback λresume →
            Js.cellWrite cell (Just resume) .next
            λ⊤ → Js.cellWrite cell Nothing .next
    case Chain.shift queue of
        Nothing →
            serve peer owned callbacks state opts
        Just (Job job) →
            Js.write job.queued Nothing
            if Js.read job.interrupted then
                _ = sendFrame peer "Interrupt" job.id Js.null
                ⊤
            else
                fiber = Task.spawnIn owned λ⊤ →
                    Task.scope λrequestScope →
                        callbacks.handle
                            (Context
                                { scope = requestScope
                                , rootScope = owned
                                , peer = peer
                                , request = True
                                }
                            )
                            state
                            (guest job.request)
                Js.write job.cancel (Just λ⊤ → Task.start (λ⊤ → Task.cancel fiber) λ_ → ⊤)
                result = Task.wait fiber
                Js.write job.cancel Nothing
                case result of
                    Task.Cancelled →
                        _ = sendFrame peer "Interrupt" job.id Js.null
                        ⊤
                    Task.Done (Ok reply) →
                        terminalReply peer job.id "Success" (host reply)
                    Task.Done (Err error) →
                        terminalReply peer job.id "Failure" (host error)
            jobs = Js.cellRead cell .jobs
            case Chain.find jobs λ(Job item) → item.id == job.id of
                Nothing →
                    ⊤
                Just link →
                    _ = Chain.remove jobs link
                    ⊤
            Js.cellWrite cell (max (Js.cellRead cell .terminal) job.id) .terminal
            serve peer owned callbacks state opts


requireSyncStart : sync (Context event, state → ⊤) → (Context event, state → ⊤)
requireSyncStart callback = callback


-- A bounded walk over Wire data. Wire rejects native graphs before this
-- helper; neither JSON conversion nor a user codec runs here.
wireBytes : V, Int → Int
wireBytes value limit =
    pending = Chain.make ⊤
    _ = Chain.append pending value
    sizeLoop pending 0 limit


sizeLoop : Chain.Chain V, Int, Int → Int
sizeLoop pending size limit =
    if size > limit then
        size
    else
        case Chain.pop pending of
            Nothing →
                size
            Just item →
                if Js.typeIs item "string" then
                    text : String
                    text = Js.to item
                    bytes = TextEncoder.encode (TextEncoder.create ⊤) text
                    sizeLoop pending (size + Uint8Array.byteLength bytes + 8) limit
                else if Js.isNullish item || not (Js.typeIs item "object") then
                    sizeLoop pending (size + 8) limit
                else
                    appendFields pending item (Data.keys item)
                    sizeLoop pending (size + 8) limit


appendFields : Chain.Chain V, V, List String → ⊤
appendFields pending item fields =
    case fields of
        [] →
            ⊤
        [ field, …rest ] →
            _ = Chain.append pending (Js.get item field)
            appendFields pending item rest


hostStop : Js.Ref (Maybe (⊤ → ⊤))
hostStop = Js.ref Nothing


hostStopped : Js.Ref (Maybe (Int → ⊤))
hostStopped = Js.ref Nothing


-- Installed by this entry, kept private to this module instance.
installHostStop : sync (⊤ → ⊤), sync (Int → ⊤) → ⊤
installHostStop stop stopped =
    Js.write hostStop (Just stop)
    Js.write hostStopped (Just stopped)


stopRealm : ⊤ → ⊤
stopRealm ⊤ =
    Js.write fatalStarted True
    if not (NativeTarget.isPage ⊤) then
        Task.shutdown 1000 λ_ → (Js.read childAbandon) ⊤
    else
        case Js.read hostStop of
            Nothing →
                ⊤
            Just stop →
                Protocol.call stop ⊤
        Task.shutdown 1000 λcut →
            case Js.read hostStopped of
                Nothing →
                    ⊤
                Just stopped →
                    Protocol.call stopped cut


terminalReply : Peer, Int, String, V → ⊤
terminalReply peer requestId kind payload =
    case sendFrame peer kind requestId payload of
        Ok _ →
            ⊤
        Err _ →
            _ = sendFrame peer "TransportFailure" 0 (Js.from { code = "WorkerCloneRejected" })
            ⊤


decodeTransport : V → TransportError
decodeTransport payload =
    code = Js.get payload "code"
    if Js.same code (host "MessageDeserializationFailed") then
        MessageDeserializationFailed
    else if Js.same code (host "ProtocolVersionMismatch") then
        ProtocolVersionMismatch
    else if Js.same code (host "WorkerCloneRejected") then
        SendFailed (WorkerCloneRejected NativeCloneRejected)
    else
        fatal "Unknown worker transport failure"


failedOpen : Peer, OpenReason error → Result (OpenError error) (Handle protocol)
failedOpen peer reason =
    observed = closePeer peer
    Js.cellWrite (peerCell peer) False .opening
    cleanup =
        case ( reason, observed ) of
            ( ReadyDeadlineExceeded, Unconfirmed _ ) →
                Unconfirmed ReadyExpired
            _ →
                observed
    Err { reason = reason, cleanup = cleanup }


finiteNumber : Int → Bool
finiteNumber value = Data.isFinite (host value)


workerDefect : Peer, V → ⊤
workerDefect peer report =
    if Js.cellRead (peerCell peer) .defected then
        ⊤
    else
        Js.cellWrite (peerCell peer) True .defected
        rawValue = Js.get report "message"
        raw : String
        raw =
            if Js.typeIs rawValue "string" then
                guest rawValue
            else
                fatal "Invalid worker defect report"
        named = Js.get report "name"
        pattern = workerNamePattern
        matchedName = HostRegExp.group pattern raw 1
        message =
            if Js.typeIs named "string" then
                raw
            else
                case matchedName of
                    Nothing →
                        HostRegExp.replace workerUncaughtPattern raw ""
                    Just _ →
                        Maybe.withDefault (HostRegExp.group pattern raw 2) raw
        name =
            if Js.typeIs named "string" then
                guest named
            else
                Maybe.withDefault matchedName "Error"
        cause = Rejection.create message
        Rejection.assign cause
            (Js.from
                { name = name
                , entryId = Js.cellRead (peerCell peer) .entry
                , instanceId = Js.cellRead (peerCell peer) .generation
                , realm = "dedicatedWorker"
                }
            )
        stack = Js.get report "stack"
        if Js.typeIs stack "string" && not (Js.same stack (host "")) then
            Rejection.assign cause (Js.from { stack = stack })
        stopRealm ⊤
        Rejection.raise cause


-- Fixed source patterns, allocated once; neither has mutable lastIndex flags.
workerNamePattern : HostRegExp.RegExp
workerNamePattern =
    case HostRegExp.create "^(?:Uncaught )?([A-Za-z_$][A-Za-z0-9_$]*): (.*)$" "s" of
        Ok pattern →
            pattern
        Err _ →
            fatal "Invalid worker error pattern"


workerUncaughtPattern : HostRegExp.RegExp
workerUncaughtPattern =
    case HostRegExp.create "^Uncaught " "" of
        Ok pattern →
            pattern
        Err _ →
            fatal "Invalid worker prefix pattern"


requireCleanup : Cleanup → ⊤
requireCleanup cleanup =
    case cleanup of
        Unconfirmed _ →
            fatal "Worker cleanup was not confirmed"
        _ →
            ⊤


each : List a, (a → ⊤) → ⊤
each values step =
    case values of
        [] →
            ⊤
        [ item, …rest ] →
            step item
            each rest step


makeHandle :
      Peer
    , Stream TransportError event
    → Handle (Protocol call reply streamRequest error event chunk)
makeHandle peer stream = Handle peer (Any.pack stream)
