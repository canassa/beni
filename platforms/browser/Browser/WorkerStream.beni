-- Bounded, single-consumer event streams owned by the worker connection.
import Js
import Js.Chain as Chain
import Js.Protocol as Protocol
import Task


pub type alias Stream error a =
    Storage error a


-- The generic carrier keeps payload and wake-up callback types intact.
pub opaque type Storage error a
    = Storage
        { queue : Chain.Chain a
        , waiter : Js.Ref (Maybe (Task.Resume (Result (ReadError error) (Step a))))
        , failure : Js.Ref (Maybe error)
        , ended : Js.Ref Bool
        , limit : Int
        , busy : Js.Ref Bool
        , taken : Js.Ref (Maybe (a → ⊤))
        }


pub opaque type Sink error a
    = Sink (a → Result error ⊤)


pub opaque type Chunk a
    = Chunk a


pub type ReadError error
    = Failed error
    | StreamClosed
    | StreamUnresponsive


pub type Step a
    = Item (Chunk a)
    | End


pub make : Int → Stream error a
make limit =
    Storage
        { queue = Chain.make ⊤
        , waiter = Js.ref Nothing
        , failure = Js.ref Nothing
        , ended = Js.ref False
        , limit = limit
        , busy = Js.ref False
        , taken = Js.ref Nothing
        }


pub offer : Stream error a, a → Bool
offer ((Storage state) as stream) item =
    if Js.read state.ended then
        False
    else
        case Js.read state.waiter of
            Just wake →
                Js.write state.waiter Nothing
                Task.resume wake (Ok (Item (Chunk item)))
                acknowledge stream item
                True
            Nothing →
                if Chain.size state.queue ≥ state.limit then
                    False
                else
                    _ = Chain.append state.queue item
                    True


pub end : Stream error a → ⊤
end (Storage state) =
    Js.write state.ended True
    case Js.read state.waiter of
        Nothing →
            ⊤
        Just wake →
            Js.write state.waiter Nothing
            Task.resume wake (Ok End)


pub fail : Stream error a, error → ⊤
fail (Storage state) error =
    Js.write state.failure (Just error)
    Chain.clear state.queue
    Js.write state.ended True
    case Js.read state.waiter of
        Nothing →
            ⊤
        Just wake →
            Js.write state.waiter Nothing
            Task.resume wake (Err (Failed error))


pub next : Stream error a → Result (ReadError error) (Step a)
next ((Storage state) as stream) =
    if Js.read state.busy then
        Err StreamClosed
    else
        Task.bracket (λ⊤ → Js.write state.busy True) (λ_ _ → Js.write state.busy False) λ_ →
            case Js.read state.failure of
                Just error →
                    Err (Failed error)
                Nothing →
                    case Chain.shift state.queue of
                        Just item →
                            acknowledge stream item
                            Ok (Item (Chunk item))
                        Nothing →
                            if Js.read state.ended then
                                Ok End
                            else
                                Task.callback λresume →
                                    Js.write state.waiter (Just resume)
                                    λ⊤ → Js.write state.waiter Nothing


pub value : Chunk a → a
value (Chunk item) = item


pub release : Chunk a → ⊤
release _ = ⊤


pub take : Chunk a → a
take chunk = value chunk


-- Transport acknowledgement is synchronous and retains the payload type.
pub onTake : Stream error a, sync (a → ⊤) → ⊤
onTake (Storage state) callback = Js.write state.taken (Just callback)


acknowledge : Stream error a, a → ⊤
acknowledge (Storage state) item =
    case Js.read state.taken of
        Nothing →
            ⊤
        Just callback →
            Protocol.call callback item
