--! What an architecture layered on `browser` builds its commands and
--! subscriptions from (`docs/design/boundary.md` §9.8): the pieces of a
--! running program a `Browser.hosted` program is handed, and the typed
--! pieces of work `Cmd` and `Sub` carry. `browser-tea` is written over
--! this module in beni and does not re-export it; a program never needs it.
--!
--! Every function here that sends is `impure`, and so is every function a
--! body is handed to send with, so a release build never drops a send.

import Browser exposing (Host)
import Js
import Listen
import Task


--| A command's or subscription's key, whatever its type: its type's
--| identity, its type's `compare`, and the value (`boundary.md` §9.8.3).
--| Two keys are the same when they are of one type and that type's
--| `compare` calls them equal — however each was built or stored. A key's
--| type must have `compare`, which is what keeps functions out of keys.
pub foreign type Key


--| Any value as a key. Its type's identity is the compiler's, handed on by
--| every function generic over the key with nothing written.
pub key : k → Key
    where k.compare : k, k → Order
key k = keyOf (Js.fingerprint k EQ) k


foreign pure keyOf : String, k → Key
    where k.compare : k, k → Order


foreign pure compareKeys : Key, Key → Order


--| The order of two keys: by their types' identities, then, for two keys
--| of one type, by that type's `compare`.
pub compare : Key, Key → Order
compare a b = compareKeys a b


--| Whether two keys are the same value.
pub eq : Key, Key → Bool
eq a b = compareKeys a b == EQ


--| Where a running body's messages go: its program, until it is closed.
pub foreign type Outlet msg


--| A new open outlet into the program.
pub foreign impure outlet : Host msg → Outlet msg


--| Send a message through an outlet: its program's `update` runs, now or,
--| during another message's `update`, right after it. Once the outlet is
--| closed, nothing happens.
pub foreign impure emit : Outlet msg, msg → ()


--| Close an outlet: from now on what is sent through it is dropped.
pub foreign impure close : Outlet msg → ()


--| A command's body, as `Cmd` carries it (`boundary.md` §9.8.11). Held
--| in a `foreign type`, so what the body may do is its own: a function in
--| a constructor's field would share one class with every command it is
--| batched or returned with (`transparent-effects-proposal.md` §14.5), and
--| one body that waits would make every body of the program run in a
--| fiber.
pub foreign type Job msg


--| A body as a job.
pub foreign pure job : (Browser.Send msg → ()) → Job msg


--| The same job, its messages passed through `tag`.
pub foreign pure mapJob : Job a, sync (a → b) → Job b


--| Run a job in the calling fiber, handed `send`, until it returns.
pub foreign suspends runJob : Job msg, Browser.Send msg → ()


--| Run a job that cannot suspend, handed `send`: what `Cmd` made of a body
--| whose every use says it never waits.
pub foreign impure callJob : Job msg, Browser.Send msg → ()


--| Work to run after a render, and the function its messages go through.
pub foreign type Later msg


--| After-render work: `body` runs synchronously in the after-render phase
--| of the flush that follows, handed a function that sends to the program.
pub foreign impure later : sync (Browser.Send msg → ()) → Later msg


--| The same work, its messages passed through `tag`.
pub foreign pure mapLater : Later a, sync (a → b) → Later b


--| Queue after-render work into the program's next flush.
pub foreign impure afterRender : Host msg, Later msg → ()


--| A subscription's body or listener, and the function each value it
--| sends is turned into a message with.
pub foreign type Tap msg


--| The body a subscription runs in a fiber, and its tagger. The body is
--| handed a function that sends values of type `a`.
pub foreign impure tap : (Browser.Send a → ()), sync (a → msg) → Tap msg


--| A listener a subscription adds with no fiber, and its tagger
--| (`boundary.md` §9.8.5): handed a function that sends values of type
--| `a`, `start` adds the host's listener and returns what removes it.
pub foreign impure hook : sync ((a → ()) → (() → ())), sync (a → msg) → Tap msg


--| The same subscription, its messages passed through `tag`.
pub foreign pure mapTap : Tap a, sync (a → b) → Tap b


--| How a subscription's tap runs while its key is in the set: a body in a
--| fiber (`tap`'s), or a listener with none (`hook`'s). The first
--| declaration of a key decides which. Only `Sub.listen` makes a `Waits`,
--| so a program whose subscriptions all listen reaches no fiber through
--| them.
pub type Kind
    = Waits
    | Hears


--| A live subscription: the body or listener of the tap it started with,
--| and the taggers every value it sends goes through, which `retap`
--| replaces.
pub foreign type Relay msg


--| A relay into the program for `tap`'s body or listener, with `tap`'s
--| tagger.
pub foreign impure relay : Host msg, Tap msg → Relay msg


--| Run the relay's body, in the current fiber, until it returns.
pub foreign suspends run : Relay msg → ()


--| Run a relay's listener with no fiber (`boundary.md` §9.8.5): added by
--| work queued where a fiber spawned now would first run, each value it
--| sends delivered by work queued where that fiber's resumption would
--| land, and removed by `unhear` or when the program stops.
pub hear : Relay msg → ()
hear r = listen r queue Task.onShutdown


queue : sync (() → ()) → ()
queue work =
    _ = Task.soon work
    ()


foreign impure listen : Relay msg, sync ((() → ()) → ()), sync ((() → ()) → ()) → ()


--| Run a relay's listener in the current fiber, as `Listen.each` runs one,
--| until the fiber is cancelled: how every listener subscription ran
--| before `Sub.on` ran with none, kept for the test hook `fibered`.
pub runHeard : Relay msg → ()
runHeard r = Listen.each (starter r) (deliver r _)


foreign impure starter : Relay msg → ((Js.Value → ()) → (() → ()))


foreign impure deliver : Relay msg, Js.Value → ()


--| The development build's test hook (`boundary.md` §9.8.5): whether the
--| page asked, before the program loaded, for every listener subscription
--| to run in a fiber through `runHeard`. Read only under
--| `Js.development`, so no release build carries it.
pub fibered : () → Bool
fibered () = Js.same (Js.global "__beniFiberSubscriptions") (Js.from True)


--| Replace the relay's taggers with those of `taps`, in order: each value
--| the body sends becomes one message per tap. Every tap must be one that
--| sends what the relay's first did — which is what equal keys promise.
pub foreign impure retap : Relay msg, List (Tap msg) → ()


--| Close a relay: what its body sends from now on is dropped.
pub foreign impure closeRelay : Relay msg → ()


--| Close a relay `hear` runs, and remove its listener now.
pub foreign impure unhear : Relay msg → ()


--| Write the page's title when it differs from `title`: what a document
--| program's render does, so the title and the body never disagree.
pub title : String → ()
title text =
    document = Js.global "document"
    if Js.same (Js.get document "title") (Js.from text) then
        ()
    else
        Js.set document "title" (Js.from text)


--| Stop the program with a defect (`boundary.md` §9.8.10 (c)): an `Error`
--| with the message is thrown, which the page reports as any defect —
--| the development crash screen, logged and stopped in release.
pub defect : String → a
defect message = Js.throw (Js.construct (Js.global "Error") [ Js.from message ])
