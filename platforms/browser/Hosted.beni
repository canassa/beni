--! Typed commands, subscriptions and outlets for the browser architecture.
--! Keys use checked Any; a live subscription retains its source while its
--! current taggers change. No message or callback passes through Js.Value.

import Browser exposing (Host)
import Browser.Host.Document as HostDocument
import Js
import Js.Any as Any
import Js.Chain as Chain
import Js.Host as TypedHost
import Js.Key as TypedKey
import Js.Protocol as Protocol
import Js.TaskHooks as TaskHooks
import Listen
import Task


pub type alias Key =
    TypedKey.Key


pub key : k → Key
    where k.compare : k, k → Order
key value = TypedKey.key value


pub compare : Key, Key → Order
compare left right = TypedKey.compare left right


pub eq : Key, Key → Bool
eq left right = compare left right == EQ


-- Generic carriers keep callback roles and the stored payload summaries apart.
type OutletStorage state
    = OutletStorage state


pub type alias Outlet msg =
    OutletStorage { host : Host msg, open : Js.Ref Bool }


pub outlet : Host msg → Outlet msg
outlet host = OutletStorage { host = host, open = Js.ref True }


pub emit : Outlet msg, msg → ⊤
emit (OutletStorage state) message = if Js.read state.open then TypedHost.send state.host message


pub close : Outlet msg → ⊤
close (OutletStorage state) = Js.write state.open False


type JobStorage msg packet
    = JobStorage packet


pub type alias Job msg =
    JobStorage msg Any.Any


pub job : (Browser.Send msg → ⊤) → Job msg
job body = JobStorage (Any.pack (Task.keepLogContext body))


pub mapJob : Job a, sync (a → b) → Job b
mapJob original tag = JobStorage (Any.pack λsend → runJob original λmessage → send (tag message))


jobBody : Job msg → (Browser.Send msg → ⊤)
jobBody (JobStorage packet) =
    case Any.unpack packet of
        Just body →
            body
        Nothing →
            defect "invalid typed command body"


-- A waiting body uses the normal beni continuation. A Now body is the
-- synchronous protocol selected by Cmd.perform's Js.maySuspend test.
pub runJob : Job msg, Browser.Send msg → ⊤
runJob work send = (jobBody work) send


pub callJob : Job msg, Browser.Send msg → ⊤
callJob work send = Protocol.call (jobBody work) send


type LaterStorage msg packet
    = LaterStorage packet


pub type alias Later msg =
    LaterStorage msg Any.Any


pub later : sync (Browser.Send msg → ⊤) → Later msg
later body = LaterStorage (Any.pack (Task.keepLogContext body))


laterBody : Later msg → (Browser.Send msg → ⊤)
laterBody (LaterStorage packet) =
    case Any.unpack packet of
        Just body →
            body
        Nothing →
            defect "invalid typed after-render body"


pub mapLater : Later a, sync (a → b) → Later b
mapLater original tag =
    LaterStorage (Any.pack λsend → Protocol.call (laterBody original) λmessage → send (tag message))


pub afterRender : Host msg, Later msg → ⊤
afterRender host work = TypedHost.after host λ⊤ →
    Protocol.call (laterBody work) λmessage → TypedHost.send host message


pub type Kind
    = Waits
    | Hears


-- Independent packet parameters retain the source, listener and tagger's
-- summaries independently, including through an exported Tap alias.
type TapStorage msg body listener tagger
    = TapStorage body listener tagger


pub type alias Tap msg =
    TapStorage msg Any.Any Any.Any Any.Any


pub tap : (Browser.Send a → ⊤), sync (a → msg) → Tap msg
tap body tag =
    TapStorage
        (Any.pack λsend → body λvalue → send (Any.pack value))
        (Any.pack emptyListener)
        (Any.pack λpacket → Maybe.map (Any.unpack packet) tag)


pub hook : sync ((a → ⊤) → (⊤ → ⊤)), sync (a → msg) → Tap msg
hook start tag =
    TapStorage
        (Any.pack emptyBody)
        (Any.pack λsend → start λvalue → send (Any.pack value))
        (Any.pack λpacket → Maybe.map (Any.unpack packet) tag)


type alias PacketSend =
    Any.Any → ⊤


type alias PacketBody =
    PacketSend → ⊤


type alias PacketListener =
    PacketSend → (⊤ → ⊤)


emptyBody : PacketBody
emptyBody _ = ⊤


emptyListener : PacketListener
emptyListener _ = λ⊤ → ⊤


tapBody : Tap msg → PacketBody
tapBody (TapStorage packet _ _) =
    case Any.unpack packet of
        Just body →
            body
        Nothing →
            defect "invalid typed subscription body"


tapListener : Tap msg → PacketListener
tapListener (TapStorage _ packet _) =
    case Any.unpack packet of
        Just listener →
            listener
        Nothing →
            defect "invalid typed subscription listener"


tapTagger : Tap msg → (Any.Any → Maybe msg)
tapTagger (TapStorage _ _ packet) =
    case Any.unpack packet of
        Just tag →
            tag
        Nothing →
            defect "invalid typed subscription tagger"


pub mapTap : Tap a, sync (a → b) → Tap b
mapTap original tag =
    TapStorage
        (case original of
            TapStorage body _ _ →
                body
        )
        (case original of
            TapStorage _ listener _ →
                listener
        )
        (Any.pack λpacket → Maybe.map ((tapTagger original) packet) tag)


type RelayStorage state
    = RelayStorage state


type alias RelayData msg =
    source : Tap msg
    host : Host msg
    open : Js.Ref Bool
    queue : Chain.Chain Any.Any
    scheduled : Js.Ref Bool
    taps : Js.Ref (List (Tap msg))
    remove : Js.Ref (Maybe (⊤ → ⊤))
    heard : Js.Ref (Maybe (Chain.Link (⊤ → ⊤)))


pub type alias Relay msg =
    RelayStorage (RelayData msg)


pub relay : Host msg, Tap msg → Relay msg
relay host source =
    RelayStorage
        { source = source
        , host = host
        , open = Js.ref True
        , queue = Chain.make ⊤
        , scheduled = Js.ref False
        , taps = Js.ref [ source ]
        , remove = Js.ref Nothing
        , heard = Js.ref Nothing
        }


tagged : Relay msg, Any.Any → ⊤
tagged (RelayStorage state) packet =
    if Js.read state.open then
        through state.host (Js.read state.taps) packet


through : Host msg, List (Tap msg), Any.Any → ⊤
through host taps packet =
    case taps of
        [] →
            ⊤
        [ currentTap, …rest ] →
            case Protocol.call (tapTagger currentTap) packet of
                Just message →
                    TypedHost.send host message
                Nothing →
                    ⊤
            through host rest packet


pub run : Relay msg → ⊤
run live =
    case live of
        RelayStorage state →
            (tapBody state.source) λpacket → tagged live packet


heard : Js.Ref (Chain.Chain (⊤ → ⊤))
heard = Js.ref (Chain.make ⊤)


released : Js.Ref Bool
released = Js.ref False


releaseAll : ⊤ → ⊤
releaseAll ⊤ =
    case Chain.shift (Js.read heard) of
        Just remove →
            Protocol.call remove ⊤
            releaseAll ⊤
        Nothing →
            ⊤


pub hear : Relay msg → ⊤
hear live =
    case live of
        RelayStorage state →
            queue λ⊤ →
                if Js.read state.open then
                    if not (Js.read released) then
                        Js.write released True
                        TaskHooks.onShutdown releaseAll
                    Js.write state.heard (Just (Chain.append (Js.read heard) λ⊤ → unhear live))
                    Js.write
                        state.remove
                        (Just
                            (Protocol.call (tapListener state.source) λpacket → arrive live packet)
                        )


arrive : Relay msg, Any.Any → ⊤
arrive live packet =
    case live of
        RelayStorage state →
            Chain.push state.queue packet
            if not (Js.read state.scheduled) then
                Js.write state.scheduled True
                queue λ⊤ → deliverQueued live


deliverQueued : Relay msg → ⊤
deliverQueued live =
    case live of
        RelayStorage state →
            case Chain.shift state.queue of
                Just packet →
                    tagged live packet
                    deliverQueued live
                Nothing →
                    Js.write state.scheduled False


queue : sync (⊤ → ⊤) → ⊤
queue work =
    _ = Task.soon work
    ⊤


pub runHeard : Relay msg → ⊤
runHeard live =
    case live of
        RelayStorage state →
            Listen.each (tapListener state.source) λpacket → tagged live packet


pub fibered : ⊤ → Bool
fibered ⊤ = Js.same (Js.global "__beniFiberSubscriptions") (Js.from True)


pub retap : Relay msg, List (Tap msg) → ⊤
retap (RelayStorage state) taps = Js.write state.taps taps


pub closeRelay : Relay msg → ⊤
closeRelay (RelayStorage state) = Js.write state.open False


pub unhear : Relay msg → ⊤
unhear (RelayStorage state) =
    Js.write state.open False
    case Js.read state.heard of
        Just link →
            Js.write state.heard Nothing
            _ = Chain.remove (Js.read heard) link
            ⊤
        Nothing →
            ⊤
    case Js.read state.remove of
        Just remove →
            Js.write state.remove Nothing
            Protocol.call remove ⊤
        Nothing →
            ⊤


pub title : String → ⊤
title text = if HostDocument.title ⊤ ≠ text then HostDocument.setTitle text


pub defect : String → a
defect message = Protocol.defect message
