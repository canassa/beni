--! What an architecture layered on `browser` builds its commands and
--! subscriptions from (`docs/design/boundary.md` §9.8): the pieces of a
--! running program a `Browser.hosted` program is handed, and the typed
--! pieces of work `Cmd` and `Sub` carry. `browser-tea` is written over
--! this module in beni and does not re-export it; a program never needs it.
--!
--! Every function here that sends is `impure`, and so is every function a
--! body is handed to send with, so a release build never drops a send.

-- Written over `Js`, as `core/Task` is: each piece is a JavaScript array or
-- object read and written by position or name, every function it holds is
-- a `Js.Value` called with `Js.apply`, and a value or a message crosses
-- into one at a type variable, so it pins no field name and no tag.

import Browser exposing (Host)
import Js
import Listen
import Task


type alias V =
    Js.Value


-- A beni value seen as a JavaScript one, and back, at a type variable.
host : a → V
host x = Js.from x


guest : V → a
guest v = Js.to v


-- A message to a program, through its host's `send`.
send : V, V → ()
send h msg = Js.to (Js.call h "send" [ msg ])


--| A command's or subscription's key, whatever its type: its type's
--| identity, its type's `compare`, and the value (`boundary.md` §9.8.3).
--| Two keys are the same when they are of one type and that type's
--| `compare` calls them equal — however each was built or stored. A key's
--| type must have `compare`, which is what keeps functions out of keys.
pub foreign type Key


--| Any value as a key. Its type's identity is the compiler's, handed on by
--| every function generic over the key with nothing written.
pub key : k → Key
    where k.compare : k, k → Order
key k = keyOf (Js.fingerprint k EQ) k


-- Hand-written: a beni `<` on the identities is `String.compare`'s
-- code-point order, which ships that function to a page that had none,
-- where JavaScript's `<`, which `Js` cannot write, orders them alike.
foreign pure keyOf : String, k → Key
    where k.compare : k, k → Order


foreign pure compareKeys : Key, Key → Order


--| The order of two keys: by their types' identities, then, for two keys
--| of one type, by that type's `compare`.
pub compare : Key, Key → Order
compare a b = compareKeys a b


--| Whether two keys are the same value.
pub eq : Key, Key → Bool
eq a b = compareKeys a b == EQ


--| Where a running body's messages go: its program, until it is closed.
pub foreign type Outlet msg


--| A new open outlet into the program: `[ h, open ]`.
pub outlet : Host msg → Outlet msg
outlet h = guest (Js.array [ host h, Js.from True ])


--| Send a message through an outlet: its program's `update` runs, now or,
--| during another message's `update`, right after it. Once the outlet is
--| closed, nothing happens.
pub emit : Outlet msg, msg → ()
emit o msg =
    v = host o
    if Js.to (Js.at v 1) then send (Js.at v 0) (host msg) else ()


--| Close an outlet: from now on what is sent through it is dropped.
pub close : Outlet msg → ()
close o = Js.setAt (host o) 1 (Js.from False)


--| A command's body, as `Cmd` carries it (`boundary.md` §9.8.11). Held
--| in a `foreign type`, so what the body may do is its own: a function in
--| a constructor's field would share one class with every command it is
--| batched or returned with (`transparent-effects-proposal.md` §14.5), and
--| one body that waits would make every body of the program run in a
--| fiber.
pub foreign type Job msg


--| A body as a job: the body itself, a function of its `send`.
pub job : (Browser.Send msg → ()) → Job msg
job body = guest (host body)


--| The same job, its messages passed through `tag`.
pub mapJob : Job a, sync (a → b) → Job b
mapJob j tag =
    guest
        (Js.from λs → Js.apply (host j) [ Js.from λm → Js.apply s [ host (tag (guest m)) ] ])


--| Run a job in the calling fiber, handed `send`, until it returns: the
--| body's own value, or the fiber runtime's sentinel when it parked, which
--| this call's caller receives either way.
pub runJob : Job msg, Browser.Send msg → ()
runJob j s = Js.suspending λ() → Js.to (Js.apply (host j) [ host s ])


--| Run a job that cannot suspend, handed `send`: what `Cmd` made of a body
--| whose every use says it never waits.
pub callJob : Job msg, Browser.Send msg → ()
callJob j s = Js.to (Js.apply (host j) [ host s ])


--| Work to run after a render, and the function its messages go through.
pub foreign type Later msg


--| After-render work: `body` runs synchronously in the after-render phase
--| of the flush that follows, handed a function that sends to the program.
--| `[ f, t ]`: the body, and the tagger its messages go through or null.
pub later : sync (Browser.Send msg → ()) → Later msg
later body = guest (Js.array [ host body, Js.null ])


--| The same work, its messages passed through `tag`.
pub mapLater : Later a, sync (a → b) → Later b
mapLater l tag =
    v = host l
    inner = Js.at v 1

    outer =
        if Js.isNull inner then
            host tag
        else
            Js.from λm → Js.apply (host tag) [ Js.apply inner [ m ] ]
    guest (Js.array [ Js.at v 0, outer ])


--| Queue after-render work into the program's next flush.
pub afterRender : Host msg, Later msg → ()
afterRender h l =
    v = host l
    tag = Js.at v 1
    p = host h

    Js.to
        (Js.call p "after"
            [ Js.from λ() →
                Js.apply (Js.at v 0)
                    [ Js.from λm → send p (if Js.isNull tag then m else Js.apply tag [ m ]) ]
            ]
        )


--| A subscription's body or listener, and the function each value it
--| sends is turned into a message with.
pub foreign type Tap msg


--| The body a subscription runs in a fiber, and its tagger. The body is
--| handed a function that sends values of type `a`. `[ b, t ]`: the body
--| or the listener, and the tagger of what it sends.
pub tap : (Browser.Send a → ()), sync (a → msg) → Tap msg
tap body tag = guest (Js.array [ host body, host tag ])


--| A listener a subscription adds with no fiber, and its tagger
--| (`boundary.md` §9.8.5): handed a function that sends values of type
--| `a`, `start` adds the host's listener and returns what removes it.
pub hook : sync ((a → ()) → (() → ())), sync (a → msg) → Tap msg
hook start tag = guest (Js.array [ host start, host tag ])


--| The same subscription, its messages passed through `tag`.
pub mapTap : Tap a, sync (a → b) → Tap b
mapTap tp f =
    v = host tp
    inner = Js.at v 1
    guest (Js.array [ Js.at v 0, Js.from λx → Js.apply (host f) [ Js.apply inner [ x ] ] ])


--| How a subscription's tap runs while its key is in the set: a body in a
--| fiber (`tap`'s), or a listener with none (`hook`'s). The first
--| declaration of a key decides which. Only `Sub.listen` makes a `Waits`,
--| so a program whose subscriptions all listen reaches no fiber through
--| them.
pub type Kind
    = Waits
    | Hears


--| A live subscription: the body or listener of the tap it started with,
--| and the taggers every value it sends goes through, which `retap`
--| replaces.
pub foreign type Relay msg


--| A relay into the program for `tap`'s body or listener, with `tap`'s
--| tagger. `{ b, h, open, q, t, x }`: the tap's body or listener, the
--| program, whether it is open, the values a listener with no fiber sent
--| and that are not yet delivered (null while no delivery is queued), the
--| current taps, whose taggers each value goes through, and what removes
--| that listener once it is added.
pub relay : Host msg, Tap msg → Relay msg
relay h tp =
    guest
        (Js.from
            { b = Js.at (host tp) 0
            , h = host h
            , open = True
            , q = Js.null
            , t = host [ tp ]
            , x = Js.null
            }
        )


-- One value, through the tagger of every current tap of an open relay.
tagged : V, V → ()
tagged r value =
    if Js.to (Js.get r "open") then through (Js.get r "h") (guest (Js.get r "t")) value else ()


through : V, List V, V → ()
through h taps value =
    case taps of
        [] →
            ()

        [ tp, …rest ] →
            _ = send h (Js.apply (Js.at tp 1) [ value ])
            through h rest value


--| Run the relay's body, in the current fiber, until it returns: the
--| body's own value, or the fiber runtime's sentinel when it parked.
pub run : Relay msg → ()
run rl =
    r = host rl
    Js.suspending λ() → Js.to (Js.apply (Js.get r "b") [ Js.from λvalue → tagged r value ])


-- The relays whose listener is added, which the program's stop removes,
-- and whether that removal is registered.
heard : V
heard = Js.construct (Js.global "Set") []


released : Js.Ref Bool
released = Js.ref False


--| Run a relay's listener with no fiber (`boundary.md` §9.8.5): added by
--| work queued where a fiber spawned now would first run, each value it
--| sends delivered by work queued where that fiber's resumption would
--| land, and removed by `unhear` or when the program stops. The first
--| value sent queues one delivery; values sent before it runs, or while it
--| sends, join it, and it sends them all in order.
pub hear : Relay msg → ()
hear rl =
    r = host rl

    queue λ() →
        if Js.to (Js.get r "open") then
            _ =
                if Js.read released then
                    ()
                else
                    _ = Js.write released True
                    Task.onShutdown λ() →
                        _ = Js.each heard λx → Js.to (Js.apply (Js.get x "x") [ Js.null ])
                        Js.to (Js.call heard "clear" [])
            _ = Js.call heard "add" [ r ]
            Js.set r "x" (Js.apply (Js.get r "b") [ Js.from λvalue → arrive r value ])
        else
            ()


arrive : V, V → ()
arrive r value =
    q = Js.get r "q"
    if Js.isNull q then
        _ = Js.set r "q" (Js.array [ value ])
        queue λ() → deliverQueued r 0
    else
        Js.to (Js.call q "push" [ value ])


deliverQueued : V, Int → ()
deliverQueued r i =
    q = Js.get r "q"
    if i < Js.to (Js.get q "length") then
        _ = tagged r (Js.at q i)
        deliverQueued r (i + 1)
    else
        Js.set r "q" Js.null


queue : sync (() → ()) → ()
queue work =
    _ = Task.soon work
    ()


--| Run a relay's listener in the current fiber, as `Listen.each` runs one,
--| until the fiber is cancelled: how every listener subscription ran
--| before `Sub.on` ran with none, kept for the test hook `fibered`.
pub runHeard : Relay msg → ()
runHeard rl =
    r = host rl
    Listen.each (Js.to (Js.get r "b")) λvalue → tagged r value


--| The development build's test hook (`boundary.md` §9.8.5): whether the
--| page asked, before the program loaded, for every listener subscription
--| to run in a fiber through `runHeard`. Read only under
--| `Js.development`, so no release build carries it.
pub fibered : () → Bool
fibered () = Js.same (Js.global "__beniFiberSubscriptions") (Js.from True)


--| Replace the relay's taggers with those of `taps`, in order: each value
--| the body sends becomes one message per tap. Every tap must be one that
--| sends what the relay's first did — which is what equal keys promise.
pub retap : Relay msg, List (Tap msg) → ()
retap r taps = Js.set (host r) "t" (host taps)


--| Close a relay: what its body sends from now on is dropped.
pub closeRelay : Relay msg → ()
closeRelay r = Js.set (host r) "open" (Js.from False)


--| Close a relay `hear` runs, and remove its listener now.
pub unhear : Relay msg → ()
unhear rl =
    r = host rl
    _ = Js.set r "open" (Js.from False)
    x = Js.get r "x"
    if Js.isNull x then
        ()
    else
        _ = Js.set r "x" Js.null
        _ = Js.call heard "delete" [ r ]
        Js.to (Js.apply x [ Js.null ])


--| Write the page's title when it differs from `title`: what a document
--| program's render does, so the title and the body never disagree.
pub title : String → ()
title text =
    document = Js.global "document"
    if Js.same (Js.get document "title") (Js.from text) then
        ()
    else
        Js.set document "title" (Js.from text)


--| Stop the program with a defect (`boundary.md` §9.8.10 (c)): an `Error`
--| with the message is thrown, which the page reports as any defect —
--| the development crash screen, logged and stopped in release.
pub defect : String → a
defect message = Js.throw (Js.construct (Js.global "Error") [ Js.from message ])
