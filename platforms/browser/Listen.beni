--! Listeners on the window or the document (`docs/design/boundary.md`
--! §9.8.5, §9.8.10): the platform's own modules build their subscriptions
--! and direct forms on them — the keyboard and the window in
--! `Browser.Events`, the address in `Browser.Navigation`. A listener is a
--! function of what it sends to that adds the host's listener and returns
--! what removes it; `Sub.on` runs one with no fiber, and `each` runs one
--! in the calling fiber. Each event is read while it is dispatched, so
--! what it carried is not read late. `browser-tea` does not re-export it,
--! as it does not `Hosted`.
--!
--! Fiber listeners keep a typed queue, a waiting continuation and their
--! remover. Values and callbacks retain their original types.

import Browser.Host.Document as HostDocument
import Browser.Host.Event as HostEvent
import Browser.Host.Window as HostWindow
import Js
import Js.Chain as Chain
import Task


--| Add a listener for every event named `name` on `target` (`"window"` or
--| `"document"`) that calls `send (read event)` while the event is
--| dispatched, and return what removes it.
pub on : String, String, sync (HostEvent.Event → a), sync (a → ⊤) → (⊤ → ⊤)
on target name read send = listen target name λevent → send (read event)


listen : String, String, sync (HostEvent.Event → ⊤) → (⊤ → ⊤)
listen target name handler =
    if target == "window" then HostWindow.listen name handler else HostDocument.listen name handler


--| The same over the events of two names on one target: one listener, so
--| an event of one name never overtakes an earlier one of the other.
pub on2 : String, String, String, sync (HostEvent.Event → a), sync (a → ⊤) → (⊤ → ⊤)
on2 target name other read send =
    handler = λevent → send (read event)
    remove = listen target name handler
    removeOther = listen target other handler
    λ⊤ →
        remove ⊤
        removeOther ⊤


--| Call `f` with each value `listener` sends, in order, for as long as the
--| calling fiber runs: the listener is added when the call starts and
--| removed however it ends. Values sent while `f` runs, or before the
--| fiber takes them, are queued, so none is lost and none overtakes
--| another.
pub each listener f = Task.bracket (λ⊤ → open listener) (λl _ → close l) λl → pump l f


type alias Inbox a =
    queue : Chain.Chain a
    waiting : Js.Ref (Maybe (Task.Resume a))
    remove : ⊤ → ⊤


open : sync ((a → ⊤) → (⊤ → ⊤)) → Inbox a
open listener =
    queue = Chain.make ⊤
    waiting = Js.ref Nothing
    handler =
        λvalue →
            case Js.read waiting of
                Nothing →
                    _ = Chain.append queue value
                    ⊤
                Just resume →
                    Js.write waiting Nothing
                    Task.resume resume value
    { queue = queue, waiting = waiting, remove = listener handler }


close : Inbox a → ⊤
close inbox = inbox.remove ⊤


pump : Inbox a, (a → ⊤) → ⊤
pump inbox f =
    f (next inbox)
    pump inbox f


-- The oldest value not yet taken, waiting for one when there is none.
next : Inbox a → a
next inbox = Task.callback λresume → take inbox resume


take : Inbox a, Task.Resume a → (⊤ → ⊤)
take inbox resume =
    case Chain.shift inbox.queue of
        Just value →
            Task.resume resume value
            λ⊤ → ⊤
        Nothing →
            Js.write inbox.waiting (Just resume)
            λ⊤ → Js.write inbox.waiting Nothing
