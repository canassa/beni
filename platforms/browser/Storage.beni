--! Web Storage (`docs/design/boundary.md` §9.8.10 (b)): text kept by key
--! in the browser, for this origin — `Local` until it is cleared, `Session`
--! for as long as the tab. Every call answers at once.
--!
--! Each failure the Web Storage standard documents is a value: storage the
--! browser will not hand over (disabled, a sandboxed frame) holds nothing,
--! so a read finds nothing and a write is `Err Unavailable`; a write past
--! the quota is `Err QuotaExceeded`. Anything else is a defect.
--!
--!     save todos =
--!         case Storage.set Storage.Local "todos" (encode todos) of
--!             Ok ⊤ → Saved
--!             Err Storage.QuotaExceeded → TooMuch
--!             Err Storage.Unavailable → NotSaved
--!
--! The standard documents two failures, and each is caught by its name and
--! nothing broader (CLAUDE.md rule 9): reading `localStorage` or
--! `sessionStorage` may throw a `SecurityError` — the area is then
--! unavailable, as it is when the host gives `null` — and `setItem` may
--! throw a `QuotaExceededError`. Every other exception is thrown on: a
--! defect. `getItem`, `removeItem`, `key` and `length` document none.

import Browser.Host.Storage as HostStorage
import Cmd exposing (Cmd)


--| Which storage: `Local`, kept across visits, or `Session`, kept while
--| the tab is open.
pub type Area
    = Local
    | Session


--| Why a write did not happen.
pub type Error
    = QuotaExceeded
    | Unavailable


--| The text stored under the key, or `Nothing`.
pub get : Area, String → Maybe String
get area key =
    case storage area of
        Nothing →
            Nothing
        Just native →
            HostStorage.get native key


--| Store the text under the key, replacing what was there.
pub set : Area, String, String → Result Error ⊤
set area key value =
    case storage area of
        Nothing →
            Err Unavailable
        Just native →
            case HostStorage.set native key value of
                Ok ⊤ →
                    Ok ⊤
                Err HostStorage.QuotaExceeded →
                    Err QuotaExceeded


--| The command form of `set`: store the text under the key when the
--| command runs, and send `failed` the error only when the write did not
--| happen. The text is a value, computed when the command is made — what
--| is saved is the model as `update` left it, never a function that reads
--| the model later (`docs/design/boundary.md` §9.8.16).
--|
--|     changed model todos =
--|         ( { model | todos = todos }, Storage.save Storage.Local "todos" (encode todos) NotSaved )
pub save : Area, String, String, (Error → msg) → Cmd msg
save area key text failed = Cmd.perform λsend →
    case set area key text of
        Ok ⊤ →
            ⊤

        Err error →
            send (failed error)


--| Forget the key.
pub remove : Area, String → ⊤
remove area key =
    case storage area of
        Nothing →
            ⊤
        Just native →
            HostStorage.remove native key


--| Every key stored, in the browser's order.
pub keys : Area → List String
keys area =
    case storage area of
        Nothing →
            []
        Just native →
            keysFrom native 0 (HostStorage.length native) []


keysFrom : HostStorage.Storage, Int, Int, List String → List String
keysFrom native index size found =
    if index ≥ size then
        found
    else
        case HostStorage.key native index of
            Nothing →
                keysFrom native (index + 1) size found
            Just name →
                keysFrom native (index + 1) size [ …found, name ]


storage : Area → Maybe HostStorage.Storage
storage area =
    case area of
        Local →
            HostStorage.local ⊤
        Session →
            HostStorage.session ⊤
