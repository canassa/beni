--! Web Storage (`docs/design/boundary.md` §9.8.10 (b)): text kept by key
--! in the browser, for this origin — `Local` until it is cleared, `Session`
--! for as long as the tab. Every call answers at once.
--!
--! Each failure the Web Storage standard documents is a value: storage the
--! browser will not hand over (disabled, a sandboxed frame) holds nothing,
--! so a read finds nothing and a write is `Err Unavailable`; a write past
--! the quota is `Err QuotaExceeded`. Anything else is a defect.
--!
--!     save todos =
--!         case Storage.set Storage.Local "todos" (encode todos) of
--!             Ok () -> Saved
--!             Err Storage.QuotaExceeded -> TooMuch
--!             Err Storage.Unavailable -> NotSaved
--!
--! The standard documents two failures, and each is caught by its name and
--! nothing broader (CLAUDE.md rule 9): reading `localStorage` or
--! `sessionStorage` may throw a `SecurityError` — the area is then
--! unavailable, as it is when the host gives `null` — and `setItem` may
--! throw a `QuotaExceededError`. Every other exception is thrown on: a
--! defect. `getItem`, `removeItem`, `key` and `length` document none.

import Js


--| Which storage: `Local`, kept across visits, or `Session`, kept while
--| the tab is open.
pub type Area
    = Local
    | Session


--| Why a write did not happen.
pub type Error
    = QuotaExceeded
    | Unavailable


--| The text stored under the key, or `Nothing`.
pub get : Area, String → Maybe String
get area key =
    s = storage area
    if Js.isNullish s then
        Nothing
    else
        v = Js.call s "getItem" [ Js.from key ]
        if Js.isNull v then
            Nothing
        else
            Just (Js.to v)


--| Store the text under the key, replacing what was there.
pub set : Area, String, String → Result Error ()
set area key value =
    s = storage area
    if Js.isNullish s then
        Err Unavailable
    else
        Js.catchIf
            (λ() →
                _ = Js.call s "setItem" [ Js.from key, Js.from value ]
                Ok ()
            )
            (λerror → isDomError error "QuotaExceededError")
            λ_ → Err QuotaExceeded


--| Forget the key.
pub remove : Area, String → ()
remove area key =
    s = storage area
    if Js.isNullish s then
        ()
    else
        Js.to (Js.call s "removeItem" [ Js.from key ])


--| Every key stored, in the browser's order.
pub keys : Area → List String
keys area =
    s = storage area
    if Js.isNullish s then
        []
    else
        keysFrom s 0 (Js.to (Js.get s "length")) (Js.array [])


keysFrom : Js.Value, Int, Int, Js.Value → List String
keysFrom s i n found =
    if i < n then
        _ = Js.call found "push" [ Js.call s "key" [ Js.from i ] ]
        keysFrom s (i + 1) n found
    else
        Js.to found


-- The area, or `null`: reading it may throw a `SecurityError`.
storage : Area → Js.Value
storage area =
    Js.catchIf
        (λ() →
            case area of
                Local →
                    Js.global "localStorage"

                Session →
                    Js.global "sessionStorage"
        )
        (λerror → isDomError error "SecurityError")
        λ_ → Js.null


isDomError : Js.Value, String → Bool
isDomError error name =
    Js.instanceOf error (Js.global "DOMException") && Js.same (Js.get error "name") (Js.from name)
