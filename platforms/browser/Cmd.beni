--! Commands: the work an `update` asks for (`docs/design/boundary.md`
--! §9.8). A command is data — it names work and does none — so `update`
--! stays a function of its message and model, and a test can inspect what
--! it returned without running anything.
--!
--! The work is a **body**, an ordinary function handed a `Send`: it may
--! wait (a timer, a request) and it sends its results as messages. A body
--! that may wait runs in a fiber of its own, in the program's scope; one
--! that never waits runs where that fiber would have started, with no
--! fiber at all, so a program whose commands never wait ships no fiber
--! runtime (§9.8.11). Nothing here sequences work: a body sequences with
--! `let`, like any other function.
--!
--!     update msg model =
--!         case msg of
--!             Typed q ->
--!                 ( { model | query = q }, Cmd.keyed Search Cmd.Restart (search q _) )
--!             Got hits ->
--!                 ( { model | hits = hits }, Cmd.none )
--!
--!     search q send =
--!         let
--!             _ = Time.sleep (Time.millis 250)
--!         in
--!         send (Got (api.search q))
--!
--! A **key** names the work so a later message can replace, skip, queue or
--! cancel it. Keys are values of any type with `compare`, matched by
--! value. `map` puts a child component's commands under a key of its own,
--! so two instances of one component never share a key.

import Browser
import Hosted exposing (Job, Key, Later)
import Js


--| How a body sends: `Browser.Send`, which never waits.
pub type alias Send msg =
    Browser.Send msg


--| What a keyed body does when a body already runs under its key.
pub type Policy
    = Restart
    | Ignore
    | Queue
    | Concurrent


--| The work an `update` asks for.
pub type Cmd msg
    = Cmd (List (Item msg))


--| One piece of a command, as the architecture running it reads it: an
--| unkeyed body, a keyed one with its key path and policy, a cancellation
--| of one key path or of every key path under a prefix, or after-render
--| work. A body is `Perform` or `Keyed` when it may wait, and `Now` or
--| `KeyedNow` when it never does — decided where the command is made, from
--| what the checker inferred of the body there (`Js.maySuspend`), so a
--| program that never builds `Perform` or `Keyed` reaches no fiber. A
--| program never needs to build or read one.
pub type Item msg
    = Perform (Job msg)
    | Now (Job msg)
    | Keyed (List Key) Policy (Job msg)
    | KeyedNow (List Key) Policy (Job msg)
    | Cancel (List Key)
    | CancelAll (List Key)
    | After (Later msg)


--| No work.
pub none : Cmd msg
none = Cmd []


--| All of these commands, in order.
pub batch : List (Cmd msg) -> Cmd msg
batch cmds = Cmd (List.concat (List.map cmds items))


--| The pieces of a command, in the order they run.
pub items : Cmd msg -> List (Item msg)
items (Cmd list) = list


--| Run `body` in a fiber of its own — or, when it never waits, with no
--| fiber, where that fiber would have started. Nothing can cancel it but
--| the program's end.
pub perform : (Send msg -> ()) -> Cmd msg
perform body =
    if Js.maySuspend body then
        Cmd [ Perform (Hosted.job body) ]
    else
        Cmd [ Now (Hosted.job body) ]


--| Run `body` in a fiber of its own under `key` (with no fiber when it
--| never waits, as `perform`), doing what `policy` says when a body
--| already runs under it:
--|
--|   - `Restart` cancels the running body, waits for its cleanup, then
--|     starts this one. The cancelled body's `send` does nothing from the
--|     moment this command is returned.
--|   - `Ignore` drops this body while one runs.
--|   - `Queue` starts this body when the running one ends.
--|   - `Concurrent` starts it at once, beside the others.
--|
--| A body that waits first is debounced by `Restart`; one that waits last
--| is throttled by `Ignore`.
pub keyed : k, Policy, (Send msg -> ()) -> Cmd msg
    where k.compare : k, k -> Order
keyed k policy body =
    if Js.maySuspend body then
        Cmd [ Keyed [ Hosted.key k ] policy (Hosted.job body) ]
    else
        Cmd [ KeyedNow [ Hosted.key k ] policy (Hosted.job body) ]


--| Cancel every body running under `key`. Their `send` does nothing from
--| the moment this command is returned; with nothing running, nothing
--| happens.
pub cancel : k -> Cmd msg
    where k.compare : k, k -> Order
cancel k = Cmd [ Cancel [ Hosted.key k ] ]


--| Cancel every keyed body of this component and of the components it
--| maps in.
pub cancelAll : Cmd msg
cancelAll = Cmd [ CancelAll [] ]


--| A child component's commands in its parent: their keys under
--| `segment`, which names this instance of the child, and every message
--| they send passed through `tag`. There is no `map` without a segment:
--| a singleton child passes `()`.
--|
--|     RowMsg id m ->
--|         let
--|             ( row, cmd ) = Row.update m (rowOf model id)
--|         in
--|         ( setRow model id row, Cmd.map cmd id (RowMsg id _) )
pub map : Cmd a, k, (a -> msg) -> Cmd msg
    where k.compare : k, k -> Order
map (Cmd list) segment tag =
    s = Hosted.key segment
    Cmd (List.map list (mapItem _ s tag))


mapItem : Item a, Key, (a -> msg) -> Item msg
mapItem item segment tag =
    case item of
        Perform job ->
            Perform (Hosted.mapJob job tag)

        Now job ->
            Now (Hosted.mapJob job tag)

        Keyed path policy job ->
            Keyed [ segment, ...path ] policy (Hosted.mapJob job tag)

        KeyedNow path policy job ->
            KeyedNow [ segment, ...path ] policy (Hosted.mapJob job tag)

        Cancel path ->
            Cancel [ segment, ...path ]

        CancelAll path ->
            CancelAll [ segment, ...path ]

        After work ->
            After (Hosted.mapLater work tag)


--| Run `body` in the after-render phase of the flush that renders this
--| update's model: after every write of the render, before the next
--| message, synchronously, so the nodes it rendered exist and a focus or
--| a measurement costs no frame. It must not wait.
pub afterRender : (Send msg -> ()) -> Cmd msg
afterRender body = Cmd [ After (Hosted.later body) ]


--| Run `work`, as `perform` runs a body, and send what it returns through
--| `tag`: the command form of calling `work` directly.
pub task : (() -> a), (a -> msg) -> Cmd msg
task work tag = perform (λsend -> send (tag (work ())))


--| Run `work`, as `perform` runs a body, for what it does.
pub do : (() -> ()) -> Cmd msg
do work = perform (λ_ -> work ())
