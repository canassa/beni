--! The `browser-direct` platform's runtime module, `Direct` (docs/design/browser-direct.md
--! §4.3, §5.3, §8.2, §9.3): the dispatch guard every entry into program
--! code goes through, the sentinel every slot starts at, and `run`, which
--! mounts the page's programs inside the guard. Written in beni over core's
--! `Js`, as `browser`'s `Rt` is, and this platform's runtime module
--! (`boundary.md` §9.2, *A runtime module*): a page ships only what it
--! reaches, so the empty mounted page writes `run` and what `run` calls
--! and nothing else of it (§13, kill criterion 2).
--!
--! Slice S0 (§14) holds what a static page needs. `end()` — the edited
--! set's reconcile and the after-render point (§8.1, §10.2) — the keyed
--! reconciler (§6.3) and the fibers' teardown (`Task.shutdown`) arrive with
--! the slices that reach them.

import Browser
import Browser.Navigation as Navigation
import Cmd
import Hosted
import Js
import Rt
import Sub
import Task
import Tea
import Url


type alias V =
    Js.Value


-- ---- The sentinel (§5.3) ------------------------------------------------

--| What every slot holds before its first write, and again after its arm
--| is torn down: an object no value is `===` to. Not `undefined`, which a
--| `⊤` is under `--release`.
pub unset : V
unset = Js.object []


-- ---- The dispatch guard (§4.3) ------------------------------------------

-- A throw escaped program code: nothing of any program runs again (§8.2).
dead : Js.Ref Bool
dead = Js.ref False


-- A dispatch is running: a send made now waits for it.
running : Js.Ref Bool
running = Js.ref False


-- The sends made while a dispatch ran, as function, argument pairs in the
-- order they were made; null until the first.
queue : Js.Ref V
queue = Js.ref Js.null


--| `(f, x)`: one entry into program code — a listener body with its
--| event, `dispatch` with a message, `run`'s mount with the page's
--| programs. A send made while another runs is queued and applied, in
--| order, before that dispatch ends, never re-entrantly (`boundary.md`
--| §9.8.4), on every page (the owner, 2026-10-12); once the page has
--| stopped it does nothing. There is no `catch`: a throw passes through to
--| the host, and stops the page.
pub send : V, V → ⊤
send f x =
    if Js.read dead then
        ⊤
    else if Js.read running then
        if Js.isNull (Js.read queue) then
            Js.write queue (Js.array [])
        _ = Js.call (Js.read queue) "push" [ f, x ]
        ⊤
    else
        Js.write running True
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                _ = Js.apply f [ x ]
                finish ⊤
                -- The development verify mode (§8.3): every mounted
                -- program's page checked against its model, once the
                -- dispatch's messages have all applied. A release build
                -- has no code for it.
                if Js.development ⊤ then
                    Js.each verifiers λcheck → Js.to (Js.apply check [])
                Js.write ok True
            )
            λ⊤ →
                Js.write running False
                if Js.read ok then ⊤ else stop ⊤


-- Apply every queued send, in the order they were made; one applied may
-- send more, which apply after them, in this dispatch.
drain : ⊤ → ⊤
drain ⊤ =
    if Js.isNull (Js.read queue) then
        ⊤
    else
        q = Js.read queue
        Js.write queue Js.null
        applyFrom q 0
        drain ⊤


applyFrom : V, Int → ⊤
applyFrom q i =
    if i < Js.to (Js.get q "length") then
        _ = Js.apply (Js.at q i) [ Js.at q (i + 1) ]
        applyFrom q (i + 2)


-- ---- A defect stops the page (§8.2) -------------------------------------

-- A throw ended a dispatch: the page stops — `dead` first, so a throw
-- while the screen is drawn cannot leave the page running — and a
-- development build shows the crash screen, which installs the `error`
-- listener that adds the host's report of the throw to it (§8.2, as
-- amended). A release build has no code for one; the host reports the
-- throw.
stop : ⊤ → ⊤
stop ⊤ =
    wasDead = Js.read dead
    Js.write dead True
    Js.write queue Js.null
    Js.write later (Js.array [])
    Js.write waiters (Js.array [])
    if Js.development ⊤ && not wasDead then
        crashScreen ⊤
    if Js.isNull (Js.read phase) then ⊤ else Task.shutdown 1000 stopped


-- An overlay above the page, which it leaves in place to inspect, the same
-- as `browser`'s: the error's text arrives with the host's report of the
-- throw, which reaches the window after the guard's `finally`.
crashScreen : ⊤ → ⊤
crashScreen ⊤ =
    document = Js.global "document"
    screen = Js.call document "createElement" [ Js.from "div" ]

    _ =
        Js.call screen "setAttribute"
            [ Js.from "style"
            , Js.from
                "position:fixed;inset:0;z-index:2147483647;overflow:auto;margin:0;padding:24px;background:#fff;color:#a00;font:14px/1.5 monospace;white-space:pre-wrap"
            ]

    Js.set
        screen
        "textContent"
        (Js.from
            "This program has stopped.\n\nSomething it ran threw an exception, so its state can no longer be trusted and nothing more of it runs. The exception is below, and in the console with its stack.\n\n"
        )

    _ = Js.call (Js.get document "body") "appendChild" [ screen ]

    add =
        λmore →
            shown : String
            shown = Js.to (Js.get screen "textContent")
            Js.set screen "textContent" (Js.from (shown ++ more))

    seen = Js.ref 0

    report =
        λevent →
            error = Js.get event "error"
            message : String
            message =
                Js.to
                    (Js.apply (Js.global "String")
                        [ if Js.isNullish error then Js.get event "message" else error ]
                    )

            n = Js.read seen
            Js.write seen (n + 1)

            add
                (if n == 0 then
                    message
                 else if n == 1 then
                    "\n\nWhile stopping, cleanup also threw:\n" ++ message
                 else
                    "\n" ++ message
                )

    Js.write screenLine (Js.from add)
    Js.write screenReport (Js.from report)
    Js.to
        (Js.call (Js.global "window") "addEventListener"
            [ Js.from "error"
            , Js.from report
            , Js.from { once = not (Task.cleansUp ⊤) }
            ]
        )


-- ---- Mounting (§8.2, §9.3) ----------------------------------------------

--| `(program)`: every mount the page's `main` holds, in order, inside one
--| dispatch, so a throw while mounting — a missing element, a program's
--| `init` — stops the page as any defect does.
pub run : V → ⊤
run program = send (Js.from mountAll) program


-- One program value mounted twice would share one state: refused before
-- any program renders (§8.2). Then each mount, in order.
mountAll : V → ⊤
mountAll program =
    Js.each program λm →
        a = Js.get m "a"

        if not (Js.isUndefined (Js.get a "$mounted")) then
            fault
                (if Js.development ⊤ then
                    "a program is mounted twice: build each mount's program with a function"
                 else
                    "mounted twice"
                )
        Js.set a "$mounted" (Js.from True)
    Js.each program λm → mountOne m


-- A mount's element — `document.body` unless it names one — handed with a
-- `template` element of its own to the mount the lowering compiled. A
-- mount node that is missing, or that holds a program already, is a fault
-- of the page, thrown before that program renders anything.
mountOne : V → ⊤
mountOne m =
    document = Js.global "document"

    root =
        if Js.isNull (Js.get m "n") then
            Js.get document "body"
        else
            Js.call document "getElementById" [ Js.get m "n" ]

    if Js.isNull root || not (Js.isUndefined (Js.get root "$$root")) then
        id : String
        id = Js.to (Js.get m "n")
        fault
            (if not (Js.development ⊤) then
                "cannot mount at ${id}"
             else if Js.isNull root && Js.isNull (Js.get m "n") then
                "the page has no body to mount a program at"
             else if Js.isNull root then
                "no element has the id \"${id}\" to mount a program at"
             else if Js.isNull (Js.get m "n") then
                "the page's body already holds a program"
             else
                "the element \"${id}\" already holds a program"
            )
    Js.set root "$$root" (Js.from True)
    _ = Js.apply (Js.get m "a") [ root, Js.call document "createElement" [ Js.from "template" ] ]
    ⊤


-- A fault of the page, thrown: a development build says what is wrong in
-- prose, a release build in a few words (§8.4, as amended for the lean
-- slice).
fault : String → ⊤
fault message = Js.throw (Js.construct (Js.global "Error") [ Js.from message ])


-- ---- What the page's writes call (§5.1, §5.3) ---------------------------
--
-- A hole's or an attribute's write is `backend.md` §15.3's, the same as
-- `browser`'s `Rt` makes it, so both platforms show one page: these are
-- that module's functions, written again here because a runtime module is
-- one platform's (`boundary.md` §9.2).

--| `(parent, marker, value)`: a text hole's node, made at mount before the
--| marker (or last, for none).
pub insertText : V, V, V → V
insertText parent marker value =
    Js.call parent "insertBefore"
        [ Js.call (Js.global "document") "createTextNode" [ value ], marker ]


--| `(el, name, value)`: the attribute, or none when `value` is null.
pub attr : V, V, V → ⊤
attr el name value =
    if Js.isNull value then
        Js.to (Js.call el "removeAttribute" [ name ])
    else
        Js.to (Js.call el "setAttribute" [ name, value ])


--| `(el, namespace, name, value)`: an attribute of a namespace
--| (`xlink:href`).
pub attrNS : V, V, V, V → ⊤
attrNS el namespace name value =
    if Js.isNull value then
        Js.to
            (Js.call el "removeAttributeNS"
                [ namespace
                , Js.call name "slice"
                    [ Js.from (Js.to (Js.call name "indexOf" [ Js.from ":" ]) + 1) ]
                ]
            )
    else
        Js.to (Js.call el "setAttributeNS" [ namespace, name, value ])


--| Elm's rule: a URL whose scheme is `javascript:`, or `data:text/html`,
--| with any whitespace or control character where a browser ignores one,
--| runs script, so it is written as nothing. A test of one pattern, which
--| throws nothing: nothing to catch.
pub safeUrl : V → V
safeUrl url =
    if Js.to (Js.call scriptUrl "test" [ url ]) then
        Js.from ""
    else
        url


-- The pattern `safeUrl` refuses, made once.
scriptUrl : V
scriptUrl =
    Js.regExp
        "^[\\s\\x00-\\x20]*(j\\s*a\\s*v\\s*a\\s*s\\s*c\\s*r\\s*i\\s*p\\s*t\\s*:|d\\s*a\\s*t\\s*a\\s*:\\s*t\\s*e\\s*x\\s*t\\s*/\\s*h\\s*t\\s*m\\s*l\\s*[,;])"
        "i"


--| `(el, markup)`: the `raw` escape hatch, markup text written unescaped.
pub rawHtml : V, V → ⊤
rawHtml el markup = Js.set el "innerHTML" markup


--| `(el, list, previous)`: the element has exactly the classes the list
--| names; what only the previous list (`unset` at the mount) held is
--| removed.
pub classes : V, V, V → ⊤
classes el list previous =
    next = classSet list

    old =
        if Js.isNull previous || Js.same previous unset then
            Js.null
        else
            classSet previous

    if Js.isNull old then
        ⊤
    else
        Js.each old λname →
            if Js.to (Js.call next "has" [ name ]) then
                ⊤
            else
                Js.to (Js.call (Js.get el "classList") "remove" [ name ])
    Js.each next λname →
        if Js.isNull old || not (Js.to (Js.call old "has" [ name ])) then
            Js.to (Js.call (Js.get el "classList") "add" [ name ])


-- The names whose flag is `True`, a name holding whitespace being several.
classSet : V → V
classSet list =
    names = Js.construct (Js.global "Set") []

    Js.each (elements list) λentry →
        if Js.to (Js.get entry "b") then
            Js.each (Js.call (Js.get entry "a") "split" [ spaces ]) λname →
                if Js.same name (Js.from "") then
                    ⊤
                else
                    Js.to (Js.call names "add" [ name ])
    names


-- HTML's whitespace, which separates class names.
spaces : V
spaces = Js.construct (Js.global "RegExp") [ Js.from "[\t\n\u{000C}\r ]+" ]


--| `(el, list, previous)`: each property set to its last value in the
--| list, an empty value removing it; a property only the previous list
--| (`unset` at the mount) set is removed.
pub styles : V, V, V → ⊤
styles el list previous =
    next = styleMap list

    old =
        if Js.isNull previous || Js.same previous unset then
            Js.null
        else
            styleMap previous

    style = Js.get el "style"

    if Js.isNull old then
        ⊤
    else
        Js.each (Js.call old "keys" []) λname →
            if Js.to (Js.call next "has" [ name ]) then
                ⊤
            else
                Js.to (Js.call style "removeProperty" [ name ])
    Js.each next λentry →
        if Js.isNull old || not (Js.same (Js.call old "get" [ Js.at entry 0 ]) (Js.at entry 1)) then
            Js.to (Js.call style "setProperty" [ Js.at entry 0, Js.at entry 1 ])


-- Each property's last value.
styleMap : V → V
styleMap list =
    values = Js.construct (Js.global "Map") []

    Js.each (elements list) λentry →
        Js.to (Js.call values "set" [ Js.get entry "a", Js.get entry "b" ])
    values


-- A list's elements, by backend.md §4's protocol: the array itself, or a
-- view's or a trie's plain copy. Read, never written.
elements : V → V
elements list =
    if Js.to (Js.call (Js.global "Array") "isArray" [ list ]) then
        list
    else
        Js.call list "$plain" []


--| The payload of an event whose handler takes the event itself.
pub identity : V → V
identity event = event


-- ---- Lists (§6, as amended for S2 and S3) -------------------------------
--
-- A `For`'s descriptor is `{ p, n, r, m, o, k, u, w, x, d, z, i }`: its
-- parent element (null for a list at the view's top level, whose parent is
-- its end marker's), its end marker (null when its rows come last), its row
-- instances in list order, `make` — `(item, list, position) → instance` —
-- whether its rows are the parent's only children, its key function (null
-- for a positional list), the instance of the row it is in; then (S3) the
-- whole-row patch `(r) → ⊤` (null where nothing patches a row whole), the
-- key map and the count of rows past the first of their key (both null on a
-- list that keeps no map), the selector's last probe, and whether its rows
-- read their position. An instance is `{ e, it, … }`: its row's one element
-- and the item it shows, and what the lowering keeps (`i`, its position, on
-- a row that reads it). Every loop over rows is here, since the code the
-- lowering writes has none (`boundary.md` §9.4.3); each function ships only
-- where a page reaches it.
--
-- **The key map** (S3) is exact whenever `d` is 0: one entry per row, the
-- row with that key. A row made registers its key (`d` counts one more
-- when it is there already); a removal while `d` is 0 deletes it; the
-- reconcile rebuilds both; a clear empties both. A script whose rows a
-- repeated key would match by rank (language.md §11.9) runs only while
-- `d` is 0 and its new keys are not in the map, and otherwise hands the
-- list to `reconcile`, which is rank-correct for any list.

-- The list's parent node.
parentOf : V → V
parentOf list =
    p = Js.get list "p"
    if Js.isNull p then Js.get (Js.get list "n") "parentNode" else p


-- A list's length, by `backend.md` §4's protocol.
count : V → Int
count xs = Js.to (Js.get xs "length")


-- Element `j` of a list, `0 ≤ j < length`: a plain list's directly, any
-- other's through `List.get`, which reads a trie's leaf without flattening
-- the trie (§6.2: an indexed script never flattens the list).
at : V, Int → V
at xs j =
    if Js.to (Js.call (Js.global "Array") "isArray" [ xs ]) then
        Js.at xs j
    else
        list : List V
        list = Js.to xs

        case List.get list j of
            Just v →
                v

            Nothing →
                Js.undefined


-- Row `item` made at position `j`, its key registered.
make : V, V, Int → V
make list item j =
    r = Js.call list "m" [ item, list, Js.from j ]
    enter list r
    r


-- Put `node` before `before`, or last for null.
put : V, V, V → ⊤
put list node before =
    _ = Js.call (parentOf list) "insertBefore" [ node, before ]
    ⊤


-- A row's key, and an item's.
keyOf : V, V → V
keyOf list r = itemKey list (Js.get r "it")


itemKey : V, V → V
itemKey list it = Js.apply (Js.get list "k") [ it ]


--| `()`: a new key map, for a list that keeps one (`x`).
pub keyMap : ⊤ → V
keyMap ⊤ = Js.construct (Js.global "Map") []


-- Row `r` made: its key in the list's map, when the list keeps one.
enter : V, V → ⊤
enter list r =
    x = Js.get list "x"

    if Js.isNull x then
        ⊤
    else
        key = keyOf list r

        if Js.to (Js.call x "has" [ key ]) then
            d : Int
            d = Js.to (Js.get list "d")
            Js.set list "d" (Js.from (d + 1))
        else
            _ = Js.call x "set" [ key, r ]
            ⊤


-- Row `r` removed: its key out of the map, while the map is exact.
leave : V, V → ⊤
leave list r =
    x = Js.get list "x"
    if not (Js.isNull x) && distinct list then
        _ = Js.call x "delete" [ keyOf list r ]
        ⊤


-- The list's keys are each one row's: the map says so, or there is none.
distinct : V → Bool
distinct list = Js.isNull (Js.get list "x") || Js.to (Js.get list "d") == 0


-- Whether a key is a row's already, by the map (false with no map).
hasKey : V, V → Bool
hasKey list key =
    x = Js.get list "x"
    not (Js.isNull x) && Js.to (Js.call x "has" [ key ])


-- The map made again from the rows (the reconcile's end).
rekeyAll : V → ⊤
rekeyAll list =
    x = Js.get list "x"
    if not (Js.isNull x) then
        _ = Js.call x "clear" []
        Js.set list "d" (Js.from 0)
        Js.each (Js.get list "r") λr → enter list r


-- Each row from `j` on that reads its position and is not where it was:
-- given its position and patched whole (§6.2, as amended for S3).
renumber : V, Int → ⊤
renumber list j =
    if Js.to (Js.get list "i") then
        renumberFrom list (Js.get list "r") j


renumberFrom : V, V, Int → ⊤
renumberFrom list insts j =
    if j < count insts then
        r = Js.at insts j
        if Js.to (Js.get r "i") ≠ j then
            Js.set r "i" (Js.from j)
            _ = Js.apply (Js.get list "w") [ r ]
            ⊤
        renumberFrom list insts (j + 1)


--| `(L, first, xs)`: the rows the template holds (K3), from its first row
--| on, one per item: each one's instance made over its element, which
--| `make` is handed instead of a clone.
pub adopt : V, V, V → ⊤
adopt list first xs =
    items = elements xs
    adoptFrom list items (Js.get list "r") first 0 (count items)


adoptFrom : V, V, V, V, Int, Int → ⊤
adoptFrom list items insts el j n =
    if j < n then
        r = Js.call list "m" [ Js.at items j, list, Js.from j, el ]
        enter list r
        _ = Js.call insts "push" [ r ]
        adoptFrom list items insts (Js.get el "nextSibling") (j + 1) n


--| `(L, xs)`: `append` (§6.2): the rows past the last, made and put after
--| it, when the list grew. Rank-safe: an item after every row takes the
--| last rank of its key. A list's first rows are made by it too, at the
--| mount and when a reconcile finds no row (the one loop that makes rows
--| into a fragment).
pub append : V, V → ⊤
append list xs =
    insts = Js.get list "r"
    n = count insts
    m = count xs
    if m > n then
        fragment = Js.call (Js.global "document") "createDocumentFragment" []
        appendInto list xs insts fragment n m
        put list fragment (Js.get list "n")


appendInto : V, V, V, V, Int, Int → ⊤
appendInto list xs insts fragment j m =
    if j < m then
        r = make list (at xs j) j
        _ = Js.call fragment "appendChild" [ Js.get r "e" ]
        _ = Js.call insts "push" [ r ]
        appendInto list xs insts fragment (j + 1) m


--| `(L, xs)`: `prepend` (§6.2): the new first rows, made and put before the
--| old first, when the list grew — or the reconcile, when a new row's key
--| is a row's already (its rank would take that row).
pub prepend : V, V → ⊤
prepend list xs =
    insts = Js.get list "r"
    n = count insts
    m = count xs
    if m > n then
        if not (distinct list) || anyHeld list xs 0 (m - n) then
            reconcile list xs
        else
            fresh = Js.array []
            fragment = Js.call (Js.global "document") "createDocumentFragment" []
            appendInto list xs fresh fragment 0 (m - n)
            put list fragment (if n == 0 then Js.get list "n" else Js.get (Js.at insts 0) "e")
            Js.set list "r" (Js.call fresh "concat" [ insts ])
            renumber list (m - n)


-- Whether an item from `j` to `end - 1` has a key a row has.
anyHeld : V, V, Int, Int → Bool
anyHeld list xs j end =
    if j ≥ end then
        False
    else if hasKey list (itemKey list (at xs j)) then
        True
    else
        anyHeld list xs (j + 1) end


--| `(L)`: `clear` (§6.2): every row removed — the parent emptied when the
--| rows are all it holds.
pub clear : V → ⊤
clear list =
    insts = Js.get list "r"
    if count insts > 0 then
        if Js.to (Js.get list "o") then
            Js.set (Js.get list "p") "textContent" (Js.from "")
        else
            Js.each insts λr → Js.to (Js.call (Js.get r "e") "remove" [])
        Js.set list "r" (Js.array [])
        x = Js.get list "x"
        if not (Js.isNull x) then
            _ = Js.call x "clear" []
            Js.set list "d" (Js.from 0)


--| `(L, xs, j)`: `insert j` (§6.2): one row made and put at `j`, when the
--| list grew by one and `j` is a place in it — or the reconcile, when its
--| key is a row's already.
pub insert : V, V, Int → ⊤
insert list xs j =
    insts = Js.get list "r"
    n = count insts
    if count xs == n + 1 && j ≥ 0 && j ≤ n then
        if not (distinct list) || hasKey list (itemKey list (at xs j)) then
            reconcile list xs
        else
            r = make list (at xs j) j
            put list (Js.get r "e") (if j == n then Js.get list "n" else Js.get (Js.at insts j) "e")
            _ = Js.call insts "splice" [ Js.from j, Js.from 0, r ]
            renumber list (j + 1)


--| `(L, xs, j)`: `removeAt j` (§6.2): row `j` removed, when the list shrank
--| by one and `j` was a row — or the reconcile, where a key repeats.
pub removeAt : V, V, Int → ⊤
removeAt list xs j =
    insts = Js.get list "r"
    n = count insts
    if count xs == n - 1 && j ≥ 0 && j < n then
        if not (distinct list) then
            reconcile list xs
        else
            r = Js.at insts j
            leave list r
            _ = Js.call (Js.get r "e") "remove" []
            _ = Js.call insts "splice" [ Js.from j, Js.from 1 ]
            renumber list j


--| `(L, xs, i, j)`: `swap i j` (§6.2): rows `i` and `j` trade places — two
--| `insertBefore`s, as vanilla's swap — when both are rows, they differ and
--| the items moved (so a list already in its new order is left alone); the
--| reconcile where a key repeats.
pub swap : V, V, Int, Int → ⊤
swap list xs i j =
    insts = Js.get list "r"
    n = count insts
    if
        i ≥ 0
            && j ≥ 0
            && i < n
            && j < n
            && i ≠ j
            && not (Js.same (at xs i) (Js.get (Js.at insts i) "it"))
    then
        if not (distinct list) then
            reconcile list xs
        else
            trade list insts i j


-- Rows `i` and `j` (in range, not the same) trade places in the page and in
-- the rows, each given its position if it reads it.
trade : V, V, Int, Int → ⊤
trade list insts i j =
    lo = if i < j then i else j
    hi = if i < j then j else i
    a = Js.at insts lo
    b = Js.at insts hi
    ea = Js.get a "e"
    eb = Js.get b "e"
    after = Js.get eb "nextSibling"
    -- Two rows side by side trade places by one move, the first's,
    -- so the second keeps its focus — what a keyed reconcile moves.
    if hi == lo + 1 then
        put list ea after
    else
        put list eb ea
        put list ea after
    Js.setAt insts lo b
    Js.setAt insts hi a
    if Js.to (Js.get list "i") then
        renumberAt list b lo
        renumberAt list a hi


--| `(L, xs, i, j, f)`: two element writes of one message at `i` and `j`
--| whose rows may take other keys, checked once, after both (the lean
--| slice's swap): when each keeps its key, each row whose item changed is
--| handed to `f`; when the two exchanged their keys and every key is one
--| row's, the rows trade places — the swap, two `insertBefore`s — and
--| then each whose item changed is handed to `f`; anything else, a key
--| that repeats included, is the reconcile, rank-correct for any list.
--| The lowering calls it only for a key whose edits of the list are
--| exactly those two element writes, so `xs` differs from the rows at
--| `i` and `j` alone: a plan with any other edit of the list does not reach
--| it.
pub exchange : V, V, Int, Int, V → ⊤
exchange list xs i j f =
    insts = Js.get list "r"
    n = count insts

    if i == j || i < 0 || j < 0 || i ≥ n || j ≥ n || count xs ≠ n then
        reconcile list xs
    else
        x = at xs i
        y = at xs j
        kx = itemKey list x
        ky = itemKey list y
        ka = keyOf list (Js.at insts i)
        kb = keyOf list (Js.at insts j)

        if Js.same kx ka && Js.same ky kb then
            visitAt insts i x f
            visitAt insts j y f
        else if
            Js.same kx kb && Js.same ky ka && distinct list && not (Js.isNull (Js.get list "x"))
        then
            trade list insts i j
            visitAt insts i x f
            visitAt insts j y f
        else
            reconcile list xs


-- Row `j` shows item `it`: set and handed to `f` when it changed.
visitAt : V, Int, V, V → ⊤
visitAt insts j it f =
    r = Js.at insts j
    if not (Js.same it (Js.get r "it")) then
        Js.set r "it" it
        _ = Js.apply f [ r ]
        ⊤


-- Row `r` at position `j`: given it and patched whole, if it reads it.
renumberAt : V, V, Int → ⊤
renumberAt list r j =
    if Js.to (Js.get r "i") ≠ j then
        Js.set r "i" (Js.from j)
        _ = Js.apply (Js.get list "w") [ r ]
        ⊤


--| `(L, xs, j)`: row `j`, its item set to the list's `j`th, when it is a
--| row and its item changed (§6.2's guard for `[κ]` and `set κ`); null
--| otherwise.
pub row : V, V, Int → V
row list xs j =
    insts = Js.get list "r"
    if j ≥ 0 && j < count insts && j < count xs then
        r = Js.at insts j
        it = at xs j
        if Js.same it (Js.get r "it") then
            Js.null
        else
            Js.set r "it" it
            r
    else
        Js.null


--| `(L, xs, j)`: `row`, for a keyed list whose key may have changed: a row
--| whose key changed is another row, made in its place (null then), as the
--| reconciler would match it — or the reconcile, when its new key is a
--| row's already or a key repeats (S3's rank, CK-221).
pub rekey : V, V, Int → V
rekey list xs j =
    insts = Js.get list "r"
    if j ≥ 0 && j < count insts && j < count xs then
        r = Js.at insts j
        it = at xs j
        old = Js.get r "it"
        if Js.same it old then
            Js.null
        else if Js.same (itemKey list it) (itemKey list old) then
            Js.set r "it" it
            r
        else if not (distinct list) || hasKey list (itemKey list it) then
            reconcile list xs
            Js.null
        else
            leave list r
            fresh = make list it j
            _ = Js.call (parentOf list) "replaceChild" [ Js.get fresh "e", Js.get r "e" ]
            Js.setAt insts j fresh
            Js.null
    else
        Js.null


--| `(L, xs, f)`: every row, its item set to the list's, handed to `f`: the
--| visit of every row a read not bound to its row needs.
pub each : V, V, V → ⊤
each list xs f =
    items = elements xs
    insts = Js.get list "r"
    eachFrom items insts f 0 (count insts)


eachFrom : V, V, V, Int, Int → ⊤
eachFrom items insts f j n =
    if j < n then
        r = Js.at insts j
        Js.set r "it" (Js.at items j)
        _ = Js.apply f [ r ]
        eachFrom items insts f (j + 1) n


--| `(L, xs, f, rekey)`: the identity walk (§6.2's `kept [*]`): each row
--| whose item is not the very one the list holds, its item set and handed
--| to `f`; a length that changed, or — where `mayRekey` says a key may — a
--| row whose key changed, hands the list to the reconcile.
pub walkItems : V, V, V, V → ⊤
walkItems list xs f mayRekey =
    items = elements xs
    insts = Js.get list "r"
    n = count insts

    if count items ≠ n then
        reconcile list xs
    else
        walkFrom list xs items insts f (Js.to mayRekey) 0 n


walkFrom : V, V, V, V, V, Bool, Int, Int → ⊤
walkFrom list xs items insts f keys j n =
    if j < n then
        r = Js.at insts j
        it = Js.at items j
        if Js.same it (Js.get r "it") then
            walkFrom list xs items insts f keys (j + 1) n
        else if keys && not (Js.same (itemKey list it) (keyOf list r)) then
            reconcile list xs
        else
            Js.set r "it" it
            _ = Js.apply f [ r ]
            walkFrom list xs items insts f keys (j + 1) n


--| `(L, xs)`: the merge (§6.2's `removeSome`): the rows and the new items
--| walked together by identity, each row whose item is not the next new
--| item removed; a new item no row shows, or a key that repeats, hands
--| the list to the reconcile.
pub merge : V, V → ⊤
merge list xs =
    items = elements xs
    insts = Js.get list "r"
    n = count insts
    m = count items

    if m == n then
        ⊤
    else if m == 0 then
        clear list
    else if not (distinct list) || mergeFrom items insts 0 0 n m < m then
        reconcile list xs
    else
        next = Js.array []
        first = mergeInto list items insts next 0 0 n n
        Js.set list "r" next
        renumber list first


-- How many new items, in order, are rows' items from row `i` on.
mergeFrom : V, V, Int, Int, Int, Int → Int
mergeFrom items insts i j n m =
    if i ≥ n || j ≥ m then
        j
    else if Js.same (Js.get (Js.at insts i) "it") (Js.at items j) then
        mergeFrom items insts (i + 1) (j + 1) n m
    else
        mergeFrom items insts (i + 1) j n m


-- The rows kept into `next`, the others removed; the first removed row's
-- position, or `first` when none was.
mergeInto : V, V, V, V, Int, Int, Int, Int → Int
mergeInto list items insts next i j n first =
    if i ≥ n then
        first
    else
        r = Js.at insts i
        if j < count items && Js.same (Js.get r "it") (Js.at items j) then
            _ = Js.call next "push" [ r ]
            mergeInto list items insts next (i + 1) (j + 1) n first
        else
            leave list r
            _ = Js.call (Js.get r "e") "remove" []
            mergeInto list items insts next (i + 1) j n (if first < j then first else j)


--| `(L, probe, f)`: the selector visit (§6.4, as amended for S3): when the
--| probe is not the one last seen, `f` on the rows keyed by the old probe,
--| then on those keyed by the new one — from the map when every key is one
--| row's, by a walk of the rows otherwise. A probe no row has is passed.
pub select : V, V, V → ⊤
select list probe f =
    old = Js.get list "z"

    if not (Js.same old probe) then
        Js.set list "z" probe
        x = Js.get list "x"

        if distinct list && not (Js.isNull x) then
            a = Js.call x "get" [ old ]

            if not (Js.isUndefined a) then
                _ = Js.apply f [ a ]
                ⊤
            b = Js.call x "get" [ probe ]

            if not (Js.isUndefined b) && not (Js.same a b) then
                _ = Js.apply f [ b ]
                ⊤
        else
            Js.each (Js.get list "r") λr →
                if Js.same (keyOf list r) old then Js.to (Js.apply f [ r ])
            Js.each (Js.get list "r") λr →
                if Js.same (keyOf list r) probe then Js.to (Js.apply f [ r ])


--| `(L, xs, f)`: the positional pass (§6.2): each row whose item changed,
--| its item set, handed to `f`; then the rows past the last made, or the
--| rows past the list's length removed.
pub positional : V, V, V → ⊤
positional list xs f =
    items = elements xs
    insts = Js.get list "r"
    n = count insts
    m = count items
    patchFrom items insts f 0 (if m < n then m else n)
    if m > n then
        append list items
    else if m < n then
        if m == 0 then
            clear list
        else
            removeFrom insts m n
            _ = Js.call insts "splice" [ Js.from m ]
            ⊤


patchFrom : V, V, V, Int, Int → ⊤
patchFrom items insts f j n =
    if j < n then
        r = Js.at insts j
        it = Js.at items j
        if not (Js.same it (Js.get r "it")) then
            Js.set r "it" it
            _ = Js.apply f [ r ]
            ⊤
        patchFrom items insts f (j + 1) n


removeFrom : V, Int, Int → ⊤
removeFrom insts j n =
    if j < n then
        _ = Js.call (Js.get (Js.at insts j) "e") "remove" []
        removeFrom insts (j + 1) n


-- ---- The reconciler (§6.3, as amended for S3 and the lean slice) --------
--
-- One pass, rank-correct for any list: the rows at the start whose item or
-- key is where it was are kept in place; the rest are matched to the new
-- items by key and rank (language.md §11.9) in one way for every list — a
-- map from each key to its first row left and a link from each row to the
-- next with its key — with no effect on the page; then the new rows are
-- made and the kept rows whose item changed patched with `w`, in
-- `browser-tea`'s order; then `browser-tea`'s moves (udomdiff over rows),
-- so the same rows move and a focus stays or goes as it does there, the
-- rows no item took removed on the way. Then the key map is made again.

--| `(L, xs)`: the keyed reconcile.
pub reconcile : V, V → ⊤
reconcile list xs =
    items = elements xs
    old = Js.get list "r"
    m = count old
    n = count items

    if m == 0 then
        -- Each row straight into the page, as Solid's `appendNodes` puts
        -- them and `browser-tea` does (S3's measured path).
        next = Js.array []
        fillRows list items next (Js.get list "n") 0 n
        Js.set list "r" next
    else if n == 0 then
        clear list
    else
        p = startRows list items old 0 (if m < n then m else n)

        if p == m && p == n then
            patchRange list items old 0 n
        else
            reconcileRows list items old p m n


fillRows : V, V, V, V, Int, Int → ⊤
fillRows list items next before j n =
    if j < n then
        r = make list (Js.at items j) j
        _ = Js.call next "push" [ r ]
        put list (Js.get r "e") before
        fillRows list items next before (j + 1) n


-- The rows from `j` whose item is the very one, or whose key is the new
-- item's: kept in place, and a rank-correct prefix whatever repeats.
startRows : V, V, V, Int, Int → Int
startRows list items old j end =
    if j < end then
        r = Js.at old j
        it = Js.at items j
        if Js.same (Js.get r "it") it || Js.same (keyOf list r) (itemKey list it) then
            startRows list items old (j + 1) end
        else
            j
    else
        j


reconcileRows : V, V, V, Int, Int, Int → ⊤
reconcileRows list items old p m n =
    next = Js.construct (Js.global "Array") [ Js.from n ]
    copyRows next old 0 p
    -- Each key's first row left, and each row's next with its key; a key
    -- met twice among the old rows makes the pass go in position order.
    firsts = Js.construct (Js.global "Map") []
    links = Js.construct (Js.global "Array") [ Js.from m ]
    repeats = chainRows list old firsts links (m - 1) p False
    once = takeRows list items old next firsts links p n True
    -- The kept rows at the start patched, then — where no key repeats —
    -- every new row made and the kept rows after the start patched, as
    -- `browser-tea`'s trimmed pass; otherwise each row in its position's
    -- order, as its full pass.
    patchRange list items next 0 p

    made =
        if once && not repeats then
            k = makeNew list items next p n 0
            patchRange list items next p n
            k
        else
            rankPass list items next p n 0

    parent = parentOf list

    if made == n && Js.to (Js.get list "o") then
        -- No row kept, and the rows are all the parent holds: a
        -- replacement empties it at once, then the new rows go in.
        Js.set parent "textContent" (Js.from "")
        Js.each next λr → putNode parent (Js.get r "e") Js.null
    else
        after = Js.get (Js.get (Js.at old (m - 1)) "e") "nextSibling"
        moveRows parent old next n after 0 m 0 n Js.null
    Js.set list "r" next
    rekeyAll list


copyRows : V, V, Int, Int → ⊤
copyRows next old j end =
    if j < end then
        Js.setAt next j (Js.at old j)
        copyRows next old (j + 1) end


-- The old rows from `j` down to `p`: each key's first, each row's next with
-- its key (-1: none); whether a key was met twice.
chainRows : V, V, V, V, Int, Int, Bool → Bool
chainRows list old firsts links j p repeats =
    if j < p then
        repeats
    else
        key = keyOf list (Js.at old j)
        v = Js.call firsts "get" [ key ]
        Js.setAt links j (if Js.isUndefined v then Js.from (0 - 1) else v)
        _ = Js.call firsts "set" [ key, Js.from j ]
        chainRows list old firsts links (j - 1) p (repeats || not (Js.isUndefined v))


-- Each new item from `j` takes the first row left with its key — its rank's
-- — and the key's next row becomes its first; a new key is marked met (-1).
-- False when a key was met twice among the new items.
takeRows : V, V, V, V, V, V, Int, Int, Bool → Bool
takeRows list items old next firsts links j n once =
    if j ≥ n then
        once
    else
        key = itemKey list (Js.at items j)
        v = Js.call firsts "get" [ key ]
        index : Int
        index = if Js.isUndefined v then 0 - 1 else Js.to v

        if index < 0 then
            Js.setAt next j Js.undefined
            _ = Js.call firsts "set" [ key, Js.from (0 - 1) ]
            takeRows list items old next firsts links (j + 1) n (once && Js.isUndefined v)
        else
            Js.setAt next j (Js.at old index)
            _ = Js.call firsts "set" [ key, Js.at links index ]
            takeRows list items old next firsts links (j + 1) n once


-- A kept row shows item `it` at position `j`: its item and position set,
-- and it patched whole with `w`, when either changed.
patchRow : V, V, V, Int → ⊤
patchRow list r it j =
    moved = Js.to (Js.get list "i") && Js.to (Js.get r "i") ≠ j
    if not (Js.same (Js.get r "it") it) || moved then
        Js.set r "it" it
        if moved then
            Js.set r "i" (Js.from j)
        _ = Js.apply (Js.get list "w") [ r ]
        ⊤


patchRange : V, V, V, Int, Int → ⊤
patchRange list items rows j end =
    if j < end then
        r = Js.at rows j
        if not (Js.isUndefined r) then
            patchRow list r (Js.at items j) j
        patchRange list items rows (j + 1) end


-- The new rows from `j` made, in order; how many.
makeNew : V, V, V, Int, Int, Int → Int
makeNew list items next j end made =
    if j < end then
        if Js.isUndefined (Js.at next j) then
            Js.setAt next j (make list (Js.at items j) j)
            makeNew list items next (j + 1) end (made + 1)
        else
            makeNew list items next (j + 1) end made
    else
        made


-- Each row from `j` made or patched, in order; how many were made.
rankPass : V, V, V, Int, Int, Int → Int
rankPass list items next j end made =
    if j < end then
        r = Js.at next j
        if Js.isUndefined r then
            Js.setAt next j (make list (Js.at items j) j)
            rankPass list items next (j + 1) end (made + 1)
        else
            patchRow list r (Js.at items j) j
            rankPass list items next (j + 1) end made
    else
        made


-- The rows `a` were become the rows `b`, moving as few as it can:
-- `browser-tea`'s `reconcile` (udomdiff over instances), each row one
-- element. Only `a[aStart, aEnd)` and `b[bStart, bEnd)` differ; the rows
-- after the ranges begin at `after` (the node after the list when there
-- are none); `b`'s rows end at `bLength`. `indices`, each row of `b`'s
-- range by its index, is made the first time a row is looked up.
moveRows : V, V, V, Int, V, Int, Int, Int, Int, V → ⊤
moveRows parent a b bLength after aStart aEnd bStart bEnd indices =
    if not (aStart < aEnd || bStart < bEnd) then
        ⊤
    else if Js.same (Js.at a aStart) (Js.at b bStart) then
        moveRows parent a b bLength after (aStart + 1) aEnd (bStart + 1) bEnd indices
    else
        ( aTo, bTo ) = sameEnds a b aStart aEnd bStart bEnd
        if aTo == aStart then
            node =
                if bTo < bLength then
                    if bStart ≠ 0 then
                        Js.get (rowAt b (bStart - 1)) "nextSibling"
                    else
                        rowAt b bTo
                else
                    after

            putRange parent b bStart bTo node
            moveRows parent a b bLength after aStart aTo bTo bTo indices
        else if bTo == bStart then
            dropRange a indices aStart aTo
            moveRows parent a b bLength after aTo aTo bStart bTo indices
        else if
            Js.same (Js.at a aStart) (Js.at b (bTo - 1))
                && Js.same (Js.at b bStart) (Js.at a (aTo - 1))
        then
            node = Js.get (rowAt a (aTo - 1)) "nextSibling"
            putNode parent (rowAt b bStart) (Js.get (rowAt a aStart) "nextSibling")
            putNode parent (rowAt b (bTo - 1)) node
            Js.setAt a (aTo - 1) (Js.at b (bTo - 1))
            moveRows parent a b bLength after (aStart + 1) (aTo - 1) (bStart + 1) (bTo - 1) indices
        else
            positions =
                if Js.isNull indices then
                    Js.construct (Js.global "Map") []
                else
                    indices

            if Js.isNull indices then
                indexRange positions b bStart bTo

            found = Js.call positions "get" [ Js.at a aStart ]
            if Js.isUndefined found then
                removeRow (Js.at a aStart)
                moveRows parent a b bLength after (aStart + 1) aTo bStart bTo positions
            else
                index : Int
                index = Js.to found
                if bStart < index && index < bTo then
                    sequence = sameRun positions a aTo bTo index (aStart + 1) 1
                    if sequence > index - bStart then
                        putRange parent b bStart index (rowAt a aStart)
                        moveRows parent a b bLength after aStart aTo index bTo positions
                    else
                        old = Js.at a aStart
                        putNode parent (rowAt b bStart) (Js.get old "e")
                        removeRow old
                        moveRows
                            parent
                            a
                            b
                            bLength
                            after
                            (aStart + 1)
                            aTo
                            (bStart + 1)
                            bTo
                            positions
                else
                    moveRows parent a b bLength after (aStart + 1) aTo bStart bTo positions


-- Row `j`'s element.
rowAt : V, Int → V
rowAt rows j = Js.get (Js.at rows j) "e"


putNode : V, V, V → ⊤
putNode parent node before =
    _ = Js.call parent "insertBefore" [ node, before ]
    ⊤


removeRow : V → ⊤
removeRow r =
    _ = Js.call (Js.get r "e") "remove" []
    ⊤


-- The rows the two ranges end with that are the same, taken off.
sameEnds : V, V, Int, Int, Int, Int → Int × Int
sameEnds a b aStart aEnd bStart bEnd =
    if aEnd > aStart && bEnd > bStart && Js.same (Js.at a (aEnd - 1)) (Js.at b (bEnd - 1)) then
        sameEnds a b aStart (aEnd - 1) bStart (bEnd - 1)
    else
        ( aEnd, bEnd )


-- `b[from, to)` put before `node`, in order.
putRange : V, V, Int, Int, V → ⊤
putRange parent b from to node =
    if from < to then
        putNode parent (rowAt b from) node
        putRange parent b (from + 1) to node


-- `a[from, to)` taken out of the page, but for the rows `b` holds.
dropRange : V, V, Int, Int → ⊤
dropRange a indices from to =
    if from < to then
        if Js.isNull indices || not (Js.to (Js.call indices "has" [ Js.at a from ])) then
            removeRow (Js.at a from)
        dropRange a indices (from + 1) to


indexRange : V, V, Int, Int → ⊤
indexRange positions b from to =
    if from < to then
        _ = Js.call positions "set" [ Js.at b from, Js.from from ]
        indexRange positions b (from + 1) to


-- How many rows of `a` from `aStart - 1` stand in `b` in the same order.
sameRun : V, V, Int, Int, Int, Int, Int → Int
sameRun positions a aEnd bEnd index i sequence =
    if
        i < aEnd
            && i < bEnd
            && Js.same (Js.call positions "get" [ Js.at a i ]) (Js.from (index + sequence))
    then
        sameRun positions a aEnd bEnd index (i + 1) (sequence + 1)
    else
        sequence


-- ---- Events in rows (§4.2) ----------------------------------------------
--
-- A handler node of a row holds its listener body as `$<event>`, a function
-- of the event and the row's instance whose `f` says its declaration's
-- `preventDefault` (1) and `stopPropagation` (2); a row's element holds its
-- instance as `$r`, whose `l` is its list's number among the page's `For`s
-- (the lean slice: a number, so the descriptor stays the program's own).

--| `(id, el, name, prop)`: list `id`'s one listener for a bubbling event, on
--| its parent `el`. It walks from the event's target up to a row of this
--| list, collecting the bodies of the nodes it passes, innermost first, and
--| runs them there; what it collected below another list's row (whose own
--| listener has run it) or another program's mount node is dropped. A node
--| whose `disabled` is true is passed over, as `browser`'s walk passes it.
pub delegate : V, V, V, V → ⊤
delegate list el name prop =
    key : String
    key = Js.to prop
    buffer = Js.array []

    Js.to
        (Js.call el "addEventListener"
            [ name
            , Js.from λevent →
                Js.set buffer "length" (Js.from 0)
                walk list key event (Js.get event "currentTarget") (Js.get event "target") buffer
            ]
        )


walk : V, String, V, V, V, V → ⊤
walk list key event top node buffer =
    if Js.isNullish node || Js.same node top then
        ⊤
    else
        if not (Js.isUndefined (Js.get node "$$root")) then
            Js.set buffer "length" (Js.from 0)

        r = Js.get node "$r"

        -- A row of another list: one whose number is not this list's, or a
        -- row of the list of that number in another program mounted below
        -- this list's parent — a list's number is its program's, and two
        -- programs number theirs alike — which a mount node between the row
        -- and this list's parent tells (S4's review, `NestedPrograms`).
        if
            not (Js.isUndefined r)
                && (not (Js.same (Js.get r "l") list) || mountBetween (Js.get node "parentNode") top
                   )
        then
            Js.set buffer "length" (Js.from 0)
            walk list key event top (Js.get node "parentNode") buffer
        else
            h = Js.get node key

            if not (Js.isUndefined h) && not (Js.to (Js.get node "disabled")) then
                _ = Js.call buffer "push" [ h ]
                ⊤

            if Js.isUndefined r then
                walk list key event top (Js.get node "parentNode") buffer
            else
                fire buffer r event 0


-- Whether a program's mount node stands from `node` up to `top`, `top`
-- left out: a row's parent is its list's parent, or an arm's nodes or the
-- mount node between, so the walk is a step or two.
mountBetween : V, V → Bool
mountBetween node top =
    if Js.isNullish node || Js.same node top then
        False
    else if not (Js.isUndefined (Js.get node "$$root")) then
        True
    else
        mountBetween (Js.get node "parentNode") top


-- Run the collected bodies, innermost first: each one's `preventDefault`
-- as it passes, its message sent, and after a `stopPropagation` the event
-- stopped and nothing above run.
fire : V, V, V, Int → ⊤
fire buffer r event i =
    if i < count buffer then
        h = Js.at buffer i
        flags : Int
        flags = Js.to (Js.get h "f")

        if Js.bitAnd flags 1 ≠ 0 then
            Js.to (Js.call event "preventDefault" [])
        send (Js.from λev → Js.to (Js.apply h [ ev, r ])) event
        if Js.bitAnd flags 2 ≠ 0 then
            Js.to (Js.call event "stopPropagation" [])
        else
            fire buffer r event (i + 1)


--| `(el, name, h, r)`: a row node's own listener, for an event that does
--| not bubble (§4.2): body `h` run with the row's instance `r`, its flags
--| applied in the listener.
pub listenRow : V, V, V, V → ⊤
listenRow el name h r =
    flags : Int
    flags = Js.to (Js.get h "f")
    if Js.same name (Js.from "change") then Js.set el "$$changeHandler" (Js.from True)

    Js.to
        (Js.call el "addEventListener"
            [ name
            , Js.from λevent →
                if Js.bitAnd flags 1 ≠ 0 then
                    Js.to (Js.call event "preventDefault" [])
                if Js.bitAnd flags 2 ≠ 0 then
                    Js.to (Js.call event "stopPropagation" [])
                send (Js.from λev → Js.to (Js.apply h [ ev, r ])) event
            ]
        )


--| `(el, name, h)`: a node's own listener outside a list whose declaration
--| neither prevents the default nor stops the event: `h` sent with the
--| event (§4.2). One function for every such node of the page, so a node
--| costs a call (the lean slice's shared listener).
pub on : V, V, V → ⊤
on el name h =
    if Js.same name (Js.from "change") then Js.set el "$$changeHandler" (Js.from True)
    Js.to (Js.call el "addEventListener" [ name, Js.from λevent → send h event ])


-- ---- Branches and `Show` (§5.5; S4's amendment, item 3) -----------------
--
-- A branch's state is `{ k, i, s, p, n, m, y }`: the number of the arm it
-- shows (-1: nothing), that arm's instance, the comment its arms are
-- written after, the parent and the marker they are written before (as a
-- slot's: a null parent is the marker's), each arm's `make`, and a
-- `Show`'s key. An arm's instance holds the clone of its template (`e`),
-- which is put on the page once, and its branch (`b`). A page with no
-- branch ships none of this.

--| `(parent, marker, makes)`: a branch's state, its comment put where its
--| arms go.
pub branch : V, V, V → V
branch parent marker makes =
    start = Js.call (Js.global "document") "createComment" [ Js.from "" ]
    host = if Js.isNull parent then Js.get marker "parentNode" else parent
    _ = Js.call host "insertBefore" [ start, marker ]

    Js.object
        [ ( "k", Js.from (0 - 1) )
        , ( "i", Js.null )
        , ( "s", start )
        , ( "p", parent )
        , ( "n", marker )
        , ( "m", makes )
        , ( "y", unset )
        ]


--| `(b, n, u, a)`: arm `n` shown — the arm shown torn down, its nodes
--| taken out and its instance dropped, and arm `n` made, from the instance
--| `u` the branch is in and `a`, what the branch's value made of the arm's
--| values, and put where the arms go; -1 shows nothing.
pub arm : V, Int, V, V → ⊤
arm b n u a =
    k : Int
    k = Js.to (Js.get b "k")
    if k ≥ 0 then clearAfter (Js.get b "s") (Js.get b "n")
    if n < 0 then
        Js.set b "i" Js.null
    else
        i = Js.apply (Js.at (Js.get b "m") n) [ u, b, a ]
        Js.set i "b" b
        clone = Js.get i "e"

        if not (Js.isNullish clone) then
            Js.to
                (Js.call (Js.get (Js.get b "s") "parentNode") "insertBefore" [ clone, Js.get b "n" ]
                )
        Js.set b "i" i
    Js.set b "k" (Js.from n)


-- Every node after `start` up to `end` (the parent's last, for null) taken
-- out of the page.
clearAfter : V, V → ⊤
clearAfter start end =
    next = Js.get start "nextSibling"

    if Js.isNull next || Js.same next end then
        ⊤
    else
        _ = Js.call next "remove" []
        clearAfter start end


--| `(t, flags)`: an arm's template — the template element `t`'s parsed
--| content, copied out of it (the next parse replaces it), and out of the
--| `<svg>` an SVG root other than `<svg>` is parsed in (`dom`'s flag 2).
pub armTemplate : V, Int → V
armTemplate t flags =
    f = Js.call (Js.get t "content") "cloneNode" [ Js.from True ]

    if Js.bitAnd flags 2 ≠ 0 then
        w = Js.get f "firstChild"
        unwrap f w
        Js.to (Js.call w "remove" [])
    f


unwrap : V, V → ⊤
unwrap f w =
    c = Js.get w "firstChild"

    if Js.isNull c then
        ⊤
    else
        _ = Js.call f "insertBefore" [ c, w ]
        unwrap f w


--| `(a, b)`: whether a keyed `Show`'s key is the one it shows: by
--| SameValueZero, as a rekey compares keys (`NaN` is itself).
pub sameKey : V, V → Bool
sameKey a b =
    Js.same a b
        || (Js.typeIs a "number"
               && Js.typeIs b "number"
               && not (Js.same a a)
               && not (Js.same b b)
           )


-- ---- The value path (S4's amendment, item 1) ----------------------------
--
-- Markup this platform does not write in place is `dom`'s kinds and blocks
-- (`backend.md` §15.3–§15.5), unchanged: the functions of `browser`'s `Rt`
-- that touch only the DOM run them, taken as they are — they keep no
-- page-wide state. What enters program code or keeps state for the page is
-- this module's: a kind's events (`listen`), its controls (`control`,
-- `edited`).

--| `(html)`: a kind's template cloner (`Rt.template`).
pub template : String → (⊤ → V)
template html = Rt.template html


--| `(html, flags)`: a kind's template cloner with a flag (`Rt.templateOf`).
pub templateOf : String, Int → (⊤ → V)
templateOf html flags = Rt.templateOf html flags


--| `(parent, marker, cx)`: a slot (`Rt.slot`) — a value slot of this
--| platform's own markup, made at mount with no context, or a kind's.
pub slot : V, V, V → V
slot parent marker cx = Rt.slot parent marker cx


--| `(slot, block)`: an `Html` hole (`Rt.childHtml`).
pub childHtml : V, V → ⊤
childHtml s b =
    instance = Js.get s "i"
    if not (Js.isNull instance) && Js.same b (Js.get instance "b") then
        _ = Js.call (Js.get instance "t") "p" [ instance, Js.get b "v" ]
        if Js.to (Js.get (Js.get instance "t") "l") then Js.set s "l" (Js.get instance "l")
    else
        Rt.childHtml s b


--| `(slot, block or null)`: a `Maybe Html` hole (`Rt.childMaybe`).
pub childMaybe : V, V → ⊤
childMaybe s b = if Js.isNull b then Rt.childMaybe s b else childHtml s b


--| `(slot, list)`: a `List Html` hole (`Rt.childList`).
pub childList : V, V → ⊤
childList s list =
    previous = Js.get s "u"
    if not (Js.isNull previous) then
        incoming = Rt.elements list
        templateListSame previous incoming 0
    Rt.childList s list


-- Rt.childList skips identical pure blocks; enter those here exactly once.
templateListSame : V, V, Int → ⊤
templateListSame previous incoming position =
    if
        position < Js.to (Js.get previous "length") && position < Js.to (Js.get incoming "length")
    then
        instance = Js.at previous position
        block = Js.at incoming position
        if
            Js.same block (Js.get instance "b")
                && not (Js.to (Js.get (Js.get instance "t") "l") && Js.to (Js.get instance "l"))
        then
            _ = Js.call (Js.get instance "t") "p" [ instance, Js.get block "v" ]
            ⊤
        templateListSame previous incoming (position + 1)


--| `(slot, items, keyOf, row, inputs)`: a kind's keyed `For` (`Rt.forKeyed`).
pub forKeyed : V, V, V, V, V → ⊤
forKeyed s items key r inputs = Rt.forKeyed s items key r inputs


--| `(slot, items, row, inputs)`: a kind's positional `For`.
pub forPosition : V, V, V, V → ⊤
forPosition s items r inputs = Rt.forPosition s items r inputs


--| `(slot, key, block)`: a kind's keyed `Show` showing its body.
pub show : V, V, V → ⊤
show s key b = Rt.show s key b


--| `(slot, fallback or null)`: a kind's `Show` on `Nothing`.
pub hide : V, V → ⊤
hide s f = Rt.hide s f


--| `(slot)`: what a skipped slot of a kind shows, patched again where it
--| must be (`Rt.restate`).
pub restate : V → ⊤
restate s = Rt.restate s


-- Value slots retain blocks; structural For slots retain row items instead
-- and continue to use their row/edit traversal protocol through `restate`.
pub restateValue : V → ⊤
restateValue s =
    if Js.read templateFallback then
        if not (Js.isNull (Js.get s "i")) then
            instance = Js.get s "i"
            childHtml s (Js.get instance "b")
        else if not (Js.isNull (Js.get s "u")) then
            childList s (Js.get s "b")
    else
        Rt.restate s


--| `Html.text`: the text, as a text hole shows it.
pub text : V → V
text s = Rt.text s


--| `Html.map`: the same markup, its messages passed through `f`.
pub map : V, V → V
map html f = Js.from { t = templateMapKind, v = Js.array [ html, f ] }


templateMapBase : V
templateMapBase = Js.get (Rt.map Js.null Js.null) "t"


templateMapKind : V
templateMapKind = Js.from { l = True, m = templateMapMount, p = templateMapPatch }


templateMapMount : V, V → V
templateMapMount values cx =
    context = Js.get values "$$directContext"
    ownsRow =
        not (Js.isUndefined context)
            && not (Js.isNull context)
            && Js.same (Js.at context 6) (Js.from True)
    before = Js.read templateRowOwner
    rowScope = if ownsRow then Js.object [] else before
    Js.write templateRowOwner rowScope
    Js.finally
        (λ⊤ →
            made = Js.call templateMapBase "m" [ values, cx ]
            if ownsRow then Js.set made "$$rowScope" rowScope
            made
        )
        λ⊤ → Js.write templateRowOwner before


templateMapPatch : V, V → ⊤
templateMapPatch instance values =
    before = Js.read templateRowOwner
    rowScope = Js.get instance "$$rowScope"
    Js.finally
        (λ⊤ →
            if not (Js.isUndefined rowScope) then
                Js.write templateRowOwner rowScope
                if Js.development ⊤ then visitRowMode rowScope (Js.read templateEffects)
            held = Js.get instance "q"
            inner = Js.get held "i"
            block = Js.at values 0
            repeat =
                Js.same block (Js.get inner "b")
                    && not (Js.to (Js.get (Js.get inner "t") "l") && Js.to (Js.get inner "l"))
            _ = Js.call templateMapBase "p" [ instance, values ]
            if repeat then
                _ = Js.call (Js.get inner "t") "p" [ inner, Js.get block "v" ]
                Js.set held "l" (Js.get inner "l")
                Js.set instance "l" (Js.get inner "l")
        )
        λ⊤ → Js.write templateRowOwner before


--| `(el, name, flags)`: a kind's handler node listening on itself, for
--| every event (§4.2, as amended for S4): the DOM's bubbling orders it
--| against this platform's own listeners as Elm orders handlers, and no
--| document listener exists. The declaration's `preventDefault` (1) and
--| `stopPropagation` (2) run in the listener, synchronously; the body —
--| the message the node holds, or makes of the event's payload, passed
--| through each `Html.map` it is inside, innermost first — runs inside
--| `send`, and goes to the dispatcher of the program whose mount node is
--| nearest above the node.
pub listen : V, String, Int → ⊤
listen el name flags =
    key = "$$${name}"
    payload = "${key}X"

    Js.to
        (Js.call el "addEventListener"
            [ Js.from name
            , Js.from λevent →
                -- A stopped page runs nothing of a handler, its flags
                -- included, as `browser`'s `Rt.fire` does.
                if Js.read dead || Js.isUndefined (Js.get el key) then
                    ⊤
                else
                    if Js.bitAnd flags 1 ≠ 0 then
                        Js.to (Js.call event "preventDefault" [])
                    if Js.bitAnd flags 2 ≠ 0 then
                        Js.to (Js.call event "stopPropagation" [])
                    -- What the node holds is read now, as the event fires:
                    -- its program's mount, its handler, its payload's
                    -- extractor and its maps. A body queued behind a running
                    -- dispatch (a blur a handler's removal fires) runs after
                    -- the dispatch may have patched the node or taken it off
                    -- the page, and is delivered where the browser fired it
                    -- (the 2026-10-10 amendment); only the message is
                    -- queued, made inside the guard.
                    root = mountAbove (Js.get el "parentNode")
                    h = Js.get el key
                    x = Js.get el payload
                    cx = Js.get el "$$cx"

                    if Js.isNull root then
                        ⊤
                    else
                        send (Js.from λev → deliver root h x cx ev) event
            ]
        )


-- The message handler `h` is, or makes of the event's payload by `x`, through
-- every `Html.map` context from `cx` out, sent to the dispatcher of the mount
-- node `root` (`$$root`).
deliver : V, V, V, V, V → ⊤
deliver root h x cx event =
    msg =
        through
            cx
            (if Js.isUndefined x then
                h
             else
                Js.apply h [ Js.apply x [ event ] ]
            )

    Js.to (Js.call root "$$root" [ msg ])


-- `msg` through each context from `c` out. (`isNullish`: a node outside
-- every `Html.map` has no `$$cx`, and the outermost context's `up` is null.)
through : V, V → V
through c msg =
    if Js.isNullish c then
        msg
    else
        through (Js.get c "up") (Js.call c "f" [ msg ])


-- The nearest mount node from `n` up, or null.
mountAbove : V → V
mountAbove n =
    if Js.isNull n || not (Js.isUndefined (Js.get n "$$root")) then
        n
    else
        mountAbove (Js.get n "parentNode")


-- ---- Controlled inputs (§8.1; S4's amendment, item 2) -------------------
--
-- A controlled element keeps the model's value of each `stateful` property
-- it has as `$$s[prop]`. What may have changed one without the model — an
-- edit, or a write of the runtime's — is marked, page-wide, and put back
-- at the end of the dispatch: the first mark of a dispatch queues the
-- reconcile behind what the dispatch has queued (§4.3), so it runs as the
-- queue drains and before the verify mode, and a mark a later message
-- makes queues it again. A page with no `stateful` attribute calls none of
-- this, and ships none of it.

-- The controls marked since the last reconcile.
marked : V
marked = Js.construct (Js.global "Set") []


-- A reconcile is queued and has not run.
pending : Js.Ref Bool
pending = Js.ref False


--| `(el, prop, v)`: a `stateful` attribute's value, kept on the element and
--| written when the page's is not it, so an edit the model took is not
--| written back. The first call listens for what changes a control
--| without the model.
pub control : V, String, V → ⊤
control el prop v =
    if Js.isUndefined (Js.get el "$$s") then
        Js.set el "$$s" (Js.object [])
        if Js.read watching then ⊤ else watchEdits ⊤
    Js.set (Js.get el "$$s") prop v
    if Js.same (Js.get el prop) v then ⊤ else Js.set el prop v


--| `(el)`: a controlled element a write of the runtime's may have changed —
--| another of its attributes, or something inside it.
pub edited : V → ⊤
edited el = mark el


-- `el` marked, and the reconcile queued if it is not.
mark : V → ⊤
mark el =
    _ = Js.call marked "add" [ el ]

    if Js.read pending then
        ⊤
    else
        Js.write pending True
        if Js.isNull (Js.read queue) then
            Js.write queue (Js.array [])
        _ = Js.call (Js.read queue) "push" [ Js.from reconcileMarks, Js.null ]
        ⊤


-- Every marked control put back to the model, and the marks cleared.
reconcileMarks : V → ⊤
reconcileMarks _ =
    Js.write pending False
    Js.each marked λel → putBack el
    Js.to (Js.call marked "clear" [])


-- Each property a control keeps written back where the page's differs.
putBack : V → ⊤
putBack el =
    s = Js.get el "$$s"
    if Js.isUndefined s then
        ⊤
    else
        Js.each (Js.call (Js.global "Object") "keys" [ s ]) λk →
            key : String
            key = Js.to k
            v = Js.get s key
            if
                key == "checked"
                    && Js.same (Js.get el "$$awaitingChange") (Js.from True)
            then
                ⊤
            else if Js.same (Js.get el key) v then
                ⊤
            else
                Js.set el key v


-- `el` and what changes with it with no event of its own, each handed to
-- `f`: every radio named as it is — a superset of its group — and every
-- option of a select.
affected : V, (V → ⊤) → ⊤
affected el f =
    f el
    tag : String
    tag = Js.to (Js.get el "localName")
    if tag == "select" then
        Js.each (Js.get el "options") f
    else if
        tag == "input" && Js.to (Js.get el "type") == "radio" && Js.to (Js.get el "name") ≠ ""
    then
        Js.each (Js.call (Js.global "document") "getElementsByName" [ Js.get el "name" ]) f


-- A control the user may have changed: marked, when it is one.
markEdit : V → ⊤
markEdit el = if Js.isUndefined (Js.get el "$$s") then ⊤ else mark el


-- Controls changed after the dispatch of the event that marked them — a
-- `reset` resets them then, a click whose default was prevented puts a box
-- back then — put back in a task after it, unless the page has stopped.
heldBack : V
heldBack = Js.array []


holdEdit : V → ⊤
holdEdit el =
    if Js.to (Js.get heldBack "length") == 0 then
        Js.to (Js.apply (Js.global "setTimeout") [ Js.from λ⊤ → putBackHeld ⊤, Js.from 0 ])
    Js.to (Js.call heldBack "push" [ el ])


putBackHeld : ⊤ → ⊤
putBackHeld ⊤ =
    held = Js.call heldBack "splice" [ Js.from 0 ]
    if Js.read dead then
        ⊤
    else
        Js.each held λel →
            Js.set el "$$awaitingChange" (Js.from False)
            putBack el


watching : Js.Ref Bool
watching = Js.ref False


-- The listeners: in the capture phase, so a control is marked before any
-- handler's message runs, whether or not it has a handler; and in the
-- bubble phase on the document, after every element's listener, a send
-- that does nothing, so the reconcile runs after every edit, handled or
-- not (§8.1's no-op send).
watchEdits : ⊤ → ⊤
watchEdits ⊤ =
    Js.write watching True
    document = Js.global "document"
    Js.each (Js.array [ Js.from "input", Js.from "change", Js.from "click", Js.from "reset" ]) λname →
        _ = Js.call document "addEventListener" [ name, Js.from edits, Js.from True ]
        Js.to
            (Js.call document "addEventListener"
                [ name, Js.from λevent → send (Js.from noop) event ]
            )
    Js.to
        (Js.call (Js.global "window") "addEventListener"
            [ Js.from "pageshow", Js.from λ_ → pageShown ⊤ ]
        )


-- The body of the no-op send.
noop : V → ⊤
noop _ = ⊤


-- What an event says may have changed without the model: its control,
-- for `input` and `change`; a checkbox or radio, for `click`, which
-- changed before the click was dispatched and may be put back after it;
-- every control of the form, for `reset`, which resets them after it.
-- (The target may be any element, the document or the window: each branch
-- reads only what is `undefined` where it is missing, and only a form has
-- its `elements` iterated.)
edits : V → ⊤
edits event =
    -- Controls held for the task are marked again by every later edit:
    -- the dispatch it ends in puts them back before the task does, as a
    -- render does on `browser-tea` (S4's review: in Chrome the reset's own
    -- reconcile ran before the reset, and took their marks).
    Js.each heldBack markEdit
    target = Js.get event "target"
    type_ : String
    type_ = Js.to (Js.get event "type")
    kind : String
    kind = Js.to (Js.get target "type")
    if type_ == "reset" then
        if Js.to (Js.get target "localName") == "form" then
            Js.each (Js.get target "elements") λel → affected el markAndHold
    else if type_ ≠ "click" then
        if type_ == "change" then
            affected target λel → Js.set el "$$awaitingChange" (Js.from False)
        affected target markEdit
    else if kind == "checkbox" || kind == "radio" then
        if
            not (Js.isUndefined (Js.get target "$$changeHandler"))
                || not (Js.isUndefined (Js.get target "$change"))
                || not (Js.isUndefined (Js.get target "$$change"))
        then
            affected target λel →
                Js.set el "$$awaitingChange" (Js.from True)
                holdEdit el
        else
            affected target markAndHold


markAndHold : V → ⊤
markAndHold el =
    markEdit el
    holdEdit el


-- The page is shown, after the browser restored what its form controls
-- held on a reload or a history step: every control put back.
pageShown : ⊤ → ⊤
pageShown ⊤ =
    if Js.read dead then
        ⊤
    else
        Js.each
            (Js.call (Js.global "document") "querySelectorAll"
                [ Js.from "input,select,textarea,option" ]
            )
            λel → putBack el


-- ---- The development verify mode (§8.3) ---------------------------------

-- Each mounted program's check, in mount order.
verifiers : V
verifiers = Js.array []


--| `(check)`: a development build's mount registers its program's check,
--| which `send` runs at the end of every dispatch. A release build never
--| calls it.
pub verify : V → ⊤
verify check =
    _ = Js.call verifiers "push" [ check ]
    ⊤


--| `(a, b)`: whether a value computed again is the one a slot holds — by
--| structure, never by identity (§8.3, as amended): a scalar by `===`, `NaN`
--| equal to itself; a list by its length and every element; a record, a
--| tuple or a constructor field by field; a function not at all, since a
--| closure made again is a new object and two are equal only by identity.
pub same : V, V → Bool
same a b =
    if
        Js.same a b
            || (Js.typeIs a "number"
                   && Js.typeIs b "number"
                   && not (Js.same a a)
                   && not (Js.same b b)
               )
    then
        True
    else if Js.typeIs a "function" && Js.typeIs b "function" then
        True
    else if
        not (Js.typeIs a "object") || not (Js.typeIs b "object") || Js.isNull a || Js.isNull b
    then
        False
    else if isList a || isList b then
        isList a && isList b && sameElements (elements a) (elements b)
    else if isBlock a || isBlock b then
        -- A markup value, `dom`'s block `{ t, v }`, by its kind: its values
        -- are its root's inputs, whole locals, which a derived value that
        -- reads only some of their paths keeps from when it was computed,
        -- rightly (S4's amendment, items 1 and 4, as built). What it shows
        -- is the page's, which the check reads where it is shown.
        isBlock a && isBlock b && Js.same (Js.get a "t") (Js.get b "t")
    else
        keys = Js.call (Js.global "Object") "keys" [ a ]
        n : Int
        n = Js.to (Js.get keys "length")
        other : Int
        other = Js.to (Js.get (Js.call (Js.global "Object") "keys" [ b ]) "length")
        n == other && sameFields keys a b 0 n


-- A markup value: `dom`'s block, whose kind `t` has its `m` and its `p`.
isBlock : V → Bool
isBlock v =
    t = Js.get v "t"
    Js.typeIs t "object"
        && not (Js.isNull t)
        && Js.typeIs (Js.get t "m") "function"
        && Js.typeIs (Js.get t "p") "function"


-- A list by `backend.md` §4's protocol: an array, or a view or a trie.
isList : V → Bool
isList v =
    Js.to (Js.call (Js.global "Array") "isArray" [ v ]) || Js.typeIs (Js.get v "$plain") "function"


sameElements : V, V → Bool
sameElements xs ys =
    n : Int
    n = Js.to (Js.get xs "length")
    m : Int
    m = Js.to (Js.get ys "length")

    n == m && sameRange xs ys 0 n


-- Elements `i` to `end - 1`, one after another: a loop, however long the
-- list (a tail call, `backend.md` §8).
sameRange : V, V, Int, Int → Bool
sameRange xs ys i end =
    if i ≥ end then
        True
    else if not (same (Js.at xs i) (Js.at ys i)) then
        False
    else
        sameRange xs ys (i + 1) end


sameFields : V, V, V, Int, Int → Bool
sameFields keys a b i n =
    if i ≥ n then
        True
    else
        k : String
        k = Js.to (Js.at keys i)

        if
            not (Js.to (Js.call (Js.global "Object") "hasOwn" [ b, Js.from k ]))
                || not
                    (same
                        (Js.call (Js.global "Reflect") "get" [ a, Js.from k ])
                        (Js.call (Js.global "Reflect") "get" [ b, Js.from k ])
                    )
        then
            False
        else
            sameFields keys a b (i + 1) n


--| `(what, shown, model)`: the verify mode found the page showing what the
--| model does not hold — a missed write, a defect of the compiler. Thrown,
--| so the page stops as for any defect (§8.2).
pub wrong : V, V, V → ⊤
wrong what shown model =
    describe =
        λv →
            if Js.same v unset then
                Js.from "nothing (never written)"
            else
                Js.apply (Js.global "String") [ v ]

    shownText : String
    shownText = Js.to (describe shown)
    modelText : String
    modelText = Js.to (describe model)
    whatText : String
    whatText = Js.to what
    Js.throw
        (Js.construct (Js.global "Error")
            [ Js.from
                "browser-direct verify: ${whatText} shows ${shownText}, but the model gives ${modelText}. The compiler missed a write: this is a defect of beni, not of the program; please report it."
            ]
        )


--| `(L, xs, check, what, structural)`: the verify mode's check of a list
--| (§8.3, as amended for S2): as many rows as items; each row showing its
--| item — the very object for a list that is a model path, an equal one
--| (`same`) for a derived list, whose items are made again; the rows one
--| after another in the page, in order, ending at the list's end marker;
--| and each row's own check.
pub verifyList : V, V, V, V, V → ⊤
verifyList list xs check what structural =
    items = elements xs
    insts = Js.get list "r"
    n = count insts
    m = count items
    whatText : String
    whatText = Js.to what

    if n ≠ m then
        wrong (Js.from "${whatText}'s number of rows") (Js.from n) (Js.from m)
    else
        verifyRows list items insts check whatText (Js.to structural) 0 n
        -- Every row this list made that the page still holds is one of its
        -- rows (a development build marks each, `$v`): a row left behind,
        -- before the first, after the last or in a list with none, is a
        -- missed removal.
        held = heldRows list (Js.get (parentOf list) "firstChild") 0

        if held ≠ n then
            wrong
                (Js.from "the count of rows of ${whatText} in the page")
                (Js.from held)
                (Js.from n)
        -- The key map, while it says every key is one row's (S3): one entry
        -- per row, each the row with that key.
        x = Js.get list "x"

        if not (Js.isNull x) && distinct list then
            size : Int
            size = Js.to (Js.get x "size")

            if size ≠ n then
                wrong (Js.from "the key map of ${whatText}'s size") (Js.from size) (Js.from n)
            Js.each insts λr →
                if not (Js.same (Js.call x "get" [ keyOf list r ]) r) then
                    wrong
                        (Js.from "the key map of ${whatText} at a row's key")
                        (Js.call x "get" [ keyOf list r ])
                        (Js.get r "it")


--| `(slot, value, kind, what)`: the verify mode's check of a value slot (S4's
--| amendment, item 1, as built): the value computed again, a block — or,
--| for kind 1, a `Maybe Html`'s block or null, for kind 2 a `List Html` — and
--| the instance the slot shows: the same kind, by identity, and the same
--| page — a fresh instance of the value, mounted off the page, reads as
--| the slot's nodes do. An instance that is live (`l`: it holds a value
--| made on every render) is checked by its kind only.
pub verifySlot : V, V, Int, V → ⊤
verifySlot s b kind what =
    if kind == 2 then
        items = Rt.elements b
        shown = if Js.isNull (Js.get s "u") then Js.array [] else Js.get s "u"
        n = count items
        whatText : String
        whatText = Js.to what

        if count shown ≠ n then
            wrong (Js.from "the number of blocks ${whatText}") (Js.from (count shown)) (Js.from n)
        else
            verifyEach s shown items what 0 n
    else if kind == 1 && Js.isNull b then
        if Js.isNull (Js.get s "i") then ⊤ else wrong what (Js.get s "i") Js.null
    else
        verifyShown s (Js.get s "i") b what


verifyEach : V, V, V, V, Int, Int → ⊤
verifyEach s shown items what j n =
    if j < n then
        verifyShown s (Js.at shown j) (Js.at items j) what
        verifyEach s shown items what (j + 1) n


verifyShown : V, V, V, V → ⊤
verifyShown s i b what =
    whatText : String
    whatText = Js.to what

    if Js.isNull i then
        wrong what Js.null b
    else if not (Js.same (Js.get b "t") (Js.get i "t")) then
        wrong (Js.from "the kind of markup ${whatText}") (Js.get i "t") (Js.get b "t")
    else if Js.to (Js.get i "l") then
        ⊤
    else
        fresh = Rt.unit b (Js.get s "cx")

        if not (samePage (Rt.first i) (Rt.last i) (Rt.first fresh) (Rt.last fresh)) then
            page = written (Rt.first i) (Rt.last i) ""
            model = written (Rt.first fresh) (Rt.last fresh) ""
            wrong what (Js.from page) (Js.from model)


-- Whether the nodes from `a` to `aEnd` show what those from `b` to `bEnd`
-- do — the page's against a fresh mount's (S4's review): node by node, each
-- element by `sameElement`.
samePage : V, V, V, V → Bool
samePage a aEnd b bEnd =
    if not (sameNode a b) then
        False
    else if Js.same a aEnd || Js.same b bEnd then
        Js.same a aEnd && Js.same b bEnd
    else
        samePage (Js.get a "nextSibling") aEnd (Js.get b "nextSibling") bEnd


-- A text's or a comment's data; an element by `sameElement`.
sameNode : V, V → Bool
sameNode a b =
    if Js.isNull a || Js.isNull b then
        Js.isNull a && Js.isNull b
    else
        kind : Int
        kind = Js.to (Js.get a "nodeType")

        if kind ≠ Js.to (Js.get b "nodeType") then
            False
        else if kind == 1 then
            sameElement a b
        else
            Js.same (Js.get a "data") (Js.get b "data")


-- An element of the page against the fresh mount's `b`: the same name and
-- namespace; every attribute `b` has, the page's equal — a class list and
-- a style's declarations as sets, since a patch appends a class switched
-- on and a property set again, and adds an attribute that turns on after
-- the others; and the same children. Not compared: an attribute only the
-- page has — the host's or an extension's, or one a missed removal left,
-- which is a limit of the check (its opposite, an attribute missed, is
-- caught); `open` on `details` and `dialog`, which the user changes and the
-- program keeps nowhere but its model (§8.1); and the children of an
-- element the user edits (`contenteditable`).
sameElement : V, V → Bool
sameElement a b =
    if
        not (Js.same (Js.get a "localName") (Js.get b "localName"))
            || not (Js.same (Js.get a "namespaceURI") (Js.get b "namespaceURI"))
    then
        False
    else
        name : String
        name = Js.to (Js.get b "localName")
        attrs = Js.get b "attributes"

        if
            not (sameAttributes a b attrs (name == "details" || name == "dialog") 0 (count attrs))
        then
            False
        else if editable b then
            True
        else
            sameChildren (Js.get a "firstChild") (Js.get b "firstChild")


sameChildren : V, V → Bool
sameChildren a b =
    if Js.isNull a || Js.isNull b then
        Js.isNull a && Js.isNull b
    else if not (sameNode a b) then
        False
    else
        sameChildren (Js.get a "nextSibling") (Js.get b "nextSibling")


-- An element whose content the user edits.
editable : V → Bool
editable el =
    v = Js.call el "getAttribute" [ Js.from "contenteditable" ]
    not (Js.isNull v) && not (Js.same v (Js.from "false"))


sameAttributes : V, V, V, Bool, Int, Int → Bool
sameAttributes a b attrs openable i n =
    if i ≥ n then
        True
    else
        one = Js.at attrs i
        key : String
        key = Js.to (Js.get one "name")
        mine = Js.call a "getAttribute" [ Js.from key ]
        theirs = Js.get one "value"

        agrees =
            if openable && key == "open" then
                True
            else if Js.isNull mine then
                False
            else if key == "class" then
                sameTokens mine theirs
            else if key == "style" then
                sameStyle (Js.get a "style") (Js.get b "style")
            else
                Js.same mine theirs

        agrees && sameAttributes a b attrs openable (i + 1) n


-- Two class lists as sets of names.
sameTokens : V, V → Bool
sameTokens x y =
    xs = tokens x
    ys = tokens y
    n : Int
    n = Js.to (Js.get xs "size")
    m : Int
    m = Js.to (Js.get ys "size")
    n == m
        && Js.to
            (Js.call (Js.call (Js.global "Array") "from" [ xs ]) "every"
                [ Js.from λt → Js.call ys "has" [ t ] ]
            )


tokens : V → V
tokens s =
    names = Js.construct (Js.global "Set") []

    Js.each (Js.call s "split" [ spaces ]) λname →
        if Js.same name (Js.from "") then
            ⊤
        else
            Js.to (Js.call names "add" [ name ])
    names


-- Two styles' declarations as sets: each property's value and priority.
sameStyle : V, V → Bool
sameStyle x y =
    n : Int
    n = Js.to (Js.get x "length")
    m : Int
    m = Js.to (Js.get y "length")
    n == m && sameDeclarations x y 0 n


sameDeclarations : V, V, Int, Int → Bool
sameDeclarations x y i n =
    if i ≥ n then
        True
    else
        prop = Js.at y i

        Js.same (Js.call x "getPropertyValue" [ prop ]) (Js.call y "getPropertyValue" [ prop ])
            && Js.same
                (Js.call x "getPropertyPriority" [ prop ])
                (Js.call y "getPropertyPriority" [ prop ])
            && sameDeclarations x y (i + 1) n


-- The nodes from `node` to `end`, as text: an element's markup, a text
-- node's or a comment's data.
written : V, V, String → String
written node end acc =
    one : String
    one =
        if Js.to (Js.get node "nodeType") == 1 then
            Js.to (Js.get node "outerHTML")
        else
            name : String
            name = Js.to (Js.get node "nodeName")
            data : String
            data = Js.to (Js.get node "data")
            "${name}(${data})"

    if Js.same node end then
        acc ++ one
    else
        written (Js.get node "nextSibling") end (acc ++ one)


-- How many of the nodes from `node` on are rows `list` made.
heldRows : V, V, Int → Int
heldRows list node k =
    if Js.isNull node then
        k
    else
        heldRows
            list
            (Js.get node "nextSibling")
            (if Js.same (Js.get node "$v") list then k + 1 else k)


verifyRows : V, V, V, V, String, Bool, Int, Int → ⊤
verifyRows list items insts check what structural j n =
    if j < n then
        r = Js.at insts j
        it = Js.at items j

        if not (if structural then same it (Js.get r "it") else Js.same it (Js.get r "it")) then
            wrong (Js.from "row ${String.fromInt j} of ${what}") (Js.get r "it") it
        -- The rows in order in the page: each after the one before it,
        -- the last before the end marker.
        el = Js.get r "e"

        if not (Js.same (Js.get el "parentNode") (parentOf list)) then
            wrong
                (Js.from "the parent of row ${String.fromInt j} of ${what}")
                (Js.get el "parentNode")
                (parentOf list)
        if j > 0 && not (Js.same (Js.get (Js.get (Js.at insts (j - 1)) "e") "nextSibling") el) then
            wrong
                (Js.from "the place of row ${String.fromInt j} of ${what}")
                (Js.get el "previousSibling")
                (Js.get (Js.at insts (j - 1)) "e")
        if
            j == n - 1
                && not (Js.isNull (Js.get list "n"))
                && not (Js.same (Js.get el "nextSibling") (Js.get list "n"))
        then
            wrong (Js.from "the end of ${what}") (Js.get el "nextSibling") (Js.get list "n")
        _ = Js.apply check [ r ]
        verifyRows list items insts check what structural (j + 1) n


-- ---- `--fuzz` (§8.3, the contract's item 3) -----------------------------

-- Each mounted program's dispatcher, in mount order.
fuzzed : V
fuzzed = Js.array []


--| `(dispatch)`: a `--fuzz` build's mount registers its dispatcher, first
--| thing, so the programs are numbered in mount order; the first also sets
--| `globalThis.__beniFuzz`, whose `send(program, msg)` dispatches a message
--| value to the program'th mount, through the guard, its writes done when
--| it returns. An index with no program throws. A build without `--fuzz`
--| never calls it.
pub fuzzMount : V → ⊤
fuzzMount dispatch =
    _ = Js.call fuzzed "push" [ dispatch ]
    if Js.isUndefined (Js.get (Js.global "globalThis") "__beniFuzz") then
        Js.set
            (Js.global "globalThis")
            "__beniFuzz"
            (Js.object
                [ ( "send"
                  , Js.from λprogram msg →
                      n : Int
                      n = Js.to (Js.get fuzzed "length")
                      i : Int
                      i = Js.to program
                      if not (Js.typeIs program "number") || i < 0 || i ≥ n then
                          Js.throw
                              (Js.construct (Js.global "Error")
                                  [ Js.from "__beniFuzz.send: no program has this index" ]
                              )
                      else
                          send (Js.at fuzzed i) msg
                  )
                ]
            )


-- ---- The compiled host and after-render point --------------------------

phase : Js.Ref V
phase = Js.ref Js.null


later : Js.Ref V
later = Js.ref (Js.array [])


waiters : Js.Ref V
waiters = Js.ref (Js.array [])


inAfter : Js.Ref Bool
inAfter = Js.ref False


pub makeHost : V → V
makeHost dispatch =
    Js.write phase (Js.from afterPoint)
    Browser.installRendered (Js.from onRendered)
    Task.onDefect λ⊤ → stop ⊤
    self =
        Js.object
            [ ( "send", Js.from λmsg → send dispatch msg )
            , ( "after"
              , Js.from λwork →
                  _ = Js.call (Js.read later) "push" [ work ]
                  send (Js.from λ_ → ⊤) Js.null
              )
            ]
    Js.set self "state" (Js.from (Tea.open (Js.to self)))
    self


pub commands : V, Cmd.Cmd msg → ⊤
commands self cmd =
    Js.set self "state" (Js.from (Tea.commands (Js.to self) cmd (Js.to (Js.get self "state"))))


pub subscriptions : V, Sub.Sub msg → ⊤
subscriptions self sub =
    Js.set self "state" (Js.from (Tea.subscriptions (Js.to self) sub (Js.to (Js.get self "state"))))


pub address : ⊤ → Url.Url
address ⊤ =
    case Navigation.currentUrl ⊤ of
        Just url →
            url
        Nothing →
            Hosted.defect
                "Tea.application needs an http or https address, and this page has none: it was opened from a file. Serve it over HTTP, or use Tea.document and Browser.Navigation.currentUrl, whose Nothing such a page can handle."


pub navigationKey : ⊤ → Navigation.Key
navigationKey ⊤ = Navigation.key ⊤


pub applicationSubscriptions :
      Sub.Sub msg
    , sync (Browser.UrlRequest → msg)
    , sync (Url.Url → msg)
    → Sub.Sub msg
applicationSubscriptions sub request changed =
    Sub.batch [ sub, Navigation.onUrlRequest request, Navigation.onUrlChange changed ]


finish : ⊤ → ⊤
finish ⊤ =
    drain ⊤
    if Js.isNull (Js.read phase) then
        ⊤
    else
        _ = Js.apply (Js.read phase) []
        if
            Js.isNull (Js.read queue)
                && Js.to (Js.get (Js.read later) "length") == 0
                && Js.to (Js.get (Js.read waiters) "length") == 0
        then
            ⊤
        else
            finish ⊤


afterPoint : ⊤ → ⊤
afterPoint ⊤ =
    resumes = Js.read waiters
    work = Js.read later
    Js.write waiters (Js.array [])
    Js.write later (Js.array [])
    Js.write inAfter True
    Js.finally
        (λ⊤ →
            Js.each resumes λresume → Js.to (Js.apply resume [ Js.null ])
            Js.each work λf → Js.to (Js.apply f [])
        )
        λ⊤ → Js.write inAfter False


onRendered : Task.Resume ⊤ → (⊤ → ⊤)
onRendered resume =
    if not (Js.read running) || Js.read inAfter then
        _ = Js.apply (Js.from resume) [ Js.null ]
        Js.to Js.null
    else
        _ = Js.call (Js.read waiters) "push" [ Js.from resume ]
        λ⊤ →
            i : Int
            i = Js.to (Js.call (Js.read waiters) "indexOf" [ Js.from resume ])
            if i ≥ 0 then
                Js.to (Js.call (Js.read waiters) "splice" [ Js.from i, Js.from 1 ])


stopped : Int → ⊤
stopped cut =
    line = "Cleanups cut short while stopping:"

    if cut == 0 then
        ⊤
    else
        Js.to (Js.call (Js.global "console") "warn" [ Js.from line, Js.from cut ])

    if Js.development ⊤ then
        if cut == 0 then
            ⊤
        else
            Js.to
                (Js.apply (Js.read screenLine)
                    [ Js.from
                        ("\n\n${line} "
                            ++ Js.to (Js.apply (Js.global "String") [ Js.from cut ])
                        )
                    ]
                )

        Js.to
            (Js.call (Js.global "window") "removeEventListener"
                [ Js.from "error", Js.read screenReport ]
            )


-- The crash screen's: what adds a line to it, and its `error` listener.
screenLine : Js.Ref V
screenLine = Js.ref Js.null


screenReport : Js.Ref V
screenReport = Js.ref Js.null


pub title : String → ⊤
title value = Hosted.title value


--| Direct writes have already completed; there is no render queue to flush.
pub flush : ⊤ → ⊤
flush ⊤ = ⊤


-- Structural scripts and read walks can reach the same final row.
groupEpoch : Js.Ref Int
groupEpoch = Js.ref 0


pub groupProgram : ⊤ → ⊤
groupProgram ⊤ = Js.write groupEpoch (Js.read groupEpoch + 1)


pub groupOnce : V, Int → Bool
groupOnce instance group =
    previous = Js.get instance "$$directGroups"
    stamps =
        if Js.isUndefined previous then
            made = Js.array []
            Js.set instance "$$directGroups" made
            made
        else
            previous
    if Js.same (Js.at stamps group) (Js.from (Js.read groupEpoch)) then
        False
    else
        Js.set stamps (String.fromInt group) (Js.from (Js.read groupEpoch))
        True


-- ---- Parameterised templates -------------------------------------------
-- A template captures the caller's analysis context with its inputs. The
-- context is per guarded invocation, never a property of a shared helper.

templateContext : Js.Ref V
templateContext = Js.ref Js.null


templateKey : Js.Ref Int
templateKey = Js.ref (-1)


templateMount : Js.Ref Bool
templateMount = Js.ref False


-- Scoped by templatePatch, so a retained slot only reads a Boolean. Nested
-- template patches restore their caller's fallback eligibility on return.
templateFallback : Js.Ref Bool
templateFallback = Js.ref False


pub templatePlan : V → V
templatePlan entries =
    plan = Js.object []
    Js.each entries λentry → Js.set plan (Js.to (Js.at entry 0)) (Js.at entry 1)
    Js.set plan "$$templates" (Js.construct (Js.global "Map") [])
    plan


pub templateProgram : V, Int → V
templateProgram plan key =
    before =
        Js.array
            [ Js.read templateContext, Js.from (Js.read templateKey), Js.read templateProgramOwner ]
    Js.write templateProgramOwner plan
    Js.write
        templateContext
        (Js.array
            [ plan
            , Js.from ""
            , Js.null
            , Js.null
            , Js.get plan "$root"
            , Js.from False
            , Js.from False
            ]
        )
    Js.write templateKey key
    before


pub templateEnd : V → ⊤
templateEnd before =
    Js.write templateContext (Js.at before 0)
    Js.write templateKey (Js.to (Js.at before 1))
    Js.write templateProgramOwner (Js.at before 2)


-- Only the block returned by a row producer owns the physical row. Nested
-- helper values created while producing it keep that row as their parent.
pub templateRow : V → V
templateRow producer = Js.from λitem position →
    result = Js.apply producer [ item, position ]
    values = Js.get result "v"
    if not (Js.to (Js.call (Js.global "Array") "isArray" [ values ])) then
        result
    else
        captured = Js.get values "$$directContext"
        context =
            if Js.isNull captured || Js.isUndefined captured then
                templateCapture "" ""
            else
                captured
        if Js.isNull context then
            result
        else
            rowContext =
                Js.array
                    [ Js.at context 0
                    , Js.at context 1
                    , Js.at context 2
                    , Js.at context 3
                    , Js.at context 4
                    , if Js.isNull captured || Js.isUndefined captured then
                        Js.from True
                      else
                        Js.at context 5
                    , Js.from True
                    ]
            arguments = Js.call values "slice" []
            Js.set arguments "$$directContext" rowContext
            Js.object [ ( "t", Js.get result "t" ), ( "v", arguments ) ]


pub templateCapture : String, String → V
templateCapture prefix source =
    context = Js.read templateContext
    if Js.isNull context then
        Js.null
    else
        path : String
        path = Js.to (Js.at context 1)
        Js.array
            [ Js.at context 0
            , Js.from (path ++ prefix)
            , Js.read templateRowOwner
            , if source == "" then Js.at context 3 else Js.from source
            , Js.at context 4
            , Js.at context 5
            , Js.from False
            ]


pub templateValue : String, V → V
templateValue part f =
    before = Js.read templateContext
    Js.write templateContext (templateCapture part "")
    Js.finally (λ⊤ → Js.apply f []) λ⊤ → Js.write templateContext before


pub templatePlace : String, V → V
templatePlace part f =
    before = Js.read templateContext
    next = templateCapture "" ""
    if not (Js.isNull next) then
        cut : Int
        cut = Js.to (Js.call (Js.from part) "lastIndexOf" [ Js.from "/" ])
        tail : String
        tail = Js.to (Js.call (Js.from part) "slice" [ Js.from (cut + 1) ])
        prefix : String
        prefix = Js.to (Js.call (Js.from part) "slice" [ Js.from 0, Js.from cut ])
        path : String
        path = Js.to (Js.at before 1)
        table = Js.at before 0
        exact = Js.get table (tail ++ path ++ prefix)
        boundary =
            if Js.isUndefined exact then
                Js.get table ("$producer/" ++ tail ++ path ++ prefix)
            else
                exact
        if not (Js.isUndefined boundary) then Js.set next "4" boundary
    Js.write templateContext next
    Js.finally (λ⊤ → Js.apply f []) λ⊤ → Js.write templateContext before


-- A group's descriptor is [source holes, every-render, capture refresh].
-- Capture refresh is not a DOM group; it updates an event's lexical inputs.
templateWanted : V → Bool
templateWanted desc =
    if Js.to (Js.at desc 2) then
        False
    else if Js.read templateEffects then
        Js.to (Js.at desc 1)
    else if Js.read templateKey < 0 || Js.isNull (Js.read templateContext) then
        True
    else if Js.to (Js.at desc 3) || Js.to (Js.at desc 2) then
        False
    else if Js.to (Js.at desc 1) then
        True
    else
        context = Js.read templateContext
        if Js.same (Js.at context 5) (Js.from True) then
            boundary = Js.at context 4
            if Js.isUndefined boundary then
                fault "browser-direct visit invariant: unbound value has no placement mask"
            Js.same (Js.call boundary "charAt" [ Js.from (Js.read templateKey) ]) (Js.from "1")
        else
            templateAny (Js.at desc 0) (Js.at context 0) (Js.to (Js.at context 1)) 0


templateAny : V, V, String, Int → Bool
templateAny holes plan path n =
    if n ≥ Js.to (Js.get holes "length") then
        False
    else
        hole : String
        hole = Js.to (Js.at holes n)
        exact = Js.get plan (hole ++ path)
        bits = if Js.isUndefined exact then Js.get plan ("$call${path}/${hole}") else exact
        if Js.typeIs bits "undefined" then
            context = Js.read templateContext
            source : String
            source = Js.to (Js.at context 3)
            reason = Js.get plan ("$value/${source}")
            if Js.isUndefined reason then
                fault
                    "browser-direct visit invariant: undeclared template fallback at ${hole}${path}"
            boundary = Js.at context 4
            if Js.isUndefined boundary then
                fault "browser-direct visit invariant: declared fallback has no placement mask"
            Js.same (Js.call boundary "charAt" [ Js.from (Js.read templateKey) ]) (Js.from "1")
        else if Js.same (Js.call bits "charAt" [ Js.from (Js.read templateKey) ]) (Js.from "1") then
            True
        else
            templateAny holes plan path (n + 1)


pub templateGroup : V, V, V → V
templateGroup desc patch restateGroup =
    Js.set desc "$$patch" patch
    Js.set desc "$$restate" restateGroup
    desc


templateSelect : V → V
templateSelect groups =
    context = Js.read templateContext
    fallback =
        if Js.isNull context then
            True
        else if Js.same (Js.at context 5) (Js.from True) then
            True
        else
            source : String
            source = Js.to (Js.at context 3)
            not (Js.isUndefined (Js.get (Js.at context 0) ("$value/${source}")))
    Js.write templateFallback (templateFallbackEntered fallback)
    if fallback then
        templateSelectNew groups
    else
        plan = Js.at context 0
        templates = Js.get plan "$$templates"
        saved = Js.call templates "get" [ groups ]
        cache =
            if Js.isUndefined saved then
                made = keyMap ⊤
                _ = Js.call templates "set" [ groups, made ]
                made
            else
                saved
        path : String
        path = Js.to (Js.at context 1)
        mode = if Js.read templateEffects then "effects" else "all"
        key = "${path}:${String.fromInt (Js.read templateKey)}:${mode}"
        selected = Js.call cache "get" [ Js.from key ]
        if Js.isUndefined selected then
            made = templateSelectNew groups
            _ = Js.call cache "set" [ Js.from key, made ]
            made
        else
            selected


templateSelectNew : V → V
templateSelectNew groups =
    mask = keyMap ⊤
    wanted = Js.ref False
    normal = Js.array []
    changed = Js.array []
    Js.each groups λgroup →
        selected = templateWanted group
        if selected then Js.write wanted True
        _ = Js.call mask "set" [ group, Js.from selected ]
        if Js.to (Js.at group 2) then
            _ = Js.call changed "push" [ Js.get group "$$patch" ]
            ⊤
        else
            operation = if selected then Js.get group "$$patch" else Js.get group "$$restate"
            if not (Js.isNull operation) then
                if Js.read templateFallback then Js.write wanted True
                _ = Js.call normal "push" [ operation ]
                _ = Js.call changed "push" [ operation ]
                ⊤
    Js.array [ mask, Js.from (Js.read wanted), normal, changed ]


-- A stored value's constant producers still lead to dynamic descendants.
-- Enter their retained slots without evaluating the mount-only producers.
templateFallbackEntered : Bool → Bool
templateFallbackEntered fallback =
    context = Js.read templateContext
    if not fallback || Js.read templateEffects || Js.isNull context then
        False
    else
        Js.read templateKey < 0
            || Js.same
                (Js.call (Js.at context 4) "charAt" [ Js.from (Js.read templateKey) ])
                (Js.from "1")


templateSameInputs : V, V, Int → Bool
templateSameInputs before after n =
    if n == 0 then
        True
    else if Js.isUndefined before || not (Js.same (Js.at before (n - 1)) (Js.at after (n - 1))) then
        False
    else
        templateSameInputs before after (n - 1)


pub templatePatch : V, V, Int, V, Bool → V
templatePatch prepare patch inputs groups rowTemplate = Js.from λinstance values →
    captured = Js.get values "$$directContext"
    before = Js.read templateContext
    context =
        if Js.isNull captured && not (Js.isNull before) then
            Js.array
                [ Js.at before 0
                , Js.at before 1
                , Js.at before 2
                , Js.null
                , Js.at before 4
                , Js.from True
                ]
        else if not (Js.isNull captured) && not (Js.isNull before) then
            Js.array
                [ Js.at captured 0
                , Js.at captured 1
                , if Js.isNull (Js.at captured 2) || Js.isUndefined (Js.at captured 2) then
                    Js.read templateRowOwner
                  else
                    Js.at captured 2
                , Js.at captured 3
                , Js.at before 4
                , Js.at captured 5
                , Js.at captured 6
                ]
        else
            captured
    wasMount = Js.read templateMount
    wasFallback = Js.read templateFallback
    wasRow = Js.read templateRowOwner
    ownsRow = rowTemplate || (not (Js.isNull context) && Js.same (Js.at context 6) (Js.from True))
    if ownsRow then
        Js.write templateRowOwner instance
        if not (Js.isNull context) then
            Js.set context "2" instance
            Js.set context "6" (Js.from False)
        if Js.development ⊤ then visitRowMode instance (Js.read templateEffects)
    else if not (Js.isNull context) then
        Js.write templateRowOwner (Js.at context 2)
    if Js.development ⊤ then templateRegister instance groups context before
    mounted = Js.get instance "$$template"
    Js.write templateContext context
    Js.write templateMount (not (Js.same mounted (Js.from True)))
    selected = templateSelect groups
    sameInputs = templateSameInputs (Js.get instance "$$arguments") values inputs
    Js.set instance "$$arguments" values
    Js.finally
        (λ⊤ →
            if
                Js.development ⊤
                    && not (Js.read templateMount)
                    && not (Js.same (Js.get instance "$$visitBorn") (Js.from (Js.read visitEpoch)))
            then
                expected = Js.array []
                Js.each groups λgroup →
                    _ =
                        Js.call expected "push"
                            [ Js.array [ group, Js.from (templateWanted group) ] ]
                    ⊤
                visitScope instance expected
            if
                Js.read templateMount
                    || Js.to (Js.at selected 1)
                    || not sameInputs
                    || Js.same (Js.get instance "l") (Js.from True)
            then
                environment = Js.apply prepare [ instance, values ]
                if Js.read templateMount then
                    Js.each groups λgroup →
                        _ = Js.apply (Js.get group "$$patch") [ instance, environment ]
                        ⊤
                else
                    operations = if sameInputs then Js.at selected 2 else Js.at selected 3
                    Js.each operations λoperation →
                        _ = Js.apply operation [ instance, environment ]
                        ⊤
                _ = Js.apply patch [ instance, environment ]
                ⊤
            Js.set instance "$$template" (Js.from True)
            Js.null
        )
        λ⊤ →
            Js.write templateContext before
            Js.write templateMount wasMount
            Js.write templateFallback wasFallback
            Js.write templateRowOwner wasRow


pub templateInputs : V, V → V
templateInputs values context =
    Js.set values "$$directContext" context
    values


-- ---- Observed visits against the analysis -------------------------------
-- Expected scopes are published by the structural traversal (branch/row
-- eligibility), independently of its group calls. A template publishes its
-- analysis-selected groups before running any of its patch body.

visitState : Js.Ref V
visitState = Js.ref Js.null


pub visitBegin : V, Int → V
visitBegin owner key =
    before = Js.read visitState
    Js.write visitEpoch (Js.read visitEpoch + 1)
    Js.write
        visitState
        (Js.array [ keyMap ⊤, keyMap ⊤, owner, Js.from (Js.read visitEpoch), Js.from key ])
    before


visitMap : V, V → V
visitMap table instance =
    before = Js.call table "get" [ instance ]
    if Js.isUndefined before then
        made = keyMap ⊤
        _ = Js.call table "set" [ instance, made ]
        made
    else
        before


pub visitScope : V, V → ⊤
visitScope instance groups =
    state = Js.read visitState
    if not (Js.isNull state) then
        expected = visitMap (Js.at state 0) instance
        Js.each groups λgroup →
            if Js.to (Js.at group 1) then
                _ = Js.call expected "set" [ Js.at group 0, Js.from True ]
                ⊤


pub visitObserve : V, V → ⊤
visitObserve instance group =
    state = Js.read visitState
    if not (Js.isNull state) then
        seen = visitMap (Js.at state 1) instance
        before = Js.call seen "get" [ group ]
        visits : Int
        visits = if Js.isUndefined before then 0 else Js.to before
        _ = Js.call seen "set" [ group, Js.from (visits + 1) ]
        ⊤


pub visitEnd : V → ⊤
visitEnd before =
    state = Js.read visitState
    if not (Js.isNull state) then
        visitInventoryExpected state
        expected = Js.at state 0
        seen = Js.at state 1
        _ =
            Js.call expected "forEach"
                [ Js.from λgroups instance →
                    actual = visitMap seen instance
                    Js.to
                        (Js.call groups "forEach"
                            [ Js.from λ_ group →
                                if not (Js.same (Js.call actual "get" [ group ]) (Js.from 1)) then
                                    visitFault "missing or repeated analysis-predicted group" group
                            ]
                        )
                ]
        _ =
            Js.call seen "forEach"
                [ Js.from λgroups instance →
                    wanted = visitMap expected instance
                    Js.to
                        (Js.call groups "forEach"
                            [ Js.from λvisits group →
                                if
                                    not (Js.same visits (Js.from 1))
                                        || not
                                            (Js.same (Js.call wanted "get" [ group ]) (Js.from True)
                                            )
                                then
                                    visitFault "extra or repeated group" group
                            ]
                        )
                ]
        ⊤
    Js.write visitState before


-- A new row/arm is initialised once, not visited by the dispatch mounting it.
pub visitFactory : V → V
visitFactory factory = Js.from λa b c d →
    before = Js.read visitState
    Js.write visitState Js.null
    Js.finally (λ⊤ → Js.apply factory [ a, b, c, d ]) λ⊤ → Js.write visitState before


pub templateObserve : V, V → ⊤
templateObserve instance group =
    if Js.development ⊤ && not (Js.read templateMount) then
        visitObserve instance group


-- Live template inventory: the end-of-handler walk also predicts groups of
-- a child whose patch was accidentally omitted altogether.
visitEpoch : Js.Ref Int
visitEpoch = Js.ref 0


templateRowOwner : Js.Ref V
templateRowOwner = Js.ref Js.null


pub templateRowPush : V → V
templateRowPush rowScope =
    before = Js.read templateRowOwner
    Js.write templateRowOwner rowScope
    before


pub templateRowPop : V → ⊤
templateRowPop before = Js.write templateRowOwner before


pub visitRow : V → ⊤
visitRow rowScope = visitRowMode rowScope False


visitRowMode : V, Bool → ⊤
visitRowMode rowScope effects =
    sameEpoch = Js.same (Js.get rowScope "$$visitEpoch") (Js.from (Js.read visitEpoch))
    onlyEffects =
        effects && (not sameEpoch || Js.same (Js.get rowScope "$$visitEffectsOnly") (Js.from True))
    Js.set rowScope "$$visitEpoch" (Js.from (Js.read visitEpoch))
    Js.set rowScope "$$visitEffectsOnly" (Js.from onlyEffects)


visitInventory : V → V
visitInventory owner =
    found = Js.get owner "$$directVisits"
    if Js.isUndefined found then
        made = keyMap ⊤
        Js.set owner "$$directVisits" made
        made
    else
        found


templateRegister : V, V, V, V → ⊤
templateRegister instance groups context parent =
    owner =
        if not (Js.isNull context) then
            Js.at context 0
        else if not (Js.isNull parent) then
            Js.at parent 0
        else
            Js.read templateProgramOwner
    if not (Js.isNull owner) then
        inventory = visitInventory owner
        found = Js.call inventory "get" [ instance ]
        born = if Js.isUndefined found then Js.from (Js.read visitEpoch) else Js.at found 3
        Js.set instance "$$visitBorn" born
        _ =
            Js.call inventory "set"
                [ instance
                , Js.array [ Js.get instance "e", groups, context, born, Js.read templateRowOwner ]
                ]
        ⊤


visitInventoryExpected : V → ⊤
visitInventoryExpected state =
    owner = Js.at state 2
    epoch = Js.at state 3
    inventory = visitInventory owner
    before = Js.read templateContext
    beforeKey = Js.read templateKey
    Js.write templateKey (Js.to (Js.at state 4))
    Js.to
        (Js.call inventory "forEach"
            [ Js.from λentry instance →
                node = Js.at entry 0
                rowScope = Js.at entry 4
                if not (Js.same (Js.get node "isConnected") (Js.from True)) then
                    _ = Js.call inventory "delete" [ instance ]
                    ⊤
                else if
                    not (Js.same (Js.at entry 3) epoch)
                        && (Js.isNull rowScope || Js.same (Js.get rowScope "$$visitEpoch") epoch)
                then
                    Js.write templateContext (Js.at entry 2)
                    wanted = Js.array []
                    Js.each (Js.at entry 1) λgroup →
                        onlyEffects =
                            not (Js.isNull rowScope)
                                && Js.same (Js.get rowScope "$$visitEffectsOnly") (Js.from True)
                        selected =
                            if onlyEffects then Js.to (Js.at group 1) else templateWanted group
                        _ = Js.call wanted "push" [ Js.array [ group, Js.from selected ] ]
                        ⊤
                    visitScope instance wanted
            ]
        )
    Js.write templateContext before
    Js.write templateKey beforeKey


visitFault : String, V → ⊤
visitFault reason group =
    rendered : String
    rendered = Js.to (Js.call (Js.global "JSON") "stringify" [ group ])
    key : Int
    key = Js.to (Js.at (Js.read visitState) 4)
    fault "browser-direct visit invariant: ${reason} (key ${String.fromInt key}, group ${rendered})"


templateProgramOwner : Js.Ref V
templateProgramOwner = Js.ref Js.null


templateEffects : Js.Ref Bool
templateEffects = Js.ref False


pub templateRestate : V, V → ⊤
templateRestate instance kind =
    before = Js.read templateEffects
    Js.write templateEffects True
    Js.finally (λ⊤ → Js.to (Js.call kind "p" [ instance, Js.get instance "$$arguments" ])) λ⊤ →
        Js.write templateEffects before
