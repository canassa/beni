--! The Elm Architecture for a page (`docs/design/boundary.md` §9.1;
--! `backend.md` §15.11), written in beni over the `browser` platform's
--! `Program`. It adds no JavaScript and no runtime of its own: the render
--! loop, the mount and the delegated events are `browser`'s, and so are
--! this platform's program, runtime and markup lowering, which it inherits.
--!
--! One immutable model, a pure `update`, and a `view` of the model. A
--! component is a model, a message type, an `update` and a `view` of its
--! own, nested with `Html.map`: the parent's view maps the child's
--! messages into its own, and its `update` hands each back to the child.
--!
--! A program with no effects is a `sandbox`. One with effects is an
--! `element`: `update` returns the next model and a `Cmd`, the work the
--! message asks for, and `subscriptions` says from the model what should
--! keep running (`browser`'s `Cmd` and `Sub` modules). The command table,
--! its four policies and the subscription diff are here, in beni, over
--! `Browser.hosted`, the `Hosted` module and core's `Task`.

import Browser exposing (Host)
import Cmd exposing (After, Cancel, CancelAll, Cmd, Concurrent, Ignore, Item, Keyed, Perform, Policy, Queue, Restart, Send)
import Dict exposing (Dict)
import Hosted exposing (Key, Outlet, Relay, Tap)
import Html exposing (Html)
import Sub exposing (Sub)
import Task exposing (Exit, Fiber, Scope)


--| What `main` is: `Browser.Program` under this platform's name, so a
--| program need not import `Browser` to write `main : Tea.Program`.
--| `Browser.mountAt` and `Browser.programs` place several on one page.
pub type alias Program =
    Browser.Program


--| A page with a model and no effects: `init` is rendered first, and each
--| message a handler sends goes through `update`. Several messages in one
--| task are rendered once, after the task.
pub sandbox :
    { init : model, update : msg, model -> model, view : model -> Html msg }
    -> Program
sandbox app = Browser.program app


--| A page with a model and effects. `init` is the first model and the
--| work it asks for; each message goes through `update`, which returns the
--| next model and the work that message asks for; and `subscriptions`
--| says, from the model, what should keep running. Commands and
--| subscriptions run in fibers in the program's scope, which the program
--| owns: none outlives it, and none belongs to the body whose message
--| started it.
pub element :
    { init : ( model, Cmd msg )
    , update : msg, model -> ( model, Cmd msg )
    , view : model -> Html msg
    , subscriptions : model -> Sub msg
    }
    -> Program
element app =
    Browser.hosted
        { init = \host -> start host app.init
        , update = \host msg state -> step host (app.update msg state.model) state
        , settle = \host state -> settle host (app.subscriptions state.model) state
        , view = \state -> app.view state.model
        }


-- The program's own state beside the model: its scope, the bodies running
-- under each key path, and the live subscriptions by key.
type alias State model msg =
    { model : model
    , scope : Scope
    , jobs : Dict (List Key) (List (Job msg))
    , live : Lives msg
    }


-- The live subscriptions: `Idle` until the first `Sub.Listen`. Only the
-- diff of one makes a `Running`, so a program that never subscribes
-- ships no code that cancels one (`docs/design/backend.md` §9, *A `case`
-- arm on a constructor nothing builds*).
type Lives msg
    = Idle
    | Running (Dict Key (Live msg))


-- A keyed body: its fiber, and the outlet its `send` goes through.
type alias Job msg =
    { fiber : Fiber ()
    , outlet : Outlet msg
    }


-- A live subscription: its fiber, and the relay its values go through.
type alias Live msg =
    { fiber : Fiber ()
    , relay : Relay msg
    }


start : Host msg, ( model, Cmd msg ) -> State model msg
start host ( model, cmd ) =
    perform host cmd { model = model, scope = Task.openRoot (), jobs = Dict.empty, live = Idle }


step : Host msg, ( model, Cmd msg ), State model msg -> State model msg
step host ( model, cmd ) state = perform host cmd { state | model = model }


perform : Host msg, Cmd msg, State model msg -> State model msg
perform host cmd state = List.foldl (Cmd.items cmd) state (\it s -> item host it s)


item : Host msg, Item msg, State model msg -> State model msg
item host it state =
    case it of
        Perform body ->
            let
                _ = spawn host state.scope body
            in
            state

        Keyed path policy body ->
            keyed host path policy body state

        Cancel path ->
            stopped state.scope (jobsAt state path) { state | jobs = Dict.remove state.jobs path }

        CancelAll prefix ->
            let
                ( gone, kept ) = Dict.partition state.jobs (\path _ -> startsWith path prefix)
            in
            { state | jobs = stopped state.scope (List.concat (Dict.values gone)) kept }

        After work ->
            let
                _ = Hosted.afterRender host work
            in
            state


keyed : Host msg, List Key, Policy, (Send msg -> ()), State model msg -> State model msg
keyed host path policy body state =
    let
        old = List.filter (jobsAt state path) (\j -> Task.running j.fiber)
    in
    case ( policy, old ) of
        ( _, [] ) ->
            put state path [ spawn host state.scope body ]

        ( Restart, _ ) ->
            closing old (put state path [ spawn host state.scope (\send -> after (stop old) (body send)) ])

        ( Ignore, _ ) ->
            state

        ( Queue, _ ) ->
            put state path [ spawn host state.scope (\send -> after (List.foldl old () (\j _ -> ended (Task.wait j.fiber))) (body send)) ]

        ( Concurrent, _ ) ->
            put state path [ spawn host state.scope body, ...old ]


-- Start a body in a fiber of the program's scope, with an outlet of its
-- own as its `send`.
spawn : Host msg, Scope, (Send msg -> ()) -> Job msg
spawn host scope body =
    let
        o = Hosted.outlet host
    in
    { fiber = Task.spawnIn scope (\() -> body (Hosted.emit o _)), outlet = o }


jobsAt : State model msg, List Key -> List (Job msg)
jobsAt state path = Maybe.withDefault (Dict.get state.jobs path) []


put : State model msg, List Key, List (Job msg) -> State model msg
put state path jobs = { state | jobs = Dict.insert state.jobs path jobs }


-- Close the outlets of `jobs` now, so nothing they send after this message
-- lands, and cancel their fibers in one of the scope's own.
stopped : Scope, List (Job msg), a -> a
stopped scope jobs value =
    case jobs of
        [] ->
            value

        _ ->
            let
                _ = closing jobs ()
                _ = Task.spawnIn scope (\() -> stop jobs)
            in
            value


closing : List (Job msg), a -> a
closing jobs value = List.foldl jobs value (\j v -> after (Hosted.close j.outlet) v)


-- Cancel each fiber and wait for its cleanup.
stop : List (Job msg) -> ()
stop jobs = List.foldl jobs () (\j _ -> Task.cancel j.fiber)


ended : Exit a -> ()
ended _ = ()


after : (), a -> a
after _ value = value


startsWith : List Key, List Key -> Bool
startsWith path prefix =
    case ( path, prefix ) of
        ( _, [] ) ->
            True

        ( [ p, ...ps ], [ q, ...qs ] ) ->
            if p == q then startsWith ps qs else False

        _ ->
            False


-- The subscription diff, once per render: keys that left are cancelled,
-- keys that stayed keep their fiber and take their new taggers, keys that
-- arrived start. With no `Listen` and nothing running there is nothing to
-- do, and a program that never subscribes reaches no more than that.
settle : Host msg, Sub msg, State model msg -> State model msg
settle host sub state =
    case sub of
        Sub.Listen declared ->
            { state | live = Running (diff host state.scope declared (running state.live)) }

        Sub.None ->
            case state.live of
                Idle ->
                    state

                Running live ->
                    { state | live = Running (diff host state.scope [] live) }


running : Lives msg -> Dict Key (Live msg)
running lives =
    case lives of
        Idle ->
            Dict.empty

        Running live ->
            live


diff : Host msg, Scope, List ( Key, Tap msg ), Dict Key (Live msg) -> Dict Key (Live msg)
diff host scope declared live =
    let
        wanted = List.foldl declared Dict.empty (\( k, t ) d -> Dict.insert d k (List.append (Maybe.withDefault (Dict.get d k) []) [ t ]))
        kept = Dict.foldl live Dict.empty (\k l d -> keep scope wanted k l d)
    in
    Dict.foldl wanted kept (\k taps d -> arrive host scope k taps d)


keep : Scope, Dict Key (List (Tap msg)), Key, Live msg, Dict Key (Live msg) -> Dict Key (Live msg)
keep scope wanted k l d =
    case Dict.get wanted k of
        Just taps ->
            let
                _ = Hosted.retap l.relay taps
            in
            Dict.insert d k l

        Nothing ->
            let
                _ = Hosted.closeRelay l.relay
                _ = Task.spawnIn scope (\() -> Task.cancel l.fiber)
            in
            d


arrive : Host msg, Scope, Key, List (Tap msg), Dict Key (Live msg) -> Dict Key (Live msg)
arrive host scope k taps d =
    case ( Dict.member d k, taps ) of
        ( False, [ first, ..._ ] ) ->
            let
                r = Hosted.relay host first
                _ = Hosted.retap r taps
            in
            Dict.insert d k { fiber = Task.spawnIn scope (\() -> Hosted.run r), relay = r }

        _ ->
            d
