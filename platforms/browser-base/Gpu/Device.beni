--! A device's snapshots, its queue, its destruction and its loss
--! (`docs/design/webgpu.md` §4, §8), and the resources it makes, each a
--! checked operation (§6.1). The loss is watched from the moment
--! the device is made: it is latched once, every waiter wakes, and a late
--! reader still sees it. There is no retry: after a loss, a program asks
--! for a new adapter and a new device.

import Gpu.Engine as Engine
import Gpu.Error as Error
import Gpu.Feature as Feature
import Gpu.Handle as Handle
import Gpu.Limits as Limits
import Gpu.Make as Make
import Gpu.Memory as Memory
import Gpu.Native as Native
import Gpu.Types as Types
import Js
import Sub exposing (Sub)


--| The features the device was made with, dependencies included.
pub features : Handle.Device → Feature.Features
features device = Feature.fromNames (Engine.readNames (Js.from device) "features")


--| The limits the device was made with.
pub limits : Handle.Device → Limits.Limits
limits device = Native.readLimits (Engine.member (Js.from device) "limits")


--| What the host says of the device's adapter.
pub adapterInfo : Handle.Device → Types.AdapterInfo
adapterInfo device = Native.readAdapterInfo (Engine.member (Js.from device) "adapterInfo")


--| The device's label.
pub label : Handle.Device → String
label device = Js.to (Js.get (Js.from device) "label")


--| Set the device's label.
pub setLabel : Handle.Device, String → ⊤
setLabel device text = Js.set (Js.from device) "label" (Js.from text)


--| The device's queue.
pub queue : Handle.Device → Handle.Queue
queue device = Js.to (Engine.member (Js.from device) "queue")


--| Destroy the device. Later work on it fails, waiters for its loss wake
--| with `Destroyed`, and destroying it again does nothing. Not checked by
--| an error scope: the standard gives it no GPU error.
pub destroy : Handle.Device → ⊤
destroy device = Engine.destroy (Js.from device)


--| The device's loss, if one has been observed.
pub loss : Handle.Device → Maybe Error.DeviceLoss
loss device = Engine.loss (Js.from device)


--| Wait until the device is lost; at once if it is already. Runs under a
--| diagnostic session's lease (§6.4).
pub awaitLost : Handle.Device → Error.DeviceLoss
awaitLost device = Engine.awaitLost (Js.from device)


--| What a device reports beside its operations' results: an error that
--| escaped every error scope, `Uncaptured`, and the device's loss, `Lost`
--| (`Gpu.Error.DeviceEvent`).
pub type alias DeviceEvent =
    Error.DeviceEvent


--| Call `handler` with each event of the device, in order, in the calling
--| fiber, until the device is lost: its `Lost` event is the last, and
--| `eachEvent` then returns. A device lost already gives `Lost` at once,
--| so no listener misses the loss by starting late. An event that arrives
--| while `handler` runs waits for it. Cancel the fiber to stop listening.
--|
--| An `Uncaptured` error is a defect of the engine, which runs every call
--| under an error scope: the program that made the device stops just after
--| its listeners are handed it. Events are telemetry, never the way to
--| detect a failure: each checked operation returns its own, and a browser
--| may report fewer errors than happened (§1). May suspend; runs under a
--| diagnostic session's lease (§6.4).
pub eachEvent : Handle.Device, (DeviceEvent → ⊤) → ⊤
eachEvent device handler = Engine.eachEvent (Js.from device) handler


type EventKey
    = Events Int


--| `eachEvent` as a subscription: each event of the device, as a message
--| through `tag`, while the subscription is live. One device's
--| declarations share one listener.
pub onEvent : Handle.Device, (DeviceEvent → msg) → Sub msg
onEvent device tag =
    Sub.listen (Events (Engine.deviceId (Js.from device))) (sendEvents device _) tag


-- Each event, sent as a value of its own: what the engine queued is its.
-- The copy exists only because the ownership checker refuses a send of a
-- value read with `Js.to` (#2291).
sendEvents : Handle.Device, (DeviceEvent → ⊤) → ⊤
sendEvents device send = eachEvent device λevent → send (fresh event)


fresh : DeviceEvent → DeviceEvent
fresh event =
    case event of
        Error.Uncaptured found →
            Error.Uncaptured
                (case found of
                    Error.ValidationError m →
                        Error.ValidationError { message = m.message }

                    Error.OutOfMemoryError m →
                        Error.OutOfMemoryError { message = m.message }

                    Error.InternalError m →
                        Error.InternalError { message = m.message }
                )

        Error.Lost l →
            Error.Lost { reason = l.reason, message = l.message }


--| A sampler, checked (§6.1): the call runs between the device's error
--| scopes, and the sampler is returned only when none reported a failure
--| and the device was not lost. `Validation` for a descriptor the device
--| refuses; `OutOfMemory` or `Internal` when those scopes report;
--| `RelatedFailures` when several do; `DeviceLost` when the device is
--| lost before or while it is checked, with what was observed; and
--| `InvalidInput (SessionState DeviceLeased)` at once, without waiting,
--| while a diagnostic session holds the device. Every checked creation
--| below fails in these ways too. May suspend.
pub createSampler : Handle.Device, Types.SamplerDescriptor → Result Error.Error Handle.Sampler
createSampler device descriptor = made device (Make.sampler (Js.from device) descriptor)


-- Run a prepared creation as a checked operation, and give what it made.
made : Handle.Device, Result Error.Error Make.Op → Result Error.Error a
made _ prepared = Result.map (Make.checked prepared) λm → Js.to m


--| A buffer, checked (§6.1, §7.1). With `mappedAtCreation = Value True` it
--| is mapped once made, and `Gpu.Buffer.currentMapping` gives the mapping,
--| writable whatever the usages; its size must then be a multiple of 4
--| (`InvalidInput MappedSizeUnaligned`, before any native call), and a host
--| with no memory for the mapping gives `MapFailed
--| MappedAllocationFailed`. A buffer the device refuses is `Validation`
--| and is destroyed, never returned. May suspend.
pub createBuffer : Handle.Device, Types.BufferDescriptor → Result Error.Error Handle.Buffer
createBuffer device descriptor = made device (Make.buffer (Js.from device) descriptor)


--| `createBuffer` with `mappedAtCreation = Value True`, and the buffer's
--| mapping from creation.
pub createMappedBuffer :
      Handle.Device
    , Types.BufferDescriptor
    → Result Error.Error { buffer : Handle.Buffer, mapping : Handle.Mapping }
createMappedBuffer device descriptor =
    buffer = createBuffer device { descriptor | mappedAtCreation = Types.Value True }?
    case Memory.currentMapping (Js.from buffer) of
        Just m →
            Ok { buffer = buffer, mapping = Js.to m }

        Nothing →
            Engine.defect "a buffer created mapped has no mapping"


--| A texture, checked. A format whose feature the device was not made with
--| is `UnsupportedCapability (MissingFeature …)` before any native call;
--| the host's refusal of a feature-gated format anyway is
--| `FormatFeatureRejected`. May suspend.
pub createTexture : Handle.Device, Types.TextureDescriptor → Result Error.Error Handle.Texture
createTexture device descriptor = made device (Make.texture (Js.from device) descriptor)


--| A bind group layout, checked. May suspend.
pub createBindGroupLayout :
      Handle.Device
    , Types.BindGroupLayoutDescriptor
    → Result Error.Error Handle.BindGroupLayout
createBindGroupLayout device descriptor =
    made device (Make.bindGroupLayout (Js.from device) descriptor)


--| A bind group, checked. Its layout and every resource it binds must be
--| accepted, alive and of this device (`InvalidInput` before any native
--| call). May suspend.
pub createBindGroup : Handle.Device, Types.BindGroupDescriptor → Result Error.Error Handle.BindGroup
createBindGroup device descriptor = made device (Make.bindGroup (Js.from device) Js.null descriptor)


--| A pipeline layout, checked; a `Nothing` slot is an empty group. May
--| suspend.
pub createPipelineLayout :
      Handle.Device
    , Types.PipelineLayoutDescriptor
    → Result Error.Error Handle.PipelineLayout
createPipelineLayout device descriptor =
    made device (Make.pipelineLayout (Js.from device) Js.null descriptor)


--| A shader module, checked: invalid WGSL is `ShaderRejected`, with the
--| host's message and every message the compiler gave (§4), read before
--| the failure is returned. `Gpu.Shader.getCompilationInfo` gives the
--| messages of a module that was accepted. May suspend.
pub createShaderModule :
      Handle.Device
    , Types.ShaderModuleDescriptor
    → Result Error.Error Handle.Shader
createShaderModule device descriptor =
    Result.map (Make.shaderModuleIn Js.null (Js.from device) descriptor) Js.to


--| A compute pipeline, made by the native synchronous call and checked
--| (§6.1): a pipeline the device refuses is `Validation`. May suspend.
pub createComputePipeline :
      Handle.Device
    , Types.ComputePipelineDescriptor
    → Result Error.Error Handle.ComputePipeline
createComputePipeline device descriptor =
    made device (Make.computePipeline (Js.from device) Js.null descriptor)


--| A compute pipeline, made by the native asynchronous call (ledger §3): a
--| `GPUPipelineError` of reason `validation` is `PipelineValidation`, of
--| reason `internal` `PipelineInternal`, each with the entry points asked
--| for; any other rejection or reason is a defect. A cancelled wait leaves the pipeline unpublished. May suspend.
pub createComputePipelineAsync :
      Handle.Device
    , Types.ComputePipelineDescriptor
    → Result Error.Error Handle.ComputePipeline
createComputePipelineAsync device descriptor =
    Result.map (Make.computePipelineAsyncIn Js.null (Js.from device) descriptor) Js.to


--| A query set, checked. A timestamp query set needs the `timestamp-query`
--| feature: `UnsupportedCapability` before any native call without it. May
--| suspend.
pub createQuerySet : Handle.Device, Types.QuerySetDescriptor → Result Error.Error Handle.QuerySet
createQuerySet device descriptor = made device (Make.querySet (Js.from device) descriptor)


--| A render pipeline, made by the native synchronous call and checked
--| (§6.1): its layout and modules must be usable, a color target or depth
--| format whose feature the device lacks is `UnsupportedCapability` before
--| any native call, and the host's refusal of such a format anyway is
--| `FormatFeatureRejected`; a pipeline the device refuses is `Validation`.
--| May suspend.
pub createRenderPipeline :
      Handle.Device
    , Types.RenderPipelineDescriptor
    → Result Error.Error Handle.RenderPipeline
createRenderPipeline device descriptor =
    made device (Make.renderPipeline (Js.from device) Js.null descriptor)


--| A render pipeline, made by the native asynchronous call (ledger §3),
--| with `createRenderPipeline`'s checks first: a `GPUPipelineError` of
--| reason `validation` is `PipelineValidation`, of reason `internal`
--| `PipelineInternal`, a `TypeError` for a feature-gated format
--| `FormatFeatureRejected`; any other rejection or reason is a defect. A
--| cancelled wait leaves the pipeline unpublished. May suspend.
pub createRenderPipelineAsync :
      Handle.Device
    , Types.RenderPipelineDescriptor
    → Result Error.Error Handle.RenderPipeline
createRenderPipelineAsync device descriptor =
    Result.map (Make.renderPipelineAsyncIn Js.null (Js.from device) descriptor) Js.to
