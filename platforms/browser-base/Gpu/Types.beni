queryTypeToString value =
    case value of
        Occlusion →
            "occlusion"

        Timestamp →
            "timestamp"


--| The `QueryType` a native spelling names, if the pin has it.
pub queryTypeFromString : String → Maybe QueryType
queryTypeFromString text =
    case text of
        "occlusion" →
            Just Occlusion

        "timestamp" →
            Just Timestamp

        _ →
            Nothing


