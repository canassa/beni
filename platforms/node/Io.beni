--! Waiting, on Node (`transparent-effects-proposal.md` §16.5): a program
--! whose work runs in a fiber, and the primitives such work waits on.
--!
--! `main` is evaluated once, when the program starts, and must not wait
--! (§15.2 item 5). `Io.run` is how a program that waits is written: `main`
--! starts a fiber and the fiber does the waiting. Nothing else about `main`
--! changes — it is still a `Node.Program`.
--!
--!     main : Program
--!     main = Io.run λ() →
--!         Io.sleep 10
--!         Node.print "later"
--!
--! A primitive here is written in beni over `Task.callback` and one `impure`
--! `foreign` that starts the host's operation and returns what cancels it,
--! so that cancelling a fiber cancels what it was waiting on.

import Duration
import Js
import Node exposing (Program)
import Task exposing (Exit, Resume)


--| A program that runs `body` in a new fiber, and does what the `Program` it
--| returns says when it ends. If the fiber is cancelled, the program exits
--| 130.
--|
--| **When the fiber ends, the program ends**: after its output and exit
--| code, every fiber still running — one in a root scope, say — is
--| cancelled and its cleanup run, with 1 000 ms for cleanup that waits, so
--| nothing keeps the process alive once the program has answered.
--|
--| **A program that can never wake is reported**: when every fiber waits
--| for something nothing can ever answer, so that Node would simply stop,
--| the program says so on standard error and exits 1 — never a silent exit
--| 0 (`boundary.md` §9.8.15 (c)).
pub run : (⊤ → Program) → Program
run body =
    ended = Js.ref False

    _ = Js.call (Js.global "process") "on" [ Js.from "beforeExit", Js.from λ_ → stranded ended ]

    Task.start (λ⊤ → begin body) λexit →
        Js.write ended True
        finish exit
        Task.shutdown 1000 λ_ → ⊤

    Node.done


-- The fiber's first act: until it ends, a process that leaves by any route
-- the platform did not foresee leaves 1. `main` has returned by now, so
-- nothing writes the code after this but the fiber's end.
begin : (⊤ → Program) → Program
begin body =
    Js.set (Js.global "process") "exitCode" (Js.from 1)
    body ⊤


-- Node's loop is about to empty: no timer, socket or other handle can run
-- anything again. If `run`'s fiber has not ended it never will, so say so
-- and leave the exit code at 1. Nothing is scheduled — work queued here
-- would run the loop again — and no cleanup is run.
stranded : Js.Ref Bool → ⊤
stranded ended =
    if Js.read ended then
        ⊤
    else
        Js.write ended True
        Js.set (Js.global "process") "exitCode" (Js.from 1)
        _ = Js.call (Js.get (Js.global "process") "stderr") "write" [ Js.from stuck ]
        ⊤


stuck : String
stuck =
    "beni: the program cannot go on: every fiber is waiting for something that can never happen.\n"


foreign impure finish : Exit Program → ⊤


--| Wait `ms` milliseconds on the calling fiber's clock: `Task.sleep`. Only
--| the fiber that sleeps waits; the others run. `0` lets every other ready
--| fiber run first.
pub sleep : Int → ⊤
sleep ms = Task.sleep (Duration.millis ms)


--| Why a file could not be read: one constructor for each failure Node
--| documents. Any other failure is a defect and ends the program.
pub type FileError
    = NotFound
    | PermissionDenied
    | IsADirectory
    | NotADirectory
    | TooManyOpenFiles
    | SymlinkLoop
    | NameTooLong
    | InvalidPath
    | TooLarge


--| Read a UTF-8 text file without blocking other fibers: `Ok` with its
--| text, or `Err` with why it could not be read.
--|
--| - `NotFound`: there is no such file, or a directory on its path is
--|   missing.
--| - `PermissionDenied`: the program may not read it.
--| - `IsADirectory`: it is a directory.
--| - `NotADirectory`: something on its path that should be a directory
--|   is a file.
--| - `TooManyOpenFiles`: the process, or the system, has no file
--|   descriptor to spare.
--| - `SymlinkLoop`: its path has too many symbolic links to follow.
--| - `NameTooLong`: its path, or a name on it, is too long.
--| - `InvalidPath`: the path holds a NUL character, which no file name
--|   can.
--| - `TooLarge`: it is larger than any string can hold.
pub readFile : String → Result FileError String
readFile path = Task.callback λresume → startRead path resume


foreign impure startRead : String, Resume (Result FileError String) → (⊤ → ⊤)
