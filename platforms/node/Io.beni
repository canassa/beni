--! Waiting, on Node (`transparent-effects-proposal.md` §16.5): a program
--! whose work runs in a fiber, and the primitives such work waits on.
--!
--! `main` is evaluated once, when the program starts, and must not wait
--! (§15.2 item 5). `Io.run` is how a program that waits is written: `main`
--! starts a fiber and the fiber does the waiting. Nothing else about `main`
--! changes — it is still a `Node.Program`.
--!
--!     main : Program
--!     main = Io.run λ⊤ →
--!         Io.sleep 10
--!         Node.print "later"
--!
--! A primitive here is written in beni over `Task.callback` and one `impure`
--! function that starts the host's operation and returns what cancels it.
--! The control flow stays in beni over generated typed native bindings.

import Browser.Host.AbortController as Abort
import Browser.Host.AbortSignal as Signal
import Browser.Host.NodeDirent as Dirent
import Browser.Host.NodeFs as Fs
import Browser.Host.NodeProcess as Process
import Browser.Host.Promise as Promise
import Browser.Host.Rejection as Rejection
import Duration
import Js
import Log
import Node exposing (Program)
import Task exposing (Exit, Resume)


--| A program that runs `body` in a new fiber, and does what the `Program` it
--| returns says when it ends. If the fiber is cancelled, the program exits
--| 130.
--|
--| **When the fiber ends, the program ends**: after its output and exit
--| code, every fiber still running — one in a root scope, say — is
--| cancelled and its cleanup run, with 1 000 ms for cleanup that waits, so
--| nothing keeps the process alive once the program has answered.
--|
--| **A program that can never wake is reported**: when every fiber waits
--| for something nothing can ever answer, so that Node would simply stop,
--| the program says so on standard error and exits 1 — never a silent exit
--| 0 (`boundary.md` §9.8.15 (c)).
--|
--| **The log goes to standard error**: from the start, each line `Log`
--| writes is one `Log.logfmt` line on standard error, so the program's own
--| output on standard output stays clean (`boundary.md` §9.8.15 (b)). A
--| line written before `run` is called — while `main` is evaluated — goes
--| to `Log`'s default sink, the console.
pub run : (⊤ → Program) → Program
run body =
    ended = Js.ref False
    Log.setSink logLine

    Process.beforeExit λ⊤ → stranded ended

    Task.start (λ⊤ → begin body) λexit →
        Js.write ended True
        finish exit
        Task.shutdown 1000 λ_ → ⊤

    Node.done


-- The fiber's first act: until it ends, a process that leaves by any route
-- the platform did not foresee leaves 1. `main` has returned by now, so
-- nothing writes the code after this but the fiber's end.
begin : (⊤ → Program) → Program
begin body =
    Process.setExitCode 1
    body ⊤


-- Node's loop is about to empty: no timer, socket or other handle can run
-- anything again. If `run`'s fiber has not ended it never will, so say so
-- and leave the exit code at 1. Nothing is scheduled — work queued here
-- would run the loop again — and no cleanup is run.
stranded : Js.Ref Bool → ⊤
stranded ended =
    if Js.read ended then
        ⊤
    else
        Js.write ended True
        Process.setExitCode 1
        Process.writeError stuck


stuck : String
stuck =
    "beni: the program cannot go on: every fiber is waiting for something that can never happen.\n"


-- `Log`'s sink on Node: one `logfmt` line per entry on standard error,
-- written at once. A write that fails, to a closed pipe say, is an `error`
-- event of `process.stderr` that nothing handles, so the program stops:
-- an unknown failure crashes (`CLAUDE.md` rule 9).
logLine : Log.Entry → ⊤
logLine entry = Process.writeError "${Log.logfmt entry}\n"


-- How the fiber ended: consume the same typed Program as the entry runtime.
finish : Exit Program → ⊤
finish exit =
    case exit of
        Task.Done program →
            out = Node.output program
            if out ≠ "" then Process.writeOut out
            Process.setExitCode (Node.exitCode program)

        Task.Cancelled →
            Process.setExitCode 130


--| Wait `ms` milliseconds on the calling fiber's clock: `Task.sleep`. Only
--| the fiber that sleeps waits; the others run. `0` lets every other ready
--| fiber run first.
pub sleep : Int → ⊤
sleep ms = Task.sleep (Duration.millis ms)


--| Why a file could not be read: one constructor for each failure Node
--| documents. Any other failure is a defect and ends the program.
pub type FileError
    = NotFound
    | PermissionDenied
    | IsADirectory
    | NotADirectory
    | TooManyOpenFiles
    | SymlinkLoop
    | NameTooLong
    | InvalidPath
    | TooLarge


--| Read a UTF-8 text file without blocking other fibers: `Ok` with its
--| text, or `Err` with why it could not be read.
--|
--| - `NotFound`: there is no such file, or a directory on its path is
--|   missing.
--| - `PermissionDenied`: the program may not read it.
--| - `IsADirectory`: it is a directory.
--| - `NotADirectory`: something on its path that should be a directory
--|   is a file.
--| - `TooManyOpenFiles`: the process, or the system, has no file
--|   descriptor to spare.
--| - `SymlinkLoop`: its path has too many symbolic links to follow.
--| - `NameTooLong`: its path, or a name on it, is too long.
--| - `InvalidPath`: the path holds a NUL character, which no file name
--|   can.
--| - `TooLarge`: it is larger than any string can hold.
pub readFile : String → Result FileError String
readFile path = Task.callback λresume → startRead path resume


--| What a directory entry is, as the directory reports it. A symbolic link
--| is not followed: it is a `Symlink` whatever it points at.
pub type EntryKind
    = File
    | Directory
    | Symlink
    | Other


--| One entry of a directory: its own name, without the directory's path.
pub type alias Entry =
    name : String
    kind : EntryKind


--| List a directory without blocking other fibers: `Ok` with its entries, or
--| `Err` with why it could not be listed.
--|
--| The entries are sorted by `name`, ascending, by the bytes of its UTF-8
--| encoding (code point order), so the listing is the same on every file
--| system and every run. `.` and `..` are not listed. A name that is not
--| valid UTF-8 has U+FFFD in place of each bad byte.
--|
--| - `NotFound`: there is no such directory, or a directory on its path is
--|   missing.
--| - `PermissionDenied`: the program may not read it.
--| - `NotADirectory`: it, or something on its path that should be a
--|   directory, is a file.
--| - `TooManyOpenFiles`: the process, or the system, has no file
--|   descriptor to spare.
--| - `SymlinkLoop`: its path has too many symbolic links to follow.
--| - `NameTooLong`: its path, or a name on it, is too long.
--| - `InvalidPath`: the path holds a NUL character, which no file name
--|   can.
--|
--| `IsADirectory` and `TooLarge` are never the answer here.
pub readDir : String → Result FileError (List Entry)
readDir path = Task.callback λresume → startReadDir path resume


startReadDir : String, Resume (Result FileError (List Entry)) → (⊤ → ⊤)
startReadDir path resume =
    cancelled = Js.ref False
    Promise.observe (Fs.readDir path)
        (λentries →
            if not (Js.read cancelled) then
                listed = List.map entries entryOf
                Task.resume resume (Ok (List.sortBy listed .name))
        )
        λerror →
            case fileError False error of
                Just known →
                    if not (Js.read cancelled) then Task.resume resume (Err known)
                Nothing →
                    Rejection.raise error
    λ⊤ → Js.write cancelled True


entryOf : Dirent.NodeDirent → Entry
entryOf native =
    { name = Dirent.name native
    , kind =
        if Dirent.isFile native then
            File
        else if Dirent.isDirectory native then
            Directory
        else if Dirent.isSymbolicLink native then
            Symlink
        else
            Other
    }


-- The controller and promise keep their native types throughout the wait.
startRead : String, Resume (Result FileError String) → (⊤ → ⊤)
startRead path resume =
    abort = Abort.create ⊤
    signal = Abort.signal abort
    Promise.observe (Fs.readUtf8 path signal)
        (λtext → Task.resume resume (Ok text))
        (rejected signal resume _)
    λ⊤ → Abort.abort abort


rejected : Signal.AbortSignal, Resume (Result FileError String), Rejection.Rejection → ⊤
rejected signal resume error =
    if Signal.aborted signal && Rejection.name error == "AbortError" then
        ⊤
    else
        case fileError True error of
            Just known →
                Task.resume resume (Err known)
            Nothing →
                Rejection.raise error


-- Only documented file-operation failures become data. Unknown reasons are
-- rethrown unchanged, including when the waiting fiber was cancelled.
fileError : Bool, Rejection.Rejection → Maybe FileError
fileError reading error =
    case Rejection.code error of
        Nothing →
            Nothing
        Just code →
            case code of
                "ENOENT" →
                    Just NotFound
                "EACCES" →
                    Just PermissionDenied
                "EPERM" →
                    Just PermissionDenied
                "EISDIR" →
                    if reading then Just IsADirectory else Nothing
                "ENOTDIR" →
                    Just NotADirectory
                "EMFILE" →
                    Just TooManyOpenFiles
                "ENFILE" →
                    Just TooManyOpenFiles
                "ELOOP" →
                    Just SymlinkLoop
                "ENAMETOOLONG" →
                    Just NameTooLong
                "ERR_INVALID_ARG_VALUE" →
                    Just InvalidPath
                "ERR_FS_FILE_TOO_LARGE" →
                    if reading then Just TooLarge else Nothing
                "ERR_STRING_TOO_LONG" →
                    if reading then Just TooLarge else Nothing
                _ →
                    Nothing
