--! The Node platform: one output string and an exit code. Programs are
--! opaque beni values, consumed by the platform's typed entry runtime.

--| What `main` is. A program says what to write to standard output and what
--| exit code to leave behind, and the platform does both.
pub opaque type Program
    = Program Int String


--| Write one line to standard output and exit 0.
pub print : String → fresh Program
print line = Program 0 (line ++ "\n")


--| Write each string as its own line and exit 0.
pub printLines : borrowed List String → fresh Program
printLines lines = Program 0 (if List.isEmpty lines then "" else String.join lines "\n" ++ "\n")


--| Write one line and exit with the code you give it.
pub exitWith : String, Int → fresh Program
exitWith line code = Program code (line ++ "\n")


--| Write nothing and exit 0.
pub done : Program
done = Program 0 ""


-- Platform-private readers; the entry runtime and Io use the same protocol.
pub output : Program → String
output (Program _ text) = text


pub exitCode : Program → Int
exitCode (Program code _) = code
