--! The HTML vocabulary (`docs/design/boundary.md` §9.1, §9.3;
--! `docs/design/language.md` §11.14): which elements, attributes and events
--! markup may write, the markup type `Html msg`, and the markup primitives
--! `text` and `map`.
--!
--! It is also the SVG vocabulary (`boundary.md` §9.9): elm/svg's `Svg`,
--! `Svg.Attributes` and `Svg.Events` folded into this one module, as
--! elm/html's three modules are, since a tag resolves in one vocabulary
--! with no import. SVG markup is `Html msg`, as Elm's `Svg msg` is its
--! `Html msg`; an element, attribute or event is written with its SVG name
--! (`<text>`, `stroke-width`, `viewBox`).
--!
--! `html` is a platform that is only depended on: it declares no `program`
--! and no markup lowering. `node` and `browser` depend on it and re-export
--! this module, so a view module is checked against ONE vocabulary and ONE
--! `Html` type and builds under both. The facts are data for the lowering
--! that renders them; the checker reads `void`, `on`, the value and payload
--! types, `via`, `classes`, `styles` and `raw`.
--!
--! There is no `script` element: a page loads its scripts through its
--! platform, never through a `view`, so nothing a view holds can become
--! one (`docs/design/language.md` §11.14).

import Js


--| Markup whose handlers produce messages of type `msg`. Its representation
--| is the build's markup lowering's, which is why no `foreign` of this
--| platform may build or read one.
pub foreign type Html msg


--| The event object a handler is handed when its event names no `via`.
pub crossing foreign type Event


--| The text, as a text hole shows it: `Html.text s` and `<>{s}</>` render
--| alike.
pub markup text : String → Html msg


--| The same markup, with every message its handlers produce passed through
--| the function before it is sent. Nested maps apply innermost first.
pub markup map : Html a, (a → b) → Html b


--| The value of the form control an event came from.
pub foreign impure targetValue : Event → String


--| Whether the checkbox an event came from is checked.
pub foreign impure targetChecked : Event → Bool


-- What a handler reads of the event it is handed (`boundary.md` §9.8.10).
-- Each is the DOM property of the same name, read while the event is
-- dispatched; one the event does not have reads as `""` or `False`, so a
-- click's `key` is `""`. Written over `Js`, so a read is the property
-- access and nothing else.

--| The key of a keyboard event, as the DOM names it: the character it
--| types (`"a"`, `"A"`, `" "`) or the key's name (`"Enter"`, `"Escape"`,
--| `"ArrowUp"`, `"Backspace"`). `""` for any other event.
--|
--|     onKeyDown={λevent → if Html.key event == "Enter" then Add else Ignored}
pub key : Event → String
key event = stringProp event "key"


--| The physical key of a keyboard event, whatever the layout types with
--| it: `"KeyA"`, `"Enter"`, `"Digit1"`. `""` for any other event.
pub code : Event → String
code event = stringProp event "code"


--| Whether Control was held during a keyboard or mouse event.
pub ctrlKey : Event → Bool
ctrlKey event = boolProp event "ctrlKey"


--| Whether Shift was held during a keyboard or mouse event.
pub shiftKey : Event → Bool
shiftKey event = boolProp event "shiftKey"


--| Whether Alt (Option on a Mac) was held during a keyboard or mouse event.
pub altKey : Event → Bool
altKey event = boolProp event "altKey"


--| Whether Meta (Command on a Mac, the Windows key elsewhere) was held
--| during a keyboard or mouse event.
pub metaKey : Event → Bool
metaKey event = boolProp event "metaKey"


--| Stop the browser doing what the event would do by default — a key
--| typing into a field, a link being followed — and return. A handler runs
--| while its event is dispatched, so calling this in one takes effect; a
--| subscription's value arrives later, when it is too late.
--|
--|     onKeyDown={λevent →
--|         if Html.key event == "Tab" then
--|             Html.preventDefault event
--|             Indent
--|         else
--|             Ignored}
pub preventDefault : Event → ⊤
preventDefault event = Js.to (Js.call (Js.from event) "preventDefault" [])


-- What a pointer handler reads (`boundary.md` §9.8.20). A pointer event
-- is handed as a `Pointer`, not an `Event`: its extractor runs while the
-- event is dispatched to the handler's own element, so the position in
-- that element's box is taken then, and stays right after the dispatch.

--| A pointer event — a mouse, a pen or a touch — as a pointer handler is
--| handed it.
pub crossing foreign type Pointer


-- What a pointer event's own listener hands its extractor: the event.
-- Not `pub`, and no event hands a handler one, so no program can call
-- `pointer`.
foreign type Dispatched


-- The extractor of every pointer event: the event, and its position in
-- the box of the element whose listener runs (`currentTarget`). Called on
-- another event, that element could be the document, which has no box.
-- `pub` only because a lowering finds an extractor among the module's
-- `pub` values (issue #532).
pub foreign impure pointer : Dispatched → Pointer


--| The pointer's identity: the same number from its first event to its
--| `onPointerUp` or `onPointerCancel`, and a different one for each finger
--| on a touch screen.
pub pointerId : Pointer → Int
pointerId p = Js.to (Js.get (Js.from (pointerEvent p)) "pointerId")


--| What the pointer is: `"mouse"`, `"pen"` or `"touch"`, or `""` when the
--| browser cannot say.
pub pointerType : Pointer → String
pointerType p = stringProp (pointerEvent p) "pointerType"


--| Whether the pointer is the primary one of its type: the mouse, or the
--| first finger of a touch.
pub isPrimary : Pointer → Bool
isPrimary p = boolProp (pointerEvent p) "isPrimary"


--| The pointer's position from the left edge of the viewport, in CSS
--| pixels.
pub clientX : Pointer → Float
clientX p = Js.to (Js.get (Js.from (pointerEvent p)) "clientX")


--| The pointer's position from the top edge of the viewport, in CSS
--| pixels.
pub clientY : Pointer → Float
clientY p = Js.to (Js.get (Js.from (pointerEvent p)) "clientY")


--| The pointer's position from the left edge of the border box of the
--| element whose handler runs, in CSS pixels, when the event was
--| dispatched. Negative, or past the box's width, when a touch has moved
--| out of the element.
--|
--|     <div style="touch-action: none" onPointerMove={λp → Aim (Html.localX p) (Html.localY p)}>
pub localX : Pointer → Float
localX p = Js.to (Js.get (Js.from p) "x")


--| The pointer's position from the top edge of that box, in CSS pixels.
pub localY : Pointer → Float
localY p = Js.to (Js.get (Js.from p) "y")


--| The pointer event as an `Event`, for the readers of an `Event`: the
--| modifier keys and `preventDefault`.
pub pointerEvent : Pointer → Event
pointerEvent p = Js.to (Js.get (Js.from p) "ev")


stringProp : Event, String → String
stringProp event name =
    v = Js.get (Js.from event) name
    if Js.isNullish v then "" else Js.to v


boolProp : Event, String → Bool
boolProp event name = Js.same (Js.get (Js.from event) name) (Js.from True)


