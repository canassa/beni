-- Events. A `delegated` event bubbles, so a lowering may listen for it once.
-- The pointer events bubble too, but are not `delegated`: their extractor
-- reads the box of the element whose own listener runs (§9.8.20).

pub event "onBlur" : Event


pub event "onChange" delegated via targetValue : String


pub event "onCheck" name "change" delegated via targetChecked on "input" : Bool


pub event "onClick" delegated : Event


