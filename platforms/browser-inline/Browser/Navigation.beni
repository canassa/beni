--! The page's address (`docs/design/boundary.md` §9.8.13 (c), §9.8.17;
--! `browser-inline.md` §10): `browser`'s `Browser.Navigation` on this
--! platform, with its signatures, so one source builds on both. Reading
--! the address — `currentUrl`, `onUrlChange` — needs nothing; changing it
--! goes through the page's `Key`.
--!
--! Elm's names are commands that take values — `pushUrl`, `replaceUrl`,
--! `back`, `forward`, `load`, `reload` — each a `Cmd.perform` whose body
--! does not wait, so it runs after the page shows the model, in the same
--! dispatch (`browser-inline.md` §4). Each sends its last argument's
--! message only when the change was refused: a typed failure is never
--! dropped (CLAUDE.md rule 9). Each has a direct form that answers at
--! once: `push`, `replace`, `goBack`, `goForward`, `loadPage`,
--! `reloadPage`. `eachUrlRequest` and `eachUrlChange` are the direct forms
--! of the two subscriptions, run in a command's fiber.
--!
--!     ClickedLink request →
--!         case request of
--!             Browser.Internal url →
--!                 ( model, Navigation.pushUrl model.key (Url.toString url) Refused )
--!
--!             Browser.External href →
--!                 ( model, Navigation.load href Refused )
--!
--! Every change `push`, `replace`, `goBack` and `goForward` make is
--! announced to every follower of the address on the page, whoever made
--! it, so no program falls out of step with the address.
--!
--! The host work and the listeners are `browser-base`'s `Browser.Address`,
--! shared with `browser`'s facade (`browser-capability-base.md` §3). A
--! listener enters the program's guard through the entry its subscription
--! was installed under (`Listen.callback`), so it is inert once the page
--! has stopped.

import Browser
import Browser.Address as Address
import Cmd exposing (Cmd)
import Inline
import Js
import Listen
import Sub exposing (Sub)
import Url exposing (Url)


--| What changes the page's address: one per page, handed out by `key`. A
--| model may hold it.
pub type alias Key =
    Inline.NavigationKey


--| The page's key.
pub key : ⊤ → Key
key ⊤ = Inline.navigationKey ⊤


--| Why the address did not change: the URL does not resolve against the
--| page (or would run script), it names another origin, or the browser
--| refused the change as too frequent.
pub type Error
    = BadUrl String
    | CrossOrigin String
    | Throttled


--| The page's address, or `Nothing` when it is not an `http` or `https`
--| one (a page opened from a file).
--|
--|     init =
--|         case Browser.Navigation.currentUrl ⊤ of
--|             Just url → filterOf url.fragment
--|             Nothing → All
pub currentUrl : ⊤ → Maybe Url
currentUrl ⊤ = Address.currentUrl ⊤


--| Add an entry to the browser's history with the URL, resolved against
--| the page, and tell every follower of the address, when the command
--| runs. The page is not reloaded. `refused error` is sent only when the
--| change did not happen.
--|
--|     ClickedLink (Browser.Internal url) →
--|         ( model, Navigation.pushUrl model.key (Url.toString url) Refused )
pub pushUrl : Key, String, sync (Error → msg) → Cmd msg
pushUrl k url refused = Cmd.perform λsend → answer (push k url) refused send


--| Replace the current entry of the browser's history with the URL, as
--| `pushUrl` adds one.
pub replaceUrl : Key, String, sync (Error → msg) → Cmd msg
replaceUrl k url refused = Cmd.perform λsend → answer (replace k url) refused send


--| Go back `n` entries in the history, as `goBack` does, when the command
--| runs.
pub back : Key, Int, sync (Error → msg) → Cmd msg
back k n refused = Cmd.perform λsend → answer (goBack k n) refused send


--| Go forward `n` entries in the history, as `goForward` does, when the
--| command runs.
pub forward : Key, Int, sync (Error → msg) → Cmd msg
forward k n refused = Cmd.perform λsend → answer (goForward k n) refused send


--| Leave the page for the URL, as `loadPage` does, when the command runs.
pub load : String, sync (Error → msg) → Cmd msg
load url refused = Cmd.perform λsend → answer (loadPage url) refused send


--| Load the page again, when the command runs. It takes `⊤`: making a
--| command is impure, and a top-level value made by an impure call cannot
--| keep the type variable `msg` (`docs/design/checker-v2.md` §8.4).
pub reload : ⊤ → Cmd msg
reload ⊤ = Cmd.perform λ_ → reloadPage ⊤


-- A change made when the command ran, and its refusal sent.
answer : Result Error ⊤, sync (Error → msg), (msg → ⊤) → ⊤
answer result refused send =
    case result of
        Ok ⊤ →
            ⊤

        Err error →
            send (refused error)


--| The direct form of `pushUrl`: add an entry to the browser's history
--| with the URL, resolved against the page, and tell every follower of
--| the address. The page is not reloaded.
pub push : Key, String → Result Error ⊤
push _ url = Address.push faults url


--| The direct form of `replaceUrl`: replace the current entry of the
--| browser's history with the URL, and tell every follower of the address.
pub replace : Key, String → Result Error ⊤
replace _ url = Address.replace faults url


--| The direct form of `back`: go back `n` entries in the history. The
--| address changes when the browser has gone back, and followers hear it
--| then; `n = 0` does nothing.
pub goBack : Key, Int → Result Error ⊤
goBack _ n = Address.go faults (negate n)


--| The direct form of `forward`: go forward `n` entries in the history,
--| as `goBack` goes back.
pub goForward : Key, Int → Result Error ⊤
goForward _ n = Address.go faults n


--| The direct form of `load`: leave the page for the URL, resolved
--| against the page. An address that does not resolve, and a
--| `javascript:` one, which would run text as script, is `BadUrl`.
pub loadPage : String → Result Error ⊤
loadPage url = Address.load faults url


--| The direct form of `reload`: load the page again.
pub reloadPage : ⊤ → ⊤
reloadPage ⊤ = Address.reload ⊤


-- The subscriptions' keys, one type each, so a page that follows only the
-- address compares no key of the other.
type Follow
    = UrlChange


type Requests
    = LinkClick


--| Call `f` with each click on a link the page should handle itself, for
--| as long as the calling fiber runs: the direct form of `onUrlRequest`.
--| It never returns.
pub eachUrlRequest : (Browser.UrlRequest → ⊤) → ⊤
eachUrlRequest f = Listen.each requests f


--| Each click on a link the page should handle itself: `Internal` with
--| its `Url` for a link to the page's own protocol, host and port,
--| `External` with its `href` for any other. One listener on the window
--| decides, while the click is dispatched and after every handler on the
--| page has run, and prevents the host from following the link when it
--| is a request: a plain click (the main button, no Ctrl, Meta, Shift or
--| Alt) whose default nothing prevented, on an `<a href>` with no
--| `download` and a `target` that is empty or `_self`. Any other click is
--| the host's. It covers the whole document, markup outside the program's
--| mount included.
pub onUrlRequest : (Browser.UrlRequest → msg) → Sub msg
onUrlRequest tag =
    Sub.on LinkClick (λsend → listenOne "click" λevent → linked send (Address.link event)) tag


-- The listener both forms run (`Browser.Address.requests`), its link as
-- this platform's `Browser.UrlRequest`.
requests : sync (Browser.UrlRequest → ⊤) → (⊤ → ⊤)
requests send = Address.requests λl → linked send (Just l)


linked : sync (Browser.UrlRequest → ⊤), Maybe Address.Link → ⊤
linked send l =
    case l of
        Just (Address.Internal url) →
            send (Browser.Internal url)

        Just (Address.External href) →
            send (Browser.External href)

        Nothing →
            ⊤


--| Call `f` with the page's new address each time it changes, for as long
--| as the calling fiber runs: the direct form of `onUrlChange`. It never
--| returns; cancelling the fiber removes the listener.
pub eachUrlChange : (Url → ⊤) → ⊤
eachUrlChange f = Listen.each Address.follow f


--| The page's new address each time it changes: the back and forward
--| buttons, a link to a fragment followed, and every `pushUrl` and
--| `replaceUrl` on the page. An address that is not a `Url` sends nothing.
pub onUrlChange : (Url → msg) → Sub msg
onUrlChange tag =
    Sub.on
        UrlChange
        (λsend → listen "popstate" Address.announcement λ_ → sendUrl send (currentUrl ⊤))
        tag


sendUrl : sync (Url → ⊤), Maybe Url → ⊤
sendUrl send url =
    case url of
        Just u →
            send u

        Nothing →
            ⊤


-- One listener on the window for the events of two names, so an event of
-- one never overtakes an earlier one of the other, and what removes it.
-- `popstate`, which a browser fires for a fragment followed and for the
-- back and forward buttons, and this module's own announcement of a push
-- or a replace, are heard in the order they fire; the address is read when
-- each fires.
listen : String, String, sync (Js.Value → ⊤) → (⊤ → ⊤)
listen name other f =
    host = Js.global "window"
    handler = live f
    _ = Js.call host "addEventListener" [ Js.from name, handler ]
    _ = Js.call host "addEventListener" [ Js.from other, handler ]

    λ⊤ →
        _ = Js.call host "removeEventListener" [ Js.from name, handler ]
        Js.to (Js.call host "removeEventListener" [ Js.from other, handler ])


-- One listener on the window, in the bubbling phase, and what removes it.
listenOne : String, sync (Js.Value → ⊤) → (⊤ → ⊤)
listenOne name f =
    host = Js.global "window"
    handler = live f
    _ = Js.call host "addEventListener" [ Js.from name, handler ]
    λ⊤ → Js.to (Js.call host "removeEventListener" [ Js.from name, handler ])


-- The host's listener: nothing once the page has stopped. A defect stops
-- the page without removing its listeners, and a stopped page must not
-- keep preventing the host from following a link (`boundary.md` §9.8.14).
live : sync (Js.Value → ⊤) → Js.Value
live f = Js.from λevent → if Inline.stopped ⊤ then ⊤ else f event


-- This module's `Error`, as `Browser.Address` makes a refusal.
faults : Address.Faults Error
faults = { badUrl = BadUrl, crossOrigin = CrossOrigin, throttled = Throttled }
