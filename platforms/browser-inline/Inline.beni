--! The `browser-inline` platform's runtime module, `Inline`
--! (`docs/design/browser-inline.md`): the dispatch guard every entry into
--! program code goes through, the queue of sends made while one runs,
--! `run`, which mounts the page's program inside the guard, and `stop`, the
--! page's unmount (`boundary.md` §9.4.5, amended 2026-10-17). Written in
--! beni over core's `Js`, and the platform's runtime module (`boundary.md`
--! §9.2, *A runtime module*): a page ships only what it reaches.

import Cmd exposing (Cmd)
import Js
import Url exposing (Url)


type alias V =
    Js.Value


-- ---- The dispatch guard -------------------------------------------------

-- A throw escaped program code, or the page called `stop`: nothing of the
-- program runs again.
dead : Js.Ref Bool
dead = Js.ref False


-- A dispatch is running: a send made now waits for it.
running : Js.Ref Bool
running = Js.ref False


-- The sends made while a dispatch ran, as function, argument pairs in the
-- order they were made; null until the first.
queue : Js.Ref V
queue = Js.ref Js.null


--| `(f, x, read)`: one entry into program code — a listener with its
--| event, a command's body, `run`'s mount. `f` is applied to `x`, or, when
--| `read` is given, to what `read` reads of the event `x`: an event's `via`
--| extractor, which is called first, while the event is dispatched
--| (`boundary.md` §9.8.20 (d), #559), even when the send waits. A send made
--| while another runs is queued and applied, in order, before that
--| dispatch ends, never re-entrantly (`boundary.md` §9.8.4, as amended
--| 2026-10-17); once the page has stopped it does nothing. There is no
--| `catch`: a throw passes through to the host, and stops the page — a
--| throw of `read` when the send waits too, which the host, not the code
--| that dispatched the event, would otherwise hear.
pub send : V, V, V → ⊤
send f x read =
    if not (Js.read dead) then
        nested = Js.read running
        Js.write running True
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                v = if Js.isUndefined read then x else Js.apply read [ x ]
                if nested then
                    if Js.isNull (Js.read queue) then
                        Js.write queue (Js.array [])
                    _ = Js.call (Js.read queue) "push" [ f, v ]
                    ⊤
                else
                    _ = Js.apply f [ v ]
                    drain ⊤
                Js.write ok True
            )
            λ⊤ →
                Js.write running nested
                if Js.read ok then ⊤ else defect ⊤


-- Apply every queued send, in the order they were made; one applied may
-- send more, which apply after them, in this dispatch.
drain : ⊤ → ⊤
drain ⊤ =
    if Js.isNull (Js.read queue) then
        ⊤
    else
        q = Js.read queue
        Js.write queue Js.null
        applyFrom q 0
        drain ⊤


applyFrom : V, Int → ⊤
applyFrom q i =
    -- A send applied may stop the page (`stop`, a defect): nothing queued
    -- behind it runs.
    if i < Js.to (Js.get q "length") && not (Js.read dead) then
        _ = Js.apply (Js.at q i) [ Js.at q (i + 1) ]
        applyFrom q (i + 2)


-- A throw ended a dispatch: the page stops, `dead` first, and drops what
-- was queued. A development build shows the crash screen; a release build
-- has no code for one, and the host reports the throw.
defect : ⊤ → ⊤
defect ⊤ =
    wasDead = Js.read dead
    Js.write dead True
    Js.write queue Js.null
    if Js.development ⊤ && not wasDead then
        crashScreen ⊤


-- An overlay above the page, which it leaves in place to inspect: the
-- error's text arrives with the host's report of the throw, which reaches
-- the window after the guard's `finally`.
crashScreen : ⊤ → ⊤
crashScreen ⊤ =
    document = Js.global "document"
    screen = Js.call document "createElement" [ Js.from "div" ]

    _ =
        Js.call screen "setAttribute"
            [ Js.from "style"
            , Js.from
                "position:fixed;inset:0;z-index:2147483647;overflow:auto;margin:0;padding:24px;background:#fff;color:#a00;font:14px/1.5 monospace;white-space:pre-wrap"
            ]

    Js.set
        screen
        "textContent"
        (Js.from
            "This program has stopped.\n\nSomething it ran threw an exception, so its state can no longer be trusted and nothing more of it runs. The exception is below, and in the console with its stack.\n\n"
        )

    _ = Js.call (Js.get document "body") "appendChild" [ screen ]

    report =
        λevent →
            error = Js.get event "error"
            message : String
            message =
                Js.to
                    (Js.apply (Js.global "String")
                        [ if Js.isNullish error then Js.get event "message" else error ]
                    )
            shown : String
            shown = Js.to (Js.get screen "textContent")
            Js.set screen "textContent" (Js.from (shown ++ message))

    Js.to
        (Js.call (Js.global "window") "addEventListener"
            [ Js.from "error", Js.from report, Js.from { once = True } ]
        )


-- ---- Mounting -----------------------------------------------------------

--| `(program)`: the page's one program — the mount the lowering compiled,
--| a function of the id of the element it mounts at — mounted inside one
--| dispatch, so a throw while it mounts, a missing element included,
--| stops the page as any defect does.
pub run : V → ⊤
run program = send program Js.undefined Js.undefined


--| `(id)`: the element a program mounts at, the one `id` names or
--| `document.body`. A development build marks it and says in prose what is
--| wrong with one that is missing or already holds a program; a release
--| build does neither, and a missing element fails inside the guard
--| (`browser-inline.md` §6).
pub root : V → V
root id =
    -- `document` is read where it is used: a binding of a host read is
    -- kept by the release optimiser, never folded into its one use.
    at =
        if Js.isUndefined id then
            Js.get (Js.global "document") "body"
        else
            Js.call (Js.global "document") "getElementById" [ id ]

    if Js.development ⊤ then
        if Js.isNull at || not (Js.isUndefined (Js.get at "$$root")) then
            shown : String
            shown = Js.to id
            fault
                "cannot mount at ${shown}: no element has that id, or a program is mounted there already"
        Js.set at "$$root" (Js.from True)
    at


fault : String → ⊤
fault message = Js.throw (Js.construct (Js.global "Error") [ Js.from message ])


-- ---- Commands (`boundary.md` §9.8.4, amended 2026-10-17) ----------------

--| `(cmd, dispatch)`: a command's bodies, in order, queued behind the
--| dispatch that returned it — so each runs after its write pass, in the
--| same dispatch — each message a body sends queued in turn and handed to
--| `dispatch`, the program's.
pub commands : Cmd V, V → ⊤
commands cmd dispatch = List.foldl (Cmd.bodies cmd) ⊤ λbody _ →
    send (Js.from λ_ → body λmsg → send dispatch (Js.from msg) Js.undefined) Js.null Js.undefined


-- ---- Documents and applications (`browser-inline.md` §10) ---------------

--| `(⊤)`: the address an application's `init` is handed, read inside the
--| mount's guard. A page whose address is not an `http` or `https` one
--| (opened from a file) has no route, and stops there as a defect
--| (`boundary.md` §9.8.13 (d)).
pub address : ⊤ → Url
address ⊤ =
    case Url.fromString (Js.to (Js.get (Js.global "location") "href")) of
        Just url →
            url

        Nothing →
            Js.throw
                (Js.construct (Js.global "Error")
                    [ Js.from
                        "Tea.application needs an http or https address, and this page has none: it was opened from a file. Serve it over HTTP, or use Tea.document and Browser.Navigation.currentUrl, whose Nothing such a page can handle."
                    ]
                )


--| `(origin, route)`: the `Url` of a route of a prerendered page — the
--| project's origin and base, `origin`, with the route after it, and no
--| query or fragment (`prerender.md` §7.3). The build and the browser make
--| it the same way, so their `init`s are handed the same value. A route the
--| build checked always makes one; anything else is a defect.
pub routeUrl : String, String → Url
routeUrl origin route =
    case Url.fromString (origin ++ route) of
        Just url →
            url

        Nothing →
            Js.throw
                (Js.construct (Js.global "Error")
                    [ Js.from "a prerendered page's route ${route} is not a URL below ${origin}" ]
                )


--| `(origin)`: the `Url` a hydrating application's `init` is handed: the
--| route the prerendered page carries in its `data-beni`, and on a page
--| with no prerendered view, the page's own address (`prerender.md` §7.3).
pub pageUrl : String → Url
pageUrl origin =
    unit = Js.call (Js.global "document") "querySelector" [ Js.from "[data-beni]" ]
    if Js.isNull unit then
        address ⊤
    else
        routeUrl origin (Js.to (Js.call unit "getAttribute" [ Js.from "data-beni" ]))


--| `(url)`: after the first render of a hydrating application, the page's
--| address, when it is not `url`, the one `init` was handed: announced, so
--| `onUrlChange` sends it as a message (`prerender.md` §7.3). An address
--| that is the route's file name — the route with `.html` after it, or a
--| route ending in `/` with `index.html` after it — is first replaced by
--| the route, its query and fragment kept.
pub arrived : Url → ⊤
arrived url =
    location = Js.global "location"
    path : String
    path = Js.to (Js.get location "pathname")
    file = String.endsWith url.path "/" && path == url.path ++ "index.html"
    if file || path == url.path ++ ".html" then
        search : String
        search = Js.to (Js.get location "search")
        hash : String
        hash = Js.to (Js.get location "hash")
        _ =
            Js.call (Js.global "history") "replaceState"
                [ Js.get (Js.global "history") "state"
                , Js.from ""
                , Js.from (url.path ++ search ++ hash)
                ]
        ⊤
    -- An address that is not a `Url` (a page opened from a file) is not
    -- sent: `onUrlChange` sends nothing for one either.
    if Url.fromString (Js.to (Js.get location "href")) ≠ Just url then
        -- `Browser.Navigation`'s announcement, which its `onUrlChange`
        -- listens to and answers with the address.
        _ =
            Js.call (Js.global "window") "dispatchEvent"
                [ Js.construct (Js.global "Event") [ Js.from "beni:navigate" ] ]
        ⊤


--| What changes the page's address: `Browser.Navigation.Key`, one per
--| page. It is declared here, where the runtime hands it to an
--| application's `init`, so that `Browser.Navigation` may import this
--| module and ask whether the page has stopped.
pub opaque type NavigationKey
    = Page


--| `(⊤)`: the page's navigation key, which an application's `init` is
--| handed.
pub navigationKey : ⊤ → NavigationKey
navigationKey ⊤ = Page


--| `(title)`: a document's title, written when it differs from the page's.
pub title : String → ⊤
title value =
    document = Js.global "document"
    if not (Js.same (Js.get document "title") (Js.from value)) then
        Js.set document "title" (Js.from value)


-- ---- The unmount (`boundary.md` §9.4.5, amended 2026-10-17) -------------

-- What undoes the mount: the function the lowering wrote, which removes
-- the program's root, its listeners and its timers, last added first.
undo : Js.Ref V
undo = Js.ref (Js.from nothing)


--| Whether a dispatch is running now: an event a listener hears then fires
--| inside it, synchronously, inside its guard. The contract: it answers for
--| a page that has not stopped, and says nothing of one that has — a caller
--| asks `stopped` first, as `Listen.on` does.
pub busy : ⊤ → Bool
busy ⊤ = Js.read running


--| Whether the page has stopped.
pub stopped : ⊤ → Bool
stopped ⊤ = Js.read dead


--| `(f)`: one piece the mount added registers what removes it; `stop`
--| runs them once, the last registered first.
pub own : V → ⊤
own f =
    before = Js.read undo
    Js.write
        undo
        (Js.from λ⊤ →
            _ = Js.apply f []
            Js.to (Js.apply before [])
        )


--| The page's unmount: nothing of the program runs after it, and what the
--| mount added to the page is taken out of it, once.
pub stop : ⊤ → ⊤
stop ⊤ =
    Js.write dead True
    Js.write queue Js.null
    f = Js.read undo
    Js.write undo (Js.from nothing)
    Js.to (Js.apply f [])


nothing : ⊤ → ⊤
nothing ⊤ = ⊤


-- ---- Bindings (`browser-inline.md` §8.2) --------------------------------

--| `(node, shown)`: a text binding — the node's text, written when it
--| differs from what the node shows. `shown` is a string: the lowering
--| writes a number as one (`browser-inline.md` §8.2).
pub text : V, V → ⊤
text node shown =
    if not (Js.same (Js.get node "textContent") shown) then
        Js.set node "textContent" shown


-- A control's property written with the model's value. A text control the
-- user is editing keeps its selection across a write that changes its
-- value (the owner, 2026-10-25): the offsets and direction read before,
-- set again after, each clamped to the new value's length. A control with
-- no selection (its `selectionStart` is null, or undefined on a `select`)
-- and one without the focus are written and left alone. A `value` the
-- control already shows is not written, and its selection is not touched.
writeProp : V, V, V → ⊤
writeProp el member v =
    caret = if Js.same member (Js.from "value") then Js.get el "selectionStart" else Js.undefined
    if Js.same member (Js.from "value") && Js.same (Js.get el member) v then
        ⊤
    else if
        Js.isNullish caret || not (Js.same (Js.get (Js.global "document") "activeElement") el)
    then
        Js.set el member v
    else
        caretEnd = Js.get el "selectionEnd"
        direction = Js.get el "selectionDirection"
        Js.set el member v
        length = Js.get (Js.get el "value") "length"
        math = Js.global "Math"
        _ =
            Js.call el "setSelectionRange"
                [ Js.call math "min" [ caret, length ]
                , Js.call math "min" [ caretEnd, length ]
                , direction
                ]
        ⊤


--| `(node, value, key)`: a property binding — the DOM property `key`, a
--| control's `value` when `key` is not given, written when it differs
--| from the node's live one, so a control the user edited shows the model.
pub prop : V, V, V → ⊤
prop node value key =
    name = if Js.isUndefined key then Js.from "value" else key
    if not (Js.same (Js.get node name) value) then
        writeProp node name value


--| `(node, hidden)`: an eager `when` — the node in the page, or, while
--| `hidden` is true, the empty text node it keeps in its place. The
--| lowering hands it the number of the arm the branch takes, or its
--| negation, as `hidden`: the shown arm is the one it is false for.
pub when : V, Bool → ⊤
when node hidden =
    held = Js.get node "$a"
    anchor =
        if Js.isUndefined held then
            made = Js.construct (Js.global "Text") []
            Js.set node "$a" made
            made
        else
            held
    -- `replaceWith` on a node out of the page does nothing.
    _ = Js.call (if hidden then node else anchor) "replaceWith" [ if hidden then anchor else node ]
    ⊤


--| `(node)`: the elements below `node` in document order, the table a
--| piece of another module's markup refers to its elements by
--| (`browser-inline.md` §8.4).
pub part : V → V
part node = Js.call node "querySelectorAll" [ Js.from "*" ]


--| `(node, f, kind, read)`: a listener of event `kind`, `click` when not
--| given, whose event enters the dispatch guard with `f` — through `read`,
--| the event's `via` extractor, when it has one (`send`).
pub on : V, V, V, V → ⊤
on node f kind read =
    _ =
        Js.call node "addEventListener"
            [ if Js.isUndefined kind then Js.from "click" else kind
            , Js.from λevent → send f event read
            ]
    ⊤


--| `(node, f, kind, arms, read)`: `on` for a handler inside eager arms, `kind`
--| always given. `arms` are the elements of those arms, outermost first, one
--| bare or an array: while one of them is hidden — its `when` anchor stands in
--| the page in its place — the event does nothing, not even enter the guard
--| (`browser-inline.md` §8.2, #466: an inactive arm has no active handler).
--| The outermost is asked first: an arm inside a hidden arm may never have
--| been written. It is apart from `on` so that a page with no handler in an
--| arm ships neither it nor the arm walk (#874).
pub onArm : V, V, V, V, V → ⊤
onArm node f kind arms read =
    _ =
        Js.call node "addEventListener"
            [ kind, Js.from λevent → if armsShown arms then send f event read ]
    ⊤


-- Whether `arms`, one element or an array of them, are in the page: no
-- anchor of theirs is.
armsShown : V → Bool
armsShown arms =
    if Js.instanceOf arms (Js.global "Array") then
        allShown arms 0
    else
        Js.isNull (Js.get (Js.get arms "$a") "parentNode")


allShown : V, Int → Bool
allShown arms i =
    if i == Js.to (Js.get arms "length") then
        True
    else if armsShown (Js.at arms i) then
        allShown arms (i + 1)
    else
        False


-- ---- Prerendered pages (`prerender.md` §4.3, §11) ----------------------

--| `(s)`: a text as an element's ordinary content holds it in HTML:
--| `&`, `<` and a carriage return written as references, so the text the
--| parser reads back is the text (`write-sets.md` §9.1). The prerender
--| tree's alone: a page ships none of it.
pub escape : V → V
escape s = replace (replace (replace s "&" "&amp;") "<" "&lt;") "\r" "&#13;"


--| `(s)`: `escape`, for the content of a `pre`, a `textarea` or a
--| `listing`, whose parser drops a newline at its start: a text that begins
--| with one gets one more in front.
pub escapePre : V → V
escapePre s =
    leading : Bool
    leading = Js.to (Js.call s "startsWith" [ Js.from "\n" ])
    if leading then Js.call (Js.from "\n") "concat" [ escape s ] else escape s


--| `(s)`: an attribute's value as a double-quoted value holds it:
--| `escape`, and `"` written as `&quot;`.
pub escapeAttribute : V → V
escapeAttribute s = replace (escape s) "\"" "&quot;"


replace : V, String, String → V
replace s from to = Js.call s "replaceAll" [ Js.from from, Js.from to ]


-- ---- Hydration (`prerender.md` §6) -------------------------------------

--| `(at, html, arms, tags)`: the hydrating mount of a prerendering build's
--| client (`prerender.md` §6.1–§6.4). It gives the unit's table: its top
--| element, then each of its descendants in document order, as the fresh
--| mount numbers them. On a page that holds the prerendered unit — the
--| element with `data-beni` — as a child of `at`, the page's elements are
--| taken over: the table merges them with the elements of each eager arm
--| the page hides, which a comment `<!--k-->` stands in place of, made
--| from `html`, the unit's string; the comment is then the arm's anchor.
--| `arms` is three numbers per arm, in the order of the arms' ordinals:
--| its element's index in the table, how many elements it holds, and its
--| parent's index. `tags` is the tag of each element of the table,
--| space-separated, every one checked in every build. A page that
--| does not hold what the program makes — a tag, a count, or a comment
--| that differs — is mounted fresh in the same task, the unit taken out
--| first, and a development build says why in a warning. A page with no
--| unit is mounted fresh. A unit that is not a child of `at` is a fault
--| in a development build, and is taken out and mounted fresh in a release
--| build. What undoes the mount, the top element's removal, is registered.
pub take : V, V, V, V → V
take at html arms tags =
    unit = Js.call (Js.global "document") "querySelector" [ Js.from "[data-beni]" ]

    adopted =
        if Js.isNull unit then
            Js.null
        else if Js.same (Js.get unit "parentNode") at then
            adopt at unit html arms tags
        else
            if Js.development ⊤ then
                id : String
                id = Js.to (Js.get at "id")
                where = if id == "" then "document.body" else id
                fault
                    "cannot take over the page at ${where}: the prerendered view is not inside the element the program mounts at"
            Js.null

    table =
        if Js.isNull adopted then
            if not (Js.isNull unit) then
                _ = Js.call unit "remove" []
                ⊤
            _ = Js.call at "insertAdjacentHTML" [ Js.from "beforeend", html ]
            tableOf (Js.get at "lastChild")
        else
            _ = Js.call unit "removeAttribute" [ Js.from "data-beni" ]
            adopted

    top = Js.at table 0
    own (Js.from λ⊤ → Js.to (Js.call top "remove" []))
    table


-- `[top, …top.querySelectorAll("*")]`: a fresh unit's table.
tableOf : V → V
tableOf top =
    table = Js.call (Js.global "Array") "from" [ Js.call top "querySelectorAll" [ Js.from "*" ] ]
    _ = Js.call table "unshift" [ top ]
    table


-- The table of the page's unit, or null when the page is not what the
-- program makes there (`prerender.md` §6.4).
adopt : V, V, V, V, V → V
adopt at unit html arms tags =
    page = Js.call unit "querySelectorAll" [ Js.from "*" ]
    table = Js.array [ unit ]
    taken = Js.ref 0
    made = Js.ref Js.null
    names = Js.call tags "split" [ Js.from " " ]
    count : Int
    count = Js.to (Js.get names "length")

    -- The arm whose comment is out of place, or -1.
    misplaced : Int
    misplaced =
        if Js.to (Js.get arms "length") == 0 then
            -1
        else
            hiddenArms
                (Js.call (Js.global "document") "createTreeWalker" [ unit, Js.from 128 ])
                { at = at
                , html = html
                , arms = arms
                , table = table
                , page = page
                , taken = taken
                , made = made
                }
                (-1)

    filled = misplaced < 0 && fill table page taken (count - 1)

    -- A tag that differs is named first, in the table as far as it was
    -- filled: an element a host inserted, removed or replaced is where the
    -- page stops being the program's.
    if tagsDiffer table names 0 then
        Js.null
    else if misplaced ≥ 0 then
        if Js.development ⊤ then
            shown = String.fromInt misplaced
            warn "the comment <!--${shown}--> does not stand where the program's arm ${shown} does"
        Js.null
    else if not filled then
        if Js.development ⊤ then
            warn "the page holds fewer elements than the program makes"
        Js.null
    else if Js.read taken < Js.to (Js.get page "length") then
        if Js.development ⊤ then
            extra : String
            extra = Js.to (Js.get (Js.at page (Js.read taken)) "localName")
            warn
                "the page holds more elements than the program makes, the first of them a <${extra}>"
        Js.null
    else
        table


-- What `hiddenArms` reads and writes as it walks: the mount element and the
-- unit's string, from which a hidden arm's elements are made, once
-- (`made`); the arms; the table it fills; and the page's elements, of
-- which `taken` are in the table.
type alias Walk =
    at : V
    html : V
    arms : V
    table : V
    page : V
    taken : Js.Ref Int
    made : Js.Ref V


-- Each comment of the unit that names an arm, in document order, after
-- the comment of the arm `last`: the page's elements before the arm into
-- the table, then the arm's own, made from the unit's string, its
-- element's anchor the comment. -1 when every comment stands where its arm
-- does; otherwise the arm of the first that does not, or that names an arm
-- that does not follow the last one outside it.
hiddenArms : V, Walk, Int → Int
hiddenArms walker w last =
    c = Js.call walker "nextNode" []
    if Js.isNull c then
        -1
    else
        data = Js.get c "data"
        k : Int
        k = Js.to (Js.apply (Js.global "Number") [ data ])
        named = Js.same (Js.apply (Js.global "String") [ Js.from k ]) data
        if not named then
            hiddenArms walker w last
        else if k ≤ last || 3 * k ≥ Js.to (Js.get w.arms "length") then
            k
        else
            index : Int
            index = Js.to (Js.at w.arms (3 * k))
            holds : Int
            holds = Js.to (Js.at w.arms (3 * k + 1))
            if
                index < Js.to (Js.get w.table "length")
                    || not (fill w.table w.page w.taken (index - 1))
            then
                k
            else if
                not
                    (Js.same
                        (Js.get c "parentNode")
                        (Js.at w.table (Js.to (Js.at w.arms (3 * k + 2))))
                    )
                    || not (between c w.page (Js.read w.taken))
            then
                k
            else
                made = madeOf w
                arm = Js.at made (index - 1)
                _ = Js.call arm "remove" []
                Js.set arm "$a" c
                push w.table made (index - 1) (index - 1 + holds)
                hiddenArms walker w k


-- Whether comment `c` stands after the page's element `k - 1` and before
-- its element `k`, in document order.
between : V, V, Int → Bool
between c page k =
    after = k == 0 || follows (Js.at page (k - 1)) c
    after && (k == Js.to (Js.get page "length") || follows c (Js.at page k))


-- Whether node `b` follows node `a` in document order:
-- `compareDocumentPosition`'s `DOCUMENT_POSITION_FOLLOWING` bit.
follows : V, V → Bool
follows a b = Js.bitAnd (Js.to (Js.call a "compareDocumentPosition" [ b ])) 4 ≠ 0


-- The descendants of the unit's top element as the unit's string makes
-- them, parsed once, where the mount element would parse it.
madeOf : Walk → V
madeOf w =
    if Js.isNull (Js.read w.made) then
        holder = Js.call w.at "cloneNode" [ Js.from False ]
        _ = Js.call holder "insertAdjacentHTML" [ Js.from "beforeend", w.html ]
        Js.write w.made (Js.call (Js.get holder "lastChild") "querySelectorAll" [ Js.from "*" ])
    Js.read w.made


-- The page's elements, from the first not taken, into `table` until it
-- holds `upto` descendants; false when the page has too few.
fill : V, V, Js.Ref Int, Int → Bool
fill table page taken upto =
    if Js.to (Js.get table "length") > upto then
        True
    else
        k = Js.read taken
        if k == Js.to (Js.get page "length") then
            False
        else
            _ = Js.call table "push" [ Js.at page k ]
            Js.write taken (k + 1)
            fill table page taken upto


-- `list`'s elements from `i` to before `end` pushed onto `table`.
push : V, V, Int, Int → ⊤
push table list i end =
    if i < end then
        _ = Js.call table "push" [ Js.at list i ]
        push table list (i + 1) end


-- Whether an element of `table` from `i` on is not the one `names` says;
-- a development build says which.
tagsDiffer : V, V, Int → Bool
tagsDiffer table names i =
    if i == Js.to (Js.get table "length") then
        False
    else
        want : String
        want = Js.to (Js.at names i)
        has : String
        has = Js.to (Js.get (Js.at table i) "localName")
        if want == has then
            tagsDiffer table names (i + 1)
        else
            if Js.development ⊤ then
                warn
                    "its element ${String.fromInt i} is a <${has}>, where the program makes a <${want}>"
            True


-- A development build's warning that the page is not the one the program
-- makes, `why` naming the first difference, before the fresh mount.
warn : String → ⊤
warn why =
    Js.to
        (Js.call (Js.global "console") "warn"
            [ Js.from
                "The prerendered page is not the one this program makes: ${why}. The program mounts it fresh."
            ]
        )


-- ---- Groups (`browser-inline.md` §8.4, amended 2026-10-22) -------------

-- Every binding entry made at this mount, in the order made: an entry's
-- place here is its ordinal. A page has one program (`browser-inline.md` §1),
-- mounted once, inside one dispatch, so no two mounts share it. Roots are set up in placement order and each
-- makes its entries in document order, so the order made is the order a
-- pass runs them in, and every bucket, filled as entries are made, is in it.
entries : Js.Ref V
entries = Js.ref (Js.array [])


--| `(f, buckets)`: binding entry `f`, given its ordinal and added to the
--| buckets of what it reads — one bucket, or an array of them. A bucket
--| holds entries, functions, so an array whose first element is an array is
--| several; an empty bucket has no first element, and is one. Returns `f`.
pub entry : V, V → V
entry f buckets =
    -- Its ordinal is the count of entries once it is in: one more than its
    -- place, which orders the same.
    Js.set f "$o" (Js.call (Js.read entries) "push" [ f ])
    Js.each
        (if Js.instanceOf (Js.at buckets 0) (Js.global "Array") then
            buckets
         else
            Js.array [ buckets ]
        )
        λbucket → Js.to (Js.call bucket "push" [ f ])
    f


--| `(bucket)`: a write pass of one bucket, its entries in order.
pub pass : V → ⊤
pass bucket = Js.each bucket λf → Js.to (Js.apply f [])


--| `(buckets)`: a write pass of several buckets: every entry of any of them,
--| once, in ordinal order — document order — synchronously.
pub passes : V → ⊤
passes buckets =
    -- Every entry of the buckets once — a `Set` of them all — sorted by
    -- ordinal.
    pass
        (Js.call
            (Js.call (Js.global "Array") "from"
                [ Js.construct (Js.global "Set") [ Js.call buckets "flat" [] ] ]
            )
            "sort"
            [ Js.from ordinalOrder ]
        )


ordinalOrder : V, V → Int
ordinalOrder x y = Js.to (Js.get x "$o") - Js.to (Js.get y "$o")


--| The first pass: every entry made at this mount, once, in order. Run when
--| every root has made and registered its entries, before subscriptions
--| start and `init`'s command runs.
pub first : ⊤ → ⊤
first ⊤ =
    all = Js.read entries
    Js.write entries (Js.array [])
    pass all


--| `(rows, elements, from, table, at)`: a run of roots mounted in placement
--| order through one table (`browser-inline.md` §8.4, amended 2026-10-24).
--| Row `i` is `[factory, holder…]`: its factory is called with the elements
--| below `elements[from + i]`, the row's holders, the root's own row of the
--| program's table, `table[at + i]`, and the table. A factory takes only
--| what it uses, so one that fills no other root's row leaves the table.
pub roots : V, V, Int, V, Int → ⊤
roots rows elements from table at =
    _ =
        Js.call rows "forEach"
            [ Js.from λrow i →
                Js.call (Js.at row 0) "apply"
                    [ Js.null
                    , Js.call (Js.array [ part (Js.at elements (from + i)) ]) "concat"
                        [ Js.call row "slice" [ Js.from 1 ]
                        , Js.array [ Js.at table (at + i), table ]
                        ]
                    ]
            ]
    ⊤


-- ---- Pushed state (`browser-inline.md` §8.4, amended 2026-10-22, 2026-10-24)

-- A route's row is `[key, F, field]`: the source's key, `0` for a row no
-- keyed route names; the source's function, which validates and gives the
-- old value or a new one; and the model's field. A program one of whose
-- routes has a record field whose object the copy keeps adds the row's
-- copy plan, `[key, F, field, plan]`, and calls the `…Planned` loaders. A
-- row whose function is "the decoded value, or the old one" holds its run's
-- shape in place of `F`, and the program calls the `…Shaped` loaders, which
-- take `validShape` last. Each loader hands the rows' loader a copy function
-- of its own, so a page ships only what it calls.

--| `(model, table, key, raw)`: a keyed route. The first row of `table`
--| whose key is `key`, when there is one, is loaded with `raw`. An unknown
--| key does nothing, as the route's default does.
pub load : V, V, V, V → ⊤
load model table key raw = loadRows model (keyedRow table key) (λ_ → raw) assign


--| `(model, rows, raws)`: routes in turn, each row loaded with the value
--| `raws` holds at its field.
pub loadAll : V, V, V → ⊤
loadAll model rows raws = loadRows model rows (atField raws) assign


--| `load` for rows with copy plans.
pub loadPlanned : V, V, V, V → ⊤
loadPlanned model table key raw = loadRows model (keyedRow table key) (λ_ → raw) planned


--| `loadAll` for rows with copy plans.
pub loadAllPlanned : V, V, V → ⊤
loadAllPlanned model rows raws = loadRows model rows (atField raws) planned


--| `load` for rows that may hold a shape, `check` core's `validShape`,
--| which the lowering hands it.
pub loadShaped : V, V, V, V, (V, V → Result V V) → ⊤
loadShaped model table key raw check =
    loadShapedRows model (keyedRow table key) (λ_ → raw) check assign


--| `loadAll` for rows that may hold a shape.
pub loadAllShaped : V, V, V, (V, V → Result V V) → ⊤
loadAllShaped model rows raws check = loadShapedRows model rows (atField raws) check assign


--| `loadPlanned` for rows that may hold a shape.
pub loadShapedPlanned : V, V, V, V, (V, V → Result V V) → ⊤
loadShapedPlanned model table key raw check =
    loadShapedRows model (keyedRow table key) (λ_ → raw) check planned


--| `loadAllPlanned` for rows that may hold a shape.
pub loadAllShapedPlanned : V, V, V, (V, V → Result V V) → ⊤
loadAllShapedPlanned model rows raws check = loadShapedRows model rows (atField raws) check planned


-- A row that holds a shape may hold constants after it, `[key, shape,
-- field, constants]` or `[key, shape, field, plan, constants]`: a record of
-- the fields the route's `case` gives a constant beside the decoded ones
-- (`browser-inline.md` §8.4, amended 2026-10-24, #946). The `…Const`
-- loaders' copy writes them after the decoded fields.

--| `loadShaped` for rows that may hold constants.
pub loadShapedConst : V, V, V, V, (V, V → Result V V) → ⊤
loadShapedConst model table key raw check =
    loadShapedRows model (keyedRow table key) (λ_ → raw) check assignConst


--| `loadAllShaped` for rows that may hold constants.
pub loadAllShapedConst : V, V, V, (V, V → Result V V) → ⊤
loadAllShapedConst model rows raws check =
    loadShapedRows model rows (atField raws) check assignConst


--| `loadShapedPlanned` for rows that may hold constants.
pub loadShapedPlannedConst : V, V, V, V, (V, V → Result V V) → ⊤
loadShapedPlannedConst model table key raw check =
    loadShapedRows model (keyedRow table key) (λ_ → raw) check plannedConst


--| `loadAllShapedPlanned` for rows that may hold constants.
pub loadAllShapedPlannedConst : V, V, V, (V, V → Result V V) → ⊤
loadAllShapedPlannedConst model rows raws check =
    loadShapedRows model rows (atField raws) check plannedConst


-- The row of `table` whose key is `key`, as a list of rows: empty when
-- there is none. A keyed table's keys are the string patterns of one
-- `case`, which differ, since a repeated one is `redundant_pattern`: so at
-- most one row has the key (`browser-inline.md` §8.4, amended 2026-10-24).
keyedRow : V, V → V
keyedRow table key = Js.call table "filter" [ Js.from λr → Js.same (Js.at r 0) key ]


atField : V → (V → V)
atField raws = λrow → Js.get raws (fieldOf row)


-- Every row's function runs first, each with its raw value and the model's
-- old value at its field, in order; then each result is copied in.
loadRows : V, V, (V → V), (V, V, V → ⊤) → ⊤
loadRows model rows rawOf into =
    nexts =
        Js.call rows "map"
            [ Js.from λrow → Js.apply (Js.at row 1) [ rawOf row, Js.get model (fieldOf row) ] ]
    copyIn model rows nexts into


-- `loadRows` for rows that may hold a shape in place of the function: the
-- value `check` decodes from the raw value with it, or the old value when
-- it does not decode, as the function's `Result.withDefault
-- (Json.decodeValue raw) old` gives.
loadShapedRows : V, V, (V → V), (V, V → Result V V), (V, V, V → ⊤) → ⊤
loadShapedRows model rows rawOf check into =
    nexts =
        Js.call rows "map"
            [ Js.from λrow →
                f = Js.at row 1
                raw = rawOf row
                old = Js.get model (fieldOf row)
                if Js.typeIs f "function" then
                    Js.apply f [ raw, old ]
                else
                    Result.withDefault (check f raw) old
            ]
    copyIn model rows nexts into


-- Each result that is not the old value at its row's field is copied into
-- it, by `into`.
copyIn : V, V, V, (V, V, V → ⊤) → ⊤
copyIn model rows nexts into = Js.each rows λrow →
    old = Js.get model (fieldOf row)
    next = Js.call nexts "shift" []
    if not (Js.same next old) then
        into old next row


fieldOf : V → String
fieldOf row = Js.to (Js.at row 2)


-- Every field of `next` into `old`: `next` is a record of the route's type,
-- which a function of the raw value alone made, so its own fields are
-- exactly the type's, and no field of it is a record whose object the copy
-- keeps.
assign : V, V, V → ⊤
assign old next _ =
    _ = Js.call (Js.global "Object") "assign" [ old, next ]
    ⊤


planned : V, V, V → ⊤
planned old next row = copy old next (Js.at row 3)


-- `assign`, then the row's constants, when it has any: a row without them
-- has nothing at that index, which `Object.assign` skips. A row whose
-- result is the old value is not copied at all (`copyIn`), so the constants
-- are written only with a decoded value, as the route's `Ok` arm gives them.
assignConst : V, V, V → ⊤
assignConst old next row =
    _ = Js.call (Js.global "Object") "assign" [ old, next, Js.at row 3 ]
    ⊤


plannedConst : V, V, V → ⊤
plannedConst old next row =
    copy old next (Js.at row 3)
    _ = Js.call (Js.global "Object") "assign" [ old, Js.at row 4 ]
    ⊤


-- `next`'s fields into `old`, as `plan` lists them: a name is written, a
-- `[name, plan]` pair is copied into the object `old` holds there.
copy : V, V, V → ⊤
copy old next plan = Js.each plan λitem →
    if Js.typeIs item "string" then
        name : String
        name = Js.to item
        Js.set old name (Js.get next name)
    else
        name : String
        name = Js.to (Js.at item 0)
        copy (Js.get old name) (Js.get next name) (Js.at item 1)
