--! Listeners on the window or the document (`docs/design/boundary.md`
--! §9.8.5): what a platform layer builds its subscriptions on. A listener
--! is a function of what it sends that adds the host's listener and
--! returns what removes it; `Sub.on` declares one. Each event is read while
--! it is dispatched, inside the dispatch guard, so what it carried is not
--! read late and a reader that throws stops the page.

import Inline
import Js


--| Add a listener for every event named `name` on `target` (`"window"` or
--| `"document"`) that calls `send (read event)` while the event is
--| dispatched, and return what removes it.
pub on : String, String, sync (Js.Value → a), sync (a → ⊤) → (⊤ → ⊤)
on target name read send =
    host = Js.global target
    -- The read is program code, and it runs while the event is dispatched,
    -- inside a dispatch guard: in the one running when the event fires in
    -- it, where only the send of what it read is queued, else in one it
    -- starts. A throw in it stops the page; once the page has stopped it
    -- does not run.
    handler = Js.from λevent →
        if Inline.stopped ⊤ then
            ⊤
        else if Inline.busy ⊤ then
            -- `send` enters the guard, which queues it.
            send (read event)
        else
            Inline.send (Js.from λdispatched → send (read dispatched)) event
    _ = Js.call host "addEventListener" [ Js.from name, handler ]
    λ⊤ → Js.to (Js.call host "removeEventListener" [ Js.from name, handler ])
