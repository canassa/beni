--! Listeners on the window or the document (`docs/design/boundary.md`
--! §9.8.5): what a platform layer builds its subscriptions on. A listener
--! is a function of what it sends that adds the host's listener and
--! returns what removes it; `Sub.on` declares one. Each event is read while
--! it is dispatched, inside the dispatch guard, so what it carried is not
--! read late and a reader that throws stops the page.

import Browser.Host.Document as HostDocument
import Browser.Host.Event as HostEvent
import Browser.Host.Window as HostWindow
import Inline
import Js.Protocol as Protocol


--| Read each native event inside dispatch, and return its exact remover.
pub on : String, String, sync (HostEvent.Event → a), sync (a → ⊤) → (⊤ → ⊤)
on target name read send =
    handler = λevent → Inline.observe send event read
    if target == "window" then
        HostWindow.listen name handler
    else if target == "document" then
        HostDocument.listen name handler
    else
        Protocol.defect "unknown listener target: ${target}"
