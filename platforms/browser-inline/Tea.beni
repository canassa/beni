--! The Elm Architecture on `browser-inline` (`docs/design/browser-inline.md`):
--! `browser-tea`'s `sandbox`, `element`, `document` and `application`, so one
--! source builds on both (`browser-inline.md` §10 for the last two).
--! Here a program is compiled, not run: each constructor is a declaration
--! the platform's `inline` lowering recognises where it is called
--! (`boundary.md` §9.4.6, version 1.6), and the call is compiled as the
--! constructor applied to the program's mount. The record is never a value,
--! and no constructor's body is ever reached (`unreachable`, below).

import Browser exposing (UrlRequest)
import Browser.Navigation as Navigation
import Cmd exposing (Cmd)
import Html exposing (Html)
import Js
import Sub exposing (Sub)
import Url exposing (Url)


--| What `main` is: `Browser.Program` under this platform's name.
pub type alias Program =
    Browser.Program


--| A page with a model and no effects: `init ⊤`, called at mount, is the
--| first model, and each message goes through `update`, whose model the
--| page shows before the dispatch ends.
pub sandbox :
      entry { init : sync (⊤ → model)
            , update : sync (msg, model → model)
            , view : sync (model → Html msg)
            }
    → Program
sandbox app = unreachable app


--| A page with a model and effects: `init ⊤` is the first model and the
--| work it asks for; each message goes through `update`, which returns the
--| next model and the work that message asks for, run after the page shows
--| the model; and `subscriptions` says what the program listens to, which
--| on this platform may not depend on the model.
pub element :
      entry { init : sync (⊤ → model × Cmd msg)
            , update : sync (msg, model → model × Cmd msg)
            , view : sync (model → Html msg)
            , subscriptions : sync (model → Sub msg)
            }
    → Program
element app = unreachable app


--| What the `view` of a `document` or an `application` makes: the page's
--| title and its body.
pub type alias Document msg =
    title : String
    body : Html msg


--| An `element` that owns the page's title: its `view` makes a `Document`,
--| a record of a `title` and a `body` written in place, and the title is
--| written after each message that changes it, so the page's title and
--| its body never disagree.
pub document :
      entry { init : sync (⊤ → model × Cmd msg)
            , update : sync (msg, model → model × Cmd msg)
            , view : sync (model → Document msg)
            , subscriptions : sync (model → Sub msg)
            }
    → Program
document app = unreachable app


--| A `document` that owns the page's address (`docs/design/boundary.md`
--| §9.8.13 (d)): `init` is handed the address the page was opened at and
--| the page's navigation key, a click on a link the page should handle is
--| sent through `onUrlRequest`, and every change of the address through
--| `onUrlChange`. A page whose address is not `http` or `https` (opened
--| from a file) stops at start: no route can be computed there.
--|
--|     main =
--|         Tea.application
--|             { init = λurl key → ( { key = key, route = toRoute url }, Cmd.none )
--|             , update = update
--|             , view = view
--|             , subscriptions = λ_ → Sub.none
--|             , onUrlRequest = ClickedLink
--|             , onUrlChange = UrlChanged
--|             }
pub application :
      entry { init : sync (Url, Navigation.Key → model × Cmd msg)
            , update : sync (msg, model → model × Cmd msg)
            , view : sync (model → Document msg)
            , subscriptions : sync (model → Sub msg)
            , onUrlRequest : sync (UrlRequest → msg)
            , onUrlChange : sync (Url → msg)
            }
    → Program
application app = unreachable app


-- What a constructor gives if a call reached it: none does, since the
-- `inline` lowering compiles each call as the program's mount
-- (`Lowering.constructs`) and refuses one used as a value. All four are
-- beni rather than `foreign` (`sandbox` and `element` since 2026-10-30,
-- `plans/runtime-in-beni.md` step 9), so the platform has no sibling and
-- a development build copies none (`browser-inline.md` §10.5).
unreachable : a → Program
unreachable _ = Js.to Js.undefined
