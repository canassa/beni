--! Durable Objects retain typed handlers, state, native handles and closed
--! mailbox jobs. One owned scheduler consumes one mailbox in arrival order.

import Browser.Host.Cloudflare as Native
import Browser.Host.Date as Date
import Browser.Host.Promise as Promise
import Browser.Host.Rejection as Rejection
import Browser.Host.Request as HostRequest
import Browser.Host.Response as HostResponse
import Browser.Host.TextEncoder as TextEncoder
import Browser.Host.Timers as Timers
import Browser.Host.Uint8Array as Uint8Array
import Dict exposing (Dict)
import Duration exposing (Duration)
import Js
import Js.Chain as Chain
import Js.Protocol as Protocol
import List
import Log
import Maybe
import Schema exposing (Schema)
import String
import Task exposing (Scheduler)
import WebSocket exposing (Close, Socket)
import Worker exposing (Request, Response)


pub type alias Ref msg =
    Worker.Ref msg


--| An object's id, storage, sockets, alarm, timer and mailbox.
pub type alias Context msg =
    ContextStorage (Instance msg)


-- The instance parameter keeps its callback effect classes independent.
-- Constructors remain private to this module.
type ContextStorage instance
    = Context (Js.Ref (Maybe instance))


--| The one-shot reply channel carried by an ask.
pub opaque type Reply a
    = Reply
        { brand : Js.Ref ⊤
        , id : String
        , local : Bool
        , owner : Maybe ReplyOwner
        , print : a → Result (List Schema.Issue) String
        }


replyBrand : Js.Ref ⊤
replyBrand = Js.ref ⊤


-- Compiler-derived, Cloudflare-private: no message is converted to Js.Value.
pub foreign pure replyIds : borrowed msg → fresh List String


type alias ReplyOwner =
    asks : Js.Ref (Dict String AskEntry)
    name : String


type alias AskEntry =
    completion : Promise.Resolvers Js.Value
    returned : Js.Ref Bool


type alias Job =
    run : ⊤ → ⊤
    chain : Maybe String
    reject : Maybe (Promise.Resolvers HostResponse.Response)
    holds : List String


type alias Instance msg =
    ctx : Native.ObjectState
    env : Worker.Env
    name : String
    owner : ReplyOwner
    parse : String → Result (List Schema.Issue) msg
    print : msg → Result (List Schema.Issue) String
    request : Request → Response
    received : msg → ⊤
    message : Socket, String → ⊤
    closed : Socket, Close → ⊤
    failed : Socket, String → ⊤
    alarm : ⊤ → ⊤
    ticked : ⊤ → ⊤
    restore : ⊤ → ⊤
    retime : ⊤ → ⊤
    mailbox : Chain.Chain Job
    waiter : Js.Ref (Maybe (Task.Resume ⊤))
    scheduler : Scheduler
    restored : Js.Ref Bool
    started : Js.Ref Bool
    chain : Js.Ref (Maybe String)
    running : Js.Ref (Maybe (Promise.Resolvers HostResponse.Response))
    hold : Js.Ref (Maybe Timers.Timer)
    timer : Js.Ref (Maybe { ms : Int, handle : Maybe Timers.Timer })
    tasks : Chain.Chain (⊤ → ⊤)
    wake : Js.Ref (Maybe (Promise.Resolvers ⊤))


--| Each handler returns the next state. tick is synchronous.
pub type alias Handlers state msg =
    request : Context msg, state, Request → state × Response
    message : Context msg, state, Socket, String → state
    closed : Context msg, state, Socket, Close → state
    failed : Context msg, state, Socket, String → state
    alarm : Context msg, state → state
    received : Context msg, state, msg → state
    tick : state → Maybe Duration
    ticked : Context msg, state → state


--| No-op handlers; request answers 404 and tick is Nothing.
pub none : Handlers state msg
none =
    { request = λ_ state _ → ( state, Worker.text 404 "no such page" )
    , message = λ_ state _ _ → state
    , closed = λ_ state _ _ → state
    , failed = λ_ state _ _ → state
    , alarm = λ_ state → state
    , received = λ_ state _ → state
    , tick = λ_ → Nothing
    , ticked = λ_ state → state
    }


pub type AskError
    = Overloaded
    | Reset
    | Transient
    | Cycle
    | NoReply
    | Unprintable (List Schema.Issue)
    | Unreadable (List Schema.Issue)


--| A named Durable Object class, its protocol, restore and handlers.
pub define :
      String
    , Schema e msg
    , (Context msg → state)
    , { request : Context msg, state, Request → state × Response
      , message : Context msg, state, Socket, String → state
      , closed : Context msg, state, Socket, Close → state
      , failed : Context msg, state, Socket, String → state
      , alarm : Context msg, state → state
      , received : Context msg, state, msg → state
      , tick : sync (state → Maybe Duration)
      , ticked : Context msg, state → state
      }
    → Worker.Definition
define className schema restore handlers = Native.definition className λctx bindings →
    start className schema restore handlers ctx bindings


instance : Context msg → Instance msg
instance (Context holder) =
    case Js.read holder of
        Just current →
            current
        Nothing →
            Protocol.defect "Object context used before initialization"


stateValue : Js.Ref (Maybe state) → state
stateValue holder =
    case Js.read holder of
        Just current →
            current
        Nothing →
            Protocol.defect "Object state used before restore"


start :
      String
    , Schema e msg
    , (Context msg → state)
    , Handlers state msg
    , Native.ObjectState
    , Native.Env
    → Native.Instance
start className schema restore handlers ctx bindings =
    holder = Js.ref Nothing
    context = Context holder
    state = Js.ref Nothing
    scheduler = Task.schedulerWith (runLater context _) (laterTurn context _) λ⊤ → defect context
    owner = { asks = Js.ref Dict.empty, name = className }
    current =
        { ctx = ctx
        , env = Worker.wrapEnv bindings
        , name = className
        , owner = owner
        , parse = Schema.parse schema _
        , print = Schema.print schema _
        , request =
            λrequest →
                ( next, response ) = handlers.request context (stateValue state) request
                Js.write state (Just next)
                response
        , received =
            λmessage → Js.write state (Just (handlers.received context (stateValue state) message))
        , message =
            λsocket payload →
                Js.write state (Just (handlers.message context (stateValue state) socket payload))
        , closed =
            λsocket why →
                Js.write state (Just (handlers.closed context (stateValue state) socket why))
        , failed =
            λsocket why →
                Js.write state (Just (handlers.failed context (stateValue state) socket why))
        , alarm = λ⊤ → Js.write state (Just (handlers.alarm context (stateValue state)))
        , ticked = λ⊤ → Js.write state (Just (handlers.ticked context (stateValue state)))
        , restore = λ⊤ → Js.write state (Just (restore context))
        , retime = λ⊤ → retime context (handlers.tick (stateValue state))
        , mailbox = Chain.make ⊤
        , waiter = Js.ref Nothing
        , scheduler = scheduler
        , restored = Js.ref False
        , started = Js.ref False
        , chain = Js.ref Nothing
        , running = Js.ref Nothing
        , hold = Js.ref Nothing
        , timer = Js.ref Nothing
        , tasks = Chain.make ⊤
        , wake = Js.ref Nothing
        }
    Js.write holder (Just current)
    Task.onSchedulerCount scheduler λcount → counted context count
    arm context
    Native.instance
        (arrived context _)
        (λ⊤ → deliver context current.alarm)
        (λchain kind correlation payload → rpcArrived context chain kind correlation payload)
        (λnativeSocket payload →
            case payload of
                Just payloadText →
                    deliver context λ⊤ →
                        current.message (WebSocket.fromNative nativeSocket) payloadText
                Nothing →
                    Log.warn
                        "beni: the object ${className} got a binary frame; the socket is closed with 1003"
                    Native.socketClose nativeSocket 1003 "binary frames are not accepted"
                    resolvedUnit ⊤
        )
        (λnativeSocket code reason _ →
            answerClose nativeSocket code reason
            why = { code = code, reason = if code == 1006 then "" else reason }
            deliver context λ⊤ → current.closed (WebSocket.fromNative nativeSocket) why
        )
        λnativeSocket reason →
            deliver context λ⊤ →
                current.failed (WebSocket.fromNative nativeSocket) (Native.errorText reason)


arm : Context msg → ⊤
arm context =
    current = instance context
    d = Promise.unitResolvers ⊤
    Js.write current.wake (Just d)
    Promise.observe
        (Promise.after (Promise.promise d) λ⊤ → fire context)
        (λ⊤ → ⊤)
        (crashed context _)


crashed : Context msg, Rejection.Rejection → ⊤
crashed context reason =
    current = instance context
    case Js.read current.running of
        Nothing →
            ⊤
        Just reject →
            Promise.reject reject reason
    Js.write current.running Nothing
    jobs = Chain.toList current.mailbox
    Chain.clear current.mailbox
    each jobs λjob →
        case job.reject of
            Nothing →
                ⊤
            Just reject →
                Promise.reject reject reason


fire : Context msg → ⊤
fire context =
    current = instance context
    arm context
    jobs = Chain.toList current.tasks
    Chain.clear current.tasks
    each jobs λjob →
        Worker.setDraining (Just λ⊤ → Js.read current.chain)
        Js.finally (λ⊤ → Protocol.call job ⊤) λ⊤ → Worker.setDraining Nothing


laterTurn : Context msg, (⊤ → ⊤) → ⊤
laterTurn context job =
    _ = Timers.start (λ⊤ → runLater context job) 0
    ⊤


runLater : Context msg, (⊤ → ⊤) → ⊤
runLater context job =
    current = instance context
    _ = Chain.append current.tasks job
    case Js.read current.wake of
        Nothing →
            ⊤
        Just signal →
            Promise.resolve signal ⊤


arrived : Context msg, HostRequest.Request → Promise.Promise HostResponse.Response
arrived context request =
    d = Native.responseResolvers ⊤
    Promise.observe
        (Promise.after (Native.requestText request) λpayload → classify context request payload d)
        (λ⊤ → ⊤)
        (Promise.reject d _)
    Promise.promise d


classify : Context msg, HostRequest.Request, String, Promise.Resolvers HostResponse.Response → ⊤
classify context request payload d =
    current = instance context
    wrapped = Worker.requestWithBody request payload
    at = Worker.path wrapped
    if Js.testHooks ⊤ then
        if String.endsWith at "/__beni/tick" then
            case Js.read current.timer of
                Nothing →
                    Promise.resolve d (Worker.hostResponse (Worker.text 409 "no timer armed"))
                Just _ →
                    enqueue context Nothing [] (Just d) λ⊤ →
                        current.ticked ⊤
                        Promise.resolve d (Worker.hostResponse (Worker.empty 204))
        else if String.endsWith at "/__beni/alarm" then
            enqueue context Nothing [] (Just d) λ⊤ →
                current.alarm ⊤
                Promise.resolve d (Worker.hostResponse (Worker.empty 204))
        else if String.endsWith at "/__beni/hold" then
            held =
                case Js.read current.hold of
                    Nothing →
                        "free"
                    Just _ →
                        "held"
            Promise.resolve d (Native.responseCreate 200 (Just held) [])
        else
            classifyEvent context wrapped d
    else
        classifyEvent context wrapped d
    wake context


classifyEvent : Context msg, Request, Promise.Resolvers HostResponse.Response → ⊤
classifyEvent context request d =
    current = instance context
    chain = Worker.header request "x-beni-chain"
    if parked context chain then
        Promise.resolve d (Native.responseCreate 508 Nothing [ ( "x-beni-cycle", "1" ) ])
    else
        enqueue context chain [] (Just d) λ⊤ →
            response = current.request request
            Promise.resolve d (Worker.hostResponse response)


rpcArrived : Context msg, Maybe String, String, Maybe String, String → Promise.Promise Js.Value
rpcArrived context chain kind correlation payload =
    d = Promise.dataResolvers ⊤
    if parked context chain then
        Promise.resolve d (answerValue "cycle" Nothing)
    else
        received
            context
            payload
            chain
            (if kind == "ask" then correlation else Nothing)
            d
    wake context
    Promise.promise d


parsingIn : Js.Ref (Maybe ReplyOwner)
parsingIn = Js.ref Nothing


received :
      Context msg
    , String
    , Maybe String
    , Maybe String
    , Promise.Resolvers Js.Value
    → ⊤
received context payload chain askId completion =
    current = instance context
    Js.write parsingIn (Just current.owner)
    parsed = current.parse payload
    Js.write parsingIn Nothing
    case parsed of
        Err _ →
            Promise.resolve completion (answerValue "unparsed" Nothing)
        Ok message →
            case askId of
                Nothing →
                    ⊤
                Just askKey →
                    Js.write
                        current.owner.asks
                        (Dict.insert (Js.read current.owner.asks) askKey
                            { completion = completion, returned = Js.ref False }
                        )
            -- RPC failures are the host abort’s Reset, after the object shuts down.
            enqueue context chain [] Nothing λ⊤ →
                current.received message
                case askId of
                    Nothing →
                        Promise.resolve completion Js.null
                    Just askKey →
                        case Dict.get (Js.read current.owner.asks) askKey of
                            Nothing →
                                ⊤
                            Just entry →
                                Js.write entry.returned True


parked : Context msg, Maybe String → Bool
parked context chain =
    case chain of
        Nothing →
            False
        Just currentChain →
            Js.read (instance context).chain == Just currentChain


enqueue :
      Context msg
    , Maybe String
    , List String
    , Maybe (Promise.Resolvers HostResponse.Response)
    , (⊤ → ⊤)
    → ⊤
enqueue context chain holds reject action =
    _ =
        Chain.append (instance context).mailbox
            { run = action, chain = chain, reject = reject, holds = holds }
    ⊤


deliver : Context msg, (⊤ → ⊤) → Promise.Promise ⊤
deliver context action =
    d = Promise.unitResolvers ⊤
    -- Host events stay pending until completion or the object aborts.
    enqueue context Nothing [] Nothing λ⊤ →
        action ⊤
        Promise.resolve d ⊤
    wake context
    Promise.promise d


resolvedUnit : ⊤ → Promise.Promise ⊤
resolvedUnit ⊤ =
    d = Promise.unitResolvers ⊤
    Promise.resolve d ⊤
    Promise.promise d


wake : Context msg → ⊤
wake context =
    current = instance context
    if not (Js.read current.started) then
        Js.write current.started True
        Protocol.call
            (λ⊤ →
                Task.withScheduler current.scheduler λ⊤ →
                    _ = Task.spawnDetached λ⊤ → consume context
                    ⊤
            )
            ⊤
    else
        case Js.read current.waiter of
            Nothing →
                ⊤
            Just waiter →
                Js.write current.waiter Nothing
                Task.resume waiter ⊤


consume : Context msg → ⊤
consume context =
    current = instance context
    if not (Js.read current.restored) then
        current.restore ⊤
        Js.write current.restored True
        current.retime ⊤
        counted context (Task.schedulerFibers current.scheduler)
    case Chain.shift current.mailbox of
        Nothing →
            settlePending context
            Task.callback λresume →
                Js.write current.waiter (Just resume)
                λ⊤ → Js.write current.waiter Nothing
            consume context
        Just job →
            Js.write current.chain job.chain
            Js.write current.running job.reject
            job.run ⊤
            Js.write current.running Nothing
            Js.write current.chain Nothing
            current.retime ⊤
            counted context (Task.schedulerFibers current.scheduler)
            consume context


counted : Context msg, Int → ⊤
counted context count =
    current = instance context
    if count ≤ 1 then
        settlePending context
        case Js.read current.hold of
            Nothing →
                ⊤
            Just handle →
                Timers.clear handle
                Js.write current.hold Nothing
    else
        case Js.read current.hold of
            Just _ →
                ⊤
            Nothing →
                Js.write current.hold (Just (Timers.start (λ⊤ → ⊤) 2147483647))


settlePending : Context msg → ⊤
settlePending context =
    current = instance context
    if Task.schedulerFibers current.scheduler ≤ 1 then
        each (Dict.toList (Js.read current.owner.asks)) λ( askKey, entry ) →
            if Js.read entry.returned && not (carried context askKey) then
                Js.write current.owner.asks (Dict.remove (Js.read current.owner.asks) askKey)
                Promise.resolve entry.completion (answerValue "none" Nothing)


carried : Context msg, String → Bool
carried context askKey = List.any (Chain.toList (instance context).mailbox) λjob →
    List.member job.holds askKey


retime : Context msg, Maybe Duration → ⊤
retime context wanted =
    current = instance context
    case wanted of
        Nothing →
            clearTimer context
        Just duration →
            ms = Duration.toMillis duration
            same =
                case Js.read current.timer of
                    Nothing →
                        False
                    Just armed →
                        armed.ms == ms
            if not same then
                clearTimer context
                handle =
                    if Js.testHooks ⊤ then
                        Nothing
                    else
                        Just (Timers.start (λ⊤ → fired context) ms)
                Js.write current.timer (Just { ms = ms, handle = handle })


clearTimer : Context msg → ⊤
clearTimer context =
    current = instance context
    case Js.read current.timer of
        Nothing →
            ⊤
        Just armed →
            case armed.handle of
                Nothing →
                    ⊤
                Just handle →
                    Timers.clear handle
            Js.write current.timer Nothing


fired : Context msg → ⊤
fired context =
    current = instance context
    Js.write current.timer Nothing
    _ = deliver context current.ticked
    ⊤


pub type AcceptError
    = NotAnUpgrade
    | TooManyTags
    | TooManySockets
    | ProtocolNotOffered


--| Accept an upgrade and retain the socket through hibernation.
pub accept : Context msg, Request, List String → Result AcceptError (Socket × Response)
accept ctx request tags = acceptWith ctx request { protocol = Nothing, tags = tags }


pub acceptWith :
      Context msg
    , Request
    , { protocol : Maybe String, tags : List String }
    → Result AcceptError (Socket × Response)
acceptWith ctx request options =
    offered =
        case Worker.header request "sec-websocket-protocol" of
            Just offeredText →
                List.map (String.split offeredText ",") String.trim
            Nothing →
                []
    if
        Worker.method request ≠ "GET"
            || Maybe.map (Worker.header request "upgrade") String.toLower ≠ Just "websocket"
    then
        Err NotAnUpgrade
    else if List.length options.tags > 10 || List.any options.tags λtag → utf8Bytes tag > 256 then
        Err TooManyTags
    else if List.length (sockets ctx) ≥ 32768 then
        Err TooManySockets
    else
        case options.protocol of
            Nothing →
                Ok (opened ctx options.tags "")
            Just protocol →
                if List.member offered protocol then
                    Ok (opened ctx options.tags protocol)
                else
                    Err ProtocolNotOffered


opened : Context msg, List String, String → Socket × Response
opened ctx tags protocol =
    pair = Native.socketPair ⊤
    client = Native.socketClient pair
    server = Native.socketServer pair
    Native.acceptSocket (hostState ctx) server tags
    Native.socketInitialize server (Native.randomUUID ⊤) protocol tags
    ( WebSocket.fromNative server, Worker.fromHost (Native.socketResponse client protocol) )


pub type AutoReplyError
    = RequestTooLarge
    | ResponseTooLarge


pub autoReply : Context msg, String, String → Result AutoReplyError ⊤
autoReply ctx request response =
    if utf8Bytes request > 2048 then
        Err RequestTooLarge
    else if utf8Bytes response > 2048 then
        Err ResponseTooLarge
    else
        Native.autoResponse (hostState ctx) request response
        Ok ⊤


rpcLimit : Int
rpcLimit = 33554432 - 65536


serializedBytes : String → Int
serializedBytes payload = 2 * Js.to (Js.get (Js.from payload) "length")


utf8Bytes : String → Int
utf8Bytes payload = Uint8Array.byteLength (TextEncoder.encode (TextEncoder.create ⊤) payload)


pub alarmAt : Context msg, Int → ⊤
alarmAt ctx at = Native.alarmSet (hostState ctx) at


pub alarmIn : Context msg, Duration → ⊤
alarmIn ctx duration = alarmAt ctx (Date.now ⊤ + Duration.toMillis duration)


pub cancelAlarm : Context msg → ⊤
cancelAlarm ctx = Native.alarmDelete (hostState ctx)


pub hostState : Context msg → Native.ObjectState
hostState ctx = (instance ctx).ctx


pub body : Request → String
body request = Worker.requestBody request


pub env : Context msg → Worker.Env
env ctx = (instance ctx).env


pub id : Context msg → String
id ctx = Native.idText (Native.objectId (hostState ctx))


pub name : Context msg → Maybe String
name ctx = Native.idName (Native.objectId (hostState ctx))


pub sockets : Context msg → List Socket
sockets ctx = List.map (Native.sockets (hostState ctx)) WebSocket.fromNative


pub socketsTagged : Context msg, String → List Socket
socketsTagged ctx tag = List.map (Native.socketsTagged (hostState ctx) tag) WebSocket.fromNative


answerClose : Native.Socket, Int, String → ⊤
answerClose socket code reason =
    if Native.socketState socket == 2 then
        if echoable code reason then
            Native.socketClose socket code reason
        else
            Native.socketCloseEmpty socket


echoable : Int, String → Bool
echoable code reason =
    code ≥ 1000
        && code ≤ 4999
        && code ≠ 1004
        && code ≠ 1005
        && code ≠ 1006
        && code ≠ 1015
        && utf8Bytes reason ≤ 123


pub self : Context msg → Ref msg
self ctx =
    current = instance ctx
    Worker.selfRef (id ctx) (name ctx) current.print λmessage →
        enqueue ctx Nothing (replyIds message) Nothing λ⊤ → current.received message
        wake ctx


pub post : Ref msg, msg → ⊤
post ref message =
    case Worker.refPost ref of
        Just send →
            send message
        Nothing →
            case Worker.refStub ref of
                Nothing →
                    ⊤
                Just stub →
                    Js.write printingTo (Just stub)
                    printed = Worker.printRef ref message
                    Js.write printingTo Nothing
                    case printed of
                        Ok payload →
                            if serializedBytes payload > rpcLimit then
                                Log.warn
                                    "beni: a message to the object was dropped, it is over the host's 32 MiB RPC limit"
                            else
                                _ = Native.stubRpc stub (Worker.chainNow ⊤) "post" Nothing payload
                                ⊤
                        Err issues →
                            why = String.join (List.map issues λissue → issue.message) "; "
                            Log.warn
                                "beni: a message to the object was dropped, it does not print by the protocol's schema: ${why}"


pub ask : Ref msg, Schema e a, (Reply a → msg) → Result AskError a
ask ref schema wrap =
    case Worker.refStub ref of
        Nothing →
            Err Cycle
        Just stub →
            askId = Native.randomUUID ⊤
            channel =
                Reply
                    { brand = replyBrand
                    , id = askId
                    , local = False
                    , owner = Nothing
                    , print = Schema.print schema _
                    }
            Js.write printingTo (Just stub)
            printed = Worker.printRef ref (wrap channel)
            Js.write printingTo Nothing
            case printed of
                Err issues →
                    Err (Unprintable issues)
                Ok payload →
                    if serializedBytes payload > rpcLimit then
                        Err
                            (Unprintable
                                [ Schema.issue "the message is over the host's 32 MiB RPC limit" ]
                            )
                    else
                        case
                            Worker.settleHost
                                (Native.stubRpc stub (Worker.chainNow ⊤) "ask" (Just askId) payload)
                        of
                            Ok result →
                                answered result schema
                            Err reason →
                                if Native.overloaded reason then
                                    Err Overloaded
                                else if Native.reset reason then
                                    Err Reset
                                else if Native.retryable reason then
                                    Err Transient
                                else
                                    Rejection.raise reason


answered : Js.Value, Schema e a → Result AskError a
answered result schema =
    kind : String
    kind = Js.to (Js.get result "kind")
    if kind == "cycle" then
        Err Cycle
    else if kind == "unparsed" then
        Err (Unreadable [ Schema.issue "the message did not parse by the receiver's schema" ])
    else if kind == "none" then
        Err NoReply
    else if kind == "large" then
        Err (Unreadable [ Schema.issue "the reply is over the host's 32 MiB RPC limit" ])
    else
        case Schema.parse schema (Js.to (Js.get result "text")) of
            Ok value →
                Ok value
            Err issues →
                Err (Unreadable issues)


printingTo : Js.Ref (Maybe Native.Stub)
printingTo = Js.ref Nothing


pub reply : Reply a, a → ⊤
reply (Reply channel) value =
    case channel.owner of
        Nothing →
            lateReply "?" channel.print value
        Just owner →
            case Dict.get (Js.read owner.asks) channel.id of
                Nothing →
                    lateReply owner.name channel.print value
                Just entry →
                    Js.write owner.asks (Dict.remove (Js.read owner.asks) channel.id)
                    case channel.print value of
                        Err _ →
                            Promise.resolve entry.completion (answerValue "unparsed" Nothing)
                        Ok payload →
                            if serializedBytes payload > rpcLimit then
                                Log.warn
                                    "beni: a reply from the object ${owner.name} is over the host's 32 MiB RPC limit: the asker gets Unreadable"
                                Promise.resolve entry.completion (answerValue "large" Nothing)
                            else
                                Promise.resolve
                                    entry.completion
                                    (answerValue "reply" (Just payload))


lateReply : String, (a → Result (List Schema.Issue) String), a → ⊤
lateReply className print value =
    shown =
        case print value of
            Ok payload →
                payload
            Err _ →
                "a value that does not print"
    Log.warn
        "beni: a reply came after its ask was answered: the object ${className} replied ${shown} to a Reply that no one waits on"


pub replySchema : Schema e a → Schema String (Reply a)
replySchema inner =
    Schema.converted Schema.string
        (Schema.conversion
            (λcorrelation →
                owner = Js.read parsingIn
                local =
                    case owner of
                        Nothing →
                            False
                        Just _ →
                            True
                Ok
                    (Reply
                        { brand = replyBrand
                        , id = correlation
                        , local = local
                        , owner = owner
                        , print = Schema.print inner _
                        }
                    )
            )
            λ(Reply channel) →
                case Js.read printingTo of
                    Nothing →
                        Ok channel.id
                    Just _ →
                        if channel.local then
                            Err
                                [ Schema.issue
                                    "a Reply names a request pending in this object alone: it cannot be sent to another"
                                ]
                        else
                            Ok channel.id
        )


answerValue : String, Maybe String → Js.Value
answerValue kind payload =
    case payload of
        Nothing →
            Js.from { kind = kind }
        Just contents →
            Js.from { kind = kind, text = contents }


defect : Context msg → ⊤
defect context =
    current = instance context
    Task.stopScheduler current.scheduler 1000 λ_ →
        reason =
            "beni: a defect stopped the object ${current.name}; its next event starts a new instance"
        Native.consoleError reason
        _ = Timers.start (λ⊤ → Native.objectAbort current.ctx reason) 0
        ⊤


each : List a, (a → ⊤) → ⊤
each values action =
    case values of
        [] →
            ⊤
        [ first, …rest ] →
            action first
            each rest action
