--! SQLite-backed synchronous storage. Schema text keeps field names stable
--! across releases and deploys. Only SQLITE_FULL from put is a typed failure.

import Browser.Host.Cloudflare as Native
import Js
import Js.Protocol as Protocol
import Schema exposing (Schema)
import Worker.Object as Object exposing (Context)


pub type PutError
    = TooLarge
    | Full
    | Unprintable (List Schema.Issue)


--| Read and parse text; Nothing when the key is absent.
pub get : Context msg, Schema e a, String → Result (List Schema.Issue) (Maybe a)
get ctx schema key =
    case Native.kvGet (kv ctx) key of
        Nothing →
            Ok Nothing
        Just contents →
            case Schema.parse schema contents of
                Ok value →
                    Ok (Just value)
                Err issues →
                    Err issues


units : String → Int
units contents = Js.to (Js.get (Js.from contents) "length")


--| Write schema text within the serialized key/value limit.
pub put : Context msg, Schema e a, String, a → Result PutError ⊤
put ctx schema key value =
    case Schema.print schema value of
        Err issues →
            Err (Unprintable issues)
        Ok contents →
            if 2 * (units key + units contents) + 64 > 2000000 then
                Err TooLarge
            else if Native.kvPut (kv ctx) key contents then
                Ok ⊤
            else
                Err Full


--| Delete the key and report whether it existed.
pub delete : Context msg, String → Bool
delete ctx key = Native.kvDelete (kv ctx) key


--| Keys with that prefix, in order.
pub keys : Context msg, String → List String
keys ctx prefix = Native.kvKeys (kv ctx) prefix


kv : Context msg → Native.KV
kv ctx =
    case Native.kv (Object.hostState ctx) of
        Just store →
            store
        Nothing →
            Protocol.defect
                "the object's storage is not SQLite-backed: give the class \"storage\": \"sqlite\" in the Wrangler configuration (boundary.md §9.12 (h), (i))"
