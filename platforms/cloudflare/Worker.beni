--! The `cloudflare` platform (`docs/design/boundary.md` §9.12): a Worker
--! whose `fetch` is an ordinary beni function, `Context, Request →
--! Response`, with its effects inferred. Each request runs on a scheduler
--! of its own (`Task.withScheduler`), so a fiber resumes only in the
--! request's own I/O context, and a defect fails only its own request.
--!
--! `Program` is a `foreign type`, so the only way to get one is
--! `Worker.program`: the unforgeable-capability shape of §5. A `Request`
--! and a `Response` are the host's objects, read and built through the
--! functions here, because a 101 answer carries the host's socket and the
--! request a Worker forwards must be the one the host made (§9.12 (d)).
--!
--!     main : Program
--!     main =
--!         Worker.program { fetch = route, objects = [] }
--!
--!     route : Worker.Context, Request → Response
--!     route ctx request =
--!         case Worker.path request of
--!             "/" →
--!                 Worker.text 200 "hello"
--!
--!             _ →
--!                 Worker.text 404 "no such page"
--!
--! Every failure the host documents for a stub or a service is one
--! constructor of a typed error, and any other failure is a defect, as
--! `Io.readFile` does it (§4.1, `CLAUDE.md` rule 9). The sibling
--! `Worker.js` holds the two places the host throws for ordinary input
--! (a redirect target, an object id); everything else is beni over `Js`.

import Browser.Host.Cloudflare as Native
import Browser.Host.Data as Data
import Browser.Host.Headers as Headers
import Browser.Host.Promise as Promise
import Browser.Host.RegExp as RegExp
import Browser.Host.Rejection as Rejection
import Browser.Host.Request as HostRequest
import Browser.Host.Response as HostResponse
import Browser.Host.Timers as Timers
import Browser.Host.URL as URL
import Js
import Js.Fifo as Fifo
import Js.Protocol as Protocol
import List
import Maybe
import Schema exposing (Schema)
import String
import Task exposing (Scheduler)


type alias V =
    Js.Value


--| What `main` is: a Worker, built by `program`.
pub type alias Program =
    Native.Program


--| A request's context: its bindings (`env`), its execution context and
--| its scheduler.
pub opaque type Context
    = Context Env Native.ExecutionContext Scheduler


--| A Durable Object class, made by `Worker.Object.define`; `program`'s
--| `objects` lists them, and the entry file exports each by its name.
pub type alias Definition =
    Native.Definition


--| A typed reference to a Durable Object of protocol `msg`: from a
--| `Namespace msg` by name or id (§9.12 (e.10)).
pub opaque type Ref msg
    = Ref
        { stub : Maybe Native.Stub
        , id : String
        , name : Maybe String
        , print : msg → Result (List Schema.Issue) String
        , post : Maybe (msg → ⊤)
        }


--| The host's request, read through the functions below.
pub opaque type Request
    = Request HostRequest.Request (Maybe String)


--| A response: the host's object, built by `text`, `html`, `empty`,
--| `redirect` or `forward`, and checked before the host sees it. An
--| invalid one — a status outside 200 to 599, a body on 204, 205 or 304,
--| a header name that is not a token, a value with a control character, a
--| relative redirect target that does not resolve — is a 500 with an empty
--| body and no header of the program's, and one `console.error` line
--| names the fault (§9.12 (d)).
pub opaque type Response
    = Response HostResponse.Response Bool Bool


--| The Worker's bindings, read by name: each answers `Maybe`, because a
--| binding the configuration does not declare is a mismatch between two
--| files the author owns, never a crash.
pub opaque type Env
    = Env Native.Env


--| A Durable Object binding, as objects of protocol `msg`.
pub opaque type Namespace msg
    = Namespace Native.Namespace (msg → Result (List Schema.Issue) String)


--| A service or assets binding: anything with `fetch`.
pub opaque type Service
    = Service Native.Service


--| Why an id did not parse: the host's `TypeError`, "Invalid Durable
--| Object ID".
pub type IdError
    = InvalidId


--| Why a stub's call failed, sorted by the four properties the host sets
--| on the error (§9.12 (d)):
--|
--| - `Overloaded`: the object is overloaded; send fewer, or spread the
--|   load.
--| - `Reset`: the host reset the object; the call may be made again.
--| - `Transient`: the connection, a shutdown; the call may be made again.
--| - `Cycle`: the call's chain already holds a handler parked in the
--|   object called (§9.12 (e.3)); refused at once.
pub type StubError
    = Overloaded
    | Reset
    | Transient
    | Cycle


--| Why a service call failed: the host's `retryable` error. The call may
--| be made again.
pub type ServiceError
    = Unavailable


-- ---- The program and typed host boundary ----------------------------------

pub program : { fetch : Context, Request → Response, objects : List Definition } → Program
program p = Native.program (λrequest bindings ctx → handle p.fetch request bindings ctx) p.objects


pub env : Context → Env
env (Context bindings _ _) = bindings


pub fromHost : HostResponse.Response → Response
fromHost response = Response response False False


pub hostResponse : Response → HostResponse.Response
hostResponse (Response response _ _) = response


pub makeRequest : HostRequest.Request → Request
makeRequest request = Request request Nothing


pub hostRequest : Request → HostRequest.Request
hostRequest (Request request _) = request


pub requestWithBody : HostRequest.Request, String → Request
requestWithBody request body = Request request (Just body)


pub requestBody : Request → String
requestBody (Request _ body) = Maybe.withDefault body ""


pub wrapEnv : Native.Env → Env
wrapEnv bindings = Env bindings


pub nativeEnv : Env → Native.Env
nativeEnv (Env bindings) = bindings


-- Read the live handler's chain, rather than a snapshot taken before consume.
draining : Js.Ref (Maybe (⊤ → Maybe String))
draining = Js.ref Nothing


pub setDraining : Maybe (⊤ → Maybe String) → ⊤
setDraining getter = Js.write draining getter


pub chainNow : ⊤ → String
chainNow ⊤ =
    chain =
        case Js.read draining of
            Nothing →
                Nothing
            Just current →
                Protocol.call current ⊤
    case chain of
        Nothing →
            Native.randomUUID ⊤
        Just current →
            current


type alias Trampoline =
    tasks : Js.Ref (Fifo.Fifo (⊤ → ⊤))
    wake : Js.Ref (Maybe (Promise.Resolvers ⊤))
    answer : Promise.Resolvers HostResponse.Response
    answered : Js.Ref Bool


handle :
      (Context, Request → Response)
    , HostRequest.Request
    , Native.Env
    , Native.ExecutionContext
    → Promise.Promise HostResponse.Response
handle fetch request bindings ctx =
    if Js.testHooks ⊤ then
        if String.startsWith (Native.requestPath request) "/__beni/" then
            hooked request
        else
            serve fetch request bindings ctx
    else
        serve fetch request bindings ctx


hooked : HostRequest.Request → Promise.Promise HostResponse.Response
hooked request =
    at = Native.requestPath request
    response =
        if String.startsWith at "/__beni/mark/" then
            Native.consoleLog "beni:mark ${String.dropLeft at 13}"
            Native.consoleError "beni:mark ${String.dropLeft at 13}"
            empty 204
        else if at == "/__beni/schedulers" then
            build 200 (Just (String.fromInt (Task.schedulersListed ⊤))) []
        else if at == "/__beni/holds" then
            build 200 (Just (String.fromInt (Js.read holds))) []
        else
            build 404 (Just "no such hook") []
    d = Native.responseResolvers ⊤
    Promise.resolve d (hostResponse response)
    Promise.promise d


serve :
      (Context, Request → Response)
    , HostRequest.Request
    , Native.Env
    , Native.ExecutionContext
    → Promise.Promise HostResponse.Response
serve fetch request bindings ctx =
    d = Native.responseResolvers ⊤
    t = { tasks = Js.ref (Fifo.make ⊤), wake = Js.ref Nothing, answer = d, answered = Js.ref False }
    arm t
    holder = Js.ref Nothing
    scheduler = Task.schedulerWith (runLater t _) (laterTurn t _) λ⊤ →
        case Js.read holder of
            Nothing →
                ⊤
            Just s →
                stop ctx s
    Js.write holder (Just scheduler)
    context = Context (Env bindings) ctx scheduler
    Protocol.call
        (λ⊤ →
            Task.withScheduler scheduler λ⊤ →
                _ = Task.spawnDetached λ⊤ →
                    response = fetch context (makeRequest request)
                    Js.write t.answered True
                    Promise.resolve d (hostResponse response)
                ⊤
        )
        ⊤
    listenForAbort request ctx scheduler
    _ = Promise.after (Promise.promise d) λ_ → answered ctx scheduler
    Promise.promise d


arm : Trampoline → ⊤
arm t =
    d = Promise.unitResolvers ⊤
    Js.write t.wake (Just d)
    Promise.observe (Promise.after (Promise.promise d) λ⊤ → fire t) (λ⊤ → ⊤) (failed t _)


failed : Trampoline, Rejection.Rejection → ⊤
failed t reason =
    if Js.read t.answered then
        Native.consoleReason "beni: a defect after the answer stopped the request's fibers:" reason
        Rejection.raise reason
    else
        Promise.reject t.answer reason


laterTurn : Trampoline, (⊤ → ⊤) → ⊤
laterTurn t task =
    _ = Timers.start (λ⊤ → runLater t task) 0
    ⊤


fire : Trampoline → ⊤
fire t =
    arm t
    -- Replace the queue before callbacks can append the next batch.
    tasks = Js.read t.tasks
    Js.write t.tasks (Fifo.make ⊤)
    fireTasks tasks


fireTasks : Fifo.Fifo (⊤ → ⊤) → ⊤
fireTasks tasks =
    if not (Fifo.empty tasks) then
        Protocol.call (Fifo.shift tasks) ⊤
        fireTasks tasks


runLater : Trampoline, (⊤ → ⊤) → ⊤
runLater t task =
    Fifo.push (Js.read t.tasks) task
    case Js.read t.wake of
        Nothing →
            ⊤
        Just wake →
            Promise.resolve wake ⊤


answered : Native.ExecutionContext, Scheduler → ⊤
answered ctx scheduler =
    if Task.schedulerBusy scheduler then
        Js.write holds (Js.read holds + 1)
        Native.waitUntil ctx (heldUntilIdle scheduler)
    else
        Task.stopScheduler scheduler cleanupDeadline λ_ → ⊤


holds : Js.Ref Int
holds = Js.ref 0


deadline : Int
deadline = 25000


cleanupDeadline : Int
cleanupDeadline = 1000


heldUntilIdle : Scheduler → Promise.Promise ⊤
heldUntilIdle scheduler =
    d = Promise.unitResolvers ⊤
    finished = Js.ref False
    finish ⊤ =
        if not (Js.read finished) then
            Js.write finished True
            Js.write holds (Js.read holds - 1)
            Promise.resolve d ⊤
    timer = Timers.start (λ⊤ → Task.stopScheduler scheduler cleanupDeadline λ_ → finish ⊤) deadline
    Task.onSchedulerIdle scheduler λ⊤ →
        Timers.clear timer
        Task.stopScheduler scheduler cleanupDeadline λ_ → finish ⊤
    Promise.promise d


stop : Native.ExecutionContext, Scheduler → ⊤
stop ctx scheduler =
    d = Promise.unitResolvers ⊤
    Task.stopScheduler scheduler cleanupDeadline λ_ → Promise.resolve d ⊤
    Native.waitUntil ctx (Promise.promise d)


listenForAbort : HostRequest.Request, Native.ExecutionContext, Scheduler → ⊤
listenForAbort request ctx scheduler =
    case Native.requestSignal request of
        Nothing →
            ⊤
        Just signal →
            Native.onAbort signal λ⊤ → stop ctx scheduler


-- ---- The request ------------------------------------------------------------

--| The method, in upper case, as the host gives it.
pub method : Request → String
method request = Native.requestMethod (hostRequest request)


--| The full URL as the host gives it: `"https://h/arena/x/ws?k=v"`.
pub url : Request → String
url request = Native.requestUrl (hostRequest request)


--| The URL's `pathname`: `"/arena/x/ws"`.
pub path : Request → String
path request = Native.requestPath (hostRequest request)


--| The header's value, the name in any case; the host joins repeats with
--| `", "`. `Nothing` when the request has none.
pub header : Request, String → Maybe String
header request name =
    if validName name then
        Headers.get (Native.requestHeaders (hostRequest request)) name
    else
        Nothing


--| Every header, names lower-cased and sorted by name as the host keeps
--| them, repeats joined with `", "`.
pub headers : Request → List (String × String)
headers request = Headers.entries (Native.requestHeaders (hostRequest request))


-- ---- The response -----------------------------------------------------------

--| A text body, `content-type: text/plain; charset=utf-8`.
pub text : Int, String → Response
text status body = build status (Just body) [ ( "content-type", "text/plain; charset=utf-8" ) ]


--| An HTML body, `content-type: text/html; charset=utf-8`.
pub html : Int, String → Response
html status body = build status (Just body) [ ( "content-type", "text/html; charset=utf-8" ) ]


--| No body.
pub empty : Int → Response
empty status = build status Nothing []


--| A redirect: `location` is the target resolved against the request's
--| URL, and the status is 301, 302, 303, 307 or 308.
pub redirect : Request, String, Int → Response
redirect request target status =
    if not (List.member [ 301, 302, 303, 307, 308 ] status) then
        invalid "a redirect's status is 301, 302, 303, 307 or 308, not ${String.fromInt status}"
    else
        case resolveUrl target (url request) of
            Just location →
                build status Nothing [ ( "location", location ) ]

            Nothing →
                invalid
                    "the redirect target \"${target}\" does not resolve against the request's URL"


--| The header appended; a repeated name is written twice. A name that
--| begins with `x-beni-`, in any case, is the platform's alone, and the
--| response becomes invalid (§9.12 (d)).
pub withHeader : Response, String, String → Response
withHeader (Response r own bad) name value =
    if bad then
        Response r own bad
    else if String.startsWith (String.toLower name) "x-beni-" then
        invalid "the header name \"${name}\" is the platform's: x-beni- names are refused"
    else if not (validName name) then
        invalid "the header name \"${name}\" is not a token"
    else if not (validValue value) then
        invalid "the value of the header \"${name}\" holds a control character"
    else if own then
        Headers.append (HostResponse.headers r) name value
        Response r own bad
    else if HostResponse.status r == 101 then
        invalid
            "a header cannot be added to a 101 answer from an object: its socket cannot be copied"
    else
        copy = Native.responseCopy r
        Headers.append (HostResponse.headers copy) name value
        Response copy True bad


-- Build the host's `Response` once every rule holds (§9.12 (d)).
build : Int, Maybe String, List (String × String) → Response
build status body hs =
    if
        not (Data.isInteger (Js.from status))
            || status < 200
            || status > 599
    then
        invalid "a status is an integer from 200 to 599, not ${String.fromInt status}"
    else if (status == 204 || status == 205 || status == 304) && bodyPresent body then
        invalid "a ${String.fromInt status} response takes no body"
    else if List.any hs λ( name, value ) → not (validName name) || not (validValue value) then
        invalid "a header name is a token, and its value holds no control character"
    else
        Response (construct status body hs) True False


bodyPresent : Maybe String → Bool
bodyPresent body =
    case body of
        Just s →
            not (String.isEmpty s)

        Nothing →
            False


construct : Int, Maybe String, List (String × String) → HostResponse.Response
construct status body hs = Native.responseCreate status body hs


-- An invalid response is a 500 with an empty body and no header of the
-- program's, and one `console.error` line names the fault, in both builds
-- (§9.12 (d)). Not a defect, for §9.10 (d)'s reason.
invalid : String → Response
invalid fault =
    Native.consoleError "beni: invalid response: ${fault}"
    Response (Native.responseCreate 500 Nothing []) True True


validName : String → Bool
validName name = testPattern "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" name


validValue : String → Bool
validValue value = not (testPattern "[\\r\\n\\x00]" value)


-- `new URL(target, base)`, whose `TypeError` from that call alone is the
-- fault (§9.12 (d)): `Js.catchIf` names it, and throws anything else
-- again (`CLAUDE.md` rule 9).
resolveUrl : String, String → Maybe String
resolveUrl target base = Maybe.map (URL.tryCreate target base) URL.href


-- ---- The bindings -----------------------------------------------------------

--| The Durable Object binding of that name, as objects of that protocol:
--| the schema is the one their `define` took (§9.12 (e.10)). `Nothing` when
--| the binding is not declared, or is not a namespace.
pub objects : Env, String, Schema e msg → Maybe (Namespace msg)
objects (Env bindings) name schema = Maybe.map (Native.namespace bindings name) λns →
    Namespace ns (Schema.print schema _)


--| A service or assets binding: an object whose `fetch` is a function.
pub service : Env, String → Maybe Service
service (Env bindings) name = Maybe.map (Native.service bindings name) Service


--| A plain-text variable or secret.
pub var : Env, String → Maybe String
var (Env bindings) name = Native.variable bindings name


-- ---- Durable Object references --------------------------------------------

--| The one object of that name: `getByName`.
pub byName : Namespace msg, String → Ref msg
byName (Namespace ns print) name = remoteRef (Native.byName ns name) (Just name) print


--| A fresh object: `newUniqueId`, then `get`; its id is `refId`.
pub unique : Namespace msg → Ref msg
unique (Namespace ns print) = remoteRef (Native.getStub ns (Native.uniqueId ns)) Nothing print


--| The object of an id a `unique` ref reported through `refId`:
--| `idFromString`.
pub byId : Namespace msg, String → Result IdError (Ref msg)
byId (Namespace ns print) idText =
    case Native.idFromString ns idText of
        Nothing →
            Err InvalidId
        Just id →
            Ok (remoteRef (Native.getStub ns id) Nothing print)


-- `idFromString`, whose `TypeError` is "Invalid Durable Object ID":
-- `Js.catchIf` names it, and throws anything else again (`CLAUDE.md`
-- rule 9).

--| The object's id, 64 hex digits.
pub refId : Ref msg → String
refId (Ref ref) = ref.id


--| The name `byName` was given; `Nothing` otherwise.
pub refName : Ref msg → Maybe String
refName (Ref ref) = ref.name


--| Forward the request to the object and wait for its answer: the host's
--| `Response`, its body stream untouched, so a 101 and a streamed body
--| pass through. The call carries the chain id of §9.12 (e.3): the
--| running handler's from an object, or from a Worker a fresh one per
--| call, after any `x-beni-chain` the client sent is stripped, since a
--| Worker parks in no object and so begins no cycle.
--| Every failure the host documents is a `StubError`; a refused
--| cycle is read off the answer (508 with `x-beni-cycle: 1`); anything
--| else is a defect.
pub forward : Ref msg, Request → Result StubError Response
forward ref request =
    -- A client reaches no path of the platform's: `/__beni/` paths are the
    -- platform's own — the test hooks, and the marks of (k) — so one is
    -- answered 404 here and never sent, except the hooks of a
    -- `--test-hooks` build, which a fixture drives through `forward`. The
    -- messages between objects travel over RPC, not over a path ((e.11)).
    if reserved (path request) then
        Ok (text 404 "no such page")
    else
        send ref request


reserved : String → Bool
reserved at =
    if not (String.contains at "/__beni/") then
        False
    else if Js.testHooks ⊤ then
        not
            (String.endsWith at "/__beni/tick"
                || String.endsWith at "/__beni/alarm"
                || String.endsWith at "/__beni/hold"
            )
    else
        True


send : Ref msg, Request → Result StubError Response
send (Ref ref) request =
    case ref.stub of
        Nothing →
            Err Cycle
        Just stub →
            hs = Headers.create ⊤
            each (headers request) λ( name, value ) →
                if not (String.startsWith name "x-beni-") then Headers.append hs name value
            Headers.set hs "x-beni-chain" (chainNow ⊤)
            case settleHost (Native.stubFetch stub (Native.requestCopy (hostRequest request) hs)) of
                Ok response →
                    if
                        HostResponse.status response == 508
                            && Headers.get (HostResponse.headers response) "x-beni-cycle"
                                == Just "1"
                    then
                        Err Cycle
                    else
                        Ok (fromHost response)
                Err reason →
                    if Native.overloaded reason then
                        Err Overloaded
                    else if Native.reset reason then
                        Err Reset
                    else if Native.retryable reason then
                        Err Transient
                    else
                        Rejection.raise reason


--| Call a service or assets binding and wait for its answer. `Unavailable`
--| when the host's error is `retryable`; anything else is a defect.
pub callService : Service, Request → Result ServiceError Response
callService (Service svc) request =
    case settleHost (Native.serviceFetch svc (hostRequest request)) of
        Ok response →
            Ok (fromHost response)
        Err reason →
            if Native.retryable reason then Err Unavailable else Rejection.raise reason


-- Park on a host promise: `Ok` its value, `Err` its reason, as the fiber's
-- own result, so the caller sorts the reason and throws what it does not
-- name from the fiber, where a throw is a defect (`CLAUDE.md` rule 9). The
-- reaction only resumes; it catches nothing. `Worker.Object` has its own.
pub settleHost : Promise.Promise a → Result Rejection.Rejection a
settleHost promise = Task.callback λresume →
    Promise.observe promise (λvalue → Task.resume resume (Ok value)) λreason →
        Task.resume resume (Err reason)
    λ⊤ → ⊤


remoteRef : Native.Stub, Maybe String, (msg → Result (List Schema.Issue) String) → Ref msg
remoteRef stub name print =
    Ref
        { stub = Just stub
        , id = Native.idText (Native.stubId stub)
        , name = name
        , print = print
        , post = Nothing
        }


pub selfRef : String, Maybe String, (msg → Result (List Schema.Issue) String), (msg → ⊤) → Ref msg
selfRef id name print post =
    Ref { stub = Nothing, id = id, name = name, print = print, post = Just post }


pub refStub : Ref msg → Maybe Native.Stub
refStub (Ref ref) = ref.stub


pub refPost : Ref msg → Maybe (msg → ⊤)
refPost (Ref ref) = ref.post


pub printRef : Ref msg, msg → Result (List Schema.Issue) String
printRef (Ref ref) message = ref.print message


testPattern : String, String → Bool
testPattern pattern value =
    case RegExp.create pattern "" of
        Ok regex →
            RegExp.test regex value
        Err _ →
            False


each : List a, (a → ⊤) → ⊤
each values action =
    case values of
        [] →
            ⊤
        [ first, …rest ] →
            action first
            each rest action
