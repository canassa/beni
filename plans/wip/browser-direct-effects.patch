+
+-- The program's own state beside the model: its scope, the bodies running
+-- under each key path, and the live subscriptions by key.
+type alias State model msg =
+    model : model
+    scope : Scope
+    jobs : Dict (List Key) (List (Run msg))
+    live : Lives msg
+
+
+-- The live subscriptions: `Idle` until the first `Sub.Listen`. Only the
+-- diff of one makes a `Running`, so a program that never subscribes
+-- ships no code that cancels one (`docs/design/backend.md` §9, *A `case`
+-- arm on a constructor nothing builds*).
+type Lives msg
+    = Idle
+    | Running (Dict Key (Live msg))
+
+
+-- A keyed body that has not been forgotten, and the outlet its `send` goes
+-- through: in a fiber, or queued to run with none (`boundary.md`
+-- §9.8.11). Only a `Keyed` command makes an `InFiber`, so a program whose
+-- keyed bodies never wait reaches none of what waits for or cancels a
+-- fiber: every such step is in an `InFiber` arm.
+type Run msg
+    = InFiber (Fiber ⊤) (Outlet msg)
+    | Queued Soon (Outlet msg)
+
+
+-- A live subscription: the relay its values go through, and what stops it
+-- when its key leaves — cancel the fiber that runs its body, or remove its
+-- listener (`boundary.md` §9.8.5). Only a `Hosted.Waits` declaration makes
+-- the first in a release build, so a program whose subscriptions all
+-- listen cancels no fiber.
+type alias Live msg =
+    relay : Relay msg
+    stop : Scope → ⊤
+
+
+start : Host msg, model × Cmd msg → State model msg
+start host ( model, cmd ) =
+    perform host cmd { model = model, scope = Task.openRoot ⊤, jobs = Dict.empty, live = Idle }
+
+
+step : Host msg, model × Cmd msg, State model msg → State model msg
+step host ( model, cmd ) state = perform host cmd { state | model = model }
+
+
+perform : Host msg, Cmd msg, State model msg → State model msg
+perform host cmd state = List.foldl (Cmd.items cmd) state λit s → item host it s
+
+
+item : Host msg, Item msg, State model msg → State model msg
+item host it state =
+    case it of
+        Perform job →
+            _ = spawn host state.scope job
+            state
+
+        Now job →
+            _ = queue host job
+            state
+
+        -- An item's path is outermost segment first (`Cmd.Item`), so a
+        -- prefix is a component and those inside.
+        Keyed path policy job →
+            keyed host path policy job state
+
+        KeyedNow path policy job →
+            keyedNow host path policy job state
+
+        Cancel path →
+            stopped state.scope (runsAt state path) { state | jobs = Dict.remove state.jobs path }
+
+        CancelAll prefix →
+            ( gone, kept ) = Dict.partition state.jobs λpath _ → startsWith path prefix
+            -- Each list is oldest first and `stopped` walks one from its end
+            -- (`runsAt`), so the lists go in reverse key order: the first
+            -- key's newest body is still the first stopped.
+            { state
+                | jobs = stopped state.scope (List.concat (List.reverse (Dict.values gone))) kept
+            }
+
+        After work →
+            Hosted.afterRender host work
+            state
+
+
+-- A keyed body that may wait.
+keyed : Host msg, List Key, Policy, Job msg, State model msg → State model msg
+keyed host path policy job state =
+    old = List.filter (runsAt state path) running
+    case ( policy, old ) of
+        ( _, [] ) →
+            put state path [ spawn host state.scope job ]
+
+        ( Restart, _ ) →
+            closing old (put state path [ spawnAfter host state.scope (λ⊤ → stop old) job ])
+
+        ( Ignore, _ ) →
+            state
+
+        ( Queue, _ ) →
+            put state path [ spawnAfter host state.scope (λ⊤ → waitFor old) job ]
+
+        ( Concurrent, _ ) →
+            put state path [ …old, spawn host state.scope job ]
+
+
+-- A keyed body that never waits: queued as a fiber would have been
+-- spawned, unless a body it must wait for is in a fiber.
+keyedNow : Host msg, List Key, Policy, Job msg, State model msg → State model msg
+keyedNow host path policy job state =
+    old = List.filter (runsAt state path) running
+    case ( policy, old ) of
+        ( _, [] ) →
+            put state path [ queue host job ]
+
+        ( Restart, _ ) →
+            closing old (put state path [ (starter policy old) host state.scope job ])
+
+        ( Ignore, _ ) →
+            state
+
+        ( Queue, _ ) →
+            put state path [ (starter policy old) host state.scope job ]
+
+        ( Concurrent, _ ) →
+            put state path [ …old, queue host job ]
+
+
+-- How a body that never waits starts once `old` have ended (`Restart`
+-- having closed them): queued, when none is in a fiber — work queued
+-- before it runs, to its end, before it — and otherwise in a fiber that
+-- cancels them (`Restart`) or waits for them (`Queue`) first, since only a
+-- fiber can wait. The fiber is reached only through an `InFiber` arm.
+starter : Policy, List (Run msg) → (Host msg, Scope, Job msg → Run msg)
+starter policy old = List.foldr old (λhost _ job → queue host job) λr otherwise →
+    startAfter policy old r otherwise
+
+
+startAfter :
+      Policy
+    , List (Run msg)
+    , Run msg
+    , (Host msg, Scope, Job msg → Run msg)
+    → (Host msg, Scope, Job msg → Run msg)
+startAfter policy old r otherwise =
+    case r of
+        InFiber _ _ →
+            λhost scope job → spawnAfter host scope (λ⊤ → settleFirst policy old) job
+
+        Queued _ _ →
+            otherwise
+
+
+settleFirst : Policy, List (Run msg) → ⊤
+settleFirst policy old =
+    case policy of
+        Restart →
+            stop old
+
+        _ →
+            waitFor old
+
+
+-- Start a body in a fiber of the program's scope, with an outlet of its
+-- own as its `send`.
+spawn : Host msg, Scope, Job msg → Run msg
+spawn host scope job =
+    o = Hosted.outlet host
+    InFiber (Task.spawnIn scope λ⊤ → Hosted.runJob job (Hosted.emit o _)) o
+
+
+-- The same, once `first` has returned.
+spawnAfter : Host msg, Scope, (⊤ → ⊤), Job msg → Run msg
+spawnAfter host scope first job =
+    spawn host scope (Hosted.job λsend → after (first ⊤) (Hosted.runJob job send))
+
+
+-- Queue a body that never waits where a fiber spawned now would first
+-- run, with an outlet of its own as its `send`.
+queue : Host msg, Job msg → Run msg
+queue host job =
+    o = Hosted.outlet host
+    Queued (Task.soon λ⊤ → Hosted.callJob job (Hosted.emit o _)) o
+
+
+running : Run msg → Bool
+running r =
+    case r of
+        InFiber fiber _ →
+            Task.running fiber
+
+        Queued soon _ →
+            Task.queued soon
+
+
+-- The bodies running at a key path, oldest first: a `Concurrent` body is
+-- added at the end, where a list grows, and every walk of the list below
+-- goes from its end, so the newest is closed, stopped and waited for first.
+runsAt : State model msg, List Key → List (Run msg)
+runsAt state path = Maybe.withDefault (Dict.get state.jobs path) []
+
+
+put : State model msg, List Key, List (Run msg) → State model msg
+put state path runs = { state | jobs = Dict.insert state.jobs path runs }
+
+
+-- Close the outlets of `runs` now, so nothing they send after this message
+-- lands, and cancel the fibers in one of the scope's own. A body still
+-- queued runs to its end, as a fiber not yet started runs to its first
+-- wait before its cancellation can reach it.
+stopped : Scope, List (Run msg), a → a
+stopped scope runs value =
+    closing runs ⊤
+    (cancelling runs) scope
+    value
+
+
+-- What cancels the fibers of `runs`: nothing when none is a fiber.
+cancelling : List (Run msg) → (Scope → ⊤)
+cancelling runs = List.foldr runs (λ_ → ⊤) λr k → canceller runs r k
+
+
+canceller : List (Run msg), Run msg, (Scope → ⊤) → (Scope → ⊤)
+canceller runs r k =
+    case r of
+        InFiber _ _ →
+            λscope →
+                _ = Task.spawnIn scope λ⊤ → stop runs
+                ⊤
+
+        Queued _ _ →
+            k
+
+
+closing : List (Run msg), a → a
+closing runs value = List.foldr runs value λr v → after (close r) v
+
+
+close : Run msg → ⊤
+close r =
+    case r of
+        InFiber _ o →
+            Hosted.close o
+
+        Queued _ o →
+            Hosted.close o
+
+
+-- Cancel each fiber and wait for its cleanup.
+stop : List (Run msg) → ⊤
+stop runs = List.foldr runs ⊤ λr _ → stopOne r
+
+
+stopOne : Run msg → ⊤
+stopOne r =
+    case r of
+        InFiber fiber _ →
+            Task.cancel fiber
+
+        Queued _ _ →
+            ⊤
+
+
+-- Wait for each fiber to end. Work queued before the fiber that waits runs
+-- before it.
+waitFor : List (Run msg) → ⊤
+waitFor runs = List.foldr runs ⊤ λr _ → waitOne r
+
+
+waitOne : Run msg → ⊤
+waitOne r =
+    case r of
+        InFiber fiber _ →
+            ended (Task.wait fiber)
+
+        Queued _ _ →
+            ⊤
+
+
+ended : Exit a → ⊤
+ended _ = ⊤
+
+
+after : ⊤, a → a
+after _ value = value
+
+
+startsWith : List Key, List Key → Bool
+startsWith path prefix =
+    case ( path, prefix ) of
+        ( _, [] ) →
+            True
+
+        ( [ p, …ps ], [ q, …qs ] ) →
+            if p == q then
+                startsWith ps qs
+            else
+                False
+
+        _ →
+            False
+
+
+-- The subscription diff, once per render: keys that left are cancelled,
+-- keys that stayed keep their fiber and take their new taggers, keys that
+-- arrived start. With no `Listen` and nothing running there is nothing to
+-- do, and a program that never subscribes reaches no more than that.
+settle : Host msg, Sub msg, State model msg → State model msg
+settle host sub state =
+    case sub of
+        Sub.Listen declared →
+            { state | live = Running (diff host state.scope declared (lives state.live)) }
+
+        Sub.None →
+            case state.live of
+                Idle →
+                    state
+
+                Running live →
+                    { state | live = Running (diff host state.scope [] live) }
+
+
+lives : Lives msg → Dict Key (Live msg)
+lives l =
+    case l of
+        Idle →
+            Dict.empty
+
+        Running live →
+            live
+
+
+-- Each key's declarations: how the first runs, which decides whether a
+-- fiber runs it, and every one's tap, in order.
+type alias Wanted msg =
+    Dict Key (Kind × List (Tap msg))
+
+
+diff : Host msg, Scope, List (Key × Kind × Tap msg), Dict Key (Live msg) → Dict Key (Live msg)
+diff host scope declared live =
+    wanted = List.foldl declared Dict.empty λ( k, kind, t ) d → want k kind t d
+    kept = Dict.foldl live Dict.empty λk l d → keep scope wanted k l d
+    Dict.foldl wanted kept λk ( kind, taps ) d → arrive host scope k kind taps d
+
+
+want : Key, Kind, Tap msg, Wanted msg → Wanted msg
+want k kind t d =
+    ( first, taps ) = Maybe.withDefault (Dict.get d k) ( kind, [] )
+    Dict.insert d k ( first, List.append taps [ t ] )
+
+
+keep : Scope, Wanted msg, Key, Live msg, Dict Key (Live msg) → Dict Key (Live msg)
+keep scope wanted k l d =
+    case Dict.get wanted k of
+        Just ( _, taps ) →
+            Hosted.retap l.relay taps
+            Dict.insert d k l
+
+        Nothing →
+            l.stop scope
+            d
+
+
+arrive : Host msg, Scope, Key, Kind, List (Tap msg), Dict Key (Live msg) → Dict Key (Live msg)
+arrive host scope k kind taps d =
+    case ( Dict.member d k, taps ) of
+        ( False, [ first, …_ ] ) →
+            r = Hosted.relay host first
+            Hosted.retap r taps
+            Dict.insert d k { relay = r, stop = begin scope r kind }
+
+        _ →
+            d
+
+
+-- A body runs in a fiber spawned into the program's scope; a listener runs
+-- with none — unless a development build's page asked, through the test
+-- hook, for every listener to run in a fiber as it did before
+-- (`boundary.md` §9.8.5).
+begin : Scope, Relay msg, Kind → (Scope → ⊤)
+begin scope r kind =
+    case kind of
+        Waits →
+            inFiber scope r λ⊤ → Hosted.run r
+
+        Hears →
+            if Js.development ⊤ then
+                if Hosted.fibered ⊤ then
+                    inFiber scope r λ⊤ → Hosted.runHeard r
+                else
+                    hear r
+            else
+                hear r
+
+
+-- When the key leaves, the relay is closed at once, so nothing the body
+-- sends after lands, and the fiber is cancelled from one of the scope's
+-- own.
+inFiber : Scope, Relay msg, (⊤ → ⊤) → (Scope → ⊤)
+inFiber scope r body =
+    fiber = Task.spawnIn scope body
+
+    λs →
+        Hosted.closeRelay r
+        _ = Task.spawnIn s λ⊤ → Task.cancel fiber
+        ⊤
+
+
+-- When the key leaves, the listener is removed at once.
+hear : Relay msg → (Scope → ⊤)
+hear r =
+    Hosted.hear r
+    λ_ → Hosted.unhear r
+
+
+-- The compiled host keeps driver state apart from the user model.
+pub open : Host msg → State ⊤ msg
+open _ = { model = ⊤, scope = Task.openRoot ⊤, jobs = Dict.empty, live = Idle }
+
+
+pub commands : Host msg, Cmd msg, State ⊤ msg → State ⊤ msg
+commands host cmd state = perform host cmd state
+
+
+pub subscriptions : Host msg, Sub msg, State ⊤ msg → State ⊤ msg
+subscriptions host sub state = settle host sub state
