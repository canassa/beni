--! URLs (`docs/design/boundary.md` §9.8.13 (a)): Elm's `Url` (elm/url) —
--! its record, its two protocols, its parser and printer, and percent
--! encoding. Pure, so a library, a `node` program and a test can use it; a
--! page gets its own address from `Browser.Navigation.currentUrl`.
--!
--! `fromString` is the URL Standard's parser for `http` and `https`,
--! written here in beni (§9.8.13 (a), its amendment of 2026-10-29), so an
--! engine with no WHATWG `URL` makes the `Url` a browser makes: its parts
--! are normalised as the standard normalises them, exactly as the host's
--! `URL` does, but a host written in Unicode is `Nothing`. Nothing is
--! decoded: `query` and `fragment` are escaped as the standard escapes
--! them, so a query parser can still tell a `&` that separates from one
--! that was escaped.

import Js


--| A URL, split into its parts.
--|
--|     https://example.com:8042/over/there?name=ferret#nose
--|     \___/   \______/ \__/\_________/ \_________/ \__/
--|       |        |      |       |           |        |
--|     scheme   host    port   path        query   fragment
pub type alias Url =
    protocol : Protocol
    host : String
    port_ : Maybe Int
    path : String
    query : Maybe String
    fragment : Maybe String


--| Only `http` and `https`, as Elm's: a page served any other way has no
--| `Url`.
pub type Protocol
    = Http
    | Https


--| The parts of an absolute `http` or `https` URL, or `Nothing` for
--| anything else: text the URL standard does not parse (no scheme, a port
--| that is not a number), another scheme, or user information (`tom@`),
--| which the record cannot hold.
--|
--| The parts are normalised as a browser normalises the address it goes
--| to: the scheme and host lower-cased, `.` and `..` resolved, the
--| scheme's default port dropped, and what a URL may not hold escaped (a
--| space is `%20`). A bare `?` or `#` is `Just ""`. A host written in
--| Unicode (`bücher.de`) is `Nothing`; its ASCII form (`xn--bcher-kva.de`),
--| which is what a browser gives, parses.
--|
--|     Url.fromString "HTTPS://Example.com:443/hats/../caps?q=top%20hat"
--|     -- Just { protocol = Https, host = "example.com", port_ = Nothing,
--|     --        path = "/caps", query = Just "q=top%20hat", fragment = Nothing }
pub fromString : String → Maybe Url
fromString str = Js.pure λ⊤ →
    -- The URL Standard's basic URL parser, for a special scheme and no
    -- base (`boundary.md` §9.8.13 (a), its amendment of 2026-10-29): C0
    -- controls and spaces trimmed, tabs and newlines removed, then the
    -- scheme, every `/` and `\` after it, the authority, the path, the
    -- query and the fragment.
    trimmed =
        Js.call (Js.call (Js.from str) "replace" [ Js.regExp "^[\\0- ]+" "", Js.from "" ]) "replace"
            [ Js.regExp "[\\0- ]+$" "", Js.from "" ]
    input = Js.call (Js.call trimmed "split" [ Js.regExp "[\\t\\n\\r]" "" ]) "join" [ Js.from "" ]
    parts =
        Js.call
            (Js.regExp "^(https?):[\\/\\\\]*([^\\/\\\\?#]*)([^?#]*)(?:\\?([^#]*))?(?:#(.*))?$" "is")
            "exec"
            [ input ]
    if Js.isNull parts then
        Nothing
    else
        authority
            (if String.toLower (Js.to (Js.at parts 1)) == "http" then Http else Https)
            (Js.to (Js.at parts 2))
            (Js.to (Js.at parts 3))
            (Js.at parts 4)
            (Js.at parts 5)


-- `pattern` tested on `s`.
matches : Js.Value, String → Bool
matches pattern s = Js.pure λ⊤ → Js.to (Js.call pattern "test" [ Js.from s ])


-- The authority's last `@` ends the user information, which may only be
-- empty (`http://@host`, `http://:@host`); the port starts at the first
-- `:` outside `[` `]`.
authority : Protocol, String, String, Js.Value, Js.Value → Maybe Url
authority protocol auth rawPath rawQuery rawFragment = Js.pure λ⊤ →
    at : Int
    at = Js.to (Js.call (Js.from auth) "lastIndexOf" [ Js.from "@" ])
    credentials : String
    credentials = Js.to (Js.call (Js.from auth) "slice" [ Js.from 0, Js.from (max at 0) ])
    hostPort =
        Js.call (Js.regExp "^((?:\\[[^\\]]*\\]?|[^:\\[])*)(?::(.*))?$" "s") "exec"
            [ Js.call (Js.from auth) "slice" [ Js.from (at + 1) ] ]
    portText = Js.at hostPort 2
    if credentials == "" || credentials == ":" then
        Maybe.andThen (host (Js.to (Js.at hostPort 1))) λh →
            Maybe.map
                (if Js.isUndefined portText then Just Nothing else port_ (Js.to portText) protocol)
                λp →
                    { protocol = protocol
                    , host = h
                    , port_ = p
                    , path = path rawPath
                    , query =
                        if Js.isUndefined rawQuery then
                            Nothing
                        else
                            Just (escape (Js.to rawQuery) "\"#'<>")
                    , fragment =
                        if Js.isUndefined rawFragment then
                            Nothing
                        else
                            Just (escape (Js.to rawFragment) "\"<>`")
                    }
    else
        Nothing


-- ASCII digits, at most 65535; `Just Nothing` for an empty port or the
-- scheme's default.
port_ : String, Protocol → Maybe (Maybe Int)
port_ digits protocol =
    n : Int
    n = Js.pure λ⊤ → Js.to (Js.apply (Js.global "Number") [ Js.from digits ])
    if not (matches (Js.regExp "^\\d*$" "") digits) || n > 65535 then
        Nothing
    else if digits == "" || n == (if protocol == Http then 80 else 443) then
        Just Nothing
    else
        Just (Just n)


-- The host parser: `[…]` an IPv6 address; otherwise the text
-- percent-decoded, which must be ASCII (a Unicode host is refused rather
-- than mapped by UTS #46, whose tables core does not carry), lower-cased,
-- free of the forbidden domain code points, then an IPv4 address when its
-- last label is a number, or a domain whose `xn--` labels decode.
host : String → Maybe String
host text =
    if text == "" then
        Nothing
    else if String.startsWith text "[" then
        if String.endsWith text "]" then
            Maybe.map
                (ipv6
                    (Js.pure λ⊤ → Js.to (Js.call (Js.from text) "slice" [ Js.from 1, Js.from (-1) ])
                    )
                )
                λa → "[${a}]"
        else
            Nothing
    else if matches (Js.regExp "[^\\0-\\x7f]|%[89a-f][\\da-f]" "i") text then
        Nothing
    else
        domain =
            case String.split text "%" of
                [ first, …rest ] →
                    String.toLower (List.foldl rest first decodeByte)

                [] →
                    text
        labels = numbered (String.split domain ".")
        if matches (Js.regExp "[\\0- #%\\/:<>?@[\\\\\\]^|\\x7f]" "") domain then
            Nothing
        else if
            matches (Js.regExp "^(\\d+|0x[\\da-f]*)$" "") (List.foldl labels "" λlabel _ → label)
        then
            ipv4 labels
        else if List.foldl labels True λlabel ok → ok && idna label then
            Just domain
        else
            Nothing


-- The text after one `%` of a host, decoded when it starts with an ASCII
-- byte's two hex digits.
decodeByte : String, String → String
decodeByte part decoded =
    if matches (Js.regExp "^[0-7][\\da-f]" "i") part then
        Js.pure λ⊤ →
            byte =
                Js.apply (Js.global "parseInt")
                    [ Js.call (Js.from part) "slice" [ Js.from 0, Js.from 2 ], Js.from 16 ]
            decoded
                ++ Js.to (Js.call (Js.global "String") "fromCharCode" [ byte ])
                ++ Js.to (Js.call (Js.from part) "slice" [ Js.from 2 ])
    else
        "${decoded}%${part}"


-- A trailing empty label is not the last one, when there is another.
numbered : List String → List String
numbered labels =
    case labels of
        [ "" ] →
            labels

        [ …init, "" ] →
            init

        _ →
            labels


-- One to four numbers, decimal, `0x` hexadecimal or `0` octal; each but
-- the last at most 255 and the last filling the bytes left.
ipv4 : List String → Maybe String
ipv4 parts =
    count = List.length parts
    ( _, address, ok ) = List.foldl parts ( 1, 0, count ≤ 4 ) λpart ( i, sum, valid ) →
        n = number part
        if i == count then
            ( i + 1, sum + n, valid && 0 ≤ n && n < 256 ^ (5 - count) )
        else
            ( i + 1, sum + n * 256 ^ (4 - i), valid && 0 ≤ n && n < 256 )
    if ok then
        Just
            (String.join
                (List.map [ 3, 2, 1, 0 ] λk → String.fromInt (Int.mod (address // 256 ^ k) 256))
                "."
            )
    else
        Nothing


-- An IPv4 number, or -1.
number : String → Int
number part = Js.pure λ⊤ →
    if matches (Js.regExp "^0[0-7]*$" "") part then
        Js.to (Js.apply (Js.global "parseInt") [ Js.from part, Js.from 8 ])
    else if part == "0x" then
        0
    else if matches (Js.regExp "^(0x[\\da-f]+|[1-9]\\d*)$" "") part then
        Js.to (Js.apply (Js.global "Number") [ Js.from part ])
    else
        -1


-- ---- IPv6 (the URL Standard's IPv6 parser and serializer) ---------------
-- Eight pieces, or at most seven around one `::`; an IPv4 address may be
-- the last two.
ipv6 : String → Maybe String
ipv6 text =
    case String.split text "::" of
        [ whole ] →
            Maybe.andThen (pieces whole True) λps →
                if List.length ps == 8 then Just (serialize ps) else Nothing

        [ left, right ] →
            Maybe.andThen (pieces left False) λl →
                Maybe.andThen (pieces right True) λr →
                    n = List.length l + List.length r
                    if n ≤ 7 then
                        Just
                            (serialize
                                (List.concat
                                    [ l, List.slice [ 0, 0, 0, 0, 0, 0, 0, 0 ] 0 (8 - n), r ]
                                )
                            )
                    else
                        Nothing

        _ →
            Nothing


-- The pieces of one side of `::`: up to four hex digits each, and, when
-- `tail`, an IPv4 address last.
pieces : String, Bool → Maybe (List Int)
pieces side tail =
    items = String.split side ":"
    count = List.length items
    ( _, found ) = List.foldl items ( 1, Just [] ) λitem ( i, acc ) →
        ( i + 1
        , Maybe.andThen acc λps →
            if matches (Js.regExp "^[\\da-f]{1,4}$" "i") item then
                Just
                    (List.concat
                        [ ps
                        , [ Js.pure λ⊤ →
                              Js.to (Js.apply (Js.global "parseInt") [ Js.from item, Js.from 16 ])
                          ]
                        ]
                    )
            else if
                tail
                    && i == count
                    && matches
                        (Js.regExp
                            "^((25[0-5]|(2[0-4]|1\\d|[1-9])?\\d)\\.){3}(25[0-5]|(2[0-4]|1\\d|[1-9])?\\d)$"
                            ""
                        )
                        item
            then
                v4 = List.foldl (String.split item ".") 0 λpart sum → sum * 256 + number part
                Just (List.concat [ ps, [ v4 // 65536, Int.mod v4 65536 ] ])
            else
                Nothing
        )
    if side == "" then Just [] else found


-- Lower-case hex pieces, the first longest run of two or more zero pieces
-- written `::`.
serialize : List Int → String
serialize ps =
    ( _, _, ( start, length ) ) = List.foldl ps ( 0, 0, ( 0, 0 ) ) λp ( i, run, ( s, l ) ) →
        if p == 0 && run + 1 > l then
            ( i + 1, run + 1, ( i - run, run + 1 ) )
        else if p == 0 then
            ( i + 1, run + 1, ( s, l ) )
        else
            ( i + 1, 0, ( s, l ) )
    hexes = List.map ps λp → Js.pure λ⊤ → Js.to (Js.call (Js.from p) "toString" [ Js.from 16 ])
    if length > 1 then
        String.join (List.slice hexes 0 start) ":"
            ++ "::"
            ++ String.join (List.slice hexes (start + length) 8) ":"
    else
        String.join hexes ":"


-- ---- `xn--` labels (UTS #46 for a label already in ASCII) ---------------
-- A label that starts `xn--` must be Punycode (RFC 3492) for a label of
-- some non-ASCII code point, none of them a control, a format character,
-- a surrogate, private use, unassigned, a space, U+3002 or U+FFFD, or of a
-- right-to-left script (whose bidi rule needs tables core does not
-- carry), the first not a combining mark, and the label unchanged by NFKC
-- and lower-casing, which is what UTS #46 maps. Punycode's decoding is one
-- to one, so the label is kept as written (lower-cased): it is the label
-- re-encoded.
idna : String → Bool
idna label =
    if String.startsWith label "xn--" then
        case punycode (String.dropLeft label 4) of
            Just decoded →
                matches (Js.regExp "[^\\0-\\x7f]" "") decoded
                    && not
                        (matches
                            (Js.regExp
                                "[\\p{C}\\p{Z}\\u3002\\uFFFD\\p{sc=Hebr}\\p{sc=Arab}\\p{sc=Syrc}\\p{sc=Thaa}\\p{sc=Nkoo}\\p{sc=Samr}\\p{sc=Mand}\\p{sc=Adlm}\\p{sc=Rohg}\\p{sc=Yezi}]|^\\p{M}"
                                "u"
                            )
                            decoded
                        )
                    && Js.pure λ⊤ →
                        Js.same
                            (Js.call
                                (Js.call (Js.from decoded) "normalize" [ Js.from "NFKC" ])
                                "toLowerCase"
                                []
                            )
                            (Js.from decoded)

            Nothing →
                False
    else
        True


-- The basic code points before the last `-`, which is consumed even when
-- it is the first, as Node's parser does (RFC 3492 consumes it only after
-- a basic code point), then RFC 3492's decoding loop.
punycode : String → Maybe String
punycode label =
    codes = List.map (String.toList label) Char.toCode
    ( _, delimiter ) = List.foldl codes ( 0, -1 ) λc ( i, found ) →
        ( i + 1, if c == 0x2D then i else found )
    digits = List.map (List.slice codes (delimiter + 1) (List.length codes)) λc →
        if 0x61 ≤ c && c ≤ 0x7A then
            c - 0x61
        else if 0x30 ≤ c && c ≤ 0x39 then
            c - 0x16
        else
            -1
    Maybe.map (decode digits (List.slice codes 0 (max delimiter 0)) 128 0 72) λout →
        String.fromList (List.map out Char.fromCode)


decode : List Int, List Int, Int, Int, Int → Maybe (List Int)
decode digits out n i bias =
    case digits of
        [] →
            Just out

        _ →
            Maybe.andThen (integer digits i 1 36 bias) λ( more, i1 ) →
                size = List.length out + 1
                n1 = n + i1 // size
                at = Int.mod i1 size
                if n1 > 0x10FFFF then
                    Nothing
                else
                    decode
                        more
                        (List.concat [ List.slice out 0 at, [ n1 ], List.slice out at size ])
                        n1
                        (at + 1)
                        (adapt (i1 - i) size (i == 0))


-- One generalised variable-length integer: `( the digits after it, i )`.
integer : List Int, Int, Int, Int, Int → Maybe (List Int × Int)
integer digits i w k bias =
    case digits of
        [ d, …more ] →
            t = Basics.clamp (k - bias) 1 26
            if d < 0 || w > 0x100000000 then
                Nothing
            else if d < t then
                Just ( more, i + d * w )
            else
                integer more (i + d * w) (w * (36 - t)) (k + 36) bias

        [] →
            Nothing


adapt : Int, Int, Bool → Int
adapt delta size first =
    d = if first then delta // 700 else delta // 2
    adaptK (d + d // size) 0


adaptK : Int, Int → Int
adaptK d k = if d > 455 then adaptK (d // 35) (k + 36) else k + 36 * d // (d + 38)


-- ---- The path, the query and the fragment ------------------------------
-- The path split at `/` and `\` after the first one, `.` and `..` (or
-- `%2e` for a dot) resolved, each segment escaped.
path : String → String
path raw =
    segments : List String
    segments = Js.pure λ⊤ →
        Js.to
            (Js.call (Js.call (Js.from raw) "slice" [ Js.from 1 ]) "split"
                [ Js.regExp "[\\/\\\\]" "" ]
            )
    count = List.length segments
    ( _, out ) = List.foldl segments ( 1, [] ) λsegment ( i, done ) →
        end = if i == count then [ "" ] else []
        ( i + 1
        , if matches (Js.regExp "^(\\.|%2e){2}$" "i") segment then
            List.concat [ List.slice done 0 (-1), end ]
          else if matches (Js.regExp "^(\\.|%2e)$" "i") segment then
            List.concat [ done, end ]
          else
            List.concat [ done, [ escape segment "\"<>^`{}" ] ]
        )
    "/" ++ String.join out "/"


-- UTF-8 percent-encoded: the C0 controls, space, what is past `~`, and
-- what `set` holds. `encodeURIComponent` leaves a `'` as it is.
escape : String, String → String
escape s set =
    String.join
        (List.map (String.toList s) λchar →
            c = Char.toCode char
            if
                c < 0x21
                    || c > 0x7E
                    || Js.pure λ⊤ → Js.to (Js.call (Js.from set) "includes" [ Js.from char ])
            then
                if c == 0x27 then "%27" else percentEncode (String.fromChar char)
            else
                String.fromChar char
        )
        ""


--| The URL written out again.
--|
--|     Url.toString { protocol = Https, host = "example.com", port_ = Just 8042,
--|                    path = "/over/there", query = Just "name=ferret", fragment = Nothing }
--|     -- "https://example.com:8042/over/there?name=ferret"
pub toString : Url → String
toString url =
    scheme =
        case url.protocol of
            Http →
                "http://"

            Https →
                "https://"

    withPort =
        case url.port_ of
            Nothing →
                scheme ++ url.host

            Just p →
                "${scheme}${url.host}:${String.fromInt p}"
    withPort ++ url.path ++ prefixed "?" url.query ++ prefixed "#" url.fragment


prefixed : String, Maybe String → String
prefixed prefix segment =
    case segment of
        Nothing →
            ""

        Just s →
            prefix ++ s


--| Escape a string for a URL, as JavaScript's `encodeURIComponent` does:
--| UTF-8, every byte but the unreserved ones as `%XX`. A lone surrogate,
--| which UTF-8 cannot hold, is written as U+FFFD.
--|
--|     percentEncode "to be" == "to%20be"
--|     percentEncode "€" == "%E2%82%AC"
pub percentEncode : String → String
percentEncode str =
    Js.to (Js.apply (Js.global "encodeURIComponent") [ Js.call (Js.from str) "toWellFormed" [] ])


--| Undo `percentEncode`, or `Nothing` when the string is not percent
--| encoded UTF-8: a `%` without two hex digits after it, or bytes that are
--| not UTF-8.
--|
--|     percentDecode "to%20be" == Just "to be"
--|     percentDecode "%C2" == Nothing
pub percentDecode : String → Maybe String
percentDecode str =
    -- `decodeURIComponent` documents one failure, a `URIError` for text that
    -- is not percent-encoded UTF-8: that is `Nothing`, and anything else is
    -- thrown on (CLAUDE.md rule 9).
    Js.catchIf
        (λ⊤ → Just (Js.to (Js.apply (Js.global "decodeURIComponent") [ Js.from str ])))
        (λerror → Js.instanceOf error (Js.global "URIError"))
        λ_ → Nothing
