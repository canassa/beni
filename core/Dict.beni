--! An ordered dictionary with Int or String keys. Iteration follows insertion
--! order. Replacing a value keeps its position; removing and reinserting a key
--! moves it to the end. Equality includes order. There is no compare method.
--!
--! Lookup and replacement take expected O(1), and insertion at the end takes
--! amortised O(1). Iteration takes O(n). Removal and insertAt take O(n).
--! A write edits in place when ownership permits it. Use Dict.copy to retain
--! an old version. A copy is shallow: values keep their identity.

import List


--| An ordered keyed collection. Keys must be Int or String.
pub equatable foreign type Dict k v


--| A fresh empty dictionary. Ownership: result ε fresh, exclusive.
--| Each call constructs its own storage, including calls through a function value.
pub foreign pure empty : ⊤ → fresh exclusive Dict k v


--| A dictionary with one entry. Ownership: fresh ε, argument 2 at [*].
pub foreign pure singleton : k, aliased v → fresh Dict k v


--| Number of entries. Ownership: π1 ε R, no value use.
pub foreign pure size : borrowed Dict k v → Int


--| Whether the dictionary has no entries.
pub isEmpty : Dict k v → Bool
isEmpty d = size d == 0


--| Whether a key is present. Ownership: π1 ε R; keys cross.
foreign pure has : borrowed Dict k v, k → Bool


--| Read the value of a key that is present. Private: the caller checks `has`.
--| Ownership: result aliases π1[*], borrowed.
foreign pure valueFor : aliased Dict k v, k → v


--| Read a key by index. Private: the caller checks the bounds.
foreign pure keyIndex : borrowed Dict k v, Int → k


--| Whether an `Int` is a position of the dictionary: whole, and in
--| `0..size - 1`. An `Int` can be NaN or hold a fraction (`2 ^ (0 - 1)`).
foreign pure isIndex : borrowed Dict k v, Int → Bool


--| Read a value by index. Ownership: result aliases π1[*], borrowed.
foreign pure valueAt : aliased Dict k v, Int → v


--| Read a value once during a walk, as List.traverseAt does. Ownership:
--| result π1[*], taken; callers walk each position once, in entry order.
foreign pure traverseAt : aliased Dict k v, Int → v


--| Scalar key equality, with no method evidence.
foreign pure keySame : borrowed k, borrowed k → Bool


--| Header identity, used before the ordered equality walk.
foreign pure same : borrowed Dict k v, borrowed Dict k v → Bool


--| Find a value, or Nothing. The result borrows the stored value.
pub get : Dict k v, k → Maybe v
get d k = if has d k then Just (valueFor d k) else Nothing


--| Whether a key is present.
pub member : Dict k v, k → Bool
member d k = has d k


--| The key at a zero-based position in insertion order, or Nothing when the
--| position is outside the dictionary.
--|
--|     keyAt (fromList [ ( "Tom", 1 ), ( "Ann", 2 ) ]) 1 == Just "Ann"
--|     keyAt (fromList [ ( "Tom", 1 ) ]) 3 == Nothing
pub keyAt : Dict k v, Int → Maybe k
keyAt d i = if isIndex d i then Just (keyIndex d i) else Nothing


--| Replace a value at its current position, or append a new key.
--| Ownership: π1 ε W, result π1 with π3 stored at [*]; no value write.
pub foreign pure insert : consumed returned Dict k v, k, aliased v → Dict k v


--| Remove a key. Retained entries keep their relative order.
--| Ownership: π1 ε W, result π1 and its retained values; no value write.
pub foreign pure remove : consumed returned Dict k v, k → Dict k v


--| Copy storage and private entry pairs, keeping the same values and order.
--| Ownership: fresh ε; result [*] aliases π1[*], including deep conditions.
pub foreign pure copy : aliased Dict k v → fresh Dict k v


--| Exchange two keys' positions. Missing or equal keys leave it unchanged.
--| Ownership: π1 ε W, result π1; a permutation preserves its conditions.
pub foreign pure swap : consumed returned Dict k v, k, k → Dict k v


--| Remove any old occurrence, then insert at the clamped zero-based index
--| in the remaining entries. Ownership: π1 ε W, π4 stored at [*].
pub foreign pure insertAt : consumed returned Dict k v, Int, k, aliased v → Dict k v


--| Apply a permutation of this dictionary's keys. Only sortBy calls this.
--| Ownership: π1 ε W; result π1 with unchanged values; π2 borrowed.
foreign pure permute : consumed returned Dict k v, borrowed List k → Dict k v


--| Update one key. Just replaces or appends, Nothing removes the key.
--| The callback runs once and may suspend.
pub update : Dict k v, k, (Maybe v → Maybe v) → Dict k v
update d k alter = focus d k alter


--| Ownership: π1 ε W; supply π1[*] at argument 3's #Just.0, taken and
--| owned under excl π1. Write back its Just payload or remove the key.
--| The storage write is required even when the callback only reads.
focus : Dict k v, k, (Maybe v → Maybe v) → Dict k v
focus d k alter =
    case alter (get d k) of
        Just v →
            insert d k v
        Nothing →
            remove d k


--| Fold from first entry to last. Values are borrowed; the accumulator
--| follows the usual fold ownership protocol.
pub foldl : Dict k v, b, (k, v, b → b) → b
foldl d initial f = foldlFrom d 0 initial f


foldlFrom : Dict k v, Int, b, (k, v, b → b) → b
foldlFrom d i acc f =
    if i < size d then
        next = f (keyIndex d i) (valueAt d i) acc
        foldlFrom d (i + 1) next f
    else
        acc


--| Fold from last entry to first.
pub foldr : Dict k v, b, (k, v, b → b) → b
foldr d initial f = foldrFrom d (size d - 1) initial f


foldrFrom : Dict k v, Int, b, (k, v, b → b) → b
foldrFrom d i acc f =
    if i ≥ 0 then
        next = f (keyIndex d i) (valueAt d i) acc
        foldrFrom d (i - 1) next f
    else
        acc


--| Build fresh storage from callback results, in the same order.
pub map : Dict k a, (k, a → b) → Dict k b
map d f = mapFrom d 0 (empty ⊤) f


mapFrom : Dict k a, Int, Dict k b, (k, a → b) → Dict k b
mapFrom d i out f =
    if i < size d then
        k = keyIndex d i
        v = f k (traverseAt d i)
        mapFrom d (i + 1) (insert out k v) f
    else
        out


--| Keep entries that pass the test, in fresh storage and the same order.
pub filter : Dict k v, (k, v → Bool) → Dict k v
filter d f = foldl d (empty ⊤) λk v out → if f k v then insert out k v else out


--| Build two dictionaries, preserving order within each.
pub partition : Dict k v, (k, v → Bool) → Dict k v × Dict k v
partition d f =
    step k v ( yes, no ) = if f k v then ( insert yes k v, no ) else ( yes, insert no k v )
    foldl d ( empty ⊤, empty ⊤ ) step


--| Keep the left's order and values, then append right-only entries.
pub union : Dict k v, Dict k v → Dict k v
union left right = foldl right (copy left) λk v out → if member out k then out else insert out k v


--| Keep left entries whose keys occur in right, in fresh storage.
pub intersect : Dict k v, Dict k v → Dict k v
intersect left right = filter left λk _ → member right k


--| Keep left entries whose keys do not occur in right, in fresh storage.
pub diff : Dict k a, Dict k b → Dict k a
diff left right = filter left λk _ → not (member right k)


--| Visit left keys in left order, then right-only keys in right order.
--| Call leftStep, bothStep or rightStep once for each distinct key.
pub merge :
      Dict k a
    , Dict k b
    , result
    , (k, a, result → result)
    , (k, a, b, result → result)
    , (k, b, result → result)
    → result
merge left right initial leftStep bothStep rightStep =
    mergeFrom left right 0 initial leftStep bothStep rightStep


-- One walk over the left entries, then the right ones, so each step hands
-- the accumulator to exactly one callback.
mergeFrom :
      Dict k a
    , Dict k b
    , Int
    , result
    , (k, a, result → result)
    , (k, a, b, result → result)
    , (k, b, result → result)
    → result
mergeFrom left right i acc leftStep bothStep rightStep =
    n = size left
    if i < n then
        k = keyIndex left i
        next =
            if has right k then
                bothStep k (valueAt left i) (valueFor right k) acc
            else
                leftStep k (valueAt left i) acc
        mergeFrom left right (i + 1) next leftStep bothStep rightStep
    else if i < n + size right then
        k = keyIndex right (i - n)
        next = if has left k then acc else rightStep k (valueAt right (i - n)) acc
        mergeFrom left right (i + 1) next leftStep bothStep rightStep
    else
        acc


--| Keys in insertion order, in a fresh list.
pub keys : Dict k v → List k
keys d = foldl d [] λk _ out → List.push out k


--| Values in insertion order, in a fresh list. Values themselves are shared.
pub values : Dict k v → List v
values d = foldl d [] λ_ v out → List.push out v


--| Fresh key/value tuples in insertion order, in a fresh list.
pub toList : Dict k v → List (k × v)
toList d = foldl d [] λk v out → List.push out ( k, v )


--| Build in list order. First occurrence sets position; last sets value.
pub fromList : List (k × v) → Dict k v
fromList pairs = List.foldl pairs (empty ⊤) λ( k, v ) out → insert out k v


--| Stable ascending sort. Evaluate the callback once per entry, in current
--| order. It may suspend. The dictionary storage is edited in place.
pub sortBy : Dict k v, (k, v → a) → Dict k v
    where a.compare : a, a → Order
sortBy d f =
    scored = foldl d [] λk v out → List.push out ( f k v, k )
    ordered = List.sortBy scored λ( score, _ ) → score
    permute d (List.map ordered λ( _, k ) → k)


--| Equal keys and values in the same order, with an identity shortcut.
pub eq : Dict k v, Dict k v → Bool
    where v.eq : v, v → Bool
eq left right = same left right || (size left == size right && eqFrom left right 0)


eqFrom : Dict k v, Dict k v, Int → Bool
    where v.eq : v, v → Bool
eqFrom left right i =
    if i < size left then
        keySame (keyIndex left i) (keyIndex right i)
            && valueAt left i == valueAt right i
            && eqFrom left right (i + 1)
    else
        True
