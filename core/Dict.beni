--! An ordered dictionary with Int or String keys. Keys are constrained by the
--! type; callers supply no comparison evidence. Dict has no compare method.
--!
--!     scores : Dict String Int
--!     scores =
--!         Dict.fromList [ ( "Alice", 3 ), ( "Bob", 5 ) ]
--!
--! Iteration follows insertion order: `toList`, `keys`, `values` and the
--! folds give the entries in the order their keys were first inserted.
--! Replacing a value keeps its position; removing a key and inserting it
--! again puts it at the end. Equality includes the order. To get the keys
--! in another order, sort them: `Dict.sortBy`, or `List.sort` on `keys`.
--!
--! Argument order here is **subject first and function last**: the dictionary
--! comes first, so `scores ▷ Dict.insert "Carol" 7` is
--! `Dict.insert scores "Carol" 7` — `▷` is pipe-first, it inserts its left
--! operand as the callee's first argument. A function argument comes last, so
--! a lambda you write inline is the final one. `empty` is a function of `⊤`:
--! each call makes new storage.
--!
--! Lookup, membership, size and replacing a value take expected O(1).
--! Iteration takes O(n). The storage is an array of entries in order and a
--! `Map` from each key to its entry (`backend.md` §4, *Ordered
--! dictionaries*). A write that the ownership checker cannot show safe
--! copies the storage: `Dict.copy` keeps an old version.

import List


--| An ordered keyed collection. Keys must be Int or String.
pub equatable keyed foreign type Dict k v


--| A new empty dictionary. Each call makes its own storage.
--|
--|     Dict.empty ⊤
pub foreign pure empty : ⊤ → fresh exclusive Dict k v


--| Create a dictionary with one key-value pair.
--|
--|     Dict.singleton "Tom" 42
pub singleton : k, v → Dict k v
singleton key value = put (empty ⊤) key value


--| Determine the number of key-value pairs in the dictionary.
pub foreign pure size : borrowed Dict k v → Int


--| Determine if a dictionary is empty.
--|
--|     isEmpty (empty ⊤) == True
pub isEmpty : Dict k v → Bool
isEmpty d = size d == 0


-- Whether a key is in the dictionary.
foreign pure has : borrowed Dict k v, borrowed k → Bool


-- The value of a key that `has` found.
foreign pure valueFor : borrowed Dict k v, borrowed position k → elementof v


-- The key at a position that `isIndex` accepted. A key is an `Int` or a
-- `String`, which holds no cell.
foreign pure keyIndex : borrowed Dict k v, borrowed Int → fresh k


-- Whether an `Int` is a position of the dictionary: whole, and in
-- `0..size - 1`. An `Int` can be NaN or hold a fraction.
foreign pure isIndex : borrowed Dict k v, borrowed Int → Bool


-- The value at a position below `size`.
foreign pure valueAt : borrowed Dict k v, borrowed Int → elementof v


-- The value at a position below `size`, as `valueAt` reads it. Its row is
-- asserted, as `List.traverseAt`'s is: the value it hands out is apart from
-- every other position. The obligation every loop that calls it meets: the
-- loop reads the dictionary only through it, once per position, at a
-- position that moves one way.
foreign pure traverseAt : borrowed Dict k v, borrowed Int → taken v


-- Two keys are the same key.
foreign pure keySame : borrowed k, borrowed k → Bool


-- Two dictionaries are one storage.
foreign pure same : borrowed Dict k v, borrowed Dict k v → Bool


-- Insert into storage that only the loop of this module that made it can
-- see, in place.
foreign pure put : written returned Dict k v, borrowed k, stored v → Dict k v


-- The entries in the order of `keys`, a permutation of the keys: the
-- writer of `sortBy`.
foreign pure permute : written returned Dict k v, borrowed List k → Dict k v


--| Get the value associated with a key. If the key is not found, return
--| `Nothing`.
--|
--|     get (fromList [ ( "Tom", "cat" ) ]) "Tom" == Just "cat"
--|     get (fromList [ ( "Tom", "cat" ) ]) "Jerry" == Nothing
pub get : Dict k v, k → Maybe v
get d key = if has d key then Just (valueFor d key) else Nothing


--| Determine if a key is in a dictionary.
--|
--|     member (fromList [ ( "Tom", "cat" ) ]) "Tom" == True
--|     member (fromList [ ( "Tom", "cat" ) ]) "Jerry" == False
pub member : Dict k v, k → Bool
member d key = has d key


--| The key at a zero-based position in insertion order, or `Nothing` when
--| the position is outside the dictionary.
--|
--|     keyAt (fromList [ ( "Tom", 1 ), ( "Ann", 2 ) ]) 1 == Just "Ann"
--|     keyAt (fromList [ ( "Tom", 1 ) ]) 3 == Nothing
pub keyAt : Dict k v, Int → Maybe k
keyAt d i = if isIndex d i then Just (keyIndex d i) else Nothing


--| Insert a key-value pair into a dictionary. A key that is there already
--| keeps its position and takes the new value; a new key goes at the end.
--|
--|     insert (fromList [ ( "Tom", 1 ) ]) "Ann" 2 == fromList [ ( "Tom", 1 ), ( "Ann", 2 ) ]
pub foreign pure insert : written returned Dict k v, borrowed position k, stored v → Dict k v


--| Remove a key-value pair from a dictionary. If the key is not found, no
--| changes are made. The other entries keep their order.
pub foreign pure remove : written returned Dict k v, borrowed k → Dict k v


--| A new dictionary with the same keys, values and order. The values are
--| not copied: a copy is shallow.
pub foreign pure copy : borrowed Dict k v → copyof Dict k v


--| Exchange the positions of two keys. A key that is not there, or the same
--| key twice, leaves the dictionary as it is.
pub foreign pure swap : written returned Dict k v, borrowed k, borrowed k → Dict k v


--| Insert a key-value pair at a zero-based position of the order. The key's
--| old entry, if any, is removed first. A position below 0 or NaN is 0; one
--| past the end is the end.
pub foreign pure insertAt : written returned Dict k v, borrowed Int, borrowed k, stored v → Dict k v


--| Update the value of a dictionary for a specific key with a given function.
--| `Just` replaces the value or inserts the key at the end; `Nothing` removes
--| the key. The function runs once.
--|
--|     update animals "Tom" λ_ → Just Cat
pub update : Dict k v, k, (Maybe v → Maybe v) → Dict k v
update d key alter =
    case alter (get d key) of
        Just value →
            insert d key value

        Nothing →
            remove d key


--| Fold over the key-value pairs in a dictionary, from the first entry to
--| the last.
pub foldl : Dict k v, b, (k, v, b → b) → b
foldl d initial f = foldlFrom d 0 initial f


foldlFrom : Dict k v, Int, b, (k, v, b → b) → b
foldlFrom d i acc f =
    if i < size d then
        foldlFrom d (i + 1) (f (keyIndex d i) (traverseAt d i) acc) f
    else
        acc


--| Fold over the key-value pairs in a dictionary, from the last entry to the
--| first.
pub foldr : Dict k v, b, (k, v, b → b) → b
foldr d initial f = foldrFrom d (size d - 1) initial f


foldrFrom : Dict k v, Int, b, (k, v, b → b) → b
foldrFrom d i acc f =
    if i ≥ 0 then
        foldrFrom d (i - 1) (f (keyIndex d i) (traverseAt d i) acc) f
    else
        acc


--| Apply a function to all values in a dictionary, in order. The keys and
--| the order are kept.
--|
--|     map (fromList [ ( "a", 1 ) ]) λ_ value → value + 1
pub map : Dict k a, (k, a → b) → Dict k b
map d f = mapFrom d 0 (empty ⊤) f


mapFrom : Dict k a, Int, Dict k b, (k, a → b) → Dict k b
mapFrom d i out f =
    if i < size d then
        key = keyIndex d i
        mapFrom d (i + 1) (put out key (f key (traverseAt d i))) f
    else
        out


--| Keep only the key-value pairs that pass the given test, in order.
pub filter : Dict k v, (k, v → Bool) → Dict k v
filter d f = filterFrom d 0 (empty ⊤) f


-- The loops below that build a dictionary or a list walk by position, with
-- the result typed: a fold's accumulator is a type variable, which the
-- ownership checker reads as one location for the storage and the values
-- (`ownership-v3-kernel.md` §12).
filterFrom : Dict k v, Int, Dict k v, (k, v → Bool) → Dict k v
filterFrom d i out f =
    if i < size d then
        key = keyIndex d i
        value = traverseAt d i
        filterFrom d (i + 1) (if f key value then put out key value else out) f
    else
        out


--| Partition a dictionary according to some test. The first dictionary
--| contains all key-value pairs which passed the test, and the second
--| contains the pairs that did not. Each keeps the order.
pub partition : Dict k v, (k, v → Bool) → Dict k v × Dict k v
partition d f = partitionFrom d 0 (empty ⊤) (empty ⊤) f


partitionFrom : Dict k v, Int, Dict k v, Dict k v, (k, v → Bool) → Dict k v × Dict k v
partitionFrom d i yes no f =
    if i < size d then
        key = keyIndex d i
        value = traverseAt d i
        if f key value then
            partitionFrom d (i + 1) (put yes key value) no f
        else
            partitionFrom d (i + 1) yes (put no key value) f
    else
        ( yes, no )


--| Combine two dictionaries. If there is a collision, preference is given to
--| the first dictionary. The first dictionary's entries come first, in its
--| order, then the second's that it does not have.
pub union : Dict k v, Dict k v → Dict k v
union left right = unionFrom right 0 (copy left)


unionFrom : Dict k v, Int, Dict k v → Dict k v
unionFrom right i out =
    if i < size right then
        key = keyIndex right i
        unionFrom right (i + 1) (if has out key then out else put out key (traverseAt right i))
    else
        out


--| Keep a key-value pair when its key appears in the second dictionary.
pub intersect : Dict k v, Dict k v → Dict k v
intersect left right = filter left λkey _ → has right key


--| Keep a key-value pair when its key does not appear in the second
--| dictionary.
pub diff : Dict k a, Dict k b → Dict k a
diff left right = filter left λkey _ → not (has right key)


--| The most general way of combining two dictionaries. The two dictionaries
--| come first and the accumulator after them, exactly as in `foldl`, and then
--| the three functions that say what to do when a given key appears:
--|
--|   1. Only in the left dictionary.
--|   2. In both dictionaries.
--|   3. Only in the right dictionary.
--|
--| The left dictionary's keys come first, in its order, then the keys that
--| only the right dictionary has, in its order. Each key is given to one
--| function once.
pub merge :
      Dict k a
    , Dict k b
    , result
    , (k, a, result → result)
    , (k, a, b, result → result)
    , (k, b, result → result)
    → result
merge left right initial leftStep bothStep rightStep =
    mergeFrom left right 0 initial leftStep bothStep rightStep


-- One walk over the left entries, then the right ones, so each step hands
-- the accumulator to exactly one function.
mergeFrom :
      Dict k a
    , Dict k b
    , Int
    , result
    , (k, a, result → result)
    , (k, a, b, result → result)
    , (k, b, result → result)
    → result
mergeFrom left right i acc leftStep bothStep rightStep =
    n = size left
    if i < n then
        key = keyIndex left i
        next =
            if has right key then
                bothStep key (valueAt left i) (valueFor right key) acc
            else
                leftStep key (valueAt left i) acc
        mergeFrom left right (i + 1) next leftStep bothStep rightStep
    else if i < n + size right then
        key = keyIndex right (i - n)
        next = if has left key then acc else rightStep key (valueAt right (i - n)) acc
        mergeFrom left right (i + 1) next leftStep bothStep rightStep
    else
        acc


--| Get all of the keys in a dictionary, in order.
--|
--|     keys (fromList [ ( 0, "Alice" ), ( 1, "Bob" ) ]) == [ 0, 1 ]
pub keys : Dict k v → List k
keys d = keysFrom d 0 []


keysFrom : Dict k v, Int, List k → List k
keysFrom d i out =
    if i < size d then
        keysFrom d (i + 1) (List.push out (keyIndex d i))
    else
        out


--| Get all of the values in a dictionary, in order.
--|
--|     values (fromList [ ( 0, "Alice" ), ( 1, "Bob" ) ]) == [ "Alice", "Bob" ]
pub values : Dict k v → List v
values d = valuesFrom d 0 []


valuesFrom : Dict k v, Int, List v → List v
valuesFrom d i out =
    if i < size d then
        valuesFrom d (i + 1) (List.push out (traverseAt d i))
    else
        out


--| Convert a dictionary into a list of key-value pairs, in order.
pub toList : Dict k v → List (k × v)
toList d = toListFrom d 0 []


toListFrom : Dict k v, Int, List (k × v) → List (k × v)
toListFrom d i out =
    if i < size d then
        toListFrom d (i + 1) (List.push out ( keyIndex d i, traverseAt d i ))
    else
        out


--| Convert a list of key-value pairs into a dictionary. A key's first
--| occurrence sets its position and its last sets its value.
pub fromList : List (k × v) → Dict k v
fromList pairs = fromListFrom pairs (empty ⊤)


fromListFrom : List (k × v), Dict k v → Dict k v
fromListFrom pairs out =
    case pairs of
        [ ( key, value ), …rest ] →
            fromListFrom rest (put out key value)

        [] →
            out


--| Sort the entries by a key that a function computes from each, smallest
--| first. Entries with equal sort keys keep their order. The function runs
--| once for each entry, in order.
pub sortBy : Dict k v, (k, v → a) → Dict k v
    where a.compare : a, a → Order
sortBy d f =
    scored = foldl d [] λkey value out → List.push out ( f key value, key )
    ordered = List.sortBy scored λ( score, _ ) → score
    permute d (List.map ordered λ( _, key ) → key)


--| Equal when both have the same keys with equal values, in the same order,
--| by each value's own `eq`.
--|
--|     eq (fromList [ ( 1, "a" ), ( 2, "b" ) ]) (fromList [ ( 1, "a" ), ( 2, "b" ) ]) == True
--|     eq (fromList [ ( 1, "a" ), ( 2, "b" ) ]) (fromList [ ( 2, "b" ), ( 1, "a" ) ]) == False
pub eq : Dict k v, Dict k v → Bool
    where v.eq : v, v → Bool
eq left right = same left right || (size left == size right && eqFrom left right 0)


eqFrom : Dict k v, Dict k v, Int → Bool
    where v.eq : v, v → Bool
eqFrom left right i =
    if i < size left then
        keySame (keyIndex left i) (keyIndex right i)
            && valueAt left i == valueAt right i
            && eqFrom left right (i + 1)
    else
        True
