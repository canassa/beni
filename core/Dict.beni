--! A dictionary mapping unique keys to values. The keys can be any type that
--! has a `compare` method, and that method is what arranges them: the
--! dictionary carries nothing but its tree, and a `where` clause on every
--! function that has to look a key up says which method it needs.
--!
--! That is what replaced `comparable` (`fast-compiler.md` §3.1). Elm writes
--! `Dict comparable v` and lets the compiler walk the key type at every
--! unification; beni resolves `compare` on the key type once at each call
--! site and passes the function it found as a hidden argument, so the
--! ordering is never something you write down:
--!
--!     scores : Dict String Int
--!     scores =
--!         Dict.fromList [ ( "Alice", 3 ), ( "Bob", 5 ) ]
--!
--! Argument order here is **subject first and function last**: the dictionary
--! comes first, so `scores |> Dict.insert "Carol" 7` is
--! `Dict.insert scores "Carol" 7` — `|>` is pipe-first, it inserts its left
--! operand as the callee's first argument. A function argument comes last, so
--! a lambda you write inline is the final one. The functions that build a
--! dictionary from nothing compare nothing on the way: `empty` is a constant
--! and `singleton` is unconstrained.
--!
--! Insert, remove and query take *O(log n)* time. The implementation is the
--! left-leaning red-black tree of Elm's `Dict`, translated function by
--! function, with the key's own `compare` in the places Elm used `compare`.
--!
--! Nothing here is `foreign`.

import List


--| A dictionary of keys and values, ordered by the key type's own `compare`.
--| So a `Dict String User` is a dictionary that lets you look up a `String`
--| (such as a user name) and find the associated `User`.
pub opaque type Dict k v
    = Dict (Tree k v)


--| The tree itself. Every recursive helper works on this; the ones that
--| compare keys carry the same `where k.compare` constraint their callers do.
type Tree k v
    = Node NColor k v (Tree k v) (Tree k v)
    | Leaf


type NColor
    = Red
    | Black


--| The empty dictionary. It compares nothing, so it needs no `compare` and
--| is a constant rather than a function.
--|
--|     Dict.empty
pub empty : Dict k v
empty =
    Dict Leaf


--| Create a dictionary with one key-value pair. One pair needs no ordering
--| either, so this one is unconstrained too.
--|
--|     Dict.singleton "Tom" 42
pub singleton : k, v -> Dict k v
singleton key value =
    Dict (Node Black key value Leaf Leaf)


--| Get the value associated with a key. If the key is not found, return
--| `Nothing`. This is useful when you are not sure if a key will be in the
--| dictionary.
--|
--|     get (fromList [ ( "Tom", "cat" ) ]) "Tom" == Just "cat"
--|     get (fromList [ ( "Tom", "cat" ) ]) "Jerry" == Nothing
pub get : Dict k v, k -> Maybe v
    where k.compare : k, k -> Order
get (Dict tree) targetKey =
    getHelp tree targetKey


getHelp : Tree k v, k -> Maybe v
    where k.compare : k, k -> Order
getHelp tree targetKey =
    case tree of
        Leaf ->
            Nothing

        Node _ key value left right ->
            case targetKey.compare key of
                LT ->
                    getHelp left targetKey

                EQ ->
                    Just value

                GT ->
                    getHelp right targetKey


--| Determine if a key is in a dictionary.
--|
--|     member (fromList [ ( "Tom", "cat" ) ]) "Tom" == True
--|     member (fromList [ ( "Tom", "cat" ) ]) "Jerry" == False
pub member : Dict k v, k -> Bool
    where k.compare : k, k -> Order
member dict key =
    case get dict key of
        Just _ ->
            True

        Nothing ->
            False


--| Determine the number of key-value pairs in the dictionary.
pub size : Dict k v -> Int
size (Dict tree) =
    sizeHelp 0 tree


sizeHelp : Int, Tree k v -> Int
sizeHelp n tree =
    case tree of
        Leaf ->
            n

        Node _ _ _ left right ->
            sizeHelp (sizeHelp (n + 1) right) left


--| Determine if a dictionary is empty.
--|
--|     isEmpty empty == True
pub isEmpty : Dict k v -> Bool
isEmpty (Dict tree) =
    case tree of
        Leaf ->
            True

        Node _ _ _ _ _ ->
            False


--| Insert a key-value pair into a dictionary. Replaces the value when there
--| is a collision.
--|
--|     insert empty "Tom" 42
pub insert : Dict k v, k, v -> Dict k v
    where k.compare : k, k -> Order
insert (Dict tree) key value =
    Dict (blacken (insertHelp tree key value))


-- The root node is always black.
blacken : Tree k v -> Tree k v
blacken tree =
    case tree of
        Node Red key value left right ->
            Node Black key value left right

        _ ->
            tree


insertHelp : Tree k v, k, v -> Tree k v
    where k.compare : k, k -> Order
insertHelp tree key value =
    case tree of
        -- New nodes are always red. If it violates the rules, it will be
        -- fixed when balancing.
        Leaf ->
            Node Red key value Leaf Leaf

        Node nColor nKey nValue nLeft nRight ->
            case key.compare nKey of
                LT ->
                    balance nColor nKey nValue (insertHelp nLeft key value) nRight

                EQ ->
                    Node nColor nKey value nLeft nRight

                GT ->
                    balance nColor nKey nValue nLeft (insertHelp nRight key value)


balance : NColor, k, v, Tree k v, Tree k v -> Tree k v
balance color key value left right =
    case right of
        Node Red rK rV rLeft rRight ->
            case left of
                Node Red lK lV lLeft lRight ->
                    Node
                        Red
                        key
                        value
                        (Node Black lK lV lLeft lRight)
                        (Node Black rK rV rLeft rRight)

                _ ->
                    Node color rK rV (Node Red key value left rLeft) rRight

        _ ->
            case left of
                Node Red lK lV (Node Red llK llV llLeft llRight) lRight ->
                    Node
                        Red
                        lK
                        lV
                        (Node Black llK llV llLeft llRight)
                        (Node Black key value lRight right)

                _ ->
                    Node color key value left right


--| Remove a key-value pair from a dictionary. If the key is not found, no
--| changes are made.
--|
--|     remove animals "Tom"
pub remove : Dict k v, k -> Dict k v
    where k.compare : k, k -> Order
remove (Dict tree) key =
    Dict (blacken (removeHelp tree key))


-- The easiest thing to remove from the tree, other than a red node, is a
-- black node with a red child. So the deletion walks down rearranging as it
-- goes, so that the node it finally removes is one of those.
removeHelp : Tree k v, k -> Tree k v
    where k.compare : k, k -> Order
removeHelp tree targetKey =
    case tree of
        Leaf ->
            Leaf

        Node color key value left right ->
            case targetKey.compare key of
                LT ->
                    case left of
                        Node Black _ _ lLeft _ ->
                            case lLeft of
                                Node Red _ _ _ _ ->
                                    Node color key value (removeHelp left targetKey) right

                                _ ->
                                    case moveRedLeft tree of
                                        Node nColor nKey nValue nLeft nRight ->
                                            balance
                                                nColor
                                                nKey
                                                nValue
                                                (removeHelp nLeft targetKey)
                                                nRight

                                        Leaf ->
                                            Leaf

                        _ ->
                            Node color key value (removeHelp left targetKey) right

                _ ->
                    removeHelpEQGT
                        (removeHelpPrepEQGT tree color key value left right)
                        targetKey


-- Rearrange the node so that the `EQ` and `GT` cases can proceed: either
-- rotate a red left child up, or borrow from the right.
removeHelpPrepEQGT : Tree k v, NColor, k, v, Tree k v, Tree k v -> Tree k v
removeHelpPrepEQGT tree color key value left right =
    case left of
        Node Red lK lV lLeft lRight ->
            Node color lK lV lLeft (Node Red key value lRight right)

        _ ->
            case right of
                Node Black _ _ (Node Black _ _ _ _) _ ->
                    moveRedRight tree

                Node Black _ _ Leaf _ ->
                    moveRedRight tree

                _ ->
                    tree


-- When we find the node to delete, we replace it with the minimum of its
-- right subtree and then delete that minimum instead.
removeHelpEQGT : Tree k v, k -> Tree k v
    where k.compare : k, k -> Order
removeHelpEQGT tree targetKey =
    case tree of
        Node color key value left right ->
            case targetKey.compare key of
                EQ ->
                    case getMin right of
                        Node _ minKey minValue _ _ ->
                            balance color minKey minValue left (removeMin right)

                        Leaf ->
                            Leaf

                _ ->
                    balance color key value left (removeHelp right targetKey)

        Leaf ->
            Leaf


getMin : Tree k v -> Tree k v
getMin tree =
    case tree of
        Node _ _ _ ((Node _ _ _ _ _) as left) _ ->
            getMin left

        _ ->
            tree


removeMin : Tree k v -> Tree k v
removeMin tree =
    case tree of
        Node color key value ((Node lColor _ _ lLeft _) as left) right ->
            case lColor of
                Black ->
                    case lLeft of
                        Node Red _ _ _ _ ->
                            Node color key value (removeMin left) right

                        _ ->
                            case moveRedLeft tree of
                                Node nColor nKey nValue nLeft nRight ->
                                    balance nColor nKey nValue (removeMin nLeft) nRight

                                Leaf ->
                                    Leaf

                _ ->
                    Node color key value (removeMin left) right

        _ ->
            Leaf


-- Borrow a key from the right sibling when the left child and its own left
-- child are both black. Elm writes this as two top-level patterns; the inner
-- `case` here is the same three cases with lines short enough to read, and
-- the colour of the node itself does not affect the result.
moveRedLeft : Tree k v -> Tree k v
moveRedLeft tree =
    case tree of
        Node _ k v (Node _ lK lV lLeft lRight) (Node _ rK rV rLeft rRight) ->
            case rLeft of
                Node Red rlK rlV rlL rlR ->
                    Node
                        Red
                        rlK
                        rlV
                        (Node Black k v (Node Red lK lV lLeft lRight) rlL)
                        (Node Black rK rV rlR rRight)

                _ ->
                    Node Black k v (Node Red lK lV lLeft lRight) (Node Red rK rV rLeft rRight)

        _ ->
            tree


-- The mirror of `moveRedLeft`: rotate the left child up when it already has
-- a red child of its own, otherwise recolour.
moveRedRight : Tree k v -> Tree k v
moveRedRight tree =
    case tree of
        Node _ k v (Node _ lK lV lLeft lRight) (Node _ rK rV rLeft rRight) ->
            case lLeft of
                Node Red llK llV llLeft llRight ->
                    Node
                        Red
                        lK
                        lV
                        (Node Black llK llV llLeft llRight)
                        (Node Black k v lRight (Node Red rK rV rLeft rRight))

                _ ->
                    Node Black k v (Node Red lK lV lLeft lRight) (Node Red rK rV rLeft rRight)

        _ ->
            tree


--| Update the value of a dictionary for a specific key with a given function.
--| The function is last, so the one you write inline reads after the key it
--| applies to.
--|
--|     update animals "Tom" (\_ -> Just Cat)
pub update : Dict k v, k, (Maybe v -> Maybe v) -> Dict k v
    where k.compare : k, k -> Order
update dict targetKey alter =
    case alter (get dict targetKey) of
        Just value ->
            insert dict targetKey value

        Nothing ->
            remove dict targetKey


--| Combine two dictionaries. If there is a collision, preference is given to
--| the first dictionary.
pub union : Dict k v, Dict k v -> Dict k v
    where k.compare : k, k -> Order
union t1 t2 =
    foldl t1 t2 (\key value dict -> insert dict key value)


--| Keep a key-value pair when its key appears in the second dictionary.
pub intersect : Dict k v, Dict k v -> Dict k v
    where k.compare : k, k -> Order
intersect t1 t2 =
    filter t1 (\key _ -> member t2 key)


--| Keep a key-value pair when its key does not appear in the second
--| dictionary.
pub diff : Dict k a, Dict k b -> Dict k a
    where k.compare : k, k -> Order
diff t1 t2 =
    foldl t2 t1 (\key _ t -> remove t key)


--| The most general way of combining two dictionaries. The two dictionaries
--| come first and the accumulator after them, exactly as in `foldl`, and then
--| the three functions that say what to do when a given key appears:
--|
--|   1. Only in the left dictionary.
--|   2. In both dictionaries.
--|   3. Only in the right dictionary.
--|
--| You then traverse all the keys from lowest to highest, building up
--| whatever you want.
pub merge :
    Dict k a
    , Dict k b
    , result
    , (k, a, result -> result)
    , (k, a, b, result -> result)
    , (k, b, result -> result)
    -> result
    where k.compare : k, k -> Order
merge leftDict rightDict initialResult leftStep bothStep rightStep =
    let
        stepState rKey rValue ( list, result ) =
            case list of
                [] ->
                    ( list, rightStep rKey rValue result )

                [ ( lKey, lValue ), ...rest ] ->
                    case lKey.compare rKey of
                        LT ->
                            stepState rKey rValue ( rest, leftStep lKey lValue result )

                        GT ->
                            ( list, rightStep rKey rValue result )

                        EQ ->
                            ( rest, bothStep lKey lValue rValue result )

        ( leftovers, intermediateResult ) =
            foldl rightDict ( toList leftDict, initialResult ) stepState
    in
    List.foldl leftovers intermediateResult (\( key, value ) result -> leftStep key value result)


--| Apply a function to all values in a dictionary. The keys, and therefore
--| the ordering, are untouched.
--|
--|     map (fromList [ ( "a", 1 ) ]) (\_ value -> value + 1)
--|
--| `func` is called in ascending key order (`checker.md` Appendix B), which
--| is what `mapTree` binds its three pieces in order to get.
pub map : Dict k a, (k, a -> b) -> Dict k b
map (Dict tree) func =
    Dict (mapTree tree func)


mapTree : Tree k a, (k, a -> b) -> Tree k b
mapTree tree func =
    case tree of
        Leaf ->
            Leaf

        Node color key value left right ->
            let
                newLeft =
                    mapTree left func

                newValue =
                    func key value

                newRight =
                    mapTree right func
            in
            Node color key newValue newLeft newRight


--| Fold over the key-value pairs in a dictionary from lowest key to highest
--| key.
--|
--|     foldl (fromList [ ( "a", 1 ), ( "b", 2 ) ]) 0 (\_ _ count -> count + 1) == 2
pub foldl : Dict k v, b, (k, v, b -> b) -> b
foldl (Dict tree) acc func =
    foldlTree tree acc func


foldlTree : Tree k v, b, (k, v, b -> b) -> b
foldlTree tree acc func =
    case tree of
        Leaf ->
            acc

        Node _ key value left right ->
            foldlTree right (func key value (foldlTree left acc func)) func


--| Fold over the key-value pairs in a dictionary from highest key to lowest
--| key.
--|
--|     foldr (fromList [ ( "b", 2 ), ( "a", 1 ) ]) [] (\key _ names -> [ key, ...names ]) == [ "a", "b" ]
pub foldr : Dict k v, b, (k, v, b -> b) -> b
foldr (Dict tree) acc func =
    foldrTree tree acc func


foldrTree : Tree k v, b, (k, v, b -> b) -> b
foldrTree tree acc func =
    case tree of
        Leaf ->
            acc

        Node _ key value left right ->
            foldrTree left (func key value (foldrTree right acc func)) func


--| Keep only the key-value pairs that pass the given test.
--|
--|     filter animals (\_ animal -> animal == Cat)
pub filter : Dict k v, (k, v -> Bool) -> Dict k v
    where k.compare : k, k -> Order
filter (Dict tree) isGood =
    foldlTree
        tree
        empty
        (\key value dict ->
            if isGood key value then
                insert dict key value
            else
                dict
        )


--| Partition a dictionary according to some test. The first dictionary
--| contains all key-value pairs which passed the test, and the second
--| contains the pairs that did not.
--|
--|     partition animals (\_ animal -> animal == Cat)
pub partition : Dict k v, (k, v -> Bool) -> ( Dict k v, Dict k v )
    where k.compare : k, k -> Order
partition (Dict tree) isGood =
    let
        step key value ( trues, falses ) =
            if isGood key value then
                ( insert trues key value, falses )
            else
                ( trues, insert falses key value )
    in
    foldlTree tree ( empty, empty ) step


--| Get all of the keys in a dictionary, sorted from lowest to highest.
--|
--|     keys (fromList [ ( "b", 1 ), ( "a", 0 ) ]) == [ "a", "b" ]
pub keys : Dict k v -> List k
keys dict =
    foldl dict [] (\key _ keyList -> List.push keyList key)


--| Get all of the values in a dictionary, in the order of their keys.
--|
--|     values (fromList [ ( "b", 1 ), ( "a", 0 ) ]) == [ 0, 1 ]
pub values : Dict k v -> List v
values dict =
    foldl dict [] (\_ value valueList -> List.push valueList value)


--| Convert a dictionary into an association list of key-value pairs, sorted
--| by keys.
--|
--|     toList (fromList [ ( "b", 1 ), ( "a", 0 ) ])
--|         == [ ( "a", 0 ), ( "b", 1 ) ]
pub toList : Dict k v -> List ( k, v )
toList dict =
    foldl dict [] (\key value list -> List.push list ( key, value ))


--| Convert an association list into a dictionary, ordered by the key type's
--| own `compare`.
--|
--|     fromList [ ( "a", 0 ), ( "b", 1 ) ]
pub fromList : List ( k, v ) -> Dict k v
    where k.compare : k, k -> Order
fromList assocs =
    List.foldl assocs empty (\( key, value ) dict -> insert dict key value)
