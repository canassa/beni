--! Schemas: a value that describes one piece of data at two typed endpoints,
--! its **Encoded** form `e` and its program **Type** `a`, with a fallible
--! conversion in each direction (`docs/design/schema.md` §1, §4, §5).
--!
--! The builders below make a `Schema`, and the runners at the end run one.
--! A `schema` declaration is the same thing written as syntax (§2): its
--! `schema ⊤` is built of these builders, and its `parse` and `print` are
--! specialised code that calls the core-private values near the end (§6).
--!
--! **The engine owns the traversal.** A builder takes ordinary values and
--! functions — a field's name, a child schema, a mapping from a product to a
--! record, a conversion — and never a function that reads or writes the host
--! value itself. So the path, the depth, the options and the unknown-key
--! policy are threaded by the engine through every step, and no function a
--! builder was given can drop them (§5, *Context contract*).
--!
--!     toUser ( ( ⊤, userId ), nickname ) =
--!         { userId = userId, nickname = nickname }
--!
--!     fromUser u =
--!         ( ( ⊤, u.userId ), u.nickname )
--!
--!     user =
--!         Schema.record
--!             (Schema.fields
--!                 ▷ Schema.field "userId" Schema.int
--!                 ▷ Schema.key "user-id"
--!                 ▷ Schema.optional "nickname" Schema.string)
--!             (Schema.mapping toUser fromUser)
--!             (Schema.mapping toUser fromUser)
--!
--! **The engine is written here, in beni over `Js`** (§5, *The builder
--! API*; `plans/core-in-beni.md`). It reads and writes the host value — a
--! parsed JSON document, or the object a `write` makes — through `Js`, and
--! every beni value it shares with the program, an `Issue`, a `Result`, a
--! `Presence`, through ordinary patterns. Every function a builder keeps is
--! `sync`, because a runner calls it during the run.

import Browser.Host.Data as HostData
import Browser.Host.Json as HostJson
import Int32
import Js
import Js.Any as Any
import Js.Data as Data
import Js.Protocol as Protocol


-- ---- The public types ----------------------------------------------------

--| A field which may be absent from an external value.
pub type Presence a
    = Missing
    | Present a


--| A value which may be explicitly null at the external boundary.
pub type Nullable a
    = Null
    | NonNull a


--| One step from the root to a failed value.
pub type PathSegment
    = Field String
    | Index Int


--| The direction in which a schema operation was running.
pub type Direction
    = Decoding
    | Encoding


--| The typed endpoint at which a schema operation failed.
pub type Endpoint
    = Encoded
    | Type


--| A stable, structured category for a schema failure. `Issue.message`
--| carries the specific prose and `Issue.path` identifies the value.
pub type IssueCode
    = WrongShape
    | MissingKey
    | UnknownKey
    | UnknownTag
    | InvalidValue
    | DepthExceeded
    | InvalidOptions
    | ConversionFailed
    | CheckFailed
    | ParseFailed
    | PrintFailed
    | InvalidSchema


--| An opaque handle to an untyped host value. The schema engine reads it
--| directly; it is not a recursively marshalled Beni data structure.
pub foreign type Value


--| A schema failure with its complete location and operation context.
pub type alias Issue =
    path : List PathSegment
    direction : Direction
    endpoint : Endpoint
    code : IssueCode
    message : String
    input : Maybe Value


--| Whether traversal stops at the first failure or collects independent
--| sibling failures in traversal order.
pub type ErrorMode
    = FirstError
    | AllErrors


--| What to do with external keys which the schema does not claim.
pub type UnknownKeys
    = Ignore
    | Reject


--| Root options shared by compiled runners and library interpretation.
--| reportInput retains plain data only; a callable or native input is Nothing
--| (the owner, 2026-11-02), and reporting is off by default.
pub type alias Options =
    errors : ErrorMode
    unknownKeys : UnknownKeys
    maxDepth : Int
    reportInput : Bool


--| A schema with encoded endpoint `e` and program endpoint `a`.
--| Its representation remains owned by the engine and is not frozen here.
pub opaque type Schema e a
    = Schema (Box e a)


--| A fallible two-way conversion from schema endpoint `b` to program
--| endpoint `a`. Its representation remains owned by the engine.
pub opaque type Conversion b a
    = Conversion (b → Result (List Issue) a) (a → Result (List Issue) b)


--| The fields of a record schema being built, as two products: `pe` holds
--| the fields' Encoded values and `pa` their Type values, each a tuple
--| nested to the left, `( ( ( ⊤, first ), second ), third )`.
pub opaque type Fields pe pa
    = Fields FieldBundle


--| A product turned into a record, and back.
pub opaque type Mapping p r
    = Mapping (p → r) (r → p)


--| One variant of a tagged schema.
pub opaque type Variant e a
    = Variant VariantNode


--| A variant's constructor, and the test that takes it apart: `inject`
--| builds the union from the payload, `project` answers the payload when
--| the value is this variant.
pub opaque type Injection p a
    = Injection (p → a) (a → Maybe p)


--| What `describe` answers: a schema's graph, as plain data. A recursive
--| schema appears once in `definitions` and is named by `Reference` wherever
--| it is used, its own body included.
pub type alias Description =
    root : Shape
    definitions : List Definition


--| A recursive schema's body. `id` is its identity in this description,
--| numbered in the order `describe` first meets it; `name` is the name it
--| was built with, which two different definitions may share.
pub type alias Definition =
    id : Int
    name : String
    shape : Shape


--| One node of a description.
pub type Shape
    = Primitive PrimitiveKind
    | ListOf Shape
    | NullableOf Shape
    | RecordOf (List FieldShape)
    | TaggedOf String (List VariantShape)
    | Converted Shape
    | Flipped Shape
    | TypeOnly Shape
    | EncodedOnly Shape
    | Reference Int
    | Invalid String
    | TupleOf (List Shape)
    | ConstructorsOf (List ConstructorShape)
    | MaybeOf Shape


--| The primitive schemas. `CharKind`, `Int32Kind` and `NeverKind` are a
--| derived schema's (`schema.md` §12.10): a string of one scalar value, a
--| 32-bit integer, and nothing at all.
pub type PrimitiveKind
    = StringKind
    | BoolKind
    | IntKind
    | FloatKind
    | FiniteFloatKind
    | NullKind
    | ValueKind
    | CharKind
    | Int32Kind
    | NeverKind


--| A record field: its declared name, which the Type endpoint reads and
--| writes, and its external key, which the Encoded endpoint does.
pub type alias FieldShape =
    name : String
    key : String
    optional : Bool
    shape : Shape


--| A variant: its constructor name, its literal tag, and its payload
--| record, if it has one.
pub type alias VariantShape =
    name : String
    tag : String
    payload : Maybe Shape


--| A constructor of a derived schema's custom type (`schema.md` §12.3): its
--| name, which is its wire form, and its arguments.
pub type alias ConstructorShape =
    name : String
    arguments : List Shape


--| A schema whose Encoded endpoint is the untyped host value: what a type's
--| `codec` method answers (`schema.md` §12.2).
pub type alias Codec a =
    Schema Value a


-- ---- Options -------------------------------------------------------------

--| The largest `maxDepth` a root operation accepts. A larger one, or a
--| negative one, is `InvalidOptions`: the engine recurses on the host's
--| stack once per level, and this bound keeps a whole operation at the
--| ceiling well inside the stack a browser or Node gives a program
--| (`schema.md` §5, *Traversal and failure rules*; §16, S3's *As built*).
pub maxDepthCeiling : Int
maxDepthCeiling = 1024


-- The default options' depth bound, named once: `defaultOptions` makes a
-- new record at each call, and `shapeMax` reads the bound, not one.
defaultMaxDepth : Int
defaultMaxDepth = 512


--| Effect's defaults: stop at the first failure, ignore unknown keys, and
--| leave the failing input out of an issue. `maxDepth` is 512.
pub defaultOptions : ⊤ → Options
defaultOptions ⊤ =
    { errors = FirstError
    , unknownKeys = Ignore
    , maxDepth = defaultMaxDepth
    , reportInput = False
    }


-- Every engine value retains its real type. Reporting is a separate checked
-- data projection, evaluated only when a failure asks to retain its input.
type alias Datum =
    box : Any.Any
    data : ⊤ → Maybe Js.Value


packed : a → Datum
packed datum = { box = Any.pack datum, data = λ⊤ → Data.checked datum }


unpacked : Datum → a
unpacked datum =
    case Any.unpack datum.box of
        Just found →
            found
        Nothing →
            Protocol.defect "schema engine value has an unexpected type"


-- Structural adapters are closed over their actual endpoint types. The
-- traversal sees typed sequences of values and never a callable in Js.Value.
type alias Access =
    view : Datum → List Datum
    make : List Datum → Datum


type alias Ends =
    encoded : Access
    typed : Access


type alias OptionalAccess =
    view : Datum → Maybe Datum
    make : Maybe Datum → Datum


type alias OptionalEnds =
    encoded : OptionalAccess
    typed : OptionalAccess


type alias Maps =
    encoded : Access
    typed : Access


type alias InjectionBox =
    inject : Datum → Datum
    project : Datum → Maybe Datum


type Node
    = Node (Js.Ref NodeBody)


type NodeBody
    = NPrim PrimitiveKind
    | NList Node Ends
    | NNullable Node OptionalEnds
    | NRecord (List FieldNode) Maps
    | NTagged String (List VariantNode)
    | NConverted Node (Datum → Result (List Issue) Datum) (Datum → Result (List Issue) Datum)
    | NFlipped Node
    | NProjected Int Node
    | NRef Cell
    | NBroken String
    | NTuple (List Node) Access
    | NCtors (List CtorNode)
    | NMaybe Node Int OptionalEnds
    | NHost Node


type alias FieldNode =
    name : String
    key : String
    renamed : Bool
    optional : Bool
    lenient : Bool
    node : Node
    presence : OptionalEnds


type alias CtorNode =
    name : String
    nodes : List Node
    inject : List Datum → Datum
    project : Datum → Maybe (List Datum)


type alias VariantNode =
    name : String
    tag : String
    payload : Maybe Node
    encoded : InjectionBox
    typed : InjectionBox
    problem : Maybe String


type alias Cell =
    id : Int
    name : String
    build : Node → Node
    state : Js.Ref Int
    body : Js.Ref (Maybe Node)


type alias Box e a =
    encodedId : String
    typedId : String
    node : ⊤ → Node
    analysis : Js.Ref (Maybe Analysis)
    engine : Engine e a


type alias Analysis =
    problem : Maybe String
    encodedOpaque : Bool
    typeOpaque : Bool


type alias FieldBundle =
    fields : List FieldNode
    encoded : Access
    typed : Access
    problem : Maybe String


type alias Context =
    all : Bool
    reject : Bool
    max : Int
    report : Bool
    dir : Direction
    json : Bool
    src : Int
    sh : Bool
    dst : Int
    dh : Bool
    inE : Endpoint
    outE : Endpoint
    cv : Bool
    issues : Js.Value
    fail : Js.Value


type alias Path =
    Js.Value


type alias PathStep =
    parent : Path
    input : Js.Value
    output : Js.Value


type Active
    = NoneActive
    | Entered Int Active


encodedSide : Int
encodedSide = 0


typeSide : Int
typeSide = 1


box : Node → Schema e a
box node = typedBox node [] []


nodeOf : Schema e a → Node
nodeOf (Schema state) = state.node ⊤


encodedValue : Schema e a, e → Datum
encodedValue _ datum = packed datum


typedValue : Schema e a, a → Datum
typedValue _ datum = packed datum


encodedRead : Schema e a, Datum → e
encodedRead _ datum = unpacked datum


typedRead : Schema e a, Datum → a
typedRead _ datum = unpacked datum


encodedProduct : Fields pe pa, Datum → pe
encodedProduct _ datum = unpacked datum


typedProduct : Fields pe pa, Datum → pa
typedProduct _ datum = unpacked datum


listAccess : (a → Datum), (Datum → a) → Access
listAccess put get =
    { view = λinput → List.map (unpacked input) put
    , make = λitems → packed (List.map items get)
    }


nullableAccess : (a → Datum), (Datum → a) → OptionalAccess
nullableAccess put get =
    { view =
        λinput →
            case unpacked input of
                Null →
                    Nothing
                NonNull datum →
                    Just (put datum)
    , make =
        λitem →
            packed
                (case item of
                    Nothing →
                        Null
                    Just datum →
                        NonNull (get datum)
                )
    }


presenceAccess : (a → Datum), (Datum → a) → OptionalAccess
presenceAccess put get =
    { view =
        λinput →
            case unpacked input of
                Missing →
                    Nothing
                Present datum →
                    Just (put datum)
    , make =
        λitem →
            packed
                (case item of
                    Nothing →
                        Missing
                    Just datum →
                        Present (get datum)
                )
    }


maybeAccess : (a → Datum), (Datum → a) → OptionalAccess
maybeAccess put get =
    { view = λinput → Maybe.map (unpacked input) put
    , make = λitem → packed (Maybe.map item get)
    }


--| A string, both ways.
pub string : Schema String String
string = primitive StringKind


--| `true` or `false`.
pub bool : Schema Bool Bool
bool = primitive BoolKind


--| A safe integer, both ways: a whole number from −(2⁵³−1) to 2⁵³−1. A
--| well-typed `Int` outside that range fails to encode.
pub int : Schema Int Int
int = primitive IntKind


--| Any number. Printing NaN or an infinity as JSON fails, because JSON has
--| no number for it.
pub float : Schema Float Float
float = primitive FloatKind


--| A finite number, both ways.
pub finiteFloat : Schema Float Float
finiteFloat = primitive FiniteFloatKind


--| JSON's `null`, whose one value is `Null`.
pub null : Schema (Nullable ⊥) (Nullable ⊥)
null = primitive NullKind


--| Any host value, unread: the Encoded value is the Type value.
pub value : Schema Value Value
value = primitive ValueKind


--| A list of the child's values: an array outside, a `List` inside.
pub list : Schema e a → Schema (List e) (List a)
list child =
    node =
        (nList (nodeOf child)
            { encoded = listAccess (encodedValue child _) (encodedRead child _)
            , typed = listAccess (typedValue child _) (typedRead child _)
            }
        )
    case engineOf child of
        Compiled workers →
            compiledBox node (listWorkers workers)
        Interpreted →
            box node


--| The child's values, or `null`, told apart.
pub nullable : Schema e a → Schema (Nullable e) (Nullable a)
nullable child =
    node =
        (nNullable (nodeOf child)
            { encoded = nullableAccess (encodedValue child _) (encodedRead child _)
            , typed = nullableAccess (typedValue child _) (typedRead child _)
            }
        )
    case engineOf child of
        Compiled workers →
            compiledBox node (nullableWorkers workers)
        Interpreted →
            box node


--| How the products of `fields` become the records of each endpoint, and
--| back: `to` builds the record from the product, `from` takes it apart.
pub mapping : sync (p → r), sync (r → p) → Mapping p r
mapping to from = Mapping to from


--| A fallible conversion: from the source endpoint `b` to the target `a`,
--| and back. An `Err` holds issues whose paths are relative to the value
--| converted; the engine puts them where the value is.
pub conversion :
      sync (b → Result (List Issue) a)
    , sync (a → Result (List Issue) b)
    → Conversion b a
conversion forward backward = Conversion forward backward


conversionStep : (b → Result (List Issue) a), Datum → Result (List Issue) Datum
conversionStep callback input = Result.map (callback (unpacked input)) packed


--| The schema's values, converted: decoding reads `e` to `b` and converts
--| it to `a`; encoding converts `a` back to `b` and writes `e`. The Type
--| endpoint is the conversion's target, which has no external form of its
--| own.
pub converted : Schema e b, Conversion b a → Schema e a
converted source ((Conversion forward backward) as conv) =
    node = (nConverted (nodeOf source) (conversionStep forward _) (conversionStep backward _))
    case engineOf source of
        Compiled workers →
            compiledBox node (convertedWorkers workers conv)
        Interpreted →
            box node


--| A constructor and its test, for one variant at one endpoint.
pub injection : sync (p → a), sync (a → Maybe p) → Injection p a
injection inject project = Injection inject project


injectionBox : Injection p a → InjectionBox
injectionBox (Injection inject project) =
    { inject = λinput → packed (inject (unpacked input))
    , project = λinput → Maybe.map (project (unpacked input)) packed
    }


--| The same schema facing the other way: its Encoded endpoint is `a` and its
--| Type endpoint `e`, so decoding it encodes the original. Flipping twice is
--| the original.
pub flip : Schema e a → Schema a e
flip schema =
    case nodeBody (nodeOf schema) of
        NFlipped child →
            box child
        _ →
            box (nFlipped (nodeOf schema))


pub typeOnly : Schema e a → Schema a a
typeOnly schema = box (nProjected typeSide (nodeOf schema))


--| The Encoded endpoint alone, at both ends.
pub encodedOnly : Schema e a → Schema e e
encodedOnly schema = box (nProjected encodedSide (nodeOf schema))


--| A schema's Encoded endpoint forgotten: the same schema, as the `Codec`
--| a type's `codec` method answers. A validated type's module writes
--| `pub codec ⊤ = Schema.erased (Schema.converted Schema.string toUserId)`.
--| Its Encoded end is a `Value`, so `decode` reads it as `read` does and
--| `encode` writes it as `write` does.
pub erased : Schema e a → Codec a
erased schema =
    case engineOf schema of
        Compiled workers →
            compiledBox (nHost (nodeOf schema)) (erasedWorkers workers)
        Interpreted →
            box (nHost (nodeOf schema))


--| The schema of a type, derived from its shape (`schema.md` §12.2): its
--| module's `codec` when it declares one, else its records, tuples and
--| constructors read as JSON. `Page.schema (Schema.derived ⊤)` composes it.
pub derived : ⊤ → Codec a
    where a.codec : ⊤ → Codec a
derived unit = a.codec unit


--| `derived` for a type's own module, which reads its shape even where the
--| module declares `codec`: an opaque type's module writes `pub codec ⊤ =
--| Schema.structural ⊤`, which `derived` there would answer with itself
--| (`schema.md` §12.2, §12.10). Accepted only in the type's own module.
pub structural : ⊤ → Codec a
    where a.codec : ⊤ → Codec a
structural unit = a.codec unit


--| A conversion's failure at the value it converted, `ConversionFailed`.
--| The engine fills in the direction, the endpoint and the path.
pub issue : String → Issue
issue message = issueAt [] message


--| A conversion's failure below the value it converted, at a path relative
--| to it.
pub issueAt : List PathSegment, String → Issue
issueAt path message =
    { path = path
    , direction = Decoding
    , endpoint = Type
    , code = ConversionFailed
    , message = message
    , input = Nothing
    }


unitAccess : Access
unitAccess = { view = λ_ → [], make = λ_ → packed ⊤ }


--| No fields yet.
pub fields : Fields ⊤ ⊤
fields = Fields { fields = [], encoded = unitAccess, typed = unitAccess, problem = Nothing }


parts : (Datum → pe), (Datum → e), Datum → pe × e
parts _ _ item = unpacked item


productAccess : (Datum → pe), (Datum → e), Access → Access
productAccess leftRead rightRead previous =
    { view =
        λitem →
            ( left, right ) = parts leftRead rightRead item
            [ …(List.copy (previous.view (packed left))), packed right ]
    , make =
        λitems →
            n = List.length items - 1
            left = leftRead (previous.make (List.take items n))
            right = rightRead (at items n)
            packed ( left, right )
    }


encodedPresence : Schema e a, Datum → Presence e
encodedPresence _ item = unpacked item


typedPresence : Schema e a, Datum → Presence a
typedPresence _ item = unpacked item


fieldNode : String, Schema e a, Bool → FieldNode
fieldNode name child optionalField =
    { name = name
    , key = name
    , renamed = False
    , optional = optionalField
    , lenient = False
    , node = nodeOf child
    , presence =
        { encoded = presenceAccess (encodedValue child _) (encodedRead child _)
        , typed = presenceAccess (typedValue child _) (typedRead child _)
        }
    }


--| A required field, read and written under its own name until `key`
--| renames it outside.
pub field : Fields pe pa, String, Schema e a → Fields (pe × e) (pa × a)
field ((Fields bundle) as previous) name child =
    Fields
        { fields = [ …(List.copy bundle.fields), fieldNode name child False ]
        , encoded = productAccess (encodedProduct previous _) (encodedRead child _) bundle.encoded
        , typed = productAccess (typedProduct previous _) (typedRead child _) bundle.typed
        , problem = bundle.problem
        }


--| A field that may be missing: its key absent is `Missing`, and present it
--| is `Present` of the child's value, whatever that is — `null` included
--| when the child is `nullable`.
pub optional :
      Fields pe pa
    , String
    , Schema e a
    → Fields (pe × Presence e) (pa × Presence a)
optional ((Fields bundle) as previous) name child =
    Fields
        { fields = [ …(List.copy bundle.fields), fieldNode name child True ]
        , encoded =
            productAccess (encodedProduct previous _) (encodedPresence child _) bundle.encoded
        , typed = productAccess (typedProduct previous _) (typedPresence child _) bundle.typed
        , problem = bundle.problem
        }


firstProblem : Maybe String, String → Maybe String
firstProblem previous problem =
    case previous of
        Just _ →
            previous
        Nothing →
            Just problem


--| The external key of the field just added: the Encoded endpoint reads and
--| writes the key, and the Type endpoint, and both typed records, the
--| field's name. A declaration's `as "key"`.
pub key : Fields pe pa, String → Fields pe pa
key (Fields bundle) external =
    case List.last bundle.fields of
        Nothing →
            Fields
                { bundle
                    | problem =
                        firstProblem
                            bundle.problem
                            "Schema.key renames the field added before it, and there is none"
                }
        Just last →
            if last.renamed then
                Fields
                    { bundle
                        | problem =
                            firstProblem
                                bundle.problem
                                "the field ${last.name} already has the key \"${last.key}\""
                    }
            else
                Fields
                    { bundle
                        | fields =
                            [ …(List.copy (List.take bundle.fields (List.length bundle.fields - 1)))
                            , { Record.copy last | key = external, renamed = True }
                            ]
                    }


mappedAccess : Access, Mapping p r → Access
mappedAccess product (Mapping to from) =
    { view = λitem → product.view (packed (from (unpacked item)))
    , make = λitems → packed (to (unpacked (product.make items)))
    }


--| A record schema: the fields, then how each endpoint's product becomes
--| its record. The two mappings are often one polymorphic pair of functions,
--| since both records have the same field names.
pub record : Fields pe pa, Mapping pe e, Mapping pa a → Schema e a
record (Fields bundle) encoded typed =
    problem =
        case bundle.problem of
            Just prior →
                Just prior
            Nothing →
                case duplicate bundle.fields .name of
                    Just name →
                        Just "two fields are named ${name}"
                    Nothing →
                        Maybe.map (duplicate bundle.fields .key) λexternal →
                            "two fields read and write the key \"${external}\""
    case problem of
        Just found →
            box (nBroken found)
        Nothing →
            box
                (nRecord bundle.fields
                    { encoded = mappedAccess bundle.encoded encoded
                    , typed = mappedAccess bundle.typed typed
                    }
                )


duplicate : List a, (a → String) → Maybe String
duplicate items nameOf =
    case items of
        [] →
            Nothing
        [ item, …rest ] →
            name = nameOf item
            if List.any rest λother → nameOf other == name then Just name else duplicate rest nameOf


--| A variant with a payload: its constructor name, its tag, its payload —
--| a `record` schema, whose fields sit beside the discriminator — and its
--| two constructors.
pub variant :
      String
    , String
    , Schema pe pa
    , Injection pe e
    , Injection pa a
    → Variant e a
variant name tag payload injectE injectA =
    node = nodeOf payload
    Variant
        { name = name
        , tag = tag
        , payload = Just node
        , encoded = injectionBox injectE
        , typed = injectionBox injectA
        , problem =
            case nodeBody node of
                NRecord _ _ →
                    Nothing
                _ →
                    Just "the payload of the variant ${name} is not a record schema"
        }


--| A variant with no payload: only the discriminator is written.
pub nullary : String, String, Injection ⊤ e, Injection ⊤ a → Variant e a
nullary name tag injectE injectA =
    Variant
        { name = name
        , tag = tag
        , payload = Nothing
        , encoded = injectionBox injectE
        , typed = injectionBox injectA
        , problem = Nothing
        }


--| A tagged union: the discriminator key, then the variants. A value is an
--| object whose discriminator holds one variant's tag and whose other keys
--| are that variant's payload.
pub tagged : String, List (Variant e a) → Schema e a
tagged discriminator variants =
    nodes = List.map variants λ(Variant node) → node
    case firstVariantProblem nodes of
        Just problem →
            box (nBroken problem)
        Nothing →
            if List.isEmpty nodes then
                box (nBroken "a tagged schema needs a variant")
            else
                case duplicate nodes .tag of
                    Just tag →
                        box (nBroken "two variants have the tag \"${tag}\"")
                    Nothing →
                        case duplicate nodes .name of
                            Just name →
                                box (nBroken "two variants are named ${name}")
                            Nothing →
                                case find nodes (variantClashes discriminator _) of
                                    Just clash →
                                        box
                                            (nBroken
                                                "the variant ${clash.name} has a field on the discriminator \"${discriminator}\""
                                            )
                                    Nothing →
                                        box (nTagged discriminator nodes)


firstVariantProblem : List VariantNode → Maybe String
firstVariantProblem variants =
    case variants of
        [] →
            Nothing
        [ node, …rest ] →
            case node.problem of
                Just problem →
                    Just problem
                Nothing →
                    firstVariantProblem rest


variantClashes : String, VariantNode → Bool
variantClashes discriminator selected =
    case Maybe.map selected.payload nodeBody of
        Just (NRecord fs _) →
            List.any fs λentry → entry.key == discriminator || entry.name == discriminator
        _ →
            False


nextCell : Js.Ref Int
nextCell = Js.ref 0


cellOf : String, (Node → Node) → Cell
cellOf name build =
    id = Js.read nextCell
    Js.write nextCell (id + 1)
    { id = id, name = name, build = build, state = Js.ref 0, body = Js.ref Nothing }


--| A schema that refers to itself: the function is given the schema it
--| defines and builds its body, once, the first time it is needed. A
--| reference to it is resolved by identity, never by name, so two schemas
--| built with one name are still two.
pub recursive : String, sync (Schema e a → Schema e a) → Schema e a
recursive name build = box (nRef (Js.pure λ⊤ → cellOf name λself → nodeOf (build (box self))))


resolve : Cell → Maybe Node
resolve cell =
    case Js.read cell.state of
        2 →
            Js.read cell.body
        1 →
            Nothing
        _ →
            Js.write cell.state 1
            node = cell.build (nRef cell)
            Js.write cell.body (Just node)
            Js.write cell.state 2
            Just node


dangling : Cell → String
dangling cell = "the recursive schema ${cell.name} is used before its body is built"


at : List a, Int → a
at items index =
    case List.get items index of
        Just item →
            item
        Nothing →
            Protocol.defect "schema engine index is out of bounds"


toHost : a → Js.Value
toHost x = Js.from x


fromHost : Js.Value → a
fromHost v = Js.to v


-- The engine's views of a value it was handed.

stringOf : Js.Value → String
stringOf v = Js.to v


intOf : Js.Value → Int
intOf v = Js.to v


-- The `i`th element of a host array, as what the engine put there.

lengthOf : Js.Value → Int
lengthOf xs = Js.to (Js.get xs "length")


-- `x` pushed onto the host array `xs`.

endpointOf : Int → Endpoint
endpointOf side =
    if side == encodedSide then
        Encoded
    else
        Type


endpointName : Int → String
endpointName side =
    if side == encodedSide then
        "Encoded"
    else
        "Type"


rootErr : Direction, Endpoint, IssueCode, String → Result (List Issue) b
rootErr dir endpoint code message = Err (rootIssue dir endpoint code message)


rootIssue : Direction, Endpoint, IssueCode, String → List Issue
rootIssue dir endpoint code message =
    [ { path = []
      , direction = dir
      , endpoint = endpoint
      , code = code
      , message = message
      , input = Nothing
      }
    ]


-- What ends a root operation before anything is read: bad options, a
-- construction failure, an endpoint with no external form read or written
-- outside.

optionsProblem : Options, Direction, Int → Maybe (List Issue)
optionsProblem o dir src =
    if
        not
            (HostData.isInteger (Js.from o.maxDepth)
                && o.maxDepth ≥ 0
                && o.maxDepth ≤ maxDepthCeiling
            )
    then
        Just
            (rootIssue
                dir
                (endpointOf src)
                InvalidOptions
                "maxDepth must be from 0 to ${String.fromInt maxDepthCeiling}, not ${String.fromInt o.maxDepth}"
            )
    else
        Nothing


opaqueIssue : Direction, Int → List Issue
opaqueIssue dir side =
    rootIssue
        dir
        (endpointOf side)
        InvalidSchema
        "the ${endpointName side} endpoint holds a conversion's target, which has no external form to read or write"


-- The context of one root operation. A step that failed answers the
-- operation's issue array, which no value it reads or makes can be.

context : Options, Direction, Int, Bool, Int, Bool, Bool → Context
context o dir src sh dst dh json =
    issues = Js.array []
    { all = o.errors == AllErrors
    , reject = o.unknownKeys == Reject
    , max = o.maxDepth
    , report = o.reportInput
    , dir = dir
    , json = json
    , src = src
    , sh = sh
    , dst = dst
    , dh = dh
    , inE = endpointOf src
    , outE = endpointOf dst
    , cv = False
    , issues = issues
    , fail = issues
    }


isType : Js.Value, String → Bool
isType v name = Js.same (Js.typeOf v) (Js.from name)


isArray : Js.Value → Bool
isArray v = HostData.isArray (v)


isObject : Js.Value → Bool
isObject v = isType v "object" && not (Js.isNull v) && not (isArray v)


isFinite : Js.Value → Bool
isFinite v = HostData.isFinite (v)


hasOwn : Js.Value, String → Bool
hasOwn v k = HostData.hasOwn (v) (stringOf (Js.from k))


-- The names a standard `Object.prototype` holds, which a read finds on
-- any object: tested as own keys (`present`). The compiled workers test the
-- same names, from `SchemaShare.isPrototypeKey`; a unit test there keeps
-- the two lists equal, so compiled and library runs answer alike whatever
-- a page adds to `Object.prototype`.

prototypeKey : String → Bool
prototypeKey k =
    k == "__proto__"
        || k == "__defineGetter__"
        || k == "__defineSetter__"
        || k == "__lookupGetter__"
        || k == "__lookupSetter__"
        || k == "constructor"
        || k == "hasOwnProperty"
        || k == "isPrototypeOf"
        || k == "propertyIsEnumerable"
        || k == "toLocaleString"
        || k == "toString"
        || k == "valueOf"


-- Whether host object `v` holds key `k`, as every reading runner tests it
-- (`schema.md` §5, *Host values*, amended 2026-10-17): a read of it answers
-- anything but `undefined`, through the prototype chain — but for a name
-- `prototypeKey` lists, which must be `v`'s own, so the prototype never
-- shadows a field.

present : Js.Value, String → Bool
present v k =
    if prototypeKey k then
        hasOwn v k
    else
        not (Js.isUndefined (Js.get v k))


-- A payload's discriminator and variant.

printable : Js.Value, Int → Int
printable v budget =
    if isType v "number" then
        if isFinite v then
            0
        else
            2
    else if not (isType v "object") || Js.isNull v then
        0
    else if isArray v then
        printableItems v Js.undefined 0 (lengthOf v) budget
    else
        keys = toHost (HostData.keys (v))
        printableItems keys v 0 (lengthOf keys) budget


-- The items of an array, or with `owner` an object's values by its keys.

printableItems : Js.Value, Js.Value, Int, Int, Int → Int
printableItems items owner i n budget =
    if i ≥ n then
        0
    else if budget < 1 then
        1
    else
        item =
            if Js.isUndefined owner then
                Js.at items i
            else
                Js.get owner (stringOf (Js.at items i))
        r = printable item (budget - 1)
        if r ≠ 0 then
            r
        else
            printableItems items owner (i + 1) n budget


-- A list's elements, each one level down: the depth bound is tested before
-- the descent (§5), and the references entered at the list's own position
-- are left behind. A failure is an issue added since `before`.

oneScalar : Js.Value → Bool
oneScalar v =
    n = lengthOf v
    if n == 0 || n > 2 then
        False
    else
        cp = intOf (Js.call v "codePointAt" [ Js.from 0 ])
        (cp < 0xD800 || cp > 0xDFFF) && n == (if cp > 0xFFFF then 2 else 1)


slotOf : Int → String
slotOf i =
    if i < 26 then
        String.fromChar (Char.fromCode (97 + i))
    else
        "a${String.fromInt i}"


-- `[shapeTagged, discriminator, tag₁, v₁, …]`: the discriminator read as a
-- field is, then the variant whose tag it is: a nullary one's value, or the
-- record shape of its payload, one level down, whose `make` builds the
-- variant.

atRoot : Path
atRoot = Js.null


step : Path, Js.Value, Js.Value → Path
step parent input output = toHost { parent = parent, input = input, output = output }


pathAt : Path, Js.Value, Js.Value → Path
pathAt parent input output = if Js.isNull input then parent else step parent input output


pathArray : Path, Bool → List PathSegment
pathArray path output = collect path output []


collect : Path, Bool, List PathSegment → List PathSegment
collect path output segments =
    if Js.isNull path then
        segments
    else
        part : PathStep
        part = fromHost path
        item = if output then part.output else part.input
        segment = if Js.typeIs item "number" then Index (intOf item) else Field (stringOf item)
        collect part.parent output [ segment, …segments ]


reportedInput : Context, Datum → Maybe Value
reportedInput c item = if c.report then Maybe.map (item.data ⊤) fromHost else Nothing


failAt : Context, Path, IssueCode, String, Datum, Bool → Maybe Datum
failAt c path code message item output =
    entry : Issue
    entry =
        { path = pathArray path output
        , direction = c.dir
        , endpoint = if output || c.cv then c.outE else c.inE
        , code = code
        , message = message
        , input = reportedInput c item
        }
    _ = Js.call c.issues "push" [ toHost entry ]
    Nothing


issueCount : Context → Int
issueCount c = lengthOf c.issues


finish : Context, Maybe Datum → Result (List Issue) a
finish c answer =
    case answer of
        Nothing →
            Err (fromHost c.issues)
        Just item →
            Ok (unpacked item)


moved : Context, Path, Datum, List Issue → ⊤
moved c path item given =
    prefix = pathArray path False
    each (if List.isEmpty given then [ issue "the conversion failed without an issue" ] else given) λentry →
        amended : Issue
        amended =
            { path = List.copy prefix ++ entry.path
            , direction = c.dir
            , endpoint = c.outE
            , code = entry.code
            , message = entry.message
            , input = reportedInput c item
            }
        _ = Js.call c.issues "push" [ toHost amended ]
        ⊤


callConversion : Context, Path, (Datum → Result (List Issue) Datum), Datum → Maybe Datum
callConversion c path callback item =
    case callback item of
        Ok result →
            Just result
        Err issues →
            moved c path item issues
            Nothing


childNodes : Node → List Node
childNodes node =
    case nodeBody node of
        NList child _ →
            [ child ]
        NNullable child _ →
            [ child ]
        NConverted child _ _ →
            [ child ]
        NFlipped child →
            [ child ]
        NProjected _ child →
            [ child ]
        NRecord fs _ →
            List.map fs .node
        NTagged _ variants →
            List.filterMap variants .payload
        NTuple items _ →
            items
        NCtors ctors →
            List.concatMap ctors .nodes
        NMaybe child _ _ →
            [ child ]
        NHost child →
            [ child ]
        _ →
            []


problemIn : Node, Js.Ref (List Int) → Maybe String
problemIn node seen =
    case nodeBody node of
        NRef cell →
            if List.member (Js.read seen) cell.id then
                Nothing
            else
                Js.write seen [ …(List.copy (Js.read seen)), cell.id ]
                case resolve cell of
                    Nothing →
                        Just (dangling cell)
                    Just body →
                        problemIn body seen
        NBroken problem →
            Just problem
        _ →
            firstNodeProblem (childNodes node) seen


firstNodeProblem : List Node, Js.Ref (List Int) → Maybe String
firstNodeProblem nodes seen =
    case nodes of
        [] →
            Nothing
        [ node, …rest ] →
            case problemIn node seen of
                Nothing →
                    firstNodeProblem rest seen
                found →
                    found


opaqueIn : Node, Int, Js.Ref (List (Int × Int)) → Bool
opaqueIn node side seen =
    case nodeBody node of
        NRef cell →
            if List.member (Js.read seen) ( cell.id, side ) then
                False
            else
                Js.write seen [ …(List.copy (Js.read seen)), ( cell.id, side ) ]
                case resolve cell of
                    Nothing →
                        False
                    Just body →
                        opaqueIn body side seen
        NConverted child _ _ →
            side == typeSide || opaqueIn child encodedSide seen
        NFlipped child →
            opaqueIn child (1 - side) seen
        NProjected selected child →
            opaqueIn child selected seen
        _ →
            List.any (childNodes node) λchild → opaqueIn child side seen


analyse : Schema e a → Analysis
analyse (Schema state) =
    case Js.read state.analysis of
        Just known →
            known
        Nothing →
            problem = problemIn (state.node ⊤) (Js.ref [])
            seen = Js.ref []
            result =
                { problem = problem
                , encodedOpaque = opaqueIn (state.node ⊤) encodedSide seen
                , typeOpaque = opaqueIn (state.node ⊤) typeSide seen
                }
            Js.write state.analysis (Just result)
            result


opaqueAt : Analysis, Int → Bool
opaqueAt analysis side = if side == encodedSide then analysis.encodedOpaque else analysis.typeOpaque


rootProblem : Schema e a, Options, Direction, Int, Bool, Int, Bool → Maybe (List Issue)
rootProblem schema opts dir src sh dst dh =
    case optionsProblem opts dir src of
        Just issues →
            Just issues
        Nothing →
            analysis = analyse schema
            case analysis.problem of
                Just problem →
                    Just (rootIssue dir (endpointOf src) InvalidSchema problem)
                Nothing →
                    if sh && opaqueAt analysis src then
                        Just (opaqueIssue dir src)
                    else if dh && opaqueAt analysis dst then
                        Just (opaqueIssue dir dst)
                    else
                        Nothing


isActive : Int, Active → Bool
isActive id active =
    case active of
        NoneActive →
            False
        Entered other rest →
            other == id || isActive id rest


hostEnds : Context → Context
hostEnds c =
    { Record.copy c | sh = c.sh || c.src == encodedSide, dh = c.dh || c.dst == encodedSide }


accessAt : Maps, Int → Access
accessAt maps side = if side == encodedSide then maps.encoded else maps.typed


endsAt : Ends, Int → Access
endsAt ends side = if side == encodedSide then ends.encoded else ends.typed


optionalAt : OptionalEnds, Int → OptionalAccess
optionalAt ends side = if side == encodedSide then ends.encoded else ends.typed


scalarString : Datum → String
scalarString item = unpacked item


scalarBool : Datum → Bool
scalarBool item = unpacked item


scalarInt : Datum → Int
scalarInt item = unpacked item


scalarFloat : Datum → Float
scalarFloat item = unpacked item


scalarChar : Datum → Char
scalarChar item = unpacked item


scalarInt32 : Datum → Int32.Int32
scalarInt32 item = unpacked item


scalarValue : Datum → Value
scalarValue item = unpacked item


hostDatum : Datum → Js.Value
hostDatum item = unpacked item


nullValue : Nullable ⊥
nullValue = Null


rawScalar : PrimitiveKind, Datum → Js.Value
rawScalar kind item =
    case kind of
        StringKind →
            toHost (scalarString item)
        BoolKind →
            toHost (scalarBool item)
        IntKind →
            toHost (scalarInt item)
        FloatKind →
            toHost (scalarFloat item)
        FiniteFloatKind →
            toHost (scalarFloat item)
        CharKind →
            toHost (scalarChar item)
        Int32Kind →
            toHost (scalarInt32 item)
        NullKind →
            Js.null
        ValueKind →
            toHost (scalarValue item)
        NeverKind →
            Protocol.defect "a value of the empty type reached a schema"


typedFloat : Js.Value → Float
typedFloat raw = fromHost raw


typedBool : Js.Value → Bool
typedBool raw = fromHost raw


typedChar : Js.Value → Char
typedChar raw = fromHost raw


typedInt32 : Js.Value → Int32.Int32
typedInt32 raw = fromHost raw


typedHostValue : Js.Value → Value
typedHostValue raw = fromHost raw


scalarDatum : PrimitiveKind, Js.Value → Datum
scalarDatum kind raw =
    case kind of
        StringKind →
            packed (stringOf raw)
        BoolKind →
            packed (typedBool raw)
        IntKind →
            packed (intOf raw)
        FloatKind →
            packed (typedFloat raw)
        FiniteFloatKind →
            packed (typedFloat raw)
        CharKind →
            packed (typedChar raw)
        Int32Kind →
            packed (typedInt32 raw)
        NullKind →
            packed nullValue
        ValueKind →
            packed (typedHostValue raw)
        NeverKind →
            Protocol.defect "a schema constructed a value of the empty type"


prim : Context, PrimitiveKind, Int, Path, Datum → Maybe Datum
prim c kind depth path item =
    raw = if c.sh then hostDatum item else rawScalar kind item
    accepted = λ⊤ → Just (if c.dh then packed raw else scalarDatum kind raw)
    wrong = λmessage → failAt c path WrongShape message item False
    invalid = λmessage → failAt c path InvalidValue message item False
    case kind of
        StringKind →
            if isType raw "string" then accepted ⊤ else wrong "expected a string"
        BoolKind →
            if isType raw "boolean" then accepted ⊤ else wrong "expected a boolean"
        IntKind →
            if not (isType raw "number") then
                wrong "expected a number"
            else if HostData.isSafeInteger (raw) then
                accepted ⊤
            else
                invalid "expected a safe integer"
        FloatKind →
            if not (isType raw "number") then
                wrong "expected a number"
            else if c.json && c.dh && not (isFinite raw) then
                failAt c path PrintFailed "JSON has no number for NaN or an infinity" item True
            else
                accepted ⊤
        FiniteFloatKind →
            if not (isType raw "number") then
                wrong "expected a number"
            else if isFinite raw then
                accepted ⊤
            else
                invalid "expected a finite number"
        NullKind →
            if c.sh && not (Js.isNull raw) then wrong "expected null" else accepted ⊤
        ValueKind →
            if c.json && c.dh then
                case printable raw (c.max - depth) of
                    1 →
                        failAt
                            c
                            path
                            DepthExceeded
                            "the value nests deeper than the depth limit"
                            item
                            True
                    2 →
                        failAt
                            c
                            path
                            PrintFailed
                            "the value holds NaN or an infinity, which JSON has no number for"
                            item
                            True
                    _ →
                        accepted ⊤
            else
                accepted ⊤
        CharKind →
            if not (isType raw "string") then
                wrong "expected a string"
            else if oneScalar raw then
                accepted ⊤
            else
                invalid "expected one character"
        Int32Kind →
            if not (isType raw "number") then
                wrong "expected a number"
            else if Js.bitOr (intOf raw) 0 == intOf raw then
                accepted ⊤
            else
                invalid "expected a 32-bit integer"
        NeverKind →
            wrong "expected nothing: ⊥ has no value"


-- Only host arrays are read through Js. Typed lists use their generated
-- structural adapter, which retains each element's compiler identity.
hostItems : Js.Value → List Datum
hostItems raw = List.map (fromHost raw) packedHost


packedHost : Js.Value → Datum
packedHost raw = packed raw


hostArray : List Datum → Datum
hostArray items = packed (toHost (List.map items hostDatum))


walkItems : Context, Node, Int, Path, List Datum, Int → Maybe (List Datum)
walkItems c child depth path items offset =
    walkItemsFrom c child depth path items offset (Js.ref []) False


walkItemsFrom :
      Context
    , Node
    , Int
    , Path
    , List Datum
    , Int
    , Js.Ref (List Datum)
    , Bool
    → Maybe (List Datum)
walkItemsFrom c child depth path items offset out failed =
    case items of
        [] →
            if failed then Nothing else Just (Js.read out)
        [ item, …rest ] →
            here = step path (toHost offset) (toHost offset)
            answer =
                if depth ≥ c.max then
                    failAt c here DepthExceeded "the depth limit is reached" item False
                else
                    run c child (depth + 1) here NoneActive item
            case answer of
                Nothing →
                    if c.all then
                        walkItemsFrom c child depth path rest (offset + 1) out True
                    else
                        Nothing
                Just result →
                    Js.write out [ …(List.copy (Js.read out)), result ]
                    walkItemsFrom c child depth path rest (offset + 1) out failed


listOf : Context, Node, Ends, Int, Path, Datum → Maybe Datum
listOf c child ends depth path item =
    if c.sh && not (isArray (hostDatum item)) then
        failAt c path WrongShape "expected an array" item False
    else
        items = if c.sh then hostItems (hostDatum item) else (endsAt ends c.src).view item
        Maybe.map (walkItems c child depth path items 0)
            (if c.dh then hostArray else (endsAt ends c.dst).make)


optionalOut : Context, OptionalEnds, Maybe Datum → Datum
optionalOut c ends found =
    if c.dh then
        case found of
            Nothing →
                packed Js.null
            Just item →
                item
    else
        (optionalAt ends c.dst).make found


nullableOf : Context, Node, OptionalEnds, Int, Path, Active, Datum → Maybe Datum
nullableOf c child ends depth path active item =
    found =
        if c.sh then
            if Js.isNull (hostDatum item) then Nothing else Just item
        else
            (optionalAt ends c.src).view item
    case found of
        Nothing →
            Just (optionalOut c ends Nothing)
        Just inner →
            Maybe.map (run c child depth path active inner) λresult →
                optionalOut c ends (Just result)


maybeOf : Context, Node, Int, OptionalEnds, Int, Path, Active, Datum → Maybe Datum
maybeOf c child mode ends depth path active item =
    found =
        if c.sh then
            if Js.isNull (hostDatum item) && Js.bitAnd mode 1 == 0 then Nothing else Just item
        else
            (optionalAt ends c.src).view item
    case found of
        Nothing →
            Just (optionalOut c ends Nothing)
        Just inner →
            case run c child depth path active inner of
                Nothing →
                    Nothing
                Just result →
                    if c.dh && Js.bitAnd mode 2 ≠ 0 && Js.isNull (hostDatum result) then
                        failAt
                            c
                            path
                            InvalidValue
                            "the value inside Just writes null, which reads back as Nothing"
                            inner
                            True
                    else
                        Just (optionalOut c ends (Just result))


run : Context, Node, Int, Path, Active, Datum → Maybe Datum
run c node depth path active item =
    case nodeBody node of
        NPrim kind →
            prim c kind depth path item
        NList child ends →
            listOf c child ends depth path item
        NNullable child ends →
            nullableOf c child ends depth path active item
        NRecord fs maps →
            recordOf c fs maps Nothing depth path item
        NTagged discriminator variants →
            taggedOf c discriminator variants depth path item
        NConverted source forward backward →
            if c.src == encodedSide && c.dst == typeSide then
                case run c source depth path active item of
                    Nothing →
                        Nothing
                    Just intermediate →
                        callConversion c path forward intermediate
            else if c.src == typeSide && c.dst == encodedSide then
                case callConversion c path backward item of
                    Nothing →
                        Nothing
                    Just intermediate →
                        run { Record.copy c | cv = True } source depth path active intermediate
            else if c.src == typeSide then
                Just item
            else
                run c source depth path active item
        NFlipped child →
            run { Record.copy c | src = 1 - c.src, dst = 1 - c.dst } child depth path active item
        NProjected side child →
            run { Record.copy c | src = side, dst = side } child depth path active item
        NRef cell →
            if isActive cell.id active then
                failAt
                    c
                    path
                    InvalidSchema
                    "the recursive schema ${cell.name} refers to itself without reading into the value"
                    item
                    False
            else
                case resolve cell of
                    Nothing →
                        failAt c path InvalidSchema (dangling cell) item False
                    Just body →
                        run c body depth path (Entered cell.id active) item
        NBroken problem →
            failAt c path InvalidSchema problem item False
        NTuple items access →
            tupleOf c items access depth path item
        NCtors ctors →
            constructorsOf c ctors depth path item
        NMaybe child mode ends →
            maybeOf c child mode ends depth path active item
        NHost child →
            run (hostEnds c) child depth path active item


type alias Owner =
    discriminator : String
    selected : VariantNode


type FieldAnswer
    = FieldValue Datum
    | FieldOmitted Datum


newObject : Maybe Owner → Js.Value
newObject owner =
    raw = HostData.emptyObject ⊤
    case owner of
        Nothing →
            ⊤
        Just selected →
            Js.set raw selected.discriminator (toHost selected.selected.tag)
    raw


unknownKeys : Context, List FieldNode, Maybe String, Path, Datum → Bool
unknownKeys c fs claimed path parent =
    raw = hostDatum parent
    keys : List String
    keys = fromHost (toHost (HostData.keys (raw)))
    unknownKeysFrom c fs claimed path raw keys False


unknownKeysFrom : Context, List FieldNode, Maybe String, Path, Js.Value, List String, Bool → Bool
unknownKeysFrom c fs claimed path raw keys failed =
    case keys of
        [] →
            failed
        [ name, …rest ] →
            if claimed == Just name || List.any fs (claims c name _) then
                unknownKeysFrom c fs claimed path raw rest failed
            else
                _ =
                    failAt
                        c
                        (step path (toHost name) (toHost name))
                        UnknownKey
                        "unexpected key \"${name}\""
                        (packedHost (Js.get raw name))
                        False
                if c.all then unknownKeysFrom c fs claimed path raw rest True else True


claims : Context, String, FieldNode → Bool
claims c name entry = (if c.src == encodedSide then entry.key else entry.name) == name


missingField : Context, FieldNode → FieldAnswer
missingField c entry =
    missing =
        if entry.lenient then
            case nodeBody entry.node of
                NMaybe _ _ ends →
                    (optionalAt ends c.dst).make Nothing
                _ →
                    Protocol.defect "a lenient schema field has no Maybe adapter"
        else
            (optionalAt entry.presence c.dst).make Nothing
    FieldOmitted missing


fieldMissing : FieldNode, Int, Datum → Bool
fieldMissing entry side item =
    if entry.lenient then
        case nodeBody entry.node of
            NMaybe _ _ ends →
                isNothing ((optionalAt ends side).view item)
            _ →
                False
    else
        isNothing ((optionalAt entry.presence side).view item)


descendField : Context, FieldNode, Int, Path, Datum → Maybe FieldAnswer
descendField c entry depth path item =
    answer =
        if depth ≥ c.max then
            failAt c path DepthExceeded "the depth limit is reached" item False
        else
            run c entry.node (depth + 1) path NoneActive item
    Maybe.map answer λresult →
        if entry.optional && not entry.lenient && not c.dh then
            FieldValue ((optionalAt entry.presence c.dst).make (Just result))
        else
            FieldValue result


runField : Context, FieldNode, Int, Path, Datum, Maybe Datum → Maybe FieldAnswer
runField c entry depth path parent supplied =
    inputName = if c.src == encodedSide then entry.key else entry.name
    outputName = if c.dst == encodedSide then entry.key else entry.name
    here = step path (toHost inputName) (toHost outputName)
    if c.sh then
        raw = hostDatum parent
        own = prototypeKey inputName
        heldOwn = own && hasOwn raw inputName
        got = if own && not heldOwn then Js.undefined else Js.get raw inputName
        held = if own then heldOwn else not (Js.isUndefined got)
        if held then
            descendField c entry depth here (packedHost got)
        else if entry.optional then
            Just (missingField c entry)
        else
            _ = failAt c here MissingKey "missing key \"${inputName}\"" parent False
            Nothing
    else
        case supplied of
            Nothing →
                Protocol.defect "a schema record has too few typed fields"
            Just item →
                if entry.optional && fieldMissing entry c.src item then
                    Just (missingField c entry)
                else if entry.optional && not entry.lenient then
                    case (optionalAt entry.presence c.src).view item of
                        Nothing →
                            Protocol.defect "a schema presence changed during its read"
                        Just inner →
                            descendField c entry depth here inner
                else
                    descendField c entry depth here item


fieldsFrom :
      Context
    , List FieldNode
    , Int
    , Path
    , Datum
    , List Datum
    , Js.Ref (List Datum)
    , Js.Value
    → Bool
fieldsFrom c fs depth path parent supplied out rawOut =
    case fs of
        [] →
            False
        [ entry, …rest ] →
            ( input, remaining ) =
                case supplied of
                    [] →
                        ( Nothing, [] )
                    [ item, …tail ] →
                        ( Just item, tail )
            case runField c entry depth path parent input of
                Nothing →
                    if c.all then fieldsFrom c rest depth path parent remaining out rawOut else True
                Just answer →
                    case answer of
                        FieldValue result →
                            if c.dh then
                                Js.set
                                    rawOut
                                    (if c.dst == encodedSide then entry.key else entry.name)
                                    (hostDatum result)
                            else
                                Js.write out [ …(List.copy (Js.read out)), result ]
                        FieldOmitted missing →
                            if not c.dh then Js.write out [ …(List.copy (Js.read out)), missing ]
                    fieldsFrom c rest depth path parent remaining out rawOut


recordOf : Context, List FieldNode, Maps, Maybe Owner, Int, Path, Datum → Maybe Datum
recordOf c fs maps owner depth path parent =
    if c.sh && not (isObject (hostDatum parent)) then
        failAt c path WrongShape "expected an object" parent False
    else
        before = issueCount c
        if
            c.sh
                && c.reject
                && unknownKeys c fs (Maybe.map owner .discriminator) path parent
                && not c.all
        then
            Nothing
        else
            supplied = if c.sh then [] else (accessAt maps c.src).view parent
            out = Js.ref []
            rawOut = if c.dh then newObject owner else Js.null
            if fieldsFrom c fs depth path parent supplied out rawOut || issueCount c > before then
                Nothing
            else if c.dh then
                Just (packedHost rawOut)
            else
                result = (accessAt maps c.dst).make (Js.read out)
                case owner of
                    Nothing →
                        Just result
                    Just selected →
                        Just ((variantInjection selected.selected c.dst).inject result)


variantInjection : VariantNode, Int → InjectionBox
variantInjection selected side = if side == encodedSide then selected.encoded else selected.typed


projected : Context, List VariantNode, Datum → Maybe (VariantNode × Datum)
projected c variants item =
    case variants of
        [] →
            Nothing
        [ selected, …rest ] →
            case (variantInjection selected c.src).project item of
                Nothing →
                    projected c rest item
                Just payload →
                    Just ( selected, payload )


variantOf : Context, String, List VariantNode, Path, Datum → Maybe (VariantNode × Datum)
variantOf c discriminator variants path item =
    if c.sh then
        raw = hostDatum item
        if not (isObject raw) then
            _ = failAt c path WrongShape "expected an object" item False
            Nothing
        else
            here = step path (toHost discriminator) (toHost discriminator)
            own = prototypeKey discriminator
            heldOwn = own && hasOwn raw discriminator
            tag = if own && not heldOwn then Js.undefined else Js.get raw discriminator
            if not (if own then heldOwn else not (Js.isUndefined tag)) then
                _ = failAt c here MissingKey "missing key \"${discriminator}\"" item False
                Nothing
            else
                found =
                    if isType tag "string" then
                        find variants λselected → selected.tag == stringOf tag
                    else
                        Nothing
                case found of
                    Just selected →
                        Just ( selected, item )
                    Nothing →
                        tags =
                            String.join (List.map variants λselected → "\"${selected.tag}\"") ", "
                        _ =
                            failAt
                                c
                                here
                                UnknownTag
                                ("unknown tag; expected " ++ tags)
                                (packedHost tag)
                                False
                        Nothing
    else
        case projected c variants item of
            Nothing →
                _ =
                    failAt
                        c
                        path
                        InvalidSchema
                        "no variant of this tagged schema takes the value"
                        item
                        False
                Nothing
            found →
                found


taggedOf : Context, String, List VariantNode, Int, Path, Datum → Maybe Datum
taggedOf c discriminator variants depth path item =
    case variantOf c discriminator variants path item of
        Nothing →
            Nothing
        Just ( selected, payload ) →
            owner = Just { discriminator = discriminator, selected = selected }
            case Maybe.map selected.payload nodeBody of
                Just (NRecord fs maps) →
                    if depth ≥ c.max then
                        failAt c path DepthExceeded "the depth limit is reached" payload False
                    else
                        recordOf c fs maps owner (depth + 1) path payload
                _ →
                    if c.sh && c.reject && unknownKeys c [] (Just discriminator) path item then
                        Nothing
                    else if c.dh then
                        Just (packedHost (newObject owner))
                    else
                        Just ((variantInjection selected c.dst).inject (packed ⊤))


elementsMessage : Int → String
elementsMessage n = "expected an array of ${String.fromInt n} elements"


walkNodes : Context, List Node, Int, Path, List Datum, Int → Maybe (List Datum)
walkNodes c nodes depth path items offset =
    walkNodesFrom c nodes depth path items offset (Js.ref []) False


walkNodesFrom :
      Context
    , List Node
    , Int
    , Path
    , List Datum
    , Int
    , Js.Ref (List Datum)
    , Bool
    → Maybe (List Datum)
walkNodesFrom c nodes depth path items offset out failed =
    case nodes of
        [] →
            if failed then Nothing else Just (Js.read out)
        [ node, …rest ] →
            case items of
                [] →
                    Protocol.defect "a schema tuple has too few elements"
                [ item, …remaining ] →
                    here = step path (toHost offset) (toHost offset)
                    answer =
                        if depth ≥ c.max then
                            failAt c here DepthExceeded "the depth limit is reached" item False
                        else
                            run c node (depth + 1) here NoneActive item
                    case answer of
                        Nothing →
                            if c.all then
                                walkNodesFrom c rest depth path remaining (offset + 1) out True
                            else
                                Nothing
                        Just result →
                            Js.write out [ …(List.copy (Js.read out)), result ]
                            walkNodesFrom c rest depth path remaining (offset + 1) out failed


tupleOf : Context, List Node, Access, Int, Path, Datum → Maybe Datum
tupleOf c nodes access depth path item =
    n = List.length nodes
    if c.sh && not (isArray (hostDatum item) && lengthOf (hostDatum item) == n) then
        failAt c path WrongShape (elementsMessage n) item False
    else
        items = if c.sh then hostItems (hostDatum item) else access.view item
        Maybe.map (walkNodes c nodes depth path items 0) (if c.dh then hostArray else access.make)


ctorMessage : String
ctorMessage = "expected a constructor: a string, or an object with one key"


unknownCtor : List CtorNode, String → String
unknownCtor ctors name =
    names = String.join (List.map ctors λentry → "\"${entry.name}\"") ", "
    "unknown constructor \"${name}\"; expected ${names}"


ctorOut : Context, CtorNode, List Datum → Datum
ctorOut c ctor items =
    if c.dh then
        n = List.length ctor.nodes
        if n == 0 then
            packedHost (toHost ctor.name)
        else
            raw = newObject Nothing
            Js.set
                raw
                ctor.name
                (if n == 1 then hostDatum (at items 0) else hostDatum (hostArray items))
            packedHost raw
    else
        ctor.inject items


ctorArgs : Context, CtorNode, Int, Path, List Datum, Datum → Maybe Datum
ctorArgs c ctor depth path items input =
    here = step path (toHost ctor.name) (toHost ctor.name)
    if depth ≥ c.max then
        failAt c here DepthExceeded "the depth limit is reached" input False
    else if List.length ctor.nodes == 1 then
        Maybe.map (run c (at ctor.nodes 0) (depth + 1) here NoneActive (at items 0)) λresult →
            ctorOut c ctor [ result ]
    else
        Maybe.map (walkNodes c ctor.nodes (depth + 1) here items 0) (ctorOut c ctor _)


ctorRawArgs : Context, CtorNode, Int, Path, Js.Value → Maybe Datum
ctorRawArgs c ctor depth path payload =
    here = step path (toHost ctor.name) (toHost ctor.name)
    n = List.length ctor.nodes
    input = packedHost payload
    if depth ≥ c.max then
        failAt c here DepthExceeded "the depth limit is reached" input False
    else if n == 1 then
        ctorArgs c ctor depth path [ input ] input
    else if not (isArray payload && lengthOf payload == n) then
        failAt c here WrongShape (elementsMessage n) input False
    else
        ctorArgs c ctor depth path (hostItems payload) input


ctorFromHost : Context, List CtorNode, Int, Path, Datum → Maybe Datum
ctorFromHost c ctors depth path item =
    raw = hostDatum item
    if isType raw "string" then
        name = stringOf raw
        case find ctors λentry → entry.name == name of
            Nothing →
                failAt c path UnknownTag (unknownCtor ctors name) item False
            Just ctor →
                if List.isEmpty ctor.nodes then
                    Just (ctorOut c ctor [])
                else
                    failAt
                        c
                        path
                        WrongShape
                        "the constructor ${name} takes arguments, so it is an object with the key \"${name}\""
                        item
                        False
    else if isObject raw then
        keys : List String
        keys = fromHost (toHost (HostData.keys (raw)))
        if List.length keys ≠ 1 then
            failAt c path WrongShape ctorMessage item False
        else
            name = at keys 0
            case find ctors λentry → entry.name == name of
                Nothing →
                    failAt c path UnknownTag (unknownCtor ctors name) item False
                Just ctor →
                    if List.isEmpty ctor.nodes then
                        failAt
                            c
                            path
                            WrongShape
                            "the constructor ${name} takes no arguments, so it is the string \"${name}\""
                            item
                            False
                    else
                        ctorRawArgs c ctor depth path (Js.get raw name)
    else
        failAt c path WrongShape ctorMessage item False


ctorOf : List CtorNode, Datum → Maybe (CtorNode × List Datum)
ctorOf ctors item =
    case ctors of
        [] →
            Nothing
        [ ctor, …rest ] →
            case ctor.project item of
                Nothing →
                    ctorOf rest item
                Just items →
                    Just ( ctor, items )


constructorsOf : Context, List CtorNode, Int, Path, Datum → Maybe Datum
constructorsOf c ctors depth path item =
    if c.sh then
        ctorFromHost c ctors depth path item
    else
        case ctorOf ctors item of
            Nothing →
                failAt c path InvalidSchema "no constructor takes the value" item False
            Just ( ctor, items ) →
                if List.isEmpty ctor.nodes then
                    Just (ctorOut c ctor items)
                else
                    ctorArgs
                        c
                        ctor
                        depth
                        path
                        items
                        (if List.length ctor.nodes == 1 then at items 0 else item)


runRoot : Schema e a, Options, Direction, Int, Bool, Int, Bool, Datum → Result (List Issue) b
runRoot schema opts dir src sh dst dh item =
    case rootProblem schema opts dir src sh dst dh of
        Just issues →
            Err issues
        Nothing →
            c = context opts dir src sh dst dh False
            finish c (run c (nodeOf schema) 0 atRoot NoneActive item)


--| An Encoded value converted to the Type.
pub decode : Schema e a, e → Result (List Issue) a
decode schema input = decodeWith schema (defaultOptions ⊤) input


--| `decode` with options.
pub decodeWith : Schema e a, Options, e → Result (List Issue) a
decodeWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledRun
                opts
                workers.args
                (selectedWorker workers.decode)
                Decoding
                encodedSide
                False
                typeSide
                False
                input
        Interpreted →
            runRoot schema opts Decoding encodedSide False typeSide False (packed input)


--| A Type value converted to the Encoded.
pub encode : Schema e a, a → Result (List Issue) e
encode schema input = encodeWith schema (defaultOptions ⊤) input


--| `encode` with options.
pub encodeWith : Schema e a, Options, a → Result (List Issue) e
encodeWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledRun
                opts
                workers.args
                (selectedWorker workers.encode)
                Encoding
                typeSide
                False
                encodedSide
                False
                input
        Interpreted →
            runRoot schema opts Encoding typeSide False encodedSide False (packed input)


--| A host value read as the Encoded endpoint's external form, to the Type.
pub read : Schema e a, Value → Result (List Issue) a
read schema input = readWith schema (defaultOptions ⊤) input


--| `read` with options.
pub readWith : Schema e a, Options, Value → Result (List Issue) a
readWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledRun
                opts
                workers.args
                (selectedWorker workers.read)
                Decoding
                encodedSide
                True
                typeSide
                False
                (toHost input)
        Interpreted →
            runRoot schema opts Decoding encodedSide True typeSide False (packedHost (toHost input))


--| A Type value written as the Encoded endpoint's external form.
pub write : Schema e a, a → Result (List Issue) Value
write schema input = writeWith schema (defaultOptions ⊤) input


--| `write` with options.
pub writeWith : Schema e a, Options, a → Result (List Issue) Value
writeWith schema opts input =
    case engineOf schema of
        Compiled workers →
            Result.map
                (compiledRun
                    opts
                    workers.args
                    (selectedWorker workers.write)
                    Encoding
                    typeSide
                    False
                    encodedSide
                    True
                    input
                )
                typedHostValue
        Interpreted →
            Result.map
                (runRoot schema opts Encoding typeSide False encodedSide True (packed input))
                typedHostValue


--| JSON text read to the Type.
pub parse : Schema e a, String → Result (List Issue) a
parse schema text = parseWith schema (defaultOptions ⊤) text


--| `parse` with options. `JSON.parse` reports malformed text by throwing a
--| `SyntaxError`, and only that is an answer; anything else it throws goes
--| on as it came (CLAUDE.md rule 9).
pub parseWith : Schema e a, Options, String → Result (List Issue) a
parseWith schema opts text =
    case engineOf schema of
        Compiled workers →
            compiledParse opts workers.args (selectedWorker workers.parse) text
        Interpreted →
            case rootProblem schema opts Decoding encodedSide True typeSide False of
                Just issues →
                    Err issues
                Nothing →
                    case parseJson text of
                        Nothing →
                            rootErr Decoding Encoded ParseFailed "invalid JSON"
                        Just raw →
                            c = context opts Decoding encodedSide True typeSide False True
                            finish c (run c (nodeOf schema) 0 atRoot NoneActive (packedHost raw))


parseJson : String → Maybe Js.Value
parseJson text =
    case HostJson.parse text of
        Ok raw →
            Just raw
        Err _ →
            Nothing


--| A Type value printed as JSON text.
pub print : borrowed Schema e a, aliased a → fresh Result (List Issue) String
print schema input = printWith schema (defaultOptions ⊤) input


--| `print` with options.
pub printWith : borrowed Schema e a, Options, aliased a → fresh Result (List Issue) String
printWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledPrint opts workers.args (selectedWorker workers.print) input
        Interpreted →
            case rootProblem schema opts Encoding typeSide False encodedSide True of
                Just issues →
                    Err issues
                Nothing →
                    c = context opts Encoding typeSide False encodedSide True True
                    case run c (nodeOf schema) 0 atRoot NoneActive (packed input) of
                        Nothing →
                            Err (fromHost c.issues)
                        Just result →
                            Ok (stringOf (HostJson.stringify (hostDatum result)))


--| The schema's graph, both endpoints, as plain data. It runs no
--| conversion; it builds a recursive schema's body if no run has yet.
pub describe : Schema e a → Description
describe schema =
    ids = Js.ref []
    definitions = Js.ref []
    root = shapeOf ids definitions (nodeOf schema)
    { root = root, definitions = List.sortBy (List.copy (Js.read definitions)) .id }


shapeOf : Js.Ref (List (Int × Int)), Js.Ref (List Definition), Node → Shape
shapeOf ids definitions node =
    case nodeBody node of
        NPrim kind →
            Primitive kind
        NList child _ →
            ListOf (shapeOf ids definitions child)
        NNullable child _ →
            NullableOf (shapeOf ids definitions child)
        NRecord fs _ →
            RecordOf
                (List.map fs λentry →
                    { name = entry.name
                    , key = entry.key
                    , optional = entry.optional
                    , shape = shapeOf ids definitions entry.node
                    }
                )
        NTagged discriminator variants →
            TaggedOf discriminator
                (List.map variants λselected →
                    { name = selected.name
                    , tag = selected.tag
                    , payload = Maybe.map selected.payload (shapeOf ids definitions _)
                    }
                )
        NConverted child _ _ →
            Converted (shapeOf ids definitions child)
        NFlipped child →
            Flipped (shapeOf ids definitions child)
        NProjected side child →
            if side == typeSide then
                TypeOnly (shapeOf ids definitions child)
            else
                EncodedOnly (shapeOf ids definitions child)
        NRef cell →
            case find (Js.read ids) λ( entry, _ ) → entry == cell.id of
                Just ( _, known ) →
                    Reference known
                Nothing →
                    id = List.length (Js.read ids)
                    Js.write ids [ …(List.copy (Js.read ids)), ( cell.id, id ) ]
                    shape =
                        case resolve cell of
                            Nothing →
                                Invalid (dangling cell)
                            Just body →
                                shapeOf ids definitions body
                    definition : Definition
                    definition = { id = id, name = cell.name, shape = shape }
                    Js.write definitions [ …(List.copy (Js.read definitions)), definition ]
                    Reference id
        NBroken problem →
            Invalid problem
        NTuple nodes _ →
            TupleOf (List.map nodes (shapeOf ids definitions _))
        NCtors ctors →
            ConstructorsOf
                (List.map ctors λctor →
                    { name = ctor.name
                    , arguments = List.map ctor.nodes (shapeOf ids definitions _)
                    }
                )
        NMaybe child _ _ →
            MaybeOf (shapeOf ids definitions child)
        NHost child →
            shapeOf ids definitions child


derivedChar : Schema Char Char
derivedChar = primitive CharKind


derivedInt32 : Schema Int32.Int32 Int32.Int32
derivedInt32 = primitive Int32Kind


derivedNever : Schema ⊥ ⊥
derivedNever = primitive NeverKind


find : List a, (a → Bool) → Maybe a
find items predicate =
    case items of
        [] →
            Nothing
        [ item, …rest ] →
            if predicate item then Just item else find rest predicate


each : List a, (a → ⊤) → ⊤
each items callback =
    case items of
        [] →
            ⊤
        [ item, …rest ] →
            callback item
            each rest callback


isNothing : Maybe a → Bool
isNothing option =
    case option of
        Nothing →
            True
        Just _ →
            False


type alias Worker i o =
    Context, Int, Path, Js.Value, Js.Value, i → Maybe o


type Engine e a
    = Interpreted
    | Compiled (Workers e a)


type alias Workers e a =
    parse : Maybe (Worker Js.Value a)
    print : Maybe (Worker a Js.Value)
    args : List Argument
    decode : Maybe (Worker e a)
    encode : Maybe (Worker a e)
    read : Maybe (Worker Js.Value a)
    write : Maybe (Worker a Js.Value)
    valid : Maybe (Worker Js.Value a)


type alias Argument =
    analyse : ⊤ → Analysis


argument : Schema e a → Argument
argument schema =
    { analyse =
        λ⊤ →
            case engineOf schema of
                Compiled workers →
                    argumentsAnalysis workers.args
                Interpreted →
                    analyse schema
    }


declared :
      String
    , String
    , (⊤ → Node)
    , Maybe (Worker Js.Value a)
    , Maybe (Worker a Js.Value)
    , List Argument
    , Maybe (Worker e a)
    , Maybe (Worker a e)
    , Maybe (Worker Js.Value a)
    , Maybe (Worker a Js.Value)
    , Maybe (Worker Js.Value a)
    → Schema e a
declared encodedId typedId description parsing printing args decoding encoding reading writing valid =
    Schema
        { encodedId = encodedId
        , typedId = typedId
        , node = description
        , analysis = Js.pure λ⊤ → Js.ref Nothing
        , engine =
            Compiled
                { parse = parsing
                , print = printing
                , args = args
                , decode = decoding
                , encode = encoding
                , read = reading
                , write = writing
                , valid = valid
                }
        }


selectedWorker : Maybe (Worker i o) → Worker i o
selectedWorker option =
    case option of
        Just worker →
            worker
        Nothing →
            Protocol.defect "an eliminated schema worker was reached"


compiledProblem : Options, Direction, Int, Bool, List Argument → Maybe (List Issue)
compiledProblem opts dir src host args =
    case optionsProblem opts dir src of
        Just issues →
            Just issues
        Nothing →
            argumentProblem args dir src host


argumentProblem : List Argument, Direction, Int, Bool → Maybe (List Issue)
argumentProblem args dir src host =
    case args of
        [] →
            Nothing
        [ supplied, …rest ] →
            analysis = supplied.analyse ⊤
            case analysis.problem of
                Just problem →
                    Just (rootIssue dir (endpointOf src) InvalidSchema problem)
                Nothing →
                    if host && analysis.encodedOpaque then
                        Just (opaqueIssue dir encodedSide)
                    else
                        argumentProblem rest dir src host


compiledParse : Options, List Argument, Worker Js.Value a, String → Result (List Issue) a
compiledParse opts args worker text =
    case compiledProblem opts Decoding encodedSide True args of
        Just issues →
            Err issues
        Nothing →
            case parseJson text of
                Nothing →
                    rootErr Decoding Encoded ParseFailed "invalid JSON"
                Just raw →
                    c = context opts Decoding encodedSide True typeSide False True
                    case worker c 0 atRoot Js.null Js.null raw of
                        Nothing →
                            Err (fromHost c.issues)
                        Just result →
                            Ok result


compiledPrint : Options, List Argument, Worker a Js.Value, a → Result (List Issue) String
compiledPrint opts args worker input =
    case compiledProblem opts Encoding typeSide True args of
        Just issues →
            Err issues
        Nothing →
            c = context opts Encoding typeSide False encodedSide True True
            case worker c 0 atRoot Js.null Js.null input of
                Nothing →
                    Err (fromHost c.issues)
                Just raw →
                    Ok (stringOf (HostJson.stringify (raw)))


compiledRun :
      Options
    , List Argument
    , Worker i o
    , Direction
    , Int
    , Bool
    , Int
    , Bool
    , i
    → Result (List Issue) o
compiledRun opts args worker dir src sh dst dh input =
    case compiledProblem opts dir src (sh || dh) args of
        Just issues →
            Err issues
        Nothing →
            c = context opts dir src sh dst dh False
            case worker c 0 atRoot Js.null Js.null input of
                Nothing →
                    Err (fromHost c.issues)
                Just result →
                    Ok result


interpretedSlot : Schema e a → Worker i o
interpretedSlot schema =
    λc depth parent input output item →
        answer = run c (nodeOf schema) depth (pathAt parent input output) NoneActive (packed item)
        Maybe.map answer unpacked


readSlot : Schema e a → Worker Js.Value a
readSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.parse
        Interpreted →
            interpretedSlot schema


writeSlot : Schema e a → Worker a Js.Value
writeSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.print
        Interpreted →
            interpretedSlot schema


decodeSlot : Schema e a → Worker e a
decodeSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.decode
        Interpreted →
            interpretedSlot schema


encodeSlot : Schema e a → Worker a e
encodeSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.encode
        Interpreted →
            interpretedSlot schema


readValueSlot : Schema e a → Worker Js.Value a
readValueSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.read
        Interpreted →
            interpretedSlot schema


writeValueSlot : Schema e a → Worker a Js.Value
writeValueSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.write
        Interpreted →
            interpretedSlot schema


readValidSlot : Schema e a → Worker Js.Value a
readValidSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.valid
        Interpreted →
            interpretedSlot schema


-- Empty typed lists witness their element types without fabricating or
-- inspecting an element. The compiler identity is `core:List.List(a)`.
resultIdentity : List a → String
resultIdentity witness = String.slice (Any.fingerprint (Any.pack witness)) 15 (-1)


typedBox : Node, List e, List a → Schema e a
typedBox node encoded typed = boxWithIds (resultIdentity encoded) (resultIdentity typed) node


-- Generated schema producers already carry these exact endpoint identities.
boxWithIds : String, String, Node → Schema e a
boxWithIds encodedId typedId node =
    Schema
        { encodedId = encodedId
        , typedId = typedId
        , node = λ⊤ → node
        , analysis = Js.pure λ⊤ → Js.ref Nothing
        , engine = Interpreted
        }


encodedIdentity : Schema e a → String
encodedIdentity (Schema state) = state.encodedId


typedIdentity : Schema e a → String
typedIdentity (Schema state) = state.typedId


-- Generated adapters use these typed beni loops; the callbacks are closed
-- synchronous projections, with their real element types preserved.
listItems : List a, sync (a → Datum) → List Datum
listItems items project = List.map items project


listMade : List Datum, sync (Datum → a) → List a
listMade items inject = List.map items inject


describedOf : Schema e a → Node
describedOf schema = nodeOf schema


describedList : Node, Access, Access → Node
describedList child encoded typed = nList child { encoded = encoded, typed = typed }


describedNullable : Node, OptionalAccess, OptionalAccess → Node
describedNullable child encoded typed = nNullable child { encoded = encoded, typed = typed }


describedRecord : List FieldNode, Access, Access → Node
describedRecord fs encoded typed = nRecord fs { encoded = encoded, typed = typed }


describedField : String, String, Bool, Node, OptionalAccess, OptionalAccess → FieldNode
describedField name external optionalField node encoded typed =
    { name = name
    , key = external
    , renamed = name ≠ external
    , optional = optionalField
    , lenient = False
    , node = node
    , presence = { encoded = encoded, typed = typed }
    }


describedTagged : String, List VariantNode → Node
describedTagged discriminator variants = nTagged discriminator variants


describedVariant : String, String, Maybe Node, InjectionBox, InjectionBox → VariantNode
describedVariant name tag payload encoded typed =
    { name = name
    , tag = tag
    , payload = payload
    , encoded = encoded
    , typed = typed
    , problem = Nothing
    }


describedRecursive : String, (Node → Node) → Node
describedRecursive name build = nRef (cellOf name build)


describedHost : Node → Node
describedHost child = nHost child


describedTuple : List Node, Access → Node
describedTuple nodes access = nTuple nodes access


describedConstructors : List CtorNode → Node
describedConstructors ctors = nCtors ctors


describedMaybe : Node, Int, OptionalAccess, OptionalAccess → Node
describedMaybe child mode encoded typed = nMaybe child mode { encoded = encoded, typed = typed }


describedMaybeField : String, Node, Int, OptionalAccess, OptionalAccess → FieldNode
describedMaybeField name child mode encoded typed =
    { name = name
    , key = name
    , renamed = False
    , optional = True
    , lenient = True
    , node = nMaybe child mode { encoded = encoded, typed = typed }
    , presence = { encoded = encoded, typed = typed }
    }


describedConverted :
      Node
    , (Datum → Result (List Issue) Datum)
    , (Datum → Result (List Issue) Datum)
    → Node
describedConverted child forward backward = nConverted child forward backward


forwardOf : Conversion b a → (b → Result (List Issue) a)
forwardOf (Conversion forward _) = forward


backwardOf : Conversion b a → (a → Result (List Issue) b)
backwardOf (Conversion _ backward) = backward


mappedConversion : sync (b → Result (List Issue) a), b, sync (a → Datum) → Result (List Issue) Datum
mappedConversion callback input project = Result.map (callback input) project


-- These failure helpers accept the real input type. Only the checked data
-- projection runs, and only on a reported failure; no input is erased.
compiledFail : Context, Path, Js.Value, Js.Value, Int, String, a, Bool → Js.Value
compiledFail c parent input output code message item written =
    entry : Issue
    entry =
        { path = pathArray (pathAt parent input output) written
        , direction = c.dir
        , endpoint = if written || c.cv then c.outE else c.inE
        , code = fromHost (Js.at issueCodes code)
        , message = message
        , input = if c.report then Maybe.map (Data.checked item) fromHost else Nothing
        }
    _ = Js.call c.issues "push" [ toHost entry ]
    c.fail


compiledDeep : Context, Path, Js.Value, Js.Value, a → Js.Value
compiledDeep c parent input output item =
    compiledFail c parent input output 5 "the depth limit is reached" item False


compiledMissing : Context, Path, Js.Value, Js.Value, a → Js.Value
compiledMissing c parent input output item =
    compiledFail c parent input output 1 "missing key \"${stringOf input}\"" item False


hostWorker : Worker i o → Worker i o
hostWorker inner =
    λc depth parent input output item → inner (hostEnds c) depth parent input output item


compiledForward : Context, Path, Js.Value, Js.Value, Conversion b a, b → Maybe a
compiledForward c parent input output (Conversion forward _) item =
    conversionAnswer (forward item) c (pathAt parent input output) item


compiledBackward : Context, Path, Js.Value, Js.Value, Conversion b a, a → Maybe b
compiledBackward c parent input output (Conversion _ backward) item =
    conversionAnswer (backward item) c (pathAt parent input output) item


conversionAnswer : Result (List Issue) a, Context, Path, b → Maybe a
conversionAnswer answer c path input =
    case answer of
        Ok item →
            Just item
        Err given →
            prefix = pathArray path False
            each
                (if List.isEmpty given then
                    [ issue "the conversion failed without an issue" ]
                 else
                    given
                )
                λentry →
                    amended : Issue
                    amended =
                        { path = List.copy prefix ++ entry.path
                        , direction = c.dir
                        , endpoint = c.outE
                        , code = entry.code
                        , message = entry.message
                        , input =
                            if c.report then Maybe.map (Data.checked input) fromHost else Nothing
                        }
                    _ = Js.call c.issues "push" [ toHost amended ]
                    ⊤
            Nothing


validContext : ⊤ → Context
validContext ⊤ = context (defaultOptions ⊤) Decoding encodedSide True typeSide False False


validJson : Context, String → Js.Value
validJson c text = Maybe.withDefault (parseJson text) c.fail


readValid : Schema e a, Value → Result (List Issue) a
readValid schema input = read schema input


badString : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badString c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a string"
            x
            False


badBool : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badBool c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a boolean"
            x
            False


badFloat : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badFloat c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


-- An `Int` and a `FiniteFloat` fail one of two tests: not a number at all,
-- or a number out of range.
badInt : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badInt c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else if isType x "number" then
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            4
            "expected a safe integer"
            x
            False
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


badFinite : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badFinite c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else if isType x "number" then
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            4
            "expected a finite number"
            x
            False
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


-- `IssueCode`'s constructors, a host array in declaration order.
issueCodes : Js.Value
issueCodes =
    toHost
        [ WrongShape
        , MissingKey
        , UnknownKey
        , UnknownTag
        , InvalidValue
        , DepthExceeded
        , InvalidOptions
        , ConversionFailed
        , CheckFailed
        , ParseFailed
        , PrintFailed
        , InvalidSchema
        ]


belowBackward : Context → Context
belowBackward c =
    if c.cv then
        c
    else
        { Record.copy c | cv = True }


-- Whether a `Value` prints as JSON within the depth left: `printable`'s
-- answer, for an encoding worker's `Value`.
printableWithin : Context, Int, Js.Value → Int
printableWithin c depth v = printable v (c.max - depth)


engineOf : Schema e a → Engine e a
engineOf (Schema state) = state.engine


-- ShapeGraph only constructs plans for plain-data endpoints. Jobs and their
-- configuration stay typed; Js.Value carries only their data input/output.
type ShapePlan
    = ShapePlan ((Js.Value, Int → Js.Value))


type alias ShapeField =
    external : String
    name : String
    flag : Int
    plan : ShapePlan


type alias ShapeVariant =
    tag : String
    plan : Maybe ShapePlan
    make : (Js.Value → Js.Value)


type alias ShapeCtor =
    name : String
    plans : List ShapePlan
    make : (List Js.Value → Js.Value)


shapeFail : Js.Value
shapeFail = Js.array []


shapeMax : Int
shapeMax = defaultMaxDepth


shapeRun : ShapePlan, Js.Value, Int → Js.Value
shapeRun (ShapePlan job) input depth = job input depth


validShape : ShapePlan, Value → Result (List Issue) a
validShape plan input =
    result = shapeRun plan (toHost input) 0
    if Js.same result shapeFail then Err [] else Ok (fromHost result)


shapeParse : ShapePlan, String → Result (List Issue) a
shapeParse plan text =
    case parseJson text of
        Nothing →
            Err []
        Just input →
            validShape plan (fromHost input)


shapeString : ShapePlan
shapeString = ShapePlan λinput _ → if isType input "string" then input else shapeFail


shapeBool : ShapePlan
shapeBool = ShapePlan λinput _ → if isType input "boolean" then input else shapeFail


shapeInt : ShapePlan
shapeInt = ShapePlan λinput _ → if HostData.isSafeInteger input then input else shapeFail


shapeFloat : ShapePlan
shapeFloat = ShapePlan λinput _ → if isType input "number" then input else shapeFail


shapeFinite : ShapePlan
shapeFinite = ShapePlan λinput _ → if isFinite input then input else shapeFail


shapeNull : ShapePlan
shapeNull = ShapePlan λinput _ → if Js.isNull input then toHost Null else shapeFail


shapeValue : ShapePlan
shapeValue = ShapePlan λinput _ → input


shapeChar : ShapePlan
shapeChar = ShapePlan λinput _ →
    if isType input "string" && oneScalar input then input else shapeFail


shapeInt32 : ShapePlan
shapeInt32 = ShapePlan λinput _ →
    if isType input "number" && Js.bitOr (intOf input) 0 == intOf input then input else shapeFail


shapeNever : ShapePlan
shapeNever = ShapePlan λ_ _ → shapeFail


shapeKey : Bool, Js.Value, String → Js.Value
shapeKey own input external =
    if own && prototypeKey external then
        if hasOwn input external then Js.get input external else Js.undefined
    else
        Js.get input external


shapeRecord : List Int, List ShapeField → ShapePlan
shapeRecord order entries = shapeRecordPlan False order entries


shapeRecordOwn : List Int, List ShapeField → ShapePlan
shapeRecordOwn order entries = shapeRecordPlan True order entries


shapeRecordPlan : Bool, List Int, List ShapeField → ShapePlan
shapeRecordPlan own order entries = ShapePlan λinput depth →
    if isObject input then
        values = Js.array []
        if shapeFieldsFrom own entries order 0 input depth values then
            shapeFail
        else
            shapeCopy entries values 0 (Js.object [])
    else
        shapeFail


shapeFieldsFrom : Bool, List ShapeField, List Int, Int, Js.Value, Int, Js.Value → Bool
shapeFieldsFrom own entries order index input depth values =
    if index ≥ List.length entries then
        False
    else
        position = if List.isEmpty order then index else at order index
        entry = at entries position
        raw = shapeKey own input entry.external
        result = shapeEntry entry (not (Js.isUndefined raw)) raw depth
        if Js.same result shapeFail then
            True
        else
            Js.setAt values position result
            shapeFieldsFrom own entries order (index + 1) input depth values


shapeCopy : List ShapeField, Js.Value, Int, Js.Value → Js.Value
shapeCopy entries values index output =
    if index ≥ List.length entries then
        output
    else
        entry = at entries index
        Js.set output entry.name (Js.at values index)
        shapeCopy entries values (index + 1) output


shapeEntry : ShapeField, Bool, Js.Value, Int → Js.Value
shapeEntry entry held input depth =
    if not held then
        if entry.flag == 0 then
            shapeFail
        else if entry.flag == 2 then
            toHost Nothing
        else
            toHost Missing
    else if depth ≥ shapeMax then
        shapeFail
    else
        result = shapeRun entry.plan input (depth + 1)
        if entry.flag ≠ 1 || Js.same result shapeFail then result else toHost (Present result)


shapeList : ShapePlan → ShapePlan
shapeList child = ShapePlan λinput depth →
    if isArray input then
        shapeListFrom child input 0 (lengthOf input) depth (Js.array [])
    else
        shapeFail


shapeListFrom : ShapePlan, Js.Value, Int, Int, Int, Js.Value → Js.Value
shapeListFrom plan input index size depth output =
    if index ≥ size then
        output
    else if depth ≥ shapeMax then
        shapeFail
    else
        result = shapeRun plan (Js.at input index) (depth + 1)
        if Js.same result shapeFail then
            shapeFail
        else
            _ = Js.call output "push" [ result ]
            shapeListFrom plan input (index + 1) size depth output


shapeNullable : ShapePlan → ShapePlan
shapeNullable child = ShapePlan λinput depth →
    if Js.isNull input then
        toHost Null
    else
        result = shapeRun child input depth
        if Js.same result shapeFail then shapeFail else toHost (NonNull result)


shapeMaybe : ShapePlan → ShapePlan
shapeMaybe child = ShapePlan λinput depth →
    if Js.isNull input then toHost Nothing else shapeRun (shapeJust child) input depth


shapeJust : ShapePlan → ShapePlan
shapeJust child = ShapePlan λinput depth →
    result = shapeRun child input depth
    if Js.same result shapeFail then shapeFail else toHost (Just result)


shapeLater : sync (⊤ → ShapePlan) → ShapePlan
shapeLater later = ShapePlan λinput depth → shapeRun (later ⊤) input depth


shapeTuple : List ShapePlan → ShapePlan
shapeTuple plans = ShapePlan λinput depth →
    if not (isArray input) || lengthOf input ≠ List.length plans then
        shapeFail
    else if List.isEmpty plans then
        Js.null
    else
        shapeTupleFrom plans input 0 depth (Js.object [])


shapeTupleFrom : List ShapePlan, Js.Value, Int, Int, Js.Value → Js.Value
shapeTupleFrom plans input index depth output =
    if index ≥ List.length plans then
        output
    else if depth ≥ shapeMax then
        shapeFail
    else
        result = shapeRun (at plans index) (Js.at input index) (depth + 1)
        if Js.same result shapeFail then
            shapeFail
        else
            Js.set output (slotOf index) result
            shapeTupleFrom plans input (index + 1) depth output


shapeTagged : String, List ShapeVariant → ShapePlan
shapeTagged external variants = shapeTaggedPlan False external variants


shapeTaggedOwn : String, List ShapeVariant → ShapePlan
shapeTaggedOwn external variants = shapeTaggedPlan True external variants


shapeTaggedPlan : Bool, String, List ShapeVariant → ShapePlan
shapeTaggedPlan own external variants = ShapePlan λinput depth →
    if not (isObject input) then
        shapeFail
    else
        tag = shapeKey own input external
        case find variants λentry → Js.same (Js.from entry.tag) tag of
            Nothing →
                shapeFail
            Just selected →
                case selected.plan of
                    Nothing →
                        selected.make Js.null
                    Just plan →
                        if depth ≥ shapeMax then
                            shapeFail
                        else
                            payload = shapeRun plan input (depth + 1)
                            if Js.same payload shapeFail then shapeFail else selected.make payload


shapeCtors : List ShapeCtor → ShapePlan
shapeCtors ctors = ShapePlan λinput depth →
    if isType input "string" then
        case find ctors λentry → Js.same (Js.from entry.name) input && List.isEmpty entry.plans of
            Nothing →
                shapeFail
            Just selected →
                selected.make []
    else if isObject input then
        keys = HostData.keys input
        if List.length keys ≠ 1 || depth ≥ shapeMax then
            shapeFail
        else
            name = at keys 0
            case find ctors λentry → entry.name == name && not (List.isEmpty entry.plans) of
                Nothing →
                    shapeFail
                Just selected →
                    shapeArgs selected (Js.get input name) depth
    else
        shapeFail


shapeArgs : ShapeCtor, Js.Value, Int → Js.Value
shapeArgs selected payload depth =
    size = List.length selected.plans
    if size == 1 then
        result = shapeRun (at selected.plans 0) payload (depth + 1)
        if Js.same result shapeFail then shapeFail else selected.make [ result ]
    else if not (isArray payload) || lengthOf payload ≠ size then
        shapeFail
    else
        case shapeArgsFrom selected.plans payload 0 (depth + 1) of
            Nothing →
                shapeFail
            Just items →
                selected.make items


shapeArgsFrom : List ShapePlan, Js.Value, Int, Int → Maybe (List Js.Value)
shapeArgsFrom plans payload index depth =
    case plans of
        [] →
            Just []
        [ plan, …rest ] →
            if depth ≥ shapeMax then
                Nothing
            else
                result = shapeRun plan (Js.at payload index) (depth + 1)
                if Js.same result shapeFail then
                    Nothing
                else
                    Maybe.map (shapeArgsFrom rest payload (index + 1) depth) λitems →
                        [ result, …items ]


primitive : PrimitiveKind → Schema a a
primitive kind = primitiveWith kind []


primitiveWith : PrimitiveKind, List a → Schema a a
primitiveWith kind witness =
    typeId = resultIdentity witness
    declared typeId typeId (λ⊤ → nPrim kind)
        (Just (primitiveSlot kind))
        (Just (primitiveSlot kind))
        []
        (Just (primitiveSlot kind))
        (Just (primitiveSlot kind))
        (Just (primitiveSlot kind))
        (Just (primitiveSlot kind))
        (Just (primitiveSlot kind))


primitiveSlot : PrimitiveKind → Worker i o
primitiveSlot kind =
    λc depth parent input output item →
        Maybe.map (prim c kind depth (pathAt parent input output) (packed item)) unpacked


listWorkers : Workers e a → Workers (List e) (List a)
listWorkers workers =
    { parse = Maybe.map workers.parse listReadWorker
    , print = Maybe.map workers.print listWriteWorker
    , args = workers.args
    , decode = Maybe.map workers.decode listTypedWorker
    , encode = Maybe.map workers.encode listTypedWorker
    , read = Maybe.map workers.read listReadWorker
    , write = Maybe.map workers.write listWriteWorker
    , valid = Maybe.map workers.valid listReadWorker
    }


walkWorker : Context, Worker i o, Int, Path, List i, Int, Js.Ref (List o), Bool → Maybe (List o)
walkWorker c child depth path items offset output failed =
    case items of
        [] →
            if failed then Nothing else Just (Js.read output)
        [ item, …rest ] →
            answer =
                if depth ≥ c.max then
                    _ = compiledDeep c path (Js.from offset) (Js.from offset) item
                    Nothing
                else
                    child c (depth + 1) path (Js.from offset) (Js.from offset) item
            case answer of
                Nothing →
                    if c.all then
                        walkWorker c child depth path rest (offset + 1) output True
                    else
                        Nothing
                Just result →
                    Js.write output [ …(List.copy (Js.read output)), result ]
                    walkWorker c child depth path rest (offset + 1) output failed


listTypedWorker : Worker i o → Worker (List i) (List o)
listTypedWorker child =
    λc depth parent input output items →
        walkWorker c child depth (pathAt parent input output) items 0 (Js.ref []) False


listReadWorker : Worker Js.Value a → Worker Js.Value (List a)
listReadWorker child =
    λc depth parent input output items →
        if isArray items then
            walkWorker
                c
                child
                depth
                (pathAt parent input output)
                (fromHost items)
                0
                (Js.ref [])
                False
        else
            _ = compiledFail c parent input output 0 "expected an array" items False
            Nothing


listWriteWorker : Worker a Js.Value → Worker (List a) Js.Value
listWriteWorker child =
    λc depth parent input output items →
        Maybe.map
            (walkWorker c child depth (pathAt parent input output) items 0 (Js.ref []) False)
            toHost


nullableWorkers : Workers e a → Workers (Nullable e) (Nullable a)
nullableWorkers workers =
    { parse = Maybe.map workers.parse nullableReadWorker
    , print = Maybe.map workers.print nullableWriteWorker
    , args = workers.args
    , decode = Maybe.map workers.decode nullableTypedWorker
    , encode = Maybe.map workers.encode nullableTypedWorker
    , read = Maybe.map workers.read nullableReadWorker
    , write = Maybe.map workers.write nullableWriteWorker
    , valid = Maybe.map workers.valid nullableReadWorker
    }


nullableReadWorker : Worker Js.Value a → Worker Js.Value (Nullable a)
nullableReadWorker child =
    λc depth parent input output item →
        if Js.isNull item then
            Just Null
        else
            Maybe.map (child c depth parent input output item) NonNull


nullableWriteWorker : Worker a Js.Value → Worker (Nullable a) Js.Value
nullableWriteWorker child =
    λc depth parent input output item →
        case item of
            Null →
                Just Js.null
            NonNull datum →
                child c depth parent input output datum


nullableTypedWorker : Worker i o → Worker (Nullable i) (Nullable o)
nullableTypedWorker child =
    λc depth parent input output item →
        case item of
            Null →
                Just Null
            NonNull datum →
                Maybe.map (child c depth parent input output datum) NonNull


convertedWorkers : Workers e b, Conversion b a → Workers e a
convertedWorkers workers conv =
    { parse = Maybe.map workers.parse (forwardWorker conv _)
    , print = Maybe.map workers.print (backwardWorker conv _)
    , args = workers.args
    , decode = Maybe.map workers.decode (forwardWorker conv _)
    , encode = Maybe.map workers.encode (backwardWorker conv _)
    , read = Maybe.map workers.read (forwardWorker conv _)
    , write = Maybe.map workers.write (backwardWorker conv _)
    , valid = Maybe.map workers.valid (forwardWorker conv _)
    }


forwardWorker : Conversion b a, Worker i b → Worker i a
forwardWorker conv child =
    λc depth parent input output item →
        Maybe.andThen
            (child c depth parent input output item)
            (compiledForward c parent input output conv _)


backwardWorker : Conversion b a, Worker b o → Worker a o
backwardWorker conv child =
    λc depth parent input output item →
        Maybe.andThen
            (compiledBackward c parent input output conv item)
            (child (belowBackward c) depth parent input output _)


compiledBox : Node, Workers e a → Schema e a
compiledBox node workers = compiledBoxWith node workers [] []


compiledBoxWith : Node, Workers e a, List e, List a → Schema e a
compiledBoxWith node workers encoded typed =
    declared (resultIdentity encoded) (resultIdentity typed) (λ⊤ → node)
        workers.parse
        workers.print
        workers.args
        workers.decode
        workers.encode
        workers.read
        workers.write
        workers.valid


argumentsAnalysis : List Argument → Analysis
argumentsAnalysis args =
    case args of
        [] →
            { problem = Nothing, encodedOpaque = False, typeOpaque = False }
        [ supplied, …rest ] →
            first = supplied.analyse ⊤
            case first.problem of
                Just _ →
                    first
                Nothing →
                    later = argumentsAnalysis rest
                    { later | encodedOpaque = first.encodedOpaque || later.encodedOpaque }


erasedWorkers : Workers e a → Workers Value a
erasedWorkers workers =
    { parse = workers.parse
    , print = workers.print
    , args = workers.args
    , decode = Maybe.map workers.read hostReadWorker
    , encode = Maybe.map workers.write hostWriteWorker
    , read = workers.read
    , write = workers.write
    , valid = workers.valid
    }


hostReadWorker : Worker Js.Value a → Worker Value a
hostReadWorker child =
    λc depth parent input output item → child (hostEnds c) depth parent input output (toHost item)


hostWriteWorker : Worker a Js.Value → Worker a Value
hostWriteWorker child =
    λc depth parent input output item →
        Maybe.map (child (hostEnds c) depth parent input output item) typedHostValue


nodeBody : Node → NodeBody
nodeBody (Node storage) = Js.read storage


nodeRef : NodeBody → Node
nodeRef body = Node (Js.pure λ⊤ → Js.ref body)


nPrim : PrimitiveKind → Node
nPrim kind = nodeRef (NPrim kind)


nList : Node, Ends → Node
nList child ends = nodeRef (NList child ends)


nNullable : Node, OptionalEnds → Node
nNullable child ends = nodeRef (NNullable child ends)


nRecord : List FieldNode, Maps → Node
nRecord entries maps = nodeRef (NRecord entries maps)


nTagged : String, List VariantNode → Node
nTagged discriminator variants = nodeRef (NTagged discriminator variants)


nConverted : Node, (Datum → Result (List Issue) Datum), (Datum → Result (List Issue) Datum) → Node
nConverted child forward backward = nodeRef (NConverted child forward backward)


nFlipped : Node → Node
nFlipped child = nodeRef (NFlipped child)


nProjected : Int, Node → Node
nProjected side child = nodeRef (NProjected side child)


nRef : Cell → Node
nRef cell = nodeRef (NRef cell)


nBroken : String → Node
nBroken problem = nodeRef (NBroken problem)


nTuple : List Node, Access → Node
nTuple nodes access = nodeRef (NTuple nodes access)


nCtors : List CtorNode → Node
nCtors ctors = nodeRef (NCtors ctors)


nMaybe : Node, Int, OptionalEnds → Node
nMaybe child mode ends = nodeRef (NMaybe child mode ends)


nHost : Node → Node
nHost child = nodeRef (NHost child)
