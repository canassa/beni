--! Schemas: a value that describes one piece of data at two typed endpoints,
--! its **Encoded** form `e` and its program **Type** `a`, with a fallible
--! conversion in each direction (`docs/design/schema.md` §1, §4, §5).
--!
--! The builders below make a `Schema`, and the runners at the end run one.
--! A `schema` declaration is the same thing written as syntax (§2): its
--! `schema ⊤` is built of these builders, and its `parse` and `print` are
--! specialised code that calls the core-private values near the end (§6).
--!
--! **The engine owns the traversal.** A builder takes ordinary values and
--! functions — a field's name, a child schema, a mapping from a product to a
--! record, a conversion — and never a function that reads or writes the host
--! value itself. So the path, the depth, the options and the unknown-key
--! policy are threaded by the engine through every step, and no function a
--! builder was given can drop them (§5, *Context contract*).
--!
--!     toUser ( ( ⊤, userId ), nickname ) =
--!         { userId = userId, nickname = nickname }
--!
--!     fromUser u =
--!         ( ( ⊤, u.userId ), u.nickname )
--!
--!     user =
--!         Schema.record
--!             (Schema.fields
--!                 ▷ Schema.field "userId" Schema.int
--!                 ▷ Schema.key "user-id"
--!                 ▷ Schema.optional "nickname" Schema.string)
--!             (Schema.mapping toUser fromUser)
--!             (Schema.mapping toUser fromUser)
--!
--! **The engine is written here, in beni over `Js`** (§5, *The builder
--! API*; `plans/core-in-beni.md`). It reads and writes the host value — a
--! parsed JSON document, or the object a `write` makes — through `Js`, and
--! every beni value it shares with the program, an `Issue`, a `Result`, a
--! `Presence`, through ordinary patterns. Every function a builder keeps is
--! `sync`, because a runner calls it during the run.

import Browser.Host.Data as HostData
import Browser.Host.Json as HostJson
import Int32
import Js
import Js.Data as Data
import Js.Protocol as Protocol


-- ---- The public types ----------------------------------------------------

--| A field which may be absent from an external value.
pub type Presence a
    = Missing
    | Present a


--| A value which may be explicitly null at the external boundary.
pub type Nullable a
    = Null
    | NonNull a


--| One step from the root to a failed value.
pub type PathSegment
    = Field String
    | Index Int


--| The direction in which a schema operation was running.
pub type Direction
    = Decoding
    | Encoding


--| The typed endpoint at which a schema operation failed.
pub type Endpoint
    = Encoded
    | Type


--| A stable, structured category for a schema failure. `Issue.message`
--| carries the specific prose and `Issue.path` identifies the value.
pub type IssueCode
    = WrongShape
    | MissingKey
    | UnknownKey
    | UnknownTag
    | InvalidValue
    | DepthExceeded
    | InvalidOptions
    | ConversionFailed
    | CheckFailed
    | ParseFailed
    | PrintFailed
    | InvalidSchema


--| An opaque handle to an untyped host value. The schema engine reads it
--| directly; it is not a recursively marshalled Beni data structure.
pub foreign type Value


--| A schema failure with its complete location and operation context.
pub type alias Issue =
    path : List PathSegment
    direction : Direction
    endpoint : Endpoint
    code : IssueCode
    message : String
    input : Maybe Value


--| Whether traversal stops at the first failure or collects independent
--| sibling failures in traversal order.
pub type ErrorMode
    = FirstError
    | AllErrors


--| What to do with external keys which the schema does not claim.
pub type UnknownKeys
    = Ignore
    | Reject


--| Root options shared by compiled runners and library interpretation.
--| reportInput retains plain data only; a callable or native input is Nothing
--| (the owner, 2026-11-02), and reporting is off by default.
pub type alias Options =
    errors : ErrorMode
    unknownKeys : UnknownKeys
    maxDepth : Int
    reportInput : Bool


--| A schema with encoded endpoint `e` and program endpoint `a`.
--| Its representation remains owned by the engine and is not frozen here.
pub opaque type Schema e a
    = Schema (Box e a)


--| A fallible two-way conversion from schema endpoint `b` to program
--| endpoint `a`. Its representation remains owned by the engine.
pub opaque type Conversion b a
    = Conversion (b → Result (List Issue) a) (a → Result (List Issue) b)


--| The fields of a record schema being built, as two products: `pe` holds
--| the fields' Encoded values and `pa` their Type values, each a tuple
--| nested to the left, `( ( ( ⊤, first ), second ), third )`.
pub opaque type Fields pe pa
    = Fields (FieldBundle pe pa)


--| A product turned into a record, and back.
pub opaque type Mapping p r
    = Mapping (p → r) (r → p)


--| One variant of a tagged schema.
pub opaque type Variant e a
    = Variant (VariantBundle e a)


--| A variant's constructor, and the test that takes it apart: `inject`
--| builds the union from the payload, `project` answers the payload when
--| the value is this variant.
pub opaque type Injection p a
    = Injection (p → a) (a → Maybe p)


--| What `describe` answers: a schema's graph, as plain data. A recursive
--| schema appears once in `definitions` and is named by `Reference` wherever
--| it is used, its own body included.
pub type alias Description =
    root : Shape
    definitions : List Definition


--| A recursive schema's body. `id` is its identity in this description,
--| numbered in the order `describe` first meets it; `name` is the name it
--| was built with, which two different definitions may share.
pub type alias Definition =
    id : Int
    name : String
    shape : Shape


--| One node of a description.
pub type Shape
    = Primitive PrimitiveKind
    | ListOf Shape
    | NullableOf Shape
    | RecordOf (List FieldShape)
    | TaggedOf String (List VariantShape)
    | Converted Shape
    | Flipped Shape
    | TypeOnly Shape
    | EncodedOnly Shape
    | Reference Int
    | Invalid String
    | TupleOf (List Shape)
    | ConstructorsOf (List ConstructorShape)
    | MaybeOf Shape


--| The primitive schemas. `CharKind`, `Int32Kind` and `NeverKind` are a
--| derived schema's (`schema.md` §12.10): a string of one scalar value, a
--| 32-bit integer, and nothing at all.
pub type PrimitiveKind
    = StringKind
    | BoolKind
    | IntKind
    | FloatKind
    | FiniteFloatKind
    | NullKind
    | ValueKind
    | CharKind
    | Int32Kind
    | NeverKind


--| A record field: its declared name, which the Type endpoint reads and
--| writes, and its external key, which the Encoded endpoint does.
pub type alias FieldShape =
    name : String
    key : String
    optional : Bool
    shape : Shape


--| A variant: its constructor name, its literal tag, and its payload
--| record, if it has one.
pub type alias VariantShape =
    name : String
    tag : String
    payload : Maybe Shape


--| A constructor of a derived schema's custom type (`schema.md` §12.3): its
--| name, which is its wire form, and its arguments.
pub type alias ConstructorShape =
    name : String
    arguments : List Shape


--| A schema whose Encoded endpoint is the untyped host value: what a type's
--| `codec` method answers (`schema.md` §12.2).
pub type alias Codec a =
    Schema Value a


-- ---- Options -------------------------------------------------------------

--| The largest `maxDepth` a root operation accepts. A larger one, or a
--| negative one, is `InvalidOptions`: the engine recurses on the host's
--| stack once per level, and this bound keeps a whole operation at the
--| ceiling well inside the stack a browser or Node gives a program
--| (`schema.md` §5, *Traversal and failure rules*; §16, S3's *As built*).
pub maxDepthCeiling : Int
maxDepthCeiling = 1024


-- The default options' depth bound, named once: `defaultOptions` makes a
-- new record at each call, and `shapeMax` reads the bound, not one.
defaultMaxDepth : Int
defaultMaxDepth = 512


--| Effect's defaults: stop at the first failure, ignore unknown keys, and
--| leave the failing input out of an issue. `maxDepth` is 512.
pub defaultOptions : ⊤ → Options
defaultOptions ⊤ =
    { errors = FirstError
    , unknownKeys = Ignore
    , maxDepth = defaultMaxDepth
    , reportInput = False
    }


-- Descriptions retain only structure. Typed workers own every value adapter.
type Node
    = Node (Js.Ref NodeBody)


type NodeBody
    = NPrim PrimitiveKind
    | NList Node
    | NNullable Node
    | NRecord (List FieldNode)
    | NTagged String (List VariantNode)
    | NConverted Node
    | NRef Cell
    | NBroken String
    | NTuple (List Node)
    | NCtors (List CtorNode)
    | NMaybe Node Int
    | NHost Node


type alias FieldNode =
    name : String
    key : String
    renamed : Bool
    optional : Bool
    lenient : Bool
    node : Node


type alias CtorNode =
    name : String
    nodes : List Node


type alias VariantNode =
    name : String
    tag : String
    payload : Maybe Node
    problem : Maybe String


type alias Cell =
    id : Int
    name : String
    build : Node → Node
    state : Js.Ref Int
    body : Js.Ref (Maybe Node)


type alias Box e a =
    encodedId : String
    typedId : String
    encodedCheck : e → Maybe Js.Value
    typedCheck : a → Maybe Js.Value
    node : ⊤ → Node
    engine : Engine e a


type alias FieldBundle pe pa =
    build : List String → Product pe pa
    args : List Argument
    fields : List FieldNode
    problem : Maybe String


type alias Context =
    all : Bool
    reject : Bool
    scope : Traversal
    max : Int
    report : Bool
    dir : Direction
    json : Bool
    sh : Bool
    dh : Bool
    issues : Js.Value
    fail : Js.Value


type alias Path =
    Js.Value


type alias PathStep =
    parent : Path
    input : Js.Value
    output : Js.Value


nodeOf : Schema e a → Node
nodeOf (Schema state) = state.node ⊤


--| A string, both ways.
pub string : Schema String String
string = primitive StringKind


--| `true` or `false`.
pub bool : Schema Bool Bool
bool = primitive BoolKind


--| A safe integer, both ways: a whole number from −(2⁵³−1) to 2⁵³−1. A
--| well-typed `Int` outside that range fails to encode.
pub int : Schema Int Int
int = primitive IntKind


--| Any number. Printing NaN or an infinity as JSON fails, because JSON has
--| no number for it.
pub float : Schema Float Float
float = primitive FloatKind


--| A finite number, both ways.
pub finiteFloat : Schema Float Float
finiteFloat = primitive FiniteFloatKind


--| JSON's `null`, whose one value is `Null`.
pub null : Schema (Nullable ⊥) (Nullable ⊥)
null = scalarSchema NullKind (λ_ → Js.null) (λ_ → Null) []


--| Any host value, unread: the Encoded value is the Type value.
pub value : Schema Value Value
value = primitive ValueKind


--| A list of the child's values: an array outside, a `List` inside.
pub list : Schema e a → Schema (List e) (List a)
list child =
    node = (nList (nodeOf child))
    case engineOf child of
        Compiled workers →
            compiledBox node (listWorkers workers)


--| The child's values, or `null`, told apart.
pub nullable : Schema e a → Schema (Nullable e) (Nullable a)
nullable child =
    node = (nNullable (nodeOf child))
    case engineOf child of
        Compiled workers →
            compiledBox node (nullableWorkers workers)


--| How the products of `fields` become the records of each endpoint, and
--| back: `to` builds the record from the product, `from` takes it apart.
pub mapping : sync (p → r), sync (r → p) → Mapping p r
mapping to from = Mapping to from


--| A fallible conversion: from the source endpoint `b` to the target `a`,
--| and back. An `Err` holds issues whose paths are relative to the value
--| converted; the engine puts them where the value is.
pub conversion :
      sync (b → Result (List Issue) a)
    , sync (a → Result (List Issue) b)
    → Conversion b a
conversion forward backward = Conversion forward backward


--| The schema's values, converted: decoding reads `e` to `b` and converts
--| it to `a`; encoding converts `a` back to `b` and writes `e`. The Type
--| endpoint is the conversion's target, which has no external form of its
--| own.
pub converted : Schema e b, Conversion b a → Schema e a
converted source conv =
    node = (nConverted (nodeOf source))
    case engineOf source of
        Compiled workers →
            compiledBox node (convertedWorkers workers conv)


--| A constructor and its test, for one variant at one endpoint.
pub injection : sync (p → a), sync (a → Maybe p) → Injection p a
injection inject project = Injection inject project


--| A schema's Encoded endpoint forgotten: the same schema, as the `Codec`
--| a type's `codec` method answers. A validated type's module writes
--| `pub codec ⊤ = Schema.erased (Schema.converted Schema.string toUserId)`.
--| Its Encoded end is a `Value`, so `decode` reads it as `read` does and
--| `encode` writes it as `write` does.
pub erased : Schema e a → Codec a
erased schema =
    case engineOf schema of
        Compiled workers →
            compiledBox (nHost (nodeOf schema)) (erasedWorkers workers)


--| The schema of a type, derived from its shape (`schema.md` §12.2): its
--| module's `codec` when it declares one, else its records, tuples and
--| constructors read as JSON. `Page.schema (Schema.derived ⊤)` composes it.
pub derived : ⊤ → Codec a
    where a.codec : ⊤ → Codec a
derived unit = a.codec unit


--| `derived` for a type's own module, which reads its shape even where the
--| module declares `codec`: an opaque type's module writes `pub codec ⊤ =
--| Schema.structural ⊤`, which `derived` there would answer with itself
--| (`schema.md` §12.2, §12.10). Accepted only in the type's own module.
pub structural : ⊤ → Codec a
    where a.codec : ⊤ → Codec a
structural unit = a.codec unit


--| A conversion's failure at the value it converted, `ConversionFailed`.
--| The engine fills in the direction, the endpoint and the path.
pub issue : String → Issue
issue message = issueAt [] message


--| A conversion's failure below the value it converted, at a path relative
--| to it.
pub issueAt : List PathSegment, String → Issue
issueAt path message =
    { path = path
    , direction = Decoding
    , endpoint = Type
    , code = ConversionFailed
    , message = message
    , input = Nothing
    }


--| No fields yet.
pub fields : Fields ⊤ ⊤
fields =
    Fields
        { fields = []
        , build = λ_ → emptyProduct
        , args = []
        , problem = Nothing
        }


fieldNode : String, Schema e a, Bool → FieldNode
fieldNode name child optionalField =
    { name = name
    , key = name
    , renamed = False
    , optional = optionalField
    , lenient = False
    , node = nodeOf child
    }


--| A required field, read and written under its own name until `key`
--| renames it outside.
pub field : Fields pe pa, String, Schema e a → Fields (pe × e) (pa × a)
field ((Fields bundle) as previous) name child =
    Fields
        { build =
            λkeys →
                case engineOf child of
                    Compiled workers →
                        appendProduct
                            (bundle.build keys)
                            (requiredProduct
                                name
                                (Maybe.withDefault (List.get keys (List.length bundle.fields)) name)
                                workers
                            )
        , args = [ …(List.copy bundle.args), argument child ]
        , fields = [ …(List.copy bundle.fields), fieldNode name child False ]
        , problem = bundle.problem
        }


--| A field that may be missing: its key absent is `Missing`, and present it
--| is `Present` of the child's value, whatever that is — `null` included
--| when the child is `nullable`.
pub optional :
      Fields pe pa
    , String
    , Schema e a
    → Fields (pe × Presence e) (pa × Presence a)
optional ((Fields bundle) as previous) name child =
    Fields
        { build =
            λkeys →
                case engineOf child of
                    Compiled workers →
                        appendProduct
                            (bundle.build keys)
                            (optionalProduct
                                name
                                (Maybe.withDefault (List.get keys (List.length bundle.fields)) name)
                                workers
                            )
        , args = [ …(List.copy bundle.args), argument child ]
        , fields = [ …(List.copy bundle.fields), fieldNode name child True ]
        , problem = bundle.problem
        }


firstProblem : Maybe String, String → Maybe String
firstProblem previous problem =
    case previous of
        Just _ →
            previous
        Nothing →
            Just problem


--| The external key of the field just added: the Encoded endpoint reads and
--| writes the key, and the Type endpoint, and both typed records, the
--| field's name. A declaration's `as "key"`.
pub key : Fields pe pa, String → Fields pe pa
key (Fields bundle) external =
    case List.last bundle.fields of
        Nothing →
            Fields
                { bundle
                    | problem =
                        firstProblem
                            bundle.problem
                            "Schema.key renames the field added before it, and there is none"
                }
        Just last →
            if last.renamed then
                Fields
                    { bundle
                        | problem =
                            firstProblem
                                bundle.problem
                                "the field ${last.name} already has the key \"${last.key}\""
                    }
            else
                Fields
                    { bundle
                        | fields =
                            [ …(List.copy (List.take bundle.fields (List.length bundle.fields - 1)))
                            , { Record.copy last | key = external, renamed = True }
                            ]
                    }


--| A record schema: the fields, then how each endpoint's product becomes
--| its record. The two mappings are often one polymorphic pair of functions,
--| since both records have the same field names.
pub record : Fields pe pa, Mapping pe e, Mapping pa a → Schema e a
record (Fields bundle) encoded typed =
    problem =
        case bundle.problem of
            Just prior →
                Just prior
            Nothing →
                case duplicate bundle.fields .name of
                    Just name →
                        Just "two fields are named ${name}"
                    Nothing →
                        Maybe.map (duplicate bundle.fields .key) λexternal →
                            "two fields read and write the key \"${external}\""
    node =
        case problem of
            Just found →
                nBroken found
            Nothing →
                nRecord bundle.fields
    keys = List.map bundle.fields .key
    compiledBox
        node
        (recordWorkers keys (bundle.build keys) encoded typed
            [ construction problem, …(List.copy bundle.args) ]
        )


duplicate : List a, (a → String) → Maybe String
duplicate items nameOf =
    case items of
        [] →
            Nothing
        [ item, …rest ] →
            name = nameOf item
            if List.any rest λother → nameOf other == name then Just name else duplicate rest nameOf


--| A variant with a payload: its constructor name, its tag, its payload —
--| a `record` schema, whose fields sit beside the discriminator — and its
--| two constructors.
pub variant :
      String
    , String
    , Schema pe pa
    , Injection pe e
    , Injection pa a
    → Variant e a
variant name tag payload injectE injectA =
    node = nodeOf payload
    Variant
        { node =
            { name = name
            , tag = tag
            , payload = Just node
            , problem =
                case nodeBody node of
                    NRecord _ →
                        Nothing
                    _ →
                        Just "the payload of the variant ${name} is not a record schema"
            }
        , workers =
            case engineOf payload of
                Compiled workers →
                    variantWorkers workers injectE injectA
        , args = [ argument payload ]
        }


--| A variant with no payload: only the discriminator is written.
pub nullary : String, String, Injection ⊤ e, Injection ⊤ a → Variant e a
nullary name tag injectE injectA =
    Variant
        { node =
            { name = name
            , tag = tag
            , payload = Nothing
            , problem = Nothing
            }
        , workers = nullaryWorkers injectE injectA
        , args = []
        }


--| A tagged union: the discriminator key, then the variants. A value is an
--| object whose discriminator holds one variant's tag and whose other keys
--| are that variant's payload.
pub tagged : String, List (Variant e a) → Schema e a
tagged discriminator variants =
    nodes = List.map variants λ(Variant bundle) → bundle.node
    bundles = List.map variants λ(Variant bundle) → bundle
    args = List.concatMap variants λ(Variant bundle) → bundle.args
    node = taggedNode discriminator nodes
    problem =
        case nodeBody node of
            NBroken found →
                Just found
            _ →
                Nothing
    compiledBox node (taggedWorkers discriminator bundles [ construction problem, …args ])


taggedNode : String, List VariantNode → Node
taggedNode discriminator nodes =
    case firstVariantProblem nodes of
        Just problem →
            (nBroken problem)
        Nothing →
            if List.isEmpty nodes then
                (nBroken "a tagged schema needs a variant")
            else
                case duplicate nodes .tag of
                    Just tag →
                        (nBroken "two variants have the tag \"${tag}\"")
                    Nothing →
                        case duplicate nodes .name of
                            Just name →
                                (nBroken "two variants are named ${name}")
                            Nothing →
                                case find nodes (variantClashes discriminator _) of
                                    Just clash →
                                        (nBroken
                                            "the variant ${clash.name} has a field on the discriminator \"${discriminator}\""
                                        )
                                    Nothing →
                                        (nTagged discriminator nodes)


firstVariantProblem : List VariantNode → Maybe String
firstVariantProblem variants =
    case variants of
        [] →
            Nothing
        [ node, …rest ] →
            case node.problem of
                Just problem →
                    Just problem
                Nothing →
                    firstVariantProblem rest


variantClashes : String, VariantNode → Bool
variantClashes discriminator selected =
    case Maybe.map selected.payload nodeBody of
        Just (NRecord fs) →
            List.any fs λentry → entry.key == discriminator || entry.name == discriminator
        _ →
            False


nextCell : Js.Ref Int
nextCell = Js.ref 0


cellOf : String, (Node → Node) → Cell
cellOf name build =
    id = Js.read nextCell
    Js.write nextCell (id + 1)
    { id = id, name = name, build = build, state = Js.ref 0, body = Js.ref Nothing }


--| A schema that refers to itself: the function is given the schema it
--| defines and builds its body, once, the first time it is needed. A
--| reference to it is resolved by identity, never by name, so two schemas
--| built with one name are still two.
pub recursive : String, sync (Schema e a → Schema e a) → Schema e a
recursive name build = recursiveWith name build (Js.ref Nothing) (Js.ref 0) (Js.ref Nothing)


resolve : Cell → Maybe Node
resolve cell =
    case Js.read cell.state of
        2 →
            Js.read cell.body
        1 →
            Nothing
        _ →
            Js.write cell.state 1
            node = cell.build (nRef cell)
            Js.write cell.body (Just node)
            Js.write cell.state 2
            Just node


dangling : Cell → String
dangling cell = "the recursive schema ${cell.name} is used before its body is built"


at : List a, Int → a
at items index =
    case List.get items index of
        Just item →
            item
        Nothing →
            Protocol.defect "schema engine index is out of bounds"


toHost : a → Js.Value
toHost x = Js.from x


fromHost : Js.Value → a
fromHost v = Js.to v


-- The engine's views of a value it was handed.

stringOf : Js.Value → String
stringOf v = Js.to v


intOf : Js.Value → Int
intOf v = Js.to v


-- The `i`th element of a host array, as what the engine put there.

lengthOf : Js.Value → Int
lengthOf xs = Js.to (Js.get xs "length")


-- `x` pushed onto the host array `xs`.

inputEndpoint : Direction → Endpoint
inputEndpoint dir = if dir == Decoding then Encoded else Type


outputEndpoint : Direction → Endpoint
outputEndpoint dir = if dir == Decoding then Type else Encoded


rootErr : Direction, Endpoint, IssueCode, String → Result (List Issue) b
rootErr dir endpoint code message = Err (rootIssue dir endpoint code message)


rootIssue : Direction, Endpoint, IssueCode, String → List Issue
rootIssue dir endpoint code message =
    [ { path = []
      , direction = dir
      , endpoint = endpoint
      , code = code
      , message = message
      , input = Nothing
      }
    ]


-- What ends a root operation before anything is read: bad options, a
-- construction failure.

optionsProblem : Options, Direction → Maybe (List Issue)
optionsProblem o dir =
    if
        not
            (HostData.isInteger (Js.from o.maxDepth)
                && o.maxDepth ≥ 0
                && o.maxDepth ≤ maxDepthCeiling
            )
    then
        Just
            (rootIssue
                dir
                (inputEndpoint dir)
                InvalidOptions
                "maxDepth must be from 0 to ${String.fromInt maxDepthCeiling}, not ${String.fromInt o.maxDepth}"
            )
    else
        Nothing


-- The context of one root operation. A step that failed answers the
-- operation's issue array, which no value it reads or makes can be.

context : Options, Direction, Bool, Bool, Bool → Context
context o dir sh dh json =
    issues = Js.array []
    { all = o.errors == AllErrors
    , scope = Unclaimed
    , reject = o.unknownKeys == Reject
    , max = o.maxDepth
    , report = o.reportInput
    , dir = dir
    , json = json
    , sh = sh
    , dh = dh
    , issues = issues
    , fail = toHost workerAbsent
    }


isType : Js.Value, String → Bool
isType v name = Js.same (Js.typeOf v) (Js.from name)


isArray : Js.Value → Bool
isArray v = HostData.isArray (v)


isObject : Js.Value → Bool
isObject v = isType v "object" && not (Js.isNull v) && not (isArray v)


isFinite : Js.Value → Bool
isFinite v = HostData.isFinite (v)


hasOwn : Js.Value, String → Bool
hasOwn v k = HostData.hasOwn (v) (stringOf (Js.from k))


-- The names a standard `Object.prototype` holds, which a read finds on
-- any object: tested as own keys (`present`). The compiled workers test the
-- same names, from `SchemaShare.isPrototypeKey`; a unit test there keeps
-- the two lists equal, so compiled and library runs answer alike whatever
-- a page adds to `Object.prototype`.

prototypeKey : String → Bool
prototypeKey k =
    k == "__proto__"
        || k == "__defineGetter__"
        || k == "__defineSetter__"
        || k == "__lookupGetter__"
        || k == "__lookupSetter__"
        || k == "constructor"
        || k == "hasOwnProperty"
        || k == "isPrototypeOf"
        || k == "propertyIsEnumerable"
        || k == "toLocaleString"
        || k == "toString"
        || k == "valueOf"


-- Whether host object `v` holds key `k`, as every reading runner tests it
-- (`schema.md` §5, *Host values*, amended 2026-10-17): a read of it answers
-- anything but `undefined`, through the prototype chain — but for a name
-- `prototypeKey` lists, which must be `v`'s own, so the prototype never
-- shadows a field.

present : Js.Value, String → Bool
present v k =
    if prototypeKey k then
        hasOwn v k
    else
        not (Js.isUndefined (Js.get v k))


-- A payload's discriminator and variant.

printable : Js.Value, Int → Int
printable v budget =
    if isType v "number" then
        if isFinite v then
            0
        else
            2
    else if not (isType v "object") || Js.isNull v then
        0
    else if isArray v then
        printableItems v Js.undefined 0 (lengthOf v) budget
    else
        keys = toHost (HostData.keys (v))
        printableItems keys v 0 (lengthOf keys) budget


-- The items of an array, or with `owner` an object's values by its keys.

printableItems : Js.Value, Js.Value, Int, Int, Int → Int
printableItems items owner i n budget =
    if i ≥ n then
        0
    else if budget < 1 then
        1
    else
        item =
            if Js.isUndefined owner then
                Js.at items i
            else
                Js.get owner (stringOf (Js.at items i))
        r = printable item (budget - 1)
        if r ≠ 0 then
            r
        else
            printableItems items owner (i + 1) n budget


-- A list's elements, each one level down: the depth bound is tested before
-- the descent (§5), and the references entered at the list's own position
-- are left behind. A failure is an issue added since `before`.

oneScalar : Js.Value → Bool
oneScalar v =
    n = lengthOf v
    if n == 0 || n > 2 then
        False
    else
        cp = intOf (Js.call v "codePointAt" [ Js.from 0 ])
        (cp < 0xD800 || cp > 0xDFFF) && n == (if cp > 0xFFFF then 2 else 1)


slotOf : Int → String
slotOf i =
    if i < 26 then
        String.fromChar (Char.fromCode (97 + i))
    else
        "a${String.fromInt i}"


-- `[shapeTagged, discriminator, tag₁, v₁, …]`: the discriminator read as a
-- field is, then the variant whose tag it is: a nullary one's value, or the
-- record shape of its payload, one level down, whose `make` builds the
-- variant.

atRoot : Path
atRoot = Js.null


step : Path, Js.Value, Js.Value → Path
step parent input output = toHost { parent = parent, input = input, output = output }


pathAt : Path, Js.Value, Js.Value → Path
pathAt parent input output = if Js.isNull input then parent else step parent input output


pathArray : Path, Bool → List PathSegment
pathArray path output = collect path output []


-- A reported leaf needs its segment, not an intermediate parent link.
pathArrayAt : Path, Js.Value, Js.Value, Bool → List PathSegment
pathArrayAt parent input output written =
    if Js.isNull input then
        pathArray parent written
    else
        item = if written then output else input
        segment = if Js.typeIs item "number" then Index (intOf item) else Field (stringOf item)
        collect parent written [ segment ]


collect : Path, Bool, List PathSegment → List PathSegment
collect path output segments =
    if Js.isNull path then
        segments
    else
        part : PathStep
        part = fromHost path
        item = if output then part.output else part.input
        segment = if Js.typeIs item "number" then Index (intOf item) else Field (stringOf item)
        collect part.parent output [ segment, …segments ]


issueCount : Context → Int
issueCount c = lengthOf c.issues


--| An Encoded value converted to the Type.
pub decode : Schema e a, e → Result (List Issue) a
decode schema input = decodeWith schema (defaultOptions ⊤) input


--| `decode` with options.
pub decodeWith : Schema e a, Options, e → Result (List Issue) a
decodeWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledRun
                opts
                workers.args
                (selectedWorker workers.decode)
                Decoding
                False
                False
                input


--| A Type value converted to the Encoded.
pub encode : Schema e a, a → Result (List Issue) e
encode schema input = encodeWith schema (defaultOptions ⊤) input


--| `encode` with options.
pub encodeWith : Schema e a, Options, a → Result (List Issue) e
encodeWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledRun
                opts
                workers.args
                (selectedWorker workers.encode)
                Encoding
                False
                False
                input


--| A host value read as the Encoded endpoint's external form, to the Type.
pub read : Schema e a, Value → Result (List Issue) a
read schema input = readWith schema (defaultOptions ⊤) input


--| `read` with options.
pub readWith : Schema e a, Options, Value → Result (List Issue) a
readWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledRun
                opts
                workers.args
                (selectedWorker workers.read)
                Decoding
                True
                False
                (toHost input)


--| A Type value written as the Encoded endpoint's external form.
pub write : Schema e a, a → Result (List Issue) Value
write schema input = writeWith schema (defaultOptions ⊤) input


--| `write` with options.
pub writeWith : Schema e a, Options, a → Result (List Issue) Value
writeWith schema opts input =
    case engineOf schema of
        Compiled workers →
            Result.map
                (compiledRun
                    opts
                    workers.args
                    (selectedWorker workers.write)
                    Encoding
                    False
                    True
                    input
                )
                typedHostValue


--| JSON text read to the Type.
pub parse : Schema e a, String → Result (List Issue) a
parse schema text = parseWith schema (defaultOptions ⊤) text


--| `parse` with options. `JSON.parse` reports malformed text by throwing a
--| `SyntaxError`, and only that is an answer; anything else it throws goes
--| on as it came (CLAUDE.md rule 9).
pub parseWith : Schema e a, Options, String → Result (List Issue) a
parseWith schema opts text =
    case engineOf schema of
        Compiled workers →
            compiledParse opts workers.args (selectedWorker workers.parse) text


parseJson : String → Maybe Js.Value
parseJson text =
    case HostJson.parse text of
        Ok raw →
            Just raw
        Err _ →
            Nothing


--| A Type value printed as JSON text.
pub print : borrowed Schema e a, aliased a → fresh Result (List Issue) String
print schema input = printWith schema (defaultOptions ⊤) input


--| `print` with options.
pub printWith : borrowed Schema e a, Options, aliased a → fresh Result (List Issue) String
printWith schema opts input =
    case engineOf schema of
        Compiled workers →
            compiledPrint opts workers.args (selectedWorker workers.print) input


--| The schema's graph, both endpoints, as plain data. It runs no
--| conversion; it builds a recursive schema's body if no run has yet.
pub describe : Schema e a → Description
describe schema =
    ids = Js.ref []
    definitions = Js.ref []
    root = shapeOf ids definitions (nodeOf schema)
    { root = root, definitions = List.sortBy (List.copy (Js.read definitions)) .id }


shapeOf : Js.Ref (List (Int × Int)), Js.Ref (List Definition), Node → Shape
shapeOf ids definitions node =
    case nodeBody node of
        NPrim kind →
            Primitive kind
        NList child →
            ListOf (shapeOf ids definitions child)
        NNullable child →
            NullableOf (shapeOf ids definitions child)
        NRecord fs →
            RecordOf
                (List.map fs λentry →
                    { name = entry.name
                    , key = entry.key
                    , optional = entry.optional
                    , shape = shapeOf ids definitions entry.node
                    }
                )
        NTagged discriminator variants →
            TaggedOf discriminator
                (List.map variants λselected →
                    { name = selected.name
                    , tag = selected.tag
                    , payload = Maybe.map selected.payload (shapeOf ids definitions _)
                    }
                )
        NConverted child →
            Converted (shapeOf ids definitions child)
        NRef cell →
            case find (Js.read ids) λ( entry, _ ) → entry == cell.id of
                Just ( _, known ) →
                    Reference known
                Nothing →
                    id = List.length (Js.read ids)
                    Js.write ids [ …(List.copy (Js.read ids)), ( cell.id, id ) ]
                    shape =
                        case resolve cell of
                            Nothing →
                                Invalid (dangling cell)
                            Just body →
                                shapeOf ids definitions body
                    definition : Definition
                    definition = { id = id, name = cell.name, shape = shape }
                    Js.write definitions [ …(List.copy (Js.read definitions)), definition ]
                    Reference id
        NBroken problem →
            Invalid problem
        NTuple nodes →
            TupleOf (List.map nodes (shapeOf ids definitions _))
        NCtors ctors →
            ConstructorsOf
                (List.map ctors λctor →
                    { name = ctor.name
                    , arguments = List.map ctor.nodes (shapeOf ids definitions _)
                    }
                )
        NMaybe child _ →
            MaybeOf (shapeOf ids definitions child)
        NHost child →
            shapeOf ids definitions child


derivedChar : Schema Char Char
derivedChar = primitive CharKind


derivedInt32 : Schema Int32.Int32 Int32.Int32
derivedInt32 = primitive Int32Kind


derivedNever : Schema ⊥ ⊥
derivedNever = primitive NeverKind


find : List a, (a → Bool) → Maybe a
find items predicate =
    case items of
        [] →
            Nothing
        [ item, …rest ] →
            if predicate item then Just item else find rest predicate


each : List a, (a → ⊤) → ⊤
each items callback =
    case items of
        [] →
            ⊤
        [ item, …rest ] →
            callback item
            each rest callback


isNothing : Maybe a → Bool
isNothing option =
    case option of
        Nothing →
            True
        Just _ →
            False


-- One private absence identity is shared by typed workers and generated raw
-- workers, so the generated path needs no Maybe adapter or per-call box.
workerAbsent : Js.Opt ⊤
workerAbsent = Js.none ⊤


workerEmpty : Js.Opt a → Bool
workerEmpty slot = Js.same slot workerAbsent


-- Only the local identity branches run here; the payload is never invoked.
-- Callers test absence before reading. A mismatch is a core protocol defect.
workerValue : Js.Opt a → a
workerValue slot = Js.pure λ⊤ →
    Js.optMatch slot
        (λ⊤ → Protocol.defect "an absent schema worker result was read")
        identity


workerMap : Js.Opt a, (a → b) → Js.Opt b
workerMap slot callback =
    if workerEmpty slot then
        Js.none ⊤
    else
        Js.some (callback (workerValue slot))


workerAndThen : Js.Opt a, (a → Js.Opt b) → Js.Opt b
workerAndThen slot callback =
    if workerEmpty slot then
        Js.none ⊤
    else
        callback (workerValue slot)


type alias Worker i o =
    Context, Int, Path, Js.Value, Js.Value, i → Js.Opt o


type Engine e a
    = Compiled (Workers e a)


type alias Workers e a =
    parse : Maybe (Worker Js.Value a)
    print : Maybe (Worker a Js.Value)
    args : List Argument
    decode : Maybe (Worker e a)
    encode : Maybe (Worker a e)
    read : Maybe (Worker Js.Value a)
    write : Maybe (Worker a Js.Value)
    valid : Maybe (Worker Js.Value a)


type alias Argument =
    analyse : ⊤ → Maybe String


argument : Schema e a → Argument
argument schema =
    case engineOf schema of
        Compiled workers →
            { analyse = λ⊤ → argumentsAnalysis workers.args }


declared :
      (e → Maybe Js.Value)
    , (a → Maybe Js.Value)
    , String
    , String
    , (⊤ → Node)
    , Maybe (Worker Js.Value a)
    , Maybe (Worker a Js.Value)
    , List Argument
    , Maybe (Worker e a)
    , Maybe (Worker a e)
    , Maybe (Worker Js.Value a)
    , Maybe (Worker a Js.Value)
    , Maybe (Worker Js.Value a)
    → Schema e a
declared checkEncoded checkTyped encodedId typedId description parsing printing args decoding encoding reading writing valid =
    Schema
        { encodedId = encodedId
        , typedId = typedId
        , encodedCheck = checkEncoded
        , typedCheck = checkTyped
        , node = description
        , engine =
            Compiled
                { parse = parsing
                , print = printing
                , args = compiledArguments args
                , decode = decoding
                , encode = encoding
                , read = reading
                , write = writing
                , valid = valid
                }
        }


selectedWorker : Maybe (Worker i o) → Worker i o
selectedWorker option =
    case option of
        Just worker →
            worker
        Nothing →
            Protocol.defect "an eliminated schema worker was reached"


compiledProblem : Options, Direction, List Argument → Maybe (List Issue)
compiledProblem opts dir args =
    case optionsProblem opts dir of
        Just issues →
            Just issues
        Nothing →
            argumentProblem args dir


argumentProblem : List Argument, Direction → Maybe (List Issue)
argumentProblem args dir =
    case args of
        [] →
            Nothing
        [ supplied, …rest ] →
            case supplied.analyse ⊤ of
                Just problem →
                    Just (rootIssue dir (inputEndpoint dir) InvalidSchema problem)
                Nothing →
                    argumentProblem rest dir


compiledParse : Options, List Argument, Worker Js.Value a, String → Result (List Issue) a
compiledParse opts args worker text =
    case compiledProblem opts Decoding args of
        Just issues →
            Err issues
        Nothing →
            case parseJson text of
                Nothing →
                    rootErr Decoding Encoded ParseFailed "invalid JSON"
                Just raw →
                    c = context opts Decoding True False True
                    answer = worker c 0 atRoot Js.null Js.null raw
                    if workerEmpty answer then
                        Err (fromHost c.issues)
                    else
                        Ok (workerValue answer)


compiledPrint : Options, List Argument, Worker a Js.Value, a → Result (List Issue) String
compiledPrint opts args worker input =
    case compiledProblem opts Encoding args of
        Just issues →
            Err issues
        Nothing →
            c = context opts Encoding False True True
            answer = worker c 0 atRoot Js.null Js.null input
            if workerEmpty answer then
                Err (fromHost c.issues)
            else
                Ok (stringOf (HostJson.stringify (workerValue answer)))


compiledRun :
      Options
    , List Argument
    , Worker i o
    , Direction
    , Bool
    , Bool
    , i
    → Result (List Issue) o
compiledRun opts args worker dir sh dh input =
    case compiledProblem opts dir args of
        Just issues →
            Err issues
        Nothing →
            c = context opts dir sh dh False
            answer = worker c 0 atRoot Js.null Js.null input
            if workerEmpty answer then
                Err (fromHost c.issues)
            else
                Ok (workerValue answer)


readSlot : Schema e a → Worker Js.Value a
readSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.parse


writeSlot : Schema e a → Worker a Js.Value
writeSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.print


decodeSlot : Schema e a → Worker e a
decodeSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.decode


encodeSlot : Schema e a → Worker a e
encodeSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.encode


readValueSlot : Schema e a → Worker Js.Value a
readValueSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.read


writeValueSlot : Schema e a → Worker a Js.Value
writeValueSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.write


readValidSlot : Schema e a → Worker Js.Value a
readValidSlot ((Schema state) as schema) =
    case state.engine of
        Compiled workers →
            selectedWorker workers.valid


-- The engine supplies this element type's checked identity as hidden evidence.
-- The empty witness carries only its static type and is never inspected.
foreign pure endpointIdentity : List a → String


-- Generated schema producers already carry these exact endpoint identities.

-- Typed check capabilities are captured once when a schema is built. Generated
-- adapters forward them as checked-data evidence, without inspecting a value.
-- The generated path calls the same checked conversion with its compiler
-- witness. This ordinary typed helper also builds stored endpoint checkers.
checkedInput : a → Maybe Js.Value
checkedInput datum = Data.checked datum


encodedCheck : Schema e a → (e → Maybe Js.Value)
encodedCheck (Schema state) = state.encodedCheck


typedCheck : Schema e a → (a → Maybe Js.Value)
typedCheck (Schema state) = state.typedCheck


encodedIdentity : Schema e a → String
encodedIdentity (Schema state) = state.encodedId


typedIdentity : Schema e a → String
typedIdentity (Schema state) = state.typedId


describedOf : Schema e a → Node
describedOf schema = nodeOf schema


describedList : Node → Node
describedList child = nList child


describedNullable : Node → Node
describedNullable child = nNullable child


describedRecord : List FieldNode → Node
describedRecord fs = nRecord fs


describedField : String, String, Bool, Node → FieldNode
describedField name external optionalField node =
    { name = name
    , key = external
    , renamed = name ≠ external
    , optional = optionalField
    , lenient = False
    , node = node
    }


describedTagged : String, List VariantNode → Node
describedTagged discriminator variants = nTagged discriminator variants


describedVariant : String, String, Maybe Node → VariantNode
describedVariant name tag payload = { name = name, tag = tag, payload = payload, problem = Nothing }


describedRecursive : String, (Node → Node) → Node
describedRecursive name build = nRef (cellOf name build)


describedHost : Node → Node
describedHost child = nHost child


describedTuple : List Node → Node
describedTuple nodes = nTuple nodes


describedConstructors : List CtorNode → Node
describedConstructors ctors = nCtors ctors


describedMaybe : Node, Int → Node
describedMaybe child mode = nMaybe child mode


describedMaybeField : String, Node, Int → FieldNode
describedMaybeField name child mode =
    { name = name
    , key = name
    , renamed = False
    , optional = True
    , lenient = True
    , node = nMaybe child mode
    }


describedConverted : Node → Node
describedConverted child = nConverted child


-- These failure helpers accept the real input type. Only the checked data
-- projection runs, and only on a reported failure; no input is erased.
compiledFail : Context, Path, Js.Value, Js.Value, Int, String, a, Bool → Js.Value
compiledFail c parent input output code message item written =
    entry : Issue
    entry =
        { path = pathArrayAt parent input output written
        , direction = c.dir
        , endpoint =
            if written || isBackward c.scope then (outputEndpoint c.dir) else (inputEndpoint c.dir)
        , code = fromHost (Js.at issueCodes code)
        , message = message
        , input = if c.report then Maybe.map (Data.checked item) fromHost else Nothing
        }
    _ = Js.call c.issues "push" [ toHost entry ]
    c.fail


compiledDeep : Context, Path, Js.Value, Js.Value, a → Js.Value
compiledDeep c parent input output item =
    compiledFail c parent input output 5 "the depth limit is reached" item False


compiledMissing : Context, Path, Js.Value, Js.Value, a → Js.Value
compiledMissing c parent input output item =
    compiledFail c parent input output 1 "missing key \"${stringOf input}\"" item False


hostWorker : Worker i o → Worker i o
hostWorker inner =
    λc depth parent input output item → inner (hostEnds c) depth parent input output item


compiledForward : Context, Path, Js.Value, Js.Value, Conversion b a, b → Js.Opt a
compiledForward c parent input output (Conversion forward _) item =
    conversionAnswer (forward item) c (pathAt parent input output) item


compiledBackward : Context, Path, Js.Value, Js.Value, Conversion b a, a → Js.Opt b
compiledBackward c parent input output (Conversion _ backward) item =
    conversionAnswer (backward item) c (pathAt parent input output) item


conversionAnswer : Result (List Issue) a, Context, Path, b → Js.Opt a
conversionAnswer answer c path input =
    case answer of
        Ok item →
            Js.some item
        Err given →
            prefix = pathArray path False
            each
                (if List.isEmpty given then
                    [ issue "the conversion failed without an issue" ]
                 else
                    given
                )
                λentry →
                    amended : Issue
                    amended =
                        { path = List.copy prefix ++ entry.path
                        , direction = c.dir
                        , endpoint = (outputEndpoint c.dir)
                        , code = entry.code
                        , message = entry.message
                        , input =
                            if c.report then Maybe.map (Data.checked input) fromHost else Nothing
                        }
                    _ = Js.call c.issues "push" [ toHost amended ]
                    ⊤
            Js.none ⊤


validContext : ⊤ → Context
validContext ⊤ = context (defaultOptions ⊤) Decoding True False False


validJson : Context, String → Js.Value
validJson c text = Maybe.withDefault (parseJson text) c.fail


readValid : Schema e a, Value → Result (List Issue) a
readValid schema input = read schema input


badString : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badString c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a string"
            x
            False


badBool : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badBool c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a boolean"
            x
            False


badFloat : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badFloat c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


-- An `Int` and a `FiniteFloat` fail one of two tests: not a number at all,
-- or a number out of range.
badInt : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badInt c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else if isType x "number" then
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            4
            "expected a safe integer"
            x
            False
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


badFinite : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badFinite c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else if isType x "number" then
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            4
            "expected a finite number"
            x
            False
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


-- `IssueCode`'s constructors, a host array in declaration order.
issueCodes : Js.Value
issueCodes =
    toHost
        [ WrongShape
        , MissingKey
        , UnknownKey
        , UnknownTag
        , InvalidValue
        , DepthExceeded
        , InvalidOptions
        , ConversionFailed
        , CheckFailed
        , ParseFailed
        , PrintFailed
        , InvalidSchema
        ]


isBackward : Traversal → Bool
isBackward scope =
    case scope of
        AfterBackward →
            True
        ClaimedAfterBackward _ _ →
            True
        _ →
            False


belowBackward : Context → Context
belowBackward c =
    case c.scope of
        AfterBackward →
            c
        ClaimedAfterBackward _ _ →
            c
        Claimed depth external →
            { Record.copy c | scope = ClaimedAfterBackward depth external }
        Unclaimed →
            { Record.copy c | scope = AfterBackward }


-- Whether a `Value` prints as JSON within the depth left: `printable`'s
-- answer, for an encoding worker's `Value`.
printableWithin : Context, Int, Js.Value → Int
printableWithin c depth v = printable v (c.max - depth)


engineOf : Schema e a → Engine e a
engineOf (Schema state) = state.engine


-- ShapeGraph only constructs plans for plain-data endpoints. Jobs and their
-- configuration stay typed; Js.Value carries only their data input/output.
type ShapePlan
    = ShapePlan ((Js.Value, Int → Js.Value))


type alias ShapeField =
    external : String
    name : String
    flag : Int
    plan : ShapePlan


type alias ShapeVariant =
    tag : String
    plan : Maybe ShapePlan
    make : (Js.Value → Js.Value)


type alias ShapeCtor =
    name : String
    plans : List ShapePlan
    make : (List Js.Value → Js.Value)


shapeFail : Js.Value
shapeFail = Js.array []


shapeMax : Int
shapeMax = defaultMaxDepth


shapeRun : ShapePlan, Js.Value, Int → Js.Value
shapeRun (ShapePlan job) input depth = job input depth


validShape : ShapePlan, Value → Result (List Issue) a
validShape plan input =
    result = shapeRun plan (toHost input) 0
    if Js.same result shapeFail then Err [] else Ok (fromHost result)


shapeParse : ShapePlan, String → Result (List Issue) a
shapeParse plan text =
    case parseJson text of
        Nothing →
            Err []
        Just input →
            validShape plan (fromHost input)


shapeString : ShapePlan
shapeString = ShapePlan λinput _ → if isType input "string" then input else shapeFail


shapeBool : ShapePlan
shapeBool = ShapePlan λinput _ → if isType input "boolean" then input else shapeFail


shapeInt : ShapePlan
shapeInt = ShapePlan λinput _ → if HostData.isSafeInteger input then input else shapeFail


shapeFloat : ShapePlan
shapeFloat = ShapePlan λinput _ → if isType input "number" then input else shapeFail


shapeFinite : ShapePlan
shapeFinite = ShapePlan λinput _ → if isFinite input then input else shapeFail


shapeNull : ShapePlan
shapeNull = ShapePlan λinput _ → if Js.isNull input then toHost Null else shapeFail


shapeValue : ShapePlan
shapeValue = ShapePlan λinput _ → input


shapeChar : ShapePlan
shapeChar = ShapePlan λinput _ →
    if isType input "string" && oneScalar input then input else shapeFail


shapeInt32 : ShapePlan
shapeInt32 = ShapePlan λinput _ →
    if isType input "number" && Js.bitOr (intOf input) 0 == intOf input then input else shapeFail


shapeNever : ShapePlan
shapeNever = ShapePlan λ_ _ → shapeFail


shapeKey : Bool, Js.Value, String → Js.Value
shapeKey own input external =
    if own && prototypeKey external then
        if hasOwn input external then Js.get input external else Js.undefined
    else
        Js.get input external


shapeRecord : List Int, List ShapeField → ShapePlan
shapeRecord order entries = shapeRecordPlan False order entries


shapeRecordOwn : List Int, List ShapeField → ShapePlan
shapeRecordOwn order entries = shapeRecordPlan True order entries


shapeRecordPlan : Bool, List Int, List ShapeField → ShapePlan
shapeRecordPlan own order entries = ShapePlan λinput depth →
    if isObject input then
        values = Js.array []
        if shapeFieldsFrom own entries order 0 input depth values then
            shapeFail
        else
            shapeCopy entries values 0 (Js.object [])
    else
        shapeFail


shapeFieldsFrom : Bool, List ShapeField, List Int, Int, Js.Value, Int, Js.Value → Bool
shapeFieldsFrom own entries order index input depth values =
    if index ≥ List.length entries then
        False
    else
        position = if List.isEmpty order then index else at order index
        entry = at entries position
        raw = shapeKey own input entry.external
        result = shapeEntry entry (not (Js.isUndefined raw)) raw depth
        if Js.same result shapeFail then
            True
        else
            Js.setAt values position result
            shapeFieldsFrom own entries order (index + 1) input depth values


shapeCopy : List ShapeField, Js.Value, Int, Js.Value → Js.Value
shapeCopy entries values index output =
    if index ≥ List.length entries then
        output
    else
        entry = at entries index
        Js.set output entry.name (Js.at values index)
        shapeCopy entries values (index + 1) output


shapeEntry : ShapeField, Bool, Js.Value, Int → Js.Value
shapeEntry entry held input depth =
    if not held then
        if entry.flag == 0 then
            shapeFail
        else if entry.flag == 2 then
            toHost Nothing
        else
            toHost Missing
    else if depth ≥ shapeMax then
        shapeFail
    else
        result = shapeRun entry.plan input (depth + 1)
        if entry.flag ≠ 1 || Js.same result shapeFail then result else toHost (Present result)


shapeList : ShapePlan → ShapePlan
shapeList child = ShapePlan λinput depth →
    if isArray input then
        shapeListFrom child input 0 (lengthOf input) depth (Js.array [])
    else
        shapeFail


shapeListFrom : ShapePlan, Js.Value, Int, Int, Int, Js.Value → Js.Value
shapeListFrom plan input index size depth output =
    if index ≥ size then
        output
    else if depth ≥ shapeMax then
        shapeFail
    else
        result = shapeRun plan (Js.at input index) (depth + 1)
        if Js.same result shapeFail then
            shapeFail
        else
            _ = Js.call output "push" [ result ]
            shapeListFrom plan input (index + 1) size depth output


shapeNullable : ShapePlan → ShapePlan
shapeNullable child = ShapePlan λinput depth →
    if Js.isNull input then
        toHost Null
    else
        result = shapeRun child input depth
        if Js.same result shapeFail then shapeFail else toHost (NonNull result)


shapeMaybe : ShapePlan → ShapePlan
shapeMaybe child = ShapePlan λinput depth →
    if Js.isNull input then toHost Nothing else shapeRun (shapeJust child) input depth


shapeJust : ShapePlan → ShapePlan
shapeJust child = ShapePlan λinput depth →
    result = shapeRun child input depth
    if Js.same result shapeFail then shapeFail else toHost (Just result)


shapeLater : sync (⊤ → ShapePlan) → ShapePlan
shapeLater later = ShapePlan λinput depth → shapeRun (later ⊤) input depth


shapeTuple : List ShapePlan → ShapePlan
shapeTuple plans = ShapePlan λinput depth →
    if not (isArray input) || lengthOf input ≠ List.length plans then
        shapeFail
    else if List.isEmpty plans then
        Js.null
    else
        shapeTupleFrom plans input 0 depth (Js.object [])


shapeTupleFrom : List ShapePlan, Js.Value, Int, Int, Js.Value → Js.Value
shapeTupleFrom plans input index depth output =
    if index ≥ List.length plans then
        output
    else if depth ≥ shapeMax then
        shapeFail
    else
        result = shapeRun (at plans index) (Js.at input index) (depth + 1)
        if Js.same result shapeFail then
            shapeFail
        else
            Js.set output (slotOf index) result
            shapeTupleFrom plans input (index + 1) depth output


shapeTagged : String, List ShapeVariant → ShapePlan
shapeTagged external variants = shapeTaggedPlan False external variants


shapeTaggedOwn : String, List ShapeVariant → ShapePlan
shapeTaggedOwn external variants = shapeTaggedPlan True external variants


shapeTaggedPlan : Bool, String, List ShapeVariant → ShapePlan
shapeTaggedPlan own external variants = ShapePlan λinput depth →
    if not (isObject input) then
        shapeFail
    else
        tag = shapeKey own input external
        case find variants λentry → Js.same (Js.from entry.tag) tag of
            Nothing →
                shapeFail
            Just selected →
                case selected.plan of
                    Nothing →
                        selected.make Js.null
                    Just plan →
                        if depth ≥ shapeMax then
                            shapeFail
                        else
                            payload = shapeRun plan input (depth + 1)
                            if Js.same payload shapeFail then shapeFail else selected.make payload


shapeCtors : List ShapeCtor → ShapePlan
shapeCtors ctors = ShapePlan λinput depth →
    if isType input "string" then
        case find ctors λentry → Js.same (Js.from entry.name) input && List.isEmpty entry.plans of
            Nothing →
                shapeFail
            Just selected →
                selected.make []
    else if isObject input then
        keys = HostData.keys input
        if List.length keys ≠ 1 || depth ≥ shapeMax then
            shapeFail
        else
            name = at keys 0
            case find ctors λentry → entry.name == name && not (List.isEmpty entry.plans) of
                Nothing →
                    shapeFail
                Just selected →
                    shapeArgs selected (Js.get input name) depth
    else
        shapeFail


shapeArgs : ShapeCtor, Js.Value, Int → Js.Value
shapeArgs selected payload depth =
    size = List.length selected.plans
    if size == 1 then
        result = shapeRun (at selected.plans 0) payload (depth + 1)
        if Js.same result shapeFail then shapeFail else selected.make [ result ]
    else if not (isArray payload) || lengthOf payload ≠ size then
        shapeFail
    else
        case shapeArgsFrom selected.plans payload 0 (depth + 1) of
            Nothing →
                shapeFail
            Just items →
                selected.make items


shapeArgsFrom : List ShapePlan, Js.Value, Int, Int → Maybe (List Js.Value)
shapeArgsFrom plans payload index depth =
    case plans of
        [] →
            Just []
        [ plan, …rest ] →
            if depth ≥ shapeMax then
                Nothing
            else
                result = shapeRun plan (Js.at payload index) (depth + 1)
                if Js.same result shapeFail then
                    Nothing
                else
                    Maybe.map (shapeArgsFrom rest payload (index + 1) depth) λitems →
                        [ result, …items ]


primitive : PrimitiveKind → Schema a a
primitive kind = primitiveWith kind []


primitiveWith : PrimitiveKind, List a → Schema a a
primitiveWith kind witness = scalarSchema kind toHost fromHost witness


listWorkers : Workers e a → Workers (List e) (List a)
listWorkers workers =
    { parse = Maybe.map workers.parse listReadWorker
    , print = Maybe.map workers.print listWriteWorker
    , args = workers.args
    , decode = Maybe.map workers.decode listTypedWorker
    , encode = Maybe.map workers.encode listTypedWorker
    , read = Maybe.map workers.read listReadWorker
    , write = Maybe.map workers.write listWriteWorker
    , valid = Maybe.map workers.valid listReadWorker
    }


walkWorker : Context, Worker i o, Int, Path, List i, Int, List o, Bool → Js.Opt (List o)
walkWorker c child depth path items offset output failed =
    case items of
        [] →
            if failed then Js.none ⊤ else Js.some output
        [ item, …rest ] →
            answer =
                if depth ≥ c.max then
                    _ = compiledDeep c path (Js.from offset) (Js.from offset) item
                    Js.none ⊤
                else
                    child c (depth + 1) path (Js.from offset) (Js.from offset) item
            if workerEmpty answer then
                if c.all then
                    walkWorker c child depth path rest (offset + 1) output True
                else
                    Js.none ⊤
            else
                walkWorker
                    c
                    child
                    depth
                    path
                    rest
                    (offset + 1)
                    (List.push output (workerValue answer))
                    failed


listTypedWorker : Worker i o → Worker (List i) (List o)
listTypedWorker child =
    λc depth parent input output items →
        walkWorker c child depth (pathAt parent input output) items 0 [] False


listReadWorker : Worker Js.Value a → Worker Js.Value (List a)
listReadWorker child =
    λc depth parent input output items →
        if isArray items then
            walkWorker
                c
                child
                depth
                (pathAt parent input output)
                (fromHost items)
                0
                []
                False
        else
            _ = compiledFail c parent input output 0 "expected an array" items False
            Js.none ⊤


listWriteWorker : Worker a Js.Value → Worker (List a) Js.Value
listWriteWorker child =
    λc depth parent input output items →
        workerMap
            (walkWorker c child depth (pathAt parent input output) items 0 [] False)
            toHost


nullableWorkers : Workers e a → Workers (Nullable e) (Nullable a)
nullableWorkers workers =
    { parse = Maybe.map workers.parse nullableReadWorker
    , print = Maybe.map workers.print nullableWriteWorker
    , args = workers.args
    , decode = Maybe.map workers.decode nullableTypedWorker
    , encode = Maybe.map workers.encode nullableTypedWorker
    , read = Maybe.map workers.read nullableReadWorker
    , write = Maybe.map workers.write nullableWriteWorker
    , valid = Maybe.map workers.valid nullableReadWorker
    }


nullableReadWorker : Worker Js.Value a → Worker Js.Value (Nullable a)
nullableReadWorker child =
    λc depth parent input output item →
        if Js.isNull item then
            Js.some Null
        else
            workerMap (child c depth parent input output item) NonNull


nullableWriteWorker : Worker a Js.Value → Worker (Nullable a) Js.Value
nullableWriteWorker child =
    λc depth parent input output item →
        case item of
            Null →
                Js.some Js.null
            NonNull datum →
                child c depth parent input output datum


nullableTypedWorker : Worker i o → Worker (Nullable i) (Nullable o)
nullableTypedWorker child =
    λc depth parent input output item →
        case item of
            Null →
                Js.some Null
            NonNull datum →
                workerMap (child c depth parent input output datum) NonNull


convertedWorkers : Workers e b, Conversion b a → Workers e a
convertedWorkers workers conv =
    { parse = Maybe.map workers.parse (forwardWorker conv _)
    , print = Maybe.map workers.print (backwardWorker conv _)
    , args = workers.args
    , decode = Maybe.map workers.decode (forwardWorker conv _)
    , encode = Maybe.map workers.encode (backwardWorker conv _)
    , read = Maybe.map workers.read (forwardWorker conv _)
    , write = Maybe.map workers.write (backwardWorker conv _)
    , valid = Maybe.map workers.valid (forwardWorker conv _)
    }


forwardWorker : Conversion b a, Worker i b → Worker i a
forwardWorker conv child =
    λc depth parent input output item →
        workerAndThen
            (child c depth parent input output item)
            (compiledForward c parent input output conv _)


backwardWorker conv child =
    λc depth parent input output item →
        workerAndThen
            (compiledBackward c parent input output conv item)
            (child (belowBackward c) depth parent input output _)


compiledBox : Node, Workers e a → Schema e a
compiledBox node workers = compiledBoxWith node workers [] []


compiledBoxWith : Node, Workers e a, List e, List a → Schema e a
compiledBoxWith node workers encoded typed =
    declared
        Data.checked
        Data.checked
        (endpointIdentity encoded)
        (endpointIdentity typed)
        (λ⊤ → node)
        workers.parse
        workers.print
        workers.args
        workers.decode
        workers.encode
        workers.read
        workers.write
        workers.valid


-- Construction facts are immutable once their compiled workers exist. Resolve
-- recursive bodies lazily, then reuse this preflight without reading descriptions.
-- Allocating this private cache is unobservable, like nodeRef's private reference.
compiledArguments : List Argument → List Argument
compiledArguments args =
    if List.isEmpty args then
        []
    else
        memoArguments args (Js.pure λ⊤ → Js.ref Nothing)


memoArguments : List Argument, Js.Ref (Maybe (Maybe String)) → List Argument
memoArguments args stored =
    [ { analyse =
          λ⊤ →
              case Js.read stored of
                  Just ready →
                      ready
                  Nothing →
                      ready = argumentsAnalysis args
                      Js.write stored (Just ready)
                      ready
      }
    ]


argumentsAnalysis : List Argument → Maybe String
argumentsAnalysis args =
    case args of
        [] →
            Nothing
        [ supplied, …rest ] →
            case supplied.analyse ⊤ of
                Just problem →
                    Just problem
                Nothing →
                    argumentsAnalysis rest


erasedWorkers : Workers e a → Workers Value a
erasedWorkers workers =
    { parse = workers.parse
    , print = workers.print
    , args = workers.args
    , decode = Maybe.map workers.read hostReadWorker
    , encode = Maybe.map workers.write hostWriteWorker
    , read = workers.read
    , write = workers.write
    , valid = workers.valid
    }


hostReadWorker : Worker Js.Value a → Worker Value a
hostReadWorker child =
    λc depth parent input output item → child (hostEnds c) depth parent input output (toHost item)


hostWriteWorker : Worker a Js.Value → Worker a Value
hostWriteWorker child =
    λc depth parent input output item →
        workerMap (child (hostEnds c) depth parent input output item) typedHostValue


nodeBody : Node → NodeBody
nodeBody (Node storage) = Js.read storage


nodeRef : NodeBody → Node
nodeRef body = Node (Js.pure λ⊤ → Js.ref body)


nPrim : PrimitiveKind → Node
nPrim kind = nodeRef (NPrim kind)


nList : Node → Node
nList child = nodeRef (NList child)


nNullable : Node → Node
nNullable child = nodeRef (NNullable child)


nRecord : List FieldNode → Node
nRecord entries = nodeRef (NRecord entries)


nTagged : String, List VariantNode → Node
nTagged discriminator variants = nodeRef (NTagged discriminator variants)


nConverted : Node → Node
nConverted child = nodeRef (NConverted child)


nRef : Cell → Node
nRef cell = nodeRef (NRef cell)


nBroken : String → Node
nBroken problem = nodeRef (NBroken problem)


nTuple : List Node → Node
nTuple nodes = nodeRef (NTuple nodes)


nCtors : List CtorNode → Node
nCtors ctors = nodeRef (NCtors ctors)


nMaybe : Node, Int → Node
nMaybe child mode = nodeRef (NMaybe child mode)


nHost : Node → Node
nHost child = nodeRef (NHost child)


-- Both independent traversal facts fit in one typed context slot.
type Traversal
    = Unclaimed
    | AfterBackward
    | Claimed Int String
    | ClaimedAfterBackward Int String


compiledClaim : Context, Int, String → Bool
compiledClaim c depth external =
    case c.scope of
        Claimed level name →
            level == depth && name == external
        ClaimedAfterBackward level name →
            level == depth && name == external
        _ →
            False


claimContext : Context, Int, String → Context
claimContext c depth external =
    { Record.copy c
        | scope =
            if isBackward c.scope then
                ClaimedAfterBackward depth external
            else
                Claimed depth external
    }


type alias VariantBundle e a =
    node : VariantNode
    workers : Workers e a
    args : List Argument


construction : Maybe String → Argument
construction problem = { analyse = λ⊤ → problem }


recursiveWith :
      String
    , (Schema e a → Schema e a)
    , Js.Ref (Maybe (Schema e a))
    , Js.Ref Int
    , Js.Ref (Maybe ActiveRun)
    → Schema e a
recursiveWith name build stored state active =
    cell = cellOf name λself →
        case recursiveBody name build stored state active self of
            Just body →
                nodeOf body
            Nothing →
                nBroken "the recursive schema ${name} is used before its body is built"
    node = nRef cell
    later = λ⊤ → recursiveBody name build stored state active node
    args =
        [ { analyse =
              λ⊤ →
                  case later ⊤ of
                      Just body →
                          case engineOf body of
                              Compiled workers →
                                  argumentsAnalysis workers.args
                      Nothing →
                          Just "the recursive schema ${name} is used before its body is built"
          }
        ]
    compiledBox node (recursiveWorkers name later active args)


recursiveBody :
      String
    , (Schema e a → Schema e a)
    , Js.Ref (Maybe (Schema e a))
    , Js.Ref Int
    , Js.Ref (Maybe ActiveRun)
    , Node
    → Maybe (Schema e a)
recursiveBody name build stored state active node =
    case Js.read state of
        2 →
            Js.read stored
        1 →
            Nothing
        _ →
            Js.write state 1
            self =
                compiledBox
                    node
                    (recursiveWorkers
                        name
                        (λ⊤ → recursiveBody name build stored state active node)
                        active
                        []
                    )
            body = build self
            Js.write stored (Just body)
            Js.write state 2
            Just body


hostEnds : Context → Context
hostEnds c = { Record.copy c | sh = c.sh || c.dir == Decoding, dh = c.dh || c.dir == Encoding }


typedHostValue : Js.Value → Value
typedHostValue raw = fromHost raw


-- Typed products are retained across every field and child worker.
type alias Product pe pa =
    parse : Worker Js.Value pa
    print : FieldWriter pa
    decode : Worker pe pa
    encode : Worker pa pe
    read : Worker Js.Value pa
    write : FieldWriter pa


type alias FieldWriter a =
    Context, Int, Path, a, Js.Value → Bool


emptyProduct : Product ⊤ ⊤
emptyProduct =
    { parse = λ_ _ _ _ _ _ → Js.some ⊤
    , print = λ_ _ _ _ _ → True
    , decode = λ_ _ _ _ _ _ → Js.some ⊤
    , encode = λ_ _ _ _ _ _ → Js.some ⊤
    , read = λ_ _ _ _ _ _ → Js.some ⊤
    , write = λ_ _ _ _ _ → True
    }


pairWorkers : Worker i a, Worker i b → Worker i (a × b)
pairWorkers left right =
    λc depth parent input output item →
        first = left c depth parent input output item
        if workerEmpty first && not c.all then
            Js.none ⊤
        else
            second = right c depth parent input output item
            if workerEmpty first || workerEmpty second then
                Js.none ⊤
            else
                Js.some ( workerValue first, workerValue second )


productWorker : Worker a b, Worker c d → Worker (a × c) (b × d)
productWorker left right =
    λctx depth parent input output ( a, c ) →
        first = left ctx depth parent input output a
        if workerEmpty first && not ctx.all then
            Js.none ⊤
        else
            second = right ctx depth parent input output c
            if workerEmpty first || workerEmpty second then
                Js.none ⊤
            else
                Js.some ( workerValue first, workerValue second )


productWriter : FieldWriter a, FieldWriter b → FieldWriter (a × b)
productWriter left right =
    λc depth path ( a, b ) target →
        first = left c depth path a target
        if not first && not c.all then
            False
        else
            second = right c depth path b target
            first && second


appendProduct : Product pe pa, Product e a → Product (pe × e) (pa × a)
appendProduct previous child =
    { parse = pairWorkers previous.parse child.parse
    , print = productWriter previous.print child.print
    , decode = productWorker previous.decode child.decode
    , encode = productWorker previous.encode child.encode
    , read = pairWorkers previous.read child.read
    , write = productWriter previous.write child.write
    }


memberCall : String, String, Maybe (Worker i o), Context, Int, Path, i → Js.Opt o
memberCall name external child c depth path item =
    input = toHost (if c.dir == Decoding then external else name)
    output = toHost (if c.dir == Encoding then external else name)
    if depth ≥ c.max then
        _ = compiledDeep c path input output item
        Js.none ⊤
    else
        (selectedWorker child) c (depth + 1) path input output item


memberTyped : String, String, Maybe (Worker i o) → Worker i o
memberTyped name external child =
    λc depth parent input output item →
        memberCall name external child c depth (pathAt parent input output) item


memberWrite : String, String, Maybe (Worker a Js.Value) → FieldWriter a
memberWrite name external child =
    λc depth path item target →
        answer = memberCall name external child c depth path item
        if workerEmpty answer then
            False
        else
            Js.set target external (workerValue answer)
            True


requiredProduct : String, String, Workers e a → Product e a
requiredProduct name external workers =
    { parse = memberRead name external workers.parse
    , print = memberWrite name external workers.print
    , decode = memberTyped name external workers.decode
    , encode = memberTyped name external workers.encode
    , read = memberRead name external workers.read
    , write = memberWrite name external workers.write
    }


optionalTyped : Worker i o → Worker (Presence i) (Presence o)
optionalTyped child =
    λc depth parent input output item →
        case item of
            Missing →
                Js.some Missing
            Present inner →
                workerMap (child c depth parent input output inner) Present


optionalWrite : FieldWriter a → FieldWriter (Presence a)
optionalWrite child =
    λc depth path item target →
        case item of
            Missing →
                True
            Present inner →
                child c depth path inner target


optionalProduct : String, String, Workers e a → Product (Presence e) (Presence a)
optionalProduct name external workers =
    child = requiredProduct name external workers
    { parse = optionalRead name external workers.parse
    , print = optionalWrite child.print
    , decode = optionalTyped child.decode
    , encode = optionalTyped child.encode
    , read = optionalRead name external workers.read
    , write = optionalWrite child.write
    }


recordRead : List String, Worker Js.Value p, (p → a) → Worker Js.Value a
recordRead keys child make =
    λc depth parent input output raw →
        path = pathAt parent input output
        if not (isObject raw) then
            _ = compiledFail c parent input output 0 "expected an object" raw False
            Js.none ⊤
        else
            before = issueCount c
            rejected = c.reject && extraKeys c keys depth path raw
            if rejected && not c.all then
                Js.none ⊤
            else
                answer = child c depth parent input output raw
                if workerEmpty answer || issueCount c > before then
                    Js.none ⊤
                else
                    Js.some (make (workerValue answer))


extraKeys : Context, List String, Int, Path, Js.Value → Bool
extraKeys c keys depth path raw = extraKeysFrom c keys depth path raw (HostData.keys raw) False


extraKeysFrom : Context, List String, Int, Path, Js.Value, List String, Bool → Bool
extraKeysFrom c keys depth path raw names failed =
    case names of
        [] →
            failed
        [ external, …rest ] →
            if List.member keys external || compiledClaim c depth external then
                extraKeysFrom c keys depth path raw rest failed
            else
                quote = String.fromChar (Char.fromCode 34)
                _ =
                    compiledFail c path (toHost external) (toHost external)
                        2
                        ("unexpected key " ++ quote ++ external ++ quote)
                        (Js.get raw external)
                        False
                if c.all then extraKeysFrom c keys depth path raw rest True else True


recordWrite : FieldWriter p, (a → p) → Worker a Js.Value
recordWrite child project =
    λc depth parent input output item →
        target = HostData.emptyObject ⊤
        if child c depth (pathAt parent input output) (project item) target then
            Js.some target
        else
            Js.none ⊤


mappedWorker : Worker p q, (i → p), (q → o) → Worker i o
mappedWorker child project make =
    λc depth parent input output item →
        workerMap (child c depth parent input output (project item)) make


recordWorkers : List String, Product pe pa, Mapping pe e, Mapping pa a, List Argument → Workers e a
recordWorkers keys products (Mapping makeE projectE) (Mapping makeA projectA) args =
    { parse = Just (recordRead keys products.parse makeA)
    , print = Just (recordWrite products.print projectA)
    , decode = Just (mappedWorker products.decode projectE makeA)
    , encode = Just (mappedWorker products.encode projectA makeE)
    , read = Just (recordRead keys products.read makeA)
    , write = Just (recordWrite products.write projectA)
    , valid = Just (recordRead keys products.read makeA)
    , args = args
    }


variantTyped : Maybe (Worker p q), Injection p i, Injection q o → Worker i o
variantTyped child (Injection _ project) (Injection inject _) =
    λc depth parent input output item →
        case project item of
            Nothing →
                Js.none ⊤
            Just payload →
                if depth ≥ c.max then
                    _ = compiledDeep c parent input output payload
                    Js.none ⊤
                else
                    workerMap
                        ((selectedWorker child) c (depth + 1) parent input output payload)
                        inject


variantRead : Maybe (Worker Js.Value a), Injection a o → Worker Js.Value o
variantRead child (Injection inject _) =
    λc depth parent input output raw →
        if depth ≥ c.max then
            _ = compiledDeep c parent input output raw
            Js.none ⊤
        else
            workerMap
                ((selectedWorker child) c (depth + 1) parent input output raw)
                inject


variantWrite : Maybe (Worker a Js.Value), Injection a i → Worker i Js.Value
variantWrite child (Injection _ project) =
    λc depth parent input output item →
        case project item of
            Nothing →
                Js.none ⊤
            Just payload →
                if depth ≥ c.max then
                    _ = compiledDeep c parent input output payload
                    Js.none ⊤
                else
                    (selectedWorker child) c (depth + 1) parent input output payload


variantWorkers : Workers pe pa, Injection pe e, Injection pa a → Workers e a
variantWorkers workers injectE injectA =
    { parse = Just (variantRead workers.parse injectA)
    , print = Just (variantWrite workers.print injectA)
    , decode = Just (variantTyped workers.decode injectE injectA)
    , encode = Just (variantTyped workers.encode injectA injectE)
    , read = Just (variantRead workers.read injectA)
    , write = Just (variantWrite workers.write injectA)
    , valid = Just (variantRead workers.read injectA)
    , args = workers.args
    }


nullaryTyped : Injection ⊤ i, Injection ⊤ o → Worker i o
nullaryTyped (Injection _ project) (Injection inject _) =
    λ_ _ _ _ _ item →
        case project item of
            Nothing →
                Js.none ⊤
            Just _ →
                Js.some (inject ⊤)


nullaryWrite : Injection ⊤ i → Worker i Js.Value
nullaryWrite (Injection _ project) =
    λ_ _ _ _ _ item →
        case project item of
            Nothing →
                Js.none ⊤
            Just _ →
                Js.some (HostData.emptyObject ⊤)


nullaryWorkers : Injection ⊤ e, Injection ⊤ a → Workers e a
nullaryWorkers ((Injection _ _) as injectE) ((Injection inject _) as injectA) =
    { parse = Just λ_ _ _ _ _ _ → Js.some (inject ⊤)
    , print = Just (nullaryWrite injectA)
    , decode = Just (nullaryTyped injectE injectA)
    , encode = Just (nullaryTyped injectA injectE)
    , read = Just λ_ _ _ _ _ _ → Js.some (inject ⊤)
    , write = Just (nullaryWrite injectA)
    , valid = Just λ_ _ _ _ _ _ → Js.some (inject ⊤)
    , args = []
    }


taggedRead :
      String
    , List (VariantBundle e a)
    , (Workers e a → Maybe (Worker Js.Value a))
    → Worker Js.Value a
taggedRead discriminator variants pick =
    λc depth parent input output raw →
        path = pathAt parent input output
        if not (isObject raw) then
            _ = compiledFail c parent input output 0 "expected an object" raw False
            Js.none ⊤
        else
            own = prototypeKey discriminator
            heldOwn = own && hasOwn raw discriminator
            literal = if own && not heldOwn then Js.undefined else Js.get raw discriminator
            held = if own then heldOwn else not (Js.isUndefined literal)
            if not held then
                _ = compiledMissing c path (toHost discriminator) (toHost discriminator) raw
                Js.none ⊤
            else
                found =
                    if isType literal "string" then
                        find variants λentry → entry.node.tag == stringOf literal
                    else
                        Nothing
                case found of
                    Nothing →
                        quote = String.fromChar (Char.fromCode 34)
                        tags =
                            String.join
                                (List.map variants λentry → quote ++ entry.node.tag ++ quote)
                                ", "
                        _ =
                            compiledFail
                                c
                                path
                                (toHost discriminator)
                                (toHost discriminator)
                                3
                                ("unknown tag; expected " ++ tags)
                                literal
                                False
                        Js.none ⊤
                    Just selected →
                        if
                            isNothing selected.node.payload
                                && c.reject
                                && extraKeys c [ discriminator ] depth path raw
                        then
                            Js.none ⊤
                        else
                            (selectedWorker (pick selected.workers))
                                (claimContext c (depth + 1) discriminator)
                                depth
                                parent
                                input
                                output
                                raw


taggedTyped : List (VariantBundle e a), (Workers e a → Maybe (Worker i o)), String → Worker i o
taggedTyped variants pick message =
    λc depth parent input output item →
        typedVariants variants pick message c depth parent input output item


typedVariants :
      List (VariantBundle e a)
    , (Workers e a → Maybe (Worker i o))
    , String
    , Context
    , Int
    , Path
    , Js.Value
    , Js.Value
    , i
    → Js.Opt o
typedVariants variants pick message c depth parent input output item =
    case variants of
        [] →
            _ = compiledFail c parent input output 11 message item False
            Js.none ⊤
        [ entry, …rest ] →
            before = issueCount c
            answer = (selectedWorker (pick entry.workers)) c depth parent input output item
            if not (workerEmpty answer) || issueCount c > before then
                answer
            else
                typedVariants rest pick message c depth parent input output item


taggedWrite :
      String
    , List (VariantBundle e a)
    , (Workers e a → Maybe (Worker a Js.Value))
    → Worker a Js.Value
taggedWrite discriminator variants pick =
    λc depth parent input output item →
        writeVariants discriminator variants pick c depth parent input output item


writeVariants :
      String
    , List (VariantBundle e a)
    , (Workers e a → Maybe (Worker a Js.Value))
    , Context
    , Int
    , Path
    , Js.Value
    , Js.Value
    , a
    → Js.Opt Js.Value
writeVariants discriminator variants pick c depth parent input output item =
    case variants of
        [] →
            _ =
                compiledFail
                    c
                    parent
                    input
                    output
                    11
                    "no variant of this tagged schema takes the value"
                    item
                    False
            Js.none ⊤
        [ entry, …rest ] →
            before = issueCount c
            answer = (selectedWorker (pick entry.workers)) c depth parent input output item
            if workerEmpty answer then
                if issueCount c > before then
                    Js.none ⊤
                else
                    writeVariants discriminator rest pick c depth parent input output item
            else
                -- This is a fresh external record owned by this composition boundary.
                target = HostData.emptyObject ⊤
                Js.set target discriminator (toHost entry.node.tag)
                source = workerValue answer
                each (HostData.keys source) λexternal →
                    Js.set target external (Js.get source external)
                Js.some target


taggedWorkers : String, List (VariantBundle e a), List Argument → Workers e a
taggedWorkers discriminator variants args =
    { parse = Just (taggedRead discriminator variants .parse)
    , print = Just (taggedWrite discriminator variants .print)
    , decode =
        Just (taggedTyped variants .decode "no variant of this tagged schema takes the value")
    , encode =
        Just (taggedTyped variants .encode "no variant of this tagged schema takes the value")
    , read = Just (taggedRead discriminator variants .read)
    , write = Just (taggedWrite discriminator variants .write)
    , valid = Just (taggedRead discriminator variants .read)
    , args = args
    }


deferredWorker : String, (⊤ → Maybe (Worker i o)), Js.Ref (Maybe ActiveRun) → Worker i o
deferredWorker name later active =
    λc depth parent input output item →
        previous = Js.read active
        repeating =
            case previous of
                Nothing →
                    False
                Just entered →
                    Js.same entered.scope c.issues && entered.depth == depth
        if repeating then
            _ =
                compiledFail
                    c
                    parent
                    input
                    output
                    11
                    ("the recursive schema "
                        ++ name
                        ++ " refers to itself without reading into the value"
                    )
                    item
                    False
            Js.none ⊤
        else
            case later ⊤ of
                Nothing →
                    _ =
                        compiledFail
                            c
                            parent
                            input
                            output
                            11
                            ("the recursive schema " ++ name ++ " is used before its body is built")
                            item
                            False
                    Js.none ⊤
                Just worker →
                    Js.write active (Just { scope = c.issues, depth = depth })
                    answer = worker c depth parent input output item
                    Js.write active previous
                    answer


type alias ActiveRun =
    scope : Js.Value
    depth : Int


laterWorker : (⊤ → Maybe (Schema e a)), (Workers e a → Maybe (Worker i o)), ⊤ → Maybe (Worker i o)
laterWorker later pick ⊤ = Maybe.andThen (later ⊤) λschema →
    case engineOf schema of
        Compiled workers →
            pick workers


recursiveWorkers :
      String
    , (⊤ → Maybe (Schema e a))
    , Js.Ref (Maybe ActiveRun)
    , List Argument
    → Workers e a
recursiveWorkers name later active args =
    { parse = Just (deferredWorker name (laterWorker later .parse _) active)
    , print = Just (deferredWorker name (laterWorker later .print _) active)
    , decode = Just (deferredWorker name (laterWorker later .decode _) active)
    , encode = Just (deferredWorker name (laterWorker later .encode _) active)
    , read = Just (deferredWorker name (laterWorker later .read _) active)
    , write = Just (deferredWorker name (laterWorker later .write _) active)
    , valid = Just (deferredWorker name (laterWorker later .read _) active)
    , args = args
    }


scalarSchema : PrimitiveKind, (a → Js.Value), (Js.Value → a), List a → Schema a a
scalarSchema kind view make witness =
    typeId = endpointIdentity witness
    typed = scalarTyped kind view
    reading = scalarRead kind make
    writing = scalarWrite kind view
    declared Data.checked Data.checked typeId typeId (λ⊤ → nPrim kind)
        (Just reading)
        (Just writing)
        []
        (Just typed)
        (Just typed)
        (Just reading)
        (Just writing)
        (Just reading)


-- Primitive workers report directly into the engine context on failure.
-- No intermediate fault record is allocated for each rejected datum.
scalarReject : Context, Path, Js.Value, Js.Value, Int, String, a, Bool → Bool
scalarReject c parent input output code message item written =
    _ = compiledFail c parent input output code message item written
    False


scalarRead : PrimitiveKind, (Js.Value → a) → Worker Js.Value a
scalarRead kind make =
    λc depth parent input output raw →
        if scalarCheck kind c depth parent input output raw raw then
            Js.some (make raw)
        else
            Js.none ⊤


scalarTyped : PrimitiveKind, (a → Js.Value) → Worker a a
scalarTyped kind view =
    λc depth parent input output item →
        if scalarCheck kind c depth parent input output (view item) item then
            Js.some item
        else
            Js.none ⊤


scalarWrite : PrimitiveKind, (a → Js.Value) → Worker a Js.Value
scalarWrite kind view =
    λc depth parent input output item →
        raw = view item
        if scalarCheck kind c depth parent input output raw item then
            Js.some raw
        else
            Js.none ⊤


scalarCheck : PrimitiveKind, Context, Int, Path, Js.Value, Js.Value, Js.Value, a → Bool
scalarCheck kind c depth parent input output raw item =
    case kind of
        StringKind →
            if isType raw "string" then
                True
            else
                scalarReject c parent input output 0 "expected a string" item False
        BoolKind →
            if isType raw "boolean" then
                True
            else
                scalarReject c parent input output 0 "expected a boolean" item False
        IntKind →
            if not (isType raw "number") then
                scalarReject c parent input output 0 "expected a number" item False
            else if HostData.isSafeInteger (raw) then
                True
            else
                scalarReject c parent input output 4 "expected a safe integer" item False
        FloatKind →
            if not (isType raw "number") then
                scalarReject c parent input output 0 "expected a number" item False
            else if c.json && c.dh && not (isFinite raw) then
                scalarReject
                    c
                    parent
                    input
                    output
                    10
                    "JSON has no number for NaN or an infinity"
                    item
                    True
            else
                True
        FiniteFloatKind →
            if not (isType raw "number") then
                scalarReject c parent input output 0 "expected a number" item False
            else if isFinite raw then
                True
            else
                scalarReject c parent input output 4 "expected a finite number" item False
        NullKind →
            if c.sh && not (Js.isNull raw) then
                scalarReject c parent input output 0 "expected null" item False
            else
                True
        ValueKind →
            if c.json && c.dh then
                case printable raw (c.max - depth) of
                    1 →
                        scalarReject
                            c
                            parent
                            input
                            output
                            5
                            "the value nests deeper than the depth limit"
                            item
                            True
                    2 →
                        scalarReject c parent input output
                            10
                            "the value holds NaN or an infinity, which JSON has no number for"
                            item
                            True
                    _ →
                        True
            else
                True
        CharKind →
            if not (isType raw "string") then
                scalarReject c parent input output 0 "expected a string" item False
            else if oneScalar raw then
                True
            else
                scalarReject c parent input output 4 "expected one character" item False
        Int32Kind →
            if not (isType raw "number") then
                scalarReject c parent input output 0 "expected a number" item False
            else if Js.bitOr (intOf raw) 0 == intOf raw then
                True
            else
                scalarReject c parent input output 4 "expected a 32-bit integer" item False
        NeverKind →
            scalarReject c parent input output 0 "expected nothing: ⊥ has no value" item False


memberReader : String, String, Maybe (Worker Js.Value a), (a → o), Maybe o → Worker Js.Value o
memberReader name external child wrap missing =
    λc depth parent input output raw →
        path = pathAt parent input output
        own = prototypeKey external
        heldOwn = own && hasOwn raw external
        gotValue = if own && not heldOwn then Js.undefined else Js.get raw external
        held = if own then heldOwn else not (Js.isUndefined gotValue)
        if held then
            workerMap (memberCall name external child c depth path gotValue) wrap
        else
            case missing of
                Just absent →
                    Js.some absent
                Nothing →
                    _ = compiledMissing c path (toHost external) (toHost name) raw
                    Js.none ⊤


memberRead : String, String, Maybe (Worker Js.Value a) → Worker Js.Value a
memberRead name external child = memberReader name external child identity Nothing


optionalRead : String, String, Maybe (Worker Js.Value a) → Worker Js.Value (Presence a)
optionalRead name external child = memberReader name external child Present (Just Missing)
