--! Schemas: a value that describes one piece of data at two typed endpoints,
--! its **Encoded** form `e` and its program **Type** `a`, with a fallible
--! conversion in each direction (`docs/design/schema.md` §1, §4, §5).
--!
--! The builders below make a `Schema`, and the runners at the end run one.
--! A `schema` declaration is the same thing written as syntax (§2): its
--! `schema ⊤` is built of these builders, and its `parse` and `print` are
--! specialised code that calls the core-private values near the end (§6).
--!
--! **The engine owns the traversal.** A builder takes ordinary values and
--! functions — a field's name, a child schema, a mapping from a product to a
--! record, a conversion — and never a function that reads or writes the host
--! value itself. So the path, the depth, the options and the unknown-key
--! policy are threaded by the engine through every step, and no function a
--! builder was given can drop them (§5, *Context contract*).
--!
--!     toUser ( ( ⊤, userId ), nickname ) =
--!         { userId = userId, nickname = nickname }
--!
--!     fromUser u =
--!         ( ( ⊤, u.userId ), u.nickname )
--!
--!     user =
--!         Schema.record
--!             (Schema.fields
--!                 ▷ Schema.field "userId" Schema.int
--!                 ▷ Schema.key "user-id"
--!                 ▷ Schema.optional "nickname" Schema.string)
--!             (Schema.mapping toUser fromUser)
--!             (Schema.mapping toUser fromUser)
--!
--! **The engine is written here, in beni over `Js`** (§5, *The builder
--! API*; `plans/core-in-beni.md`). It reads and writes the host value — a
--! parsed JSON document, or the object a `write` makes — through `Js`, and
--! every beni value it shares with the program, an `Issue`, a `Result`, a
--! `Presence`, through ordinary patterns. Every function a builder keeps is
--! `sync`, because a runner calls it during the run.

import Js


-- ---- The public types ----------------------------------------------------

--| A field which may be absent from an external value.
pub type Presence a
    = Missing
    | Present a


--| A value which may be explicitly null at the external boundary.
pub type Nullable a
    = Null
    | NonNull a


--| One step from the root to a failed value.
pub type PathSegment
    = Field String
    | Index Int


--| The direction in which a schema operation was running.
pub type Direction
    = Decoding
    | Encoding


--| The typed endpoint at which a schema operation failed.
pub type Endpoint
    = Encoded
    | Type


--| A stable, structured category for a schema failure. `Issue.message`
--| carries the specific prose and `Issue.path` identifies the value.
pub type IssueCode
    = WrongShape
    | MissingKey
    | UnknownKey
    | UnknownTag
    | InvalidValue
    | DepthExceeded
    | InvalidOptions
    | ConversionFailed
    | CheckFailed
    | ParseFailed
    | PrintFailed
    | InvalidSchema


--| An opaque handle to an untyped host value. The schema engine reads it
--| directly; it is not a recursively marshalled Beni data structure.
pub foreign type Value


--| A schema failure with its complete location and operation context.
pub type alias Issue =
    path : List PathSegment
    direction : Direction
    endpoint : Endpoint
    code : IssueCode
    message : String
    input : Maybe Value


--| Whether traversal stops at the first failure or collects independent
--| sibling failures in traversal order.
pub type ErrorMode
    = FirstError
    | AllErrors


--| What to do with external keys which the schema does not claim.
pub type UnknownKeys
    = Ignore
    | Reject


--| Root options shared by compiled runners and library interpretation.
pub type alias Options =
    errors : ErrorMode
    unknownKeys : UnknownKeys
    maxDepth : Int
    reportInput : Bool


--| A schema with encoded endpoint `e` and program endpoint `a`.
--| Its representation remains owned by the engine and is not frozen here.
pub foreign type Schema e a


--| A fallible two-way conversion from schema endpoint `b` to program
--| endpoint `a`. Its representation remains owned by the engine.
pub foreign type Conversion b a


--| The fields of a record schema being built, as two products: `pe` holds
--| the fields' Encoded values and `pa` their Type values, each a tuple
--| nested to the left, `( ( ( ⊤, first ), second ), third )`.
pub foreign type Fields pe pa


--| A product turned into a record, and back.
pub foreign type Mapping p r


--| One variant of a tagged schema.
pub foreign type Variant e a


--| A variant's constructor, and the test that takes it apart: `inject`
--| builds the union from the payload, `project` answers the payload when
--| the value is this variant.
pub foreign type Injection p a


--| What `describe` answers: a schema's graph, as plain data. A recursive
--| schema appears once in `definitions` and is named by `Reference` wherever
--| it is used, its own body included.
pub type alias Description =
    root : Shape
    definitions : List Definition


--| A recursive schema's body. `id` is its identity in this description,
--| numbered in the order `describe` first meets it; `name` is the name it
--| was built with, which two different definitions may share.
pub type alias Definition =
    id : Int
    name : String
    shape : Shape


--| One node of a description.
pub type Shape
    = Primitive PrimitiveKind
    | ListOf Shape
    | NullableOf Shape
    | RecordOf (List FieldShape)
    | TaggedOf String (List VariantShape)
    | Converted Shape
    | Flipped Shape
    | TypeOnly Shape
    | EncodedOnly Shape
    | Reference Int
    | Invalid String
    | TupleOf (List Shape)
    | ConstructorsOf (List ConstructorShape)
    | MaybeOf Shape


--| The primitive schemas. `CharKind`, `Int32Kind` and `NeverKind` are a
--| derived schema's (`schema.md` §12.10): a string of one character, a
--| 32-bit integer, and nothing at all.
pub type PrimitiveKind
    = StringKind
    | BoolKind
    | IntKind
    | FloatKind
    | FiniteFloatKind
    | NullKind
    | ValueKind
    | CharKind
    | Int32Kind
    | NeverKind


--| A record field: its declared name, which the Type endpoint reads and
--| writes, and its external key, which the Encoded endpoint does.
pub type alias FieldShape =
    name : String
    key : String
    optional : Bool
    shape : Shape


--| A variant: its constructor name, its literal tag, and its payload
--| record, if it has one.
pub type alias VariantShape =
    name : String
    tag : String
    payload : Maybe Shape


--| A constructor of a derived schema's custom type (`schema.md` §12.3): its
--| name, which is its wire form, and its arguments.
pub type alias ConstructorShape =
    name : String
    arguments : List Shape


--| A schema whose Encoded endpoint is the untyped host value: what a type's
--| `codec` method answers (`schema.md` §12.2).
pub type alias Codec a =
    Schema Value a


-- ---- Options -------------------------------------------------------------

--| The largest `maxDepth` a root operation accepts. A larger one, or a
--| negative one, is `InvalidOptions`: the engine recurses on the host's
--| stack once per level, and this bound keeps a whole operation at the
--| ceiling well inside the stack a browser or Node gives a program
--| (`schema.md` §5, *Traversal and failure rules*; §16, S3's *As built*).
pub maxDepthCeiling : Int
maxDepthCeiling = 1024


-- The default options' depth bound, named once: `defaultOptions` makes a
-- new record at each call, and `shapeMax` reads the bound, not one.
defaultMaxDepth : Int
defaultMaxDepth = 512


--| Effect's defaults: stop at the first failure, ignore unknown keys, and
--| leave the failing input out of an issue. `maxDepth` is 512.
pub defaultOptions : ⊤ → Options
defaultOptions ⊤ =
    { errors = FirstError
    , unknownKeys = Ignore
    , maxDepth = defaultMaxDepth
    , reportInput = False
    }


-- ---- The engine's graph --------------------------------------------------
-- What a builder makes is a `Box` around a `Node`, and every opaque type of
-- this module is the engine's own record seen through `cast`: nothing reads
-- them but the code below. A function a builder was given is kept as the
-- host function it is and called with `Js.apply`; a value at a type
-- variable — a user's record, an `Encoded` or `Type` value — is a
-- `Js.Value` the engine only hands to those functions, never reads; and the
-- engine's own sequences — a record's fields, a union's variants, the
-- issues of a run — are host arrays, made and read through `Js`.
-- `NHost` is a schema whose Encoded end is a host value whatever the
-- operation (`erased`, a derived codec): `decode` reads it as `read` does
-- and `encode` writes it as `write` does (`schema.md` §12.10).

type Node
    = NPrim PrimitiveKind
    | NList Node
    | NNullable Node
    | NRecord Js.Value Maps
    | NTagged String Js.Value
    | NConverted Node Js.Value Js.Value
    | NFlipped Node
    | NProjected Int Node
    | NRef Cell
    | NBroken String
    | NTuple Js.Value Pair
    | NCtors Js.Value
    | NMaybe Node Int
    | NHost Node


-- A record's field: `key` is what the Encoded endpoint reads and writes,
-- `name` what the Type endpoint does. A record's are a host array of these.
-- `lenient` is a derived record's `Maybe` field (`schema.md` §12.4): its
-- key may be absent, which is `Nothing`, and its node is an `NMaybe`.
type alias FieldNode =
    name : String
    key : String
    renamed : Bool
    optional : Bool
    lenient : Bool
    node : Node


-- A derived custom type's constructor (`schema.md` §12.3): its name, which
-- is its wire form, its arguments' nodes, a host array, and how the typed
-- value is made from a host array of its arguments (`inject`) and taken
-- apart into one, or `null` when it is another constructor (`project`).
type alias CtorNode =
    name : String
    nodes : Js.Value
    inject : Js.Value
    project : Js.Value


-- A record's mappings, from each endpoint's product to its record and back.
type alias Maps =
    toE : Js.Value
    fromE : Js.Value
    toA : Js.Value
    fromA : Js.Value


-- A pair of functions: a `Mapping`'s `to` and `from`, an `Injection`'s
-- `inject` and `project`, a `Conversion`'s `forward` and `backward`.
type alias Pair =
    there : Js.Value
    back : Js.Value


-- A variant: its payload is a record node, or none. A union's are a host
-- array of these. `problem` is why it is not a variant, when it is not.
type alias VariantNode =
    name : String
    tag : String
    payload : Maybe Node
    injE : Pair
    injA : Pair
    problem : Maybe String


-- A recursive schema's definition. `state` is 0 unbuilt, 1 building and 2
-- built; the function that builds the body is given the reference to this
-- very cell, a node, so a reference is resolved by identity.
type alias Cell =
    name : String
    build : Js.Value
    state : Js.Ref Int
    body : Js.Ref (Maybe Node)


-- A schema: its node, the analysis a root operation on it made, once, and
-- how `parse` and `print` run it.
type alias Box =
    node : Node
    analysis : Js.Ref (Maybe Analysis)
    engine : Engine


-- How `parse` and `print` run a schema (`schema.md` §6, *A statically known
-- schema runs compiled*). A builder that boxes a node makes an
-- `Interpreted` schema, which the engine of this module walks. A schema the
-- program fixes at compile time — a declaration's `schema`, a primitive,
-- and `list`, `nullable` and `converted` of compiled schemas — is
-- `Compiled`: it carries its parse and print workers. Only `box` builds
-- `Interpreted`, so in a build where no builder that boxes survives, the
-- arms on it — the interpreter behind every runner — are not in it
-- (`backend.md` §9, *A `case` arm on a constructor nothing builds*,
-- amended 2026-10-15).
type Engine
    = Interpreted
    | Compiled Workers


-- A compiled schema: what it was made of (`Made`); a declaration's `parse`
-- and `print` workers, `null` where the build calls none, and `null` for
-- every other maker, whose workers `parserOf` and `printerOf` make when one
-- runs; and the `Interpreted` schemas its workers run through the library —
-- a generic declaration's arguments — a host array in the order its value
-- reaches them, or `null` when there are none.
type alias Workers =
    made : Made
    parse : Js.Value
    print : Js.Value
    args : Js.Value


-- What a compiled schema was made of: what `nodeOf` builds its node from
-- and `parserOf` and `printerOf` its workers. A declaration's is a function
-- of no argument that answers its description, and its workers of the
-- operations other than `parse` and `print`, a host array (`declared`).
-- `MadeErased` is `erased`'s: the same schema, its Encoded end a host value.
type Made
    = MadeDeclared Js.Value Js.Value
    | MadePrimitive PrimitiveKind
    | MadeList Workers
    | MadeNullable Workers
    | MadeConverted Workers Pair
    | MadeErased Workers


type alias Analysis =
    problem : Maybe String
    encodedOpaque : Bool
    typeOpaque : Bool


-- A record being built: its fields, a host array, and its first
-- construction failure.
type alias FieldsBox =
    fields : Js.Value
    problem : Maybe String


-- The value itself, as another type: an opaque type of this module and the
-- engine record it is are one object.
cast : a → b
cast x = fromHost (toHost x)


-- A value handed to the host, and one taken back, at a type variable: a
-- `Js.from` or `Js.to` at a named type would keep that type's field names
-- and string tags in a release build (`boundary.md` §4, *What JavaScript
-- may read of a beni value*), and the host only stores these, compares
-- them with `===` and hands them back. A function is one of them: the
-- builders park a mapping's, an injection's and a conversion's functions in
-- the host and the engine calls them from beni, so they cross here too — a
-- `Js.from` at `b → Result (List Issue) a` kept `Issue`'s field names and
-- the string tags of every type it names in every schema program.
toHost : a → Js.Value
toHost x = Js.from x


fromHost : Js.Value → a
fromHost v = Js.to v


-- The engine's views of a value it was handed.
nullableOf : Js.Value → Nullable Js.Value
nullableOf v = cast v


presenceOf : Js.Value → Presence Js.Value
presenceOf v = cast v


maybeOf : Js.Value → Maybe Js.Value
maybeOf v = cast v


resultOf : Js.Value → Result Js.Value Js.Value
resultOf v = cast v


issueOf : Js.Value → Issue
issueOf v = cast v


pairOf : Js.Value → Js.Value × Js.Value
pairOf v = cast v


stringOf : Js.Value → String
stringOf v = Js.to v


intOf : Js.Value → Int
intOf v = Js.to v


-- The `i`th element of a host array, as what the engine put there.
fieldAt : Js.Value, Int → FieldNode
fieldAt xs i = fromHost (Js.at xs i)


variantAt : Js.Value, Int → VariantNode
variantAt xs i = fromHost (Js.at xs i)


-- A host array of the engine's fields or variants, as the `List` it is: a
-- plain array is one (`backend.md` §4, *Lists are arrays*), so a walk that
-- runs once per schema, not once per value, is `List`'s.
fieldList : Js.Value → List FieldNode
fieldList xs = fromHost xs


variantList : Js.Value → List VariantNode
variantList xs = fromHost xs


box : Node → Schema e a
box n =
    b : Box
    b = { node = n, analysis = Js.ref Nothing, engine = Interpreted }
    cast b


-- A compiled schema (`Engine`). Its own `node` is never read: `nodeOf`
-- makes one from `made`.
compiled : Made, Js.Value, Js.Value, Js.Value → Schema e a
compiled origin parsing printing args =
    w : Workers
    w = { made = origin, parse = parsing, print = printing, args = args }
    b : Box
    b = { node = fromHost Js.null, analysis = Js.ref Nothing, engine = Compiled w }
    cast b


-- A `schema` declaration's `schema` (`schema.md` §6, *A statically known
-- schema runs compiled*): a function of no argument answering its
-- description, its `parse` and `print` workers, the schema arguments its
-- value reaches — `null` for a nongeneric one — and its other workers, a
-- host array of the `decode`, `encode`, `read` and `write` ones. A worker
-- the build runs none of is `null`, the array's trailing ones are left out,
-- and the array is `null` when it would hold none. Called by the code a
-- declaration compiles to, never by a program.
declared : Js.Value, Js.Value, Js.Value, Js.Value, Js.Value → Schema e a
declared description parsing printing args others =
    compiled (MadeDeclared description others) parsing printing (interpretedIn args)


-- The `Interpreted` schemas among `args` and behind its compiled ones, in
-- order: what a compiled root checks before it reads (`compiledProblem`).
-- `null`, which stands for no arguments, stays `null`.
interpretedIn : Js.Value → Js.Value
interpretedIn args =
    if Js.isNull args then
        args
    else
        out = Js.array []
        _ =
            Js.call args "forEach"
                [ toHost λa →
                    s : Schema Js.Value Js.Value
                    s = fromHost a
                    case (boxOf s).engine of
                        Compiled w →
                            if Js.isNull w.args then
                                ⊤
                            else
                                _ = Js.call w.args "forEach" [ toHost λx → push out x ]
                                ⊤

                        Interpreted →
                            push out a
                ]
        out


pair : Js.Value, Js.Value → Pair
pair there back = { there = there, back = back }


boxOf : Schema e a → Box
boxOf s = cast s


nodeOf : Schema e a → Node
nodeOf s =
    b = boxOf s
    case b.engine of
        Compiled w →
            madeNode w.made

        Interpreted →
            b.node


-- A compiled schema's node, for an operation that needs one: `describe`,
-- `flip`, a builder given it as a child. A declaration's is its
-- description, which is a node.
madeNode : Made → Node
madeNode origin =
    case origin of
        MadeDeclared description _ →
            fromHost (Js.apply description [])

        MadePrimitive p →
            NPrim p

        MadeList child →
            NList (madeNode child.made)

        MadeNullable child →
            NNullable (madeNode child.made)

        MadeConverted source p →
            NConverted (madeNode source.made) p.there p.back

        MadeErased source →
            NHost (madeNode source.made)


-- ---- A declaration's description ------------------------------------------
-- What the code of a declaration's `$$description` calls (`schema.md` §6,
-- *What `describe` ships*): the node each builder would box, made directly.
-- The checker has already refused every construction failure a builder
-- tests for, so none is tested here, and no node is boxed: a build that
-- describes declarations, or hands one to `flip` or a builder, does not on
-- that account build an `Interpreted` schema. None of these is `pub`.

-- A schema's node: a primitive's, or a schema argument's.
describedOf : Schema e a → Node
describedOf s = nodeOf s


describedList : Node → Node
describedList child = NList child


describedNullable : Node → Node
describedNullable child = NNullable child


describedConverted : Node, Conversion b a → Node
describedConverted source c =
    p : Pair
    p = cast c
    NConverted source p.there p.back


-- A record: its fields, a host array of `describedField`s, and the mapping
-- from a product to the record and back, which both endpoints share.
describedRecord : Js.Value, Js.Value, Js.Value → Node
describedRecord fs to from = NRecord fs { toE = to, fromE = from, toA = to, fromA = from }


describedField : String, String, Bool, Node → Js.Value
describedField name external isOptional n =
    toHost (fieldNode name external (name ≠ external) isOptional n)


-- A tagged union: its discriminator and its variants, a host array of
-- `describedVariant`s.
describedTagged : String, Js.Value → Node
describedTagged discriminator vs = NTagged discriminator vs


-- A variant: its payload's node, or `null` for a nullary one, and the
-- injection both endpoints share.
describedVariant : String, String, Js.Value, Js.Value, Js.Value → Js.Value
describedVariant name tag payload inject project =
    v : VariantNode
    v =
        { name = name
        , tag = tag
        , payload = if Js.isNull payload then Nothing else Just (fromHost payload)
        , injE = pair inject project
        , injA = pair inject project
        , problem = Nothing
        }
    toHost v


-- A declaration in a reference cycle: `build` is given the reference to it
-- and answers its body (`recursive`).
describedRecursive : String, Js.Value → Node
describedRecursive name build = NRef (cellOf name build)


-- The two sides of a schema.
encodedSide : Int
encodedSide = 0


typeSide : Int
typeSide = 1


endpointOf : Int → Endpoint
endpointOf side =
    if side == encodedSide then
        Encoded
    else
        Type


endpointName : Int → String
endpointName side =
    if side == encodedSide then
        "Encoded"
    else
        "Type"


-- ---- Host arrays ---------------------------------------------------------

lengthOf : Js.Value → Int
lengthOf xs = Js.to (Js.get xs "length")


-- `x` pushed onto the host array `xs`.
push : Js.Value, Js.Value → ⊤
push xs x =
    _ = Js.call xs "push" [ x ]
    ⊤


-- A fresh host array: `xs` and then `x`.
appended : Js.Value, Js.Value → Js.Value
appended xs x = Js.call xs "concat" [ Js.array [ x ] ]


-- A list's elements as a plain array: a host array is one, and a `List` is
-- read by the protocol every reader outside `core/List` uses.
plain : Js.Value → Js.Value
plain xs =
    if isArray xs then
        xs
    else
        Js.call xs "$plain" []


-- The first name of the host array `xs`, by `nameOf`, that occurs again
-- after it.
duplicateIn : Js.Value, (a → String) → Maybe String
duplicateIn xs nameOf =
    names = Js.call xs "map" [ toHost nameOf ]
    found =
        Js.call names "find"
            [ toHost λn i → Js.to (Js.call names "indexOf" [ n, Js.from (i + 1) ]) ≥ 0 ]
    if Js.isUndefined found then
        Nothing
    else
        Just (stringOf found)


-- ---- Primitives ----------------------------------------------------------
-- Each is compiled (`Engine`): its worker, both ways, is `prim` on the
-- context the root made, which knows the direction.

--| A string, both ways.
pub string : Schema String String
string = primitive StringKind


--| `true` or `false`.
pub bool : Schema Bool Bool
bool = primitive BoolKind


--| A safe integer, both ways: a whole number from −(2⁵³−1) to 2⁵³−1. A
--| well-typed `Int` outside that range fails to encode.
pub int : Schema Int Int
int = primitive IntKind


--| Any number. Printing NaN or an infinity as JSON fails, because JSON has
--| no number for it.
pub float : Schema Float Float
float = primitive FloatKind


--| A finite number, both ways.
pub finiteFloat : Schema Float Float
finiteFloat = primitive FiniteFloatKind


--| JSON's `null`, whose one value is `Null`.
pub null : Schema (Nullable ⊥) (Nullable ⊥)
null = primitive NullKind


--| Any host value, unread: the Encoded value is the Type value.
pub value : Schema Value Value
value = primitive ValueKind


primitive : PrimitiveKind → Schema e a
primitive p = compiled (MadePrimitive p) Js.null Js.null Js.null


-- ---- Lists and nullability -----------------------------------------------

--| A list of the child's values: an array outside, a `List` inside.
pub list : Schema e a → Schema (List e) (List a)
list child =
    case (boxOf child).engine of
        Compiled w →
            compiled (MadeList w) Js.null Js.null w.args

        Interpreted →
            box (NList (nodeOf child))


--| The child's values, or `null`, told apart.
pub nullable : Schema e a → Schema (Nullable e) (Nullable a)
nullable child =
    case (boxOf child).engine of
        Compiled w →
            compiled (MadeNullable w) Js.null Js.null w.args

        Interpreted →
            box (NNullable (nodeOf child))


-- ---- Schemas derived from a type -----------------------------------------
-- What a type's `codec` is (`schema.md` §12). The compiler derives one from
-- a type and compiles it as it compiles a declaration; the `described…`
-- values below make its description's nodes, which `describe` and the
-- library path read (§12.10). None but `Codec`, `erased`, `derived` and
-- `structural` is `pub`: the code a derived codec compiles to calls the
-- rest.

--| A schema's Encoded endpoint forgotten: the same schema, as the `Codec`
--| a type's `codec` method answers. A validated type's module writes
--| `pub codec ⊤ = Schema.erased (Schema.converted Schema.string toUserId)`.
--| Its Encoded end is a `Value`, so `decode` reads it as `read` does and
--| `encode` writes it as `write` does.
pub erased : Schema e a → Codec a
erased s =
    case (boxOf s).engine of
        Compiled w →
            compiled (MadeErased w) w.parse w.print w.args

        Interpreted →
            box (NHost (nodeOf s))


--| The schema of a type, derived from its shape (`schema.md` §12.2): its
--| module's `codec` when it declares one, else its records, tuples and
--| constructors read as JSON. `Page.schema (Schema.derived ⊤)` composes it.
pub derived : ⊤ → Codec a
    where a.codec : ⊤ → Codec a
derived u = a.codec u


--| `derived` for a type's own module, which reads its shape even where the
--| module declares `codec`: an opaque type's module writes `pub codec ⊤ =
--| Schema.structural ⊤`, which `derived` there would answer with itself
--| (`schema.md` §12.2, §12.10). Accepted only in the type's own module.
pub structural : ⊤ → Codec a
    where a.codec : ⊤ → Codec a
structural u = a.codec u


-- A derived codec's description: its node, its Encoded end a host value
-- (`NHost`).
describedHost : Node → Node
describedHost n = NHost n


-- A derived tuple: its elements' nodes, a host array, and how the typed
-- tuple is made from a host array of its values (`there`) and taken apart
-- into one (`back`). `⊤` is the tuple of none.
describedTuple : Js.Value, Js.Value, Js.Value → Node
describedTuple items there back = NTuple items (pair there back)


-- A derived custom type's constructors (`schema.md` §12.3): a host array of
-- `[name, nodes, inject, project]`, one per constructor in declaration
-- order.
describedConstructors : Js.Value → Node
describedConstructors ctors =
    cs = Js.array []
    Js.each ctors λk →
        c : CtorNode
        c =
            { name = stringOf (Js.at k 0)
            , nodes = Js.at k 1
            , inject = Js.at k 2
            , project = Js.at k 3
            }
        push cs (toHost c)
    NCtors cs


-- A derived `Maybe` outside a record field (`schema.md` §12.4): `null` is
-- `Nothing`. `mode` has bit 1 when the inner node reads `null` itself,
-- and bit 2 when a `null` the inner node writes is refused (§12.10).
describedMaybe : Node, Int → Node
describedMaybe n mode = NMaybe n mode


-- A derived record's `Maybe` field (`schema.md` §12.4, §12.10): its key
-- absent is `Nothing`, and present it is `describedMaybe n mode`'s answer.
describedMaybeField : String, Node, Int → Js.Value
describedMaybeField name n mode =
    f : FieldNode
    f =
        { name = name
        , key = name
        , renamed = False
        , optional = True
        , lenient = True
        , node = NMaybe n mode
        }
    toHost f


-- A string of exactly one character.
derivedChar : Schema Char Char
derivedChar = primitive CharKind


-- A safe integer from −2³¹ to 2³¹ − 1.
derivedInt32 : Schema e a
derivedInt32 = primitive Int32Kind


-- Nothing: `⊥` has no value.
derivedNever : Schema ⊥ ⊥
derivedNever = primitive NeverKind


-- The `i`th of a host array of nodes.
nodeAt : Js.Value, Int → Node
nodeAt xs i = fromHost (Js.at xs i)


-- A compiled schema's `parse` worker. A declaration's is its own; the
-- others' are made here, when a root or a slot is about to run one, so a
-- build that only composes and describes schemas keeps none of them.
parserOf : Workers → Js.Value
parserOf w =
    case w.made of
        MadeDeclared _ _ →
            w.parse

        MadePrimitive p →
            primitiveWorker p

        MadeList child →
            listWorker (parserOf child)

        MadeNullable child →
            nullableWorker (parserOf child)

        MadeConverted source p →
            forwardWorker (parserOf source) (cast p)

        MadeErased source →
            parserOf source


-- A compiled schema's `print` worker, as `parserOf`.
printerOf : Workers → Js.Value
printerOf w =
    case w.made of
        MadeDeclared _ _ →
            w.print

        MadePrimitive p →
            primitiveWorker p

        MadeList child →
            listWorker (printerOf child)

        MadeNullable child →
            nullableWorker (printerOf child)

        MadeConverted source p →
            backwardWorker (printerOf source) (cast p)

        MadeErased source →
            printerOf source


-- The operations a compiled schema runs besides `parse` and `print`, by
-- their place in a declaration's array of the other workers (`declared`).
-- `decode` and `read` decode, from the Encoded endpoint to the Type, and
-- `encode` and `write` encode. A declaration's worker is specialised to its
-- operation's two ends (`schema.md` §6, *Every runner of a statically known
-- schema is compiled*); the workers core makes for its own makers read the
-- ends from the context and serve every operation.
decodeMode : Int
decodeMode = 0


encodeMode : Int
encodeMode = 1


readMode : Int
readMode = 2


writeMode : Int
writeMode = 3


-- `read` as a validator (`schema.md` §6, *A run whose failure is never
-- read is a validator*): a declaration's workers that make no issue.
validMode : Int
validMode = 4


-- A compiled schema's worker of decoding operation `mode`, as `parserOf`
-- makes its `parse` worker. Not `parserOf` with one more argument: that
-- would cost every program that only parses and prints its inlined
-- `parserOf` (Conduit direct +71 brotli, `schema.md` §16, *As built — every
-- runner*). The duplication, here and in the four slot makers, is the price
-- of that, paid only by a program that runs the other four operations or
-- builds a dynamic schema (#176); merging them back must keep Conduit's
-- bytes.
parserIn : Workers, Int → Js.Value
parserIn w mode =
    case w.made of
        MadeDeclared _ others →
            Js.at others mode

        MadePrimitive p →
            primitiveWorker p

        MadeList child →
            listWorker (parserIn child mode)

        MadeNullable child →
            nullableWorker (parserIn child mode)

        MadeConverted source p →
            forwardWorker (parserIn source mode) (cast p)

        MadeErased source →
            if mode == decodeMode then
                hostWorker (parserIn source readMode)
            else
                parserIn source mode


-- A compiled schema's worker of encoding operation `mode`.
printerIn : Workers, Int → Js.Value
printerIn w mode =
    case w.made of
        MadeDeclared _ others →
            Js.at others mode

        MadePrimitive p →
            primitiveWorker p

        MadeList child →
            listWorker (printerIn child mode)

        MadeNullable child →
            nullableWorker (printerIn child mode)

        MadeConverted source p →
            backwardWorker (printerIn source mode) (cast p)

        MadeErased source →
            if mode == encodeMode then
                hostWorker (printerIn source writeMode)
            else
                printerIn source mode


-- `NHost` over a compiled worker: the worker of `read` or `write`, run on
-- the context with its Encoded end a host value (`hostEnds`).
hostWorker : Js.Value → Js.Value
hostWorker inner =
    worker : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    worker c depth parent input output v =
        Js.apply inner [ toHost (hostEnds c), Js.from depth, parent, input, output, v ]
    toHost worker


-- The context with its Encoded end a host value: `decode` becomes `read`
-- and `encode` becomes `write` (`NHost`). The issues are the same array,
-- so a failure below is the caller's `c.fail`.
hostEnds : Context → Context
hostEnds c =
    { Record.copy c | sh = c.sh || c.src == encodedSide, dh = c.dh || c.dst == encodedSide }


-- `prim`, in either direction: the context says which.
primitiveWorker : PrimitiveKind → Js.Value
primitiveWorker p =
    worker : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    worker c depth parent input output v = prim c p depth (pathAt parent input output) v
    toHost worker


-- `listOf` over a compiled child's worker, in either direction: the context
-- says which. A failure's path is made only when one is reported.
listWorker : Js.Value → Js.Value
listWorker child =
    worker : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    worker c depth parent input output v =
        if c.sh && not (isArray v) then
            failAt c (pathAt parent input output) WrongShape "expected an array" v False
        else
            before = issueCount c
            path = pathAt parent input output
            xs = plain v
            out = Js.array []
            if workerItems c child depth path xs out 0 (lengthOf xs) then
                c.fail
            else if issueCount c > before then
                c.fail
            else
                out
    toHost worker


-- `listItems`, calling the child's worker. True when the list stops at a
-- failure.
workerItems : Context, Js.Value, Int, Path, Js.Value, Js.Value, Int, Int → Bool
workerItems c child depth path xs out i n =
    if i ≥ n then
        False
    else
        item = Js.at xs i
        x =
            if depth ≥ c.max then
                failAt
                    c
                    (step path (Js.from i) (Js.from i))
                    DepthExceeded
                    "the depth limit is reached"
                    item
                    False
            else
                Js.apply child [ toHost c, Js.from (depth + 1), path, Js.from i, Js.from i, item ]
        if Js.same x c.fail then
            if c.all then
                workerItems c child depth path xs out (i + 1) n
            else
                True
        else
            _ = Js.call out "push" [ x ]
            workerItems c child depth path xs out (i + 1) n


-- `NNullable` over a compiled child's worker, in either direction.
nullableWorker : Js.Value → Js.Value
nullableWorker child =
    worker : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    worker c depth parent input output v =
        if c.sh then
            if Js.isNull v then
                nullOut c
            else
                nonNullOut c (Js.apply child [ toHost c, Js.from depth, parent, input, output, v ])
        else
            case nullableOf v of
                Null →
                    nullOut c

                NonNull a →
                    nonNullOut
                        c
                        (Js.apply child [ toHost c, Js.from depth, parent, input, output, a ])
    toHost worker


-- ---- Records -------------------------------------------------------------

--| No fields yet.
pub fields : Fields ⊤ ⊤
fields = fieldsBox (toHost []) Nothing


fieldsBox : Js.Value, Maybe String → Fields pe pa
fieldsBox fs problem =
    b : FieldsBox
    b = { fields = fs, problem = problem }
    cast b


fieldsOf : Fields pe pa → FieldsBox
fieldsOf fs = cast fs


fieldNode : String, String, Bool, Bool, Node → FieldNode
fieldNode name k renamed isOptional n =
    { name = name, key = k, renamed = renamed, optional = isOptional, lenient = False, node = n }


withField : Fields pe pa, String, Schema e a, Bool → Fields qe qa
withField fs name s isOptional =
    b = fieldsOf fs
    Js.pure λ⊤ →
        fieldsBox
            (appended b.fields (toHost (fieldNode name name False isOptional (nodeOf s))))
            b.problem


--| A required field, read and written under its own name until `key`
--| renames it outside.
pub field : Fields pe pa, String, Schema e a → Fields (pe × e) (pa × a)
field fs name s = withField fs name s False


--| A field that may be missing: its key absent is `Missing`, and present it
--| is `Present` of the child's value, whatever that is — `null` included
--| when the child is `nullable`.
pub optional :
      Fields pe pa
    , String
    , Schema e a
    → Fields (pe × Presence e) (pa × Presence a)
optional fs name s = withField fs name s True


-- The construction failure a builder found, unless one was found before.
firstProblem : Maybe String, String → Maybe String
firstProblem problem message =
    case problem of
        Just _ →
            problem

        Nothing →
            Just message


--| The external key of the field just added: the Encoded endpoint reads and
--| writes the key, and the Type endpoint, and both typed records, the
--| field's name. A declaration's `as "key"`.
pub key : Fields pe pa, String → Fields pe pa
key fs external =
    b = fieldsOf fs
    Js.pure λ⊤ →
        n = lengthOf b.fields
        if n == 0 then
            fieldsBox
                b.fields
                (firstProblem
                    b.problem
                    "Schema.key renames the field added before it, and there is none"
                )
        else
            last = fieldAt b.fields (n - 1)
            if last.renamed then
                fieldsBox
                    b.fields
                    (firstProblem
                        b.problem
                        "the field ${last.name} already has the key \"${last.key}\""
                    )
            else
                fieldsBox
                    (appended
                        (Js.call b.fields "slice" [ Js.from 0, Js.from (n - 1) ])
                        (toHost { Record.copy last | key = external, renamed = True })
                    )
                    b.problem


--| How the products of `fields` become the records of each endpoint, and
--| back: `to` builds the record from the product, `from` takes it apart.
pub mapping : sync (p → r), sync (r → p) → Mapping p r
mapping to from = cast (pair (toHost to) (toHost from))


--| A record schema: the fields, then how each endpoint's product becomes
--| its record. The two mappings are often one polymorphic pair of functions,
--| since both records have the same field names.
pub record : Fields pe pa, Mapping pe e, Mapping pa a → Schema e a
record fs encoded typed =
    b = fieldsOf fs
    encodedMaps : Pair
    encodedMaps = cast encoded
    typedMaps : Pair
    typedMaps = cast typed
    Js.pure λ⊤ →
        case b.problem of
            Just problem →
                box (NBroken problem)

            Nothing →
                case duplicateIn b.fields fieldName of
                    Just name →
                        box (NBroken "two fields are named ${name}")

                    Nothing →
                        case duplicateIn b.fields fieldKey of
                            Just k →
                                box (NBroken "two fields read and write the key \"${k}\"")

                            Nothing →
                                box
                                    (NRecord b.fields
                                        { toE = encodedMaps.there
                                        , fromE = encodedMaps.back
                                        , toA = typedMaps.there
                                        , fromA = typedMaps.back
                                        }
                                    )


fieldName : FieldNode → String
fieldName f = f.name


fieldKey : FieldNode → String
fieldKey f = f.key


-- ---- Tagged unions -------------------------------------------------------

--| A constructor and its test, for one variant at one endpoint.
pub injection : sync (p → a), sync (a → Maybe p) → Injection p a
injection inject project = cast (pair (toHost inject) (toHost project))


variantNode : String, String, Maybe Node, Pair, Pair, Maybe String → Variant e a
variantNode name tag payload injE injA problem =
    v : VariantNode
    v = { name = name, tag = tag, payload = payload, injE = injE, injA = injA, problem = problem }
    cast v


--| A variant with a payload: its constructor name, its tag, its payload —
--| a `record` schema, whose fields sit beside the discriminator — and its
--| two constructors.
pub variant :
      String
    , String
    , Schema pe pa
    , Injection pe e
    , Injection pa a
    → Variant e a
variant name tag payload injectE injectA =
    n = nodeOf payload
    variantNode
        name
        tag
        (Just n)
        (cast injectE)
        (cast injectA)
        (case n of
            NRecord _ _ →
                Nothing

            _ →
                Just "the payload of the variant ${name} is not a record schema"
        )


--| A variant with no payload: only the discriminator is written.
pub nullary : String, String, Injection ⊤ e, Injection ⊤ a → Variant e a
nullary name tag injectE injectA =
    variantNode name tag Nothing (cast injectE) (cast injectA) Nothing


--| A tagged union: the discriminator key, then the variants. A value is an
--| object whose discriminator holds one variant's tag and whose other keys
--| are that variant's payload.
pub tagged : String, List (Variant e a) → Schema e a
tagged discriminator variants = Js.pure λ⊤ →
    vs = plain (toHost variants)
    broken =
        Js.call vs "find"
            [ toHost λv →
                case v.problem of
                    Just _ →
                        True

                    Nothing →
                        False
            ]
    case if Js.isUndefined broken then Nothing else (asVariant broken).problem of
        Just problem →
            box (NBroken problem)

        Nothing →
            if lengthOf vs == 0 then
                box (NBroken "a tagged schema needs a variant")
            else
                case duplicateIn vs variantTag of
                    Just tag →
                        box (NBroken "two variants have the tag \"${tag}\"")

                    Nothing →
                        case duplicateIn vs variantName of
                            Just name →
                                box (NBroken "two variants are named ${name}")

                            Nothing →
                                clash =
                                    Js.call vs "find"
                                        [ toHost λv →
                                            case v.payload of
                                                Just (NRecord fs _) →
                                                    Js.to
                                                        (Js.call fs "some"
                                                            [ toHost λf →
                                                                f.key == discriminator
                                                                    || f.name == discriminator
                                                            ]
                                                        )

                                                _ →
                                                    False
                                        ]
                                if Js.isUndefined clash then
                                    box (NTagged discriminator vs)
                                else
                                    box
                                        (NBroken
                                            "the variant ${(asVariant clash).name} has a field on the discriminator \"${discriminator}\""
                                        )


variantTag : VariantNode → String
variantTag v = v.tag


variantName : VariantNode → String
variantName v = v.name


asVariant : Js.Value → VariantNode
asVariant v = fromHost v


-- ---- Conversions ---------------------------------------------------------

--| A fallible conversion: from the source endpoint `b` to the target `a`,
--| and back. An `Err` holds issues whose paths are relative to the value
--| converted; the engine puts them where the value is.
pub conversion :
      sync (b → Result (List Issue) a)
    , sync (a → Result (List Issue) b)
    → Conversion b a
conversion forward backward = cast (pair (toHost forward) (toHost backward))


--| The schema's values, converted: decoding reads `e` to `b` and converts
--| it to `a`; encoding converts `a` back to `b` and writes `e`. The Type
--| endpoint is the conversion's target, which has no external form of its
--| own.
pub converted : Schema e b, Conversion b a → Schema e a
converted source c =
    p : Pair
    p = cast c
    case (boxOf source).engine of
        Compiled w →
            compiled (MadeConverted w p) Js.null Js.null w.args

        Interpreted →
            box (NConverted (nodeOf source) p.there p.back)


-- `NConverted` decoding over a compiled source's worker: the source, then
-- the conversion's `forward` (`compiledForward`).
forwardWorker : Js.Value, Conversion b a → Js.Value
forwardWorker source conv =
    worker : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    worker c depth parent input output v =
        b = Js.apply source [ toHost c, Js.from depth, parent, input, output, v ]
        if Js.same b c.fail then
            c.fail
        else
            compiledForward c parent input output conv b
    toHost worker


-- `NConverted` encoding: the conversion's `backward`, then the source below
-- it (`belowBackward`).
backwardWorker : Js.Value, Conversion b a → Js.Value
backwardWorker source conv =
    worker : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    worker c depth parent input output v =
        b = compiledBackward c parent input output conv v
        if Js.same b c.fail then
            c.fail
        else
            Js.apply source [ toHost (belowBackward c), Js.from depth, parent, input, output, b ]
    toHost worker


--| A conversion's failure at the value it converted, `ConversionFailed`.
--| The engine fills in the direction, the endpoint and the path.
pub issue : String → Issue
issue message = issueAt [] message


--| A conversion's failure below the value it converted, at a path relative
--| to it.
pub issueAt : List PathSegment, String → Issue
issueAt path message =
    { path = path
    , direction = Decoding
    , endpoint = Type
    , code = ConversionFailed
    , message = message
    , input = Nothing
    }


-- ---- Recursion -----------------------------------------------------------

--| A schema that refers to itself: the function is given the schema it
--| defines and builds its body, once, the first time it is needed. A
--| reference to it is resolved by identity, never by name, so two schemas
--| built with one name are still two.
pub recursive : String, sync (Schema e a → Schema e a) → Schema e a
recursive name body =
    built : Node → Node
    built self = nodeOf (body (box self))
    box (NRef (cellOf name (toHost built)))


-- A recursive schema's definition, unbuilt: `build` is given the reference
-- to it, a node, and answers its body's node.
cellOf : String, Js.Value → Cell
cellOf name build = { name = name, build = build, state = Js.ref 0, body = Js.ref Nothing }


-- A reference's body, built the first time it is needed; `Nothing` while it
-- is being built, the one way a reference can dangle.
resolve : Cell → Maybe Node
resolve cell =
    case Js.read cell.state of
        2 →
            Js.read cell.body

        1 →
            Nothing

        _ →
            Js.write cell.state 1
            n : Node
            n = fromHost (Js.apply cell.build [ toHost (NRef cell) ])
            Js.write cell.body (Just n)
            Js.write cell.state 2
            Just n


dangling : Cell → String
dangling cell = "the recursive schema ${cell.name} is used before its body is built"


-- ---- Endpoints -----------------------------------------------------------

--| The same schema facing the other way: its Encoded endpoint is `a` and its
--| Type endpoint `e`, so decoding it encodes the original. Flipping twice is
--| the original.
pub flip : Schema e a → Schema a e
flip s =
    case nodeOf s of
        NFlipped inner →
            box inner

        n →
            box (NFlipped n)


--| The Type endpoint alone, at both ends: both directions validate a Type
--| value and convert nothing. Outside, it is written with the declared
--| field names. A conversion's target is identity here.
pub typeOnly : Schema e a → Schema a a
typeOnly s = box (NProjected typeSide (nodeOf s))


--| The Encoded endpoint alone, at both ends.
pub encodedOnly : Schema e a → Schema e e
encodedOnly s = box (NProjected encodedSide (nodeOf s))


-- ---- What a root operation checks before it reads anything ---------------

-- The first construction failure the schema reaches. `seen` is a host `Set`
-- of the definitions already entered.
problemIn : Node, Js.Value → Maybe String
problemIn n seen =
    case n of
        NList child →
            problemIn child seen

        NNullable child →
            problemIn child seen

        NFlipped child →
            problemIn child seen

        NConverted child _ _ →
            problemIn child seen

        NProjected _ child →
            problemIn child seen

        NRecord fs _ →
            problemInFields fs seen 0 (lengthOf fs)

        NTagged _ vs →
            problemInVariants vs seen 0 (lengthOf vs)

        NRef cell →
            if Js.to (Js.call seen "has" [ toHost cell ]) then
                Nothing
            else
                _ = Js.call seen "add" [ toHost cell ]
                case resolve cell of
                    Nothing →
                        Just (dangling cell)

                    Just body →
                        problemIn body seen

        NBroken problem →
            Just problem

        NPrim _ →
            Nothing

        NTuple items _ →
            problemInNodes items seen 0 (lengthOf items)

        NCtors cs →
            problemInCtors cs seen 0 (lengthOf cs)

        NMaybe child _ →
            problemIn child seen

        NHost inner →
            problemIn inner seen


problemInNodes : Js.Value, Js.Value, Int, Int → Maybe String
problemInNodes items seen i n =
    if i ≥ n then
        Nothing
    else
        case problemIn (nodeAt items i) seen of
            Nothing →
                problemInNodes items seen (i + 1) n

            found →
                found


problemInCtors : Js.Value, Js.Value, Int, Int → Maybe String
problemInCtors cs seen i n =
    if i ≥ n then
        Nothing
    else
        k : CtorNode
        k = fromHost (Js.at cs i)
        case problemInNodes k.nodes seen 0 (lengthOf k.nodes) of
            Nothing →
                problemInCtors cs seen (i + 1) n

            found →
                found


problemInFields : Js.Value, Js.Value, Int, Int → Maybe String
problemInFields fs seen i n =
    if i ≥ n then
        Nothing
    else
        case problemIn (fieldAt fs i).node seen of
            Nothing →
                problemInFields fs seen (i + 1) n

            found →
                found


problemInVariants : Js.Value, Js.Value, Int, Int → Maybe String
problemInVariants vs seen i n =
    if i ≥ n then
        Nothing
    else
        case (variantAt vs i).payload of
            Just p →
                case problemIn p seen of
                    Nothing →
                        problemInVariants vs seen (i + 1) n

                    found →
                        found

            Nothing →
                problemInVariants vs seen (i + 1) n


-- Whether the `side` endpoint holds a conversion's target, which has no
-- external form: a reachability walk over (node, side), so a flip inside a
-- recursive schema is followed exactly. `seen` is a host `Map` from a
-- definition to the sides it was entered at, one bit each.
opaqueIn : Node, Int, Js.Value → Bool
opaqueIn n side seen =
    case n of
        NList child →
            opaqueIn child side seen

        NNullable child →
            opaqueIn child side seen

        NRecord fs _ →
            opaqueField fs side seen 0 (lengthOf fs)

        NTagged _ vs →
            opaqueVariant vs side seen 0 (lengthOf vs)

        NConverted child _ _ →
            side == typeSide || opaqueIn child encodedSide seen

        NFlipped child →
            opaqueIn child (1 - side) seen

        NProjected onlySide child →
            opaqueIn child onlySide seen

        NRef cell →
            entered = Js.call seen "get" [ toHost cell ]
            mask = if Js.isUndefined entered then 0 else intOf entered
            bit = if side == encodedSide then 1 else 2
            if Js.bitAnd mask bit ≠ 0 then
                False
            else
                _ = Js.call seen "set" [ toHost cell, Js.from (Js.bitOr mask bit) ]
                case resolve cell of
                    Nothing →
                        False

                    Just body →
                        opaqueIn body side seen

        NTuple items _ →
            opaqueNodes items side seen 0 (lengthOf items)

        NCtors cs →
            opaqueCtors cs side seen 0 (lengthOf cs)

        NMaybe child _ →
            opaqueIn child side seen

        NHost inner →
            opaqueIn inner side seen

        _ →
            False


opaqueNodes : Js.Value, Int, Js.Value, Int, Int → Bool
opaqueNodes items side seen i n =
    i < n && (opaqueIn (nodeAt items i) side seen || opaqueNodes items side seen (i + 1) n)


opaqueCtors : Js.Value, Int, Js.Value, Int, Int → Bool
opaqueCtors cs side seen i n =
    if i ≥ n then
        False
    else
        k : CtorNode
        k = fromHost (Js.at cs i)
        opaqueNodes k.nodes side seen 0 (lengthOf k.nodes) || opaqueCtors cs side seen (i + 1) n


opaqueField : Js.Value, Int, Js.Value, Int, Int → Bool
opaqueField fs side seen i n =
    i < n && (opaqueIn (fieldAt fs i).node side seen || opaqueField fs side seen (i + 1) n)


opaqueVariant : Js.Value, Int, Js.Value, Int, Int → Bool
opaqueVariant vs side seen i n =
    if i ≥ n then
        False
    else
        case (variantAt vs i).payload of
            Just p →
                opaqueIn p side seen || opaqueVariant vs side seen (i + 1) n

            Nothing →
                opaqueVariant vs side seen (i + 1) n


analyse : Schema e a → Analysis
analyse s =
    b = boxOf s
    case Js.read b.analysis of
        Just z →
            z

        Nothing →
            n = nodeOf s
            problem = problemIn n (Js.construct (Js.global "Set") [])
            seen = Js.construct (Js.global "Map") []
            encodedOpaque = opaqueIn n encodedSide seen
            typeOpaque = opaqueIn n typeSide seen
            z : Analysis
            z = { problem = problem, encodedOpaque = encodedOpaque, typeOpaque = typeOpaque }
            Js.write b.analysis (Just z)
            z


opaqueAt : Analysis, Int → Bool
opaqueAt z side =
    if side == encodedSide then
        z.encodedOpaque
    else
        z.typeOpaque


-- ---- One operation's context ---------------------------------------------

-- The context of one root operation. `src` and `dst` are the sides read
-- and written, which a flip or a projection moves, and `sh` and `dh`
-- whether each is a host value; `inE` and `outE` are the root's endpoints,
-- which an issue is reported at whatever moved below; `cv` is set below a
-- conversion's backward step, where a failure is in what the operation
-- writes. `issues` is a host array every step pushes onto, and `fail` what
-- a step that failed answers.
type alias Context =
    all : Bool
    reject : Bool
    max : Int
    report : Bool
    dir : Direction
    json : Bool
    src : Int
    sh : Bool
    dst : Int
    dh : Bool
    inE : Endpoint
    outE : Endpoint
    cv : Bool
    issues : Js.Value
    fail : Js.Value


-- The path to a value: a host `null` at the root, and below it a `Step`,
-- the key or index as the input names it and as the output does. A step is
-- made for every value a run reads, and read only when one fails.
type alias Path =
    Js.Value


type alias Step =
    parent : Path
    input : Js.Value
    output : Js.Value


atRoot : Path
atRoot = Js.null


step : Path, Js.Value, Js.Value → Path
step parent input output =
    s : Step
    s = { parent = parent, input = input, output = output }
    toHost s


-- The recursive schemas entered at a position since the last descent.
type Active
    = NoneActive
    | Entered Cell Active


isActive : Cell, Active → Bool
isActive cell active =
    case active of
        NoneActive →
            False

        Entered c rest →
            Js.same c cell || isActive cell rest


-- The path as a host array of `PathSegment`s, outermost first.
pathArray : Path, Bool → Js.Value
pathArray path output =
    out = Js.array []
    collect path output out
    _ = Js.call out "reverse" []
    out


collect : Path, Bool, Js.Value → ⊤
collect path output out =
    if Js.isNull path then
        ⊤
    else
        s : Step
        s = fromHost path
        -- `push` written out, as in `fieldsFrom`: every failure runs it.
        _ = Js.call out "push" [ toHost (segment (if output then s.output else s.input)) ]
        collect s.parent output out


segment : Js.Value → PathSegment
segment s =
    if isType s "number" then
        Index (intOf s)
    else
        Field (stringOf s)


-- An issue at `path`, pushed onto the context's list. `output` says the
-- failure is in what the operation writes.
failAt : Context, Path, IssueCode, String, Js.Value, Bool → Js.Value
failAt c path code message input output =
    entry : Issue
    entry =
        { path = fromHost (pathArray path output)
        , direction = c.dir
        , endpoint = if output || c.cv then c.outE else c.inE
        , code = code
        , message = message
        , input = if c.report then Just (cast input) else Nothing
        }
    _ = Js.call c.issues "push" [ toHost entry ]
    c.fail


rootErr : Direction, Endpoint, IssueCode, String → Result (List Issue) b
rootErr dir endpoint code message = Err (rootIssue dir endpoint code message)


rootIssue : Direction, Endpoint, IssueCode, String → List Issue
rootIssue dir endpoint code message =
    [ { path = []
      , direction = dir
      , endpoint = endpoint
      , code = code
      , message = message
      , input = Nothing
      }
    ]


-- What ends a root operation before anything is read: bad options, a
-- construction failure, an endpoint with no external form read or written
-- outside.
rootProblem : Schema e a, Options, Direction, Int, Bool, Int, Bool → Maybe (List Issue)
rootProblem s o dir src sh dst dh =
    case optionsProblem o dir src of
        Just issues →
            Just issues

        Nothing →
            z = analyse s
            case z.problem of
                Just problem →
                    Just (rootIssue dir (endpointOf src) InvalidSchema problem)

                Nothing →
                    if sh && opaqueAt z src then
                        Just (opaqueIssue dir src)
                    else if dh && opaqueAt z dst then
                        Just (opaqueIssue dir dst)
                    else
                        Nothing


-- A `maxDepth` the engine does not take: the first thing a root looks at.
optionsProblem : Options, Direction, Int → Maybe (List Issue)
optionsProblem o dir src =
    if
        not
            (Js.to (Js.call (Js.global "Number") "isInteger" [ Js.from o.maxDepth ])
                && o.maxDepth ≥ 0
                && o.maxDepth ≤ maxDepthCeiling
            )
    then
        Just
            (rootIssue
                dir
                (endpointOf src)
                InvalidOptions
                "maxDepth must be from 0 to ${String.fromInt maxDepthCeiling}, not ${String.fromInt o.maxDepth}"
            )
    else
        Nothing


opaqueIssue : Direction, Int → List Issue
opaqueIssue dir side =
    rootIssue
        dir
        (endpointOf side)
        InvalidSchema
        "the ${endpointName side} endpoint holds a conversion's target, which has no external form to read or write"


-- The context of one root operation. A step that failed answers the
-- operation's issue array, which no value it reads or makes can be.
context : Options, Direction, Int, Bool, Int, Bool, Bool → Context
context o dir src sh dst dh json =
    issues = Js.array []
    { all = o.errors == AllErrors
    , reject = o.unknownKeys == Reject
    , max = o.maxDepth
    , report = o.reportInput
    , dir = dir
    , json = json
    , src = src
    , sh = sh
    , dst = dst
    , dh = dh
    , inE = endpointOf src
    , outE = endpointOf dst
    , cv = False
    , issues = issues
    , fail = issues
    }


finish : Context, Js.Value → Result (List Issue) b
finish c x =
    if Js.same x c.fail then
        Err (fromHost c.issues)
    else
        Ok (fromHost x)


issueCount : Context → Int
issueCount c = lengthOf c.issues


-- ---- The host value ------------------------------------------------------

isType : Js.Value, String → Bool
isType v name = Js.same (Js.typeOf v) (Js.from name)


isArray : Js.Value → Bool
isArray v = Js.to (Js.call (Js.global "Array") "isArray" [ v ])


isObject : Js.Value → Bool
isObject v = isType v "object" && not (Js.isNull v) && not (isArray v)


isFinite : Js.Value → Bool
isFinite v = Js.to (Js.call (Js.global "Number") "isFinite" [ v ])


hasOwn : Js.Value, String → Bool
hasOwn v k = Js.to (Js.call (Js.global "Object") "hasOwn" [ v, Js.from k ])


-- The names a standard `Object.prototype` holds, which a read finds on
-- any object: tested as own keys (`present`). The compiled workers test the
-- same names, from `SchemaShare.isPrototypeKey`; a unit test there keeps
-- the two lists equal, so compiled and library runs answer alike whatever
-- a page adds to `Object.prototype`.
prototypeKey : String → Bool
prototypeKey k =
    k == "__proto__"
        || k == "__defineGetter__"
        || k == "__defineSetter__"
        || k == "__lookupGetter__"
        || k == "__lookupSetter__"
        || k == "constructor"
        || k == "hasOwnProperty"
        || k == "isPrototypeOf"
        || k == "propertyIsEnumerable"
        || k == "toLocaleString"
        || k == "toString"
        || k == "valueOf"


-- Whether host object `v` holds key `k`, as every reading runner tests it
-- (`schema.md` §5, *Host values*, amended 2026-10-17): a read of it answers
-- anything but `undefined`, through the prototype chain — but for a name
-- `prototypeKey` lists, which must be `v`'s own, so the prototype never
-- shadows a field.
present : Js.Value, String → Bool
present v k =
    if prototypeKey k then
        hasOwn v k
    else
        not (Js.isUndefined (Js.get v k))


-- A payload's discriminator and variant.
type alias Owner =
    discriminator : String
    variant : VariantNode


-- A fresh host object with no prototype, so that writing `__proto__` or
-- `constructor` makes an own key and changes nothing else (§5); a variant's
-- discriminator is its first key.
newObject : Maybe Owner → Js.Value
newObject owner =
    o = Js.call (Js.global "Object") "create" [ Js.null ]
    case owner of
        Just w →
            Js.set o w.discriminator (Js.from w.variant.tag)

        Nothing →
            ⊤
    o


-- ---- The traversal -------------------------------------------------------

-- Run node `n` on value `v` at `depth` and `path`. `active` lists the
-- recursive schemas entered at this position since the last descent:
-- entering one again would read nothing, so it is refused there (§5). A
-- flip, a projection, a reference and the last step of a conversion loop
-- here; a level of the value costs this frame and its record's or list's.
run : Context, Node, Int, Path, Active, Js.Value → Js.Value
run c n depth path active v =
    case n of
        NPrim p →
            prim c p depth path v

        NList child →
            listOf c child depth path v

        NNullable child →
            if c.sh then
                if Js.isNull v then
                    nullOut c
                else
                    nonNullOut c (run c child depth path active v)
            else
                case nullableOf v of
                    Null →
                        nullOut c

                    NonNull a →
                        nonNullOut c (run c child depth path active a)

        NRecord fs maps →
            if c.sh && not (isObject v) then
                failAt c path WrongShape "expected an object" v False
            else
                recordOf c fs maps Nothing depth path v

        NTagged discriminator vs →
            case variantOf c discriminator vs path v of
                NotFound →
                    c.fail

                FoundVariant x payload →
                    case x.payload of
                        Just (NRecord fs maps) →
                            if depth ≥ c.max then
                                failAt
                                    c
                                    path
                                    DepthExceeded
                                    "the depth limit is reached"
                                    payload
                                    False
                            else
                                recordOf
                                    c
                                    fs
                                    maps
                                    (Just { discriminator = discriminator, variant = x })
                                    (depth + 1)
                                    path
                                    payload

                        _ →
                            nullaryOf c discriminator x path v

        NConverted source forward backward →
            if c.src == encodedSide && c.dst == typeSide then
                b = run c source depth path active v
                if Js.same b c.fail then
                    c.fail
                else
                    call c path forward b
            else if c.src == typeSide && c.dst == encodedSide then
                b = call c path backward v
                if Js.same b c.fail then
                    c.fail
                else
                    run
                        (if c.cv then c else { Record.copy c | cv = True })
                        source
                        depth
                        path
                        active
                        b
            else if c.src == typeSide then
                v
            else
                run c source depth path active v

        NFlipped inner →
            run { Record.copy c | src = 1 - c.src, dst = 1 - c.dst } inner depth path active v

        NProjected side inner →
            run { Record.copy c | src = side, dst = side } inner depth path active v

        NRef cell →
            if isActive cell active then
                failAt
                    c
                    path
                    InvalidSchema
                    "the recursive schema ${cell.name} refers to itself without reading into the value"
                    v
                    False
            else
                case resolve cell of
                    Nothing →
                        failAt c path InvalidSchema (dangling cell) v False

                    Just body →
                        run c body depth path (Entered cell active) v

        NBroken problem →
            failAt c path InvalidSchema problem v False

        NTuple items p →
            arity = lengthOf items
            if c.sh && not (isArray v && lengthOf v == arity) then
                failAt c path WrongShape (elementsMessage arity) v False
            else
                tupleOf c items p depth path v

        NCtors cs →
            if c.sh then
                ctorFromHost c cs depth path v
            else
                ctorFromTyped c cs depth path v

        NMaybe child mode →
            if c.sh then
                if Js.isNull v && Js.bitAnd mode 1 == 0 then
                    nothingOut c
                else
                    justOut c mode (run c child depth path active v) path v
            else
                case maybeOf v of
                    Nothing →
                        nothingOut c

                    Just a →
                        justOut c mode (run c child depth path active a) path a

        NHost inner →
            run (hostEnds c) inner depth path active v


-- ---- Derived nodes (`schema.md` §12.3, §12.10) ---------------------------

elementsMessage : Int → String
elementsMessage n = "expected an array of ${String.fromInt n} elements"


-- A tuple's elements, each one level down, then the tuple: a host array
-- outside, the typed tuple inside.
tupleOf : Context, Js.Value, Pair, Int, Path, Js.Value → Js.Value
tupleOf c items p depth path v =
    before = issueCount c
    xs = if c.sh then v else Js.apply p.back [ v ]
    out = Js.array []
    if elementsFrom c items depth path xs out 0 (lengthOf items) then
        c.fail
    else if issueCount c > before then
        c.fail
    else if c.dh then
        out
    else
        Js.apply p.there [ out ]


-- Element `i` on of a fixed number, each by its own node at `Index i`, one
-- level down from `depth`. True when they stop at a failure.
elementsFrom : Context, Js.Value, Int, Path, Js.Value, Js.Value, Int, Int → Bool
elementsFrom c items depth path xs out i n =
    if i ≥ n then
        False
    else
        here = step path (Js.from i) (Js.from i)
        item = Js.at xs i
        x =
            if depth ≥ c.max then
                failAt c here DepthExceeded "the depth limit is reached" item False
            else
                run c (nodeAt items i) (depth + 1) here NoneActive item
        if Js.same x c.fail then
            if c.all then
                elementsFrom c items depth path xs out (i + 1) n
            else
                True
        else
            _ = Js.call out "push" [ x ]
            elementsFrom c items depth path xs out (i + 1) n


ctorMessage : String
ctorMessage = "expected a constructor: a string, or an object with one key"


-- A constructor read from its wire form: a nullary one's name, or an object
-- whose one key is the name of one that takes arguments.
ctorFromHost : Context, Js.Value, Int, Path, Js.Value → Js.Value
ctorFromHost c cs depth path v =
    if isType v "string" then
        name = stringOf v
        case ctorNamed cs name 0 (lengthOf cs) of
            Nothing →
                failAt c path UnknownTag (unknownCtor cs name) v False

            Just k →
                if lengthOf k.nodes == 0 then
                    ctorOut c k (Js.array [])
                else
                    failAt
                        c
                        path
                        WrongShape
                        "the constructor ${name} takes arguments, so it is an object with the key \"${name}\""
                        v
                        False
    else if isObject v then
        keys = Js.call (Js.global "Object") "keys" [ v ]
        if lengthOf keys ≠ 1 then
            failAt c path WrongShape ctorMessage v False
        else
            name = stringOf (Js.at keys 0)
            case ctorNamed cs name 0 (lengthOf cs) of
                Nothing →
                    failAt c path UnknownTag (unknownCtor cs name) v False

                Just k →
                    if lengthOf k.nodes == 0 then
                        failAt
                            c
                            path
                            WrongShape
                            "the constructor ${name} takes no arguments, so it is the string \"${name}\""
                            v
                            False
                    else
                        payload = Js.get v name
                        ctorArgs c k depth path payload payload
    else
        failAt c path WrongShape ctorMessage v False


-- A typed constructor's arguments, each run, then the constructor again.
ctorFromTyped : Context, Js.Value, Int, Path, Js.Value → Js.Value
ctorFromTyped c cs depth path v =
    case ctorOf cs v 0 (lengthOf cs) of
        Nothing →
            failAt c path InvalidSchema "no constructor takes the value" v False

        Just found →
            ( k, args ) = found
            if lengthOf k.nodes == 0 then
                ctorOut c k args
            else
                ctorArgs c k depth path (if lengthOf k.nodes == 1 then Js.at args 0 else args) v


-- The arguments of `k`, read at its name one level down: the argument
-- itself, or an array of exactly as many as it takes. `input` is what the
-- depth bound's issue holds: the payload read, or the constructor written.
ctorArgs : Context, CtorNode, Int, Path, Js.Value, Js.Value → Js.Value
ctorArgs c k depth path payload input =
    here = step path (Js.from k.name) (Js.from k.name)
    n = lengthOf k.nodes
    if depth ≥ c.max then
        failAt c here DepthExceeded "the depth limit is reached" input False
    else if n == 1 then
        x = run c (nodeAt k.nodes 0) (depth + 1) here NoneActive payload
        if Js.same x c.fail then
            c.fail
        else
            ctorOut c k (Js.array [ x ])
    else if c.sh && not (isArray payload && lengthOf payload == n) then
        failAt c here WrongShape (elementsMessage n) payload False
    else
        before = issueCount c
        out = Js.array []
        if elementsFrom c k.nodes (depth + 1) here payload out 0 n then
            c.fail
        else if issueCount c > before then
            c.fail
        else
            ctorOut c k out


-- A constructor of `args` written: its name, or an object of its name
-- outside; the constructor applied inside.
ctorOut : Context, CtorNode, Js.Value → Js.Value
ctorOut c k args =
    if c.dh then
        n = lengthOf k.nodes
        if n == 0 then
            Js.from k.name
        else
            o = newObject Nothing
            Js.set o k.name (if n == 1 then Js.at args 0 else args)
            o
    else
        Js.apply k.inject [ args ]


ctorNamed : Js.Value, String, Int, Int → Maybe CtorNode
ctorNamed cs name i n =
    if i ≥ n then
        Nothing
    else
        k : CtorNode
        k = fromHost (Js.at cs i)
        if k.name == name then
            Just k
        else
            ctorNamed cs name (i + 1) n


-- The constructor a typed value is, and its arguments.
ctorOf : Js.Value, Js.Value, Int, Int → Maybe (CtorNode × Js.Value)
ctorOf cs v i n =
    if i ≥ n then
        Nothing
    else
        k : CtorNode
        k = fromHost (Js.at cs i)
        args = Js.apply k.project [ v ]
        if Js.isNull args then
            ctorOf cs v (i + 1) n
        else
            Just ( k, args )


unknownCtor : Js.Value, String → String
unknownCtor cs name =
    names = Js.call (Js.call cs "map" [ toHost quotedCtor ]) "join" [ Js.from ", " ]
    "unknown constructor \"${name}\"; expected ${stringOf names}"


quotedCtor : Js.Value → String
quotedCtor k =
    c : CtorNode
    c = fromHost k
    "\"${c.name}\""


nothingOut : Context → Js.Value
nothingOut c =
    if c.dh then
        Js.null
    else
        toHost Nothing


justOut : Context, Int, Js.Value, Path, Js.Value → Js.Value
justOut c mode x path input =
    if Js.same x c.fail then
        c.fail
    else if c.dh then
        if Js.bitAnd mode 2 ≠ 0 && Js.isNull x then
            failAt
                c
                path
                InvalidValue
                "the value inside Just writes null, which reads back as Nothing"
                input
                True
        else
            x
    else
        toHost (Just x)


nullOut : Context → Js.Value
nullOut c =
    if c.dh then
        Js.null
    else
        toHost Null


nonNullOut : Context, Js.Value → Js.Value
nonNullOut c x =
    if Js.same x c.fail then
        c.fail
    else if c.dh then
        x
    else
        toHost (NonNull x)


prim : Context, PrimitiveKind, Int, Path, Js.Value → Js.Value
prim c p depth path v =
    case p of
        StringKind →
            if isType v "string" then
                v
            else
                failAt c path WrongShape "expected a string" v False

        BoolKind →
            if isType v "boolean" then
                v
            else
                failAt c path WrongShape "expected a boolean" v False

        IntKind →
            if not (isType v "number") then
                failAt c path WrongShape "expected a number" v False
            else if Js.to (Js.call (Js.global "Number") "isSafeInteger" [ v ]) then
                v
            else
                failAt c path InvalidValue "expected a safe integer" v False

        FloatKind →
            if not (isType v "number") then
                failAt c path WrongShape "expected a number" v False
            else if c.json && c.dh && not (isFinite v) then
                failAt c path PrintFailed "JSON has no number for NaN or an infinity" v True
            else
                v

        FiniteFloatKind →
            if not (isType v "number") then
                failAt c path WrongShape "expected a number" v False
            else if isFinite v then
                v
            else
                failAt c path InvalidValue "expected a finite number" v False

        NullKind →
            if c.sh && not (Js.isNull v) then
                failAt c path WrongShape "expected null" v False
            else
                nullOut c

        ValueKind →
            if c.json && c.dh then
                case printable v (c.max - depth) of
                    1 →
                        failAt
                            c
                            path
                            DepthExceeded
                            "the value nests deeper than the depth limit"
                            v
                            True

                    2 →
                        failAt
                            c
                            path
                            PrintFailed
                            "the value holds NaN or an infinity, which JSON has no number for"
                            v
                            True

                    _ →
                        v
            else
                v

        CharKind →
            if not (isType v "string") then
                failAt c path WrongShape "expected a string" v False
            else if lengthOf (Js.call (Js.global "Array") "from" [ v ]) == 1 then
                v
            else
                failAt c path InvalidValue "expected one character" v False

        Int32Kind →
            if not (isType v "number") then
                failAt c path WrongShape "expected a number" v False
            else if Js.bitOr (intOf v) 0 == intOf v then
                v
            else
                failAt c path InvalidValue "expected a 32-bit integer" v False

        NeverKind →
            failAt c path WrongShape "expected nothing: ⊥ has no value" v False


-- Whether a host value prints as JSON as it is: 0 when it does, 1 when it
-- nests deeper than `budget` more levels, 2 when it holds a number JSON
-- has no form for.
printable : Js.Value, Int → Int
printable v budget =
    if isType v "number" then
        if isFinite v then
            0
        else
            2
    else if not (isType v "object") || Js.isNull v then
        0
    else if isArray v then
        printableItems v Js.undefined 0 (lengthOf v) budget
    else
        keys = Js.call (Js.global "Object") "keys" [ v ]
        printableItems keys v 0 (lengthOf keys) budget


-- The items of an array, or with `owner` an object's values by its keys.
printableItems : Js.Value, Js.Value, Int, Int, Int → Int
printableItems items owner i n budget =
    if i ≥ n then
        0
    else if budget < 1 then
        1
    else
        item =
            if Js.isUndefined owner then
                Js.at items i
            else
                Js.get owner (stringOf (Js.at items i))
        r = printable item (budget - 1)
        if r ≠ 0 then
            r
        else
            printableItems items owner (i + 1) n budget


-- A list's elements, each one level down: the depth bound is tested before
-- the descent (§5), and the references entered at the list's own position
-- are left behind. A failure is an issue added since `before`.
listOf : Context, Node, Int, Path, Js.Value → Js.Value
listOf c child depth path v =
    if c.sh && not (isArray v) then
        failAt c path WrongShape "expected an array" v False
    else
        before = issueCount c
        xs = plain v
        out = Js.array []
        if listItems c child depth path xs out 0 (lengthOf xs) then
            c.fail
        else if issueCount c > before then
            c.fail
        else
            out


-- True when the list stops at a failure.
listItems : Context, Node, Int, Path, Js.Value, Js.Value, Int, Int → Bool
listItems c child depth path xs out i n =
    if i ≥ n then
        False
    else
        here = step path (Js.from i) (Js.from i)
        item = Js.at xs i
        x =
            if depth ≥ c.max then
                failAt c here DepthExceeded "the depth limit is reached" item False
            else
                run c child (depth + 1) here NoneActive item
        if Js.same x c.fail then
            if c.all then
                listItems c child depth path xs out (i + 1) n
            else
                True
        else
            -- `push` written out, as `fieldsFrom` writes it.
            _ = Js.call out "push" [ x ]
            listItems c child depth path xs out (i + 1) n


-- Under `Reject`, each own key of a host object the record does not claim,
-- in the object's own key order, at its own path. True when one was found.
unknownKeys : Context, Js.Value, Maybe String, Path, Js.Value → Bool
unknownKeys c fs claimed path v =
    keys = Js.call (Js.global "Object") "keys" [ v ]
    unknownKeysFrom c fs claimed path v keys 0 (lengthOf keys) False


unknownKeysFrom : Context, Js.Value, Maybe String, Path, Js.Value, Js.Value, Int, Int, Bool → Bool
unknownKeysFrom c fs claimed path v keys i n found =
    if i ≥ n then
        found
    else
        k = stringOf (Js.at keys i)
        if claimed == Just k || claims c fs k 0 (lengthOf fs) then
            unknownKeysFrom c fs claimed path v keys (i + 1) n found
        else
            _ =
                failAt
                    c
                    (step path (Js.from k) (Js.from k))
                    UnknownKey
                    "unexpected key \"${k}\""
                    (Js.get v k)
                    False
            if c.all then
                unknownKeysFrom c fs claimed path v keys (i + 1) n True
            else
                True


-- Whether a field reads key `k` of the input.
claims : Context, Js.Value, String, Int, Int → Bool
claims c fs k i n =
    if i ≥ n then
        False
    else
        f = fieldAt fs i
        (if c.src == encodedSide then f.key else f.name) == k || claims c fs k (i + 1) n


-- A typed record's field values, first field first, from the product its
-- mapping takes it apart into: `( ( ( ⊤, a ), b ), c )` is `[a, b, c]`.
valuesOf : Context, Int, Maps, Js.Value → Js.Value
valuesOf c n maps v =
    values = Js.construct (Js.global "Array") [ Js.from n ]
    product = Js.apply (if c.src == encodedSide then maps.fromE else maps.fromA) [ v ]
    unpack product (n - 1) values
    values


unpack : Js.Value, Int, Js.Value → ⊤
unpack product i values =
    if i < 0 then
        ⊤
    else
        ( rest, x ) = pairOf product
        Js.setAt values i x
        unpack rest (i - 1) values


-- The typed value a record's fields make: the record its mapping builds
-- from their product — in its variant's constructor, for a payload.
made : Context, Maps, Maybe Owner, Js.Value → Js.Value
made c maps owner out =
    product = productOf out 0 (lengthOf out) (toHost ⊤)
    built = Js.apply (if c.dst == encodedSide then maps.toE else maps.toA) [ product ]
    case owner of
        Nothing →
            built

        Just w →
            Js.apply (if c.dst == encodedSide then w.variant.injE.there else w.variant.injA.there)
                [ built ]


productOf : Js.Value, Int, Int, Js.Value → Js.Value
productOf out i n acc =
    if i ≥ n then
        acc
    else
        productOf out (i + 1) n (toHost ( acc, Js.at out i ))


-- A record's fields, in order, each one level down from the record at
-- `depth`, then the value they make. This frame and `run`'s are what one
-- level of a value costs the stack.
recordOf : Context, Js.Value, Maps, Maybe Owner, Int, Path, Js.Value → Js.Value
recordOf c fs maps owner depth path v =
    before = issueCount c
    if
        c.sh && c.reject && unknownKeys c fs (Maybe.map owner .discriminator) path v && not c.all
    then
        c.fail
    else
        values = if c.sh then v else valuesOf c (lengthOf fs) maps v
        out = if c.dh then newObject owner else Js.array []
        if fieldsFrom c fs 0 (lengthOf fs) depth path v values out then
            c.fail
        else if issueCount c > before then
            c.fail
        else if c.dh then
            out
        else
            made c maps owner out


-- The fields from the `i`th on, each read, run and written. True when the
-- record stops at a failure.
fieldsFrom : Context, Js.Value, Int, Int, Int, Path, Js.Value, Js.Value, Js.Value → Bool
fieldsFrom c fs i n depth path v values out =
    if i ≥ n then
        False
    else
        f = fieldAt fs i
        inName = if c.src == encodedSide then f.key else f.name
        outName = if c.dst == encodedSide then f.key else f.name
        here = step path (Js.from inName) (Js.from outName)
        x =
            if c.sh then
                -- `present`'s test and `push` are written out here and not
                -- through `present` and `push`: this is the loop every
                -- record runs, and V8 inlines neither helper into it once a
                -- program runs the engine several ways
                -- (`plans/core-in-beni.md`, the schema engine).
                -- Each key read once, as the compiled paths read it (#368).
                own = prototypeKey inName
                ownHeld = own && Js.to (Js.call (Js.global "Object") "hasOwn" [ v, Js.from inName ])
                got = if own && not ownHeld then Js.undefined else Js.get v inName
                held = if own then ownHeld else not (Js.isUndefined got)
                if held then
                    descend c f depth here got
                else if f.lenient then
                    toHost Nothing
                else if f.optional then
                    toHost Missing
                else
                    failAt c here MissingKey "missing key \"${inName}\"" v False
            else if f.lenient then
                case maybeOf (Js.at values i) of
                    Nothing →
                        Js.at values i

                    Just _ →
                        descend c f depth here (Js.at values i)
            else if f.optional then
                case presenceOf (Js.at values i) of
                    Missing →
                        Js.at values i

                    Present a →
                        descend c f depth here a
            else
                descend c f depth here (Js.at values i)
        if Js.same x c.fail then
            if c.all then
                fieldsFrom c fs (i + 1) n depth path v values out
            else
                True
        else
            if not c.dh then
                Js.to (Js.call out "push" [ x ])
            else if not f.optional then
                Js.set out outName x
            else if f.lenient then
                case maybeOf (Js.at values i) of
                    Nothing →
                        ⊤

                    Just _ →
                        Js.set out outName x
            else
                case presenceOf x of
                    Present a →
                        Js.set out outName a

                    Missing →
                        ⊤
            fieldsFrom c fs (i + 1) n depth path v values out


-- A field's value run one level down, or the failure the depth bound is;
-- an optional field's answer is `Present` of it.
descend : Context, FieldNode, Int, Path, Js.Value → Js.Value
descend c f depth here x =
    y =
        if depth ≥ c.max then
            failAt c here DepthExceeded "the depth limit is reached" x False
        else
            run c f.node (depth + 1) here NoneActive x
    if f.optional && not f.lenient && not (Js.same y c.fail) then
        toHost (Present y)
    else
        y


-- The variant a tagged value is, and its payload: the host object itself,
-- or what a typed value's constructor holds.
type Found
    = NotFound
    | FoundVariant VariantNode Js.Value


-- The discriminator is read first.
variantOf : Context, String, Js.Value, Path, Js.Value → Found
variantOf c discriminator vs path v =
    if c.sh then
        if not (isObject v) then
            failed (failAt c path WrongShape "expected an object" v False)
        else
            here = step path (Js.from discriminator) (Js.from discriminator)
            -- The discriminator read once, as the compiled paths read it (#368).
            own = prototypeKey discriminator
            ownHeld = own && hasOwn v discriminator
            tag = if own && not ownHeld then Js.undefined else Js.get v discriminator
            if not (if own then ownHeld else not (Js.isUndefined tag)) then
                failed (failAt c here MissingKey "missing key \"${discriminator}\"" v False)
            else
                found =
                    if isType tag "string" then
                        withTag vs (stringOf tag) 0 (lengthOf vs)
                    else
                        Nothing
                case found of
                    Just x →
                        FoundVariant x v

                    Nothing →
                        failed
                            (failAt
                                c
                                here
                                UnknownTag
                                ("unknown tag; expected " ++ tagList vs 0 (lengthOf vs) "")
                                tag
                                False
                            )
    else
        case projected c vs v 0 (lengthOf vs) of
            NotFound →
                failed
                    (failAt
                        c
                        path
                        InvalidSchema
                        "no variant of this tagged schema takes the value"
                        v
                        False
                    )

            found →
                found


failed : Js.Value → Found
failed _ = NotFound


-- The variant whose tag is `tag`.
withTag : Js.Value, String, Int, Int → Maybe VariantNode
withTag vs tag i n =
    if i ≥ n then
        Nothing
    else
        v = variantAt vs i
        if v.tag == tag then
            Just v
        else
            withTag vs tag (i + 1) n


-- Every variant's tag, quoted, joined with ", ".
tagList : Js.Value, Int, Int, String → String
tagList vs i n acc =
    if i ≥ n then
        acc
    else
        tagList vs (i + 1) n (acc ++ (if i == 0 then "" else ", ") ++ "\"${(variantAt vs i).tag}\"")


-- The first variant whose test takes a typed value, and its payload.
projected : Context, Js.Value, Js.Value, Int, Int → Found
projected c vs v i n =
    if i ≥ n then
        NotFound
    else
        x = variantAt vs i
        case maybeOf (Js.apply (if c.src == encodedSide then x.injE.back else x.injA.back) [ v ]) of
            Just payload →
                FoundVariant x payload

            Nothing →
                projected c vs v (i + 1) n


-- A variant with no payload: its discriminator alone outside, its
-- constructor inside.
nullaryOf : Context, String, VariantNode, Path, Js.Value → Js.Value
nullaryOf c discriminator x path v =
    if c.sh && c.reject && unknownKeys c (toHost []) (Just discriminator) path v then
        c.fail
    else if c.dh then
        newObject (Just { discriminator = discriminator, variant = x })
    else
        Js.apply (if c.dst == encodedSide then x.injE.there else x.injA.there) [ toHost ⊤ ]


-- A conversion's own answer. Its issues are moved to where the value is:
-- the engine's path in front of theirs, and its direction and endpoint; an
-- `Err` with none is one of the engine's.
call : Context, Path, Js.Value, Js.Value → Js.Value
call c path fn v =
    case resultOf (Js.apply fn [ v ]) of
        Ok a →
            a

        Err given →
            moved c (pathArray path False) v given
            c.fail


-- A conversion's issues, `given`, each pushed onto the context's with the
-- engine's path in front of its own; an `Err` with none is one of the
-- engine's.
moved : Context, Js.Value, Js.Value, Js.Value → ⊤
moved c prefix v given =
    issues = plain given
    Js.each
        (if lengthOf issues == 0 then
            toHost [ issue "the conversion failed without an issue" ]
         else
            issues
        )
        λx →
            i = issueOf x
            entry : Issue
            entry =
                { path = fromHost (Js.call prefix "concat" [ plain (toHost i.path) ])
                , direction = c.dir
                , endpoint = c.outE
                , code = i.code
                , message = i.message
                , input = if c.report then Just (cast v) else Nothing
                }
            push c.issues (toHost entry)


-- ---- Running -------------------------------------------------------------

-- One root operation: its context, then the traversal from the root.
runRoot : Schema e a, Options, Direction, Int, Bool, Int, Bool, Js.Value → Result (List Issue) b
runRoot s o dir src sh dst dh v =
    case rootProblem s o dir src sh dst dh of
        Just issues →
            Err issues

        Nothing →
            c = context o dir src sh dst dh False
            finish c (run c (nodeOf s) 0 atRoot NoneActive v)


--| An Encoded value converted to the Type.
pub decode : Schema e a, e → Result (List Issue) a
decode schema input = decodeWith schema (defaultOptions ⊤) input


--| `decode` with options.
pub decodeWith : Schema e a, Options, e → Result (List Issue) a
decodeWith s o v =
    case (boxOf s).engine of
        Compiled w →
            compiledRun
                o
                w.args
                (parserIn w decodeMode)
                Decoding
                encodedSide
                False
                typeSide
                False
                (toHost v)

        Interpreted →
            runRoot s o Decoding encodedSide False typeSide False (toHost v)


--| A Type value converted to the Encoded.
pub encode : Schema e a, a → Result (List Issue) e
encode schema input = encodeWith schema (defaultOptions ⊤) input


--| `encode` with options.
pub encodeWith : Schema e a, Options, a → Result (List Issue) e
encodeWith s o v =
    case (boxOf s).engine of
        Compiled w →
            compiledRun
                o
                w.args
                (printerIn w encodeMode)
                Encoding
                typeSide
                False
                encodedSide
                False
                (toHost v)

        Interpreted →
            runRoot s o Encoding typeSide False encodedSide False (toHost v)


--| A host value read as the Encoded endpoint's external form, to the Type.
pub read : Schema e a, Value → Result (List Issue) a
read schema input = readWith schema (defaultOptions ⊤) input


--| `read` with options.
pub readWith : Schema e a, Options, Value → Result (List Issue) a
readWith s o v =
    case (boxOf s).engine of
        Compiled w →
            compiledRun
                o
                w.args
                (parserIn w readMode)
                Decoding
                encodedSide
                True
                typeSide
                False
                (toHost v)

        Interpreted →
            runRoot s o Decoding encodedSide True typeSide False (toHost v)


--| A Type value written as the Encoded endpoint's external form.
pub write : Schema e a, a → Result (List Issue) Value
write schema input = writeWith schema (defaultOptions ⊤) input


--| `write` with options.
pub writeWith : Schema e a, Options, a → Result (List Issue) Value
writeWith s o v =
    case (boxOf s).engine of
        Compiled w →
            compiledRun
                o
                w.args
                (printerIn w writeMode)
                Encoding
                typeSide
                False
                encodedSide
                True
                (toHost v)

        Interpreted →
            runRoot s o Encoding typeSide False encodedSide True (toHost v)


--| JSON text read to the Type.
pub parse : Schema e a, String → Result (List Issue) a
parse schema text = parseWith schema (defaultOptions ⊤) text


--| `parse` with options. `JSON.parse` reports malformed text by throwing a
--| `SyntaxError`, and only that is an answer; anything else it throws goes
--| on as it came (CLAUDE.md rule 9).
pub parseWith : Schema e a, Options, String → Result (List Issue) a
parseWith s o text =
    case (boxOf s).engine of
        Compiled w →
            compiledParse o w.args (parserOf w) text

        Interpreted →
            case rootProblem s o Decoding encodedSide True typeSide False of
                Just issues →
                    Err issues

                Nothing →
                    case
                        Js.catchIf
                            (λ⊤ → Ok (Js.call (Js.global "JSON") "parse" [ Js.from text ]))
                            (λthrown → Js.instanceOf thrown (Js.global "SyntaxError"))
                            λthrown → Err (stringOf (Js.get thrown "message"))
                    of
                        Err message →
                            rootErr Decoding Encoded ParseFailed "invalid JSON: ${message}"

                        Ok v →
                            c = context o Decoding encodedSide True typeSide False True
                            finish c (run c (nodeOf s) 0 atRoot NoneActive v)


--| A Type value printed as JSON text.
pub print : borrowed Schema e a, aliased a → fresh Result (List Issue) String
print schema input = printWith schema (defaultOptions ⊤) input


--| `print` with options.
pub printWith : borrowed Schema e a, Options, aliased a → fresh Result (List Issue) String
printWith s o v =
    case (boxOf s).engine of
        Compiled w →
            compiledPrint o w.args (printerOf w) v

        Interpreted →
            case rootProblem s o Encoding typeSide False encodedSide True of
                Just issues →
                    Err issues

                Nothing →
                    c = context o Encoding typeSide False encodedSide True True
                    x = run c (nodeOf s) 0 atRoot NoneActive (toHost v)
                    if Js.same x c.fail then
                        Err (fromHost c.issues)
                    else
                        Ok (stringOf (Js.call (Js.global "JSON") "stringify" [ x ]))


-- ---- The specialised path ------------------------------------------------
-- What the code a `schema` declaration compiles to calls (`schema.md` §6,
-- *The specialised path, as specified for S4*). None of it is `pub`, so no
-- program can name it; the code generator names each by its symbol in this
-- module, as it names `List`'s core-private values (`backend.md` §4).
--
-- A worker takes the engine's own context, the depth of its value, where
-- the value is — its parent's path and the key or index the parent read it
-- at as the input and as the output name it, both `null` at the root — and
-- the value, and answers what `run` answers: its result, or the context's
-- failure mark. The path itself is made only when something needs it, so a
-- value that fails nothing and holds no record makes none.

-- The path of a value its parent read at `input` (as the output names it,
-- `output`); the parent's own at the root, where both are `null`.
pathAt : Path, Js.Value, Js.Value → Path
pathAt parent input output =
    if Js.isNull input then
        parent
    else
        step parent input output


-- A specialised `parseWith`: the root's checks, `JSON.parse`, the context,
-- then `worker` on what was parsed. `args` are a generic declaration's
-- schema arguments its value reaches, a host array in the order it first
-- meets them.
compiledParse : Options, Js.Value, Js.Value, String → Result (List Issue) a
compiledParse o args worker text =
    case compiledProblem o Decoding encodedSide args of
        Just issues →
            Err issues

        Nothing →
            case
                Js.catchIf
                    (λ⊤ → Ok (Js.call (Js.global "JSON") "parse" [ Js.from text ]))
                    (λthrown → Js.instanceOf thrown (Js.global "SyntaxError"))
                    λthrown → Err (stringOf (Js.get thrown "message"))
            of
                Err message →
                    rootErr Decoding Encoded ParseFailed "invalid JSON: ${message}"

                Ok v →
                    c = context o Decoding encodedSide True typeSide False True
                    finish c (Js.apply worker [ toHost c, Js.from 0, atRoot, Js.null, Js.null, v ])


-- A specialised `printWith`: the root's checks, the context, then `worker`,
-- which answers the host value the engine would write, and one `JSON.stringify`
-- of it, as `printWith` makes.
compiledPrint : Options, Js.Value, Js.Value, a → Result (List Issue) String
compiledPrint o args worker v =
    case compiledProblem o Encoding typeSide args of
        Just issues →
            Err issues

        Nothing →
            c = context o Encoding typeSide False encodedSide True True
            x = Js.apply worker [ toHost c, Js.from 0, atRoot, Js.null, Js.null, toHost v ]
            if Js.same x c.fail then
                Err (fromHost c.issues)
            else
                Ok (stringOf (Js.call (Js.global "JSON") "stringify" [ x ]))


-- A compiled `decodeWith`, `encodeWith`, `readWith` or `writeWith`: the
-- root's checks, the context of `runRoot`'s operation — `src` and `dst` its
-- endpoints, `sh` and `dh` whether each is a host value — then `worker`,
-- which is specialised to those ends.
compiledRun :
      Options
    , Js.Value
    , Js.Value
    , Direction
    , Int
    , Bool
    , Int
    , Bool
    , Js.Value
    → Result (List Issue) b
compiledRun o args worker dir src sh dst dh v =
    case
        if sh || dh then
            compiledProblem o dir src args
        else
            typedProblem o dir src args
    of
        Just issues →
            Err issues

        Nothing →
            c = context o dir src sh dst dh False
            finish c (Js.apply worker [ toHost c, Js.from 0, atRoot, Js.null, Js.null, v ])


-- `compiledProblem` for `decode` and `encode`, which read and write no host
-- value, so that `rootProblem` checks no external form for them: the
-- options, then each schema argument's construction failure.
typedProblem : Options, Direction, Int, Js.Value → Maybe (List Issue)
typedProblem o dir src args =
    case optionsProblem o dir src of
        Just issues →
            Just issues

        Nothing →
            if Js.isNull args then
                Nothing
            else
                dynamic = interpretedIn args
                case argumentProblem dynamic 0 (lengthOf dynamic) of
                    Just problem →
                        Just (rootIssue dir (endpointOf src) InvalidSchema problem)

                    Nothing →
                        Nothing


-- `rootProblem`, for a declaration whose own nodes cannot fail to be built
-- or hide an external form: the options, then each schema argument's
-- construction failure, then an argument whose host end has no external
-- form. `parse` and `read` read a host value, `print` and `write` write one,
-- and either way the host end is the Encoded endpoint.
compiledProblem : Options, Direction, Int, Js.Value → Maybe (List Issue)
compiledProblem o dir src args =
    case optionsProblem o dir src of
        Just issues →
            Just issues

        Nothing →
            -- `null`: a root with no schema argument, such as a nongeneric
            -- declaration's, which has nothing more to check.
            if Js.isNull args then
                Nothing
            else
                dynamic = interpretedIn args
                n = lengthOf dynamic
                case argumentProblem dynamic 0 n of
                    Just problem →
                        Just (rootIssue dir (endpointOf src) InvalidSchema problem)

                    Nothing →
                        if argumentOpaque dynamic 0 n then
                            Just (opaqueIssue dir encodedSide)
                        else
                            Nothing


-- Each argument of `interpretedIn`'s answer is `Interpreted`; the arms say
-- so, so that a build with no such schema keeps no analysis.
argumentProblem : Js.Value, Int, Int → Maybe String
argumentProblem args i n =
    if i ≥ n then
        Nothing
    else
        s : Schema Js.Value Js.Value
        s = fromHost (Js.at args i)
        case (boxOf s).engine of
            Compiled _ →
                argumentProblem args (i + 1) n

            Interpreted →
                case (analyse s).problem of
                    Nothing →
                        argumentProblem args (i + 1) n

                    found →
                        found


argumentOpaque : Js.Value, Int, Int → Bool
argumentOpaque args i n =
    if i ≥ n then
        False
    else
        s : Schema Js.Value Js.Value
        s = fromHost (Js.at args i)
        case (boxOf s).engine of
            Compiled _ →
                argumentOpaque args (i + 1) n

            Interpreted →
                opaqueAt (analyse s) encodedSide || argumentOpaque args (i + 1) n


-- A schema argument as a `parse` worker: its own compiled worker, or the
-- library engine on the context the specialised parent made. One slot
-- maker per operation, so that a build which runs one operation keeps no
-- other's workers (`SchemaGraph.root_guards`).
readSlot : Schema e a → Js.Value
readSlot s =
    case (boxOf s).engine of
        Compiled w →
            parserOf w

        Interpreted →
            interpretedSlot s


-- A schema argument as a `print` worker: the library engine writes the
-- host value, as an encoding worker does.
writeSlot : Schema e a → Js.Value
writeSlot s =
    case (boxOf s).engine of
        Compiled w →
            printerOf w

        Interpreted →
            interpretedSlot s


-- A schema argument as a `decode` worker.
decodeSlot : Schema e a → Js.Value
decodeSlot s =
    case (boxOf s).engine of
        Compiled w →
            parserIn w decodeMode

        Interpreted →
            interpretedSlot s


-- A schema argument as an `encode` worker.
encodeSlot : Schema e a → Js.Value
encodeSlot s =
    case (boxOf s).engine of
        Compiled w →
            printerIn w encodeMode

        Interpreted →
            interpretedSlot s


-- A schema argument as a `read` worker.
readValueSlot : Schema e a → Js.Value
readValueSlot s =
    case (boxOf s).engine of
        Compiled w →
            parserIn w readMode

        Interpreted →
            interpretedSlot s


-- A schema argument as a validator's worker: a compiled one's validator,
-- and the library engine on the context for a dynamic one.
readValidSlot : Schema e a → Js.Value
readValidSlot s =
    case (boxOf s).engine of
        Compiled w →
            parserIn w validMode

        Interpreted →
            interpretedSlot s


-- `read` at a call whose `Err` payload nothing reads (`schema.md` §6, *A run
-- whose failure is never read is a validator*): the compiler calls this in
-- its place. A compiled schema runs its validator workers, which make no
-- issue, and fails with none; a schema with a dynamic part — the library's
-- to run, or a dynamic argument that may fail to be built — runs as `read`
-- runs, which only a program that builds such a schema reaches.
readValid : Schema e a, Value → Result (List Issue) a
readValid s v =
    case (boxOf s).engine of
        Compiled w →
            -- An argument with a dynamic part is the library's to run.
            case firstDynamic w.args of
                Just _ →
                    read s v

                Nothing →
                    validate w v

        Interpreted →
            read s v


validate : Workers, Value → Result (List Issue) a
validate w v = validRun (parserIn w validMode) v


-- A validator worker run on a host value, its context `read`'s: what a run
-- whose schema is `S.schema ⊤` of a nongeneric declaration calls with `S`'s
-- validator, the schema value never made (`schema.md` §6).
validRun : Js.Value, Value → Result (List Issue) a
validRun worker v =
    c = context (defaultOptions ⊤) Decoding encodedSide True typeSide False False
    x = Js.apply worker [ toHost c, Js.from 0, atRoot, Js.null, Js.null, toHost v ]
    if Js.same x c.fail then Err [] else Ok (fromHost x)


-- `parse` at a call whose `Err` payload nothing reads, its schema `S.schema ⊤`
-- of a nongeneric declaration (`schema.md` §6): `JSON.parse`, only its
-- `SyntaxError` caught, then `S`'s validator worker on `read`'s context,
-- which holds for what `JSON.parse` makes as for any host value. That
-- context's `json` is False where `parse`'s is True, which no decoding run
-- can tell: `json` is read only together with `dh`, a host output, by the
-- `Float` and `Value` tests of what `print` may write, and a decoding
-- context's `dh` is False (`prim`).
validParse : Js.Value, String → Result (List Issue) a
validParse worker text =
    case
        Js.catchIf
            (λ⊤ → Ok (Js.call (Js.global "JSON") "parse" [ Js.from text ]))
            (λthrown → Js.instanceOf thrown (Js.global "SyntaxError"))
            λ_ → Err ⊤
    of
        Ok v →
            validRun worker (fromHost v)

        Err _ →
            Err []


-- ---- Shapes: the one validator every shape run shares ---------------------
--
-- `schema.md` §6, *A validator run is a shape that one shared validator
-- reads*. A run whose error nothing reads, over a schema the compiler can
-- write as a shape, calls `validShape` or `shapeParse` with the schema's
-- shape in place of the schema. A shape names the reader of each of its
-- nodes, so a build ships the readers of the kinds its shapes hold and no
-- other. Each reader answers what the specialised `read` answers for the
-- same node — the typed value, or `shapeFail` where `read` fails — and makes
-- no issue.

-- `read` of a shape at a call whose error nothing reads.
validShape : Js.Value, Value → Result (List Issue) a
validShape shape v =
    x = shapeRun shape (toHost v) 0
    if Js.same x shapeFail then Err [] else Ok (fromHost x)


-- `parse` of a shape at a call whose error nothing reads: `JSON.parse`,
-- only its `SyntaxError` caught, then the shape.
shapeParse : Js.Value, String → Result (List Issue) a
shapeParse shape text =
    case
        Js.catchIf
            (λ⊤ → Ok (Js.call (Js.global "JSON") "parse" [ Js.from text ]))
            (λthrown → Js.instanceOf thrown (Js.global "SyntaxError"))
            λ_ → Err ⊤
    of
        Ok v →
            validShape shape (fromHost v)

        Err _ →
            Err []


-- What every reader answers where `read` fails: no value a reader makes or
-- returns is this array.
shapeFail : Js.Value
shapeFail = Js.array []


-- The default options' depth bound, which every shape run reads under.
shapeMax : Int
shapeMax = defaultMaxDepth


-- Shape `s` read on `x` at depth `depth`: a primitive's reader, or the
-- reader an array names first.
shapeRun : Js.Value, Js.Value, Int → Js.Value
shapeRun s x depth =
    if Js.typeIs s "function" then
        Js.apply s [ x ]
    else
        Js.apply (Js.at s 0) [ s, x, Js.from depth ]


shapeString : Js.Value → Js.Value
shapeString x = if Js.typeIs x "string" then x else shapeFail


shapeBool : Js.Value → Js.Value
shapeBool x = if Js.typeIs x "boolean" then x else shapeFail


-- `Number.isSafeInteger` and `Number.isFinite` answer false for anything
-- that is not a number.
shapeInt : Js.Value → Js.Value
shapeInt x = if Js.to (Js.call (Js.global "Number") "isSafeInteger" [ x ]) then x else shapeFail


shapeFloat : Js.Value → Js.Value
shapeFloat x = if Js.typeIs x "number" then x else shapeFail


shapeFinite : Js.Value → Js.Value
shapeFinite x = if isFinite x then x else shapeFail


shapeNull : Js.Value → Js.Value
shapeNull x = if Js.isNull x then toHost Null else shapeFail


shapeValue : Js.Value → Js.Value
shapeValue x = x


shapeChar : Js.Value → Js.Value
shapeChar x =
    if Js.typeIs x "string" && lengthOf (Js.call (Js.global "Array") "from" [ x ]) == 1 then
        x
    else
        shapeFail


shapeInt32 : Js.Value → Js.Value
shapeInt32 x = if Js.typeIs x "number" && Js.bitOr (intOf x) 0 == intOf x then x else shapeFail


shapeNever : Js.Value → Js.Value
shapeNever _ = shapeFail


-- Object `x`'s key `k`, read once, as every reading runner reads it
-- (`present`): `undefined` when it is absent — and a name `prototypeKey`
-- lists, which must be `x`'s own, is not read unless it is. Only the
-- `…Own` readers ask: the compiler gives a record or a union one of them
-- exactly when one of its keys is such a name, so a program none of whose
-- keys is ships no list of names.
shapeKey : Js.Value, String → Js.Value
shapeKey x k =
    if prototypeKey k then
        if hasOwn x k then Js.get x k else Js.undefined
    else
        Js.get x k


-- `[shapeRecord, order, entry₁, …]`: a record. Its entries are in the
-- canonical order of a record literal's keys, each `[key, shape]`,
-- `[key, shape, 1]` (optional), `[key, shape, 2]` (a `Maybe` field) or
-- `[key, shape, flag, name]` (a field whose name is not its key); `order` is
-- `0`, or the entries' places in the declaration's order. Each key is read
-- once, in the declaration's order, and the values are copied into a fresh
-- record by the fields' names in the canonical order: the host object is
-- never kept.
shapeRecord : Js.Value, Js.Value, Int → Js.Value
shapeRecord s x depth = if isObject x then shapeRecordRead False s x depth else shapeFail


-- `[shapeRecordOwn, order, entry₁, …]`: a record one of whose keys is a name
-- `Object.prototype` holds, each key present as `present` tests it.
shapeRecordOwn : Js.Value, Js.Value, Int → Js.Value
shapeRecordOwn s x depth = if isObject x then shapeRecordRead True s x depth else shapeFail


shapeRecordRead : Bool, Js.Value, Js.Value, Int → Js.Value
shapeRecordRead own s x depth =
    n = lengthOf s - 2
    order = Js.at s 1
    values = Js.array []
    if shapeFieldsFrom own s order 0 n x depth values then
        shapeFail
    else
        shapeCopy s values 0 n (Js.object [])


-- The `j`th field to read on: entry `order[j]`, or `j` when `order` is
-- `0`, its value set at its entry's place in `values`. True when one fails.
shapeFieldsFrom : Bool, Js.Value, Js.Value, Int, Int, Js.Value, Int, Js.Value → Bool
shapeFieldsFrom own s order j n x depth values =
    if j ≥ n then
        False
    else
        i = if Js.same order (Js.from 0) then j else intOf (Js.at order j)
        entry = Js.at s (i + 2)
        k = stringOf (Js.at entry 0)
        -- Each key read once, as the workers read it: a name `prototypeKey`
        -- lists only when it is `x`'s own, any other with `undefined` absent.
        y =
            if own && prototypeKey k then
                if hasOwn x k then
                    shapeEntry entry True (Js.get x k) depth
                else
                    shapeEntry entry False Js.undefined depth
            else
                v = Js.get x k
                shapeEntry entry (not (Js.isUndefined v)) v depth
        if Js.same y shapeFail then
            True
        else
            Js.setAt values i y
            shapeFieldsFrom own s order (j + 1) n x depth values


-- The fresh record: each entry's name — its key, or its fourth element —
-- set to its value, in the entries' order, which is the canonical one.
shapeCopy : Js.Value, Js.Value, Int, Int, Js.Value → Js.Value
shapeCopy s values i n out =
    if i ≥ n then
        out
    else
        entry = Js.at s (i + 2)
        name = if lengthOf entry > 3 then Js.at entry 3 else Js.at entry 0
        Js.set out (stringOf name) (Js.at values i)
        shapeCopy s values (i + 1) n out


-- One field: absent, a required one fails, an optional one is `Missing` and
-- a `Maybe` field `Nothing`; present, its value one level down.
shapeEntry : Js.Value, Bool, Js.Value, Int → Js.Value
shapeEntry entry held v depth =
    flag = if lengthOf entry == 2 then 0 else intOf (Js.at entry 2)
    if not held then
        if flag == 0 then shapeFail else if flag == 2 then toHost Nothing else toHost Missing
    else if depth ≥ shapeMax then
        shapeFail
    else
        y = shapeRun (Js.at entry 1) v (depth + 1)
        if flag ≠ 1 || Js.same y shapeFail then y else toHost (Present y)


-- `[shapeList, s]`: a fresh array, each element one level down.
shapeList : Js.Value, Js.Value, Int → Js.Value
shapeList s x depth =
    if isArray x then
        shapeListFrom (Js.at s 1) x 0 (lengthOf x) depth (Js.array [])
    else
        shapeFail


shapeListFrom : Js.Value, Js.Value, Int, Int, Int, Js.Value → Js.Value
shapeListFrom s x i n depth out =
    if i ≥ n then
        out
    else if depth ≥ shapeMax then
        shapeFail
    else
        y = shapeRun s (Js.at x i) (depth + 1)
        if Js.same y shapeFail then
            shapeFail
        else
            Js.to (Js.call out "push" [ y ])
            shapeListFrom s x (i + 1) n depth out


-- `[shapeNullable, s]`: `null` is `Null`, anything else `s`'s in `NonNull`.
shapeNullable : Js.Value, Js.Value, Int → Js.Value
shapeNullable s x depth =
    if Js.isNull x then
        toHost Null
    else
        y = shapeRun (Js.at s 1) x depth
        if Js.same y shapeFail then shapeFail else toHost (NonNull y)


-- `[shapeMaybe, s]`: `null` is `Nothing`, anything else `s`'s in `Just`.
shapeMaybe : Js.Value, Js.Value, Int → Js.Value
shapeMaybe s x depth = if Js.isNull x then toHost Nothing else shapeJust s x depth


-- `[shapeJust, s]`: `s`'s answer in `Just`, `s` reading `null` itself.
shapeJust : Js.Value, Js.Value, Int → Js.Value
shapeJust s x depth =
    y = shapeRun (Js.at s 1) x depth
    if Js.same y shapeFail then shapeFail else toHost (Just y)


-- `[shapeLater, f]`: the shape `f` answers, a definition in a reference
-- cycle with the one that names it.
shapeLater : Js.Value, Js.Value, Int → Js.Value
shapeLater s x depth = shapeRun (Js.apply (Js.at s 1) []) x depth


-- `[shapeTuple, s₁, …]`: an array of exactly that many, each element one
-- level down, as §4's tuple; `⊤`'s `null` for none.
shapeTuple : Js.Value, Js.Value, Int → Js.Value
shapeTuple s x depth =
    n = lengthOf s - 1
    if not (isArray x) || lengthOf x ≠ n then
        shapeFail
    else if n == 0 then
        Js.null
    else
        shapeTupleFrom s x 0 n depth (Js.object [])


shapeTupleFrom : Js.Value, Js.Value, Int, Int, Int, Js.Value → Js.Value
shapeTupleFrom s x i n depth out =
    if i ≥ n then
        out
    else if depth ≥ shapeMax then
        shapeFail
    else
        y = shapeRun (Js.at s (i + 1)) (Js.at x i) (depth + 1)
        if Js.same y shapeFail then
            shapeFail
        else
            Js.set out (slotOf i) y
            shapeTupleFrom s x (i + 1) n depth out


-- The name of a tuple's `i`th slot, as `backend.md` §4 spells it.
slotOf : Int → String
slotOf i =
    if i < 26 then
        stringOf (Js.call (Js.global "String") "fromCharCode" [ Js.from (97 + i) ])
    else
        "a${String.fromInt i}"


-- `[shapeTagged, discriminator, tag₁, v₁, …]`: the discriminator read as a
-- field is, then the variant whose tag it is: a nullary one's value, or the
-- record shape of its payload, one level down, whose `make` builds the
-- variant.
shapeTagged : Js.Value, Js.Value, Int → Js.Value
shapeTagged s x depth =
    if isObject x then shapeVariant s (Js.get x (stringOf (Js.at s 1))) x depth 2 else shapeFail


-- `[shapeTaggedOwn, discriminator, …]`: a union whose discriminator is a
-- name `Object.prototype` holds, read as `present` reads it.
shapeTaggedOwn : Js.Value, Js.Value, Int → Js.Value
shapeTaggedOwn s x depth =
    if isObject x then shapeVariant s (shapeKey x (stringOf (Js.at s 1))) x depth 2 else shapeFail


-- The variant whose tag, among every other element of `s` from the `i`th,
-- is `===` to `tag`: a nullary one's value, or its payload's record shape
-- one level down; `shapeFail` when none is.
shapeVariant : Js.Value, Js.Value, Js.Value, Int, Int → Js.Value
shapeVariant s tag x depth i =
    if i ≥ lengthOf s then
        shapeFail
    else if Js.same (Js.at s i) tag then
        v = Js.at s (i + 1)
        if not (isArray v) then
            v
        else if depth ≥ shapeMax then
            shapeFail
        else
            payload = shapeRun (Js.at v 1) x (depth + 1)
            if Js.same payload shapeFail then
                shapeFail
            else
                Js.object [ ( "$", Js.at v 0 ), ( "a", payload ) ]
    else
        shapeVariant s tag x depth (i + 2)


-- The position of the name `===` to `k` among `s`'s, every other element
-- from `i` on; −1 when none is.
shapeFind : Js.Value, Js.Value, Int, Int → Int
shapeFind s k i n =
    if i ≥ n then
        -1
    else if Js.same (Js.at s i) k then
        i
    else
        shapeFind s k (i + 2) n


-- `[shapeCtors, name₁, c₁, …]`: a custom type in Roc's form (§12.3). A
-- nullary constructor is its name, and its `c` its value; one that takes
-- arguments is an object of one key, its name, and its `c` `[make, s₁, …]`.
shapeCtors : Js.Value, Js.Value, Int → Js.Value
shapeCtors s x depth =
    n = lengthOf s
    if Js.typeIs x "string" then
        i = shapeFind s x 1 n
        if i < 0 || isArray (Js.at s (i + 1)) then shapeFail else Js.at s (i + 1)
    else if isObject x then
        keys = Js.call (Js.global "Object") "keys" [ x ]
        if lengthOf keys ≠ 1 then
            shapeFail
        else
            k = Js.at keys 0
            i = shapeFind s k 1 n
            if i < 0 || not (isArray (Js.at s (i + 1))) || depth ≥ shapeMax then
                shapeFail
            else
                shapeArgs (Js.at s (i + 1)) (Js.get x (stringOf k)) depth
    else
        shapeFail


-- A constructor's arguments, below its name at `depth + 1`: the one
-- argument itself, or an array of exactly as many, one level further down.
shapeArgs : Js.Value, Js.Value, Int → Js.Value
shapeArgs c payload depth =
    arity = lengthOf c - 1
    if arity == 1 then
        y = shapeRun (Js.at c 1) payload (depth + 1)
        if Js.same y shapeFail then shapeFail else Js.apply (Js.at c 0) [ y ]
    else if not (isArray payload) || lengthOf payload ≠ arity then
        shapeFail
    else
        ys = shapeArgsFrom c payload 0 arity (depth + 1) (Js.array [])
        if Js.same ys shapeFail then shapeFail else Js.call (Js.at c 0) "apply" [ Js.null, ys ]


shapeArgsFrom : Js.Value, Js.Value, Int, Int, Int, Js.Value → Js.Value
shapeArgsFrom c payload i n depth out =
    if i ≥ n then
        out
    else if depth ≥ shapeMax then
        shapeFail
    else
        y = shapeRun (Js.at c (i + 1)) (Js.at payload i) (depth + 1)
        if Js.same y shapeFail then
            shapeFail
        else
            Js.to (Js.call out "push" [ y ])
            shapeArgsFrom c payload (i + 1) n depth out


-- The first schema argument of a compiled root's that has a dynamic part,
-- as `interpretedIn` finds them.
firstDynamic : Js.Value → Maybe (Schema Js.Value Js.Value)
firstDynamic args =
    if Js.isNull args then
        Nothing
    else
        dynamic = interpretedIn args
        if lengthOf dynamic == 0 then Nothing else Just (fromHost (Js.at dynamic 0))


-- A schema argument as a `write` worker.
writeValueSlot : Schema e a → Js.Value
writeValueSlot s =
    case (boxOf s).engine of
        Compiled w →
            printerIn w writeMode

        Interpreted →
            interpretedSlot s


-- The library engine as a worker of any operation: `run` reads the ends
-- from the context.
interpretedSlot : Schema e a → Js.Value
interpretedSlot s =
    n = nodeOf s
    slot : Context, Int, Path, Js.Value, Js.Value, Js.Value → Js.Value
    slot c depth parent input output v = run c n depth (pathAt parent input output) NoneActive v
    toHost slot


-- An issue with code `code`, its number in `IssueCode`'s declaration order,
-- at the value its parent read at `input`: a specialised failure branch's
-- one call.
compiledFail : Context, Path, Js.Value, Js.Value, Int, String, Js.Value, Bool → Js.Value
compiledFail c parent input output code message v written =
    failAt c (pathAt parent input output) (fromHost (Js.at issueCodes code)) message v written


-- ---- Validators shared across schemas ------------------------------------
-- What a worker calls in place of a branch it would otherwise write, where
-- the build shares it (`schema.md` §6, *Validators shared across schemas*;
-- `SchemaShare`). Each answers what the branch answers, issue for issue.

-- The depth bound, reached before a descent into the value its parent read
-- at `input`: `compiledFail` with the code and message fixed.
compiledDeep : Context, Path, Js.Value, Js.Value, Js.Value → Js.Value
compiledDeep c parent input output v =
    compiledFail c parent input output 5 "the depth limit is reached" v False


-- A missing key, its message made from the key the input names it by.
compiledMissing : Context, Path, Js.Value, Js.Value, Js.Value → Js.Value
compiledMissing c parent input output v =
    compiledFail c parent input output 1 "missing key \"${stringOf input}\"" v False


-- Why a required field of an object `JSON.parse` made failed its read, as
-- the branch the worker would write reports it: the key absent (its value
-- `x` is `undefined`, `SchemaLower`'s `readsByValue`), the depth bound, then
-- the primitive's own tests, in `prim`'s order. The worker writes the tests
-- in place, one condition on the success path, and calls this only when one
-- failed, so the shared part is the cold one: a helper that makes a known
-- issue, interpreting nothing. The key is both segments of the path: what a
-- decoding failure reports is the input's.
badString : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badString c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a string"
            x
            False


badBool : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badBool c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a boolean"
            x
            False


badFloat : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badFloat c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


-- An `Int` and a `FiniteFloat` fail one of two tests: not a number at all,
-- or a number out of range.
badInt : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badInt c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else if isType x "number" then
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            4
            "expected a safe integer"
            x
            False
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


badFinite : Context, Path, Js.Value, Js.Value, Js.Value, Js.Value, String, Bool → Js.Value
badFinite c p k n v x external deep =
    if Js.isUndefined x then
        compiledMissing c (pathAt p k n) (Js.from external) (Js.from external) v
    else if deep then
        compiledDeep c (pathAt p k n) (Js.from external) (Js.from external) x
    else if isType x "number" then
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            4
            "expected a finite number"
            x
            False
    else
        compiledFail
            c
            (pathAt p k n)
            (Js.from external)
            (Js.from external)
            0
            "expected a number"
            x
            False


-- `IssueCode`'s constructors, a host array in declaration order.
issueCodes : Js.Value
issueCodes =
    plain
        (toHost
            [ WrongShape
            , MissingKey
            , UnknownKey
            , UnknownTag
            , InvalidValue
            , DepthExceeded
            , InvalidOptions
            , ConversionFailed
            , CheckFailed
            , ParseFailed
            , PrintFailed
            , InvalidSchema
            ]
        )


-- A `via`'s decoding direction on the value its parent read at `input`:
-- `call`, with the path made only when the conversion fails.
compiledForward : Context, Path, Js.Value, Js.Value, Conversion b a, Js.Value → Js.Value
compiledForward c parent input output conv v =
    p : Pair
    p = cast conv
    conversionAnswer (Js.apply p.there [ v ]) c parent input output v


-- A `via`'s encoding direction.
compiledBackward : Context, Path, Js.Value, Js.Value, Conversion b a, Js.Value → Js.Value
compiledBackward c parent input output conv v =
    p : Pair
    p = cast conv
    conversionAnswer (Js.apply p.back [ v ]) c parent input output v


conversionAnswer : Js.Value, Context, Path, Js.Value, Js.Value, Js.Value → Js.Value
conversionAnswer answer c parent input output v =
    case resultOf answer of
        Ok a →
            a

        Err given →
            moved c (pathArray (pathAt parent input output) False) v given
            c.fail


-- The context below an encoding conversion, where a failure is in what the
-- operation writes (`run`'s `NConverted`).
belowBackward : Context → Context
belowBackward c =
    if c.cv then
        c
    else
        { Record.copy c | cv = True }


-- Whether a `Value` prints as JSON within the depth left: `printable`'s
-- answer, for an encoding worker's `Value`.
printableWithin : Context, Int, Js.Value → Int
printableWithin c depth v = printable v (c.max - depth)


-- ---- Descriptions --------------------------------------------------------

--| The schema's graph, both endpoints, as plain data. It runs no
--| conversion; it builds a recursive schema's body if no run has yet.
pub describe : Schema e a → Description
describe s =
    ids = Js.construct (Js.global "Map") []
    definitions = Js.array []
    root = shapeOf ids definitions (nodeOf s)
    _ = Js.call definitions "sort" [ toHost byId ]
    { root = root, definitions = fromHost definitions }


byId : Definition, Definition → Int
byId x y = x.id - y.id


-- `ids` maps a definition to its number in this description, in the order
-- it was first met; `definitions` collects each once its body is described.
shapeOf : Js.Value, Js.Value, Node → Shape
shapeOf ids definitions n =
    case n of
        NPrim k →
            Primitive k

        NList child →
            ListOf (shapeOf ids definitions child)

        NNullable child →
            NullableOf (shapeOf ids definitions child)

        NRecord fs _ →
            RecordOf
                (List.map (fieldList fs) λf →
                    { name = f.name
                    , key = f.key
                    , optional = f.optional
                    , shape = shapeOf ids definitions f.node
                    }
                )

        NTagged discriminator vs →
            TaggedOf
                discriminator
                (List.map (variantList vs) λv →
                    { name = v.name
                    , payload = Maybe.map v.payload (shapeOf ids definitions _)
                    , tag = v.tag
                    }
                )

        NConverted child _ _ →
            Converted (shapeOf ids definitions child)

        NFlipped child →
            Flipped (shapeOf ids definitions child)

        NProjected side child →
            if side == typeSide then
                TypeOnly (shapeOf ids definitions child)
            else
                EncodedOnly (shapeOf ids definitions child)

        NRef cell →
            known = Js.call ids "get" [ toHost cell ]
            if not (Js.isUndefined known) then
                Reference (intOf known)
            else
                id = intOf (Js.get ids "size")
                _ = Js.call ids "set" [ toHost cell, Js.from id ]
                shape =
                    case resolve cell of
                        Nothing →
                            Invalid (dangling cell)

                        Just body →
                            shapeOf ids definitions body
                definition : Definition
                definition = { id = id, name = cell.name, shape = shape }
                push definitions (toHost definition)
                Reference id

        NBroken problem →
            Invalid problem

        NTuple items _ →
            TupleOf (shapesOf ids definitions items)

        NCtors cs →
            ConstructorsOf
                (List.map (ctorList cs) λk →
                    { name = k.name, arguments = shapesOf ids definitions k.nodes }
                )

        NMaybe child _ →
            MaybeOf (shapeOf ids definitions child)

        NHost inner →
            shapeOf ids definitions inner


shapesOf : Js.Value, Js.Value, Js.Value → List Shape
shapesOf ids definitions items = List.map (fromHost items) λx → shapeOf ids definitions (fromHost x)


ctorList : Js.Value → List CtorNode
ctorList cs = fromHost cs
