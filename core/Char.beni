--! Functions for working with characters. Character literals are enclosed in
--! `'a'` pairs of single quotes, and hold exactly one Unicode scalar value.
--!
--! Four declarations are `foreign`, and everything else is written over
--! `toCode`:
--!
--!   - `toCode` `fromCode` — the character/number boundary, which is the
--!     platform's representation.
--!   - `toUpper` `toLower` — Unicode case mapping, which is a table nobody
--!     wants to carry in beni source.
--!
--! The classification functions are ASCII, exactly as Elm's are.

--| Convert to the corresponding Unicode code point.
--|
--|     toCode 'A' == 0x41
--|     toCode 'π' == 0x03C0
pub foreign toCode : Char -> Int


--| Convert a Unicode code point to a character.
--|
--|     fromCode 0x41 == 'A'
pub foreign fromCode : Int -> Char


--| Convert to upper case.
--|
--|     toUpper 'a' == 'A'
pub foreign toUpper : Char -> Char


--| Convert to lower case.
--|
--|     toLower 'A' == 'a'
pub foreign toLower : Char -> Char


--| Detect upper case ASCII characters.
--|
--|     isUpper 'A' == True
--|     isUpper 'a' == False
pub isUpper : Char -> Bool
isUpper char =
    let
        code =
            toCode char
    in
    code <= 0x5A && 0x41 <= code


--| Detect lower case ASCII characters.
--|
--|     isLower 'a' == True
--|     isLower 'A' == False
pub isLower : Char -> Bool
isLower char =
    let
        code =
            toCode char
    in
    0x61 <= code && code <= 0x7A


--| Detect upper case and lower case ASCII characters.
--|
--|     isAlpha 'a' == True
--|     isAlpha '0' == False
pub isAlpha : Char -> Bool
isAlpha char =
    isLower char || isUpper char


--| Detect upper case and lower case ASCII characters and ASCII digits.
--|
--|     isAlphaNum 'a' == True
--|     isAlphaNum '-' == False
pub isAlphaNum : Char -> Bool
isAlphaNum char =
    isLower char || isUpper char || isDigit char


--| Detect digits `0123456789`.
--|
--|     isDigit '0' == True
--|     isDigit 'a' == False
pub isDigit : Char -> Bool
isDigit char =
    let
        code =
            toCode char
    in
    code <= 0x39 && 0x30 <= code


--| Detect octal digits `01234567`.
--|
--|     isOctDigit '7' == True
--|     isOctDigit '8' == False
pub isOctDigit : Char -> Bool
isOctDigit char =
    let
        code =
            toCode char
    in
    code <= 0x37 && 0x30 <= code


--| Detect hexadecimal digits `0123456789abcdefABCDEF`.
--|
--|     isHexDigit 'f' == True
--|     isHexDigit 'g' == False
pub isHexDigit : Char -> Bool
isHexDigit char =
    let
        code =
            toCode char
    in
    (0x30 <= code && code <= 0x39)
        || (0x41 <= code && code <= 0x46)
        || (0x61 <= code && code <= 0x66)
