--! What time it is, and a clock a test can move by hand
--! (`transparent-effects-proposal.md` §17.6): Effect's `Clock` and
--! `TestClock`.
--!
--! Every fiber has a clock. It is the real one unless the fiber runs inside
--! `Clock.run`, which gives the function it runs — and every fiber that
--! function starts — a **virtual** clock: one that reads whatever it was
--! set to, and moves only when `Clock.adjust` moves it. `Task.sleep` waits
--! on the calling fiber's clock, so code that sleeps can be tested without
--! waiting:
--!
--!     clock = Clock.virtual 0
--!     worker = Task.spawn λ⊤ → Clock.run clock λ⊤ →
--!         _ = Task.sleep (Duration.seconds 30)
--!         Log.info "half a minute later"
--!     _ = Clock.adjust clock (Duration.seconds 30)
--!     Task.join worker
--!
--! What a program observes on a virtual clock depends on the program
--! alone: sleepers wake in the order of their wake times, and of the order
--! they began to sleep among equal ones, and `adjust` lets everything they
--! wake run as far as it can before it wakes the next.
--!
--! A virtual clock reads an `Int`, so its last reading is 9007199254740991,
--! 2⁵³ − 1. `adjust` answers a `Result`: an `Err` when the clock cannot move
--! that far, and then no sleeper wakes. The `_ =` above says that this test
--! does not look at it. A sleep that ends after the last reading never
--! wakes: the clock cannot read that time.
--!
--! Nothing here is `foreign`.

import Duration exposing (Duration)
import Js
import Task


--| A clock that moves only when `adjust` moves it.
pub opaque type Virtual
    = Virtual Js.Value


--| The milliseconds since the Unix epoch, on the calling fiber's clock: the
--| host's `Date.now()` on the real clock, the reading of a virtual one
--| inside `run`.
pub now : ⊤ → Int
now ⊤ =
    clock = Task.currentClock ⊤

    if Js.isUndefined clock then
        Js.to (Js.call (Js.global "Date") "now" [])
    else
        Js.to (Js.get clock "now")


--| The milliseconds, with a fraction, since a start that the host chooses,
--| on the calling fiber's clock: the host's `performance.now()` on the real
--| clock, the reading of a virtual one inside `run`. It never goes back, so
--| the difference of two readings is how long the work between them took.
--| The start is not the epoch: compare a reading only with another reading
--| of the same clock in the same program.
pub elapsed : ⊤ → Float
elapsed ⊤ =
    clock = Task.currentClock ⊤

    if Js.isUndefined clock then
        latest = max (Js.to (Js.call (Js.global "performance") "now" [])) (Js.read highest)
        Js.write highest latest
        latest
    else
        Js.to (Js.get clock "now")


-- The highest reading `elapsed` gave on the real clock. A host's reading
-- can go back: workerd's `performance.now()` is its `Date.now()`, which
-- has no floor when precise timers are on. So `elapsed` never gives less
-- than this (transparent-effects-proposal.md §17.6, amended 2026-11-05).
highest : Js.Ref Float
highest = Js.ref 0


--| A new virtual clock reading `epoch` milliseconds, with nothing waiting
--| on it. Two clocks are independent.
pub virtual : Int → Virtual
virtual epoch = Virtual (Task.virtualClock (Js.from epoch))


--| Run `work` on the virtual clock: `work`, and every fiber it starts —
--| and every fiber those start — sleep on it and read it. A fiber started
--| inside keeps it after `run` returns.
pub run : Virtual, (⊤ → a) → a
run (Virtual clock) work = Task.withClock clock work


--| Why `adjust` did not move a clock.
--|
--| `TooFar left`: the new reading would be past 9007199254740991, the last
--| millisecond an `Int` holds. `left` is how far the clock can still move,
--| so `adjust clock left` moves it to its last reading.
pub type AdjustError
    = TooFar Duration


--| Move the clock forward by `duration`, and return once everything that
--| woke has run as far as it can. Every fiber due by the new reading is
--| woken, in the order of its wake time, the clock reading that time when
--| it wakes — so one woken that sleeps again, and is due by the new
--| reading, wakes in the same `adjust`. Time never goes back; `zero`
--| changes nothing.
--|
--| `Err (TooFar left)` when the new reading would be past the last
--| millisecond an `Int` holds. The clock then keeps its reading and its
--| sleepers, and no sleeper wakes. The fibers that were ready still run
--| first, as in every `adjust` but one of `zero`.
--|
--|     -- 5 ms before the last reading: Err (Clock.TooFar (Duration.millis 5))
--|     clock = Clock.virtual 9007199254740986
--|     Clock.adjust clock (Duration.millis 6)
--|
--| Called from the fiber that drives the test, outside `run`: it waits for
--| the others.
pub adjust : Virtual, Duration → Result AdjustError ⊤
adjust (Virtual clock) duration =
    Result.mapError (Task.adjustClock clock (Js.from (Duration.toMillis duration))) λleft →
        TooFar (Duration.millis left)
