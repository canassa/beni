--! A set of unique values. The values can be any type that has a `compare`
--! method, and that method is what arranges them, exactly as it is for
--! `Dict`: a `where` clause on each function that has to look a value up
--! says so, and the set itself carries nothing but its dictionary.
--!
--!     names : Set String
--!     names =
--!         Set.fromList [ "Alice", "Bob" ]
--!
--! Argument order here is **subject first and function last**, as it is
--! everywhere in core: the set comes first, so `names ▷ Set.insert "Carol"`
--! is `Set.insert names "Carol"` — `▷` is pipe-first, it inserts its left
--! operand as the callee's first argument. A function argument comes last, so
--! a lambda you write inline is the final one, and `map` now has only the
--! one to place.
--!
--! Insert, remove and query take *O(log n)* time. A `Set` is a `Dict` whose
--! values are all `⊤`, which is how Elm builds it too.
--!
--! Nothing here is `foreign`.

import Dict exposing (Dict)
import List


--| Represents a set of unique values. So `Set Int` is a set of integers and
--| `Set String` is a set of strings.
pub opaque type Set t
    = Set (Dict t ⊤)


--| The empty set. It compares nothing, so it needs no `compare` and is a
--| constant rather than a function.
--|
--|     Set.empty
pub empty : Set t
empty = Set Dict.empty


--| Create a set with one value. One value needs no ordering either, so this
--| one is unconstrained too.
--|
--|     Set.singleton "Tom"
pub singleton : t → Set t
singleton value = Set (Dict.singleton value ⊤)


--| Insert a value into a set.
--|
--|     Set.insert Set.empty "Tom"
pub insert : Set t, t → Set t
    where t.compare : t, t → Order
insert (Set dict) value = Set (Dict.insert dict value ⊤)


--| Remove a value from a set. If the value is not found, no changes are made.
--|
--|     Set.remove names "Tom"
pub remove : Set t, t → Set t
    where t.compare : t, t → Order
remove (Set dict) value = Set (Dict.remove dict value)


--| Determine if a set is empty.
--|
--|     isEmpty empty == True
pub isEmpty : Set t → Bool
isEmpty (Set dict) = Dict.isEmpty dict


--| Determine if a value is in a set.
--|
--|     member (fromList [ "Alice", "Bob" ]) "Alice" == True
--|     member (fromList [ "Alice", "Bob" ]) "Carol" == False
pub member : Set t, t → Bool
    where t.compare : t, t → Order
member (Set dict) value = Dict.member dict value


--| Determine the number of elements in a set.
pub size : Set t → Int
size (Set dict) = Dict.size dict


--| Get the union of two sets. Keep all values.
pub union : Set t, Set t → Set t
    where t.compare : t, t → Order
union (Set d1) (Set d2) = Set (Dict.union d1 d2)


--| Get the intersection of two sets. Keeps values that appear in both sets.
pub intersect : Set t, Set t → Set t
    where t.compare : t, t → Order
intersect (Set d1) (Set d2) = Set (Dict.intersect d1 d2)


--| Get the difference between the first set and the second. Keeps values
--| that do not appear in the second set.
pub diff : Set t, Set t → Set t
    where t.compare : t, t → Order
diff (Set d1) (Set d2) = Set (Dict.diff d1 d2)


--| Convert a set into a list, sorted from lowest to highest.
pub toList : Set t → List t
toList (Set dict) = Dict.keys dict


--| Convert a list into a set, removing any duplicates. The values are
--| ordered by their own `compare`.
--|
--|     Set.fromList [ "a", "b", "a" ]
pub fromList : List t → Set t
    where t.compare : t, t → Order
fromList list = List.foldl list empty λvalue set → insert set value


--| Map a function onto a set, creating a new set with no duplicates. The
--| result holds values of a NEW type, so the constraint is on that type's
--| `compare` and not on the one the set came in with.
--|
--|     Set.map names String.length
pub map : Set a, (a → b) → Set b
    where b.compare : b, b → Order
map set func = fromList (List.map (toList set) func)


--| Fold over the values in a set, in order from lowest to highest.
--|
--|     Set.foldl numbers 0 λn total → n + total
pub foldl : Set t, b, (t, b → b) → b
foldl (Set dict) initial func = Dict.foldl dict initial λkey _ acc → func key acc


--| Fold over the values in a set, in order from highest to lowest.
--|
--|     foldr (fromList [ "b", "a" ]) [] (λname acc → [ name, …acc ]) == [ "a", "b" ]
pub foldr : Set t, b, (t, b → b) → b
foldr (Set dict) initial func = Dict.foldr dict initial λkey _ acc → func key acc


--| Only keep elements that pass the given test.
--|
--|     Set.filter numbers λn → n > 0
pub filter : Set t, (t → Bool) → Set t
    where t.compare : t, t → Order
filter (Set dict) isGood = Set (Dict.filter dict λkey _ → isGood key)


--| Create two new sets. The first contains all the elements that passed the
--| given test, and the second contains all the elements that did not.
--|
--|     Set.partition numbers λn → n > 0
pub partition : Set t, (t → Bool) → Set t × Set t
    where t.compare : t, t → Order
partition (Set dict) isGood =
    ( trues, falses ) = Dict.partition dict λkey _ → isGood key
    ( Set trues, Set falses )


--| Whether two sets hold the same values, by the value type's `compare`.
--| This is what `==` and `≠` on a set mean (`static-dispatch-spike.md`
--| §3.3), and it stays callable by name.
--|
--|     eq (fromList [ 1, 2, 3 ]) (fromList [ 3, 2, 1 ]) == True
--|
--| It is written here because the derived `eq` would compare the trees
--| underneath, and two sets holding the same values are not always the same
--| tree. It is `Dict.eq` on the dictionaries. O(n).
pub eq : Set t, Set t → Bool
    where t.compare : t, t → Order
eq (Set left) (Set right) = Dict.eq left right


--| Order two sets as their `toList`s are ordered: value by value from the
--| lowest, the first that differs deciding, and a set that runs out first
--| while everything before matched is `LT`. This is what `<`, `≤`, `>` and
--| `≥` on a set mean, and what makes a set a `Dict` key or a `Set` member.
--| It agrees with `eq`.
--|
--|     compare (fromList [ 1, 2 ]) (fromList [ 1, 3 ]) == LT
pub compare : Set t, Set t → Order
    where t.compare : t, t → Order
compare (Set left) (Set right) = Dict.compare left right
