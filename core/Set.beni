--! An ordered set of Int or String values, backed by Dict.
--! Iteration follows insertion order and equality includes that order.
--! Inserting an existing member keeps its position. Removing and then
--! reinserting it appends it. There is no compare method.
--!
--! Writes edit the underlying dictionary in place. Use Set.copy to retain
--! an old version. Lookup takes expected O(1); iteration takes O(n).

import Dict exposing (Dict)
import List


--| An ordered collection of unique Int or String members.
pub opaque type Set t
    = Set (Dict t ⊤)


--| A fresh empty set.
pub empty : ⊤ → Set t
empty ⊤ = Set (Dict.empty ⊤)


--| A set with one member.
pub singleton : t → Set t
singleton x = Set (Dict.singleton x ⊤)


--| Insert a member without moving an existing one.
pub insert : Set t, t → Set t
insert (Set d) x = Set (Dict.insert d x ⊤)


--| Remove a member; retain the order of the others.
pub remove : Set t, t → Set t
remove (Set d) x = Set (Dict.remove d x)


--| Copy the dictionary storage.
pub copy : Set t → Set t
copy (Set d) = Set (Dict.copy d)


--| Exchange two members' positions. Leave it unchanged if either is absent.
pub swap : Set t, t, t → Set t
swap (Set d) a b = Set (Dict.swap d a b)


--| Remove any old occurrence, then insert at the clamped index in the rest.
pub insertAt : Set t, Int, t → Set t
insertAt (Set d) i x = Set (Dict.insertAt d i x ⊤)


--| Stable ascending sort by the callback result. The callback runs once
--| per member, in current order, and may suspend.
pub sortBy : Set t, (t → a) → Set t
    where a.compare : a, a → Order
sortBy (Set d) f = Set (Dict.sortBy d λk _ → f k)


--| Whether there are no members.
pub isEmpty : Set t → Bool
isEmpty (Set d) = Dict.isEmpty d


--| Whether a member is present.
pub member : Set t, t → Bool
member (Set d) x = Dict.member d x


--| Number of members.
pub size : Set t → Int
size (Set d) = Dict.size d


--| Keep the left's order, then append right-only members.
pub union : Set t, Set t → Set t
union (Set left) (Set right) = Set (Dict.union left right)


--| Keep left members that occur in right, in fresh storage and left order.
pub intersect : Set t, Set t → Set t
intersect (Set left) (Set right) = Set (Dict.intersect left right)


--| Keep left members absent from right, in fresh storage and left order.
pub diff : Set t, Set t → Set t
diff (Set left) (Set right) = Set (Dict.diff left right)


--| Members in insertion order, in a fresh list.
pub toList : Set t → List t
toList (Set d) = Dict.keys d


--| Keep the first occurrence of each member, in list order.
pub fromList : List t → Set t
fromList xs = Set (List.foldl xs (Dict.empty ⊤) λx d → Dict.insert d x ⊤)


--| Map in insertion order and keep the first occurrence of each result.
--| Callback results must be Int or String.
pub map : Set a, (a → b) → Set b
map set f = fromList (List.map (toList set) f)


--| Fold from first member to last.
pub foldl : Set t, b, (t, b → b) → b
foldl (Set d) initial f = Dict.foldl d initial λk _ acc → f k acc


--| Fold from last member to first.
pub foldr : Set t, b, (t, b → b) → b
foldr (Set d) initial f = Dict.foldr d initial λk _ acc → f k acc


--| Keep members that pass the test, in fresh storage and the same order.
pub filter : Set t, (t → Bool) → Set t
filter (Set d) f = Set (Dict.filter d λk _ → f k)


--| Build two sets, preserving order within each.
pub partition : Set t, (t → Bool) → Set t × Set t
partition (Set d) f =
    ( yes, no ) = Dict.partition d λk _ → f k
    ( Set yes, Set no )


--| Equal members in the same order, with the dictionary identity shortcut.
pub eq : Set t, Set t → Bool
eq (Set left) (Set right) = Dict.eq left right
