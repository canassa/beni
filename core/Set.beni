--! A set of unique values. The values can be any type, and the ordering that
--! arranges them is an argument, exactly as it is for `Dict`: `empty`,
--! `singleton` and `fromList` take the comparison function, and every other
--! function uses the one the set already holds.
--!
--!     names : Set String
--!     names =
--!         Set.fromList [ "Alice", "Bob" ] String.compare
--!
--! Argument order here is **subject first and function last**, as it is
--! everywhere in core: the set comes first, so `names |> Set.insert "Carol"`
--! is `Set.insert names "Carol"` — `|>` is pipe-first, it inserts its left
--! operand as the callee's first argument. A function argument comes last, so
--! a lambda you write inline is the final one; where a function takes both an
--! *ordering* and a *callback*, as `map` does, the ordering comes first and
--! the callback stays last.
--!
--! Insert, remove and query take *O(log n)* time. A `Set` is a `Dict` whose
--! values are all `()`, which is how Elm builds it too.
--!
--! Nothing here is `foreign`.

import Dict exposing (Dict)
import List


--| Represents a set of unique values. So `Set Int` is a set of integers and
--| `Set String` is a set of strings.
pub opaque type Set t
    = Set (Dict t ())


--| Create an empty set whose values are ordered by the given function.
--|
--|     Set.empty String.compare
pub empty : (t, t -> Order) -> Set t
empty cmp =
    Set (Dict.empty cmp)


--| Create a set with one value, ordered by the given function.
--|
--|     Set.singleton "Tom" String.compare
pub singleton : t, (t, t -> Order) -> Set t
singleton value cmp =
    Set (Dict.singleton value () cmp)


--| Insert a value into a set.
--|
--|     Set.insert (Set.empty String.compare) "Tom"
pub insert : Set t, t -> Set t
insert (Set dict) value =
    Set (Dict.insert dict value ())


--| Remove a value from a set. If the value is not found, no changes are made.
--|
--|     Set.remove names "Tom"
pub remove : Set t, t -> Set t
remove (Set dict) value =
    Set (Dict.remove dict value)


--| Determine if a set is empty.
--|
--|     isEmpty (empty String.compare) == True
pub isEmpty : Set t -> Bool
isEmpty (Set dict) =
    Dict.isEmpty dict


--| Determine if a value is in a set.
--|
--|     Set.member names "Alice" == True
pub member : Set t, t -> Bool
member (Set dict) value =
    Dict.member dict value


--| Determine the number of elements in a set.
pub size : Set t -> Int
size (Set dict) =
    Dict.size dict


--| Get the union of two sets. Keep all values. The ordering of the second
--| set is the one the result keeps, as it is the set being added to.
pub union : Set t, Set t -> Set t
union (Set d1) (Set d2) =
    Set (Dict.union d1 d2)


--| Get the intersection of two sets. Keeps values that appear in both sets.
pub intersect : Set t, Set t -> Set t
intersect (Set d1) (Set d2) =
    Set (Dict.intersect d1 d2)


--| Get the difference between the first set and the second. Keeps values
--| that do not appear in the second set.
pub diff : Set t, Set t -> Set t
diff (Set d1) (Set d2) =
    Set (Dict.diff d1 d2)


--| Convert a set into a list, sorted from lowest to highest.
pub toList : Set t -> List t
toList (Set dict) =
    Dict.keys dict


--| Convert a list into a set, removing any duplicates, ordered by the given
--| function.
--|
--|     Set.fromList [ "a", "b", "a" ] String.compare
pub fromList : List t, (t, t -> Order) -> Set t
fromList list cmp =
    List.foldl list (empty cmp) (\value set -> insert set value)


--| Map a function onto a set, creating a new set with no duplicates. The
--| ordering comes before the function, because the values the result holds
--| have a new type and the old ordering no longer applies to them — and
--| because the function you write inline belongs last.
--|
--|     Set.map names compare String.length
pub map : Set a, (b, b -> Order), (a -> b) -> Set b
map set cmp func =
    fromList (List.map (toList set) func) cmp


--| Fold over the values in a set, in order from lowest to highest.
--|
--|     Set.foldl numbers 0 (\n total -> n + total)
pub foldl : Set t, b, (t, b -> b) -> b
foldl (Set dict) initial func =
    Dict.foldl dict initial (\key _ acc -> func key acc)


--| Fold over the values in a set, in order from highest to lowest.
--|
--|     Set.foldr names [] (\name acc -> name :: acc) == Set.toList names
pub foldr : Set t, b, (t, b -> b) -> b
foldr (Set dict) initial func =
    Dict.foldr dict initial (\key _ acc -> func key acc)


--| Only keep elements that pass the given test.
--|
--|     Set.filter numbers (\n -> n > 0)
pub filter : Set t, (t -> Bool) -> Set t
filter (Set dict) isGood =
    Set (Dict.filter dict (\key _ -> isGood key))


--| Create two new sets. The first contains all the elements that passed the
--| given test, and the second contains all the elements that did not.
--|
--|     Set.partition numbers (\n -> n > 0)
pub partition : Set t, (t -> Bool) -> ( Set t, Set t )
partition (Set dict) isGood =
    let
        ( trues, falses ) =
            Dict.partition dict (\key _ -> isGood key)
    in
    ( Set trues, Set falses )
