-- Core-private typed array construction. These operations emit in place.
import Js


--| Allocate private capacity; finish the initialized prefix before reading it.
pub foreign pure arrayAllocate : unused Int → fresh exclusive Js.Builder a


--| Set one initialized builder slot, retaining its element type.
pub foreign pure arraySet : written returned Js.Builder a, borrowed Int, stored a → Js.Builder a


--| Finish the initialized prefix as a plain List.
pub foreign pure arrayDone : written returned Js.Builder a, borrowed Int → builderdone List a


--| Read an initialized index; the core container proves its bounds.
pub foreign impure arrayGet : borrowed Js.Builder a, borrowed Int → unknown a


--| The native capacity length.
pub foreign impure arrayLength : borrowed Js.Builder a → Int


--| Shared runtime capacity store. Stored callbacks remain charged to the writer.
pub foreign impure arrayWrite : escaped Js.Builder a, unused Int, escaped a → ⊤


--| Sort initialized private capacity in place. Comparison borrows both values.
pub foreign impure arraySort :
      written returned Js.Builder a
    , borrowed sync (a, a → Int)
    → Js.Builder a
