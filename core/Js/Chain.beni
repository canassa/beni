-- Core-private typed intrusive storage. Removed links forget values and neighbours.

import Js


pub opaque type Chain a
    = Chain
        { first : Js.Ref (Maybe (Link a))
        , last : Js.Ref (Maybe (Link a))
        , count : Js.Ref Int
        }


pub opaque type Link a
    = Link
        { value : Js.Ref (Maybe a)
        , before : Js.Ref (Maybe (Link a))
        , after : Js.Ref (Maybe (Link a))
        }


pub make : ⊤ → Chain a
make ⊤ = Chain { first = Js.ref Nothing, last = Js.ref Nothing, count = Js.ref 0 }


pub size : Chain a → Int
size (Chain q) = Js.read q.count


pub append : Chain a, a → Link a
append (Chain q) value =
    link =
        Link
            { value = Js.ref (Just value)
            , before = Js.ref (Js.read q.last)
            , after = Js.ref Nothing
            }
    case Js.read q.last of
        Nothing →
            Js.write q.first (Just link)
        Just (Link previous) →
            Js.write previous.after (Just link)
    Js.write q.last (Just link)
    Js.write q.count (Js.read q.count + 1)
    link


pub prepend : Chain a, a → Link a
prepend (Chain q) value =
    link =
        Link
            { value = Js.ref (Just value)
            , before = Js.ref Nothing
            , after = Js.ref (Js.read q.first)
            }
    case Js.read q.first of
        Nothing →
            Js.write q.last (Just link)
        Just (Link next) →
            Js.write next.before (Just link)
    Js.write q.first (Just link)
    Js.write q.count (Js.read q.count + 1)
    link


pub remove : Chain a, Link a → Maybe a
remove (Chain q) (Link link) =
    case Js.read link.value of
        Nothing →
            Nothing
        Just value →
            case Js.read link.before of
                Nothing →
                    Js.write q.first (Js.read link.after)
                Just (Link previous) →
                    Js.write previous.after (Js.read link.after)
            case Js.read link.after of
                Nothing →
                    Js.write q.last (Js.read link.before)
                Just (Link next) →
                    Js.write next.before (Js.read link.before)
            Js.write link.value Nothing
            Js.write link.before Nothing
            Js.write link.after Nothing
            Js.write q.count (Js.read q.count - 1)
            Just value


pub shift : Chain a → Maybe a
shift ((Chain q) as deque) =
    case Js.read q.first of
        Nothing →
            Nothing
        Just link →
            remove deque link


pub pop : Chain a → Maybe a
pop ((Chain q) as deque) =
    case Js.read q.last of
        Nothing →
            Nothing
        Just link →
            remove deque link


pub toList : Chain a → List a
toList (Chain q) = linksList (Js.read q.first) []


linksList : Maybe (Link a), List a → List a
linksList next values =
    case next of
        Nothing →
            values
        Just (Link link) →
            case Js.read link.value of
                Nothing →
                    values
                Just value →
                    linksList (Js.read link.after) [ …values, value ]


pub clear : Chain a → ⊤
clear deque =
    case shift deque of
        Nothing →
            ⊤
        Just _ →
            clear deque


pub first : Chain a → Maybe a
first (Chain q) =
    case Js.read q.first of
        Nothing →
            Nothing
        Just (Link link) →
            Js.read link.value
