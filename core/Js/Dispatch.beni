-- Platform-only synchronous dispatch. Nested sends retain closed typed jobs.
import Js
import Js.Fifo as Fifo
import Js.Protocol as Protocol


pending : Js.Ref (Fifo.Fifo (⊤ → ⊤))
pending = Js.ref (Fifo.make ⊤)


dead : Js.Ref Bool
dead = Js.ref False


running : Js.Ref Bool
running = Js.ref False


failure : Js.Ref (⊤ → ⊤)
failure = Js.ref λ⊤ → ⊤


pub onDefect : sync (⊤ → ⊤) → ⊤
onDefect callback = Js.write failure callback


pub busy : ⊤ → Bool
busy ⊤ = Js.read running


pub stopped : ⊤ → Bool
stopped ⊤ = Js.read dead


pub stop : ⊤ → ⊤
stop ⊤ =
    Js.write dead True
    Fifo.clear (Js.read pending)


pub send : sync (a → ⊤), a → ⊤
send callback value = read callback value identity


-- An extractor runs inside the guard before a nested send is queued.
pub read : sync (a → ⊤), b, sync (b → a) → ⊤
read callback raw project =
    if not (Js.read dead) then
        nested = Js.read running
        Js.write running True
        ok = Js.ref False
        Js.finally
            (λ⊤ →
                value = project raw
                if nested then
                    Fifo.push (Js.read pending) λ⊤ → callback value
                else
                    callback value
                    drain ⊤
                Js.write ok True
            )
            λ⊤ →
                Js.write running nested
                if not (Js.read ok) then
                    stop ⊤
                    (Js.read failure) ⊤


-- Native observers call a sender that already queues dispatch. Avoid a second turn.
-- Synchronous callbacks restore running before returning, so it also marks success.
pub observe : sync (a → ⊤), b, sync (b → a) → ⊤
observe callback raw project =
    if not (Js.read dead) then
        nested = Js.read running
        Js.write running True
        Js.finally
            (λ⊤ →
                callback (project raw)
                if not nested then drain ⊤
                Js.write running False
            )
            λ⊤ →
                failed = Js.read running
                Js.write running nested
                if failed then
                    stop ⊤
                    (Js.read failure) ⊤


drain : ⊤ → ⊤
drain ⊤ =
    if not (Js.read dead) then
        queue = Js.read pending
        if not (Fifo.empty queue) then
            work = Fifo.shift queue
            Protocol.call work ⊤
            drain ⊤
