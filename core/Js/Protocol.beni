-- Platform-only synchronous protocol steps, over core's typed invocation.
import Js
import Js.Runtime as Runtime


-- Used where a protocol has already established that this job cannot park.
-- Waiting jobs use ordinary beni calls and their normal continuation.
pub call : (a → b), a → b
call callback argument = Js.invoke callback argument


pub defect : String → a
defect message = Runtime.defect message
