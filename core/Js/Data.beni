-- Core-only checked conversion of a value graph to plain host data.
import Js
import Js.Any
import List


-- The value is retained only after the whole reachable graph is checked.
-- Private list protocol callbacks are metadata; their logical elements are
-- checked and projected to a plain array without invoking those callbacks.
pub checked : returned a → Maybe Js.Value
checked value = checkedGraph List.viewToken value


foreign pure checkedGraph : borrowed Js.Cell { listProtocol : ⊤ }, returned a → Maybe Js.Value


-- The compiler adds a checked representation witness to checkedGraph and
-- propagates it through generic callers. It distinguishes native scalars and
-- Any packets from ordinary data with the same runtime representation.
