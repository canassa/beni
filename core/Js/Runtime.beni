-- Core-private protocol primitives. Host scheduling is beni in Task.

-- The unique parked sentinel, consumed only by the core suspension protocol.
pub foreign pure parked : unused ⊤ → unknown a


-- Js.throw accepts Js.Value, which cannot hold the native Error this throws.
-- Keep this exact defect primitive rather than erase an Error handle.
pub foreign impure defect : borrowed String → unknown a
