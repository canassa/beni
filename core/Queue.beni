--! Values passed between fibers, first in, first out
--! (`transparent-effects-proposal.md` §17.9): Effect's `Queue`.
--!
--!     jobs = Queue.bounded 16
--!     _ = Task.spawn λ⊤ → Queue.offer jobs (next ⊤)
--!     job = Queue.take jobs
--!
--! **Four kinds**, which differ only in what an offer to a full queue does:
--! `bounded` waits for room, `dropping` refuses the new value, `sliding`
--! drops the oldest value, and `unbounded` is never full.
--!
--! **First come, first served.** Fibers that wait to take are served in
--! the order they began to wait, and so are fibers that wait to offer. A
--! value goes straight to the fiber that waits longest, and a take never
--! passes a fiber that waits to take.
--!
--! **Cancelling a wait loses nothing.** A fiber cancelled while it waits
--! leaves the queue at once. A taker that was handed values but was
--! cancelled before it ran gives them back to the front of the queue, so
--! the next taker gets them first. An offer that was accepted stays
--! accepted when its fiber is cancelled: the value is in the queue once.
--!
--! **`end` ends the queue.** Later offers are refused, the values held are
--! still taken, and then `take` answers `Nothing`, so a consumer's loop
--! ends there.
--!
--! Nothing here is `foreign`: it is beni over `Task.callback` and
--! `Task.resume`.

import Js
import Js.Array as Array
import Js.Chain as Chain
import Task


--| A queue and the fibers waiting to give or take its typed values.
pub opaque type Queue a
    = Queue (State a)


type alias State a =
    mode : Int
    cap : Int
    items : Chain.Chain a
    takers : Chain.Chain (Taker a)
    offers : Chain.Chain (Offer a)
    ended : Js.Ref Bool
    pending : Js.Ref Int


type alias Taker a =
    need : Int
    most : Int
    got : Js.Ref (Maybe (List a))
    finish : List a → ⊤


type alias Offer a =
    remaining : Js.Ref (List a)
    finish : List a → ⊤


--| A full queue waits until there is room.
pub bounded : Int → Queue a
bounded capacity = make 0 capacity


--| A full queue refuses the new value.
pub dropping : Int → Queue a
dropping capacity = make 1 capacity


--| A full queue drops its oldest value to make room.
pub sliding : Int → Queue a
sliding capacity = make 2 capacity


--| A queue that is never full.
pub unbounded : ⊤ → Queue a
unbounded ⊤ = make 3 1


make : Int, Int → Queue a
make mode capacity =
    Queue
        { mode = mode
        , cap = max 1 capacity
        , items = Chain.make ⊤
        , takers = Chain.make ⊤
        , offers = Chain.make ⊤
        , ended = Js.ref False
        , pending = Js.ref 0
        }


--| Put a value at the end. False means the queue refused it or has ended.
pub offer : Queue a, a → Bool
offer (Queue q) value =
    if ended q then
        False
    else if not (full q) && Chain.size q.offers == 0 then
        push q value
        serve q
        True
    else if q.mode == 1 then
        False
    else if q.mode == 2 then
        slide q
        push q value
        serve q
        True
    else
        Task.callback λresume → waitOffer q [ value ] λrest → Task.resume resume (List.isEmpty rest)


--| Offer each value in order and return the values not accepted.
pub offerAll : Queue a, List a → List a
offerAll (Queue q) values =
    if ended q then
        values
    else if q.mode == 0 then
        rest = if Chain.size q.offers == 0 then fillServing q values else values
        if List.isEmpty rest then
            []
        else
            Task.callback λresume → waitOffer q rest λleft → Task.resume resume left
    else
        rest = offerMany q values []
        serve q
        rest


offerMany : State a, List a, List a → List a
offerMany q values rest =
    case values of
        [] →
            rest
        [ value, …remaining ] →
            if full q then serve q
            if not (full q) then
                push q value
                offerMany q remaining rest
            else if q.mode == 2 then
                slide q
                push q value
                offerMany q remaining rest
            else
                offerMany q remaining [ …rest, value ]


--| Take the oldest value, waiting when needed. Nothing means the queue has ended.
pub take : Queue a → Maybe a
take (Queue q) =
    if Chain.size q.takers == 0 && count q > 0 then
        value = Chain.shift q.items
        refill q
        value
    else if Chain.size q.takers == 0 && finished q then
        Nothing
    else
        got = Js.ref Nothing
        answer = Task.callback λresume →
            park q
                { need = 1, most = 1, got = got, finish = λvs → Task.resume resume (List.head vs) }
        settle q got
        answer


--| Take all held values, waiting until there is a value or the queue has ended.
pub takeAll : Queue a → List a
takeAll (Queue q) = takeList q 1 9007199254740991


--| Take up to n values, waiting for n, the queue's capacity, or its end.
pub takeN : Queue a, Int → List a
takeN (Queue q) n = if n ≤ 0 then [] else takeList q (if q.mode == 3 then n else min n q.cap) n


takeList : State a, Int, Int → List a
takeList q need most =
    if Chain.size q.takers == 0 && (count q ≥ need || finished q) then
        values = popUpTo q most
        refill q
        values
    else
        got = Js.ref Nothing
        answer = Task.callback λresume →
            park q { need = need, most = most, got = got, finish = λvs → Task.resume resume vs }
        settle q got
        answer


--| Take an available value without waiting or passing a waiting taker.
pub poll : Queue a → Maybe a
poll (Queue q) =
    if Chain.size q.takers == 0 && count q > 0 then
        value = Chain.shift q.items
        refill q
        value
    else
        Nothing


--| How many values the queue holds.
pub size : Queue a → Int
size (Queue q) = count q


--| Refuse later offers, and finish taking the values already held.
pub end : Queue a → ⊤
end (Queue q) =
    if not (ended q) then
        Js.write q.ended True
        refuse q.offers
        serve q


ended : State a → Bool
ended q = Js.read q.ended


finished : State a → Bool
finished q = ended q && Js.read q.pending == 0


count : State a → Int
count q = Chain.size q.items


full : State a → Bool
full q = q.mode ≠ 3 && count q ≥ q.cap


push : State a, a → ⊤
push q value = Chain.push q.items value


popUpTo : State a, Int → List a
popUpTo q most =
    limit = min (max 0 most) (count q)
    drainItems q (Array.arrayAllocate limit) 0 limit


drainItems : State a, Js.Builder a, Int, Int → List a
drainItems q values index limit =
    if index == limit then
        Array.arrayDone values index
    else
        case Chain.shift q.items of
            Nothing →
                Array.arrayDone values index
            Just value →
                filled = Array.arraySet values index value
                drainItems q filled (index + 1) limit


unshift : State a, List a → ⊤
unshift q values = List.foldr values ⊤ λvalue _ → Chain.unshift q.items value


slide : State a → ⊤
slide q =
    if count q ≥ q.cap then
        _ = Chain.shift q.items
        slide q


fill : State a, List a → List a
fill q values =
    if full q then
        values
    else
        case values of
            [] →
                []
            [ value, …rest ] →
                push q value
                fill q rest


fillServing : State a, List a → List a
fillServing q values =
    rest = fill q values
    serve q
    if List.length rest < List.length values && not (List.isEmpty rest) then
        fillServing q rest
    else
        rest


park : State a, Taker a → (⊤ → ⊤)
park q w =
    link = Chain.append q.takers w
    λ⊤ →
        case Js.read w.got of
            Nothing →
                _ = Chain.remove q.takers link
                serve q
            Just values →
                Js.write w.got Nothing
                if not (List.isEmpty values) then
                    unshift q values
                    Js.write q.pending (Js.read q.pending - 1)
                    serve q


settle : State a, Js.Ref (Maybe (List a)) → ⊤
settle q slot =
    case Js.read slot of
        Nothing →
            ⊤
        Just values →
            Js.write slot Nothing
            if not (List.isEmpty values) then
                Js.write q.pending (Js.read q.pending - 1)
                if finished q then serve q


waitOffer : State a, List a, (List a → ⊤) → (⊤ → ⊤)
waitOffer q values finish =
    offerer = { remaining = Js.ref values, finish = finish }
    link = Chain.append q.offers offerer
    λ⊤ →
        _ = Chain.remove q.offers link
        ⊤


serve : State a → ⊤
serve q =
    case Chain.first q.takers of
        Nothing →
            ⊤
        Just w →
            if count q ≥ w.need || finished q then
                _ = Chain.shift q.takers
                values = popUpTo q w.most
                Js.write w.got (Just values)
                if not (List.isEmpty values) then Js.write q.pending (Js.read q.pending + 1)
                w.finish values
                refill q
                serve q


refill : State a → ⊤
refill q =
    case Chain.first q.offers of
        Nothing →
            ⊤
        Just offerer →
            if not (full q) then
                rest = fill q (Js.read offerer.remaining)
                Js.write offerer.remaining rest
                if List.isEmpty rest then
                    _ = Chain.shift q.offers
                    offerer.finish []
                    refill q


refuse : Chain.Chain (Offer a) → ⊤
refuse offers =
    case Chain.shift offers of
        Nothing →
            ⊤
        Just offerer →
            offerer.finish (Js.read offerer.remaining)
            refuse offers
