--! Floating-point functions whose Elm names would read wrong in
--! subject-first order (`language.md` §12.4).
--!
--! The `Float` type itself is declared in `Basics`, with the arithmetic,
--! the conversions and the trigonometry, and every module sees it. This
--! module is in the prelude's module aliases, so `Float.log x 10` needs no
--! import. Its values are functions, not methods: `Float`'s methods are
--! `Basics`'s, so write `Float.log x 10`, not `x.log 10`.

import Js


--| The logarithm of a number in a given base: the number first, then the
--| base.
--|
--|     Float.log 100 10 == 2
--|
--| The answer is IEEE 754's `ln x / ln base`, and some answers are not
--| finite: the logarithm of 0 is `-Infinity` (`Infinity` for a base under 1),
--| a negative number or base gives `NaN`, and base 1 divides by `ln 1 = 0`,
--| so `Float.log 2 1` is `Infinity` and `Float.log 1 1` is `NaN`. No
--| non-finite value is an operand on the way to an answer.
pub log : Float, Float → Float
log x base =
    top = ln x
    bottom = ln base
    -- The answers are IEEE 754's `top / bottom`. `ln 0` is `-Infinity`, `ln`
    -- of `Infinity` is `Infinity` and `ln` of a negative number is `NaN`, so a
    -- non-finite side is answered here and never divided. Base 1 makes
    -- `bottom` 0, a finite operand.
    if isNaN top then
        top
    else if isNaN bottom then
        bottom
    else if isInfinite top then
        -- An infinity whose sign is the product of the two signs. `bottom` is
        -- never `-0`.
        if isInfinite bottom then
            0 / 0
        else if bottom < 0 then
            if top < 0 then
                1 / 0
            else
                (-1) / 0
        else
            top
    else if isInfinite bottom then
        -- A zero whose sign is the product of the two signs. `top` is never
        -- `-0`.
        if (top < 0) == (bottom < 0) then
            0
        else
            0 / (-1)
    else
        top / bottom


ln : Float → Float
ln x = Js.pure λ⊤ → Js.to (Js.call (Js.global "Math") "log" [ Js.from x ])
