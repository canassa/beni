--! A value that is completed once and waited for by any number of fibers
--! (`transparent-effects-proposal.md` §17.4): Effect's `Deferred`.
--!
--!     ready = Deferred.make ⊤
--!     _ = Task.spawn λ⊤ → Deferred.complete ready (load ⊤)
--!     config = Deferred.wait ready
--!
--! **The first completion wins.** `complete` gives the value to every fiber
--! waiting, in the order they began to wait, and answers `True`; once
--! completed, a `Deferred` keeps its value, and a later `complete` changes
--! nothing and answers `False`.
--!
--! **Waiting is cancellable and leaves nothing behind.** A fiber cancelled
--! while it waits is taken off the list at once: it is never handed the
--! value, and nothing holds on to it.
--!
--! There is no failure to complete with: a failure is a `Result` carried in
--! the value, and a waiter that should stop is cancelled.
--!
--! Nothing here is `foreign`: it is beni over `Task.callback` and
--! `Task.resume`.

import Js
import Js.Chain as Chain
import Task


--| A value that is completed once, and may be waited for until it is.
pub opaque cell type Deferred a
    = Deferred { value : Js.Ref (Maybe a), waiters : Chain.Chain (Task.Resume a) }


--| A new Deferred, not completed.
pub make : unused ⊤ → cellempty Deferred a
make ⊤ = Deferred { value = Js.ref Nothing, waiters = Chain.make ⊤ }


--| Wait for its value, or return it at once when already completed.
pub wait : cellread Deferred a → lent a
wait (Deferred d) =
    case Js.read d.value of
        Just value →
            value
        Nothing →
            Task.callback λresume →
                link = Chain.append d.waiters resume
                λ⊤ →
                    _ = Chain.remove d.waiters link
                    ⊤


--| Complete once and resume every waiting fiber in arrival order.
pub complete : cellcomplete Deferred a, consumed cellstored a → Bool
complete (Deferred d) value =
    case Js.read d.value of
        Just _ →
            False
        Nothing →
            Js.write d.value (Just value)
            wake d.waiters value
            True


wake : Chain.Chain (Task.Resume a), a → ⊤
wake waiters value =
    case Chain.shift waiters of
        Nothing →
            ⊤
        Just resume →
            Task.resume resume value
            wake waiters value


--| The completed value, or Nothing before completion, without waiting.
pub poll : cellread Deferred a → lentoptional Maybe a
poll (Deferred d) = Js.read d.value


--| Whether the Deferred has been completed.
pub isDone : cellread Deferred a → Bool
isDone deferred =
    case poll deferred of
        Just _ →
            True
        Nothing →
            False
