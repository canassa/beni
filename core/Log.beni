--! A log a shipped program keeps (`transparent-effects-proposal.md`
--! §17.11, `boundary.md` §9.8.15 (b)): a line at one of five levels,
--! handed to the program's sink. Effect's `Effect.log` and `Logger`.
--!
--!     Log.warn "saving took ${String.fromInt ms} ms"
--!
--! `Debug.log` is for development, and a `--release` build refuses it.
--! These are kept by every build: each call is `impure`, so `--release`
--! never drops one.
--!
--! A line is text: a program that logs a value formats it, because
--! `Debug.toString`'s text is not a promise.
--!
--! **Levels.** `Trace < Debug < Info < Warn < Error`. A line below the
--! minimum is not written: the call builds nothing, and costs a read of
--! the fiber's slot and one comparison. The minimum is the program's —
--! `Info` until `setMinimum` changes it — unless `minimum` sets one for a
--! function and the fibers it starts.
--!
--! **The sink.** A call makes an `Entry` — the level, the line, the
--! annotations and log spans of the calling fiber, and the time on its
--! clock — and hands it to the sink. The default sink writes the line on
--! the console at its level: `console.debug` for `Trace` and `Debug`, then
--! `console.info`, `console.warn` and `console.error`. A platform replaces
--! it with `setSink`: the `node` platform's `Io.run` writes one `logfmt`
--! line per entry to standard error.
--!
--! **The log context.** `annotate`, `span`, `minimum` and `withSink` change
--! the context for the function they run, and for every fiber that
--! function starts, and put it back when the function ends:
--!
--!     Log.annotate "user" (String.fromInt id) λ⊤ →
--!         Log.span "save" λ⊤ →
--!             _ = save id
--!             Log.info "saved"
--!
--! On `node`, under `Io.run`, that line is
--! `timestamp=… level=INFO message=saved save=12ms user=7`.
--!
--! Nothing here is `foreign`.

import Clock
import Js
import List
import String
import Task


--| How much a line matters, least first: `Trace < Debug < Info < Warn <
--| Error`.
pub type Level
    = Trace
    | Debug
    | Info
    | Warn
    | Error


--| One line, as a sink is given it: its `level`, its `message`, the
--| `annotations` of the log context as key and value, outermost first, the
--| log `spans` it is inside as label and the milliseconds since that span
--| began, innermost first, and its `time` in milliseconds since the Unix
--| epoch, on the calling fiber's clock.
pub type alias Entry =
    level : Level
    message : String
    annotations : List (String × String)
    spans : List (String × Int)
    time : Int


--| The line at `Trace`, the finest detail.
pub trace : String → ⊤
trace message = log Trace message


--| The line at `Debug`.
pub debug : String → ⊤
debug message = log Debug message


--| The line at `Info`.
pub info : String → ⊤
info message = log Info message


--| The line at `Warn`.
pub warn : String → ⊤
warn message = log Warn message


--| The line at `Error`.
pub error : String → ⊤
error message = log Error message


--| The line at `level`: an `Entry`, handed to the sink — unless `level` is
--| below the minimum, when nothing is built.
pub log : Level, String → ⊤
log level message =
    here = context ⊤
    least = if Js.isUndefined here.minimum then Js.read programMinimum else Js.to here.minimum

    if rank level ≥ rank least then
        now = Clock.now ⊤
        emit here.sink
            { level = level
            , message = message
            , annotations = here.annotations
            , spans = List.map here.spans λ( label, began ) → ( label, now - began )
            , time = now
            }


-- A level's place in the order.
rank : Level → Int
rank level =
    case level of
        Trace →
            0

        Debug →
            1

        Info →
            2

        Warn →
            3

        Error →
            4


-- The sink `setSink` installed: undefined until it is called, for the
-- default.
sink : Js.Ref Js.Value
sink = Js.ref Js.undefined


--| Make `f` the sink of every line the program writes from now on, outside
--| `withSink`. It is a platform's call, as `Task.onDefect` is: the `node`
--| platform's `Io.run` makes it. The last call wins. A sink runs during
--| the call that logs, so it must not suspend.
pub setSink : sync (Entry → ⊤) → ⊤
setSink f = Js.write sink (Js.from f)


-- The program's minimum, which `setMinimum` sets.
programMinimum : Js.Ref Level
programMinimum = Js.ref Info


--| Make `level` the program's minimum from now on: a line below it is not
--| written, in every fiber, the ones a platform's runtime starts
--| included, unless `minimum` sets another for a function. The last call
--| wins, as `setSink`'s does. Until a call, the minimum is `Info`.
--|
--|     init ⊤ =
--|         Log.setMinimum Log.Debug
--|         ( model, Cmd.log Log.Debug "written" )
pub setMinimum : Level → ⊤
setMinimum level = Js.write programMinimum level


-- Hand `entry` to the sink: `withSink`'s, else `setSink`'s, else the
-- console.
emit : Js.Value, Entry → ⊤
emit scoped entry =
    target = if Js.isUndefined scoped then Js.read sink else scoped

    if Js.isUndefined target then
        console entry
    else
        Js.to (Js.apply target [ Js.from entry ])


-- ---- The log context (§17.5) ----------------------------------------------

-- A fiber's log context: the annotations, outermost first; each log span
-- with the time it began, innermost first; the minimum level that
-- `minimum` set, undefined for the program's; and the sink `withSink` gave
-- it, undefined for none. It lives in the fiber's slot as a `Js.Value`,
-- and a change makes a new one.
type alias Context =
    annotations : List (String × String)
    spans : List (String × Int)
    minimum : Js.Value
    sink : Js.Value


-- The context of a fiber that no `annotate`, `span`, `minimum` or
-- `withSink` changed.
initial : Context
initial = { annotations = [], spans = [], minimum = Js.undefined, sink = Js.undefined }


-- The calling fiber's log context.
context : ⊤ → Context
context ⊤ =
    slot = Task.currentLogContext ⊤
    if Js.isUndefined slot then initial else Js.to slot


-- Run `work` with the calling fiber's log context set to `next`.
within : Context, (⊤ → a) → a
within next work = Task.withLogContext (Js.from next) work


--| Run `work` with the annotation `key` = `value` on every line it writes,
--| and on every line the fibers it starts write: Effect's
--| `annotateLogs`. When `key` is there already, the new value replaces
--| the old one in its place.
--|
--|     Log.annotate "request" id λ⊤ →
--|         Log.info "started"
pub annotate : String, String, (⊤ → a) → a
annotate key value work =
    here = context ⊤
    within { here | annotations = annotated here.annotations key value } work


-- `annotations` with `key` set to `value`: in its place when the key is
-- there, else last. A new list each time: the outer context still holds
-- the old one.
annotated : List (String × String), String, String → List (String × String)
annotated annotations key value =
    if List.any annotations λ( k, _ ) → k == key then
        List.map annotations λ( k, v ) → if k == key then ( k, value ) else ( k, v )
    else
        List.push (List.copy annotations) ( key, value )


--| Run `work` inside the log span `label`: every line it writes, and every
--| line the fibers it starts write, carries `label` and the milliseconds
--| since `span` began, on the calling fiber's clock: Effect's
--| `withLogSpan`.
pub span : String, (⊤ → a) → a
span label work =
    here = context ⊤
    within { here | spans = [ ( label, Clock.now ⊤ ), …here.spans ] } work


--| Run `work` with `level` as the minimum: a line below it, from `work` or
--| from a fiber it starts, is not written. It overrides the program's
--| minimum, `setMinimum`'s, for `work` only.
--|
--|     Log.minimum Log.Debug λ⊤ →
--|         Log.debug "written"
pub minimum : Level, (⊤ → a) → a
minimum level work =
    here = context ⊤
    within { here | minimum = Js.from level } work


--| Run `work` with `f` as the sink of every line it writes, and of every
--| line the fibers it starts write, in place of the program's: how a test
--| reads what was logged. `f` runs during the call that logs, so it must
--| not suspend.
pub withSink : sync (Entry → ⊤), (⊤ → a) → a
withSink f work =
    here = context ⊤
    within { here | sink = Js.from f } work


-- The default sink: the console method for the level, given the message
-- with each span appended as ` label=Nms`, and the annotations as a second
-- argument, an object of strings, when there are any. With neither it is
-- the one-argument call `browser`'s `Log` always made, so a page prints
-- what it printed.
console : Entry → ⊤
console entry =
    text = List.foldl entry.spans entry.message λeach line → "${line}${spanText each}"
    out = Js.global "console"
    name = methodOf entry.level

    if List.isEmpty entry.annotations then
        Js.to (Js.call out name [ Js.from text ])
    else
        Js.to (Js.call out name [ Js.from text, annotationObject entry.annotations ])


-- The console method for a level.
methodOf : Level → String
methodOf level =
    case level of
        Trace →
            "debug"

        Debug →
            "debug"

        Info →
            "info"

        Warn →
            "warn"

        Error →
            "error"


-- The annotations as one object of strings. Made by `Object.fromEntries`,
-- which defines each key as its own property, so a key such as `__proto__`
-- is a key like any other. The keys keep their order, but for an integer
-- index such as `"1"`, which a JavaScript object puts first.
annotationObject : List (String × String) → Js.Value
annotationObject annotations =
    pairs = Js.array []

    List.foldl annotations ⊤ λ( key, value ) _ →
        Js.to (Js.call pairs "push" [ Js.array [ Js.from key, Js.from value ] ])

    Js.call (Js.global "Object") "fromEntries" [ pairs ]


--| The line the `node` platform writes for an entry: Effect's `logfmt`
--| (`Logger.formatLogFmt`).
--|
--|     timestamp=2026-10-20T09:15:00.000Z level=INFO message="saved 3 items" save=12ms user=7
--|
--| The time in ISO 8601, in UTC; the level in capitals; the message; then
--| each span as `label=Nms`, innermost first; then each annotation as
--| `key=value`, outermost first. A value with white space, a `"` or a `=`
--| in it is quoted as `JSON.stringify` quotes a string, and any other is
--| written as it is. In a key or a label, each white space, `"` and `=` is
--| written `_`. A time outside the range of a JavaScript `Date`,
--| ±8.64 × 10¹⁵ ms, is written as the nearest end of it.
pub logfmt : Entry → String
logfmt entry =
    head =
        "timestamp=${timestamp entry.time} level=${levelName entry.level} message=${valueText entry.message}"
    spans = String.concat (List.map entry.spans spanText)
    annotations = String.concat (List.map entry.annotations annotationText)
    head ++ spans ++ annotations


-- A level as `logfmt` writes it.
levelName : Level → String
levelName level =
    case level of
        Trace →
            "TRACE"

        Debug →
            "DEBUG"

        Info →
            "INFO"

        Warn →
            "WARN"

        Error →
            "ERROR"


-- The time in ISO 8601, in UTC: `Date`'s `toISOString`, which throws for
-- a time outside a `Date`'s range. Such a time is first moved to the
-- nearest end of it, and one that is not a number — `round (0 / 0)` is an
-- `Int` — is written `NaN`.
timestamp : Int → String
timestamp ms =
    if Basics.isNaN (Basics.toFloat ms) then
        "NaN"
    else
        inRange = Basics.clamp ms (-8640000000000000) 8640000000000000
        Js.to (Js.call (Js.construct (Js.global "Date") [ Js.from inRange ]) "toISOString" [])


-- An annotation as ` key=value`.
annotationText : String × String → String
annotationText ( key, value ) = " ${labelText key}=${valueText value}"


-- A span as ` label=Nms`, Effect's `formatLogSpan`.
spanText : String × Int → String
spanText ( label, ms ) = " ${labelText label}=${String.fromInt ms}ms"


-- A key or a label with each white space, `"` and `=` written `_`:
-- Effect's `formatLabel`.
labelText : String → String
labelText label =
    Js.to
        (Js.call (Js.call (Js.from label) "split" [ Js.regExp "[\\s\"=]" "" ]) "join"
            [ Js.from "_" ]
        )


-- A value as it is when it holds no white space, `"` or `=` (Effect's
-- `textOnly`), and else quoted as `JSON.stringify` quotes a string.
valueText : String → String
valueText value =
    if Js.to (Js.call (Js.regExp "^[^\\s\"=]*$" "") "test" [ Js.from value ]) then
        value
    else
        Js.to (Js.call (Js.global "JSON") "stringify" [ Js.from value ])
