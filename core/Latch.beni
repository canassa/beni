--! A gate that fibers wait at (`transparent-effects-proposal.md` §17.9):
--! Effect's `Latch`.
--!
--!     ready = Latch.make False
--!     _ = Task.spawn λ⊤ →
--!         Latch.wait ready
--!         serve ⊤
--!     Latch.open ready
--!
--! **Open, a wait passes; closed, it waits.** `open` wakes every fiber that
--! waits, in the order they began to wait. `release` wakes them too, but
--! leaves the latch closed: a pulse, after which a wait still waits.
--!
--! **Waiting is cancellable and leaves nothing behind.** A fiber cancelled
--! while it waits is taken off the list at once.
--!
--! Nothing here is `foreign`: it is beni over `Task.callback` and
--! `Task.resume`.

import Js
import Js.Chain as Chain
import Task


--| A gate, open or closed, and the fibers that wait at it, in order.
pub opaque type Latch
    = Latch { opened : Js.Ref Bool, waiters : Chain.Chain (Task.Resume ⊤) }


--| A new latch, open when opened is True.
pub make : Bool → Latch
make opened = Latch { opened = Js.ref opened, waiters = Chain.make ⊤ }


--| Open the latch and resume every waiter.
pub open : Latch → ⊤
open (Latch l) =
    Js.write l.opened True
    wake l.waiters


--| Close the latch.
pub close : Latch → ⊤
close (Latch l) = Js.write l.opened False


--| Resume the current waiters without opening the latch.
pub release : Latch → ⊤
release (Latch l) = wake l.waiters


--| Wait until the latch opens or releases its current waiters.
pub wait : Latch → ⊤
wait (Latch l) =
    if not (Js.read l.opened) then
        Task.callback λresume →
            link = Chain.append l.waiters resume
            λ⊤ →
                _ = Chain.remove l.waiters link
                ⊤


--| Whether the latch is open.
pub isOpen : Latch → Bool
isOpen (Latch l) = Js.read l.opened


wake : Chain.Chain (Task.Resume ⊤) → ⊤
wake waiters =
    case Chain.shift waiters of
        Nothing →
            ⊤
        Just resume →
            Task.resume resume ⊤
            wake waiters
