--! Tons of useful functions that get imported by default.
--!
--! This module is the home of the prelude (`language.md` Appendix A): every
--! name listed there is declared here, so a module that imports nothing still
--! sees `Int`, `Bool`, `max` and the rest. It is also where the functions the
--! operators of §6.5 desugar to live: `a + b` is `add a b`, `a == b` is
--! `eq a b`, and likewise `-` `*` `/` `//` `^` `/=` `<` `>` `<=` `>=` `&&`
--! `||` and `++`, with the prefix `-` desugaring to `negate`. Those are all
--! of them: a list's spread is `List.cons` and `List.append`, and `|>` and
--! `<|` are pure syntax with no function behind them — `x |> f a` rewrites to the direct call
--! `f x a`, and `f <| x` to `f x` (§6.5, §6.7). The operators are syntax, so
--! these names are never written by hand — but they are what the checker
--! types and what the code generator emits.
--!
--! Two things Elm has are gone (`fast-compiler.md` §3.1): `comparable` and
--! `compappend`. What replaced them is the `compare` method: `<`, `>`, `<=`
--! and `>=` call the `compare` of whatever type they are given, so they
--! order a `String`, a record or a list as readily as a number, and `==`
--! calls that type's `eq` the same way.
--!
--! The `foreign` declarations here, and why each one is not beni. The
--! operators no longer route through `eq`, `neq`, `lt`, `gt`, `le` or `ge`
--! — they dispatch on the receiver's type instead — but all seven, `compare`
--! included, stay declared, exported and callable by name:
--!
--!   - `add` `sub` `mul` `fdiv` `pow` `lt` `gt` `le` `ge` — the operators.
--!     A saturated call of each is written in place as its JavaScript
--!     operator (`backend.md` §4, *Arithmetic is an operator*), and a beni
--!     body would be that same call of itself; the sibling is what a
--!     function passed as a value is.
--!   - `and` `or` — short-circuiting: a beni definition takes both sides as
--!     arguments, so both would be evaluated.
--!   - `eq` `neq` — structural equality over any representation, and
--!     `append` — concatenation over two: each asks a value's JavaScript
--!     `typeof`, whose answer is a string this module cannot write, being
--!     below `String` (`plans/core-in-beni.md`).
--!
--! The conversions and the floating-point library — `toFloat` `round`
--! `floor` `ceiling` `truncate` `idiv` `modBy` `remainderBy` `sqrt`
--! `logBase` `e` `pi` and the trigonometry, `isNaN` `isInfinite` — are beni
--! over `Js` (`boundary.md` §4.2). Everything else is ordinary beni.

import Js


--| An integer.
--|
--|     42
--|     -7
--|
--| Two integers are equal when they are the same number.
pub equatable foreign type Int


--| A double-precision floating-point number.
--|
--|     3.14
--|     1.0e9
--|
--| Two floats are equal when they are the same number.
pub equatable foreign type Float


--| A value that is either `True` or `False`. It is what `if` branches on and
--| what `&&`, `||` and `not` work with.
pub type Bool
    = True
    | False


--| The result of comparing two values: less than, equal to, or greater than.
--| Every ordering in beni is a function returning one of these, because there
--| is no `comparable` to make it implicit.
--|
--|     compare 1 2 == LT
pub type Order
    = LT
    | EQ
    | GT


--| A type with no values at all. It is impossible to build one — the only
--| constructor demands one to begin with — so a `Never` in a type says that
--| branch of the program cannot happen, and `never` turns that promise into
--| whatever value you need.
pub type Never
    = JustOneMore Never


--| Add two numbers. The `number` type variable means both `Int` and `Float`
--| work, as long as both sides agree.
--|
--|     add 3 4 == 7
--|
--| This is what `+` desugars to.
pub foreign pure add : number, number -> number


--| Subtract the second number from the first. What `-` desugars to.
--|
--|     sub 4 3 == 1
pub foreign pure sub : number, number -> number


--| Multiply two numbers. What `*` desugars to.
--|
--|     mul 2 3 == 6
pub foreign pure mul : number, number -> number


--| Floating-point division. What `/` desugars to.
--|
--|     fdiv 3 2 == 1.5
pub foreign pure fdiv : Float, Float -> Float


--| Integer division, truncated towards zero. What `//` desugars to.
--|
--|     idiv 3 2 == 1
--|     idiv (-3) 2 == -1
pub idiv : Int, Int -> Int
idiv a b =
    -- Truncated towards zero, and 0 for a zero divisor rather than
    -- Infinity: `Int` has no infinity, so answering one would put a value
    -- in the type that the type does not contain.
    if b == 0 then
        0
    else
        Js.pure
            (λ() ->
                Js.to
                    (Js.call (Js.global "Math") "trunc"
                        [ Js.from (Js.to (Js.from a) / Js.to (Js.from b)) ]
                    )
            )


--| Exponentiation. What `^` desugars to.
--|
--|     pow 3 2 == 9
pub foreign pure pow : number, number -> number


--| Check if two values are equal. Equality is structural: two values of the
--| same type are equal when they are built the same way.
--|
--|     eq 1 1 == True
--|     eq [ 1, 2 ] [ 1, 2 ] == True
--|
--| The `equatable` marker rules out the one case that cannot be decided:
--| comparing functions is a compile error, not a crash. What `==` desugars to.
pub foreign pure eq : equatable a, a -> Bool


--| Check if two values are not equal. What `/=` desugars to.
--|
--|     neq 1 2 == True
pub foreign pure neq : equatable a, a -> Bool


--| Check if the first number is less than the second. What `<` desugars to.
--|
--|     lt 1 2 == True
--|
--| Numbers only. `String.compare` orders text.
pub foreign pure lt : number, number -> Bool


--| Check if the first number is greater than the second. What `>` desugars to.
--|
--|     gt 2 1 == True
pub foreign pure gt : number, number -> Bool


--| Check if the first number is less than or equal to the second. What `<=`
--| desugars to.
--|
--|     le 1 1 == True
pub foreign pure le : number, number -> Bool


--| Check if the first number is greater than or equal to the second. What `>=`
--| desugars to.
--|
--|     ge 1 1 == True
pub foreign pure ge : number, number -> Bool


--| The logical AND, short-circuiting: the second argument is evaluated only
--| when the first is `True`. What `&&` desugars to.
--|
--|     and True False == False
pub foreign pure and : Bool, Bool -> Bool


--| The logical OR, short-circuiting: the second argument is evaluated only
--| when the first is `False`. What `||` desugars to.
--|
--|     or True False == True
pub foreign pure or : Bool, Bool -> Bool


--| Put two appendable values together. `appendable` is `String` or `List a`.
--|
--|     append "butter" "fly" == "butterfly"
--|     append [ 1, 2 ] [ 3 ] == [ 1, 2, 3 ]
--|
--| What `++` desugars to.
pub foreign pure append : appendable, appendable -> appendable


--| Convert an integer into a float.
--|
--|     toFloat 5 == 5.0
pub toFloat : Int -> Float
toFloat n = Js.to (Js.from n)


--| Round a number to the nearest integer.
--|
--|     round 1.5 == 2
--|     round (-1.5) == -1
pub round : Float -> Int
round x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "round" [ Js.from x ]))


--| Floor a number, rounding down.
--|
--|     floor 1.9 == 1
pub floor : Float -> Int
floor x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "floor" [ Js.from x ]))


--| Ceiling a number, rounding up.
--|
--|     ceiling 1.1 == 2
pub ceiling : Float -> Int
ceiling x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "ceil" [ Js.from x ]))


--| Truncate a number, dropping the decimal part.
--|
--|     truncate 1.9 == 1
--|     truncate (-1.9) == -1
pub truncate : Float -> Int
truncate x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "trunc" [ Js.from x ]))


--| Perform modular arithmetic: the number first, then the modulus. The
--| result has the sign of the modulus.
--|
--|     modBy (-1) 4 == 3
--|     modBy 11 4 == 3
--|
--| The number comes first so a pipeline reads: `n |> modBy 2` is `modBy n 2`.
pub modBy : Int, Int -> Int
modBy n k =
    -- `%` takes the sign of the dividend; this answer takes the modulus's.
    if k == 0 then 0 else Js.rem (Js.rem n k + k) k


--| Get the remainder after dividing the first number by the second. The
--| result has the sign of the dividend, the number being divided.
--|
--|     remainderBy (-1) 4 == -1
--|     remainderBy 11 4 == 3
pub remainderBy : Int, Int -> Int
remainderBy n k = if k == 0 then 0 else Js.rem n k


--| Take the square root of a number.
--|
--|     sqrt 9 == 3
pub sqrt : Float -> Float
sqrt x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "sqrt" [ Js.from x ]))


--| Calculate the logarithm of a number in a given base: the number first,
--| then the base.
--|
--|     logBase 100 10 == 2
pub logBase : Float, Float -> Float
logBase x base =
    Js.pure
        (λ() ->
            Js.to (Js.call (Js.global "Math") "log" [ Js.from x ])
                / Js.to (Js.call (Js.global "Math") "log" [ Js.from base ])
        )


--| An approximation of Euler's constant.
pub e : Float
e = Js.pure (λ() -> Js.to (Js.get (Js.global "Math") "E"))


--| An approximation of pi.
pub pi : Float
pi = Js.pure (λ() -> Js.to (Js.get (Js.global "Math") "PI"))


--| Figure out the cosine of an angle in radians.
pub cos : Float -> Float
cos x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "cos" [ Js.from x ]))


--| Figure out the sine of an angle in radians.
pub sin : Float -> Float
sin x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "sin" [ Js.from x ]))


--| Figure out the tangent of an angle in radians.
pub tan : Float -> Float
tan x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "tan" [ Js.from x ]))


--| Figure out the arccosine of a number, in radians.
pub acos : Float -> Float
acos x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "acos" [ Js.from x ]))


--| Figure out the arcsine of a number, in radians.
pub asin : Float -> Float
asin x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "asin" [ Js.from x ]))


--| Figure out the arctangent of a number, in radians. Prefer `atan2` when you
--| have both sides of the triangle: it can tell the quadrants apart.
pub atan : Float -> Float
atan x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "atan" [ Js.from x ]))


--| Figure out the arctangent of `y / x` in radians, keeping the signs of both
--| arguments so the answer lands in the right quadrant.
pub atan2 : Float, Float -> Float
atan2 y x = Js.pure (λ() -> Js.to (Js.call (Js.global "Math") "atan2" [ Js.from y, Js.from x ]))


--| Determine whether a float is an undefined or unrepresentable number.
--|
--|     isNaN (0 / 0) == True
--|     isNaN (sqrt (-1)) == True
pub isNaN : Float -> Bool
isNaN x = Js.pure (λ() -> Js.to (Js.call (Js.global "Number") "isNaN" [ Js.from x ]))


--| Determine whether a float is positive or negative infinity.
--|
--|     isInfinite (1 / 0) == True
pub isInfinite : Float -> Bool
isInfinite x =
    -- NaN's absolute value is NaN, which is not `Infinity`.
    Js.pure (λ() -> Js.same (Js.call (Js.global "Math") "abs" [ Js.from x ]) (Js.global "Infinity"))


--| Negate a number.
--|
--|     negate 42 == -42
--|
--| This is what the prefix `-` desugars to, which is why it is written as a
--| subtraction from zero rather than as `-n`.
pub negate : number -> number
negate n = 0 - n


--| Get the absolute value of a number.
--|
--|     abs (-25) == 25
pub abs : number -> number
abs n =
    if n < 0 then
        negate n
    else
        n


--| Find the larger of two numbers.
--|
--|     max 42 12345678 == 12345678
pub max : number, number -> number
max x y =
    if x > y then
        x
    else
        y


--| Find the smaller of two numbers.
--|
--|     min 42 12345678 == 42
pub min : number, number -> number
min x y =
    if x < y then
        x
    else
        y


--| Clamp a number between a lower and an upper bound: the number first, then
--| the bounds.
--|
--|     clamp 42 100 200 == 100
--|     clamp 178 100 200 == 178
pub clamp : number, number, number -> number
clamp n low high =
    if n < low then
        low
    else if n > high then
        high
    else
        n


--| Compare two numbers.
--|
--|     compare 3 4 == LT
--|     compare 4 4 == EQ
--|
--| Only numbers. Ordering anything else is an explicit function you pass in,
--| such as `String.compare` or a lambda over a record field.
pub compare : number, number -> Order
compare x y =
    if x < y then
        LT
    else if x > y then
        GT
    else
        EQ


--| Negate a boolean value.
--|
--|     not True == False
pub not : Bool -> Bool
not b =
    if b then
        False
    else
        True


--| The exclusive-or of two booleans: `True` when exactly one of them is.
--|
--|     xor True False == True
--|     xor True True == False
pub xor : Bool, Bool -> Bool
xor a b =
    if a then
        not b
    else
        b


--| Given a value, return exactly the same value. Useful as the "do nothing"
--| argument to a higher-order function.
--|
--|     identity 42 == 42
pub identity : a -> a
identity a = a


--| Return the first argument and ignore the second. With the `_` placeholder
--| it is still the "do nothing" argument to a higher-order function.
--|
--|     always 0 1 == 0
--|     List.map [ 1, 2, 3 ] (always 0 _) == [ 0, 0, 0 ]
pub always : a, b -> a
always a _ = a


--| A function that can never be called, turned into any type you like. If you
--| hold a `Never` you are in a branch that cannot happen, and this is how you
--| tell the type checker so.
pub never : Never -> a
never (JustOneMore nvr) = never nvr


--| Convert degrees to the standard angle unit, radians.
--|
--|     degrees 180 == 3.141592653589793
pub degrees : Float -> Float
degrees angle = angle * pi / 180


--| Convert radians to the standard angle unit, radians. This is `identity`,
--| and exists so an angle's unit is written down at the point it is chosen.
--|
--|     radians pi == 3.141592653589793
pub radians : Float -> Float
radians angle = angle


--| Convert turns to the standard angle unit, radians. One turn is 360 degrees.
--|
--|     turns 0.5 == 3.141592653589793
pub turns : Float -> Float
turns angle = 2 * pi * angle


--| Convert Cartesian coordinates to polar coordinates.
--|
--|     toPolar ( 0, 1 ) == ( 1, 1.5707963267948966 )
pub toPolar : ( Float, Float ) -> ( Float, Float )
toPolar ( x, y ) = ( sqrt (x * x + y * y), atan2 y x )


--| Convert polar coordinates to Cartesian coordinates.
--|
--|     fromPolar ( 1, 0 ) == ( 1, 0 )
pub fromPolar : ( Float, Float ) -> ( Float, Float )
fromPolar ( radius, theta ) = ( radius * cos theta, radius * sin theta )
