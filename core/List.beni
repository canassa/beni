--! You can create a list in beni with the `[ 1, 2, 3 ]` syntax, so lists are
--! used all over the place. This module has a bunch of functions to help you
--! work with them.
--!
--! Argument order here is **subject first and function last**: the value the
--! function is about comes first, so `xs |> map f` inserts it at the front,
--! and the function comes last, so a lambda you write inline is the final
--! argument. Two kinds of declaration sit outside that sentence, in opposite
--! directions. `cons` is ordered by the operator instead — `::` desugars to a
--! call of it, so it is element before list rather than something you pipe
--! into. And the builders take no list at all, so "the list comes first"
--! cannot be what subject first means for them: `repeat` is still subject
--! first, with the value repeated before the count, exactly as `String.repeat`
--! is, while `range lo hi` has no subject to put first.
--!
--! Three declarations here are `foreign`, and nothing else is:
--!
--!   - `cons : a, List a -> List a` — `::` desugars to a call of this
--!     function, so a beni definition of it would call itself. Its order is
--!     the operator's, element before list, not a pipeline's.
--!   - `eq : List a, List a -> Bool where a.eq` — what `==` on a list means.
--!     `List a` has no constructors, so the compiler has nothing to derive a
--!     body from, and the shape of a cons cell belongs to the code generator
--!     rather than to beni.
--!   - `compare : List a, List a -> Order where a.compare` — what `<` and
--!     its three relatives on a list mean, for the same two reasons, and a
--!     loop for the same reason `foldr` is one.
--!
--! `List a` is equal to another list when they have the same elements in the
--! same order, by each element's own `eq` — which is what makes `==` on a
--! list of a type with an `eq` of its own answer that type's question and not
--! a structural walk's. It is ordered the same way, element by element by
--! each element's own `compare`, with a shorter list `LT` against a longer
--! one that starts the same.
--!
--! There is no `comparable` (`fast-compiler.md` §3.1). What replaced it is
--! the `compare` method, so the ordering functions ask for one rather than
--! for a number: `sort` for anything that has a `compare`, `sortBy` for
--! anything with a key that does, and `sortWith` for an ordering you write
--! yourself, which is how you sort by something that is not the type's own
--! order.

--| A list of values, all of the same type. `[]` is the empty list and `::`
--| puts one more value on the front.
--|
--|     [ 1, 2, 3 ]
--|     1 :: [ 2, 3 ]
--|
--| Equatable when the element type is.
pub equatable foreign type List a


--| Add an element to the front of a list.
--|
--|     cons 1 [ 2, 3 ] == [ 1, 2, 3 ]
--|
--| This is what `::` desugars to, which is why the element comes first here
--| while every other function in this module takes the list first.
pub foreign pure cons : a, List a -> List a


--| Reduce a list from the left, starting from an initial value.
--|
--|     foldl [ 1, 2, 3 ] [] cons == [ 3, 2, 1 ]
--|
--| The recursive call is in tail position, so the code generator turns it
--| into a loop (`backend.md` §8) and this walks a list of any length.
pub foldl : List a, b, (a, b -> b) -> b
foldl xs acc func =
    case xs of
        [] ->
            acc

        x :: rest ->
            foldl rest (func x acc) func


--| Reduce a list from the right, starting from an initial value.
--|
--|     foldr [ 1, 2, 3 ] [] cons == [ 1, 2, 3 ]
--|
--| This is the one function here that calls its callback back to front, and
--| that is its contract rather than an accident of how it is written
--| (`checker.md` Appendix B): the last element is handed to `func` first.
--| Nothing built on it may inherit that order — see `map`.
--|
--| Reverse, then fold from the left — exact for this argument order, and
--| `reverse` is itself a `foldl`, so there is no cycle. It costs one extra
--| list of n cells per call, which is not a regression: the JavaScript this
--| replaced materialised the whole list into an array to fold it backwards.
pub foldr : List a, b, (a, b -> b) -> b
foldr xs acc func =
    foldl (reverse xs) acc func


--| Two lists are equal when they have the same elements, in the same order,
--| by each element's own `eq`.
--|
--|     [ 1, 2 ] == [ 1, 2 ]
--|
--| This is what `==` on a list calls. It is written here rather than derived
--| because `List a` has no constructors for the compiler to walk, and it is
--| written in JavaScript because the representation of a list is the code
--| generator's rather than beni's.
pub foreign pure eq : List a, List a -> Bool
    where a.eq : a, a -> Bool


--| Order two lists element by element, by each element's own `compare`.
--| The first pair that differs decides; if one list runs out first while
--| everything before matched, the shorter one is `LT`.
--|
--|     compare [ 1, 2 ] [ 1, 2, 3 ] == LT
--|
--| This is what `<`, `<=`, `>` and `>=` on a list call. Like `eq` it is
--| written here rather than derived, for the same two reasons: `List a` has
--| no constructors to walk, and the shape of a cons cell belongs to the
--| code generator.
pub foreign pure compare : List a, List a -> Order
    where a.compare : a, a -> Order


--| Create a list with only one element.
--|
--|     singleton 1234 == [ 1234 ]
pub singleton : a -> List a
singleton value =
    [ value ]


--| Create a list with `n` copies of a value.
--|
--|     repeat 0 3 == [ 0, 0, 0 ]
pub repeat : a, Int -> List a
repeat value n =
    repeatHelp [] n value


repeatHelp : List a, Int, a -> List a
repeatHelp result n value =
    if n <= 0 then
        result
    else
        repeatHelp (value :: result) (n - 1) value


--| Create a list of numbers, every element increasing by one. You give the
--| lowest and the highest number that should be in the list.
--|
--|     range 3 6 == [ 3, 4, 5, 6 ]
--|     range 3 3 == [ 3 ]
--|     range 6 3 == []
pub range : Int, Int -> List Int
range lo hi =
    rangeHelp lo hi []


rangeHelp : Int, Int, List Int -> List Int
rangeHelp lo hi list =
    if lo <= hi then
        rangeHelp lo (hi - 1) (hi :: list)
    else
        list


--| Apply a function to every element of a list.
--|
--|     map [ 1, 4, 9 ] negate == [ -1, -4, -9 ]
--|
--| `func` is called on the first element first (`checker.md` Appendix B).
--|
--| This is the plain recursion, `func x :: map rest func`, and it walks a
--| list of any length: a self-call under `::` is a **cons step**, which the
--| code generator compiles to one loop that builds the result front to back
--| (`backend.md` §8, *Tail calls modulo cons*) — n cells, no `reverse`, no
--| stack. The head is evaluated before the loop moves on, so `func` sees
--| the elements in list order, as the recursion would. Every function below
--| that builds a list is written the same way.
pub map : List a, (a -> b) -> List b
map xs func =
    case xs of
        [] ->
            []

        x :: rest ->
            func x :: map rest func


--| Same as `map` but the function is also given the index of each element,
--| starting at zero.
--|
--|     indexedMap [ "a", "b" ] (\i x -> ( i, x )) == [ ( 0, "a" ), ( 1, "b" ) ]
pub indexedMap : List a, (Int, a -> b) -> List b
indexedMap xs func =
    indexedMapHelp xs 0 func


indexedMapHelp : List a, Int, (Int, a -> b) -> List b
indexedMapHelp xs index func =
    case xs of
        [] ->
            []

        x :: rest ->
            func index x :: indexedMapHelp rest (index + 1) func


--| Keep the elements that pass the test.
--|
--|     filter [ 1, 2, 3, 4 ] (\n -> modBy n 2 == 0) == [ 2, 4 ]
--|
--| `isGood` is asked about the first element first. A dropped element is an
--| ordinary tail call, so it costs no cell; the result is a new list even
--| when nothing was dropped.
pub filter : List a, (a -> Bool) -> List a
filter list isGood =
    case list of
        [] ->
            []

        x :: rest ->
            if isGood x then
                x :: filter rest isGood
            else
                filter rest isGood


--| Filter out certain values. For example, to get all the heads of a list of
--| lists, filter out the empty ones in the same pass that unwraps the rest.
--|
--|     filterMap [ [ 1, 2 ], [], [ 3 ] ] head == [ 1, 3 ]
--|
--| `func` sees the first element first.
pub filterMap : List a, (a -> Maybe b) -> List b
filterMap xs func =
    case xs of
        [] ->
            []

        x :: rest ->
            case func x of
                Just value ->
                    value :: filterMap rest func

                Nothing ->
                    filterMap rest func


--| Determine the length of a list.
--|
--|     length [ 1, 2, 3 ] == 3
pub length : List a -> Int
length xs =
    foldl xs 0 (\_ n -> n + 1)


--| Reverse a list.
--|
--|     reverse [ 1, 2, 3 ] == [ 3, 2, 1 ]
pub reverse : List a -> List a
reverse list =
    foldl list [] cons


--| Figure out whether a list contains a value. The element type has to have
--| an `eq`, which rules out lists of functions.
--|
--|     member [ 1, 2, 3 ] 9 == False
--|     member [ 1, 4, 9 ] 4 == True
pub member : List a, a -> Bool
    where a.eq : a, a -> Bool
member xs value =
    any xs (\x -> x == value)


--| Determine if all elements satisfy some test.
--|
--|     all [ 2, 4 ] (\n -> modBy n 2 == 0) == True
--|     all [] (\n -> modBy n 2 == 0) == True
pub all : List a, (a -> Bool) -> Bool
all list isOkay =
    not (any list (\x -> not (isOkay x)))


--| Determine if any elements satisfy some test.
--|
--|     any [ 2, 3 ] (\n -> modBy n 2 == 0) == True
--|     any [] (\n -> modBy n 2 == 0) == False
pub any : List a, (a -> Bool) -> Bool
any list isOkay =
    case list of
        [] ->
            False

        x :: rest ->
            if isOkay x then
                True
            else
                any rest isOkay


--| Find the maximum element in a non-empty list of numbers. Elm's version
--| takes any `comparable`; this one takes numbers, and folding with `max`
--| over a key function covers the rest.
--|
--|     maximum [ 1, 4, 2 ] == Just 4
--|     maximum [] == Nothing
pub maximum : List number -> Maybe number
maximum list =
    case list of
        x :: rest ->
            Just (foldl rest x max)

        [] ->
            Nothing


--| Find the minimum element in a non-empty list of numbers.
--|
--|     minimum [ 3, 2, 1 ] == Just 1
--|     minimum [] == Nothing
pub minimum : List number -> Maybe number
minimum list =
    case list of
        x :: rest ->
            Just (foldl rest x min)

        [] ->
            Nothing


--| Get the sum of the list elements.
--|
--|     sum [ 1, 2, 3 ] == 6
pub sum : List number -> number
sum xs =
    foldl xs 0 (+)


--| Get the product of the list elements.
--|
--|     product [ 2, 2, 2 ] == 8
pub product : List number -> number
product xs =
    foldl xs 1 (*)


--| Put two lists together. `++` does the same thing.
--|
--|     append [ 1, 2 ] [ 3 ] == [ 1, 2, 3 ]
--|
--| `ys` is not copied: it is the result's tail, and `append xs []` is `xs`
--| itself.
pub append : List a, List a -> List a
append xs ys =
    case ys of
        [] ->
            xs

        _ ->
            appendHelp xs ys


appendHelp : List a, List a -> List a
appendHelp xs ys =
    case xs of
        [] ->
            ys

        x :: rest ->
            x :: appendHelp rest ys


--| Concatenate a bunch of lists into a single list.
--|
--|     concat [ [ 1, 2 ], [ 3 ], [] ] == [ 1, 2, 3 ]
--|
--| The last list that is not empty is not copied: it is the result's tail,
--| as it was when this was `append` folded from the right, so `concat [ xs
--| ]` is `xs` itself.
pub concat : List (List a) -> List a
concat lists =
    concatHelp [] [] lists


--| `copying` is what is left of the list being copied, `pending` the last
--| non-empty list met, not yet copied because it may turn out to be the
--| last and then is shared instead.
concatHelp : List a, List a, List (List a) -> List a
concatHelp copying pending lists =
    case copying of
        x :: more ->
            x :: concatHelp more pending lists

        [] ->
            case lists of
                [] ->
                    pending

                [] :: rest ->
                    concatHelp [] pending rest

                next :: rest ->
                    concatHelp pending next rest


--| Map a given function onto a list and flatten the resulting lists.
--|
--|     concatMap [ 1, 2 ] (\x -> [ x, x ]) == [ 1, 1, 2, 2 ]
--|
--| `func` is called on the first element first, and the last list it
--| answers that is not empty is shared rather than copied, exactly as
--| `concat (map list func)` shares it — in one pass, without that
--| intermediate list.
pub concatMap : List a, (a -> List b) -> List b
concatMap list func =
    concatMapHelp [] [] list func


concatMapHelp : List b, List b, List a, (a -> List b) -> List b
concatMapHelp copying pending list func =
    case copying of
        x :: more ->
            x :: concatMapHelp more pending list func

        [] ->
            case list of
                [] ->
                    pending

                y :: rest ->
                    case func y of
                        [] ->
                            concatMapHelp [] pending rest func

                        next ->
                            concatMapHelp pending next rest func


--| Places the given value between all members of the given list.
--|
--|     intersperse [ "turtles", "turtles" ] "on" == [ "turtles", "on", "turtles" ]
pub intersperse : List a, a -> List a
intersperse xs sep =
    case xs of
        [] ->
            []

        hd :: tl ->
            hd :: intersperseHelp tl sep


intersperseHelp : List a, a -> List a
intersperseHelp xs sep =
    case xs of
        [] ->
            []

        x :: rest ->
            sep :: x :: intersperseHelp rest sep


--| Combine two lists, combining them with the given function. If one list is
--| longer, the extra elements are dropped.
--|
--|     map2 [ 1, 2, 3 ] [ 10, 20 ] (+) == [ 11, 22 ]
--|
--| `func` is called on the first elements first, and not at all for the tail
--| the shorter list does not reach. `func x y :: map2 …` was once the
--| spelling that died at about 5 700 elements, because it recursed to the
--| length of the list; it is a cons step now, compiled to a loop (see
--| `map`). `map3`–`map5` are the same shape, one argument wider each.
pub map2 : List a, List b, (a, b -> result) -> List result
map2 xs ys func =
    case ( xs, ys ) of
        ( x :: xrest, y :: yrest ) ->
            func x y :: map2 xrest yrest func

        _ ->
            []


--| Combine three lists, combining them with the given function.
pub map3 : List a, List b, List c, (a, b, c -> result) -> List result
map3 xs ys zs func =
    case ( xs, ys, zs ) of
        ( x :: xrest, y :: yrest, z :: zrest ) ->
            func x y z :: map3 xrest yrest zrest func

        _ ->
            []


--| Combine four lists, combining them with the given function.
pub map4 : List a, List b, List c, List d, (a, b, c, d -> result) -> List result
map4 xs ys zs ws func =
    case ( xs, ys, zs, ws ) of
        ( x :: xrest, y :: yrest, z :: zrest, w :: wrest ) ->
            func x y z w :: map4 xrest yrest zrest wrest func

        _ ->
            []


--| Combine five lists, combining them with the given function.
pub map5 :
    List a
    , List b
    , List c
    , List d
    , List e
    , (a, b, c, d, e -> result)
    -> List result
map5 xs ys zs ws vs func =
    case ( xs, ys, zs, ws, vs ) of
        ( x :: xrest, y :: yrest, z :: zrest, w :: wrest, v :: vrest ) ->
            func x y z w v :: map5 xrest yrest zrest wrest vrest func

        _ ->
            []


--| Sort a list from lowest to highest, by the element type's own `compare`.
--|
--|     sort [ 3, 1, 5 ] == [ 1, 3, 5 ]
--|
--| Elm sorts any `comparable`; beni has none, so this one asks the element
--| type for its `compare` method and sorts by what it answers.
pub sort : List a -> List a
    where a.compare : a, a -> Order
sort xs =
    sortWith xs (\x y -> x.compare y)


--| Sort values by a key read out of each of them. The key can be of any
--| type that has a `compare`, not only a number.
--|
--|     sortBy [ { age = 30 }, { age = 20 } ] .age == [ { age = 20 }, { age = 30 } ]
--|
--| `toKey` is called **exactly once per element, on the first element
--| first** (`checker.md` Appendix B), which is what decorate–sort–undecorate
--| buys: `map` reads the keys in list order, the pairs are sorted by their
--| first component alone, and `map` reads the elements back out. The
--| spelling this replaced, `sortWith xs (\x y -> (toKey x).compare (toKey
--| y))`, called `toKey` once per COMPARISON — six times for a three-element
--| list, and not at all for a one-element one — so an expensive key was
--| recomputed and an effectful one would run its effect a number of times
--| nobody could predict. The COMPARATOR's order and count stay unspecified,
--| which is inherent to a sort. Both `map`s are loops (see `map`), so the
--| decoration is as stack-safe as the merge.
--|
--| Ties are `EQ` on the key, and `mergeWith` takes the left element on `EQ`,
--| so this is as stable as `sortWith` is.
pub sortBy : List a, (a -> b) -> List a
    where b.compare : b, b -> Order
sortBy xs toKey =
    let
        decorated =
            map xs (\x -> ( toKey x, x ))

        sorted =
            sortWith decorated (\( left, _ ) ( right, _ ) -> left.compare right)
    in
    map sorted (\( _, x ) -> x)


--| Sort values with an ordering function you write yourself, which is how
--| you sort by something that is not the type's own order.
--|
--|     sortWith [ 1, 2, 3 ] (\x y -> Basics.compare y x) == [ 3, 2, 1 ]
--|
--| The sort is a stable merge sort: equal elements keep the order they were
--| given in, and that is a contract rather than an accident of the merge
--| (`checker.md` Appendix B) — `mergeWith` takes the LEFT element on
--| anything but `GT`, and the front half, the first ⌊n / 2⌋ elements, stays
--| in front. The order in which `cmp` is asked, and how many times, stays
--| unspecified.
pub sortWith : List a, (a, a -> Order) -> List a
sortWith list cmp =
    case list of
        [] ->
            []

        [ _ ] ->
            list

        _ ->
            mergeWith
                (sortWith (frontHalf list list) cmp)
                (sortWith (backHalf list list) cmp)
                cmp


--| The first ⌊n / 2⌋ elements of a list of n: a slow pointer taking one
--| element for every two the fast one passes, built front to back (see
--| `map`).
frontHalf : List a, List a -> List a
frontHalf slow fast =
    case fast of
        _ :: _ :: fastRest ->
            case slow of
                x :: slowRest ->
                    x :: frontHalf slowRest fastRest

                [] ->
                    []

        _ ->
            []


--| What `frontHalf` leaves: the list itself, not a copy, after ⌊n / 2⌋
--| elements.
backHalf : List a, List a -> List a
backHalf slow fast =
    case fast of
        _ :: _ :: fastRest ->
            case slow of
                _ :: slowRest ->
                    backHalf slowRest fastRest

                [] ->
                    slow

        _ ->
            slow


--| Merge two sorted lists into one. On `EQ` the left element wins, which is
--| what makes `sortWith` stable. What is left of one list when the other
--| runs out is the result's tail, not a copy.
mergeWith : List a, List a, (a, a -> Order) -> List a
mergeWith left right cmp =
    case left of
        [] ->
            right

        x :: xrest ->
            case right of
                [] ->
                    left

                y :: yrest ->
                    case cmp x y of
                        GT ->
                            y :: mergeWith left yrest cmp

                        _ ->
                            x :: mergeWith xrest right cmp


--| Determine if a list is empty.
--|
--|     isEmpty [] == True
pub isEmpty : List a -> Bool
isEmpty xs =
    case xs of
        [] ->
            True

        _ ->
            False


--| Extract the first element of a list.
--|
--|     head [ 1, 2, 3 ] == Just 1
--|     head [] == Nothing
pub head : List a -> Maybe a
head list =
    case list of
        x :: _ ->
            Just x

        [] ->
            Nothing


--| Extract the rest of the list.
--|
--|     tail [ 1, 2, 3 ] == Just [ 2, 3 ]
--|     tail [] == Nothing
pub tail : List a -> Maybe (List a)
tail list =
    case list of
        _ :: xs ->
            Just xs

        [] ->
            Nothing


--| Take the first `n` members of a list.
--|
--|     take [ 1, 2, 3 ] 2 == [ 1, 2 ]
pub take : List a, Int -> List a
take list n =
    if n <= 0 then
        []
    else
        case list of
            [] ->
                []

            x :: xs ->
                x :: take xs (n - 1)


--| Drop the first `n` members of a list.
--|
--|     drop [ 1, 2, 3 ] 2 == [ 3 ]
pub drop : List a, Int -> List a
drop list n =
    if n <= 0 then
        list
    else
        case list of
            [] ->
                list

            _ :: xs ->
                drop xs (n - 1)


--| Partition a list based on some test. The first list contains all values
--| that satisfy the test, and the second list contains all the value that do
--| not.
--|
--|     partition [ 1, 2, 3, 4 ] (\n -> modBy n 2 == 0) == ( [ 2, 4 ], [ 1, 3 ] )
--|
--| `pred` is asked about each element once, the first element first. This
--| one function still accumulates and reverses: it builds two lists, and a
--| cons step has one destination. Its two accumulators are parameters of
--| the loop rather than a pair rebuilt per element.
pub partition : List a, (a -> Bool) -> ( List a, List a )
partition list pred =
    partitionHelp list pred [] []


partitionHelp : List a, (a -> Bool), List a, List a -> ( List a, List a )
partitionHelp list pred trues falses =
    case list of
        [] ->
            ( reverse trues, reverse falses )

        x :: rest ->
            if pred x then
                partitionHelp rest pred (x :: trues) falses
            else
                partitionHelp rest pred trues (x :: falses)


--| Decompose a list of tuples into a tuple of lists.
--|
--|     unzip [ ( 0, True ), ( 17, False ) ] == ( [ 0, 17 ], [ True, False ] )
pub unzip : List ( a, b ) -> ( List a, List b )
unzip pairs =
    ( map pairs (\( x, _ ) -> x), map pairs (\( _, y ) -> y) )
