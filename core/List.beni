--! Lists keep their element types throughout the runtime, including callbacks
--! and native handles. Private typed array operations are lowered in place.

import Js


--| A list of values of the same type.
pub equatable sequence foreign type List a


type alias Builder a =
    Js.Builder a


--| Add an element to the front. Rejoining a pattern's rest preserves identity.
pub cons : stored a, returned List a → prepended List a
cons x xs =
    b = base xs
    o = offset xs
    if o > 0 && Js.same (at b (o - 1)) x then
        if o == 1 then b else viewOf b (o - 1) viewToken
    else
        copied = put (builder (length xs + 1)) 0 x
        done (copyInto b o (length b) copied 1) (length xs + 1)


--| Put two lists together, in order. Appending a shorter right side to a
--| tree-backed left side grows its tail; each singleton append is amortised
--| O(1). Empty operands still produce a fresh list.
pub append : written List a, borrowed List a → concatenated List a
append xs ys =
    n = length xs
    m = length ys
    if n ≥ 32 && m > 0 && m < n then
        appendFrom xs (base ys) (offset ys) (offset ys + m)
    else
        first = copyInto (base xs) (offset xs) (offset xs + n) (builder (n + m)) 0
        done (copyInto (base ys) (offset ys) (offset ys + m) first n) (n + m)


appendFrom : List a, List a, Int, Int → List a
appendFrom xs b i end =
    if i < end then
        appendFrom (push xs (at b i)) b (i + 1) end
    else
        xs


--| The number of elements.
pub foreign pure length : borrowed List a → Int


--| Equal elements in the same order, by their own eq method.
pub eq : List a, List a → Bool
    where a.eq : a, a → Bool
eq xs ys = length xs == length ys && eqFrom (base xs) (offset xs) (base ys) (offset ys)


eqFrom : List a, Int, List a, Int → Bool
    where a.eq : a, a → Bool
eqFrom a i b j =
    if i < length a then
        if at a i == at b j then
            eqFrom a (i + 1) b (j + 1)
        else
            False
    else
        True


--| Compare elements in order by their own compare method.
pub compare : List a, List a → Order
    where a.compare : a, a → Order
compare xs ys = compareFrom (base xs) (offset xs) (base ys) (offset ys)


compareFrom : List a, Int, List a, Int → Order
    where a.compare : a, a → Order
compareFrom a i b j =
    if i < length a && j < length b then
        case (at a i).compare (at b j) of
            EQ →
                compareFrom a (i + 1) b (j + 1)
            order →
                order
    else if i < length a then
        GT
    else if j < length b then
        LT
    else
        EQ


--| Replace an element. An invalid index or the same value leaves the list alone.
pub set : written returned List a, borrowed Int, stored a → List a
set xs i value =
    if outside i (length xs) then
        xs
    else if Js.same (unsafeGet xs i) value then
        xs
    else if isTree xs || length xs > 256 then
        Js.pure λ⊤ →
            previous =
                if isTree xs then
                    treeOf xs
                else
                    fromArray (base xs) (offset xs) (offset xs + length xs) (emptyHeader ⊤)
            header (setHeader previous i value)
    else
        b = copyInto (base xs) (offset xs) (offset xs + length xs) (builder (length xs)) 0
        done (put b i value) (length xs)


--| Add an element at the end in amortised O(1). An earlier version keeps
--| its elements: branching from an already claimed tail copies at most 32.
pub push : written returned List a, stored a → List a
push xs value = Js.pure λ⊤ →
    n = length xs
    if n < 32 then
        b = copyInto (base xs) (offset xs) (offset xs + n) (builder (n + 1)) 0
        done (put b n value) (n + 1)
    else
        previous =
            if isTree xs then
                treeOf xs
            else
                fromArray (base xs) (offset xs) (offset xs + n) (emptyHeader ⊤)
        header (pushHeader previous value)


--| Remove the last element. An empty list is left alone.
pub pop : written returned List a → List a
pop xs = Js.pure λ⊤ →
    n = length xs
    if n == 0 then
        xs
    else if n == 1 then
        []
    else if n < 32 then
        sliceOf xs 0 (n - 1)
    else
        previous =
            if isTree xs then
                treeOf xs
            else
                fromArray (base xs) (offset xs) (offset xs + n) (emptyHeader ⊤)
        header (popHeader previous)


--| A fresh list of elements from from up to to. Negative indexes count from the end.
pub slice : List a, Int, Int → List a
slice xs from to =
    n = length xs
    f = clampIndex from n
    t = clampIndex to n
    if f ≥ t then [] else sliceOf xs f t


clampIndex : Int, Int → Int
clampIndex i n = Js.pure λ⊤ →
    j = Js.call (Js.global "Math") "trunc" [ Js.from i ]
    if Js.to j ≥ 0 then
        Js.to (Js.call (Js.global "Math") "min" [ j, Js.from n ])
    else if Js.to j < 0 then
        Js.to (Js.call (Js.global "Math") "max" [ Js.from 0, Js.from (n + Js.to j) ])
    else
        0


--| A fresh list with the same elements. The elements themselves are not copied.
pub copy : borrowed List a → copyof List a
copy xs = sliceOf xs 0 (length xs)


sliceOf : borrowed List a, borrowed Int, borrowed Int → copyof List a
sliceOf xs from to =
    o = offset xs
    done (copyInto (base xs) (o + from) (o + to) (builder (to - from)) 0) (to - from)


--| Insert an element at an index, or leave the list alone when the index is invalid.
pub insertAt : written returned List a, borrowed Int, stored a → List a
insertAt xs i value =
    n = length xs
    if outside i (n + 1) then
        xs
    else
        b = base xs
        o = offset xs
        first = copyInto b o (o + i) (builder (n + 1)) 0
        added = put first i value
        done (copyInto b (o + i) (o + n) added (i + 1)) (n + 1)


--| Remove an element at an index, or leave the list alone when the index is invalid.
pub removeAt : written returned List a, borrowed Int → List a
removeAt xs i =
    n = length xs
    if outside i n then
        xs
    else
        b = base xs
        o = offset xs
        first = copyInto b o (o + i) (builder (n - 1)) 0
        done (copyInto b (o + i + 1) (o + n) first i) (n - 1)


--| Exchange two elements. Invalid or equal indexes leave the list alone.
pub swap : written returned List a, borrowed Int, borrowed Int → List a
swap xs i j =
    n = length xs
    if outside i n || outside j n || i == j then
        xs
    else
        x = unsafeGet xs i
        y = unsafeGet xs j
        set (set xs i y) j x


unsafeGet : borrowed List a, borrowed Int → elementof a
unsafeGet xs i = Js.pure λ⊤ →
    if isTree xs then
        headerGet (treeOf xs) i
    else
        at (base xs) (offset xs + i)


outside : Int, Int → Bool
outside i n = Js.shiftRightZero i 0 ≠ i || i ≥ n


view : returned List a, borrowed Int → List a
view xs k =
    if k == 0 then xs else if k ≥ length xs then [] else viewOf (base xs) (offset xs + k) viewToken


-- The owner's 2026-11-02 core-only array operations. No Js.Value conversion.
foreign pure base : returned List a → List a


foreign pure offset : borrowed List a → Int


foreign pure viewOf : returned List a, borrowed Int, aliased Js.Cell { listProtocol : ⊤ } → List a


foreign pure at : borrowed List a, borrowed Int → elementof a


foreign pure traverseAt : borrowed List a, borrowed Int → taken a


foreign pure builder : unused Int → fresh exclusive Builder a


foreign pure put : written returned Builder a, borrowed Int, stored a → Builder a


foreign pure done : written returned Builder a, borrowed Int → builderdone List a


foreign pure half : Int → Int


copyInto : List a, Int, Int, Builder a, Int → Builder a
copyInto source i stop target j =
    if i < stop then copyInto source (i + 1) stop (put target j (at source i)) (j + 1) else target


close : List a, List a → List a
close b rest = if length b == 0 then rest else append b rest


--| Reduce a list from the left, starting from an initial value.
--|
--|     foldl [ 1, 2, 3 ] [] cons == [ 3, 2, 1 ]
--|
--| `func` sees the first element first. The loop is a tail call, which the
--| code generator turns into a loop (`backend.md` §8), so this walks a list
--| of any length.
pub foldl : List a, b, (a, b → b) → b
foldl xs acc func = foldlFrom (base xs) (offset xs) (offset xs + length xs) acc func


--| Fold `a[i]`, `a[i + 1]`, … `a[stop - 1]` of an array `base` returned.
foldlFrom : List a, Int, Int, b, (a, b → b) → b
foldlFrom a i stop acc func =
    if i < stop then
        foldlFrom a (i + 1) stop (func (traverseAt a i) acc) func
    else
        acc


--| Reduce a list from the right, starting from an initial value.
--|
--|     foldr [ 1, 2, 3 ] [] cons == [ 1, 2, 3 ]
--|
--| This is the one function here that calls its callback back to front, and
--| that is its contract rather than an accident of how it is written
--| (`checker.md` Appendix B): the last element is handed to `func` first.
--| Nothing built on it may inherit that order — see `map`. It walks the
--| list backwards by index and allocates nothing.
pub foldr : List a, b, (a, b → b) → b
foldr xs acc func = foldrFrom (base xs) (offset xs) (offset xs + length xs - 1) acc func


foldrFrom : List a, Int, Int, b, (a, b → b) → b
foldrFrom a o i acc func =
    if i < o then
        acc
    else
        foldrFrom a o (i - 1) (func (traverseAt a i) acc) func


--| Create a list with only one element.
--|
--|     singleton 1234 == [ 1234 ]
pub singleton : a → List a
singleton value = [ value ]


--| Create a list with `n` copies of a value.
--|
--|     repeat 0 3 == [ 0, 0, 0 ]
pub repeat : a, Int → List a
repeat value n = repeatHelp value 0 n (builder n)


repeatHelp : a, Int, Int, Builder a → List a
repeatHelp value i n b =
    if i < n then
        repeatHelp value (i + 1) n (put b i value)
    else
        done b i


--| Create a list of numbers, every element increasing by one. You give the
--| lowest and the highest number that should be in the list.
--|
--|     range 3 6 == [ 3, 4, 5, 6 ]
--|     range 3 3 == [ 3 ]
--|     range 6 3 == []
pub range : Int, Int → List Int
range lo hi = rangeHelp lo 0 (hi - lo + 1) (builder (hi - lo + 1))


rangeHelp : Int, Int, Int, Builder Int → List Int
rangeHelp lo i n b =
    if i < n then
        rangeHelp lo (i + 1) n (put b i (lo + i))
    else
        done b i


--| Create a list of `n` elements, calling `func` on each index from 0 to
--| `n - 1` in that order. A count of zero or less is `[]`.
--|
--|     initialize 4 (λi → i * i) == [ 0, 1, 4, 9 ]
--|
--| O(n).
pub initialize : Int, (Int → a) → List a
initialize n func = initializeHelp 0 n func (builder n)


initializeHelp : Int, Int, (Int → a), Builder a → List a
initializeHelp i n func b =
    if i < n then
        initializeHelp (i + 1) n func (put b i (func i))
    else
        done b i


--| Apply a function to every element of a list.
--|
--|     map [ 1, 4, 9 ] negate == [ -1, -4, -9 ]
--|
--| `func` is called on the first element first (`checker.md` Appendix B).
--| The result is a fresh list, even when every result is the element it
--| was given (`backend.md` §4, *Identity*). O(n), and the result reads at
--| O(1).
pub map : List a, (a → b) → List b
map xs func = mapHelp (base xs) (offset xs) 0 (length xs) func (builder (length xs))


--| Every loop below reads element `i` of its list as `at a (o + i)`, `a`
--| and `o` being the list's `base` and `offset`; a loop that hands the
--| element to a callback reads it with `traverseAt`.
mapHelp : List a, Int, Int, Int, (a → b), Builder b → List b
mapHelp a o i n func b =
    if i < n then
        mapHelp a o (i + 1) n func (put b i (func (traverseAt a (o + i))))
    else
        done b n


--| Same as `map` but the function is also given the index of each element,
--| starting at zero. The result is a fresh list, as `map`'s is.
--|
--|     indexedMap [ "a", "b" ] (λi x → ( i, x )) == [ ( 0, "a" ), ( 1, "b" ) ]
pub indexedMap : List a, (Int, a → b) → List b
indexedMap xs func = indexedMapHelp (base xs) (offset xs) 0 (length xs) func (builder (length xs))


indexedMapHelp : List a, Int, Int, Int, (Int, a → b), Builder b → List b
indexedMapHelp a o i n func b =
    if i < n then
        indexedMapHelp a o (i + 1) n func (put b i (func i (traverseAt a (o + i))))
    else
        done b n


--| Keep the elements that pass the test.
--|
--|     filter [ 1, 2, 3, 4 ] (λn → Int.mod n 2 == 0) == [ 2, 4 ]
--|
--| `isGood` is asked about the first element first. The result is a fresh
--| list, even when it keeps every element (`backend.md` §4, *Identity*).
--| O(n).
pub filter : List a, (a → Bool) → List a
filter xs isGood = filterHelp (base xs) (offset xs) 0 (length xs) isGood (builder (length xs)) 0


--| `j` is how many were kept: the builder has room for all that are left.
filterHelp : List a, Int, Int, Int, (a → Bool), Builder a, Int → List a
filterHelp a o i n isGood b j =
    if i < n then
        x = traverseAt a (o + i)
        if isGood x then
            filterHelp a o (i + 1) n isGood (put b j x) (j + 1)
        else
            filterHelp a o (i + 1) n isGood b j
    else
        done b j


--| Filter out certain values. For example, to get all the heads of a list of
--| lists, filter out the empty ones in the same pass that unwraps the rest.
--|
--|     filterMap [ [ 1, 2 ], [], [ 3 ] ] head == [ 1, 3 ]
--|
--| `func` sees the first element first. O(n).
pub filterMap : List a, (a → Maybe b) → List b
filterMap xs func = filterMapHelp (base xs) (offset xs) 0 (length xs) func (builder (length xs)) 0


filterMapHelp : List a, Int, Int, Int, (a → Maybe b), Builder b, Int → List b
filterMapHelp a o i n func b j =
    if i < n then
        case func (traverseAt a (o + i)) of
            Just y →
                filterMapHelp a o (i + 1) n func (put b j y) (j + 1)

            Nothing →
                filterMapHelp a o (i + 1) n func b j
    else
        done b j


--| Reverse a list.
--|
--|     reverse [ 1, 2, 3 ] == [ 3, 2, 1 ]
--|
--| A fresh list, even of fewer than two elements (`backend.md` §4,
--| *Identity*). O(n).
pub reverse : List a → List a
reverse xs = reverseHelp (base xs) (offset xs + length xs - 1) 0 (length xs) (builder (length xs))


--| `top` is the index in `a` of the list's last element.
reverseHelp : List a, Int, Int, Int, Builder a → List a
reverseHelp a top i n b =
    if i < n then
        reverseHelp a top (i + 1) n (put b i (traverseAt a (top - i)))
    else
        done b n


--| Figure out whether a list contains a value. The element type has to have
--| an `eq`, which rules out lists of functions.
--|
--|     member [ 1, 2, 3 ] 9 == False
--|     member [ 1, 4, 9 ] 4 == True
pub member : List a, a → Bool
    where a.eq : a, a → Bool
member xs value = any xs λx → x == value


--| Determine if all elements satisfy some test.
--|
--|     all [ 2, 4 ] (λn → Int.mod n 2 == 0) == True
--|     all [] (λn → Int.mod n 2 == 0) == True
pub all : List a, (a → Bool) → Bool
all xs isOkay = not (any xs λx → not (isOkay x))


--| Determine if any elements satisfy some test.
--|
--|     any [ 2, 3 ] (λn → Int.mod n 2 == 0) == True
--|     any [] (λn → Int.mod n 2 == 0) == False
pub any : List a, (a → Bool) → Bool
any xs isOkay = anyFrom (base xs) (offset xs) (offset xs + length xs) isOkay


anyFrom : List a, Int, Int, (a → Bool) → Bool
anyFrom a i stop isOkay =
    if i ≥ stop then
        False
    else if isOkay (at a i) then
        True
    else
        anyFrom a (i + 1) stop isOkay


--| Find the maximum element in a non-empty list of numbers. Elm's version
--| takes any `comparable`; this one takes numbers, and folding with `max`
--| over a key function covers the rest.
--|
--|     maximum [ 1, 4, 2 ] == Just 4
--|     maximum [] == Nothing
pub maximum : List number → Maybe number
maximum xs =
    if isEmpty xs then
        Nothing
    else
        Just (foldlFrom (base xs) (offset xs + 1) (offset xs + length xs) (unsafeGet xs 0) max)


--| Find the minimum element in a non-empty list of numbers.
--|
--|     minimum [ 3, 2, 1 ] == Just 1
--|     minimum [] == Nothing
pub minimum : List number → Maybe number
minimum xs =
    if isEmpty xs then
        Nothing
    else
        Just (foldlFrom (base xs) (offset xs + 1) (offset xs + length xs) (unsafeGet xs 0) min)


--| Get the sum of the list elements.
--|
--|     sum [ 1, 2, 3 ] == 6
pub sum : List number → number
sum xs = foldl xs 0 (+)


--| Get the product of the list elements.
--|
--|     product [ 2, 2, 2 ] == 8
pub product : List number → number
product xs = foldl xs 1 (*)


--| `a[i]` … `a[stop - 1]`, put into builder `b` from index `j` on.
putAll : Builder a, Int, List a, Int, Int → Builder a
putAll b j a i stop =
    if i < stop then
        putAll (put b j (at a i)) (j + 1) a (i + 1) stop
    else
        b


--| Concatenate a bunch of lists into a single list.
--|
--|     concat [ [ 1, 2 ], [ 3 ], [] ] == [ 1, 2, 3 ]
--|
--| A fresh list made its final size, even when only one of the lists is
--| not empty (`backend.md` §4, *Identity*), O(total): one count, then one
--| copy loop per list.
pub concat : List (List a) → List a
concat ls =
    a = base ls
    o = offset ls
    n = totalFrom a o 0
    done (concatFrom a o (builder n) 0) n


--| How many elements the lists `a[i] …` to the end of `a` hold together. A
--| list's elements end where its base array does, so every loop here stops
--| at `length a`.
totalFrom : List (List a), Int, Int → Int
totalFrom a i n =
    if i < length a then
        totalFrom a (i + 1) (n + length (at a i))
    else
        n


--| The lists `a[i] …` written into `b` from `j` on.
concatFrom : List (List a), Int, Builder a, Int → Builder a
concatFrom a i b j =
    if i < length a then
        l = at a i
        concatFrom a (i + 1) (putAll b j (base l) (offset l) (offset l + length l)) (j + length l)
    else
        b


--| Map a given function onto a list and flatten the resulting lists.
--|
--|     concatMap [ 1, 2 ] (λx → [ x, x ]) == [ 1, 1, 2, 2 ]
--|
--| `func` is called on the first element first, and once per element. It
--| is `concat (map xs func)`, a fresh list even when exactly one of the
--| answers is not empty. The answers are kept in a list of
--| their own first, so the result is made its final size once, which is
--| faster than growing it as the answers come.
pub concatMap : List a, (a → List b) → List b
concatMap xs func = concat (map xs func)


--| Places the given value between all members of the given list.
--|
--|     intersperse [ "turtles", "turtles" ] "on" == [ "turtles", "on", "turtles" ]
pub intersperse : List a, a → List a
intersperse xs sep =
    if isEmpty xs then
        []
    else
        intersperseHelp
            (base xs)
            (offset xs)
            sep
            1
            (length xs)
            (put (builder (2 * length xs - 1)) 0 (unsafeGet xs 0))


intersperseHelp : List a, Int, a, Int, Int, Builder a → List a
intersperseHelp a o sep i n b =
    if i < n then
        intersperseHelp a o sep (i + 1) n (put (put b (2 * i - 1) sep) (2 * i) (at a (o + i)))
    else
        done b (2 * n - 1)


--| Combine two lists, combining them with the given function. If one list is
--| longer, the extra elements are dropped.
--|
--|     map2 [ 1, 2, 3 ] [ 10, 20 ] (+) == [ 11, 22 ]
--|
--| `func` is called on the first elements first, and not at all for the tail
--| the shorter list does not reach. `map3`–`map5` are the same, one list
--| wider each.
pub map2 : List a, List b, (a, b → result) → List result
map2 xs ys func =
    n = min (length xs) (length ys)
    map2Help (base xs) (offset xs) (base ys) (offset ys) 0 n func (builder n)


--| `ax` and `ox` are `xs`'s base and offset, `ay` and `oy` `ys`'s, and so on
--| for `map3`–`map5`: each is a loop of its own, so that its call of `func`
--| is too.
map2Help : List a, Int, List b, Int, Int, Int, (a, b → result), Builder result → List result
map2Help ax ox ay oy i n func b =
    if i < n then
        map2Help ax ox ay oy (i + 1) n func (put b i (func (at ax (ox + i)) (at ay (oy + i))))
    else
        done b n


--| Combine three lists, combining them with the given function.
pub map3 : List a, List b, List c, (a, b, c → result) → List result
map3 xs ys zs func =
    n = min (length xs) (min (length ys) (length zs))
    map3Help (base xs) (offset xs) (base ys) (offset ys) (base zs) (offset zs) 0 n func (builder n)


map3Help :
      List a
    , Int
    , List b
    , Int
    , List c
    , Int
    , Int
    , Int
    , (a, b, c → result)
    , Builder result
    → List result
map3Help ax ox ay oy az oz i n func b =
    if i < n then
        map3Help
            ax
            ox
            ay
            oy
            az
            oz
            (i + 1)
            n
            func
            (put b i (func (at ax (ox + i)) (at ay (oy + i)) (at az (oz + i))))
    else
        done b n


--| Combine four lists, combining them with the given function.
pub map4 : List a, List b, List c, List d, (a, b, c, d → result) → List result
map4 xs ys zs ws func =
    n = min (min (length xs) (length ys)) (min (length zs) (length ws))
    map4Help
        (base xs)
        (offset xs)
        (base ys)
        (offset ys)
        (base zs)
        (offset zs)
        (base ws)
        (offset ws)
        0
        n
        func
        (builder n)


map4Help :
      List a
    , Int
    , List b
    , Int
    , List c
    , Int
    , List d
    , Int
    , Int
    , Int
    , (a, b, c, d → result)
    , Builder result
    → List result
map4Help ax ox ay oy az oz aw ow i n func b =
    if i < n then
        map4Help
            ax
            ox
            ay
            oy
            az
            oz
            aw
            ow
            (i + 1)
            n
            func
            (put b i (func (at ax (ox + i)) (at ay (oy + i)) (at az (oz + i)) (at aw (ow + i))))
    else
        done b n


--| Combine five lists, combining them with the given function.
pub map5 :
      List a
    , List b
    , List c
    , List d
    , List e
    , (a, b, c, d, e → result)
    → List result
map5 xs ys zs ws vs func =
    n = min (min (length xs) (length ys)) (min (min (length zs) (length ws)) (length vs))
    map5Help
        (base xs)
        (offset xs)
        (base ys)
        (offset ys)
        (base zs)
        (offset zs)
        (base ws)
        (offset ws)
        (base vs)
        (offset vs)
        0
        n
        func
        (builder n)


map5Help :
      List a
    , Int
    , List b
    , Int
    , List c
    , Int
    , List d
    , Int
    , List e
    , Int
    , Int
    , Int
    , (a, b, c, d, e → result)
    , Builder result
    → List result
map5Help ax ox ay oy az oz aw ow av ov i n func b =
    if i < n then
        map5Help
            ax
            ox
            ay
            oy
            az
            oz
            aw
            ow
            av
            ov
            (i + 1)
            n
            func
            (put
                b
                i
                (func
                    (at ax (ox + i))
                    (at ay (oy + i))
                    (at az (oz + i))
                    (at aw (ow + i))
                    (at av (ov + i))
                )
            )
    else
        done b n


--| Sort a list from lowest to highest, by the element type's own `compare`.
--|
--|     sort [ 3, 1, 5 ] == [ 1, 3, 5 ]
--|
--| Elm sorts any `comparable`; beni has none, so this one asks the element
--| type for its `compare` method and sorts by what it answers.
pub sort : List a → List a
    where a.compare : a, a → Order
sort xs = sortWith xs λx y → x.compare y


--| Sort values by a key read out of each of them. The key can be of any
--| type that has a `compare`, not only a number.
--|
--|     sortBy [ { age = 30 }, { age = 20 } ] .age == [ { age = 20 }, { age = 30 } ]
--|
--| `toKey` is called **exactly once per element, on the first element
--| first** (`checker.md` Appendix B), which is what decorate–sort–undecorate
--| buys: `map` reads the keys in list order, the pairs are sorted by their
--| first component alone, and `map` reads the elements back out. The
--| spelling this replaced, `sortWith xs (λx y → (toKey x).compare (toKey
--| y))`, called `toKey` once per COMPARISON — six times for a three-element
--| list, and not at all for a one-element one — so an expensive key was
--| recomputed and an effectful one would run its effect a number of times
--| nobody could predict. The COMPARATOR's order and count stay unspecified,
--| which is inherent to a sort.
--|
--| Ties are `EQ` on the key, and the merge takes the left element on `EQ`,
--| so this is as stable as `sortWith` is. The result is a fresh list, even
--| of fewer than two elements (`backend.md` §4, *Identity*).
pub sortBy : List a, (a → b) → List a
    where b.compare : b, b → Order
sortBy xs toKey =
    decorated = map xs λx → ( toKey x, x )
    map (sortWith decorated λ( left, _ ) ( right, _ ) → left.compare right) λ( _, x ) → x


--| Sort values with an ordering function you write yourself, which is how
--| you sort by something that is not the type's own order.
--|
--|     sortWith [ 1, 2, 3 ] (λx y → Basics.compare y x) == [ 3, 2, 1 ]
--|
--| The sort is a stable merge sort: equal elements keep the order they were
--| given in, and that is a contract rather than an accident of the merge
--| (`checker.md` Appendix B) — the merge takes the LEFT element on anything
--| but `GT`, and the front half, the first ⌊n / 2⌋ elements, stays in front.
--| The order in which `cmp` is asked, and how many times, stays unspecified.
--| The result is a fresh list, even of fewer than two elements
--| (`backend.md` §4, *Identity*). O(n log n), recursing to a depth of
--| log₂ n.
pub sortWith : borrowed List a, many (a, a → Order) → copyof List a
sortWith xs cmp = sortRange xs 0 (length xs) cmp


--| Elements `lo` up to `hi` of `xs`, sorted: the front half first, then the
--| back half, then the two merged.
sortRange : List a, Int, Int, (a, a → Order) → List a
sortRange xs lo hi cmp =
    if hi - lo < 2 then
        slice xs lo hi
    else
        mid = lo + half (hi - lo)
        left = sortRange xs lo mid cmp
        right = sortRange xs mid hi cmp
        merge left 0 (length left) right 0 (length right) cmp (builder (hi - lo))


--| Two sorted lists merged. On anything but `GT` the left element wins,
--| which is what makes `sortWith` stable; what is left of one list when the
--| other runs out is added after. Both are plain arrays — `sortRange`'s
--| `slice` of at most one element of a longer list, or a `merge` — so they
--| are read by `at` with no `base`.
merge : List a, Int, Int, List a, Int, Int, (a, a → Order), Builder a → List a
merge xs i n ys j m cmp b =
    if i ≥ n then
        done (putAll b (i + j) ys j m) (n + m)
    else if j ≥ m then
        done (putAll b (i + j) xs i n) (n + m)
    else
        x = at xs i
        y = at ys j
        case cmp x y of
            GT →
                merge xs i n ys (j + 1) m cmp (put b (i + j) y)

            _ →
                merge xs (i + 1) n ys j m cmp (put b (i + j) x)


--| Determine if a list is empty.
--|
--|     isEmpty [] == True
pub isEmpty : List a → Bool
isEmpty xs = length xs == 0


--| Extract the first element of a list.
--|
--|     head [ 1, 2, 3 ] == Just 1
--|     head [] == Nothing
pub head : List a → Maybe a
head xs = get xs 0


--| Extract the rest of the list.
--|
--|     tail [ 1, 2, 3 ] == Just [ 2, 3 ]
--|     tail [] == Nothing
--|
--| O(1): the rest is a view of the list, sharing its elements, which keeps
--| the whole list alive as a substring may. Of a list that has been written
--| to it is the same list without its first element, sharing its structure.
pub tail : List a → Maybe (List a)
tail xs =
    if isEmpty xs then
        Nothing
    else
        Just (view xs 1)


--| Take the first `n` members of a list. A fraction is cut toward zero.
--|
--|     take [ 1, 2, 3 ] 2 == [ 1, 2 ]
--|
--| O(n), a fresh list even when `n` covers the whole list (`backend.md` §4,
--| *Identity*).
pub take : List a, Int → List a
take xs n =
    if n ≤ 0 then
        []
    else
        slice xs 0 n


--| Drop the first `n` members of a list.
--|
--|     drop [ 1, 2, 3 ] 2 == [ 3 ]
--|
--| O(1), as `tail` is, and `drop xs 0` is `xs` itself. A fraction is cut toward
--| zero: `drop xs 1.5 == drop xs 1`.
pub drop : List a, Int → List a
drop xs n =
    if n ≤ 0 then
        xs
    else
        view xs (clampIndex n (length xs))


--| The element at an index, counting from 0, or `Nothing` when the index is
--| negative, not less than the length, or not a whole number.
--|
--|     get [ 10, 20, 30 ] 1 == Just 20
--|     get [ 10, 20, 30 ] 3 == Nothing
--|
--| Near O(1).
pub get : List a, Int → Maybe a
get xs i =
    if outside i (length xs) then
        Nothing
    else
        Just (unsafeGet xs i)


--| Extract the last element of a list.
--|
--|     last [ 1, 2, 3 ] == Just 3
--|     last [] == Nothing
--|
--| Near O(1).
pub last : List a → Maybe a
last xs = get xs (length xs - 1)


--| Replace the element at an index with what `func` makes of it. `func` is
--| called once in range and not at all out of range, where the result is
--| the list itself.
--|
--|     update [ 1, 2, 3 ] 1 (λx → x * 10) == [ 1, 20, 3 ]
--|
--| The cost of `set`, and its identities.
pub update : List a, Int, (a → a) → List a
update xs i func = focus xs i func


--| The focus primitive (`ownership-checker.md` §18.5): element `i` taken out
--| of the list, handed to `func`, and the result put back where it was. Its
--| ownership row is asserted: the element is handed out while no other
--| position holds it, so `func` may edit it in place when the list is
--| unique, exclusive and dead after the call. `update` is this.
focus : written returned List a, borrowed Int, once taken stored (a → a) → List a
focus xs i func =
    if outside i (length xs) then
        xs
    else
        set xs i (func (unsafeGet xs i))


--| Partition a list based on some test. The first list contains all values
--| that satisfy the test, and the second list contains all the value that do
--| not.
--|
--|     partition [ 1, 2, 3, 4 ] (λn → Int.mod n 2 == 0) == ( [ 2, 4 ], [ 1, 3 ] )
--|
--| `pred` is asked about each element once, the first element first. O(n).
pub partition : List a, (a → Bool) → List a × List a
partition xs pred =
    partitionHelp
        (base xs)
        (offset xs)
        0
        (length xs)
        pred
        (builder (length xs))
        (builder (length xs))
        0


--| `k` is how many passed: the rest, `i - k`, did not.
partitionHelp : List a, Int, Int, Int, (a → Bool), Builder a, Builder a, Int → List a × List a
partitionHelp a o i n pred yes no k =
    if i < n then
        x = at a (o + i)
        if pred x then
            partitionHelp a o (i + 1) n pred (put yes k x) no (k + 1)
        else
            partitionHelp a o (i + 1) n pred yes (put no (i - k) x) k
    else
        ( done yes k, done no (n - k) )


--| Decompose a list of tuples into a tuple of lists.
--|
--|     unzip [ ( 0, True ), ( 17, False ) ] == ( [ 0, 17 ], [ True, False ] )
pub unzip : List (a × b) → List a × List b
unzip pairs =
    unzipHelp
        (base pairs)
        (offset pairs)
        0
        (length pairs)
        (builder (length pairs))
        (builder (length pairs))


unzipHelp : List (a × b), Int, Int, Int, Builder a, Builder b → List a × List b
unzipHelp a o i n xs ys =
    if i < n then
        case at a (o + i) of
            ( x, y ) →
                unzipHelp a o (i + 1) n (put xs i x) (put ys i y)
    else
        ( done xs n, done ys n )


-- A persistent radix tree and a tail whose unused slots can be claimed once.
-- Headers retain their own tail count, so a later append never changes an
-- earlier list. Branching from an earlier tail copies at most 32 elements.
type Tree a
    = Leaf (List a)
    | Branch (List (Tree a))


type alias Tail a =
    Js.Cell { values : Builder a, used : Int }


type alias Header a =
    total : Int
    treeCount : Int
    root : Tree a
    shift : Int
    capacity : Int
    tail : Tail a
    cache : Js.Cell { flat : Js.Opt (List a) }


-- These are the core-only List view wrapper and its checked discriminator.
-- All tree traversal, tail claiming and flattening remain in beni.
foreign pure wrapTree :
      unused Int
    , stored Header a
    , escaped sync (⊤ → List a)
    , aliased Js.Cell { listProtocol : ⊤ }
    → List a


foreign pure treeOf : borrowed List a → Header a


foreign pure isTree : borrowed List a → Bool


header : Header a → List a
header h = wrapTree h.total h (λ⊤ → plainHeader h) viewToken


emptyHeader : ⊤ → Header a
emptyHeader _ =
    { total = 0
    , treeCount = 0
    , root = Leaf []
    , shift = 0
    , capacity = 32
    , tail = Js.cell { values = builder 32, used = 0 }
    , cache = Js.cell { flat = Js.none ⊤ }
    }


fromArray : List a, Int, Int, Header a → Header a
fromArray b i end h =
    if i < end then
        fromArray b (i + 1) end (pushHeader h (at b i))
    else
        h


pushHeader : Header a, a → Header a
pushHeader h value =
    count = h.total - h.treeCount
    if count < 32 then
        claimed = Js.cellRead h.tail .used == count
        old = Js.cellRead h.tail .values
        values =
            if claimed then
                old
            else
                copyInto (peekArray old) 0 count (builder 32) 0
        writeArray values count value
        next = values
        nextTail =
            if claimed then
                Js.cellWrite h.tail (count + 1) .used
                h.tail
            else
                Js.cell { values = next, used = count + 1 }
        { total = h.total + 1
        , treeCount = h.treeCount
        , root = h.root
        , shift = h.shift
        , capacity = h.capacity
        , tail = nextTail
        , cache = Js.cell { flat = Js.none ⊤ }
        }
    else
        leaf = Leaf (peekArray (Js.cellRead h.tail .values))
        root =
            if h.treeCount == 0 then
                leaf
            else if h.treeCount == h.capacity then
                Branch [ h.root, path h.shift leaf ]
            else
                insertLeaf h.root h.shift h.treeCount leaf
        { total = h.total + 1
        , treeCount = h.treeCount + 32
        , root = root
        , shift = if h.treeCount == h.capacity then h.shift + 5 else h.shift
        , capacity = if h.treeCount == h.capacity then h.capacity * 32 else h.capacity
        , tail = Js.cell { values = put (builder 32) 0 value, used = 1 }
        , cache = Js.cell { flat = Js.none ⊤ }
        }


path : Int, Tree a → Tree a
path shift leaf = if shift == 0 then leaf else Branch [ path (shift - 5) leaf ]


insertLeaf : Tree a, Int, Int, Tree a → Tree a
insertLeaf tree shift index leaf =
    case tree of
        Leaf _ →
            leaf
        Branch children →
            slot = Js.bitAnd (Js.shiftRightZero index shift) 31
            next =
                if slot < length children then
                    insertLeaf (unsafeGet children slot) (shift - 5) index leaf
                else
                    path (shift - 5) leaf
            Branch
                (if slot < length children then
                    set (copy children) slot next
                 else
                    push (copy children) next
                )


plainHeader : Header a → List a
plainHeader h = Js.pure λ⊤ →
    Js.optMatch (Js.cellRead h.cache .flat)
        (λ⊤ →
            first = flattenTree h.root (builder h.total) 0 h.capacity
            tailValues = peekArray (Js.cellRead h.tail .values)
            b = copyInto tailValues 0 (h.total - h.treeCount) first h.treeCount
            flat = done b h.total
            Js.cellWrite h.cache (Js.some flat) .flat
            flat
        )
        λflat → flat


flattenTree : Tree a, Builder a, Int, Int → Builder a
flattenTree tree into start span =
    case tree of
        Leaf values →
            copyInto values 0 (length values) into start
        Branch children →
            flattenChildren children 0 into start (span // 32)


flattenChildren : List (Tree a), Int, Builder a, Int, Int → Builder a
flattenChildren children i into start span =
    if i < length children then
        next = flattenTree (unsafeGet children i) into start span
        flattenChildren children (i + 1) next (start + span) span
    else
        into


-- The checked data conversion recognises only views carrying this private token.
pub viewToken : Js.Cell { listProtocol : ⊤ }
viewToken = Js.cell { listProtocol = ⊤ }


-- A read-only view of a tail buffer; unlike done, it never resizes it.
foreign pure peekArray : returned Builder a → List a


-- Only private tail capacity is written: a header never exposes slots past
-- its own count, and claiming checks that no later header has used the slot.
foreign impure writeArray : aliased Builder a, unused Int, aliased a → ⊤


-- Runtime protocol check; views use the private native prototype.
pub foreign pure isView : borrowed a → Bool


headerGet : Header a, Int → a
headerGet h i =
    if i < h.treeCount then
        at (leafValues h.root h.shift i) (Js.bitAnd i 31)
    else
        at (peekArray (Js.cellRead h.tail .values)) (i - h.treeCount)


leafValues : Tree a, Int, Int → List a
leafValues tree shift i =
    case tree of
        Leaf values →
            values
        Branch children →
            leafValues (unsafeGet children (Js.bitAnd (Js.shiftRightZero i shift) 31)) (shift - 5) i


makeHeader : Int, Int, Tree a, Int, Int, Tail a → Header a
makeHeader total treeCount root shift capacity held =
    { total = total
    , treeCount = treeCount
    , root = root
    , shift = shift
    , capacity = capacity
    , tail = held
    , cache = Js.cell { flat = Js.none ⊤ }
    }


setHeader : Header a, Int, a → Header a
setHeader h i value =
    if i < h.treeCount then
        makeHeader h.total h.treeCount (setTree h.root h.shift i value) h.shift h.capacity h.tail
    else
        count = h.total - h.treeCount
        values = copyInto (peekArray (Js.cellRead h.tail .values)) 0 count (builder 32) 0
        next = put values (i - h.treeCount) value
        makeHeader
            h.total
            h.treeCount
            h.root
            h.shift
            h.capacity
            (Js.cell { values = next, used = count })


setTree : Tree a, Int, Int, a → Tree a
setTree tree shift i value =
    case tree of
        Leaf values →
            Leaf (set (copy values) (Js.bitAnd i 31) value)
        Branch children →
            slot = Js.bitAnd (Js.shiftRightZero i shift) 31
            next = setTree (unsafeGet children slot) (shift - 5) i value
            Branch (set (copy children) slot next)


popHeader : Header a → Header a
popHeader h =
    count = h.total - h.treeCount
    if count > 1 then
        makeHeader (h.total - 1) h.treeCount h.root h.shift h.capacity h.tail
    else
        lastLeaf = leafValues h.root h.shift (h.treeCount - 1)
        values = copyInto lastLeaf 0 32 (builder 32) 0
        held = Js.cell { values = values, used = 32 }
        case removeLeaf h.root h.shift (h.treeCount - 1) of
            Nothing →
                makeHeader (h.total - 1) 0 (Leaf []) 0 32 held
            Just root →
                ( smaller, shift, capacity ) = collapseRoot root h.shift h.capacity
                makeHeader (h.total - 1) (h.treeCount - 32) smaller shift capacity held


removeLeaf : Tree a, Int, Int → Maybe (Tree a)
removeLeaf tree shift i =
    case tree of
        Leaf _ →
            Nothing
        Branch children →
            slot = Js.bitAnd (Js.shiftRightZero i shift) 31
            case removeLeaf (unsafeGet children slot) (shift - 5) i of
                Nothing →
                    if length children == 1 then
                        Nothing
                    else
                        Just (Branch (sliceOf children 0 (length children - 1)))
                Just next →
                    Just (Branch (set (copy children) slot next))


collapseRoot : Tree a, Int, Int → Tree a × Int × Int
collapseRoot tree shift capacity =
    case tree of
        Branch [ child ] →
            collapseRoot child (shift - 5) (capacity // 32)
        _ →
            ( tree, shift, capacity )
