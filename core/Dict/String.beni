--! `Dict` with `String` keys, with the ordering filled in.
--!
--! `Dict` takes its comparison function as an argument (`fast-compiler.md`
--! §3.1 point 4), which is exact but wordy for the key types that come up
--! most. This module is the sugar: three thin wrappers that pass
--! `String.compare` for you. Everything else — `get`, `insert`, `remove`,
--! `foldl` — is the ordinary `Dict` function, because a dictionary carries
--! the ordering it was built with.
--!
--!     import Dict exposing (Dict)
--!     import Dict.String
--!
--!     scores : Dict String Int
--!     scores =
--!         Dict.insert "Alice" 3 Dict.String.empty
--!
--! Nothing here is `foreign`.

import Dict exposing (Dict)
import String


--| An empty dictionary with `String` keys.
pub empty : Dict String v
empty =
    Dict.empty String.compare


--| A dictionary with one key-value pair and `String` keys.
--|
--|     singleton "Tom" 42
pub singleton : String, v -> Dict String v
singleton key value =
    Dict.singleton String.compare key value


--| Convert an association list with `String` keys into a dictionary.
--|
--|     fromList [ ( "a", 0 ), ( "b", 1 ) ]
pub fromList : List ( String, v ) -> Dict String v
fromList assocs =
    Dict.fromList String.compare assocs
