--! `Dict` with `Int` keys, with the ordering filled in.
--!
--! The same sugar `Dict.String` is, over `compare` instead of
--! `String.compare` (`fast-compiler.md` §3.1 point 4). Everything except the
--! three constructors below is the ordinary `Dict` function.
--!
--!     import Dict exposing (Dict)
--!     import Dict.Int
--!
--!     counts : Dict Int Int
--!     counts =
--!         Dict.insert Dict.Int.empty 7 1
--!
--! Nothing here is `foreign`.

import Dict exposing (Dict)


--| An empty dictionary with `Int` keys.
pub empty : Dict Int v
empty =
    Dict.empty compare


--| A dictionary with one key-value pair and `Int` keys.
--|
--|     singleton 7 "seven"
pub singleton : Int, v -> Dict Int v
singleton key value =
    Dict.singleton key value compare


--| Convert an association list with `Int` keys into a dictionary.
--|
--|     fromList [ ( 1, "a" ), ( 2, "b" ) ]
pub fromList : List ( Int, v ) -> Dict Int v
fromList assocs =
    Dict.fromList assocs compare
