--! A `Result` is the value of a computation that may fail, carrying the
--! reason when it does. Use it to manage errors from functions like
--! `String.toInt`, where the failure has something to say.
--!
--! Every function here takes the `Result` as its first argument and the
--! function it applies, if any, as its last. That is what lets `▷` feed a
--! `Result` in at the front — `result ▷ map toString` is
--! `map result toString` — and lets `x ← andThen result` bind the rest of
--! the block as the callback. `fromMaybe` follows the same rule with the
--! `Maybe` as its subject.
--!
--! Everything here is ordinary beni — no `foreign` declarations.

import List


--| A `Result` is either `Ok`, meaning the computation succeeded, or it is an
--| `Err`, meaning there was some failure.
--|
--|     toValidMonth : Int → Result String Int
--|     toValidMonth month =
--|         if month ≥ 1 && month ≤ 12 then
--|             Ok month
--|         else
--|             Err "months must be between 1 and 12"
pub type Result e a
    = Ok a
    | Err e


--| If the result is `Ok`, return the value, but if the result is an `Err`,
--| return a given default value.
--|
--|     withDefault (Ok 123) 0 == 123
--|     withDefault (Err "no") 0 == 0
pub withDefault : Result x a, a → a
withDefault result default =
    case result of
        Ok value →
            value

        Err _ →
            default


--| Apply a function to a result. If the result is `Ok`, it will be converted.
--| If the result is an `Err`, the same error value will propagate through.
--|
--|     map (Ok 4.0) sqrt == Ok 2.0
--|     map (Err "bad input") sqrt == Err "bad input"
--|
--| The `Result` comes first, so this reads well in a pipeline:
--|
--|     (Ok 4.0 ▷ map sqrt) == Ok 2.0
pub map : Result x a, (a → value) → Result x value
map result func =
    case result of
        Ok value →
            Ok (func value)

        Err x →
            Err x


--| Apply a function if both results are `Ok`. If not, the first `Err` will
--| propagate through.
--|
--|     map2 (Ok 3) (Ok 4) (+) == Ok 7
--|     map2 (Ok 3) (Err "no") (+) == Err "no"
pub map2 : Result x a, Result x b, (a, b → value) → Result x value
map2 ra rb func =
    case ra of
        Err x →
            Err x

        Ok a →
            case rb of
                Err x →
                    Err x

                Ok b →
                    Ok (func a b)


--| Apply a function if all three results are `Ok`.
--|
--|     map3 (Ok 1) (Ok 2) (Ok 3) (λa b c → a + b + c) == Ok 6
--|     map3 (Ok 1) (Err "no") (Ok 3) (λa b c → a + b + c) == Err "no"
pub map3 : Result x a, Result x b, Result x c, (a, b, c → value) → Result x value
map3 ra rb rc func =
    case ra of
        Err x →
            Err x

        Ok a →
            case rb of
                Err x →
                    Err x

                Ok b →
                    case rc of
                        Err x →
                            Err x

                        Ok c →
                            Ok (func a b c)


--| Apply a function if all four results are `Ok`.
pub map4 :
      Result x a
    , Result x b
    , Result x c
    , Result x d
    , (a, b, c, d → value)
    → Result x value
map4 ra rb rc rd func =
    case ra of
        Err x →
            Err x

        Ok a →
            case rb of
                Err x →
                    Err x

                Ok b →
                    case rc of
                        Err x →
                            Err x

                        Ok c →
                            case rd of
                                Err x →
                                    Err x

                                Ok d →
                                    Ok (func a b c d)


--| Apply a function if all five results are `Ok`.
pub map5 :
      Result x a
    , Result x b
    , Result x c
    , Result x d
    , Result x e
    , (a, b, c, d, e → value)
    → Result x value
map5 ra rb rc rd re func =
    case ra of
        Err x →
            Err x

        Ok a →
            case rb of
                Err x →
                    Err x

                Ok b →
                    case rc of
                        Err x →
                            Err x

                        Ok c →
                            case rd of
                                Err x →
                                    Err x

                                Ok d →
                                    case re of
                                        Err x →
                                            Err x

                                        Ok value →
                                            Ok (func a b c d value)


--| Chain together a sequence of computations that may fail.
--|
--|     andThen (Ok 1) (λx → Ok (x + 1)) == Ok 2
--|     andThen (Err "no") (λx → Ok (x + 1)) == Err "no"
--|
--| The callback comes last, so `x ← andThen result` binds the rest of the
--| block as the callback. The `?` operator does the same thing with less
--| punctuation: `toInt s?` is the number, or an early return of the `Err` from
--| the enclosing function.
pub andThen : Result x a, (a → Result x b) → Result x b
andThen result callback =
    case result of
        Ok value →
            callback value

        Err x →
            Err x


--| Transform an `Err` value, leaving an `Ok` alone.
--|
--|     mapError (Err 42) Debug.toString == Err "42"
--|     mapError (Ok 42) Debug.toString == Ok 42
pub mapError : Result x a, (x → y) → Result y a
mapError result func =
    case result of
        Ok value →
            Ok value

        Err x →
            Err (func x)


--| Convert to a `Maybe`, throwing the error away.
--|
--|     toMaybe (Ok 42) == Just 42
--|     toMaybe (Err "no") == Nothing
pub toMaybe : Result x a → Maybe a
toMaybe result =
    case result of
        Ok value →
            Just value

        Err _ →
            Nothing


--| Convert from a `Maybe`, giving the error to use when it is `Nothing`. The
--| `Maybe` is the subject, so the error comes second.
--|
--|     fromMaybe (Just 42) "lost" == Ok 42
--|     fromMaybe Nothing "lost" == Err "lost"
pub fromMaybe : Maybe a, x → Result x a
fromMaybe maybe err =
    case maybe of
        Just value →
            Ok value

        Nothing →
            Err err


--| `Ok` of every value, in order, when every result is `Ok`; otherwise the
--| first `Err`. The results after it are not looked at.
--|
--|     combine [ Ok 1, Ok 2 ] == Ok [ 1, 2 ]
--|     combine [ Ok 1, Err "no", Err "never" ] == Err "no"
--|     combine [] == Ok []
pub combine : List (Result x a) → Result x (List a)
combine results = combineHelp results []


combineHelp : List (Result x a), List a → Result x (List a)
combineHelp results values =
    case results of
        [] →
            Ok values

        [ first, …rest ] →
            case first of
                Ok value →
                    combineHelp rest (List.push values value)

                Err x →
                    Err x


--| Every error and every value, each in the order they came: the errors
--| first, as in Effect's `partition`, whose failures are the first half.
--|
--|     partition [ Ok 1, Err "a", Ok 2, Err "b" ] == ( [ "a", "b" ], [ 1, 2 ] )
pub partition : List (Result x a) → List x × List a
partition results = partitionHelp results [] []


partitionHelp : List (Result x a), List x, List a → List x × List a
partitionHelp results errors values =
    case results of
        [] →
            ( errors, values )

        [ first, …rest ] →
            case first of
                Ok value →
                    partitionHelp rest errors (List.push values value)

                Err x →
                    partitionHelp rest (List.push errors x) values
