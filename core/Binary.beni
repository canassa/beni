--! Fixed binary storage and native typed views. Every runtime operation is
--! beni over Js; docs/design/binary.md owns the boundary and failure contract.
--! The handles are the generated native types of `Browser.Host`
--! (workers.md §4): a `View` or a `Source` is an ordinary union over them.

import Browser.Host.ArrayBuffer exposing (ArrayBuffer)
import Browser.Host.BigInt64Array exposing (BigInt64Array)
import Browser.Host.BigUint64Array exposing (BigUint64Array)
import Browser.Host.DataView exposing (DataView)
import Browser.Host.Float16Array exposing (Float16Array)
import Browser.Host.Float32Array exposing (Float32Array)
import Browser.Host.Float64Array exposing (Float64Array)
import Browser.Host.Int16Array exposing (Int16Array)
import Browser.Host.Int32Array exposing (Int32Array)
import Browser.Host.Int8Array exposing (Int8Array)
import Browser.Host.SharedArrayBuffer exposing (SharedArrayBuffer)
import Browser.Host.Uint16Array exposing (Uint16Array)
import Browser.Host.Uint32Array exposing (Uint32Array)
import Browser.Host.Uint8Array exposing (Uint8Array)
import Browser.Host.Uint8ClampedArray exposing (Uint8ClampedArray)
import Js


--| Native, fixed-length ArrayBuffer storage.
pub type alias Buffer =
    ArrayBuffer


--| Native, fixed-length SharedArrayBuffer storage. Sharing is explicit.
pub type alias SharedBuffer =
    SharedArrayBuffer


--| Which storage a view shares.
pub type Backing
    = Local Buffer
    | Shared SharedBuffer


--| A native view, tagged with its kind. Every Web IDL typed array and DataView.
pub type View
    = Int8Array Int8Array
    | Uint8Array Uint8Array
    | Uint8ClampedArray Uint8ClampedArray
    | Int16Array Int16Array
    | Uint16Array Uint16Array
    | Int32Array Int32Array
    | Uint32Array Uint32Array
    | BigInt64Array BigInt64Array
    | BigUint64Array BigUint64Array
    | Float16Array Float16Array
    | Float32Array Float32Array
    | Float64Array Float64Array
    | DataView DataView


--| A native AllowSharedBufferSource. Every use checks its backing again.
pub type Source
    = WholeBuffer Buffer
    | WholeShared SharedBuffer
    | ViewOf View


--| Every Web IDL buffer-view kind. Data counts bytes; the others count elements.
pub type ViewKind
    = I8
    | U8
    | U8Clamped
    | I16
    | U16
    | I32
    | U32
    | I64
    | U64
    | F16
    | F32
    | F64
    | Data


--| Byte order for values wider than one byte.
pub type Endian
    = Little
    | Big


--| An exact unsigned 64-bit bit pattern, represented by two unsigned words.
pub opaque type Word64
    = Words Int Int


--| A binary operation's checked failure. Unknown host failures are defects.
pub type Error
    = Unsupported String
    | InvalidSize Int
    | InvalidRange Int Int Int
    | Misaligned Int Int
    | InvalidInteger Int Int Int
    | Detached
    | ResizableBacking
    | AllocationFailed Int
    | PrecisionLost
    | TransferDenied
    | IsolationRequired


--| Source dimensions after validating its current backing state.
pub type alias SourceInfo =
    byteLength : Int
    byteOffset : Int
    elementLength : Int
    bytesPerElement : Int
    shared : Bool


--| Allocate zero-filled, fixed ArrayBuffer storage.
pub allocate : Int → Result Error Buffer
allocate size =
    validSize size?
    Js.catchIf
        (λ⊤ → Ok (Js.to (Js.construct (Js.global "ArrayBuffer") [ Js.from size ])))
        isRangeError
        λ_ → Err (AllocationFailed size)


--| Allocate fixed shared storage. A page that is not cross-origin isolated has
--| none: that is `IsolationRequired`, and a host without the type `Unsupported`.
pub shared : Int → Result Error SharedBuffer
shared size =
    validSize size?
    constructor = Js.global "SharedArrayBuffer"
    if Js.same (Js.get (Js.global "globalThis") "crossOriginIsolated") (Js.from False) then
        Err IsolationRequired
    else if not (Js.typeIs constructor "function") then
        Err (Unsupported "SharedArrayBuffer")
    else
        Js.catchIf (λ⊤ → Ok (Js.to (Js.construct constructor [ Js.from size ]))) isRangeError λ_ →
            Err (AllocationFailed size)


--| Make a view without copying. Offset is bytes, count is elements (Data: bytes).
--| Nothing as the count takes the rest of the storage, which must divide evenly.
pub view : Backing, ViewKind, Int, Maybe Int → Result Error View
view storage which offset count =
    buffer = backingValue storage
    validBacking buffer?
    total : Int
    total = Js.to (Js.get buffer "byteLength")
    validSize offset?
    if offset > total then
        Err (InvalidRange offset 0 total)
    else
        stride = elementSize which
        if Int.rem offset stride ≠ 0 then
            Err (Misaligned offset stride)
        else
            length = viewCount (total - offset) stride count?
            constructor = Js.global (constructorName which)
            if not (Js.typeIs constructor "function") then
                Err (Unsupported (constructorName which))
            else
                Ok (tag which (Js.construct constructor [ buffer, Js.from offset, Js.from length ]))


--| The kind of a view.
pub kind : View → ViewKind
kind value =
    case value of
        Int8Array _ →
            I8
        Uint8Array _ →
            U8
        Uint8ClampedArray _ →
            U8Clamped
        Int16Array _ →
            I16
        Uint16Array _ →
            U16
        Int32Array _ →
            I32
        Uint32Array _ →
            U32
        BigInt64Array _ →
            I64
        BigUint64Array _ →
            U64
        Float16Array _ →
            F16
        Float32Array _ →
            F32
        Float64Array _ →
            F64
        DataView _ →
            Data


--| The exact native storage of a live fixed view; no copy is made.
pub backing : View → Result Error Backing
backing value =
    buffer = Js.get (native value) "buffer"
    validBacking buffer?
    if isShared buffer then Ok (Shared (Js.to buffer)) else Ok (Local (Js.to buffer))


--| Byte length of live fixed storage.
pub byteLength : Backing → Result Error Int
byteLength storage =
    buffer = backingValue storage
    validBacking buffer?
    Ok (Js.to (Js.get buffer "byteLength"))


--| Whether the storage was detached, by `transfer` or by its owner.
pub detached : Buffer → Bool
detached buffer = isDetached (Js.from buffer)


--| Validate fixed backing again and read this source's current dimensions.
--| Resizable and growable storage are refused even when still in bounds:
--| WebGPU's AllowShared does not grant AllowResizable.
pub sourceInfo : Source → Result Error SourceInfo
sourceInfo source =
    buffer = sourceBuffer source
    validBacking buffer?
    case source of
        ViewOf value →
            bytes : Int
            bytes = Js.to (Js.get (native value) "byteLength")
            offset : Int
            offset = Js.to (Js.get (native value) "byteOffset")
            stride = elementSize (kind value)
            Ok
                { byteLength = bytes
                , byteOffset = offset
                , elementLength = bytes // stride
                , bytesPerElement = stride
                , shared = isShared buffer
                }
        _ →
            bytes : Int
            bytes = Js.to (Js.get buffer "byteLength")
            Ok
                { byteLength = bytes
                , byteOffset = 0
                , elementLength = bytes
                , bytesPerElement = 1
                , shared = isShared buffer
                }


--| Copy byte values into new fixed storage. Every input is checked before allocation.
pub fromList : List Int → Result Error Buffer
fromList values =
    validBytes values?
    buffer = allocate (List.length values)?
    bytes = Js.construct (Js.global "Uint8Array") [ Js.from buffer ]
    _ = List.foldl values 0 λvalue index →
        Js.setAt bytes index (Js.from value)
        index + 1
    Ok buffer


--| Copy a source's bytes to a persistent beni list.
pub toList : Source → Result Error (List Int)
toList source =
    bytes = sourceBytes source?
    Ok (Js.to (Js.call (Js.global "Array") "from" [ bytes ]))


--| Copy the bytes of a checked source into new independent storage.
pub copy : Source → Result Error Buffer
copy source =
    bytes = sourceBytes source?
    length : Int
    length = Js.to (Js.get bytes "byteLength")
    buffer = allocate length?
    _ = Js.call (Js.construct (Js.global "Uint8Array") [ Js.from buffer ]) "set" [ bytes ]
    Ok buffer


--| Copy source bytes into a view at a byte offset. Overlapping storage copies
--| as if through a temporary, as native `set` does.
pub copyInto : View, Int, Source → Result Error ⊤
copyInto destination offset source =
    target = sourceBytes (ViewOf destination)?
    bytes = sourceBytes source?
    length : Int
    length = Js.to (Js.get bytes "byteLength")
    validRange offset length (Js.to (Js.get target "byteLength"))?
    _ = Js.call target "set" [ bytes, Js.from offset ]
    Ok ⊤


--| Move the storage to a new fixed buffer of the same length; the original and
--| every view of it become detached. This is ArrayBuffer.prototype.transfer in
--| this realm; moving storage to a worker is not offered yet (#1299).
pub transfer : Buffer → Result Error Buffer
transfer buffer =
    value = Js.from buffer
    validBacking value?
    if not (Js.typeIs (Js.get value "transfer") "function") then
        Err (Unsupported "ArrayBuffer.prototype.transfer")
    else
        -- Detached and shared storage are refused above, so a TypeError is the
        -- one left: storage with a detach key (WebAssembly memory) refuses it.
        Js.catchIf
            (λ⊤ → Ok (Js.to (Js.call value "transfer" [])))
            (λerror →
                Js.instanceOf error (Js.global "TypeError")
                    || Js.instanceOf error (Js.global "RangeError")
            )
            λerror →
                if Js.instanceOf error (Js.global "RangeError") then
                    Err (AllocationFailed (Js.to (Js.get value "byteLength")))
                else
                    Err TransferDenied


--| Exact words, high first. Both are checked in 0 through 2^32 - 1.
pub word64 : Int, Int → Result Error Word64
word64 high low =
    validInteger high 0 4294967295?
    validInteger low 0 4294967295?
    Ok (Words high low)


--| Both words, without conversion through an inexact number.
pub words : Word64 → { high : Int, low : Int }
words (Words high low) = { high = high, low = low }


--| Convert the integer value of an Int to words, across the full u64 range.
--| An Int already rounded before this call cannot recover its lost low bits.
pub word64FromInt : Int → Result Error Word64
word64FromInt value =
    (if value < 0 || value ≥ 18446744073709551616 || not (integer value) then
        Err (InvalidInteger value 0 18446744073709549568)
     else
        Ok ⊤
    )?
    Ok (Words (value // 4294967296) (Int.rem value 4294967296))


--| Convert words only if the integer is exactly representable by beni Int.
pub word64ToInt : Word64 → Result Error Int
word64ToInt (Words high low) =
    value = high * 4294967296 + low
    if value // 4294967296 ≠ high || Int.rem value 4294967296 ≠ low then
        Err PrecisionLost
    else
        Ok value


--| The exact integer value of an Int, encoded as signed two's-complement i64 bits.
pub word64FromSignedInt : Int → Result Error Word64
word64FromSignedInt value =
    (if value < -9223372036854775808 || value ≥ 9223372036854775808 || not (integer value) then
        Err (InvalidInteger value (-9223372036854775808) 9223372036854774784)
     else
        Ok ⊤
    )?
    signedHigh = floor (toFloat value / 4294967296)
    high = if signedHigh < 0 then signedHigh + 4294967296 else signedHigh
    Ok (Words high (Int.mod value 4294967296))


--| Interpret exact words as a signed two's-complement i64, refusing rounded output.
pub word64ToSignedInt : Word64 → Result Error Int
word64ToSignedInt (Words high low) =
    signedHigh = if high ≥ 2147483648 then high - 4294967296 else high
    value = signedHigh * 4294967296 + low
    case word64FromSignedInt value of
        Ok (Words actualHigh actualLow) →
            if actualHigh == high && actualLow == low then Ok value else Err PrecisionLost
        Err _ →
            Err PrecisionLost


--| Read an exact 64-bit word pair, with no BigInt-to-Number truncation.
pub readWord64 : View, Int, Endian → Result Error Word64
readWord64 value offset endian =
    data = scalarView value offset 8?
    lowOffset = if endian == Little then offset else offset + 4
    highOffset = if endian == Little then offset + 4 else offset
    low : Int
    low = Js.to (Js.call data "getUint32" [ Js.from lowOffset, Js.from (endian == Little) ])
    high : Int
    high = Js.to (Js.call data "getUint32" [ Js.from highOffset, Js.from (endian == Little) ])
    Ok (Words high low)


--| Write an exact 64-bit word pair.
pub writeWord64 : View, Int, Endian, Word64 → Result Error ⊤
writeWord64 value offset endian (Words high low) =
    data = scalarView value offset 8?
    lowOffset = if endian == Little then offset else offset + 4
    highOffset = if endian == Little then offset + 4 else offset
    _ = Js.call data "setUint32" [ Js.from lowOffset, Js.from low, Js.from (endian == Little) ]
    _ = Js.call data "setUint32" [ Js.from highOffset, Js.from high, Js.from (endian == Little) ]
    Ok ⊤


--| The native element width, in bytes.
pub elementSize : ViewKind → Int
elementSize which =
    case which of
        I8 →
            1
        U8 →
            1
        U8Clamped →
            1
        I16 →
            2
        U16 →
            2
        I32 →
            4
        U32 →
            4
        I64 →
            8
        U64 →
            8
        F16 →
            2
        F32 →
            4
        F64 →
            8
        Data →
            1


--| Read Int8 at a byte offset.
pub readI8 : View, Int → Result Error Int
readI8 value offset =
    data = scalarView value offset 1?
    Ok (Js.to (Js.call data "getInt8" [ Js.from offset ]))


--| Write Int8 at a byte offset.
pub writeI8 : View, Int, Int → Result Error ⊤
writeI8 value offset number =
    validInteger number (-128) 127?
    data = scalarView value offset 1?
    _ = Js.call data "setInt8" [ Js.from offset, Js.from number ]
    Ok ⊤


--| Read Uint8 at a byte offset.
pub readU8 : View, Int → Result Error Int
readU8 value offset =
    data = scalarView value offset 1?
    Ok (Js.to (Js.call data "getUint8" [ Js.from offset ]))


--| Write Uint8 at a byte offset.
pub writeU8 : View, Int, Int → Result Error ⊤
writeU8 value offset number =
    validInteger number 0 255?
    data = scalarView value offset 1?
    _ = Js.call data "setUint8" [ Js.from offset, Js.from number ]
    Ok ⊤


--| Read Int16 at a byte offset.
pub readI16 : View, Int, Endian → Result Error Int
readI16 value offset endian =
    data = scalarView value offset 2?
    Ok (Js.to (Js.call data "getInt16" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Int16 at a byte offset.
pub writeI16 : View, Int, Endian, Int → Result Error ⊤
writeI16 value offset endian number =
    validInteger number (-32768) 32767?
    data = scalarView value offset 2?
    _ = Js.call data "setInt16" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
    Ok ⊤


--| Read Uint16 at a byte offset.
pub readU16 : View, Int, Endian → Result Error Int
readU16 value offset endian =
    data = scalarView value offset 2?
    Ok (Js.to (Js.call data "getUint16" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Uint16 at a byte offset.
pub writeU16 : View, Int, Endian, Int → Result Error ⊤
writeU16 value offset endian number =
    validInteger number 0 65535?
    data = scalarView value offset 2?
    _ = Js.call data "setUint16" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
    Ok ⊤


--| Read Int32 at a byte offset.
pub readI32 : View, Int, Endian → Result Error Int
readI32 value offset endian =
    data = scalarView value offset 4?
    Ok (Js.to (Js.call data "getInt32" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Int32 at a byte offset.
pub writeI32 : View, Int, Endian, Int → Result Error ⊤
writeI32 value offset endian number =
    validInteger number (-2147483648) 2147483647?
    data = scalarView value offset 4?
    _ = Js.call data "setInt32" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
    Ok ⊤


--| Read Uint32 at a byte offset.
pub readU32 : View, Int, Endian → Result Error Int
readU32 value offset endian =
    data = scalarView value offset 4?
    Ok (Js.to (Js.call data "getUint32" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Uint32 at a byte offset.
pub writeU32 : View, Int, Endian, Int → Result Error ⊤
writeU32 value offset endian number =
    validInteger number 0 4294967295?
    data = scalarView value offset 4?
    _ = Js.call data "setUint32" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
    Ok ⊤


--| Read Float16 at a byte offset. A host without DataView.getFloat16 is Unsupported.
pub readF16 : View, Int, Endian → Result Error Float
readF16 value offset endian =
    data = scalarView value offset 2?
    if not (Js.typeIs (Js.get data "getFloat16") "function") then
        Err (Unsupported "DataView.prototype.getFloat16")
    else
        Ok (Js.to (Js.call data "getFloat16" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Float16 at a byte offset, rounding to the nearest half-precision value.
pub writeF16 : View, Int, Endian, Float → Result Error ⊤
writeF16 value offset endian number =
    data = scalarView value offset 2?
    if not (Js.typeIs (Js.get data "setFloat16") "function") then
        Err (Unsupported "DataView.prototype.setFloat16")
    else
        _ = Js.call data "setFloat16" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
        Ok ⊤


--| Read Float32 at a byte offset.
pub readF32 : View, Int, Endian → Result Error Float
readF32 value offset endian =
    data = scalarView value offset 4?
    Ok (Js.to (Js.call data "getFloat32" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Float32 at a byte offset, rounding to the nearest single-precision value.
pub writeF32 : View, Int, Endian, Float → Result Error ⊤
writeF32 value offset endian number =
    data = scalarView value offset 4?
    _ = Js.call data "setFloat32" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
    Ok ⊤


--| Read Float64 at a byte offset.
pub readF64 : View, Int, Endian → Result Error Float
readF64 value offset endian =
    data = scalarView value offset 8?
    Ok (Js.to (Js.call data "getFloat64" [ Js.from offset, Js.from (endian == Little) ]))


--| Write Float64 at a byte offset.
pub writeF64 : View, Int, Endian, Float → Result Error ⊤
writeF64 value offset endian number =
    data = scalarView value offset 8?
    _ = Js.call data "setFloat64" [ Js.from offset, Js.from number, Js.from (endian == Little) ]
    Ok ⊤


native : View → Js.Value
native value =
    case value of
        Int8Array handle →
            Js.from handle
        Uint8Array handle →
            Js.from handle
        Uint8ClampedArray handle →
            Js.from handle
        Int16Array handle →
            Js.from handle
        Uint16Array handle →
            Js.from handle
        Int32Array handle →
            Js.from handle
        Uint32Array handle →
            Js.from handle
        BigInt64Array handle →
            Js.from handle
        BigUint64Array handle →
            Js.from handle
        Float16Array handle →
            Js.from handle
        Float32Array handle →
            Js.from handle
        Float64Array handle →
            Js.from handle
        DataView handle →
            Js.from handle


tag : ViewKind, Js.Value → View
tag which value =
    case which of
        I8 →
            Int8Array (Js.to value)
        U8 →
            Uint8Array (Js.to value)
        U8Clamped →
            Uint8ClampedArray (Js.to value)
        I16 →
            Int16Array (Js.to value)
        U16 →
            Uint16Array (Js.to value)
        I32 →
            Int32Array (Js.to value)
        U32 →
            Uint32Array (Js.to value)
        I64 →
            BigInt64Array (Js.to value)
        U64 →
            BigUint64Array (Js.to value)
        F16 →
            Float16Array (Js.to value)
        F32 →
            Float32Array (Js.to value)
        F64 →
            Float64Array (Js.to value)
        Data →
            DataView (Js.to value)


backingValue : Backing → Js.Value
backingValue storage =
    case storage of
        Local buffer →
            Js.from buffer
        Shared buffer →
            Js.from buffer


sourceBuffer : Source → Js.Value
sourceBuffer source =
    case source of
        WholeBuffer buffer →
            Js.from buffer
        WholeShared buffer →
            Js.from buffer
        ViewOf value →
            Js.get (native value) "buffer"


-- A fresh Uint8Array over exactly a checked source's bytes.
sourceBytes : Source → Result Error Js.Value
sourceBytes source =
    info = sourceInfo source?
    Ok
        (Js.construct (Js.global "Uint8Array")
            [ sourceBuffer source, Js.from info.byteOffset, Js.from info.byteLength ]
        )


isShared : Js.Value → Bool
isShared buffer =
    constructor = Js.global "SharedArrayBuffer"
    Js.typeIs constructor "function" && Js.instanceOf buffer constructor


isDetached : Js.Value → Bool
isDetached buffer =
    if isShared buffer then
        False
    else
        state = Js.get buffer "detached"
        if Js.typeIs state "boolean" then
            Js.to state
        else
            -- Before ES2024's `detached` getter: a zero-length view of a genuine
            -- ArrayBuffer throws a TypeError only when the storage is detached.
            Js.catchIf
                (λ⊤ →
                    _ = Js.construct (Js.global "Uint8Array") [ buffer, Js.from 0, Js.from 0 ]
                    False
                )
                (λerror → Js.instanceOf error (Js.global "TypeError"))
                λ_ → True


validBacking : Js.Value → Result Error ⊤
validBacking buffer =
    if isDetached buffer then
        Err Detached
    else if
        Js.same (Js.get buffer "resizable") (Js.from True)
            || Js.same (Js.get buffer "growable") (Js.from True)
    then
        Err ResizableBacking
    else
        Ok ⊤


validBytes : List Int → Result Error ⊤
validBytes values =
    case values of
        [] →
            Ok ⊤
        [ value, …rest ] →
            validInteger value 0 255?
            validBytes rest


integer : Int → Bool
integer value = Js.to (Js.call (Js.global "Number") "isInteger" [ Js.from value ])


validSize : Int → Result Error ⊤
validSize value =
    if
        value < 0 || not (Js.to (Js.call (Js.global "Number") "isSafeInteger" [ Js.from value ]))
    then
        Err (InvalidSize value)
    else
        Ok ⊤


validInteger : Int, Int, Int → Result Error ⊤
validInteger value lower upper =
    if value < lower || value > upper || not (integer value) then
        Err (InvalidInteger value lower upper)
    else
        Ok ⊤


validRange : Int, Int, Int → Result Error ⊤
validRange offset size total =
    validSize offset?
    validSize size?
    if offset > total || size > total - offset then
        Err (InvalidRange offset size total)
    else
        Ok ⊤


viewCount : Int, Int, Maybe Int → Result Error Int
viewCount remaining stride count =
    case count of
        Nothing →
            if Int.rem remaining stride ≠ 0 then
                Err (Misaligned remaining stride)
            else
                Ok (remaining // stride)
        Just length →
            validSize length?
            if length > remaining // stride then
                Err (InvalidRange 0 length (remaining // stride))
            else
                Ok length


-- A DataView over exactly the view's bytes, after the backing and range checks.
scalarView : View, Int, Int → Result Error Js.Value
scalarView value offset size =
    info = sourceInfo (ViewOf value)?
    validRange offset size info.byteLength?
    Ok
        (Js.construct (Js.global "DataView")
            [ sourceBuffer (ViewOf value), Js.from info.byteOffset, Js.from info.byteLength ]
        )


isRangeError : Js.Value → Bool
isRangeError error = Js.instanceOf error (Js.global "RangeError")


constructorName : ViewKind → String
constructorName which =
    case which of
        I8 →
            "Int8Array"
        U8 →
            "Uint8Array"
        U8Clamped →
            "Uint8ClampedArray"
        I16 →
            "Int16Array"
        U16 →
            "Uint16Array"
        I32 →
            "Int32Array"
        U32 →
            "Uint32Array"
        I64 →
            "BigInt64Array"
        U64 →
            "BigUint64Array"
        F16 →
            "Float16Array"
        F32 →
            "Float32Array"
        F64 →
            "Float64Array"
        Data →
            "DataView"
