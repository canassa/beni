-- The size of a program that uses the spike's four primitives and a
-- timer (bench/fiber/size.mjs): a scope, a bracket, a spawn, a join and a
-- sleep, and nothing else of the runtime.
import Io
import Node exposing (Program)
import Task


worker : Int -> Int
worker n =
    _ = Io.sleep 1
    n * 2


main : Program
main = Io.run λ() ->
    answer = Task.scope λs ->
        Task.bracket (λ() -> 21) (λ_ _ -> ()) λr -> Task.join (Task.spawnIn s λ() -> worker r)
    Node.print (String.fromInt answer)
