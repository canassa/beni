import Io
import Node exposing (Program)
import Probe
import Task


loop : Int, Int → Int
loop n acc =
    if n == 0 then
        acc
    else
        Task.yieldNow ⊤
        loop (n - 1) (acc + 1)


main : Program
main = Io.run λ⊤ →
    Probe.begin ⊤
    total = loop Probe.count 0
    Probe.mark "yield"
    Node.print (String.fromInt total)
