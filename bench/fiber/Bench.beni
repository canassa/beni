-- The beni side of the fiber runtime benchmark
-- (docs/design/research/44-effects-runtime-spike.md §7). Built with
-- `--library`, so every `pub` value is a root and the harness imports it;
-- `node.mjs` and `chrome.mjs` start each workload in a fiber with `start`.
import Task exposing (Exit)


--| The runtime's entry, for the harness: `work` in a root fiber, `done`
--| with how it ended.
pub start : (() -> a), (Exit a -> ()) -> ()
start work done = Task.start work done


--| A plain function: the baseline a call is measured against.
pub inc : Int -> Int
inc n = n + 1


--| A function that may suspend and never does here: its class is
--| `suspends`, so every call of it is a suspension point, and every one
--| takes the fast path.
pub incS : Int -> Int
incS n =
    if n < 0 then
        let
            _ = Task.yieldNow ()
        in
        n
    else
        n + 1


--| `n` plain calls, in a loop.
pub loopPlain : Int, Int -> Int
loopPlain n acc =
    if n == 0 then
        acc
    else
        loopPlain (n - 1) (inc acc)


--| `n` suspension points in a tail-call loop: the loop's fast path, a
--| comparison per call and no allocation.
pub loopSuspending : Int, Int -> Int
loopSuspending n acc =
    if n == 0 then
        acc
    else
        loopSuspending (n - 1) (incS acc)


--| Four suspension points in sequence, outside a loop: each hands the rest
--| of the function to `Task.andThen` as a closure, fast path or not.
four : Int -> Int
four x =
    let
        a = incS x
        b = incS a
        c = incS b
    in
    incS c + 0


--| `4 n` sequenced suspension points.
pub loopSequenced : Int, Int -> Int
loopSequenced n acc =
    if n == 0 then
        acc
    else
        loopSequenced (n - 1) (four acc - 3)


--| `n` suspension points that really park: each yields to the scheduler.
pub loopYielding : Int, Int -> Int
loopYielding n acc =
    if n == 0 then
        acc
    else
        let
            _ = Task.yieldNow ()
        in
        loopYielding (n - 1) (acc + 1)


--| `n` fibers, each yielding once and answering its index; joined in order
--| and summed.
pub fanOut : Int -> Int
fanOut n =
    let
        fibers = List.map (List.range 1 n) (λi -> Task.spawn (λ() -> worker i))
    in
    List.foldl fibers 0 (λf acc -> acc + Task.join f)


worker : Int -> Int
worker i =
    let
        _ = Task.yieldNow ()
    in
    i


--| The spike's four primitives together, for the size of what a program
--| that uses them ships: a scope, a bracket, a spawn and a join.
pub together : Int -> Int
together n =
    Task.scope
        (λs ->
            Task.bracket
                (λ() -> n)
                (λ_ _ -> ())
                (λr ->
                    let
                        f = Task.spawnIn s (λ() -> worker r)
                    in
                    Task.join f
                )
        )
