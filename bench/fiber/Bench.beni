-- The beni side of the fiber runtime benchmark
-- (docs/design/research/44-effects-runtime-spike.md §7). Built with
-- `--library`, so every `pub` value is a root and the harness imports it;
-- `node.mjs` and `chrome.mjs` start each workload in a fiber with `start`.
import Clock
import Deferred
import Duration
import Ref exposing (Ref)
import Schedule
import Task exposing (Exit)


--| The runtime's entry, for the harness: `work` in a root fiber, `done`
--| with how it ended.
pub start : (() → a), (Exit a → ()) → ()
start work done = Task.start work done


--| A plain function: the baseline a call is measured against.
pub inc : Int → Int
inc n = n + 1


--| A function that may suspend and never does here: its class is
--| `suspends`, so every call of it is a suspension point, and every one
--| takes the fast path.
pub incS : Int → Int
incS n =
    if n < 0 then
        _ = Task.yieldNow ()
        n
    else
        n + 1


--| `n` plain calls, in a loop.
pub loopPlain : Int, Int → Int
loopPlain n acc =
    if n == 0 then
        acc
    else
        loopPlain (n - 1) (inc acc)


--| `n` suspension points in a tail-call loop: the loop's fast path, a
--| comparison per call and no allocation.
pub loopSuspending : Int, Int → Int
loopSuspending n acc =
    if n == 0 then
        acc
    else
        loopSuspending (n - 1) (incS acc)


--| Four suspension points in sequence, outside a loop: each hands the rest
--| of the function to `Task.andThen` as a closure, fast path or not.
four : Int → Int
four x =
    a = incS x
    b = incS a
    c = incS b
    incS c + 0


--| `4 n` sequenced suspension points.
pub loopSequenced : Int, Int → Int
loopSequenced n acc =
    if n == 0 then
        acc
    else
        loopSequenced (n - 1) (four acc - 3)


--| `n` suspension points that really park: each yields to the scheduler.
pub loopYielding : Int, Int → Int
loopYielding n acc =
    if n == 0 then
        acc
    else
        _ = Task.yieldNow ()
        loopYielding (n - 1) (acc + 1)


--| `n` fibers, each yielding once and answering its index; joined in order
--| and summed.
pub fanOut : Int → Int
fanOut n =
    fibers = List.map (List.range 1 n) λi → Task.spawn λ() → worker i
    List.foldl fibers 0 λf acc → acc + Task.join f


worker : Int → Int
worker i =
    _ = Task.yieldNow ()
    i


--| The spike's four primitives together, for the size of what a program
--| that uses them ships: a scope, a bracket, a spawn and a join.
pub together : Int → Int
together n = Task.scope λs →
    Task.bracket (λ() → n) (λ_ _ → ()) λr →
        f = Task.spawnIn s λ() → worker r
        Task.join f


--| `n` hand-offs through a `Deferred`: a fiber waits on a new one, the
--| caller completes it, and the waiter is joined.
pub deferredHandoff : Int, Int → Int
deferredHandoff n acc =
    if n == 0 then
        acc
    else
        d = Deferred.make ()
        f = Task.spawn λ() → Deferred.wait d
        _ = Task.yieldNow ()
        _ = Deferred.complete d 1
        deferredHandoff (n - 1) (acc + Task.join f)


--| `n` times a new `Deferred` completed and then waited for: the wait
--| answers at once.
pub deferredReady : Int, Int → Int
deferredReady n acc =
    if n == 0 then
        acc
    else
        d = Deferred.make ()
        _ = Deferred.complete d 1
        deferredReady (n - 1) (acc + Deferred.wait d)


--| `n` updates of one `Ref`.
pub refUpdates : Int → Int
refUpdates n =
    r = Ref.make 0
    _ = updateTimes r n
    Ref.get r


updateTimes : Ref Int, Int → ()
updateTimes r n =
    if n == 0 then
        ()
    else
        _ = Ref.update r λx → x + 1
        updateTimes r (n - 1)


--| `n` detached fibers, each started and joined in turn.
pub detachJoin : Int, Int → Int
detachJoin n acc =
    if n == 0 then
        acc
    else
        f = Task.spawnDetached λ() → 1
        detachJoin (n - 1) (acc + Task.join f)


--| `n` zero-length sleeps on the real clock: each lets the others run, as
--| `yieldNow` does.
pub sleepZero : Int, Int → Int
sleepZero n acc =
    if n == 0 then
        acc
    else
        _ = Task.sleep Duration.zero
        sleepZero (n - 1) (acc + 1)


--| Report 23 case 5.5: work that fails three times, retried on an
--| exponential schedule of one hour, driven ten hours on a virtual clock.
--| Answers the number of attempts.
pub tenHours : () → Int
tenHours () =
    clock = Clock.virtual 0
    attempts = Ref.make 0

    retrying = Task.spawn λ() →
        Clock.run clock λ() →
            Task.retry (Schedule.exponential (Duration.hours 1) 2.0) λ() →
                n = Ref.modify attempts λk → ( k + 1, k + 1 )
                if n < 4 then Err () else Ok n
    _ = Clock.adjust clock (Duration.hours 10)
    _ = Task.join retrying
    Ref.get attempts


--| `forEach` over `n` items, at most 16 at once, each call answering its
--| item without waiting. Answers the sum.
pub forEachSixteen : Int → Int
forEachSixteen n = List.sum (Task.forEach (List.range 1 n) 16 λi → i)


--| `n` times, `par` of two thunks that answer at once.
pub parFast : Int, Int → Int
parFast n acc =
    if n == 0 then
        acc
    else
        ( a, b ) = Task.par (λ() → 1) λ() → 1
        parFast (n - 1) (acc + a + b - 1)


--| `n` times, `race` of two branches that each yield once.
pub raceParked : Int, Int → Int
raceParked n acc =
    if n == 0 then
        acc
    else
        winner = Task.race (λ() → worker 1) λ() → worker 1
        raceParked (n - 1) (acc + winner)


--| `n` times, `timeout` of a minute around a body that answers at once.
pub timeoutFast : Int, Int → Int
timeoutFast n acc =
    if n == 0 then
        acc
    else
        got = Task.timeout (Duration.minutes 1) λ() → 1
        timeoutFast (n - 1) (acc + Maybe.withDefault got 0)
