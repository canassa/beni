--- examples/conduit/src/Api.beni	2026-10-15 15:55:12.023950955 +0200
+++ zig-out/proto/jsonbody/src/Api.beni	2026-10-15 16:21:37.217248265 +0200
@@ -279,7 +279,7 @@
 
 pub login : String, String → Result Error Viewer
 login email password =
-    body = Http.jsonBody (LoginJson.schema ⊤) { user = { email = email, password = password } }
+    body = jsonText LoginJson.print { user = { email = email, password = password } }
     Result.map (post (url [ "users", "login" ] []) Nothing body UserEnvelope.parse) λenvelope →
         viewerFromJson envelope.user
 
@@ -287,7 +287,18 @@
 pub register : String, String, String → Result Error Viewer
 register username email password =
     body =
-        Http.jsonBody (RegisterJson.schema ⊤)
+        jsonText RegisterJson.print
             { user = { username = username, email = email, password = password } }
     Result.map (post (url [ "users" ] []) Nothing body UserEnvelope.parse) λenvelope →
         viewerFromJson envelope.user
+
+
+--| A JSON request body from a schema's compiled `print`.
+pub jsonText : (a → Result (List Schema.Issue) String), a → Http.Body
+jsonText print value =
+    case print value of
+        Ok text →
+            Http.stringBody "application/json" text
+
+        Err _ →
+            Http.emptyBody
