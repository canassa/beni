-- A function that a `schema` declaration names in a `via` conversion is
-- called by the compiled print worker with the program's value. No walked
-- body calls it, so its write of its parameter is accepted, and `v.items`
-- is read after the write (research report 128 §4.1).
import Io
import Node exposing (Program)
import Schema


back : List Int → Result (List Schema.Issue) (List Int)
back l = Ok (List.push l 3)


schema Box =
    items : List Int via (Schema.conversion Ok back)


main : Program
main = Io.run λ⊤ →
    v = { items = [ 1, 2 ] }
    _ = Box.print v
    Debug.log (String.fromInt (List.length v.items)) ⊤
    Node.done
