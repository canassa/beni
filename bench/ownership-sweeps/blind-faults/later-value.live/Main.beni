-- A local function reads a value that is bound below it (report 113 §6).
import List
import Maybe
import Node exposing (Program)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


main : Program
main =
    g n = ints zs
    zs = [ 1, 2, 3 ]
    ys = List.set zs 0 9
    Node.print "${ints ys} ${g 1}"
