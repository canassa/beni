-- The safe twin of early-call.live: nothing calls `h` after the write.
import List
import Maybe
import Node exposing (Program)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


main : Program
main =
    xs = [ 1, 2, 3 ]
    h n = g n
    g n = ints xs
    ys = List.set xs 0 9
    Node.print "${ints ys}"
