-- The safe twin of early-mutual.live: `h 1` runs before the write.
import List
import Maybe
import Node exposing (Program)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


main : Program
main =
    xs = [ 1, 2, 3 ]
    h n = if n == 0 then "" else g (n - 1)
    g n = if n == 0 then ints xs else h n
    s = h 1
    ys = List.set xs 0 9
    Node.print "${ints ys} ${s}"
