-- The safe twin of alias-twice.live: two lists.
import List
import Maybe
import Node exposing (Program)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


type alias P =
    a : List Int
    b : List Int


bump : P → P
bump p = { a = List.push p.a 1, b = List.push p.b 2 }


main : Program
main =
    xs = [ 1, 2, 3 ]
    ys = [ 4 ]
    p = P xs ys
    q = bump p
    Node.print "${ints q.a} ${ints q.b}"
