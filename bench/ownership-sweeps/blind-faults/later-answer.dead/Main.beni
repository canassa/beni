-- The safe twin of later-answer.live.
import List
import Maybe
import Node exposing (Program)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


main : Program
main =
    xs = [ 1, 2, 3 ]
    a = g 1
    g n = xs
    s = ints a
    ys = List.set xs 0 9
    Node.print "${ints ys} ${s}"
