-- The twin of `constant-method.live`: `keeper` keeps nothing, and `eq` is a
-- function that calls it. Accepted.
import Io
import Node exposing (Program)
import Ref exposing (Ref)


type T
    = T (Ref (List Int)) (List Int)


keeper : T, T → Bool
keeper (T r a) (T _ b) =
    _ = r
    List.length a == List.length b


pub eq : T, T → Bool
eq x y = keeper x y


grow : Ref (List Int), List Int → Int
grow r xs =
    same = ( T r xs, 0 ) == ( T r [], 0 )
    ys = List.push xs 9
    List.length ys


main : Program
main = Io.run λ⊤ →
    r = Ref.make []
    n = grow r [ 1, 2 ]
    Debug.log (String.fromInt (List.length (Ref.get r))) ⊤
    Node.done
