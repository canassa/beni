-- List.update with a function that reads the list being updated.
import List
import Maybe
import Node exposing (Program)
import String


ints : List Int → String
ints xs = String.join (List.map xs String.fromInt) ","


all : List (List Int) → String
all xss = String.join (List.map xss ints) ";"


bump : List Int → List Int
bump ys = List.push ys 9


later : List Int, List Int → Order
later a b = compare (List.length b) (List.length a)


main : Program
main =
    xs = [ [ 1 ], [ 2 ] ]
    ys = List.update xs 0 λzs → List.push zs (List.length xs)
    Node.print (all ys)
