-- The dead twin of `dag-writer.live` (research report 127): nothing reads `xs` after
-- the write. The leaf writes the answer of another closure, which the
-- checker refuses; the walk must end.
import List
import Node exposing (Program)
import Ref
import String


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


go : Int → String
go n =
    a0 = λl → List.push l n
    b0 = λl → List.reverse l
    c0 = λl → List.drop l 1
    a1 = λl → c0 (b0 (a0 (l)))
    b1 = λl → a0 (c0 (b0 (l)))
    c1 = λl → b0 (a0 (c0 (l)))
    a2 = λl → c1 (b1 (a1 (l)))
    b2 = λl → a1 (c1 (b1 (l)))
    c2 = λl → b1 (a1 (c1 (l)))
    a3 = λl → c2 (b2 (a2 (l)))
    b3 = λl → a2 (c2 (b2 (l)))
    c3 = λl → b2 (a2 (c2 (l)))
    a4 = λl → c3 (b3 (a3 (l)))
    b4 = λl → a3 (c3 (b3 (l)))
    c4 = λl → b3 (a3 (c3 (l)))
    a5 = λl → c4 (b4 (a4 (l)))
    b5 = λl → a4 (c4 (b4 (l)))
    c5 = λl → b4 (a4 (c4 (l)))
    a6 = λl → c5 (b5 (a5 (l)))
    b6 = λl → a5 (c5 (b5 (l)))
    c6 = λl → b5 (a5 (c5 (l)))
    a7 = λl → c6 (b6 (a6 (l)))
    b7 = λl → a6 (c6 (b6 (l)))
    c7 = λl → b6 (a6 (c6 (l)))
    a8 = λl → c7 (b7 (a7 (l)))
    b8 = λl → a7 (c7 (b7 (l)))
    c8 = λl → b7 (a7 (c7 (l)))
    a9 = λl → c8 (b8 (a8 (l)))
    b9 = λl → a8 (c8 (b8 (l)))
    c9 = λl → b8 (a8 (c8 (l)))
    a10 = λl → c9 (b9 (a9 (l)))
    b10 = λl → a9 (c9 (b9 (l)))
    c10 = λl → b9 (a9 (c9 (l)))
    a11 = λl → c10 (b10 (a10 (l)))
    b11 = λl → a10 (c10 (b10 (l)))
    c11 = λl → b10 (a10 (c10 (l)))
    a12 = λl → c11 (b11 (a11 (l)))
    b12 = λl → a11 (c11 (b11 (l)))
    c12 = λl → b11 (a11 (c11 (l)))
    a13 = λl → c12 (b12 (a12 (l)))
    b13 = λl → a12 (c12 (b12 (l)))
    c13 = λl → b12 (a12 (c12 (l)))
    a14 = λl → c13 (b13 (a13 (l)))
    b14 = λl → a13 (c13 (b13 (l)))
    c14 = λl → b13 (a13 (c13 (l)))
    a15 = λl → c14 (b14 (a14 (l)))
    b15 = λl → a14 (c14 (b14 (l)))
    c15 = λl → b14 (a14 (c14 (l)))
    a16 = λl → c15 (b15 (a15 (l)))
    b16 = λl → a15 (c15 (b15 (l)))
    c16 = λl → b15 (a15 (c15 (l)))
    a17 = λl → c16 (b16 (a16 (l)))
    b17 = λl → a16 (c16 (b16 (l)))
    c17 = λl → b16 (a16 (c16 (l)))
    a18 = λl → c17 (b17 (a17 (l)))
    b18 = λl → a17 (c17 (b17 (l)))
    c18 = λl → b17 (a17 (c17 (l)))
    a19 = λl → c18 (b18 (a18 (l)))
    b19 = λl → a18 (c18 (b18 (l)))
    c19 = λl → b18 (a18 (c18 (l)))
    a20 = λl → c19 (b19 (a19 (l)))
    b20 = λl → a19 (c19 (b19 (l)))
    c20 = λl → b19 (a19 (c19 (l)))
    a21 = λl → c20 (b20 (a20 (l)))
    b21 = λl → a20 (c20 (b20 (l)))
    c21 = λl → b20 (a20 (c20 (l)))
    a22 = λl → c21 (b21 (a21 (l)))
    b22 = λl → a21 (c21 (b21 (l)))
    c22 = λl → b21 (a21 (c21 (l)))
    a23 = λl → c22 (b22 (a22 (l)))
    b23 = λl → a22 (c22 (b22 (l)))
    c23 = λl → b22 (a22 (c22 (l)))
    a24 = λl → c23 (b23 (a23 (l)))
    b24 = λl → a23 (c23 (b23 (l)))
    c24 = λl → b23 (a23 (c23 (l)))
    xs = [ n, 2 ]
    ys = List.push xs 3
    show ys ++ show (a24 [ 4, 5 ])


main : Program
main = Node.print (go 1)
