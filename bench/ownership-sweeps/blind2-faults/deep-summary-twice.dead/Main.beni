import List
import Node exposing (Program)
import String


type Lst
    = Cons (List Int) Lst
    | Nil


show : List Int → String
show l = String.join (List.map l String.fromInt) ","


f : Lst → String
f t =
    case t of
        Cons _ (Cons a (Cons _ _)) →
            w = List.set a 0 9
            show w

        _ →
            "-"


go : Int → String
go n =
    q = [ n, 2 ]
    f (Cons [ 0 ] (Cons q (Cons q Nil)))


main : Program
main = Node.print (go 0)
