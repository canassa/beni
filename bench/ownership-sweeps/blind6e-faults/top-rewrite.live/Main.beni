import Io
import List
import Node exposing (Program)
import Ref exposing (Ref)


body : (List Int → ⊤) → ⊤
body send =
    xs = [ 1 ]
    send xs
    ys = List.push xs 2
    send ys


main : Program
main = Io.run λ⊤ →
    r = Ref.make []
    body λl → Ref.set r (List.concat [ Ref.get r, [ l ] ])
    Debug.log (Debug.toString (Ref.get r)) ⊤
    Node.done
