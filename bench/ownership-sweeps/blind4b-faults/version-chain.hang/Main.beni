-- A list written 40 times in a row, each write on the version the last one
-- answered. ownership v3 takes time that doubles with each write (research
-- report 119, fault 1).
import List
import Node exposing (Program)
import String


go : Int → String
go n =
    v0 = [ n ]
    v1 = List.push v0 1
    v2 = List.push v1 2
    v3 = List.push v2 3
    v4 = List.push v3 4
    v5 = List.push v4 5
    v6 = List.push v5 6
    v7 = List.push v6 7
    v8 = List.push v7 8
    v9 = List.push v8 9
    v10 = List.push v9 10
    v11 = List.push v10 11
    v12 = List.push v11 12
    v13 = List.push v12 13
    v14 = List.push v13 14
    v15 = List.push v14 15
    v16 = List.push v15 16
    v17 = List.push v16 17
    v18 = List.push v17 18
    v19 = List.push v18 19
    v20 = List.push v19 20
    v21 = List.push v20 21
    v22 = List.push v21 22
    v23 = List.push v22 23
    v24 = List.push v23 24
    v25 = List.push v24 25
    v26 = List.push v25 26
    v27 = List.push v26 27
    v28 = List.push v27 28
    v29 = List.push v28 29
    v30 = List.push v29 30
    v31 = List.push v30 31
    v32 = List.push v31 32
    v33 = List.push v32 33
    v34 = List.push v33 34
    v35 = List.push v34 35
    v36 = List.push v35 36
    v37 = List.push v36 37
    v38 = List.push v37 38
    v39 = List.push v38 39
    v40 = List.push v39 40
    String.fromInt (List.length v40)


main : Program
main = Node.print (go 0)
