-- w6's result is a tuple 32 levels deep with 2^32 leaves: each level is two
-- copies of one type. ownership v3 names one location per path of a type
-- (research report 119, fault 2), so it never ends. No list is in it.
import Node exposing (Program)


w1 x = ( x, x )


w2 x = w1 (w1 x)


w3 x = w2 (w2 x)


w4 x = w3 (w3 x)


w5 x = w4 (w4 x)


w6 x = w5 (w5 x)


main : Program
main = Node.print "F"
