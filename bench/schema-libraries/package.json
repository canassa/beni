{
  "name": "beni-schema-libraries-investigation",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm run build:sources && npm run wire:sources && npm run generate:compiled",
    "build:sources": "bash scripts/build-sources.sh",
    "wire:sources": "node scripts/wire-source-builds.mjs",
    "generate:compiled": "node scripts/generate-ajv-standalone.mjs && ttsc -p typia/tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "arktype": "2.2.3",
    "effect": "4.0.0-rc.116",
    "fast-json-stringify": "7.0.1",
    "typebox": "1.3.34",
    "typia": "15.0.0",
    "valibot": "1.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "ts-patch": "4.0.1",
    "ttsc": "0.28.1",
    "typescript": "7.0.2"
  }
}
