-- ops: 120000
--
-- R3 of the M5 row (`plans/static-dispatch-spike.md` §7): `List.sort` over
-- `Int`, over `String` and over a record, repeated. C0 spells the last two
-- with `sortWith` and an explicit ordering, because `List.sort` is
-- `List number -> List number` and there is no `comparable`; the spike makes
-- all three `List.sort` with a `where a.compare` constraint.
--
-- The checksum folds EVERY element of each sorted list, not its minimum: a
-- derived `compare` that gets the order subtly wrong — ties broken the other
-- way, one field ignored, a lexicographic comparison that stops early —
-- leaves the minimum alone and moves the rest, so a checksum over the head
-- would score the wrong answer as a fast one.
--
-- Sizes: 4 000 elements, 10 repetitions. `List.mergeWithHelp` is a self tail
-- call and the tail-call loop has not landed, so the merge recurses once per
-- element and a list over about 6 000 overflows the stack. The repetition,
-- not the length, is what buys the running time.
--
-- One op is one element sorted: 3 lists x 4 000 x 10.
import List
import Node exposing (Program)
import String


type alias Person =
    { name : String, age : Int }


blocks : Int
blocks =
    8


perBlock : Int
perBlock =
    500


reps : Int
reps =
    10


modulus : Int
modulus =
    1000003


-- Scattered rather than ascending: a sorted input would measure the best
-- case of a merge sort and nothing else.
values : List Int
values =
    List.concatMap
        (List.range 0 (blocks - 1))
        (\b -> List.map (List.range 1 perBlock) (\i -> modBy ((b * perBlock + i) * 7919) 104729))


strings : List String
strings =
    List.map values String.fromInt


people : List Person
people =
    List.map values (\n -> { name = String.fromInt n, age = modBy n 97 })


-- Order-sensitive over the whole list: swapping any two distinct elements
-- changes the answer.
hash : List Int -> Int
hash xs =
    List.foldl xs 0 (\x acc -> modBy (acc * 31 + x) modulus)


toInt : String -> Int
toInt s =
    Maybe.withDefault (String.toInt s) 0


main : Program
main =
    let
        total =
            List.foldl
                (List.range 1 reps)
                0
                (\_ acc ->
                    let
                        ints =
                            hash (List.sort values)

                        texts =
                            hash (List.map (List.sortWith strings String.compare) toInt)

                        ages =
                            hash (List.map (List.sortBy people (\p -> p.age)) (\p -> p.age * 1000 + toInt p.name))
                    in
                    modBy (acc + ints + texts + ages) modulus
                )
    in
    Node.print (String.join [ String.fromInt (List.length values), String.fromInt total ] " ")
