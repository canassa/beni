-- ops: 3000000
--
-- R6 of the M5 row (`plans/static-dispatch-spike.md` §7): R5's shape with
-- THREE element types going through the same three generic levels in one
-- loop, so `cmp x mark` inside `tally` is a megamorphic call site.
--
-- This is the inline-cache question of report 18 §1.4, and like R5 it
-- measures **lambda-passing versus evidence**. In C0 the three orderings are
-- three lambdas, each closing over the local `scale` of the function that
-- built it and each allocated afresh per call; in C1 they are three evidence
-- arguments reaching one direct call whose callee still varies. Whether
-- dispatch helps here, hurts here, or does nothing is the number this
-- program exists for, and it is the second program `--cpu-prof` profiles.
--
-- Deliberately identical to R5 except for the three types, so the pair is a
-- controlled comparison: same list length, same level chain, same loop.
--
-- One op is one `cmp` call: 3 types x 500 elements x 2 000 repetitions, the
-- repetitions run as 4 x 500 because `List.range 1 2000` was close to the
-- JavaScript stack limit when this was written. **The tail-call loop landed
-- on 2026-09-18 in `bbfc869`**, so the split is now vestigial for a compiler
-- at or after it and still mandatory for the C0 baseline binary; it is left
-- alone because the `-- ops:` count and the checksum are cited.
import List
import Node exposing (Program)
import String


outerReps : Int
outerReps =
    4


innerReps : Int
innerReps =
    500


type alias Person =
    { name : String, age : Int }


numbers : List Int
numbers =
    List.map (List.range 1 500) (\n -> modBy (n * 7919) 499)


texts : List String
texts =
    List.map numbers String.fromInt


people : List Person
people =
    List.map numbers (\n -> { name = String.fromInt n, age = modBy n 97 })


numberMark : Int
numberMark =
    250


textMark : String
textMark =
    "250"


personMark : Person
personMark =
    { name = "250", age = 48 }


-- The local every comparator closes over. `scale` is 1 at every call site
-- here, so the answers are the ascending ones; what it buys is a genuine
-- capture, which is what stops V8 from treating the lambda as a constant.
flipOrder : Order, Int -> Order
flipOrder o scale =
    if scale == 1 then
        o

    else
        case o of
            LT ->
                GT

            GT ->
                LT

            EQ ->
                EQ


-- Level 3: one function, one `cmp x mark` call site, three element types
-- reaching it in the same loop.
tally : List a, a, (a, a -> Order) -> Int
tally xs mark cmp =
    List.foldl xs
        0
        (\x acc ->
            case cmp x mark of
                LT ->
                    acc + 1

                _ ->
                    acc
        )


level2 : List a, a, (a, a -> Order) -> Int
level2 xs mark cmp =
    tally xs mark cmp


level1 : List a, a, (a, a -> Order) -> Int
level1 xs mark cmp =
    level2 xs mark cmp


tallyNumbers : List Int, Int, Int -> Int
tallyNumbers xs mark scale =
    level1 xs mark (\a b -> flipOrder (compare a b) scale)


tallyTexts : List String, String, Int -> Int
tallyTexts xs mark scale =
    level1 xs mark (\a b -> flipOrder (String.compare a b) scale)


tallyPeople : List Person, Person, Int -> Int
tallyPeople xs mark scale =
    level1 xs
        mark
        (\a b ->
            flipOrder
                (case compare a.age b.age of
                    EQ ->
                        String.compare a.name b.name

                    other ->
                        other
                )
                scale
        )


main : Program
main =
    let
        total =
            List.foldl
                (List.range 1 outerReps)
                0
                (\_ acc ->
                    List.foldl
                        (List.range 1 innerReps)
                        acc
                        (\_ n ->
                            n
                                + tallyNumbers numbers numberMark 1
                                + tallyTexts texts textMark 1
                                + tallyPeople people personMark 1
                        )
                )
    in
    Node.print (String.fromInt total)
