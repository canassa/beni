-- ops: 120000
--
-- R1 of the static-dispatch spike's M5 row (`plans/static-dispatch-spike.md`
-- §7): `Dict` insert then get over `String` keys. This is the **C1** form —
-- the comparator is gone from the source entirely (`Dict.empty` is a
-- constant), and what orders the dictionary is `String`'s own `compare`
-- method, resolved at each call and passed as one hidden evidence
-- parameter. Byte for byte the same workload as `c0/R1DictString.beni`;
-- the pair of numbers is what the change costs or buys at run time.
--
-- The key list is built by `concatMap` over two small ranges rather than one
-- `List.range 1 100000`, because when this was written `List.rangeHelp` was a
-- self tail call that recursed, and a range over about 7 000 overflowed the
-- JavaScript stack. **The tail-call loop (`fast-compiler.md` §13) landed on
-- 2026-09-18**, so the split is now VESTIGIAL for a compiler at
-- or after it and still MANDATORY for the C0 baseline binary this program is
-- also measured with. It is left exactly as it was because the `-- ops:`
-- count and the checksum are cited throughout
-- `plans/static-dispatch-spike-results.md`. Everything else here goes through
-- `List.foldl`, which is `foreign` and therefore a loop.
--
-- One op is one insert or one get, so `ops` is 2 x keys.
import Dict
import List
import Node exposing (Program)
import String


blocks : Int
blocks = 120


perBlock : Int
perBlock = 500


keys : List String
keys =
    List.concatMap
        (List.range 0 (blocks - 1))
        (λblock -> List.map (List.range 1 perBlock) (λi -> String.fromInt (block * perBlock + i)))


main : Program
main =
    let
        dict = List.foldl keys Dict.empty (λk d -> Dict.insert d k (String.length k))
        total = List.foldl keys 0 (λk acc -> acc + Maybe.withDefault (Dict.get dict k) 0)
    in
    Node.print (String.join [ String.fromInt (Dict.size dict), String.fromInt total ] " ")
