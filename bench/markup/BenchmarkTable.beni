--! The js-framework-benchmark table (research 29): a keyed list of rows,
--! a jumbotron of buttons, and the messages they send. Markup-heavy on
--! purpose: this module exists to measure the lexer's markup modes.

type alias Row =
    id : Int
    label : String


type alias Model =
    rows : List Row
    selected : Maybe Int
    nextId : Int
    seed : Int


type Msg
    = Run
    | RunLots
    | Add
    | Update
    | Clear
    | SwapRows
    | Select Int
    | Remove Int


adjectives =
    [ "pretty", "large", "big", "small", "tall", "short", "long", "handsome", "plain", "quaint"
    , "clean", "elegant", "easy", "angry", "crazy", "helpful", "mushy", "odd", "unsightly"
    , "adorable", "important", "inexpensive", "cheap", "expensive", "fancy"
    ]


colours =
    [ "red", "yellow", "blue", "green", "pink", "brown", "purple", "brown", "white", "black"
    , "orange"
    ]


nouns =
    [ "table", "chair", "house", "bbq", "desk", "car", "pony", "cookie", "sandwich", "burger"
    , "pizza", "mouse", "keyboard"
    ]


rowClass model row =
    if model.selected == Just row.id then
        "danger"

    else
        ""


button id label msg =
    <div class="col-sm-6 smallpad">
        <button type="button" class="btn btn-primary btn-block" id={id} onClick={msg}>
            {label}
        </button>
    </div>


jumbotron =
    <div class="jumbotron">
        <div class="row">
            <div class="col-md-6">
                <h1>beni keyed</h1>
            </div>
            <div class="col-md-6">
                <div class="row">
                    {button "run" "Create 1,000 rows" Run}
                    {button "runlots" "Create 10,000 rows" RunLots}
                    {button "add" "Append 1,000 rows" Add}
                    {button "update" "Update every 10th row" Update}
                    {button "clear" "Clear" Clear}
                    {button "swaprows" "Swap Rows" SwapRows}
                </div>
            </div>
        </div>
    </div>


viewRow model row =
    <tr class={rowClass model row}>
        <td class="col-md-1">{row.id}</td>
        <td class="col-md-4">
            <a onClick={Select row.id}>{row.label}</a>
        </td>
        <td class="col-md-1">
            <a onClick={Remove row.id}>
                <span class="glyphicon glyphicon-remove" aria-hidden="true" />
            </a>
        </td>
        <td class="col-md-6" />
    </tr>


view model =
    <div class="container">
        {jumbotron}
        <table class="table table-hover table-striped test-data">
            <tbody>
                <For each={model.rows} keyed={.id}>
                    {\row ->
                        <tr class={rowClass model row}>
                            <td class="col-md-1">{row.id}</td>
                            <td class="col-md-4">
                                <a onClick={Select row.id}>{row.label}</a>
                            </td>
                            <td class="col-md-1">
                                <a onClick={Remove row.id}>
                                    <span class="glyphicon glyphicon-remove" aria-hidden="true" />
                                </a>
                            </td>
                            <td class="col-md-6" />
                        </tr>
                    }
                </For>
            </tbody>
        </table>
        <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true" />
    </div>


viewByFunction model =
    <div class="container">
        {jumbotron}
        <table class="table table-hover table-striped test-data">
            <tbody>
                <For each={model.rows} keyed={.id}>{viewRow model _}</For>
            </tbody>
        </table>
    </div>


summary model =
    let
        count =
            List.length model.rows
    in
    <footer class="summary">
        <p>
            Showing {count} rows, {if count > 0 then "some" else "none"} selected
            <Show when={model.selected} keyed fallback={<em>nothing picked</em>}>
                {\id -> <strong>row #{id}</strong>}
            </Show>
        </p>
        <ul class="stats">
            <li>rows: {count}</li>
            <li>next id: {model.nextId}</li>
            <li>seed: {model.seed}</li>
        </ul>
    </footer>


update msg model =
    case msg of
        Run ->
            { model | rows = [], selected = Nothing }

        RunLots ->
            { model | rows = [], selected = Nothing }

        Add ->
            model

        Update ->
            { model | rows = List.map (\r -> { r | label = r.label ++ " !!!" }) model.rows }

        Clear ->
            { model | rows = [], selected = Nothing }

        SwapRows ->
            model

        Select id ->
            { model | selected = Just id }

        Remove id ->
            { model | rows = List.filter (\r -> r.id /= id) model.rows }
