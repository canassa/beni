-- Scenarios 3 and 4 of research/38 §16: `core/List` used the way Elm code
-- uses it, and results built by prepending inside a fold.
import List


-- 3. the library ------------------------------------------------------------

--| `foldr` building a list, the Elm idiom for an order-keeping map.
pub foldrBuild : List Int -> List Int
foldrBuild xs = List.foldr xs [] (λx acc -> [ x * 2, ...acc ])


pub foldrSum : List Int -> Int
foldrSum xs = List.foldr xs 0 (λx acc -> x + acc)


pub rangeSum : Int -> Int
rangeSum n = List.sum (List.range 1 n)


pub zip : List a, List b -> List ( a, b )
zip xs ys = List.map2 xs ys (λa b -> ( a, b ))


pub concatMapPairs : List Int -> List Int
concatMapPairs xs = List.concatMap xs (λx -> [ x, x + 1 ])


--| `acc ++ [ x ]` in a loop: quadratic for a cons list too.
pub appendLoop : List Int -> List Int
appendLoop xs = List.foldl xs [] (λx acc -> acc ++ [ x ])


pub appendTwo : List a, List a -> List a
appendTwo xs ys = xs ++ ys


pub reverse : List a -> List a
reverse xs = List.reverse xs


pub libMap : List Int -> List Int
libMap xs = List.map xs (λx -> x * 3 + 1)


pub libFilter : List Int -> List Int
libFilter xs = List.filter xs (λx -> Int.mod x 3 /= 0)


-- 4. building by prepending in a fold ---------------------------------------------

--| The accumulator is the fold's own state.
pub prependFold : List Int -> List Int
prependFold xs = List.reverse (List.foldl xs [] (λx acc -> [ x * 2, ...acc ]))


type alias Scan =
    seen : List Int
    count : Int


--| The accumulator is a field of the fold's state record.
pub recordFold : List Int -> List Int
recordFold xs =
    final =
        List.foldl
            xs
            { seen = [], count = 0 }
            (λx st -> { st | seen = [ x * 2, ...st.seen ], count = st.count + 1 })
    List.reverse final.seen


--| Two accumulators in a tuple, as `List.partition` is written.
pub partitionFold : List Int -> ( List Int, List Int )
partitionFold xs =
    List.foldr xs ( [], [] )
        (λx pair ->
            case pair of
                ( evens, odds ) ->
                    if Int.mod x 2 == 0 then
                        ( [ x, ...evens ], odds )
                    else
                        ( evens, [ x, ...odds ] )
        )
