-- Scenarios 1 and 2 of research/38 §16: list functions written by hand the
-- way an Elm programmer writes them, by `x :: rest` pattern matching and
-- `::` construction. Nothing here calls into `core/List` except `reverse`.
import List


-- 1. map and filter by hand -------------------------------------------------


--| The textbook `map`: not a tail call, one stack frame per element.
pub mapRec : List a, (a -> b) -> List b
mapRec xs f =
    case xs of
        [] ->
            []

        x :: rest ->
            f x :: mapRec rest f


--| The textbook `filter`, also not a tail call on the kept branch.
pub filterRec : List a, (a -> Bool) -> List a
filterRec xs keep =
    case xs of
        [] ->
            []

        x :: rest ->
            if keep x then
                x :: filterRec rest keep

            else
                filterRec rest keep


--| `map` the stack-safe way: an accumulator, then one `reverse`.
pub mapAcc : List a, (a -> b) -> List b
mapAcc xs f =
    mapAccHelp xs f []


mapAccHelp : List a, (a -> b), List b -> List b
mapAccHelp xs f acc =
    case xs of
        [] ->
            List.reverse acc

        x :: rest ->
            mapAccHelp rest f (f x :: acc)


pub filterAcc : List a, (a -> Bool) -> List a
filterAcc xs keep =
    filterAccHelp xs keep []


filterAccHelp : List a, (a -> Bool), List a -> List a
filterAccHelp xs keep acc =
    case xs of
        [] ->
            List.reverse acc

        x :: rest ->
            if keep x then
                filterAccHelp rest keep (x :: acc)

            else
                filterAccHelp rest keep acc


-- 2. `x :: rest` recursion -----------------------------------------------------


pub sum : List Int -> Int
sum xs =
    sumHelp xs 0


sumHelp : List Int, Int -> Int
sumHelp xs acc =
    case xs of
        [] ->
            acc

        x :: rest ->
            sumHelp rest (acc + x)


--| The same sum through the library (added for research/38 §17).
pub sumFold : List Int -> Int
sumFold xs =
    List.foldl xs 0 (\x acc -> acc + x)


pub takeWhile : List a, (a -> Bool) -> List a
takeWhile xs keep =
    case xs of
        [] ->
            []

        x :: rest ->
            if keep x then
                x :: takeWhile rest keep

            else
                []


--| Neighbouring pairs: `[1, 2, 3]` gives `[(1, 2), (2, 3)]`. The second
--| element goes back on the front of the rest, as Elm code writes it.
pub pairwise : List a -> List ( a, a )
pairwise xs =
    case xs of
        a :: b :: rest ->
            ( a, b ) :: pairwise (b :: rest)

        _ ->
            []


--| Merge sort as a textbook writes it: split by dealing alternately into two
--| accumulators, sort both halves, merge.
pub mergeSort : List Int -> List Int
mergeSort xs =
    case xs of
        [] ->
            []

        [ x ] ->
            [ x ]

        _ ->
            case split xs [] [] of
                ( left, right ) ->
                    merge (mergeSort left) (mergeSort right)


split : List a, List a, List a -> ( List a, List a )
split xs left right =
    case xs of
        [] ->
            ( left, right )

        x :: rest ->
            split rest right (x :: left)


--| The merge Elm programmers write: match both lists at once, and put the
--| head that was not taken back on its tail.
merge : List Int, List Int -> List Int
merge xs ys =
    case ( xs, ys ) of
        ( [], _ ) ->
            ys

        ( _, [] ) ->
            xs

        ( x :: xt, y :: yt ) ->
            if x <= y then
                x :: merge xt (y :: yt)

            else
                y :: merge (x :: xt) yt
