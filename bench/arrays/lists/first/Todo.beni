-- Scenario 5 of research/38 §16, written array-first (§17): the TEA model's
-- rows are the one sequence type, and `Add` puts the new row at the END with
-- `List.push`. `Remove` is `List.filter` and `Toggle` is `List.map`, as before.
import List


type alias Item =
    id : Int
    label : String
    done : Bool


type alias Model =
    items : List Item
    nextId : Int


type Msg
    = Add
    | Remove Int
    | Toggle Int


pub create : Int -> Model
create n =
    { items = List.map (List.range 1 n) (λi -> { id = i, label = "todo", done = False })
    , nextId = n + 1
    }


pub add : Msg
add = Add


pub remove : Int -> Msg
remove id = Remove id


pub toggle : Int -> Msg
toggle id = Toggle id


pub update : Msg, Model -> Model
update msg model =
    case msg of
        Add ->
            { model
                | items = List.push model.items { id = model.nextId, label = "todo", done = False }
                , nextId = model.nextId + 1
            }

        Remove id ->
            { model | items = List.filter model.items (λi -> i.id /= id) }

        Toggle id ->
            { model
                | items =
                    List.map model.items
                        (λi ->
                            if i.id == id then
                                { i | done = not i.done }
                            else
                                i
                        )
            }
