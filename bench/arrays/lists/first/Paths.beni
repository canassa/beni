-- Retained sequences that share a prefix, written array-first (research/38
-- §17): a path grows at its END, `List.push parent i`, and every path is
-- kept. And an undo stack: `push` a state, `last` + `pop` to undo.
import List


--| The path to each of `n` nodes along a chain, root first, every path kept.
pub chainPaths : Int -> List (List Int)
chainPaths n =
    List.foldl (List.range 1 n)
        []
        (\i paths ->
            case List.last paths of
                Nothing ->
                    [ [ i ] ]

                Just parent ->
                    List.push paths (List.push parent i)
        )


--| Every path's elements summed, for the differential test (quadratic, and
--| not timed).
pub checksum : List (List Int) -> Int
checksum paths =
    List.foldl paths 0 (\p acc -> List.foldl p acc (\x s -> modBy (s * 31 + x) 1000003))


--| An editing session of `n` steps: every fourth step undoes the last edit,
--| the others record the current state on the undo stack and replace it.
pub undoSession : Int -> ( Int, List Int )
undoSession n =
    List.foldl (List.range 1 n)
        ( 0, [] )
        (\i ( current, history ) ->
            if modBy i 4 == 0 then
                case List.last history of
                    Just previous ->
                        ( previous, List.pop history )

                    Nothing ->
                        ( current, history )

            else
                ( i, List.push history current )
        )
