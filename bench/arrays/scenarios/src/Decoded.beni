-- Scenario 2: a decoded JSON array, read and never written. Every `Array`
-- here comes from the decoder, `filter`, `sortWith` or `slice`, so a
-- compiler that tracks representation could prove each one plain; this is
-- the module the proven-plain build rewrites.
import Array exposing (Array)


type alias Item =
    id : Int
    name : String
    price : Float
    category : Int


pub countIn : Array Item, Int -> Int
countIn items c = Array.foldl items 0 (λit n -> if it.category == c then n + 1 else n)


pub total : Array Item -> Float
total items = Array.foldl items 0.0 (λit s -> s + it.price)


pub inCategory : Array Item, Int -> Array Item
inCategory items c = Array.filter items (λit -> it.category == c)


pub cheapest : Array Item, Int -> Array Item
cheapest items k = Array.slice (Array.sortWith items (λa b -> compare a.price b.price)) 0 k


find : Array Item, Int, Int, Int -> Maybe Item
find items id lo hi =
    if lo > hi then
        Nothing
    else
        let
            mid = (lo + hi) // 2
        in
        case Array.get items mid of
            Just it ->
                if it.id == id then
                    Just it
                else if it.id < id then
                    find items id (mid + 1) hi
                else
                    find items id lo (mid - 1)

            Nothing ->
                Nothing


--| `k` lookups by id, each a binary search over the id-sorted items.
pub lookups : Array Item, Int -> Float
lookups items k = lookupsHelp items 0 k 0.0


lookupsHelp : Array Item, Int, Int, Float -> Float
lookupsHelp items j k acc =
    if j >= k then
        acc
    else
        let
            id = Int.mod (j * 7919) (Array.length items)
        in
        case find items id 0 (Array.length items - 1) of
            Just it ->
                lookupsHelp items (j + 1) k (acc + it.price)

            Nothing ->
                lookupsHelp items (j + 1) k acc


--| One page of a paginated view: `size` items from `start`, read by index.
pub page : Array Item, Int, Int -> List String
page items start size = pageHelp items (start + size - 1) start []


pageHelp : Array Item, Int, Int, List String -> List String
pageHelp items i start acc =
    if i < start then
        acc
    else
        case Array.get items i of
            Just it ->
                pageHelp items (i - 1) start [ it.name, ...acc ]

            Nothing ->
                pageHelp items (i - 1) start acc
