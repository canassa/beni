-- Scenario 4: arrays built one element at a time inside a fold, the loop
-- copy-on-write turns quadratic.
import Array exposing (Array)
import List


--| Accumulate one result per input by `push`.
pub collect : Int -> Array Int
collect n = List.foldl (List.range 1 n) Array.empty (\x acc -> Array.push acc (modBy (x * x) 1000))


--| Count `samples` into `buckets` buckets.
pub histogram : List Int, Int -> Array Int
histogram samples buckets =
    List.foldl
        samples
        (Array.repeat 0 buckets)
        (\x acc -> Array.update acc (modBy x buckets) (\c -> c + 1))


--| Fewest coins making each amount up to `n`, by a table built with `push`
--| whose every entry reads four earlier ones.
pub coins : Int -> Array Int
coins n = coinsHelp 1 n (Array.push Array.empty 0)


coinsHelp : Int, Int, Array Int -> Array Int
coinsHelp i n dp =
    if i > n then
        dp
    else
        let
            best = min (min (via dp i 1) (via dp i 5)) (min (via dp i 11) (via dp i 23))
        in
        coinsHelp (i + 1) n (Array.push dp best)


via : Array Int, Int, Int -> Int
via dp i coin =
    case Array.get dp (i - coin) of
        Just c ->
            c + 1

        Nothing ->
            1000000000


pub total : Array Int -> Int
total arr = Array.foldl arr 0 (\v s -> s + v)
