-- Report 38 §3's single operations, written the way an Elm programmer writes
-- them over today's `List` (report 46). Elements are opaque here; the harness
-- passes the functions and the comparison.
import List


pub get : List a, Int -> Maybe a
get xs i = List.head (List.drop xs i)


pub set : List a, Int, a -> List a
set xs i v = List.take xs i ++ [ v, ...List.drop xs (i + 1) ]


pub push : List a, a -> List a
push xs v = xs ++ [ v ]


pub pop : List a -> List a
pop xs = List.take xs (List.length xs - 1)


pub slice : List a, Int, Int -> List a
slice xs from to = List.take (List.drop xs from) (to - from)


pub concat : List a, List a -> List a
concat xs ys = xs ++ ys


pub insert : List a, Int, a -> List a
insert xs i v = List.take xs i ++ [ v, ...List.drop xs i ]


pub remove : List a, Int -> List a
remove xs i = List.take xs i ++ List.drop xs (i + 1)


pub swap : List a, Int, Int -> List a
swap xs i j =
    case ( get xs i, get xs j ) of
        ( Just a, Just b ) ->
            List.indexedMap xs λk x ->
                if k == i then
                    b
                else if k == j then
                    a
                else
                    x

        _ ->
            xs


pub map : List a, (a -> b) -> List b
map xs f = List.map xs f


pub filter : List a, (a -> Bool) -> List a
filter xs keep = List.filter xs keep


pub foldl : List a, b, (a, b -> b) -> b
foldl xs acc f = List.foldl xs acc f


pub eq : List a, List a -> Bool
    where a.eq : a, a -> Bool
eq xs ys = xs == ys


pub sort : List a, (a, a -> Order) -> List a
sort xs cmp = List.sortWith xs cmp
