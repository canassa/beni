       <body>
         <main class="container mx-auto min-h-screen flex flex-col justify-center items-center py-8">
           <div class="relative">
             <div class="relative" style="width:600px;height:600px">
               <div class="absolute transform -translate-x-1/2 -translate-y-1/2" style="left: 300px; top: -36px;">
