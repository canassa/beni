-- The workloads of `bench/primitives/run.mjs`: core's small primitives —
-- `String`'s, `Int32`'s, `Char`'s, `Basics`' — each in a loop over prepared input, so what is
-- timed is the primitive and not the list around it. Built with `--library`,
-- so every one of them is a root.
import Int32 exposing (Int32)
import List
import String


--| `n` strings of 8 to 20 characters, most sharing a prefix with the
--| previous one, so a comparison walks past the first character.
pub strings : Int → List String
strings n = List.map (List.range 1 n) λi → "item-${String.fromInt (Int.mod (i * 7919) 1009)}-tail"


--| The same strings, as text separated by spaces and new lines.
pub text : Int → String
text n = String.join (strings n) " \n"


--| `n` digit strings.
pub numerals : Int → List String
numerals n = List.map (List.range 1 n) λi → String.fromInt (i * 31)


pub ints : Int → List Int
ints n = List.range 1 n


--| How many neighbours are in order: one `<` on two strings each.
pub compare : List String → Int
compare xs = inOrder xs 1 0


inOrder : List String, Int, Int → Int
inOrder xs i count =
    case ( List.get xs (i - 1), List.get xs i ) of
        ( Just a, Just b ) →
            inOrder
                xs
                (i + 1)
                (if a < b then
                    count + 1
                 else
                    count
                )

        _ →
            count


pub sort : List String → List String
sort xs = List.sort xs


pub length : List String → Int
length xs = List.foldl xs 0 λs acc → acc + String.length s


pub slice : List String → List String
slice xs = List.map xs λs → String.slice s 2 (-2)


pub indexes : List String → Int
indexes xs = List.foldl xs 0 λs acc → acc + List.length (String.indexes s "t")


pub toInt : List String → Int
toInt xs = List.foldl xs 0 λs acc →
    case String.toInt s of
        Just n →
            acc + n

        Nothing →
            acc


pub fromInt : List Int → List String
fromInt ns = List.map ns String.fromInt


pub join : List String → String
join xs = String.join xs ","


pub words : String → Int
words s = List.length (String.words s)


pub split : String → Int
split s = List.length (String.split s "-")


--| FNV-1a over every string's code points: `Int32.xor` and `Int32.mul`.
pub fnv : List String → Int
fnv xs =
    Int32.toUnsignedInt
        (List.foldl xs (Int32.fromInt 0x811C9DC5) λs h →
            List.foldl (String.toList s) h λc acc →
                Int32.mul
                    (Int32.xor acc (Int32.fromInt (Char.toCode c)))
                    (Int32.fromInt 0x01000193)
        )


--| `Int32`'s guarded division, remainder and modulus.
pub divisions : List Int → Int
divisions ns =
    Int32.toInt
        (List.foldl ns (Int32.fromInt 1) λn acc →
            x = Int32.fromInt (n * 2654435761)
            Int32.add
                acc
                (Int32.add
                    (Int32.div x (Int32.fromInt (n + 3)))
                    (Int32.add (Int32.rem x (Int32.fromInt 7)) (Int32.mod x (Int32.fromInt 13)))
                )
        )


--| `Char`'s four over every character: its code point, the next one, and
--| both case mappings.
pub chars : List String → Int
chars xs = List.foldl xs 0 λs acc →
    List.foldl (String.toList s) acc λc n →
        n
            + Char.toCode (Char.fromCode (Char.toCode c + 1))
            + Char.toCode (Char.toUpper c)
            + Char.toCode (Char.toLower c)


--| `Basics`' conversions and arithmetic over every number.
pub math : List Int → Int
math ns = List.foldl ns 0 λn acc →
    x = toFloat n / 7
    acc
        + floor x
        + round (sqrt x)
        + ceiling (Float.log x 2)
        + truncate (sin x * 100)
        + Int.mod n 13
        + Int.rem n 11
        + n // 3


type alias Shape =
    id : Int
    name : String
    tags : List Int
    at : Int × Int
    kind : Maybe Int


shape : Int → Shape
shape i =
    { id = i
    , name = "item-${String.fromInt i}"
    , tags = [ i, i + 1, i + 2 ]
    , at = ( i, i * 2 )
    , kind = Just i
    }


--| `n` pairs of equal records, each side built on its own so that a
--| comparison walks every field.
pub records : Int → List (Shape × Shape)
records n = List.map (List.range 1 n) λi → ( shape i, shape i )


--| How many pairs `Basics.eq` finds equal: structural equality on records,
--| field by field.
pub eqRecords : List (Shape × Shape) → Int
eqRecords pairs = List.foldl pairs 0 λ( a, b ) acc → if Basics.eq a b then acc + 1 else acc


--| Two equal lists of `n / 10` lists of ten numbers, built apart.
pub nested : Int → List (List Int) × List (List Int)
nested n =
    rows = List.range 1 (n // 10)
    ( List.map rows λr → List.range r (r + 9), List.map rows λr → List.range r (r + 9) )


--| `Basics.eq` on two nested lists.
pub eqNested : List (List Int) × List (List Int) → Bool
eqNested ( a, b ) = Basics.eq a b


--| Two equal lists of `20 n` numbers, built apart.
pub long : Int → List Int × List Int
long n = ( List.range 1 (20 * n), List.range 1 (20 * n) )


--| `Basics.eq` on two long lists.
pub eqLong : List Int × List Int → Bool
eqLong ( a, b ) = Basics.eq a b


--| `++` where the checker does not know the type: `Basics.append` on
--| strings, once per string.
pub appends : List String → Int
appends xs = String.length (joined xs "")


joined : List appendable, appendable → appendable
joined xs acc = List.foldl xs acc λx s → s ++ x
