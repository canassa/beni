type Msg
    = Bump


update : Msg, Model -> Model
update msg model =
    case msg of
        Bump ->
            bump model


bump : Model -> Model
bump model =
    case Int.mod model.tick 50 of
        0 ->
            { model | tick = model.tick + 1, v0 = model.v0 + 1 }

        1 ->
            { model | tick = model.tick + 1, v1 = model.v1 + 1 }

