-- TodoMVC with the whole todomvc.com specification, for the size
-- comparison in bench/todomvc/size.mjs: tests/corpus/browser/tea/TodoMVC.beni
-- plus editing — a double-click on a title opens an edit field, focused
-- after the render (`Cmd.afterRender`, `Dom.focus`); Enter or leaving the
-- field saves the trimmed title, an empty one deletes the todo, and Escape
-- cancels.
import Browser.Navigation
import Cmd exposing (Cmd)
import Dom
import Html exposing (Html)
import Storage exposing (Local)
import Tea
import Url exposing (Url)


type Filter
    = All
    | Active
    | Completed


type alias Todo =
    id : Int
    title : String
    done : Bool


type alias Editing =
    id : Int
    draft : String


type alias Model =
    todos : List Todo
    draft : String
    filter : Filter
    nextId : Int
    editing : Maybe Editing


type Msg
    = Typed String
    | KeyDown Html.Event
    | Toggle Int
    | ToggleAll Bool
    | Destroy Int
    | ClearCompleted
    | UrlChanged Url
    | StartEdit Int String
    | EditTyped String
    | EditKey Html.Event
    | EditDone


-- ---- Persistence --------------------------------------------------------
-- One line per todo: "1" or "0" for done, then the title. A title comes
-- from a one-line input, so it holds no line break.

key : String
key = "todos-beni"


encode : List Todo → String
encode todos = String.join (List.map todos λt → (if t.done then "1" else "0") ++ t.title) "\n"


decode : String → List Todo
decode text =
    List.indexedMap (List.filter (String.lines text) λline → not (String.isEmpty line)) λi line →
        { id = i, title = String.dropLeft line 1, done = String.startsWith line "1" }


save : List Todo → Cmd Msg
save todos = Cmd.do λ() → saved (Storage.set Local key (encode todos))


-- A todo list too big for the quota, or storage the browser withholds,
-- is kept in the page only.
saved : Result Storage.Error () → ()
saved _ = ()


-- ---- The filter, from the address ----------------------------------------

filterOf : Maybe Url → Filter
filterOf url =
    case Maybe.andThen url λu → u.fragment of
        Just "/active" →
            Active

        Just "/completed" →
            Completed

        _ →
            All


-- ---- The program -----------------------------------------------------------

init : Model × Cmd Msg
init =
    todos =
        case Storage.get Local key of
            Just text →
                decode text

            Nothing →
                []
    ( { todos = todos
      , draft = ""
      , filter = filterOf (Browser.Navigation.currentUrl ())
      , nextId = List.length todos
      , editing = Nothing
      }
    , Cmd.none
    )


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Typed text →
            ( { model | draft = text }, Cmd.none )

        KeyDown event →
            if Html.key event == "Enter" then
                _ = Html.preventDefault event

                title = String.trim model.draft
                if String.isEmpty title then
                    ( model, Cmd.none )
                else
                    changed
                        { model | draft = "", nextId = model.nextId + 1 }
                        (model.todos ++ [ { id = model.nextId, title = title, done = False } ])
            else
                ( model, Cmd.none )

        Toggle id →
            changed
                model
                (List.map model.todos λt → if t.id == id then { t | done = not t.done } else t)

        ToggleAll done →
            changed model (List.map model.todos λt → { t | done = done })

        Destroy id →
            changed model (List.filter model.todos λt → t.id ≠ id)

        ClearCompleted →
            changed model (List.filter model.todos λt → not t.done)

        UrlChanged url →
            ( { model | filter = filterOf (Just url) }, Cmd.none )

        StartEdit id title →
            ( { model | editing = Just { id = id, draft = title } }, Cmd.afterRender focusEditor )

        EditTyped text →
            ( { model | editing = Maybe.map model.editing λed → { ed | draft = text } }, Cmd.none )

        EditKey event →
            case Html.key event of
                "Enter" →
                    commit model

                "Escape" →
                    ( { model | editing = Nothing }, Cmd.none )

                _ →
                    ( model, Cmd.none )

        EditDone →
            commit model


-- The edit field is rendered by the update that opens it, so it is focused
-- after that render. Only one is open at a time, so it has a fixed id.
focusEditor : Cmd.Send Msg → ()
focusEditor _ =
    case Dom.focus "edit" of
        _ →
            ()


-- Enter and leaving the field both save; the second of the two, when Enter
-- has already closed the field, finds nothing open and does nothing.
commit : Model → Model × Cmd Msg
commit model =
    case model.editing of
        Nothing →
            ( model, Cmd.none )

        Just ed →
            title = String.trim ed.draft
            closed = { model | editing = Nothing }
            if String.isEmpty title then
                changed closed (List.filter model.todos λt → t.id ≠ ed.id)
            else
                changed
                    closed
                    (List.map model.todos λt → if t.id == ed.id then { t | title = title } else t)


changed : Model, List Todo → Model × Cmd Msg
changed model todos = ( { model | todos = todos }, save todos )


visible : Filter, Todo → Bool
visible filter todo =
    case filter of
        All →
            True

        Active →
            not todo.done

        Completed →
            todo.done


-- The draft of the todo being edited, when it is this one.
editingDraft : Maybe Editing, Int → Maybe String
editingDraft editing id =
    case editing of
        Just ed →
            if ed.id == id then Just ed.draft else Nothing

        Nothing →
            Nothing


isEditing : Maybe Editing, Int → Bool
isEditing editing id =
    case editingDraft editing id of
        Just _ →
            True

        Nothing →
            False


editor : Maybe String → Html Msg
editor editing =
    case editing of
        Just draft →
            <input
                id="edit"
                class="edit"
                value={draft}
                onInput={EditTyped}
                onKeyDown={EditKey}
                onBlur={λ_ → EditDone}
            />

        Nothing →
            <></>


view : Model → Html Msg
view model =
    left = List.length (List.filter model.todos λt → not t.done)
    <section class="todoapp">
        <header class="header">
            <h1>todos</h1>
            <input
                id="new-todo"
                class="new-todo"
                value={model.draft}
                onInput={Typed}
                onKeyDown={KeyDown}
            />
        </header>
        <section class="main" hidden={List.isEmpty model.todos}>
            <input
                id="toggle-all"
                class="toggle-all"
                type="checkbox"
                checked={left == 0}
                onCheck={ToggleAll}
            />
            <label for="toggle-all">Mark all as complete</label>
            <ul class="todo-list">
                <For each={List.filter model.todos (visible model.filter _)} keyed={.id}>
                    {λtodo →
                        <li
                            class={[ ( "completed", todo.done )
                                   , ( "editing", isEditing model.editing todo.id )
                                   ]
                                  }
                        >
                            <div class="view">
                                <input
                                    class="toggle"
                                    type="checkbox"
                                    checked={todo.done}
                                    onCheck={λ_ → Toggle todo.id}
                                />
                                <label onDblClick={StartEdit todo.id todo.title}>
                                    {todo.title}
                                </label>
                                <button class="destroy" onClick={Destroy todo.id} />
                            </div>
                            {editor (editingDraft model.editing todo.id)}
                        </li>
                    }
                </For>
            </ul>
        </section>
        <footer class="footer" hidden={List.isEmpty model.todos}>
            <span class="todo-count">
                <strong>{String.fromInt left}</strong>{if left == 1 then
                                                          " item left"
                                                       else
                                                          " items left"
                                                      }
            </span>
            <ul class="filters">
                <li><a href="#/" class={[ ( "selected", model.filter == All ) ]}>All</a></li>
                <li>
                    <a href="#/active" class={[ ( "selected", model.filter == Active ) ]}>Active</a>
                </li>
                <li>
                    <a href="#/completed" class={[ ( "selected", model.filter == Completed ) ]}>
                        Completed
                    </a>
                </li>
            </ul>
            <button
                id="clear-completed"
                class="clear-completed"
                hidden={left == List.length model.todos}
                onClick={ClearCompleted}
            >
                Clear completed
            </button>
        </footer>
    </section>


main : Tea.Program
main =
    Tea.element
        { init = init
        , update = update
        , view = view
        , subscriptions = λ_ → Browser.Navigation.onUrlChange UrlChanged
        }
