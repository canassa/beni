+        if (ir.tag(stmt) != .switch_stmt) return false;
+        if (ir.subRange(@fromBackingInt(@intCast(ir.data(stmt).rhs))).len() != 0) return false;
+        return s.effectFreeTest(m, @fromBackingInt(@intCast(ir.data(stmt).lhs)), 0);
+    }
