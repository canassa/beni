+    /// Slice 10: the clauses of a `switch` on a constructor's field that
+    /// none of the field's values selects, dropped (`fieldValues`) — a
+    /// `case` whose literal the field never holds, and `default` when every
+    /// value it may hold has a `case`. A clause the one before it may fall
+    /// into stays. The discriminant is a chain safe to evaluate, so a
+    /// `switch` left with no clause does nothing and goes with its list
+    /// (`foldList`, `droppedSwitch`). True when a clause went.
+    fn pruneCases(s: *Spec, m: *Mod, stmt: Index) Allocator.Error!bool {
+        const ir = m.ir;
+        const d = ir.data(stmt);
+        var set: std.ArrayList(u32) = .empty;
+        if (!try s.fieldValues(m, @fromBackingInt(@intCast(d.lhs)), &set)) return false;
+        const cases = try s.arena.dupe(Index, ir.extraSlice(ir.subRange(@fromBackingInt(@intCast(d.rhs))), Index));
+        // Every label a literal, or nothing is decided.
+        const labels = try s.arena.alloc(?Lit, cases.len);
+        for (cases, labels) |c, *label| {
+            const t: Node.OptionalIndex = @fromBackingInt(@intCast(ir.data(c).lhs));
+            label.* = if (t.unwrap()) |test_node| switch (ir.tag(test_node)) {
+                .true_lit => .{ .kind = .true_lit },
+                .false_lit => .{ .kind = .false_lit },
+                .null_lit => .{ .kind = .null_lit },
+                .undefined_lit => .{ .kind = .undefined_lit },
+                .number => .{ .kind = .number, .bytes = ir.bytes(test_node) },
+                .string => .{ .kind = .string, .bytes = ir.bytes(test_node) },
+                else => return false,
+            } else null;
+        }
+        // Which clauses a value enters: a `case` when some value may equal
+        // its literal; `default` when some value equals no literal for sure.
+        const entered = try s.arena.alloc(bool, cases.len);
+        @memset(entered, false);
+        for (labels, entered) |label, *e| if (label) |l| for (set.items) |v| {
+            if (strictEquals(l, s.lits.items[v]) orelse true) e.* = true;
+        };
+        for (set.items) |v| {
+            const matched = for (labels) |label| {
+                if (label) |l| if (strictEquals(l, s.lits.items[v]) orelse false) break true;
+            } else false;
+            if (matched) continue;
+            for (labels, entered) |label, *e| if (label == null) {
+                e.* = true;
+            };
+        }
+        // A clause stays when it is entered, or when the clause before it
+        // stays and may complete into it.
+        var kept: std.ArrayList(u32) = .empty;
+        var live_before = false;
+        for (cases, entered) |c, e| {
+            const live = e or live_before;
+            if (live) try kept.append(s.arena, c.int());
+            live_before = live and completesList(ir, ir.subRange(@fromBackingInt(@intCast(ir.data(c).rhs))), 0);
+        }
+        if (kept.items.len == cases.len) return false;
+        try s.setList(m, d.rhs, kept.items);
+        return true;
+    }
+
