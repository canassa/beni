  interface value update (annotated)

decl 4: pub value view (annotated)
  %0 = type_top 0 (Model)
  %1 = type_import Html.Html
  %2 = type_top 1 (Msg)
  %3 = type_app %1 [%2]
  %4 = type_fn [%0] -> %3
  %5 = pat_var local 0 (model)
  %6 = ctor 1 (Increment)
  %7 = ctor 2 (Toggle)
  %8 = ctor 3 (Reset)
  %9 = local 0 (model)
  %10 = field_access %9 .count7112
  %11 = import_value Basics.not
  %12 = local 0 (model)
  %13 = field_access %12 .enabled7112
  %14 = call %11 [%13]
  %15 = local 0 (model)
  %16 = field_access %15 .history7112
  %17 = markup
    element section
      attr id = "s0"
      attr data-shape = "cluster"
      element h2
        text "cluster 17/0 Review"
      element div
        attr class = "level-0"
        element button
          attr id = "s0-increment"
          attr onClick = %6
          text "Increment"
        element button
          attr id = "s0-toggle"
          attr onClick = %7
          text "Toggle"
        element button
          attr id = "s0-reset"
          attr onClick = %8
          text "Reset"
        element output
          attr id = "s0-count"
          hole %10
        element span
          attr hidden = %14
          hole %16
  annotation %4
  params [%5]
  body %17
  locals
    0 model param %5
  refs
    type_top 0 (Model)
    import_type Html.Html
    type_top 1 (Msg)
    ctor 1 (Increment)
    ctor 2 (Toggle)
    ctor 3 (Reset)
    import_value Basics.not
  interface value view (annotated)

interface
  alias Model (record constructor)
  type Msg = Increment | Toggle | Reset
  value init (annotated)
  value update (annotated)
  value view (annotated)

