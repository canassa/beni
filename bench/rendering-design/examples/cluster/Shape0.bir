  %29 = local 1 (model)
  %30 = field_access %29 .history7112
  %31 = int 1
  %32 = import_value Basics.add
  %33 = call %32 [%30, %31]
  %34 = record_update %24 { enabled7112 = %28, history7112 = %33 }
  %35 = branch %23 -> %34
  %36 = ctor 3 (Reset)
  %37 = pat_ctor %36 []
