decl 0: pub alias Model
  %0 = type_import Basics.Int
  %1 = type_import Basics.Bool
  %2 = type_import Basics.Int
  %3 = type_record { count7112 : %0, enabled7112 : %1, history7112 : %2 }
  body %3
  ctor 0 Model [%0, %1, %2]
  refs
    import_type Basics.Int
    import_type Basics.Bool
  interface alias Model (record constructor)

decl 1: pub type Msg
  ctor 1 Increment []
  ctor 2 Toggle []
  ctor 3 Reset []
  interface type Msg = Increment | Toggle | Reset

decl 2: pub value init (annotated)
  %0 = type_unit
  %1 = type_top 0 (Model)
  %2 = type_fn [%0] -> %1
  %3 = pat_unit
  %4 = int 0
  %5 = import_ctor Basics.True
  %6 = int 0
  %7 = record { count7112 = %4, enabled7112 = %5, history7112 = %6 }
  annotation %2
  params [%3]
  body %7
  refs
    type_top 0 (Model)
    import_ctor Basics.True
  interface value init (annotated)

