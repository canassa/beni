  %21 = branch %8 -> %20
  %22 = ctor 2 (Toggle)
  %23 = pat_ctor %22 []
  %24 = local 1 (model)
  %25 = import_value Basics.not
  %26 = local 1 (model)
  %27 = field_access %26 .enabled7112
