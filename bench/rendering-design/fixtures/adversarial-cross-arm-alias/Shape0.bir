decl 0: pub alias Model
  %0 = type_import List.List
  %1 = type_import Basics.Int
  %2 = type_app %0 [%1]
  %3 = type_import List.List
  %4 = type_import Basics.Int
  %5 = type_app %3 [%4]
  %6 = type_record { rows : %2, snapshot : %5 }
  body %6
  ctor 0 Model [%2, %5]
  refs
    import_type List.List
    import_type Basics.Int
  interface alias Model (record constructor)

decl 1: pub type Msg
  ctor 1 Capture []
  ctor 2 Reverse []
  interface type Msg = Capture | Reverse

decl 2: pub value init (annotated)
  %0 = type_unit
  %1 = type_top 0 (Model)
  %2 = type_fn [%0] -> %1
  %3 = pat_unit
  %4 = int 1
  %5 = int 2
  %6 = int 3
  %7 = list [%4, %5, %6]
  %8 = list []
  %9 = record { rows = %7, snapshot = %8 }
  annotation %2
  params [%3]
  body %9
  refs
    type_top 0 (Model)
  interface value init (annotated)

decl 3: pub value update (annotated)
  %0 = type_top 1 (Msg)
  %1 = type_top 0 (Model)
  %2 = type_top 0 (Model)
  %3 = type_fn [%0, %1] -> %2
  %4 = pat_var local 0 (msg)
  %5 = pat_var local 1 (model)
  %6 = local 0 (msg)
  %7 = ctor 1 (Capture)
  %8 = pat_ctor %7 []
  %9 = local 1 (model)
  %10 = local 1 (model)
  %11 = field_access %10 .rows
  %12 = record_update %9 { snapshot = %11 }
  %13 = branch %8 -> %12
  %14 = ctor 2 (Reverse)
  %15 = pat_ctor %14 []
  %16 = local 1 (model)
  %17 = qualified List.reverse
  %18 = local 1 (model)
  %19 = field_access %18 .rows
  %20 = call %17 [%19]
  %21 = record_update %16 { rows = %20 }
  %22 = branch %15 -> %21
  %23 = case %6 [%13, %22]
  annotation %3
  params [%4, %5]
  body %23
  locals
    0 msg param %4
    1 model param %5
  refs
    type_top 1 (Msg)
    type_top 0 (Model)
    ctor 1 (Capture)
    ctor 2 (Reverse)
    import_value List.reverse
  interface value update (annotated)

decl 4: value number (annotated)
  %0 = type_import List.List
  %1 = type_import Basics.Int
  %2 = type_app %0 [%1]
  %3 = type_import Basics.Int
  %4 = type_fn [%2] -> %3
  %5 = pat_var local 0 (rows)
  %6 = qualified List.foldl
  %7 = local 0 (rows)
  %8 = int 0
  %9 = pat_var local 1 (n)
  %10 = pat_var local 2 (total)
  %11 = local 2 (total)
  %12 = int 10
  %13 = import_value Basics.mul
  %14 = call %13 [%11, %12]
  %15 = local 1 (n)
  %16 = import_value Basics.add
  %17 = call %16 [%14, %15]
  %18 = lambda [%9, %10] -> %17
  %19 = call %6 [%7, %8, %18]
  annotation %4
  params [%5]
  body %19
  locals
    0 rows param %5
    1 n param %9
    2 total param %10
  refs
    import_type List.List
    import_type Basics.Int
    import_value List.foldl
    import_value Basics.mul
    import_value Basics.add

decl 5: pub value view (annotated)
  %0 = type_top 0 (Model)
  %1 = type_import Html.Html
  %2 = type_top 1 (Msg)
  %3 = type_app %1 [%2]
  %4 = type_fn [%0] -> %3
  %5 = pat_var local 0 (model)
  %6 = ctor 1 (Capture)
  %7 = ctor 2 (Reverse)
  %8 = top 4 (number)
  %9 = local 0 (model)
  %10 = field_access %9 .rows
  %11 = call %8 [%10]
  %12 = top 4 (number)
  %13 = local 0 (model)
  %14 = field_access %13 .snapshot
  %15 = call %12 [%14]
  %16 = markup
    element section
      attr data-shape = "adversarial"
      element button
        attr id = "capture"
        attr onClick = %6
        text "Capture"
      element button
        attr id = "reverse"
        attr onClick = %7
        text "Reverse"
      element output
        attr id = "rowsOutput"
        hole %11
      element output
        attr id = "snapshotOutput"
        hole %15
  annotation %4
  params [%5]
  body %16
  locals
    0 model param %5
  refs
    type_top 0 (Model)
    import_type Html.Html
    type_top 1 (Msg)
    ctor 1 (Capture)
    ctor 2 (Reverse)
    top 4 (number)
  interface value view (annotated)

interface
  alias Model (record constructor)
  type Msg = Capture | Reverse
  value init (annotated)
  value update (annotated)
  value view (annotated)

imports
  import Html exposing (Html)
  prelude Basics
  prelude List
  prelude Maybe
  prelude Result
  prelude String
  prelude Char
  prelude Debug
  prelude Int
  prelude Float
