--! A tokenizer and precedence-climbing parser for arithmetic expressions
--! with variables, unary minus, exponentiation and function calls, plus an
--! evaluator and a printer. Typical hand-written parser shape.

import Dict exposing (Dict)


pub type Token
    = TNumber Float
    | TIdent String
    | TPlus
    | TMinus
    | TStar
    | TSlash
    | TCaret
    | TLParen
    | TRParen
    | TComma


pub type Expr
    = Number Float
    | Var String
    | Neg Expr
    | Binary Op Expr Expr
    | Call String (List Expr)


pub type Op
    = Add
    | Sub
    | Mul
    | Div
    | Pow


pub tokenize : String → Result String (List Token)
tokenize input = tokenizeChars (String.toList input) []


tokenizeChars : List Char, List Token → Result String (List Token)
tokenizeChars chars acc =
    case chars of
        [] →
            Ok (List.reverse acc)

        [ ' ', …rest ] →
            tokenizeChars rest acc

        [ '\n', …rest ] →
            tokenizeChars rest acc

        [ '+', …rest ] →
            tokenizeChars rest [ TPlus, …acc ]

        [ '-', …rest ] →
            tokenizeChars rest [ TMinus, …acc ]

        [ '*', …rest ] →
            tokenizeChars rest [ TStar, …acc ]

        [ '/', …rest ] →
            tokenizeChars rest [ TSlash, …acc ]

        [ '^', …rest ] →
            tokenizeChars rest [ TCaret, …acc ]

        [ '(', …rest ] →
            tokenizeChars rest [ TLParen, …acc ]

        [ ')', …rest ] →
            tokenizeChars rest [ TRParen, …acc ]

        [ ',', …rest ] →
            tokenizeChars rest [ TComma, …acc ]

        [ c, …rest ] →
            if Char.isDigit c then
                ( digits, remaining ) = span isNumberChar chars
                text = String.fromList digits
                case String.toFloat text of
                    Just n →
                        tokenizeChars remaining [ TNumber n, …acc ]

                    Nothing →
                        Err "bad number: ${text}"
            else if Char.isAlpha c then
                ( letters, remaining ) = span Char.isAlphaNum chars
                tokenizeChars remaining [ TIdent (String.fromList letters), …acc ]
            else
                Err "unexpected character: ${c}"


isNumberChar : Char → Bool
isNumberChar c = Char.isDigit c || c == '.'


span : (a → Bool), List a → List a × List a
span predicate items =
    go taken remaining =
        case remaining of
            [ x, …rest ] →
                if predicate x then
                    go [ x, …taken ] rest
                else
                    ( List.reverse taken, remaining )

            [] →
                ( List.reverse taken, [] )
    go [] items


pub parse : String → Result String Expr
parse input =
    tokens = tokenize input?
    ( expr, rest ) = parseExpr 0 tokens?
    case rest of
        [] →
            Ok expr

        [ token, …_ ] →
            Err "unexpected ${describeToken token} after expression"


parseExpr : Int, List Token → Result String (Expr × List Token)
parseExpr minPrec tokens =
    ( left, rest ) = parseUnary tokens?
    climb minPrec left rest


climb : Int, Expr, List Token → Result String (Expr × List Token)
climb minPrec left tokens =
    case tokens of
        [ token, …rest ] →
            case binaryOp token of
                Just ( op, prec, rightAssoc ) →
                    if prec < minPrec then
                        Ok ( left, tokens )
                    else
                        nextMin =
                            if rightAssoc then
                                prec
                            else
                                prec + 1

                        ( right, remaining ) = parseExpr nextMin rest?
                        climb minPrec (Binary op left right) remaining

                Nothing →
                    Ok ( left, tokens )

        [] →
            Ok ( left, [] )


binaryOp : Token → Maybe (Op × Int × Bool)
binaryOp token =
    case token of
        TPlus →
            Just ( Add, 1, False )

        TMinus →
            Just ( Sub, 1, False )

        TStar →
            Just ( Mul, 2, False )

        TSlash →
            Just ( Div, 2, False )

        TCaret →
            Just ( Pow, 3, True )

        _ →
            Nothing


parseUnary : List Token → Result String (Expr × List Token)
parseUnary tokens =
    case tokens of
        [ TMinus, …rest ] →
            ( operand, remaining ) = parseUnary rest?
            Ok ( Neg operand, remaining )

        _ →
            parseAtom tokens


parseAtom : List Token → Result String (Expr × List Token)
parseAtom tokens =
    case tokens of
        [ TNumber n, …rest ] →
            Ok ( Number n, rest )

        [ TIdent name, TLParen, …rest ] →
            ( args, remaining ) = parseArgs rest []?
            Ok ( Call name args, remaining )

        [ TIdent name, …rest ] →
            Ok ( Var name, rest )

        [ TLParen, …rest ] →
            ( inner, remaining ) = parseExpr 0 rest?
            case remaining of
                [ TRParen, …afterParen ] →
                    Ok ( inner, afterParen )

                _ →
                    Err "expected closing parenthesis"

        [ token, …_ ] →
            Err "unexpected ${describeToken token}"

        [] →
            Err "unexpected end of input"


parseArgs : List Token, List Expr → Result String (List Expr × List Token)
parseArgs tokens acc =
    case tokens of
        [ TRParen, …rest ] →
            Ok ( List.reverse acc, rest )

        _ →
            ( arg, remaining ) = parseExpr 0 tokens?
            case remaining of
                [ TComma, …afterComma ] →
                    parseArgs afterComma [ arg, …acc ]

                [ TRParen, …afterParen ] →
                    Ok ( List.reverse [ arg, …acc ], afterParen )

                _ →
                    Err "expected `,` or `)` in argument list"


describeToken : Token → String
describeToken token =
    case token of
        TNumber n →
            "number ${n}"

        TIdent name →
            "identifier ${name}"

        TPlus →
            "`+`"

        TMinus →
            "`-`"

        TStar →
            "`*`"

        TSlash →
            "`/`"

        TCaret →
            "`^`"

        TLParen →
            "`(`"

        TRParen →
            "`)`"

        TComma →
            "`,`"


pub eval : Dict String Float, Expr → Result String Float
eval env expr =
    case expr of
        Number n →
            Ok n

        Var name →
            Dict.get env name ▷ Result.fromMaybe "unknown variable ${name}"

        Neg inner →
            Ok (negate (eval env inner?))

        Binary op left right →
            l = eval env left?
            r = eval env right?
            case op of
                Add →
                    Ok (l + r)

                Sub →
                    Ok (l - r)

                Mul →
                    Ok (l * r)

                Div →
                    if r == 0 then
                        Err "division by zero"
                    else
                        Ok (l / r)

                Pow →
                    Ok (l ^ r)

        Call name args →
            values = evalAll env args?
            callFunction name values


evalAll : Dict String Float, List Expr → Result String (List Float)
evalAll env exprs =
    case exprs of
        [] →
            Ok []

        [ first, …rest ] →
            Ok [ eval env first?, …evalAll env rest? ]


callFunction : String, List Float → Result String Float
callFunction name args =
    case ( name, args ) of
        ( "sqrt", [ x ] ) →
            Ok (sqrt x)

        ( "abs", [ x ] ) →
            Ok (abs x)

        ( "max", [ a, b ] ) →
            Ok (max a b)

        ( "min", [ a, b ] ) →
            Ok (min a b)

        ( "sum", xs ) →
            Ok (List.sum xs)

        ( _, _ ) →
            Err "unknown function ${name} with ${List.length args} arguments"


pub print : Expr → String
print expr =
    case expr of
        Number n →
            String.fromFloat n

        Var name →
            name

        Neg inner →
            "-${printAtom inner}"

        Binary op left right →
            "${printAtom left} ${opSymbol op} ${printAtom right}"

        Call name args →
            name ++ "(" ++ String.join (List.map args print) ", " ++ ")"


printAtom : Expr → String
printAtom expr =
    case expr of
        Binary _ _ _ →
            "(" ++ print expr ++ ")"

        _ →
            print expr


opSymbol : Op → String
opSymbol op =
    case op of
        Add →
            "+"

        Sub →
            "-"

        Mul →
            "*"

        Div →
            "/"

        Pow →
            "^"


pub calculate : Dict String Float, String → Result String Float
calculate env input = eval env (parse input?)
