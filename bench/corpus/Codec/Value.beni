--! A JSON-shaped value, written in beni, and its printer. `Codec.Parse`
--! reads text into it, `Codec.Decode` turns it into typed data and
--! `Codec.Encode` builds it back up. An object keeps its fields in the
--! order they were written, so printing what was parsed round-trips.

pub type Value
    = Null
    | Boolean Bool
    | Number Float
    | Text String
    | Array (List Value)
    | Object (List ( String, Value ))


--| The field of an object with this name, the first one when a name
--| repeats. `Nothing` for a missing field and for a value that is not an
--| object.
pub get : Value, String -> Maybe Value
get value name =
    case value of
        Object fields ->
            lookup fields name

        _ ->
            Nothing


lookup : List ( String, Value ), String -> Maybe Value
lookup fields name =
    case fields of
        [] ->
            Nothing

        ( key, value ) :: rest ->
            if key == name then
                Just value
            else
                lookup rest name


--| What kind of value this is, as an error message names it.
pub kind : Value -> String
kind value =
    case value of
        Null ->
            "null"

        Boolean _ ->
            "a boolean"

        Number _ ->
            "a number"

        Text _ ->
            "a string"

        Array items ->
            "an array of ${List.length items}"

        Object fields ->
            "an object with ${List.length fields} fields"


--| The value as JSON text. An indent of 0 prints it on one line; any
--| other indent puts every array element and object field on its own
--| line, nested that many spaces per level.
pub print : Value, Int -> String
print value indent =
    printAt value indent 0


printAt : Value, Int, Int -> String
printAt value indent depth =
    case value of
        Null ->
            "null"

        Boolean b ->
            if b then
                "true"
            else
                "false"

        Number n ->
            printNumber n

        Text s ->
            quote s

        Array items ->
            if List.isEmpty items then
                "[]"
            else
                items
                    |> List.map (\item -> printAt item indent (depth + 1))
                    |> block "[" "]" indent depth

        Object fields ->
            if List.isEmpty fields then
                "{}"
            else
                fields
                    |> List.map (\( key, item ) -> printField key item indent depth)
                    |> block "{" "}" indent depth


printField : String, Value, Int, Int -> String
printField key item indent depth =
    let
        separator =
            if indent == 0 then
                ":"
            else
                ": "
    in
    quote key ++ separator ++ printAt item indent (depth + 1)


block : List String, String, String, Int, Int -> String
block parts open close indent depth =
    if indent == 0 then
        open ++ String.join parts "," ++ close
    else
        let
            inner =
                "\n" ++ String.repeat " " (indent * (depth + 1))

            outer =
                "\n" ++ String.repeat " " (indent * depth)
        in
        open ++ inner ++ String.join parts ("," ++ inner) ++ outer ++ close


printNumber : Float -> String
printNumber n =
    if isNaN n || isInfinite n then
        "null"
    else if toFloat (round n) == n && abs n < 9007199254740992 then
        String.fromInt (round n)
    else
        String.fromFloat n


--| A string as a JSON string literal: quoted, with the characters JSON
--| does not allow bare written as escapes.
pub quote : String -> String
quote s =
    "\"" ++ String.concat (List.map (String.toList s) escape) ++ "\""


escape : Char -> String
escape c =
    case c of
        '"' ->
            "\\\""

        '\\' ->
            "\\\\"

        '\n' ->
            "\\n"

        '\r' ->
            "\\r"

        '\t' ->
            "\\t"

        _ ->
            if Char.toCode c < 32 then
                "\\u" ++ String.padLeft (hex (Char.toCode c)) 4 '0'
            else
                String.fromChar c


hex : Int -> String
hex n =
    let
        digit d =
            String.slice "0123456789abcdef" d (d + 1)
    in
    if n < 16 then
        digit n
    else
        hex (n // 16) ++ digit (modBy n 16)


--| Two values are the same JSON: numbers by value, objects field by field
--| in order.
pub same : Value, Value -> Bool
same a b =
    case ( a, b ) of
        ( Null, Null ) ->
            True

        ( Boolean x, Boolean y ) ->
            x == y

        ( Number x, Number y ) ->
            x == y

        ( Text x, Text y ) ->
            x == y

        ( Array xs, Array ys ) ->
            List.length xs == List.length ys && List.all (List.map2 xs ys same) identity

        ( Object xs, Object ys ) ->
            List.length xs
                == List.length ys
                && List.all
                    (List.map2 xs ys (\( k1, v1 ) ( k2, v2 ) -> k1 == k2 && same v1 v2))
                    identity

        _ ->
            False
