--! Encoders: functions that build a `Codec.Value` from typed data, and
--! `encode`, which prints one as JSON text.

import Codec.Value as Json exposing (Null, Boolean, Number, Text, Array, Object)
import Dict exposing (Dict)
import Set exposing (Set)


pub type alias Value =
    Json.Value


--| The value as JSON text, indented that many spaces per level; 0 prints
--| it on one line.
pub encode : Value, Int → String
encode value indent = Json.print value indent


pub string : String → Value
string s = Text s


pub int : Int → Value
int n = Number (toFloat n)


pub float : Float → Value
float n = Number n


pub bool : Bool → Value
bool b = Boolean b


pub null : Value
null = Null


pub list : List a, (a → Value) → Value
list items encoder = Array (List.map items encoder)


pub set : Set a, (a → Value) → Value
set items encoder = Array (List.map (Set.toList items) encoder)


pub object : List (String × Value) → Value
object fields = Object fields


--| A dictionary as an object, its keys turned into field names.
pub dict : Dict k v, (k → String), (v → Value) → Value
dict entries toKey encoder =
    Dict.foldr entries [] (λkey item fields → [ ( toKey key, encoder item ), …fields ])
        ▷ Object


--| A value that may be missing, as `null` when it is.
pub maybe : Maybe a, (a → Value) → Value
maybe item encoder =
    case item of
        Just present →
            encoder present

        Nothing →
            Null


--| The fields whose value is present, the others left out rather than
--| written as `null`.
pub optionalFields : List (String × Maybe Value) → Value
optionalFields fields =
    fields
        ▷ List.filterMap λ( name, item ) → Maybe.map item λpresent → ( name, present )
        ▷ Object
