--! A notes application: model, messages, update with undo history, search,
--! tagging, and a view on the in-corpus `Ui.Html`. Real-application shape for
--! the benchmark corpus.

import Dict exposing (Dict)
import Set exposing (Set)
import Ui.Html exposing (Html, button, div, h1, input, li, span, text, textarea, ul)
import Ui.Html.Attributes exposing (class, classList, placeholder, value)
import Ui.Html.Events exposing (onClick, onInput)


pub type alias Note =
    id : Int
    title : String
    body : String
    tags : Set String
    pinned : Bool
    updatedAt : Int


pub type alias Model =
    notes : Dict Int Note
    nextId : Int
    selected : Maybe Int
    query : String
    activeTag : Maybe String
    history : List (Dict Int Note)
    future : List (Dict Int Note)
    now : Int
    status : Status


pub type Status
    = Idle
    | Saving
    | Saved Int
    | Failed String


pub type Msg
    = NewNote
    | Select Int
    | Deselect
    | SetTitle String
    | SetBody String
    | AddTag String
    | RemoveTag String
    | TogglePin Int
    | Delete Int
    | SetQuery String
    | FilterTag (Maybe String)
    | Undo
    | Redo
    | Tick Int
    | SaveResult (Result String Int)


pub init : Int -> Model
init now =
    { notes = Dict.empty
    , nextId = 1
    , selected = Nothing
    , query = ""
    , activeTag = Nothing
    , history = []
    , future = []
    , now = now
    , status = Idle
    }


pub update : Msg, Model -> Model
update msg model =
    case msg of
        NewNote ->
            let
                note =
                    { id = model.nextId
                    , title = "Untitled"
                    , body = ""
                    , tags = Set.empty
                    , pinned = False
                    , updatedAt = model.now
                    }
            in
            model
                |> pushHistory
                |> setNotes (Dict.insert model.notes note.id note)
                |> select (Just note.id)
                |> bumpId

        Select id ->
            select model (Just id)

        Deselect ->
            select model Nothing

        SetTitle title ->
            editSelected model (λnote -> { note | title = title })

        SetBody body ->
            editSelected model (λnote -> { note | body = body })

        AddTag tag ->
            let
                clean = String.trim (String.toLower tag)
            in
            if String.isEmpty clean then
                model
            else
                editSelected model (λnote -> { note | tags = Set.insert note.tags clean })

        RemoveTag tag ->
            editSelected model (λnote -> { note | tags = Set.remove note.tags tag })

        TogglePin id ->
            model
                |> pushHistory
                |> editNote id (λnote -> { note | pinned = not note.pinned })

        Delete id ->
            let
                remaining = Dict.remove model.notes id

                selected =
                    if model.selected == Just id then
                        Nothing
                    else
                        model.selected
            in
            model
                |> pushHistory
                |> setNotes remaining
                |> select selected

        SetQuery query ->
            { model | query = query }

        FilterTag tag ->
            { model | activeTag = tag }

        Undo ->
            case model.history of
                [ previous, ...rest ] ->
                    { model
                        | notes = previous
                        , history = rest
                        , future = [ model.notes, ...model.future ]
                    }

                [] ->
                    model

        Redo ->
            case model.future of
                [ next, ...rest ] ->
                    { model
                        | notes = next
                        , future = rest
                        , history = [ model.notes, ...model.history ]
                    }

                [] ->
                    model

        Tick now ->
            { model | now = now }

        SaveResult result ->
            case result of
                Ok at ->
                    { model | status = Saved at }

                Err reason ->
                    { model | status = Failed reason }


pushHistory : Model -> Model
pushHistory model =
    { model
        | history = List.take [ model.notes, ...model.history ] 50
        , future = []
    }


setNotes : Model, Dict Int Note -> Model
setNotes model notes = { model | notes = notes }


select : Model, Maybe Int -> Model
select model id = { model | selected = id }


bumpId : Model -> Model
bumpId model = { model | nextId = model.nextId + 1 }


editNote : Model, Int, (Note -> Note) -> Model
editNote model id f =
    case Dict.get model.notes id of
        Just note ->
            let
                edited = f note
            in
            { model | notes = Dict.insert model.notes id { edited | updatedAt = model.now } }

        Nothing ->
            model


editSelected : Model, (Note -> Note) -> Model
editSelected model f =
    case model.selected of
        Just id ->
            editNote model id f

        Nothing ->
            model


pub visibleNotes : Model -> List Note
visibleNotes model =
    let
        query = String.toLower (String.trim model.query)

        matchesQuery note =
            String.isEmpty query
                || String.contains (String.toLower note.title) query
                || String.contains (String.toLower note.body) query

        matchesTag note =
            case model.activeTag of
                Just tag ->
                    Set.member note.tags tag

                Nothing ->
                    True

        rank note =
            if note.pinned then
                0
            else
                1

        pinnedFirstThenNewest a b =
            if rank a /= rank b then
                compare (rank a) (rank b)
            else
                compare b.updatedAt a.updatedAt
    in
    Dict.values model.notes
        |> List.filter matchesQuery
        |> List.filter matchesTag
        |> List.sortWith pinnedFirstThenNewest


pub allTags : Model -> List ( String, Int )
allTags model =
    let
        count tag counts =
            Dict.update counts tag (λexisting -> Just (Maybe.withDefault existing 0 + 1))

        countNote note counts = Set.foldl note.tags counts count

        commonestFirst ( tag1, n1 ) ( tag2, n2 ) =
            if n1 /= n2 then
                compare n2 n1
            else
                String.compare tag1 tag2
    in
    Dict.values model.notes
        |> List.foldl Dict.empty countNote
        |> Dict.toList
        |> List.sortWith commonestFirst


pub view : Model -> Html Msg
view model =
    div [ class "app" ]
        [ viewSidebar model
        , viewEditor model
        , viewStatus model.status
        ]


viewSidebar : Model -> Html Msg
viewSidebar model =
    div [ class "sidebar" ]
        [ h1 [] [ text "Notes" ]
        , input [ placeholder "Search", value model.query, onInput SetQuery ] []
        , button [ onClick NewNote ] [ text "New" ]
        , button [ onClick Undo ] [ text "Undo" ]
        , button [ onClick Redo ] [ text "Redo" ]
        , viewTags model
        , ul [ class "notes" ] (List.map (visibleNotes model) (viewNoteItem model.selected _))
        ]


viewTags : Model -> Html Msg
viewTags model =
    ul [ class "tags" ]
        [ li [ onClick (FilterTag Nothing) ] [ text "all" ]
        , ...List.map (allTags model)
            (λ( tag, n ) ->
                li
                    [ classList [ ( "active", model.activeTag == Just tag ) ]
                    , onClick (FilterTag (Just tag))
                    ]
                    [ text "${tag} (${n})" ]
            )
        ]


viewNoteItem : Maybe Int, Note -> Html Msg
viewNoteItem selected note =
    li
        [ classList
            [ ( "note", True )
            , ( "selected", selected == Just note.id )
            , ( "pinned", note.pinned )
            ]
        , onClick (Select note.id)
        ]
        [ span [ class "title" ] [ text note.title ]
        , span [ class "preview" ] [ text (preview note.body) ]
        , button [ onClick (TogglePin note.id) ]
            [ text
                (if note.pinned then
                    "unpin"
                 else
                    "pin"
                )
            ]
        , button [ onClick (Delete note.id) ] [ text "delete" ]
        ]


preview : String -> String
preview body =
    let
        firstLine = body |> String.lines |> List.head |> Maybe.withDefault ""
    in
    if String.length firstLine > 40 then
        String.left firstLine 37 ++ "..."
    else
        firstLine


viewEditor : Model -> Html Msg
viewEditor model =
    case model.selected |> Maybe.andThen (λid -> Dict.get model.notes id) of
        Just note ->
            div [ class "editor" ]
                [ input [ value note.title, onInput SetTitle ] []
                , textarea [ value note.body, onInput SetBody ] []
                , ul [ class "note-tags" ]
                    (List.map (Set.toList note.tags)
                        (λtag -> li [ onClick (RemoveTag tag) ] [ text tag ])
                    )
                , input [ placeholder "Add tag", onInput AddTag ] []
                , span [ class "meta" ] [ text "updated ${note.updatedAt}" ]
                , button [ onClick Deselect ] [ text "Close" ]
                ]

        Nothing ->
            div [ class "editor empty" ] [ text "Select or create a note" ]


viewStatus : Status -> Html Msg
viewStatus status =
    case status of
        Idle ->
            text ""

        Saving ->
            span [ class "status" ] [ text "Saving..." ]

        Saved at ->
            span [ class "status" ] [ text "Saved at ${at}" ]

        Failed reason ->
            span [ class "status error" ] [ text "Save failed: ${reason}" ]
