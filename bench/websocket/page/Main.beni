-- The page side of boundary.md §9.11 (m): a state message from the server
-- each tick, applied to the model and rendered; and a button, so a click's
-- message is measured on the same page.
import Cmd exposing (Cmd)
import Html exposing (Html)
import Sub
import Tea
import WebSocket


type Msg
    = Socket WebSocket.Event
    | Clicked


type alias Model =
    state : String
    count : Int


update : Msg, Model → Model × Cmd Msg
update msg model =
    case msg of
        Socket (WebSocket.Received text) →
            ( { model | state = text, count = model.count + 1 }, Cmd.none )

        Socket _ →
            ( model, Cmd.none )

        Clicked →
            ( { model | count = model.count + 1 }, Cmd.none )


view : Model → Html Msg
view model =
    <main>
        <button id="b" onClick={Clicked}>b</button>
        <p>{model.state}</p>
        <p>{String.fromInt model.count}</p>
    </main>


main : Tea.Program
main =
    Tea.element
        { init = λ⊤ → ( { state = "", count = 0 }, Cmd.none )
        , update = update
        , view = view
        , subscriptions = λ_ → WebSocket.listen "/arena" [] Socket
        }
